---
import Layout from '../../../layouts/Layout.astro';
import { generateSlug } from '../../../utils/slugUtils.js';

// Obtener parámetros de la URL
const { id, slug } = Astro.params;

// NUEVA IMPLEMENTACIÓN: Consulta dinámica a Directus
async function getServicioFromDirectus(servicioId) {
  try {
    const directusUrl = 'http://umbot-directus:8055'; // URL interna del contenedor
    const response = await fetch(`${directusUrl}/items/servicios?filter[id][_eq]=${servicioId}`);
    
    if (!response.ok) {
      throw new Error(`HTTP ${response.status}`);
    }
    
    const data = await response.json();
    return data.data && data.data.length > 0 ? data.data[0] : null;
  } catch (error) {
    console.error('Error fetching from Directus:', error);
    return null;
  }
}

// Buscar el servicio por ID dinámicamente
const servicio = await getServicioFromDirectus(parseInt(id));

// Si no se encuentra el servicio, devolver 404
if (!servicio) {
  return Astro.redirect('/404');
}

// Verificar que el slug coincida (para SEO)
const expectedSlug = generateSlug(servicio.titulo || servicio.Titulo);
if (slug !== expectedSlug) {
  return Astro.redirect(`/servicios/${id}/${expectedSlug}`);
}

// Mapeo de IDs de imágenes de Directus a archivos estáticos locales
const imageMapping = {
  // Servicios IT (ID: 1)
  '2749f988-2e2d-4f32-9978-4dbeb4aa6ab2': '/images/services/servicios-it.jpg',
  // Redes de datos (ID: 2)
  '18b5f4e3-4bc8-485d-a01c-8cbd53e25f4d': '/images/services/redes-comunicaciones.jpg',
  // Seguridad Informática (ID: 3)
  'f2a65085-e6ad-49fc-a123-1b5dc19fc7ab': '/images/services/ciberseguridad.jpg',
  // Telefonía y Citoina (ID: 4)
  '4ffcefb0-6cb8-4cfa-a748-bd4c3da1d716': '/images/services/telefonia.jpg',
  // Servicios Web (ID: 6)
  'dc6d6069-23af-4d75-ae5a-38c830bf2b85': '/images/services/servicios-web.jpg',
  // Mapeos adicionales para compatibilidad
  'b1a91d79-c979-4067-b78a-2cd97166fbcd': '/images/services/seguridad-informatica.jpg',
  '6e626d63-c3ca-4982-8ed3-4a5e75e1b179': '/images/services/redes-comunicaciones.jpg',
  'ccc32af0-df52-4e6e-8ca0-9660dddec095': '/images/services/servicios-it.jpg'
};

// Función para obtener URL de imagen
function getAssetUrl(assetId) {
  if (!assetId) return '/images/services/default-service.jpg';
  
  // Si tenemos un mapeo estático, usarlo
  if (imageMapping[assetId]) {
    return imageMapping[assetId];
  }
  
  // Fallback para nuevas imágenes
  return `http://localhost:8055/assets/${assetId}`;
}

// Preparar datos del servicio con campos normalizados
const servicioData = {
  id: servicio.id,
  titulo: servicio.titulo || servicio.Titulo,
  descripcion: servicio.descripcion || servicio.Descripcion,
  area: servicio.area || servicio.Area,
  cliente: servicio.cliente || servicio.Cliente,
  unidad_negocio: servicio.unidad_de_negocio || servicio.Unidad_de_negocio,
  imagen: getAssetUrl(servicio.imagen || servicio.Imagen),
  servicios: servicio.servicios || servicio.Servicios || [],
  presupuesto: servicio.presupuesto || servicio.Presupuesto
};
---

<Layout title={`${servicioData.titulo} - Ultima Milla`}>
  <main class="flex-1">
    <!-- Hero Section -->
    <section class="relative h-96 bg-gradient-to-r from-blue-900 to-purple-900 text-white overflow-hidden">
      <div class="absolute inset-0 bg-black opacity-50"></div>
      <img 
        src={servicioData.imagen} 
        alt={servicioData.titulo}
        class="absolute inset-0 w-full h-full object-cover z-0"
        loading="eager"
      />
      <div class="relative z-10 container mx-auto px-4 h-full flex flex-col justify-center">
        <nav class="text-sm mb-4 opacity-90">
          <a href="/" class="hover:text-blue-300">Inicio</a>
          <span class="mx-2">/</span>
          <a href="/servicios" class="hover:text-blue-300">Servicios</a>
          <span class="mx-2">/</span>
          <span class="text-blue-300">{servicioData.titulo}</span>
        </nav>
        
        <div class="inline-block bg-blue-600 text-blue-100 px-3 py-1 rounded-full text-sm mb-4">
          {servicioData.area}
        </div>
        
        <h1 class="text-4xl md:text-5xl font-bold mb-4">
          {servicioData.titulo}
        </h1>
        
        <p class="text-xl opacity-90 max-w-2xl">
          {servicioData.descripcion}
        </p>
      </div>
    </section>

    <!-- Información del Proyecto -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4">
        <div class="grid md:grid-cols-2 gap-12">
          <!-- Información del Proyecto -->
          <div class="bg-white rounded-lg shadow-lg p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Información del Proyecto</h2>
            
            <div class="space-y-4">
              <div>
                <h3 class="font-semibold text-gray-700">Área de Especialización</h3>
                <p class="text-gray-600">{servicioData.area}</p>
              </div>
              
              <div>
                <h3 class="font-semibold text-gray-700">Tipo de Cliente</h3>
                <p class="text-gray-600">{servicioData.cliente}</p>
              </div>
              
              <div>
                <h3 class="font-semibold text-gray-700">Unidad de Negocio</h3>
                <p class="text-gray-600">{servicioData.unidad_negocio}</p>
              </div>
              
              <div>
                <h3 class="font-semibold text-gray-700">ID del Servicio</h3>
                <p class="text-gray-600">#{servicioData.id.toString().padStart(4, '0')}</p>
              </div>
            </div>
          </div>

          <!-- Servicios Incluidos -->
          <div class="bg-white rounded-lg shadow-lg p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Servicios Incluidos</h2>
            
            <ul class="space-y-3">
              {servicioData.servicios.map((servicio) => (
                <li class="flex items-center">
                  <svg class="h-5 w-5 text-green-500 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span class="text-gray-700">{servicio}</span>
                </li>
              ))}
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- Características Destacadas -->
    <section class="py-16">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center text-gray-900 mb-12">Características Destacadas</h2>
        
        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          <div class="text-center">
            <div class="bg-blue-100 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
              <svg class="h-8 w-8 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">Diseño personalizado de red</h3>
            <p class="text-gray-600">Adaptado específicamente a las necesidades de tu organización</p>
          </div>
          
          <div class="text-center">
            <div class="bg-green-100 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
              <svg class="h-8 w-8 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">Alta velocidad y confiabilidad</h3>
            <p class="text-gray-600">Tecnología de última generación para máximo rendimiento</p>
          </div>
          
          <div class="text-center">
            <div class="bg-purple-100 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
              <svg class="h-8 w-8 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">Redundancia y contingencias</h3>
            <p class="text-gray-600">Sistemas de respaldo para garantizar continuidad operativa</p>
          </div>
          
          <div class="text-center">
            <div class="bg-yellow-100 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
              <svg class="h-8 w-8 text-yellow-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 12l3-3 3 3 4-4M8 21l4-4 4 4M3 4h18M4 4h16v12a1 1 0 01-1 1H5a1 1 0 01-1-1V4z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">Escalabilidad futura</h3>
            <p class="text-gray-600">Infraestructura preparada para crecimiento futuro</p>
          </div>
          
          <div class="text-center">
            <div class="bg-red-100 rounded-full w-16 h-16 flex items-center justify-center mx-auto mb-4">
              <svg class="h-8 w-8 text-red-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192L5.636 18.364M12 2.25a9.75 9.75 0 110 19.5 9.75 9.75 0 010-19.5z"></path>
              </svg>
            </div>
            <h3 class="text-xl font-semibold text-gray-900 mb-2">Soporte técnico especializado</h3>
            <p class="text-gray-600">Equipo de expertos disponible para asistencia técnica</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Información del Servicio -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto">
          <div class="bg-white rounded-lg shadow-lg p-8">
            <h2 class="text-2xl font-bold text-gray-900 mb-6">Información del Servicio</h2>
            
            <div class="grid md:grid-cols-2 gap-6 mb-8">
              <div>
                <p class="text-gray-600"><strong>Área:</strong> {servicioData.area}</p>
              </div>
              <div>
                <p class="text-gray-600"><strong>Cliente tipo:</strong> {servicioData.cliente}</p>
              </div>
              <div>
                <p class="text-gray-600"><strong>Unidad:</strong> {servicioData.unidad_negocio}</p>
              </div>
            </div>
            
            <div class="text-center">
              <a href="/contacto" class="bg-blue-600 hover:bg-blue-700 text-white font-bold py-3 px-8 rounded-lg transition duration-300">
                Solicitar Cotización
              </a>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Etiquetas -->
    <section class="py-8 bg-white">
      <div class="container mx-auto px-4 text-center">
        <h3 class="text-lg font-semibold text-gray-700 mb-4">Etiquetas</h3>
        <div class="flex flex-wrap justify-center gap-2">
          <span class="bg-blue-100 text-blue-800 px-3 py-1 rounded-full text-sm">{servicioData.area}</span>
          <span class="bg-green-100 text-green-800 px-3 py-1 rounded-full text-sm">{servicioData.cliente}</span>
          <span class="bg-purple-100 text-purple-800 px-3 py-1 rounded-full text-sm">{servicioData.unidad_negocio}</span>
          <span class="bg-gray-100 text-gray-800 px-3 py-1 rounded-full text-sm">ID-{servicioData.id}</span>
        </div>
      </div>
    </section>

    <!-- Servicios Relacionados -->
    <section class="py-16 bg-gray-50">
      <div class="container mx-auto px-4">
        <h2 class="text-3xl font-bold text-center text-gray-900 mb-12">Servicios Relacionados</h2>
        <p class="text-center text-gray-600 mb-8">Otros servicios en el área de {servicioData.area}</p>
        
        <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          <div class="bg-white rounded-lg shadow-lg overflow-hidden">
            <img src="/images/services/servicios-it.jpg" alt="Servicios IT" class="w-full h-48 object-cover">
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-2">Servicios IT</h3>
              <p class="text-gray-600 mb-4">Redes de Datos. Seguridad. Telecomunicaciones. Software. Acceso....</p>
              <p class="text-sm text-gray-500">Cliente: Instituciones</p>
            </div>
          </div>
          
          <div class="bg-white rounded-lg shadow-lg overflow-hidden">
            <img src="/images/services/telefonia.jpg" alt="Telefonía y Citoina" class="w-full h-48 object-cover">
            <div class="p-6">
              <h3 class="text-xl font-bold text-gray-900 mb-2">Telefonía y Citoina</h3>
              <p class="text-gray-600 mb-4">Telefonía IP, Citofonía (porteros eléctricos)...</p>
              <p class="text-sm text-gray-500">Cliente: Edificios</p>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Animaciones suaves */
  .transition-all {
    transition: all 0.3s ease;
  }
  
  /* Efectos hover para botones */
  .hover\\:bg-blue-700:hover {
    background-color: #1d4ed8;
  }
  
  /* Sombras personalizadas */
  .shadow-lg {
    box-shadow: 0 10px 15px -3px rgba(0, 0, 0, 0.1), 0 4px 6px -2px rgba(0, 0, 0, 0.05);
  }
</style>

<!-- Metadatos dinámicos -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Service",
  "name": "{servicioData.titulo}",
  "description": "{servicioData.descripcion}",
  "provider": {
    "@type": "Organization",
    "name": "Ultima Milla",
    "url": "https://umbot.com.ar"
  },
  "serviceType": "{servicioData.area}",
  "audience": "{servicioData.cliente}"
}
</script>

<!-- Marcador de página dinámica para debugging -->
<!-- DYNAMIC SSR PAGE - Servicio ID: {servicioData.id} - Generated: {new Date().toISOString()} --> 