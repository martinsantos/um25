# Copiar líneas a .env — plantilla réplica (no commitear .env)
UMSA_LOCAL_REPLICA=1
# H1 y títulos iguales a www (skin hybrid nueva). Desactivar: UMSA_REPLICA_IDENTICAL=0
UMSA_REPLICA_IDENTICAL=1
DIRECTUS_INTERNAL_URL=http://localhost:8055
PUBLIC_DIRECTUS_URL=http://localhost:8055
DIRECTUS_STATIC_TOKEN=your_production_directus_token
PUBLIC_DIRECTUS_TOKEN=your_production_directus_token
PUBLIC_SITE_URL=http://localhost:4321
HOST=0.0.0.0
PORT=4321
USE_DIRECTUS=true
