    console.log('⌨️ Input element:', this.input ? '✅ Found' : '❌ Not found');
    console.log('📺 Output element:', this.output ? '✅ Found' : '❌ Not found');
    console.log('💬 Prompt element:', this.prompt ? '✅ Found' : '❌ Not found');
    
    if (this.themeSelector) {
      console.log('🎨 Theme selector value:', this.themeSelector.value);
      console.log('🎨 Theme selector options:', Array.from(this.themeSelector.options).map(o => o.value));
      
      // Add debug event listener for theme selector
      this.themeSelector.addEventListener('change', (e) => {
        console.log('🎨 THEME SELECTOR EVENT FIRED! New value:', e.target.value);
      });
      
      // Add click listener for debugging
      this.themeSelector.addEventListener('click', () => {
        console.log('🎨 Theme selector was clicked');
      });
      
      // Test theme change programmatically
      console.log('🧪 Testing programmatic theme change to matrix...');
      setTimeout(() => {
        this.changeTheme('matrix');
        console.log('🧪 Matrix theme applied, reverting to default in 3 seconds...');
        setTimeout(() => {
          this.changeTheme('default');
          console.log('🧪 Test completed: reverted to default theme');
        }, 3000);
      }, 1000);
    } else {
      console.error('❌ Theme selector not found! Searching for it manually...');
      const manualSearch = document.getElementById('theme-selector');
      console.log('🔍 Manual search result:', manualSearch ? '✅ Found by manual search' : '❌ Still not found');
    }
    
    console.log('🏷️ Current theme:', this.currentTheme);
    console.log('🏷️ Terminal data-theme attr:', this.terminal ? this.terminal.getAttribute('data-theme') : 'N/A');
    console.log('🔧 === END DIAGNOSTIC TEST ===');
  }
  
  // Método avanzado para suprimir errores de desarrollo
  suppressDevErrors() {
    // Suprimir console.error
    const originalConsoleError = console.error;
    console.error = function(...args) {
      const message = args.join(' ').toLowerCase();
      if (
        message.includes('websocket') ||
        message.includes('vite') ||
        message.includes('hmr') ||
        message.includes('[vite]') ||
        message.includes('failed to fetch') ||
        message.includes('net::err') ||
        message.includes('connection failed') ||
        message.includes('alpinejs') ||
        message.includes('alpine') ||
        message.includes('504') ||
        message.includes('server error') ||
        message.includes('localhost') && message.includes('refused')
      ) {
        // Suprimir errores de desarrollo
        return;
      }
      originalConsoleError.apply(console, args);
    };
    
    // Suprimir console.warn para errores similares
    const originalConsoleWarn = console.warn;
    console.warn = function(...args) {
      const message = args.join(' ').toLowerCase();
      if (
        message.includes('websocket') ||
        message.includes('vite') ||
        message.includes('hmr') ||
        message.includes('alpinejs') ||
        message.includes('dev server')
      ) {
        return;
      }
      originalConsoleWarn.apply(console, args);
    };
    
    // Interceptar eventos de error global
    window.addEventListener('error', function(e) {
      const message = e.message ? e.message.toLowerCase() : '';
      const source = e.filename ? e.filename.toLowerCase() : '';
      
      if (
        message.includes('websocket') ||
        message.includes('vite') ||
        source.includes('vite') ||
        source.includes('alpinejs')
      ) {
        e.preventDefault();
        e.stopPropagation();
        return false;
      }
    }, true);
    
    // Interceptar promesas rechazadas
    window.addEventListener('unhandledrejection', function(e) {
      const reason = e.reason ? e.reason.toString().toLowerCase() : '';
      
      if (
        reason.includes('websocket') ||
        reason.includes('vite') ||
        reason.includes('fetch') ||
        reason.includes('connection')
      ) {
        e.preventDefault();
        return false;
      }
    });
    
    console.log('🔇 Error suppression active for development environment');
  }
}

// Initialize when DOM is ready
if (document.readyState === 'loading') {
  document.addEventListener('DOMContentLoaded', () => {
    window.umTerminal = new UMTerminalAdvanced();
    // Suprimir errores de desarrollo en producción
    if (window.location.hostname !== 'localhost') {
      window.umTerminal.suppressDevErrors();
    }
  });
} else {
  window.umTerminal = new UMTerminalAdvanced();
  // Suprimir errores de desarrollo en producción
  if (window.location.hostname !== 'localhost') {
    window.umTerminal.suppressDevErrors();
  }
}
