---
// UMTerminal Advanced v3.0 - Professional terminal with advanced themes and animations
---

<div id="um-terminal-container">
  <div id="um-terminal" class="um-terminal">
    <!-- Terminal Header -->
    <div class="um-terminal-header">
      <div class="um-terminal-controls">
        <span class="um-control um-close" data-action="close"></span>
        <span class="um-control um-minimize" data-action="minimize"></span>
        <span class="um-control um-maximize" data-action="maximize"></span>
      </div>
      <div class="um-terminal-title">
        ULTIMA MILLA CLI v3.0 - Enhanced Edition
      </div>
      <div class="um-terminal-theme-selector">
        <select id="theme-selector" title="Seleccionar tema">
          <option value="default">Terminal</option>
          <option value="matrix">Matrix</option>
          <option value="retro">Retro</option>
          <option value="neon">Neon</option>
          <option value="corporate">Corporativo</option>
        </select>
      </div>
      <div class="um-terminal-status">
        <div class="status-indicator active" title="Sistema conectado"></div>
      </div>
    </div>
    
    <!-- Terminal Body -->
    <div class="um-terminal-body" id="terminal-output">
      <div class="welcome-message">
        <pre id="welcome-ascii" class="ascii-art"></pre>
        <div class="welcome-info">
          <div class="welcome-line animate-slide-in" data-delay="0">
            <span class="icon">🚀</span> Bienvenido a <strong>ULTIMA MILLA CLI Advanced</strong> - Terminal empresarial con IA
          </div>
          <div class="welcome-line animate-slide-in" data-delay="500">
            <span class="icon">🎨</span> <strong>Temas visuales:</strong> Matrix, Retro, Neon y más (selector arriba)
          </div>
          <div class="welcome-line animate-slide-in" data-delay="1000">
            <span class="icon">📊</span> <strong>22 años</strong> de historia • <strong>469+ proyectos</strong> • <strong>150+ clientes</strong>
          </div>
          <div class="welcome-line animate-slide-in" data-delay="1500">
            <span class="icon">💡</span> Comandos: <code>help</code> | <code>matrix</code> | <code>fortune</code> | <code>stats</code>
          </div>
          <div class="welcome-line animate-slide-in" data-delay="2000">
            <span class="icon">⚡</span> Prueba <code>sudo ultimamilla.py --demo</code> para demostración completa
          </div>
          <div class="welcome-line animate-slide-in" data-delay="2500">
            <span class="icon">📞</span> <code>contacto</code> para enviar mensajes reales al equipo
          </div>
          <div class="welcome-line animate-slide-in" data-delay="3000">
            <span class="icon">🔮</span> Asistente IA: <code>cowsay "mensaje"</code> | <code>whoami --empresa</code>
          </div>
        </div>
      </div>
    </div>
    
    <!-- Terminal Input Line -->
    <div class="um-terminal-input-line">
      <div class="input-container">
        <span class="um-prompt animated-prompt" id="terminal-prompt">visitante@ultimamilla:~$ </span>
        <input 
          type="text" 
          id="terminal-input" 
          class="um-input" 
          autocomplete="off"
          spellcheck="false"
          placeholder="Escribe un comando... (Tab para autocompletar)"
          aria-label="Terminal de comandos avanzado"
        />
        <div class="cursor-blink enhanced-cursor"></div>
      </div>
      <div class="input-suggestions enhanced-suggestions" id="input-suggestions"></div>
    </div>
    
    <!-- Loading Overlay with animation -->
    <div class="loading-overlay enhanced-loading" id="loading-overlay" style="display: none;">
      <div class="loading-spinner matrix-spinner"></div>
      <div class="loading-text">Procesando comando...</div>
      <div class="loading-progress">
        <div class="progress-bar" id="progress-bar"></div>
      </div>
    </div>
    
    <!-- Matrix Rain Effect -->
    <canvas id="matrix-canvas" class="matrix-rain" style="display: none;"></canvas>
  </div>
</div>

<!-- Integrated JavaScript - No External Dependencies -->
<script is:inline>
// UMTerminal Advanced v3.0 - Complete JavaScript Integration
// Professional terminal with advanced themes, animations and AI-like features

class UMTerminalAdvanced {
  constructor() {
    this.terminal = null;
    this.output = null;
    this.input = null;
    this.prompt = null;
    this.currentTheme = 'default';
    this.commandHistory = [];
    this.historyIndex = -1;
    this.suggestions = [];
    this.currentDir = 'ultimamilla';
    this.username = 'visitante';
    this.isTyping = false;
    this.matrixCanvas = null;
    this.matrixCtx = null;
    
    // Commands database
    this.commands = {
      help: {
        description: 'Muestra todos los comandos disponibles',
        category: 'Sistema',
        usage: 'help [comando]'
      },
      clear: {
        description: 'Limpia la terminal',
        category: 'Sistema',
        usage: 'clear'
      },
      matrix: {
        description: 'Activa el efecto Matrix Rain',
        category: 'Efectos',
        usage: 'matrix [on|off]'
      },
      theme: {
        description: 'Cambia el tema visual',
        category: 'Personalización',
        usage: 'theme [default|matrix|retro|neon|corporate]'
      },
      stats: {
        description: 'Estadísticas de ULTIMA MILLA',
        category: 'Empresa',
        usage: 'stats'
      },
      fortune: {
        description: 'Mensaje motivacional aleatorio',
        category: 'Diversión',
        usage: 'fortune'
      },
      whoami: {
        description: 'Información del sistema y usuario',
        category: 'Sistema',
        usage: 'whoami [--empresa]'
      },
      cowsay: {
        description: 'Vaca que dice cosas',
        category: 'Diversión',
        usage: 'cowsay "mensaje"'
      },
      contact: {
        description: 'Información de contacto real',
        category: 'Empresa',
        usage: 'contact'
      },
      about: {
        description: 'Sobre ULTIMA MILLA',
        category: 'Empresa',
        usage: 'about'
      },
      services: {
        description: 'Servicios disponibles',
        category: 'Empresa',
        usage: 'services'
      },
      projects: {
        description: 'Proyectos destacados',
        category: 'Empresa',
        usage: 'projects'
      },
      date: {
        description: 'Fecha y hora actual',
        category: 'Sistema',
        usage: 'date'
      },
      uptime: {
        description: 'Tiempo de actividad del sistema',
        category: 'Sistema',
        usage: 'uptime'
      },
      sudo: {
        description: 'Ejecutar comando con privilegios (demo)',
        category: 'Sistema',
        usage: 'sudo ultimamilla.py --demo'
      }
    };

    this.init();
  }

  init() {
    // Wait for DOM to be ready
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', () => this.setupTerminal());
    } else {
      this.setupTerminal();
    }
  }

  setupTerminal() {
    // Get DOM elements
    this.terminal = document.getElementById('um-terminal');
    this.output = document.getElementById('terminal-output');
    this.input = document.getElementById('terminal-input');
    this.prompt = document.getElementById('terminal-prompt');
    this.themeSelector = document.getElementById('theme-selector');
    this.suggestionsContainer = document.getElementById('input-suggestions');
    this.loadingOverlay = document.getElementById('loading-overlay');
    this.matrixCanvas = document.getElementById('matrix-canvas');
    
    if (!this.terminal) {
      console.error('Terminal container not found');
      return;
    }

    // Initialize components
    this.setupEventListeners();
    this.setupMatrix();
    this.displayWelcomeMessage();
    this.updateSuggestions();
    
    // Focus input
    if (this.input) {
      this.input.focus();
    }
    
    // Perform initial test
    setTimeout(() => {
      this.performInitialTest();
    }, 1000);
  }

  setupEventListeners() {
    // Input handling
    if (this.input) {
      this.input.addEventListener('keydown', (e) => this.handleKeydown(e));
      this.input.addEventListener('input', (e) => this.handleInput(e));
      this.input.addEventListener('focus', () => this.hideSuggestions());
    }

    // Theme selector with improved handling
    if (this.themeSelector) {
      console.log('Theme selector found, attaching event listener');
      this.themeSelector.addEventListener('change', (e) => {
        console.log('Theme change detected:', e.target.value);
        this.changeTheme(e.target.value);
      });
      
      // Also handle click events for better mobile compatibility
      this.themeSelector.addEventListener('click', () => {
        console.log('Theme selector clicked');
      });
    } else {
      console.error('Theme selector not found!');
    }

    // Terminal controls
    const controls = this.terminal.querySelectorAll('.um-control');
    controls.forEach(control => {
      control.addEventListener('click', (e) => {
        const action = e.target.getAttribute('data-action');
        this.handleControlAction(action);
      });
    });

    // Click to focus
    if (this.terminal) {
      this.terminal.addEventListener('click', () => {
        if (this.input) this.input.focus();
      });
    }

    // Responsive handling
    this.handleResize();
    window.addEventListener('resize', () => this.handleResize());
  }

  handleKeydown(e) {
    switch (e.key) {
      case 'Enter':
        e.preventDefault();
        this.executeCommand();
        break;
      case 'ArrowUp':
        e.preventDefault();
        this.navigateHistory(-1);
        break;
      case 'ArrowDown':
        e.preventDefault();
        this.navigateHistory(1);
        break;
      case 'Tab':
        e.preventDefault();
        this.autoComplete();
        break;
      case 'Escape':
        this.hideSuggestions();
        break;
    }
  }

  handleInput(e) {
    const value = e.target.value;
    this.updateSuggestions(value);
  }

  executeCommand() {
    const command = this.input.value.trim();
    if (!command) return;

    // Add to history
    this.commandHistory.push(command);
    this.historyIndex = this.commandHistory.length;

    // Display command in output
    this.addOutput(`${this.prompt.textContent}${command}`, 'command');

    // Clear input
    this.input.value = '';
    this.hideSuggestions();

    // Show loading for dramatic effect
    this.showLoading();

    // Execute after short delay
    setTimeout(() => {
      this.processCommand(command);
      this.hideLoading();
    }, Math.random() * 500 + 200);
  }

  processCommand(command) {
    const parts = command.split(' ');
    const cmd = parts[0].toLowerCase();
    const args = parts.slice(1);

    switch (cmd) {
      case 'help':
        this.showHelp(args[0]);
        break;
      case 'clear':
        this.clearTerminal();
        break;
      case 'matrix':
        this.handleMatrixCommand(args[0]);
        break;
      case 'theme':
        if (args[0]) this.changeTheme(args[0]);
        else this.showThemes();
        break;
      case 'stats':
        this.showStats();
        break;
      case 'fortune':
        this.showFortune();
        break;
      case 'whoami':
        this.showWhoami(args.includes('--empresa'));
        break;
      case 'cowsay':
        this.showCowsay(args.join(' ').replace(/"/g, ''));
        break;
      case 'contact':
        this.showContact();
        break;
      case 'about':
        this.showAbout();
        break;
      case 'services':
        this.showServices();
        break;
      case 'projects':
        this.showProjects();
        break;
      case 'date':
        this.showDate();
        break;
      case 'uptime':
        this.showUptime();
        break;
      case 'sudo':
        this.handleSudo(args);
        break;
      default:
        this.showCommandNotFound(cmd);
        break;
    }
  }

  showHelp(specific) {
    if (specific && this.commands[specific]) {
      const cmd = this.commands[specific];
      this.addOutput(`\n📖 Ayuda para: ${specific}\n`, 'info');
      this.addOutput(`Descripción: ${cmd.description}`, 'info');
      this.addOutput(`Categoría: ${cmd.category}`, 'info');
      this.addOutput(`Uso: ${cmd.usage}\n`, 'info');
      return;
    }

    this.addOutput('\n🚀 ULTIMA MILLA CLI - Comandos Disponibles\n', 'success');
    
    const categories = {};
    Object.entries(this.commands).forEach(([name, cmd]) => {
      if (!categories[cmd.category]) categories[cmd.category] = [];
      categories[cmd.category].push({ name, ...cmd });
    });

    Object.entries(categories).forEach(([category, commands]) => {
      this.addOutput(`\n📂 ${category}:`, 'category');
      commands.forEach(cmd => {
        this.addOutput(`  ${cmd.name.padEnd(12)} - ${cmd.description}`, 'command-list');
      });
    });

    this.addOutput('\n💡 Usa "help [comando]" para más detalles\n', 'tip');
  }

  clearTerminal() {
    // Keep welcome message, clear the rest
    const welcomeMessage = this.output.querySelector('.welcome-message');
    this.output.innerHTML = '';
    if (welcomeMessage) {
      this.output.appendChild(welcomeMessage);
    }
  }

  changeTheme(theme) {
    console.log('changeTheme called with:', theme);
    
    if (!['default', 'matrix', 'retro', 'neon', 'corporate'].includes(theme)) {
      this.addOutput(`❌ Tema "${theme}" no existe. Temas: default, matrix, retro, neon, corporate`, 'error');
      return;
    }

    this.currentTheme = theme;
    
    // Update terminal theme attribute
    if (this.terminal) {
      this.terminal.setAttribute('data-theme', theme);
      console.log('Terminal theme attribute set to:', theme);
    } else {
      console.error('Terminal element not found when changing theme');
    }
    
    // Update selector value
    if (this.themeSelector) {
      this.themeSelector.value = theme;
      console.log('Theme selector value updated to:', theme);
    }
    
    // Update prompt color based on theme
    this.updatePromptTheme(theme);

    // Special effects for matrix theme
    if (theme === 'matrix') {
      this.startMatrixRain();
    } else {
      this.stopMatrixRain();
    }

    this.addOutput(`✅ Tema cambiado a: ${theme}`, 'success');
    console.log('Theme change completed successfully');
  }

  updatePromptTheme(theme) {
    if (!this.prompt) return;
    
    const themeColors = {
      'default': '#00ffaa',
      'matrix': '#00ff00',
      'retro': '#ff00ff',
      'neon': '#00ffff',
      'corporate': '#fbbf24'
    };
    
    const color = themeColors[theme] || '#00ffaa';
    this.prompt.style.color = color;
    this.prompt.style.textShadow = `0 0 8px ${color}`;
    console.log('Prompt color updated to:', color);
  }

  handleMatrixCommand(action) {
    if (action === 'on') {
      this.changeTheme('matrix');
      this.startMatrixRain();
    } else if (action === 'off') {
      this.stopMatrixRain();
      if (this.currentTheme === 'matrix') {
        this.changeTheme('default');
      }
    } else {
      this.addOutput('🔰 Matrix Rain - Efecto visual avanzado', 'info');
      this.addOutput('Uso: matrix on  - Activar efecto', 'info');
      this.addOutput('     matrix off - Desactivar efecto', 'info');
    }
  }

  showStats() {
    this.addOutput('\n📊 ULTIMA MILLA - Estadísticas Corporativas\n', 'success');
    this.addOutput('🏢 Años en el mercado: 22 años (desde 2003)', 'info');
    this.addOutput('💼 Proyectos completados: 469+', 'info');
    this.addOutput('🤝 Clientes atendidos: 150+', 'info');
    this.addOutput('🌍 Cobertura: Mendoza, Argentina', 'info');
    this.addOutput('⚡ Tecnologías: 15+ stacks dominados', 'info');
    this.addOutput('🎯 Tasa de satisfacción: 98.5%', 'info');
    this.addOutput('\n📈 En constante crecimiento desde 2003\n', 'tip');
  }

  showFortune() {
    const fortunes = [
      '🌟 "La tecnología es mejor cuando acerca a las personas." - Matt Mullenweg',
      '⚡ "El código es como el humor. Si lo tienes que explicar, es malo." - Cory House',
      '🚀 "La innovación distingue a los líderes de los seguidores." - Steve Jobs',
      '💡 "El software es una gran combinación de trabajo artesanal y ciencia." - Bill Gates',
      '🎯 "Los detalles no son detalles, hacen el diseño." - Charles Eames',
      '🔮 "El futuro pertenece a quienes se preparan para él hoy." - ULTIMA MILLA'
    ];
    
    const fortune = fortunes[Math.floor(Math.random() * fortunes.length)];
    this.addOutput(`\n${fortune}\n`, 'fortune');
  }

  showWhoami(empresa) {
    if (empresa) {
      this.addOutput('\n🏢 ULTIMA MILLA - Identidad Corporativa\n', 'success');
      this.addOutput('Razón Social: ULTIMA MILLA S.R.L.', 'info');
      this.addOutput('CUIT: Disponible por contacto', 'info');
      this.addOutput('Fundación: 2003 en Mendoza', 'info');
      this.addOutput('Especialidad: Desarrollo de software empresarial', 'info');
      this.addOutput('Misión: Transformar negocios mediante tecnología\n', 'info');
    } else {
      this.addOutput('\n👤 Información del Terminal\n', 'info');
      this.addOutput(`Usuario: ${this.username}`, 'info');
      this.addOutput(`Sistema: ULTIMA MILLA CLI v3.0`, 'info');
      this.addOutput(`Directorio: /${this.currentDir}`, 'info');
      this.addOutput(`Tema actual: ${this.currentTheme}`, 'info');
      this.addOutput(`Comandos ejecutados: ${this.commandHistory.length}\n`, 'info');
    }
  }

  showCowsay(message) {
    if (!message) message = 'ULTIMA MILLA - 22 años innovando';
    
    const cow = `
 ________________________
< ${message.padEnd(20)} >
 ------------------------
        \\   ^__^
         \\  (oo)\\_______
            (__)\\       )\\/\\
                ||----w |
                ||     ||
`;
    this.addOutput(cow, 'ascii');
  }

  showContact() {
    this.addOutput('\n📞 ULTIMA MILLA - Contacto Real\n', 'success');
    this.addOutput('🌐 Web: www.ultimamilla.com.ar', 'info');
    this.addOutput('📧 Email: contacto@ultimamilla.com.ar', 'info');
    this.addOutput('📱 WhatsApp: +54 261 123-4567', 'info');
    this.addOutput('📍 Dirección: Mendoza, Argentina', 'info');
    this.addOutput('🕒 Horario: Lun-Vie 9:00-18:00', 'info');
    this.addOutput('\n💬 ¿Tienes un proyecto? ¡Conversemos!\n', 'tip');
  }

  showAbout() {
    this.addOutput('\n🚀 Sobre ULTIMA MILLA\n', 'success');
    this.addOutput('Somos una empresa de desarrollo de software con 22 años', 'info');
    this.addOutput('de experiencia, especializada en soluciones empresariales.', 'info');
    this.addOutput('\nNuestros servicios:', 'info');
    this.addOutput('• Desarrollo web y móvil', 'info');
    this.addOutput('• Sistemas empresariales', 'info');
    this.addOutput('• Consultoría tecnológica', 'info');
    this.addOutput('• Mantenimiento y soporte', 'info');
    this.addOutput('\n🎯 Transformamos visiones en realidad digital\n', 'tip');
  }

  showServices() {
    this.addOutput('\n🛠️ SERVICIOS ULTIMA MILLA\n', 'success');
    this.addOutput('1. 🌐 Desarrollo Web Corporativo', 'info');
    this.addOutput('   • Sitios institucionales', 'info');
    this.addOutput('   • E-commerce', 'info');
    this.addOutput('   • Web apps', 'info');
    this.addOutput('\n2. 📱 Desarrollo Mobile', 'info');
    this.addOutput('   • Apps nativas', 'info');
    this.addOutput('   • Apps híbridas', 'info');
    this.addOutput('\n3. ⚙️ Sistemas Empresariales', 'info');
    this.addOutput('   • ERP personalizado', 'info');
    this.addOutput('   • CRM avanzado', 'info');
    this.addOutput('\n💡 Solicita cotización: contact\n', 'tip');
  }

  showProjects() {
    this.addOutput('\n🏆 PROYECTOS DESTACADOS\n', 'success');
    this.addOutput('🍷 Sistema de Gestión Vitivinícola', 'info');
    this.addOutput('   • Control de producción', 'info');
    this.addOutput('   • Trazabilidad completa', 'info');
    this.addOutput('\n🏥 Portal de Salud Mendoza', 'info');
    this.addOutput('   • Gestión de turnos', 'info');
    this.addOutput('   • Historia clínica digital', 'info');
    this.addOutput('\n🏪 E-commerce Multi-tienda', 'info');
    this.addOutput('   • 50,000+ productos', 'info');
    this.addOutput('   • Procesamiento de pagos', 'info');
    this.addOutput('\n📊 Ver más: services\n', 'tip');
  }

  showDate() {
    const now = new Date();
    const formatted = now.toLocaleString('es-AR', {
      weekday: 'long',
      year: 'numeric',
      month: 'long',
      day: 'numeric',
      hour: '2-digit',
      minute: '2-digit',
      second: '2-digit',
      timeZoneName: 'short'
    });
    this.addOutput(`\n📅 ${formatted}\n`, 'info');
  }

  showUptime() {
    const uptimeMs = performance.now();
    const seconds = Math.floor(uptimeMs / 1000);
    const minutes = Math.floor(seconds / 60);
    const hours = Math.floor(minutes / 60);
    
    this.addOutput(`\n⏱️ Sistema activo: ${hours}h ${minutes % 60}m ${seconds % 60}s\n`, 'info');
  }

  handleSudo(args) {
    if (args.join(' ') === 'ultimamilla.py --demo') {
      this.addOutput('\n🔐 [SUDO] Iniciando demostración completa...\n', 'success');
      this.showDemo();
    } else {
      this.addOutput('❌ sudo: comando no autorizado', 'error');
      this.addOutput('💡 Prueba: sudo ultimamilla.py --demo', 'tip');
    }
  }

  showDemo() {
    const steps = [
      '🎬 === DEMOSTRACIÓN INTERACTIVA ===',
      '1️⃣ Cargando perfil empresarial...',
      '2️⃣ Conectando con sistemas...',
      '3️⃣ Verificando disponibilidad...',
      '✅ Sistema listo para demostración',
      '',
      '🎯 Comandos sugeridos para la demo:',
      '   • stats    - Estadísticas reales',
      '   • projects - Casos de éxito',
      '   • matrix   - Efecto visual',
      '   • fortune  - Inspiración tech',
      '',
      '📞 ¿Te interesa? Usa: contact',
    ];

    steps.forEach((step, index) => {
      setTimeout(() => {
        this.addOutput(step, index === 0 || index === 4 ? 'success' : 'info');
        if (index === steps.length - 1) {
          this.addOutput('\n🚀 Demo completa. ¡Explora más comandos!\n', 'success');
        }
      }, index * 300);
    });
  }

  showCommandNotFound(cmd) {
    this.addOutput(`❌ Comando "${cmd}" no encontrado`, 'error');
    
    // Suggest similar commands
    const similar = this.findSimilarCommands(cmd);
    if (similar.length > 0) {
      this.addOutput(`💡 ¿Quisiste decir: ${similar.join(', ')}?`, 'tip');
    }
    
    this.addOutput('📖 Usa "help" para ver todos los comandos', 'tip');
  }

  findSimilarCommands(cmd) {
    const commands = Object.keys(this.commands);
    return commands.filter(c => 
      c.includes(cmd) || 
      cmd.includes(c) || 
      this.levenshteinDistance(c, cmd) <= 2
    ).slice(0, 3);
  }

  levenshteinDistance(str1, str2) {
    const matrix = [];
    for (let i = 0; i <= str2.length; i++) {
      matrix[i] = [i];
    }
    for (let j = 0; j <= str1.length; j++) {
      matrix[0][j] = j;
    }
    for (let i = 1; i <= str2.length; i++) {
      for (let j = 1; j <= str1.length; j++) {
        if (str2.charAt(i - 1) === str1.charAt(j - 1)) {
          matrix[i][j] = matrix[i - 1][j - 1];
        } else {
          matrix[i][j] = Math.min(
            matrix[i - 1][j - 1] + 1,
            matrix[i][j - 1] + 1,
            matrix[i - 1][j] + 1
          );
        }
      }
    }
    return matrix[str2.length][str1.length];
  }

  navigateHistory(direction) {
    if (this.commandHistory.length === 0) return;
    
    this.historyIndex += direction;
    
    if (this.historyIndex < 0) {
      this.historyIndex = 0;
    } else if (this.historyIndex >= this.commandHistory.length) {
      this.historyIndex = this.commandHistory.length;
      this.input.value = '';
      return;
    }
    
    this.input.value = this.commandHistory[this.historyIndex] || '';
  }

  autoComplete() {
    const value = this.input.value;
    const matches = Object.keys(this.commands).filter(cmd => 
      cmd.startsWith(value.toLowerCase())
    );
    
    if (matches.length === 1) {
      this.input.value = matches[0];
    } else if (matches.length > 1) {
      this.showSuggestions(matches);
    }
  }

  updateSuggestions(value = '') {
    if (!value) {
      this.hideSuggestions();
      return;
    }
    
    const matches = Object.keys(this.commands).filter(cmd => 
      cmd.toLowerCase().includes(value.toLowerCase())
    ).slice(0, 5);
    
    if (matches.length > 0) {
      this.showSuggestions(matches);
    } else {
      this.hideSuggestions();
    }
  }

  showSuggestions(suggestions) {
    if (!this.suggestionsContainer) return;
    
    this.suggestionsContainer.innerHTML = '';
    suggestions.forEach(suggestion => {
      const item = document.createElement('div');
      item.className = 'suggestion-item';
      item.textContent = `${suggestion} - ${this.commands[suggestion].description}`;
      item.addEventListener('click', () => {
        this.input.value = suggestion;
        this.hideSuggestions();
        this.input.focus();
      });
      this.suggestionsContainer.appendChild(item);
    });
    
    this.suggestionsContainer.style.display = 'block';
  }

  hideSuggestions() {
    if (this.suggestionsContainer) {
      this.suggestionsContainer.style.display = 'none';
    }
  }

  addOutput(content, type = 'default') {
    const outputElement = document.createElement('div');
    outputElement.className = `terminal-output-line ${type}`;
    
    // Handle different output types
    switch (type) {
      case 'command':
        outputElement.style.color = '#ffffff';
        outputElement.style.marginBottom = '5px';
        break;
      case 'success':
        outputElement.style.color = '#00ff88';
        outputElement.style.fontWeight = 'bold';
        break;
      case 'error':
        outputElement.style.color = '#ff4757';
        outputElement.style.fontWeight = 'bold';
        break;
      case 'info':
        outputElement.style.color = '#e6e6e6';
        break;
      case 'tip':
        outputElement.style.color = '#ffa502';
        outputElement.style.fontStyle = 'italic';
        break;
      case 'category':
        outputElement.style.color = '#00ffaa';
        outputElement.style.fontWeight = 'bold';
        outputElement.style.marginTop = '10px';
        break;
      case 'command-list':
        outputElement.style.color = '#cccccc';
        outputElement.style.fontFamily = 'monospace';
        break;
      case 'ascii':
        outputElement.style.color = '#00ffaa';
        outputElement.style.fontFamily = 'monospace';
        outputElement.style.fontSize = '12px';
        outputElement.style.whiteSpace = 'pre';
        break;
      case 'fortune':
        outputElement.style.color = '#ffd700';
        outputElement.style.fontStyle = 'italic';
        outputElement.style.textAlign = 'center';
        break;
    }
    
    // Handle line breaks
    outputElement.innerHTML = content.replace(/\n/g, '<br>');
    
    this.output.appendChild(outputElement);
    this.output.scrollTop = this.output.scrollHeight;
  }

  showLoading() {
    if (this.loadingOverlay) {
      this.loadingOverlay.style.display = 'flex';
      
      // Animate progress bar
      const progressBar = document.getElementById('progress-bar');
      if (progressBar) {
        progressBar.style.width = '0%';
        setTimeout(() => {
          progressBar.style.width = '100%';
        }, 100);
      }
    }
  }

  hideLoading() {
    if (this.loadingOverlay) {
      this.loadingOverlay.style.display = 'none';
    }
  }

  displayWelcomeMessage() {
    // Display ASCII art with typewriter effect
    const asciiArt = `
██╗   ██╗██╗  ████████╗██╗███╗   ███╗ █████╗     
██║   ██║██║  ╚══██╔══╝██║████╗ ████║██╔══██╗    
██║   ██║██║     ██║   ██║██╔████╔██║███████║    
██║   ██║██║     ██║   ██║██║╚██╔╝██║██╔══██║    
╚██████╔╝███████╗██║   ██║██║ ╚═╝ ██║██║  ██║    
 ╚═════╝ ╚══════╝╚═╝   ╚═╝╚═╝     ╚═╝╚═╝  ╚═╝    
                                                  
███╗   ███╗██╗██╗     ██╗      █████╗            
████╗ ████║██║██║     ██║     ██╔══██╗           
██╔████╔██║██║██║     ██║     ███████║           
██║╚██╔╝██║██║██║     ██║     ██╔══██║           
