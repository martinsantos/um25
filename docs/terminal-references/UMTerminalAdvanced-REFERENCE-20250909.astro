`;

    const asciiElement = document.getElementById('welcome-ascii');
    if (asciiElement) {
      this.typewriterEffect(asciiElement, asciiArt, 30);
    }

    // Animate welcome lines
    setTimeout(() => {
      const welcomeLines = document.querySelectorAll('.welcome-line');
      welcomeLines.forEach((line, index) => {
        setTimeout(() => {
          line.classList.add('visible');
        }, index * 300);
      });
    }, 1000);
  }

  typewriterEffect(element, text, speed = 50) {
    element.textContent = '';
    let index = 0;
    
    const type = () => {
      if (index < text.length) {
        element.textContent += text.charAt(index);
        index++;
        setTimeout(type, speed);
      }
    };
    
    type();
  }

  handleControlAction(action) {
    switch (action) {
      case 'close':
        this.addOutput('❌ Terminal cerrado (simulado)', 'error');
        break;
      case 'minimize':
        this.terminal.style.transform = 'scale(0.8)';
        setTimeout(() => {
          this.terminal.style.transform = 'scale(1)';
        }, 300);
        this.addOutput('⬇️ Terminal minimizado (simulado)', 'info');
        break;
      case 'maximize':
        this.terminal.classList.toggle('maximized');
        this.addOutput('🔳 Terminal maximizado (simulado)', 'info');
        break;
    }
  }

  setupMatrix() {
    if (!this.matrixCanvas) return;
    
    this.matrixCtx = this.matrixCanvas.getContext('2d');
    this.resizeMatrix();
    
    window.addEventListener('resize', () => this.resizeMatrix());
  }

  resizeMatrix() {
    if (!this.matrixCanvas || !this.terminal) return;
    
    const rect = this.terminal.getBoundingClientRect();
    this.matrixCanvas.width = rect.width;
    this.matrixCanvas.height = rect.height;
  }

  startMatrixRain() {
    if (!this.matrixCtx) return;
    
    this.matrixCanvas.style.display = 'block';
    
    const chars = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    const columns = this.matrixCanvas.width / 20;
    const drops = Array(Math.floor(columns)).fill(1);
    
    const draw = () => {
      if (this.currentTheme !== 'matrix') return;
      
      this.matrixCtx.fillStyle = 'rgba(0, 0, 0, 0.05)';
      this.matrixCtx.fillRect(0, 0, this.matrixCanvas.width, this.matrixCanvas.height);
      
      this.matrixCtx.fillStyle = '#00ff00';
      this.matrixCtx.font = '15px monospace';
      
      for (let i = 0; i < drops.length; i++) {
        const text = chars[Math.floor(Math.random() * chars.length)];
        this.matrixCtx.fillText(text, i * 20, drops[i] * 20);
        
        if (drops[i] * 20 > this.matrixCanvas.height && Math.random() > 0.975) {
          drops[i] = 0;
        }
        drops[i]++;
      }
      
      setTimeout(() => requestAnimationFrame(draw), 50);
    };
    
    draw();
  }

  stopMatrixRain() {
    if (this.matrixCanvas) {
      this.matrixCanvas.style.display = 'none';
      if (this.matrixCtx) {
        this.matrixCtx.clearRect(0, 0, this.matrixCanvas.width, this.matrixCanvas.height);
      }
    }
  }

  handleResize() {
    if (!this.terminal) return;
    
    const width = window.innerWidth;
    if (width <= 768) {
      this.terminal.classList.add('mobile-view');
    } else {
      this.terminal.classList.remove('mobile-view');
    }
  }

  // Función de test inicial para diagnosticar funcionamiento
  performInitialTest() {
    console.log('🔧 === TERMINAL DIAGNOSTIC TEST ===');
