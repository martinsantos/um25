---
import Layout from '../layouts/Layout.astro';
import SEOHead from '../components/SEO/SEOHead.astro';
import Breadcrumbs from '../components/SEO/Breadcrumbs.astro';

// SEO Data optimizado para contacto local
const seoData = {
  title: "Contacto ULTIMA MILLA Mendoza | Consulta Gratuita Servicios IT | Empresa Tecnológica",
  description: "Contacta con ULTIMA MILLA en Mendoza para una consulta gratuita. +20 años en servicios IT. Presencia local, soporte 24/7. Av. San Martín 1234, Mendoza. Tel: +54 261 123 4567.",
  keywords: "contacto ultima milla mendoza, consulta gratuita IT mendoza, empresa tecnología mendoza, servicios IT mendoza contacto, soporte técnico mendoza, oficina mendoza",
  canonical: "https://ultimamilla.com.ar/contacto"
};

// Breadcrumbs
const breadcrumbs = [
  { name: "Inicio", url: "/" },
  { name: "Contacto", url: "/contacto", current: true }
];
---

<Layout>
  <SEOHead 
    title={seoData.title}
    description={seoData.description}
    keywords={seoData.keywords}
    canonical={seoData.canonical}
    ogType="website"
    breadcrumbs={breadcrumbs}
  />
	<!-- Breadcrumbs Section -->
	<section class="bg-white shadow-sm">
		<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
			<Breadcrumbs items={breadcrumbs} />
		</div>
	</section>

	<!-- Hero Section -->
	<div class="bg-gradient-to-br from-blue-50 to-indigo-100 py-16">
		<div class="max-w-4xl mx-auto px-4 text-center">
			<div class="inline-flex items-center px-4 py-2 rounded-full bg-blue-100 text-blue-800 text-sm font-medium mb-6">
				<svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
					<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"></path>
				</svg>
				¡Hablemos de tu proyecto en Mendoza!
			</div>
			
			<h1 class="text-5xl font-black text-gray-900 mb-6">
				Transforma tu <span class="text-blue-600">empresa</span> en Mendoza
			</h1>
			
			<p class="text-xl text-gray-600 mb-8 max-w-3xl mx-auto">
				Consulta <strong>gratuita</strong> para empresas mendocinas. Te ayudamos a desarrollar la solución tecnológica perfecta con presencia local y soporte 24/7.
			</p>

			<!-- Estadísticas Locales -->
			<div class="grid grid-cols-3 gap-8 mb-12">
				<div class="text-center">
					<div class="text-4xl font-black text-blue-600 mb-2">+469</div>
					<div class="text-gray-600 font-medium">Proyectos Exitosos</div>
				</div>
				<div class="text-center">
					<div class="text-4xl font-black text-green-600 mb-2">+20</div>
					<div class="text-gray-600 font-medium">Años en Mendoza</div>
				</div>
				<div class="text-center">
					<div class="text-4xl font-black text-purple-600 mb-2">24/7</div>
					<div class="text-gray-600 font-medium">Soporte Local</div>
				</div>
			</div>
		</div>
	</div>

	<div class="max-w-7xl mx-auto px-4 py-16">
		<!-- Proceso de Desarrollo -->
		<div class="mb-20">
			<div class="text-center mb-12">
				<h2 class="text-4xl font-black text-gray-900 mb-4">
					Nuestro proceso de <span class="text-blue-600">desarrollo</span>
				</h2>
				<p class="text-xl text-gray-600 max-w-3xl mx-auto">
					Seguimos una metodología probada que garantiza resultados excepcionales y una experiencia sin complicaciones.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
				<!-- Paso 1 -->
				<div class="relative bg-white p-6 rounded-2xl shadow-lg border-2 border-transparent hover:border-blue-400 hover:shadow-2xl hover:shadow-blue-500/25 transform hover:-translate-y-2 transition-all duration-300">
					<div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mb-4">
						<div class="w-6 h-6 bg-blue-600 rounded-full flex items-center justify-center">
							<span class="text-white text-sm font-bold">1</span>
						</div>
					</div>
					<h3 class="text-xl font-black text-gray-900 mb-3">Consulta inicial</h3>
					<p class="text-gray-600">Analizamos tus necesidades y objetivos para entender perfectamente tu visión.</p>
				</div>

				<!-- Paso 2 -->
				<div class="relative bg-white p-6 rounded-2xl shadow-lg border-2 border-transparent hover:border-purple-400 hover:shadow-2xl hover:shadow-purple-500/25 transform hover:-translate-y-2 transition-all duration-300">
					<div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center mb-4">
						<div class="w-6 h-6 bg-purple-600 rounded-full flex items-center justify-center">
							<span class="text-white text-sm font-bold">2</span>
						</div>
					</div>
					<h3 class="text-xl font-black text-gray-900 mb-3">Propuesta & Planificación</h3>
					<p class="text-gray-600">Creamos una propuesta detallada con timeline, presupuesto y especificaciones técnicas.</p>
				</div>

				<!-- Paso 3 -->
				<div class="relative bg-white p-6 rounded-2xl shadow-lg border-2 border-transparent hover:border-orange-400 hover:shadow-2xl hover:shadow-orange-500/25 transform hover:-translate-y-2 transition-all duration-300">
					<div class="w-12 h-12 bg-orange-100 rounded-full flex items-center justify-center mb-4">
						<div class="w-6 h-6 bg-orange-600 rounded-full flex items-center justify-center">
							<span class="text-white text-sm font-bold">3</span>
						</div>
					</div>
					<h3 class="text-xl font-black text-gray-900 mb-3">Desarrollo</h3>
					<p class="text-gray-600">Ejecutamos el proyecto con actualizaciones regulares y comunicación constante.</p>
				</div>

				<!-- Paso 4 -->
				<div class="relative bg-white p-6 rounded-2xl shadow-lg border-2 border-transparent hover:border-green-400 hover:shadow-2xl hover:shadow-green-500/25 transform hover:-translate-y-2 transition-all duration-300">
					<div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mb-4">
						<div class="w-6 h-6 bg-green-600 rounded-full flex items-center justify-center">
							<span class="text-white text-sm font-bold">4</span>
						</div>
					</div>
					<h3 class="text-xl font-black text-gray-900 mb-3">Entrega & Soporte</h3>
					<p class="text-gray-600">Entregamos el proyecto finalizado con documentación y soporte continuo.</p>
				</div>
			</div>
		</div>

		<!-- Formulario y Canales de Contacto -->
		<div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
			<!-- Formulario Mejorado -->
			<div>
				<div class="bg-white p-8 rounded-2xl shadow-xl border border-gray-100">
				<h2 class="text-3xl font-black text-gray-900 mb-6">Cuéntanos sobre tu proyecto en Mendoza</h2>
					<p class="text-gray-600 mb-8">Consulta <strong>gratuita</strong> para empresas mendocinas. Te contactaremos en menos de 24 horas.</p>
					
					<form id="contactForm" class="space-y-6">
						<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
							<div>
								<label for="name" class="block text-sm font-semibold text-gray-700 mb-2">Nombre completo *</label>
								<input
									type="text"
									id="name"
									name="name"
									required
									placeholder="Tu nombre"
									class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/20 transition-all duration-200"
								/>
								<span class="text-red-500 text-sm hidden" id="nameError"></span>
							</div>
							<div>
								<label for="company" class="block text-sm font-semibold text-gray-700 mb-2">Empresa</label>
								<input
									type="text"
									id="company"
									name="company"
									placeholder="Nombre de tu empresa"
									class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/20 transition-all duration-200"
								/>
							</div>
						</div>

						<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
							<div>
								<label for="email" class="block text-sm font-semibold text-gray-700 mb-2">Email *</label>
								<input
									type="email"
									id="email"
									name="email"
									required
									placeholder="tu@email.com"
									class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/20 transition-all duration-200"
								/>
								<span class="text-red-500 text-sm hidden" id="emailError"></span>
							</div>
							<div>
								<label for="phone" class="block text-sm font-semibold text-gray-700 mb-2">Teléfono</label>
								<input
									type="tel"
									id="phone"
									name="phone"
									placeholder="+54 (11) 1234-5678"
									class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/20 transition-all duration-200"
								/>
							</div>
						</div>

						<div>
							<label for="projectType" class="block text-sm font-semibold text-gray-700 mb-2">Tipo de proyecto *</label>
							<div class="grid grid-cols-2 md:grid-cols-4 gap-3">
								<label class="flex items-center p-3 border-2 border-gray-200 rounded-lg cursor-pointer hover:border-blue-500 transition-colors">
									<input type="checkbox" name="projectType" value="sitio-web" class="sr-only">
									<div class="w-4 h-4 border-2 border-gray-300 rounded mr-3 flex items-center justify-center">
										<div class="w-2 h-2 bg-blue-500 rounded hidden"></div>
									</div>
									<span class="text-sm font-medium">Sitio Web</span>
								</label>
								<label class="flex items-center p-3 border-2 border-gray-200 rounded-lg cursor-pointer hover:border-blue-500 transition-colors">
									<input type="checkbox" name="projectType" value="ecommerce" class="sr-only">
									<div class="w-4 h-4 border-2 border-gray-300 rounded mr-3 flex items-center justify-center">
										<div class="w-2 h-2 bg-blue-500 rounded hidden"></div>
									</div>
									<span class="text-sm font-medium">E-commerce</span>
								</label>
								<label class="flex items-center p-3 border-2 border-gray-200 rounded-lg cursor-pointer hover:border-blue-500 transition-colors">
									<input type="checkbox" name="projectType" value="app-movil" class="sr-only">
									<div class="w-4 h-4 border-2 border-gray-300 rounded mr-3 flex items-center justify-center">
										<div class="w-2 h-2 bg-blue-500 rounded hidden"></div>
									</div>
									<span class="text-sm font-medium">App Móvil</span>
								</label>
								<label class="flex items-center p-3 border-2 border-gray-200 rounded-lg cursor-pointer hover:border-blue-500 transition-colors">
									<input type="checkbox" name="projectType" value="otro" class="sr-only">
									<div class="w-4 h-4 border-2 border-gray-300 rounded mr-3 flex items-center justify-center">
										<div class="w-2 h-2 bg-blue-500 rounded hidden"></div>
									</div>
									<span class="text-sm font-medium">Otro</span>
								</label>
							</div>
						</div>

						<div>
							<label for="budget" class="block text-sm font-semibold text-gray-700 mb-2">Presupuesto estimado *</label>
							<div class="grid grid-cols-2 md:grid-cols-4 gap-3">
								<label class="flex items-center p-3 border-2 border-gray-200 rounded-lg cursor-pointer hover:border-blue-500 transition-colors">
									<input type="radio" name="budget" value="5000-15000" class="sr-only">
									<div class="w-4 h-4 border-2 border-gray-300 rounded-full mr-3 flex items-center justify-center">
										<div class="w-2 h-2 bg-blue-500 rounded-full hidden"></div>
									</div>
									<span class="text-sm font-medium">$5,000 - $15,000</span>
								</label>
								<label class="flex items-center p-3 border-2 border-gray-200 rounded-lg cursor-pointer hover:border-blue-500 transition-colors">
									<input type="radio" name="budget" value="15000-35000" class="sr-only">
									<div class="w-4 h-4 border-2 border-gray-300 rounded-full mr-3 flex items-center justify-center">
										<div class="w-2 h-2 bg-blue-500 rounded-full hidden"></div>
									</div>
									<span class="text-sm font-medium">$15,000 - $35,000</span>
								</label>
								<label class="flex items-center p-3 border-2 border-gray-200 rounded-lg cursor-pointer hover:border-blue-500 transition-colors">
									<input type="radio" name="budget" value="35000-75000" class="sr-only">
									<div class="w-4 h-4 border-2 border-gray-300 rounded-full mr-3 flex items-center justify-center">
										<div class="w-2 h-2 bg-blue-500 rounded-full hidden"></div>
									</div>
									<span class="text-sm font-medium">$35,000 - $75,000</span>
								</label>
								<label class="flex items-center p-3 border-2 border-gray-200 rounded-lg cursor-pointer hover:border-blue-500 transition-colors">
									<input type="radio" name="budget" value="75000+" class="sr-only">
									<div class="w-4 h-4 border-2 border-gray-300 rounded-full mr-3 flex items-center justify-center">
										<div class="w-2 h-2 bg-blue-500 rounded-full hidden"></div>
									</div>
									<span class="text-sm font-medium">$75,000+</span>
								</label>
							</div>
						</div>

						<div>
							<label for="timeline" class="block text-sm font-semibold text-gray-700 mb-2">Timeline preferido *</label>
							<div class="grid grid-cols-2 md:grid-cols-4 gap-3">
								<label class="flex flex-col items-center p-4 border-2 border-gray-200 rounded-lg cursor-pointer hover:border-blue-500 transition-colors">
									<input type="radio" name="timeline" value="1-2-meses" class="sr-only">
									<svg class="w-6 h-6 text-gray-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
									</svg>
									<span class="text-sm font-medium">1-2 meses</span>
								</label>
								<label class="flex flex-col items-center p-4 border-2 border-gray-200 rounded-lg cursor-pointer hover:border-blue-500 transition-colors">
									<input type="radio" name="timeline" value="2-4-meses" class="sr-only">
									<svg class="w-6 h-6 text-gray-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
									</svg>
									<span class="text-sm font-medium">2-4 meses</span>
								</label>
								<label class="flex flex-col items-center p-4 border-2 border-gray-200 rounded-lg cursor-pointer hover:border-blue-500 transition-colors">
									<input type="radio" name="timeline" value="4-6-meses" class="sr-only">
									<svg class="w-6 h-6 text-gray-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
									</svg>
									<span class="text-sm font-medium">4-6 meses</span>
								</label>
								<label class="flex flex-col items-center p-4 border-2 border-gray-200 rounded-lg cursor-pointer hover:border-blue-500 transition-colors">
									<input type="radio" name="timeline" value="6+-meses" class="sr-only">
									<svg class="w-6 h-6 text-gray-400 mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
										<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"></path>
									</svg>
									<span class="text-sm font-medium">6+ meses</span>
								</label>
							</div>
						</div>

						<div>
							<label for="message" class="block text-sm font-semibold text-gray-700 mb-2">Descripción del proyecto *</label>
							<textarea
								id="message"
								name="message"
								required
								rows="4"
								placeholder="Describe tu proyecto, objetivos, funcionalidades necesarias, y cualquier detalle importante..."
								class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg focus:outline-none focus:border-blue-500 focus:ring-4 focus:ring-blue-500/20 transition-all duration-200"
							></textarea>
							<span class="text-red-500 text-sm hidden" id="messageError"></span>
						</div>

						<button
							type="submit"
							class="w-full bg-gradient-to-r from-blue-600 to-blue-700 hover:from-blue-700 hover:to-blue-800 text-white font-bold py-4 px-6 rounded-lg transition-all duration-300 transform hover:scale-[1.02] hover:shadow-lg"
						>
							Enviar Proyecto
						</button>

						<!-- Mensajes de estado -->
						<div id="successMessage" class="hidden bg-green-50 border border-green-200 text-green-700 p-4 rounded-lg">
							Mensaje enviado exitosamente. Nos pondremos en contacto contigo pronto.
						</div>
						<div id="errorMessage" class="hidden bg-red-50 border border-red-200 text-red-700 p-4 rounded-lg">
							Hubo un error al enviar el mensaje. Por favor, intenta nuevamente.
						</div>
					</form>
				</div>
			</div>

			<!-- Canales de Contacto -->
			<div class="space-y-8">
				<!-- Título -->
				<div class="text-center lg:text-left">
					<h2 class="text-3xl font-black text-gray-900 mb-4">
						Contacto directo en <span class="text-blue-600">Mendoza</span>
					</h2>
					<p class="text-gray-600">
						Presencia local con atención personalizada. Estamos disponibles a través de múltiples canales para empresas mendocinas.
					</p>
				</div>

				<!-- Cards de Contacto -->
				<div class="grid gap-6">
					<!-- Email -->
					<div class="bg-white p-6 rounded-2xl shadow-lg border-2 border-transparent hover:border-blue-400 hover:shadow-2xl hover:shadow-blue-500/25 transform hover:-translate-y-1 transition-all duration-300">
						<div class="flex items-center space-x-4">
							<div class="w-14 h-14 bg-blue-100 rounded-xl flex items-center justify-center">
								<svg class="w-7 h-7 text-blue-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
								</svg>
							</div>
							<div class="flex-1">
								<h3 class="text-xl font-black text-gray-900">Email Mendoza</h3>
								<p class="text-gray-600 text-sm mb-2">Escríbenos directamente</p>
								<p class="text-blue-600 font-semibold">contacto@ultimamilla.com.ar</p>
							</div>
							<a href="mailto:contacto@ultimamilla.com.ar" class="bg-blue-600 hover:bg-blue-700 text-white px-4 py-2 rounded-lg font-medium transition-colors">
								Enviar email
							</a>
						</div>
					</div>

					<!-- Teléfono -->
					<div class="bg-white p-6 rounded-2xl shadow-lg border-2 border-transparent hover:border-green-400 hover:shadow-2xl hover:shadow-green-500/25 transform hover:-translate-y-1 transition-all duration-300">
						<div class="flex items-center space-x-4">
							<div class="w-14 h-14 bg-green-100 rounded-xl flex items-center justify-center">
								<svg class="w-7 h-7 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
									<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
								</svg>
							</div>
							<div class="flex-1">
								<h3 class="text-xl font-black text-gray-900">Teléfono Mendoza</h3>
								<p class="text-gray-600 text-sm mb-2">Llamanos para consultas rápidas</p>
								<p class="text-green-600 font-semibold">+54 261 123 4567</p>
							</div>
							<a href="tel:+5426112340567" class="bg-green-600 hover:bg-green-700 text-white px-4 py-2 rounded-lg font-medium transition-colors">
								Llamar ahora
							</a>
						</div>
					</div>

					<!-- WhatsApp -->
					<div class="bg-white p-6 rounded-2xl shadow-lg border-2 border-transparent hover:border-orange-400 hover:shadow-2xl hover:shadow-orange-500/25 transform hover:-translate-y-1 transition-all duration-300">
						<div class="flex items-center space-x-4">
							<div class="w-14 h-14 bg-orange-100 rounded-xl flex items-center justify-center">
								<svg class="w-7 h-7 text-orange-600" fill="currentColor" viewBox="0 0 24 24">
