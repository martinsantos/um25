<script>
	// Manejo del formulario
	const form = document.getElementById('contactForm') as HTMLFormElement;
	const successMessage = document.getElementById('successMessage');
	const errorMessage = document.getElementById('errorMessage');
	const errorElements = {
		name: document.getElementById('nameError'),
		email: document.getElementById('emailError'),
		message: document.getElementById('messageError')
	};

	// Funcionalidad de checkboxes y radio buttons personalizados
	document.addEventListener('DOMContentLoaded', () => {
		// Checkboxes
		document.querySelectorAll('input[type="checkbox"]').forEach(checkbox => {
			checkbox.addEventListener('change', function() {
				const label = this.closest('label');
				const indicator = label?.querySelector('div > div');
				if (this.checked) {
					label?.classList.add('border-blue-500', 'bg-blue-50');
					indicator?.classList.remove('hidden');
				} else {
					label?.classList.remove('border-blue-500', 'bg-blue-50');
					indicator?.classList.add('hidden');
				}
			});
		});

		// Radio buttons
		document.querySelectorAll('input[type="radio"]').forEach(radio => {
			radio.addEventListener('change', function() {
				const name = this.name;
				// Reset all radio buttons with same name
				document.querySelectorAll(`input[name="${name}"]`).forEach(r => {
					const label = r.closest('label');
					const indicator = label?.querySelector('div > div');
					label?.classList.remove('border-blue-500', 'bg-blue-50');
					indicator?.classList.add('hidden');
				});
				
				// Set current selection
				const label = this.closest('label');
				const indicator = label?.querySelector('div > div');
				label?.classList.add('border-blue-500', 'bg-blue-50');
				indicator?.classList.remove('hidden');
			});
		});
	});

	// Función para validar email
	function isValidEmail(email: string) {
		const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
		return re.test(email);
	}

	// Función para mostrar errores
	function showError(field: keyof typeof errorElements, message: string) {
		const errorElement = errorElements[field];
		if (errorElement) {
			errorElement.textContent = message;
			errorElement.classList.remove('hidden');
		}
	}

	// Función para limpiar errores
	function clearErrors() {
		Object.values(errorElements).forEach(element => {
			if (element) {
				element.textContent = '';
				element.classList.add('hidden');
			}
		});
		successMessage?.classList.add('hidden');
		errorMessage?.classList.add('hidden');
	}

	if (form) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			clearErrors();

			const formData = new FormData(form);
			const data = Object.fromEntries(formData);
			let hasErrors = false;

			// Validaciones
			if (!data.name) {
				showError('name', 'El nombre es requerido');
				hasErrors = true;
			}

			if (!data.email) {
				showError('email', 'El email es requerido');
				hasErrors = true;
			} else if (!isValidEmail(data.email.toString())) {
				showError('email', 'Por favor ingresa un email válido');
				hasErrors = true;
			}

			if (!data.message) {
				showError('message', 'El mensaje es requerido');
				hasErrors = true;
			}

			if (hasErrors) return;

			try {
				// Simular envío (reemplazar con endpoint real)
				await new Promise(resolve => setTimeout(resolve, 1000));
				
				if (successMessage) {
					successMessage.classList.remove('hidden');
					form.reset();
					// Reset custom form elements
					document.querySelectorAll('label').forEach(label => {
						label.classList.remove('border-blue-500', 'bg-blue-50');
						const indicator = label.querySelector('div > div');
						indicator?.classList.add('hidden');
					});
				}
			} catch (error) {
				if (errorMessage) {
					errorMessage.classList.remove('hidden');
					errorMessage.textContent = 'Error al enviar el mensaje. Por favor, intenta nuevamente.';
				}
			}
		});
	}
</script>
