---
// home-with-cli.astro - Página home con UM CLI integrado
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
---

<Layout title="ULTIMA MILLA - Conectando el futuro desde 2003">
  <!-- Hero section existente -->
  <Hero />
  
  <!-- Sección del UM CLI -->
  <section class="um-cli-section">
    <div class="container">
      <div class="cli-intro">
        <h2>🖥️ Explora ULTIMA MILLA</h2>
        <p>Descubre nuestros servicios, proyectos y capacidades a través de nuestro terminal interactivo. Una experiencia única que combina la nostalgia de Linux con datos reales de 22 años de historia empresarial.</p>
      </div>
      
      <!-- Container para el CLI -->
      <div id="um-cli-container"></div>
      
      <!-- Sugerencias rápidas -->
      <div class="cli-suggestions">
        <h3>💡 Comandos sugeridos para empezar:</h3>
        <div class="suggestion-grid">
          <button class="suggestion-btn" data-command="help">
            <code>help</code>
            <span>Ver todos los comandos</span>
          </button>
          <button class="suggestion-btn" data-command="sudo ultimamilla.py --demo">
            <code>sudo ultimamilla.py --demo</code>
            <span>Demostración completa</span>
          </button>
          <button class="suggestion-btn" data-command="grep Quilmes">
            <code>grep "Quilmes"</code>
            <span>Buscar proyectos de Quilmes</span>
          </button>
          <button class="suggestion-btn" data-command="stats --clientes">
            <code>stats --clientes</code>
            <span>Estadísticas de clientes</span>
          </button>
          <button class="suggestion-btn" data-command="ls servicios">
            <code>ls servicios</code>
            <span>Ver nuestros servicios</span>
          </button>
          <button class="suggestion-btn" data-command="top --proyectos">
            <code>top --proyectos</code>
            <span>Proyectos más grandes</span>
          </button>
        </div>
      </div>
    </div>
  </section>
  
  <!-- Resto del contenido de la página -->
  <!-- Aquí irían las otras secciones de la home -->
  
</Layout>

<style>
  .um-cli-section {
    background: linear-gradient(135deg, #0f1419 0%, #161b22 50%, #21262d 100%);
    padding: 80px 0;
    position: relative;
    overflow: hidden;
  }

  .um-cli-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(circle at 20% 50%, rgba(0, 212, 170, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 50%, rgba(121, 192, 255, 0.1) 0%, transparent 50%);
    pointer-events: none;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 1;
  }

  .cli-intro {
    text-align: center;
    margin-bottom: 40px;
  }

  .cli-intro h2 {
    font-size: 2.5rem;
    color: #00d4aa;
    margin-bottom: 16px;
    font-weight: 700;
    text-shadow: 0 0 20px rgba(0, 212, 170, 0.3);
  }

  .cli-intro p {
    font-size: 1.2rem;
    color: #8b949e;
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.6;
  }

  #um-cli-container {
    margin: 40px 0;
    position: relative;
    z-index: 2;
  }

  .cli-suggestions {
    margin-top: 40px;
  }

  .cli-suggestions h3 {
    color: #e6edf3;
    font-size: 1.3rem;
    margin-bottom: 24px;
    text-align: center;
  }

  .suggestion-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 16px;
    max-width: 1000px;
    margin: 0 auto;
  }

  .suggestion-btn {
    background: rgba(33, 38, 45, 0.8);
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 16px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .suggestion-btn:hover {
    background: rgba(33, 38, 45, 1);
    border-color: #00d4aa;
    box-shadow: 0 4px 12px rgba(0, 212, 170, 0.2);
    transform: translateY(-2px);
  }

  .suggestion-btn code {
    background: rgba(110, 118, 129, 0.15);
    color: #79c0ff;
    padding: 6px 10px;
    border-radius: 4px;
    font-family: 'Fira Code', 'SF Mono', monospace;
    font-size: 0.9rem;
    font-weight: 600;
    border: 1px solid rgba(121, 192, 255, 0.3);
  }

  .suggestion-btn span {
    color: #8b949e;
    font-size: 0.9rem;
    line-height: 1.4;
  }

  .suggestion-btn:hover code {
    color: #00d4aa;
    border-color: rgba(0, 212, 170, 0.5);
    background: rgba(0, 212, 170, 0.1);
  }

  /* Responsive */
  @media (max-width: 768px) {
    .um-cli-section {
      padding: 60px 0;
    }

    .cli-intro h2 {
      font-size: 2rem;
    }

    .cli-intro p {
      font-size: 1rem;
    }

    .suggestion-grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .suggestion-btn {
      padding: 12px;
    }

    .container {
      padding: 0 15px;
    }
  }

  /* Animaciones */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .cli-intro {
    animation: fadeInUp 0.6s ease-out;
  }

  .suggestion-grid {
    animation: fadeInUp 0.6s ease-out 0.3s both;
  }

  /* Efecto de typing para el titulo */
  .cli-intro h2 {
    overflow: hidden;
    border-right: 3px solid #00d4aa;
    white-space: nowrap;
    animation: 
      typing 2s steps(20, end),
      blink-caret 0.75s step-end infinite;
  }

  @keyframes typing {
    from { width: 0 }
    to { width: 100% }
  }

  @keyframes blink-caret {
    from, to { border-color: transparent }
    50% { border-color: #00d4aa }
  }
</style>

<script>
  // Importar el plugin UM CLI
  import('../plugins/UMCliPlugin.js').then(module => {
    const UMCliPlugin = module.default;
    
    // Inicializar el CLI cuando se carga la página
    document.addEventListener('DOMContentLoaded', () => {
      // Crear instancia del CLI
      const umCli = new UMCliPlugin({
        container: '#um-cli-container',
        theme: 'dark',
        showWelcome: true,
        autoFocus: false, // No autoenfocamos para evitar scroll automático
        customCommands: {
          // Comando personalizado para contacto
          'contacto': async () => ({
            success: true,
            output: `
📞 INFORMACIÓN DE CONTACTO - ULTIMA MILLA

🏢 Oficina Principal
📍 Mendoza, Argentina
📧 info@ultimamilla.com
🌐 www.ultimamilla.com
📱 WhatsApp: +54 261 XXX-XXXX

💼 Áreas de Contacto:
• Ventas: ventas@ultimamilla.com
• Soporte: soporte@ultimamilla.com  
• Proyectos: proyectos@ultimamilla.com
• RRHH: rrhh@ultimamilla.com

⏰ Horarios de atención:
Lunes a Viernes: 9:00 - 18:00 ART
Soporte 24/7 para clientes premium

¿Listo para conectar el futuro juntos? 🚀
            `
          }),

          // Comando de presupuesto
          'presupuesto': async () => ({
            success: true,
            output: `
💰 SOLICITAR PRESUPUESTO - ULTIMA MILLA

📋 Para generar un presupuesto personalizado, proporcionanos:

🔧 TIPO DE PROYECTO:
• Redes y comunicaciones
• Software a medida  
• Sistemas de seguridad (CCTV/SDI)
• Soporte IT y mantenimiento
• Consultoría tecnológica

📏 ALCANCE:
• Pequeño (< $500K)
• Mediano ($500K - $2M) 
• Grande ($2M - $5M)
• Enterprise (> $5M)

📞 CONTACTA CON NUESTRO EQUIPO:
• Email: presupuestos@ultimamilla.com
• Formulario web: www.ultimamilla.com/presupuesto
• WhatsApp: +54 261 XXX-XXXX

⚡ Respuesta en 24-48 horas hábiles
🎯 22 años de experiencia nos respaldan
            `
          })
        }
      });

      // Event listeners para los botones de sugerencias
      const suggestionButtons = document.querySelectorAll('.suggestion-btn');
      suggestionButtons.forEach(button => {
        button.addEventListener('click', () => {
          const command = button.dataset.command;
          if (command) {
            // Ejecutar el comando y enfocar el terminal
            umCli.executeCommandProgrammatically(command);
            umCli.focus();
            
            // Scroll suave hacia el terminal
            document.getElementById('um-cli-container').scrollIntoView({
              behavior: 'smooth',
              block: 'center'
            });
          }
        });
      });

      // Eventos personalizados del CLI
      umCli.on('commandExecuted', (event) => {
        console.log('Comando ejecutado:', event.detail.command);
        
        // Analytics: trackear comandos populares
        if (typeof gtag !== 'undefined') {
          gtag('event', 'cli_command_executed', {
            'command': event.detail.command.raw || 'unknown',
            'success': event.detail.command.success
          });
        }
      });

      umCli.on('fullscreenToggled', (event) => {
        console.log('Fullscreen toggled:', event.detail.isFullscreen);
      });

      // Mostrar mensaje especial en el primer uso
      setTimeout(() => {
        const welcomeCommands = [
          '🎯 ¡Bienvenido a ULTIMA MILLA CLI!',
          '💡 Tip: Usa TAB para autocompletar comandos',
          '🚀 Prueba "sudo ultimamilla.py --demo" para una demo completa',
          ''
        ];
        
        welcomeCommands.forEach((msg, i) => {
          setTimeout(() => {
            if (msg) {
              umCli.addOutput(msg, 'um-command-info');
            }
          }, i * 800);
        });
      }, 2000);
    });
  });

  // Animación de entrada para los elementos
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.animation = 'fadeInUp 0.6s ease-out forwards';
      }
    });
  }, observerOptions);

  // Observar elementos cuando se carga la página
  document.addEventListener('DOMContentLoaded', () => {
    const elements = document.querySelectorAll('.cli-suggestions, #um-cli-container');
    elements.forEach(el => observer.observe(el));
  });
</script>

<noscript>
  <div class="no-js-message">
    <h3>Terminal no disponible</h3>
    <p>Para una experiencia completa, habilita JavaScript en tu navegador.</p>
    <p>Mientras tanto, puedes contactarnos en: <a href="mailto:info@ultimamilla.com">info@ultimamilla.com</a></p>
  </div>
  
  <style>
    .no-js-message {
      background: #1a1a2e;
      color: #eee;
      padding: 40px;
      text-align: center;
      border-radius: 8px;
      margin: 40px auto;
      max-width: 600px;
      border: 2px solid #00d4aa;
    }
    
    .no-js-message a {
      color: #00d4aa;
      text-decoration: none;
    }
    
    .no-js-message a:hover {
      text-decoration: underline;
    }
  </style>
</noscript>
