---
/**
 * LayoutV4 - Layout principal V4 Design System
 * - Integra NavbarV4 + FooterV4
 * - SEO delegado a SEOHead component
 * - Open Sans font
 * - V4 custom styles
 */

import NavbarV4 from '../components/v4/NavbarV4.astro';
import FooterV4 from '../components/v4/FooterV4.astro';
import SEOHead from '../components/SEO/SEOHead.astro';
import '../styles/v4.css';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  canonical?: string;
  ogType?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  gscVerification?: string;
}

const {
  title,
  description,
  keywords,
  image,
  canonical,
  ogType = 'website',
  structuredData,
  noindex = false,
  gscVerification = 'TSoaOAODUVxCt2ohPOomFxRxF3I_MMKzu_wmbpFVpuw',
} = Astro.props;

const siteUrl = "https://ultimamilla.com.ar";
// Always build currentUrl from hardcoded siteUrl to prevent www leaking via Astro.url or canonical prop
const currentUrl = (canonical ? canonical.replace(/^https?:\/\/www\./, 'https://') : `${siteUrl}${Astro.url.pathname}`).replace(/\/$/, "");

const hasHeadSlot = Astro.slots.has('head');

// Build breadcrumb trail from URL path
const breadcrumbs: Array<{ name: string; url: string }> = [
  { name: "Inicio", url: siteUrl },
];

if (Astro.url.pathname !== "/") {
  const segments = Astro.url.pathname.split("/").filter(Boolean);
  let pathAccumulator = "";
  segments.forEach((segment) => {
    pathAccumulator += `/${segment}`;
    breadcrumbs.push({
      name: segment.split("-").map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(" "),
      url: `${siteUrl}${pathAccumulator}`,
    });
  });
}

const currentYear = new Date().getFullYear();
---

<!DOCTYPE html>
<html lang="es">
  <head>
    <!-- SEOHead — handles all meta, OG, Twitter, schema, canonical, hreflang, favicon -->
    <SEOHead
      title={title}
      description={description}
      keywords={keywords}
      ogImage={image}
      canonical={currentUrl}
      ogType={ogType}
      structuredData={structuredData}
      noindex={noindex}
      hreflang={true}
      gscVerification={gscVerification}
      breadcrumbs={breadcrumbs}
    />

    <!-- Fonts - Open Sans + Futura PT (marca) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://fonts.cdnfonts.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700;800&display=swap" rel="stylesheet" />
    <link href="https://fonts.cdnfonts.com/css/futura-pt" rel="stylesheet" />

    {hasHeadSlot && <slot name="head" />}

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-S2376K1GED"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-S2376K1GED');
    </script>

    <!-- V4 Custom Styles -->
    <style is:global>
      /* V4 Design System - Base Styles */
      body {
        font-family: 'Open Sans', system-ui, -apple-system, sans-serif;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        max-width: 100vw;
        background-color: #ffffff;
        color: #111827;
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* Card hover animation */
      .card-hover {
        transition: all 0.3s ease;
      }
      .card-hover:hover {
        transform: translateY(-8px);
        box-shadow: 0 20px 40px rgba(0,0,0,0.15);
      }

      /* Animations */
      .animate-fade-in {
        animation: fadeIn 0.8s ease forwards;
        opacity: 0;
      }
      .animate-slide-up {
        animation: slideUp 0.8s ease forwards;
        opacity: 0;
        transform: translateY(30px);
      }
      @keyframes fadeIn {
        to { opacity: 1; }
      }
      @keyframes slideUp {
        to { opacity: 1; transform: translateY(0); }
      }

      /* Typography fluid */
      .text-fluid-hero {
        font-size: clamp(1.75rem, 6vw, 3.5rem);
        line-height: 1.1;
      }
      .text-fluid-title {
        font-size: clamp(1.5rem, 4vw, 2.25rem);
      }
      .text-fluid-body {
        font-size: clamp(0.9rem, 2.5vw, 1.125rem);
      }

      /* Section padding fluid */
      .section-padding {
        padding-top: clamp(2.5rem, 8vw, 5rem);
        padding-bottom: clamp(2.5rem, 8vw, 5rem);
      }

      /* Touch targets */
      .touch-target {
        min-height: 44px;
        min-width: 44px;
      }

      /* Line clamp utilities */
      .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      /* Safe area for iPhone notch */
      @supports (padding: env(safe-area-inset-bottom)) {
        .safe-bottom {
          padding-bottom: calc(1rem + env(safe-area-inset-bottom));
        }
      }

      /* Reduced motion */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }

      /* Reset base link colors for V4 */
      a {
        color: inherit;
        text-decoration: none;
      }
    </style>
  </head>
  <body>
    <NavbarV4 />

    <main>
      <slot />
    </main>

    <FooterV4 />
  </body>
</html>
