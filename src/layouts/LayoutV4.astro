---
/**
 * LayoutV4 - Layout principal V4 Design System
 * - Integra NavbarV4 + FooterV4
 * - SEO delegado a SEOHead component
 * - Open Sans font
 * - V4 custom styles
 */

import NavbarV4 from '../components/v4/NavbarV4.astro';
import FooterV4 from '../components/v4/FooterV4.astro';
import SEOHead from '../components/SEO/SEOHead.astro';
import { getDevSkinVariant } from '../utils/skinVariant';
import '../styles/v4.css';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  canonical?: string;
  ogType?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  gscVerification?: string;
}

const {
  title,
  description,
  keywords,
  image,
  canonical,
  ogType = 'website',
  structuredData,
  noindex = false,
  gscVerification = 'TSoaOAODUVxCt2ohPOomFxRxF3I_MMKzu_wmbpFVpuw',
} = Astro.props;

const siteUrl = "https://ultimamilla.com.ar";
// Always build currentUrl from hardcoded siteUrl to prevent www leaking via Astro.url or canonical prop
const currentUrl = (canonical ? canonical.replace(/^https?:\/\/www\./, 'https://') : `${siteUrl}${Astro.url.pathname}`).replace(/\/$/, "");

const hasHeadSlot = Astro.slots.has('head');

// Build breadcrumb trail from URL path
const breadcrumbs: Array<{ name: string; url: string }> = [
  { name: "Inicio", url: siteUrl },
];

if (Astro.url.pathname !== "/") {
  const segments = Astro.url.pathname.split("/").filter(Boolean);
  let pathAccumulator = "";
  segments.forEach((segment) => {
    pathAccumulator += `/${segment}`;
    breadcrumbs.push({
      name: segment.split("-").map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(" "),
      url: `${siteUrl}${pathAccumulator}`,
    });
  });
}

const skinVariant = getDevSkinVariant(Astro.url, import.meta.env.DEV) ?? 'hybrid';
const skinAttribute = skinVariant;
const pageLang = Astro.url.pathname === '/en' || Astro.url.pathname.startsWith('/en/') ? 'en' : 'es';
const skipLinkLabel = pageLang === 'en' ? 'Skip to main content' : 'Saltar al contenido principal';
---

<!DOCTYPE html>
<html lang={pageLang}>
  <head>
    <!-- SEOHead — handles all meta, OG, Twitter, schema, canonical, hreflang, favicon -->
    <SEOHead
      title={title}
      description={description}
      keywords={keywords}
      ogImage={image}
      canonical={currentUrl}
      ogType={ogType}
      structuredData={structuredData}
      noindex={noindex}
      hreflang={true}
      gscVerification={gscVerification}
      breadcrumbs={breadcrumbs}
    />

    <!-- Fonts - Poppins 600 titulares + Open Sans cuerpo + Futura PT logo/marca -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preconnect" href="https://fonts.cdnfonts.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&family=Poppins:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <link href="https://fonts.cdnfonts.com/css/futura-pt" rel="stylesheet" />

    {hasHeadSlot && <slot name="head" />}

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-S2376K1GED"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-S2376K1GED');
    </script>

    <!-- V4 Custom Styles -->
    <style is:global>
      /* V4 Design System - Base Styles */
      body {
        font-family: var(--um-font-body);
        font-synthesis: none;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        width: 100%;
        max-width: 100%;
        background-color: var(--skin-page);
        color: var(--skin-text);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
      }

      /* Static cards: hierarchy comes from layout, not motion or shadows. */
      .card-hover {
        transition: border-color 0.18s ease, background-color 0.18s ease;
      }
      .card-hover:hover {
        transform: none;
        box-shadow: none;
      }


      /* Typography fluid */
      .text-fluid-hero {
        font-size: clamp(2.125rem, 6vw, 3.8rem);
        line-height: 1.1;
      }
      .text-fluid-title {
        font-size: clamp(1.75rem, 4vw, 2.5rem);
      }
      .text-fluid-body {
        font-size: clamp(1rem, 2.5vw, 1.125rem);
      }

      /* Section padding fluid */
      .section-padding {
        padding-top: clamp(2.5rem, 8vw, 5rem);
        padding-bottom: clamp(2.5rem, 8vw, 5rem);
      }

      /* Touch targets */
      .touch-target {
        min-height: 44px;
        min-width: 44px;
      }

      /* Line clamp utilities */
      .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      /* Safe area for iPhone notch */
      @supports (padding: env(safe-area-inset-bottom)) {
        .safe-bottom {
          padding-bottom: calc(1rem + env(safe-area-inset-bottom));
        }
      }

      /* Reduced motion */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }

      /* Reset base link colors for V4 */
      a {
        color: inherit;
        text-decoration: none;
      }

      .um-skip-link {
        position: absolute;
        left: -9999px;
        top: auto;
        width: 1px;
        height: 1px;
        overflow: hidden;
        z-index: 10000;
        padding: 12px 18px;
        background: #111;
        color: #fff;
        font-weight: 600;
        text-decoration: none;
      }

      .um-skip-link:focus {
        left: 16px;
        top: 16px;
        width: auto;
        height: auto;
        overflow: visible;
        outline: 2px solid var(--um-red);
        outline-offset: 2px;
      }
    </style>
  </head>
  <body data-skin={skinAttribute}>
    <a class="um-skip-link" href="#main-content">{skipLinkLabel}</a>
    <NavbarV4 />

    <main id="main-content">
      <slot />
    </main>

    <FooterV4 />
  </body>
</html>
