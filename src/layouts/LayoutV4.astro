---
/**
 * LayoutV4 - Layout principal V4 Design System
 * - Integra NavbarV4 + FooterV4
 * - SEO delegado a SEOHead component
 * - V4 typography tokens
 * - V4 custom styles
 */

import NavbarV4 from '../components/v4/NavbarV4.astro';
import FooterV4 from '../components/v4/FooterV4.astro';
import AppTabBar from '../components/v4/AppTabBar.astro';
import AppInstallHint from '../components/v4/AppInstallHint.astro';
import ContactModal from '../components/um/ContactModal.astro';
import SEOHead from '../components/SEO/SEOHead.astro';
import { SITE_URL } from '../config/seo';
import { hasEnglishAlternate, resolvePageLanguage } from '../config/i18nRoutes';
import { getDevSkinVariant } from '../utils/skinVariant';
import '../styles/v4.css';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  canonical?: string;
  ogType?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  gscVerification?: string;
  /** Fondo de página: las páginas del sistema oscuro piden 'black'. */
  skin?: 'black' | 'white' | 'hybrid' | 'steel';
}

const {
  title,
  description,
  keywords,
  image,
  imageWidth,
  imageHeight,
  canonical,
  ogType = 'website',
  structuredData,
  noindex = false,
  gscVerification = 'TSoaOAODUVxCt2ohPOomFxRxF3I_MMKzu_wmbpFVpuw',
  skin,
} = Astro.props;

const siteUrl = SITE_URL;
const currentUrl = (canonical || `${siteUrl}${Astro.url.pathname}`).replace(/^https?:\/\/(?:www\.)?ultimamilla\.com\.ar/i, siteUrl).replace(/\/$/, "");

const hasHeadSlot = Astro.slots.has('head');

// Build breadcrumb trail from URL path. Los segmentos numéricos (IDs) y los
// agrupadores sin página propia se omiten; el último nivel usa el título humano.
const breadcrumbs: Array<{ name: string; url: string }> = [
  { name: "Inicio", url: siteUrl },
];

const breadcrumbLabels: Record<string, string> = {
  servicios: "Servicios",
  sectores: "Sectores",
  antecedentes: "Antecedentes",
  blog: "Blog",
  nosotros: "Nosotros",
  contacto: "Contacto",
  certificaciones: "Documentación técnica",
  cctvai: "UMSA CCTV AI",
  aeropuertos: "Aeropuertos",
  bodegas: "Bodegas",
  constructoras: "Constructoras",
  gobiernosectorpublico: "Gobierno y sector público",
  industria: "Industria",
  mineria: "Minería",
  salud: "Salud",
  "seguridad-electronica": "Seguridad electrónica",
  software: "Software",
};
const sectorSlugs = new Set(["aeropuertos", "bodegas", "constructoras", "gobiernosectorpublico", "industria", "mineria", "salud", "seguridad-electronica", "software"]);
const breadcrumbTitle = String(title || "")
  .replace(/\s*[|·–-]\s*ULTIMA MILLA\s*$/i, "")
  .trim();

if (Astro.url.pathname !== "/") {
  const segments = Astro.url.pathname.split("/").filter(Boolean);
  if (segments.length === 1 && sectorSlugs.has(segments[0]!)) {
    breadcrumbs.push({ name: "Sectores", url: `${siteUrl}/sectores` });
  }
  let pathAccumulator = "";
  segments.forEach((segment, index) => {
    pathAccumulator += `/${segment}`;
    const isLast = index === segments.length - 1;
    if (!isLast && (/^\d+$/.test(segment) || segment === "categoria" || segment === "en")) return;
    const fallbackName = segment.split("-").map((w: string) => w.charAt(0).toUpperCase() + w.slice(1)).join(" ");
    const name = breadcrumbLabels[segment] || (isLast && breadcrumbTitle ? breadcrumbTitle : fallbackName);
    breadcrumbs.push({
      name,
      url: isLast ? currentUrl : `${siteUrl}${pathAccumulator}`,
    });
  });
}

const skinVariant = getDevSkinVariant(Astro.url, import.meta.env.DEV) ?? skin ?? 'hybrid';
const skinAttribute = skinVariant;
const pageLang = resolvePageLanguage(Astro.url.pathname);
const skipLinkLabel = pageLang === 'en' ? 'Skip to main content' : 'Saltar al contenido principal';
const shouldEmitHreflang = hasEnglishAlternate(Astro.url.pathname);
// Service worker UM25 detrás de bandera de build (fase 5): sólo con
// PUBLIC_ENABLE_SW=true. Por defecto no se registra nada.
const enableServiceWorker = import.meta.env.PUBLIC_ENABLE_SW === 'true';
---

<!DOCTYPE html>
<html lang={pageLang}>
  <head>
    <!-- SEOHead — handles all meta, OG, Twitter, schema, canonical, hreflang, favicon -->
    <SEOHead
      title={title}
      description={description}
      keywords={keywords}
      ogImage={image}
      ogImageWidth={imageWidth}
      ogImageHeight={imageHeight}
      canonical={currentUrl}
      ogType={ogType}
      structuredData={structuredData}
      noindex={noindex}
      hreflang={shouldEmitHreflang}
      gscVerification={gscVerification}
      breadcrumbs={breadcrumbs}
    />

    <!-- Fuente UM Sans. El logo es un SVG vectorizado (UMLogo): ya no se carga
         Futura PT desde un CDN externo, que bloqueaba el render. -->
    <link rel="preload" href="/fonts/um-sans/v2.0.0/UMSans2-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/um-sans/v2.0.0/um-sans.css" />

    {hasHeadSlot && <slot name="head" />}

    <!-- Google Analytics 4 -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-S2376K1GED"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());
      gtag('config', 'G-S2376K1GED');
    </script>

    <!-- V4 Custom Styles -->
    <style is:global>
      /* V4 Design System - Base Styles */
      body {
        font-family: var(--um-font-body);
        font-synthesis: none;
        margin: 0;
        padding: 0;
        overflow-x: hidden;
        width: 100%;
        max-width: 100%;
        background-color: var(--skin-page);
        color: var(--skin-text);
        -webkit-font-smoothing: antialiased;
        -moz-osx-font-smoothing: grayscale;
        text-rendering: optimizeLegibility;
        font-kerning: normal;
        font-feature-settings: "kern" 1, "liga" 1, "calt" 1;
      }

      /* Static cards: hierarchy comes from layout, not motion or shadows. */
      .card-hover {
        transition: border-color 0.18s ease, background-color 0.18s ease;
      }
      .card-hover:hover {
        transform: none;
        box-shadow: none;
      }


      /* Typography fluid */
      .text-fluid-hero {
        font-size: clamp(2.125rem, 6vw, 3.8rem);
        line-height: 1.1;
      }
      .text-fluid-title {
        font-size: clamp(1.75rem, 4vw, 2.5rem);
      }
      .text-fluid-body {
        font-size: clamp(1rem, 2.5vw, 1.125rem);
      }

      /* Section padding fluid */
      .section-padding {
        padding-top: clamp(2.5rem, 8vw, 5rem);
        padding-bottom: clamp(2.5rem, 8vw, 5rem);
      }

      /* Touch targets */
      .touch-target {
        min-height: 44px;
        min-width: 44px;
      }

      /* Line clamp utilities */
      .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }
      .line-clamp-3 {
        display: -webkit-box;
        -webkit-line-clamp: 3;
        -webkit-box-orient: vertical;
        overflow: hidden;
      }

      /* Safe area for iPhone notch */
      @supports (padding: env(safe-area-inset-bottom)) {
        .safe-bottom {
          padding-bottom: calc(1rem + env(safe-area-inset-bottom));
        }
      }

      /* Motion sobrio de entrada: los bloques marcados con data-reveal llegan
         ya visibles (sin JS no cambia nada) y sólo se desplazan 12px cuando el
         observador confirma que entran en pantalla. */
      html.um-motion [data-reveal] {
        opacity: 0;
        transform: translateY(12px);
        transition: opacity 0.55s cubic-bezier(.2,.8,.2,1), transform 0.55s cubic-bezier(.2,.8,.2,1);
      }
      html.um-motion [data-reveal].is-in {
        opacity: 1;
        transform: none;
      }

      /* Reduced motion */
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after {
          animation-duration: 0.01ms !important;
          transition-duration: 0.01ms !important;
        }
      }

      /* Reset base link colors for V4 */
      a {
        color: inherit;
        text-decoration: none;
      }

      /* Editorial headings must wrap by phrase, never split ordinary words. */
      main :where(h1, h2, h3, h4):not(.font-hub *) {
        overflow-wrap: normal !important;
        word-break: normal !important;
        hyphens: none !important;
        text-wrap: pretty;
      }

      .um-skip-link {
        position: fixed;
        left: 16px;
        top: 16px;
        width: auto;
        height: auto;
        transform: translateY(calc(-100% - 32px));
        overflow: visible;
        z-index: var(--um-z-skip);
        padding: 12px 18px;
        background: #111;
        color: #fff;
        font-weight: 600;
        text-decoration: none;
      }

      .um-skip-link:focus {
        transform: translateY(0);
        outline: 2px solid var(--um-red);
        outline-offset: 2px;
      }
    </style>
  </head>
  <body
    data-skin={skinAttribute}
    data-font-system="um-sans-2.0.0"
  >
    <a class="um-skip-link" href="#main-content">{skipLinkLabel}</a>
    <NavbarV4 />

    <main id="main-content">
      <slot />
    </main>

    <ContactModal />
    <FooterV4 />
    <AppTabBar />
    <AppInstallHint />
    {enableServiceWorker && (
      <script is:inline>
        if ('serviceWorker' in navigator) {
          addEventListener('load', () => { navigator.serviceWorker.register('/sw-um25.js', { scope: '/' }).catch(() => {}); });
        }
      </script>
    )}

    <script>
      // Reveal: se activa sólo con IntersectionObserver y sin reduced-motion.
      const bootReveal = () => {
        const root = document.documentElement;
        const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
        const targets = document.querySelectorAll<HTMLElement>('[data-reveal]:not(.is-in)');
        if (reduce || !('IntersectionObserver' in window) || !targets.length) {
          root.classList.remove('um-motion');
          return;
        }
        root.classList.add('um-motion');
        const io = new IntersectionObserver((entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            const el = entry.target as HTMLElement;
            const delay = Number(el.dataset.revealDelay || 0);
            el.style.transitionDelay = delay ? `${delay}ms` : '';
            el.classList.add('is-in');
            io.unobserve(el);
          });
        }, { rootMargin: '0px 0px -8% 0px', threshold: 0.12 });
        targets.forEach((el) => {
          const r = el.getBoundingClientRect();
          // Lo que ya está en pantalla al cargar no se anima: la primera vista queda completa.
          if (r.top < innerHeight && r.bottom > 0) el.classList.add('is-in');
          else io.observe(el);
        });
      };
      bootReveal();
      document.addEventListener('astro:page-load', bootReveal);
    </script>
  </body>
</html>
