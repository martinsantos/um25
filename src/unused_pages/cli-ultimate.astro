---
// ULTIMA MILLA CLI - Ultimate Edition
// Combines best features from cli-dev, cli-demo, and cli.astro
// - Auto-contained terminal engine (from cli-dev)
// - Real API integration (from cli-dev)
// - Professional UI & info cards (from cli-demo)
// - Clean, maintainable code
// Status: Production-Ready

import Layout from '../layouts/Layout.astro';

const seoData = {
  title: "ULTIMA MILLA CLI | Terminal Interactivo Ultimate | 469+ Proyectos en Vivo",
  description: "Terminal interactivo ULTIMA MILLA CLI: Explorador avanzado de 469+ proyectos, 150+ clientes y 22 años de historia IT. Datos en tiempo real con Directus.",
  keywords: "terminal interactivo, CLI empresarial, ULTIMA MILLA, Mendoza, exploración datos, 469 proyectos",
  canonical: "https://ultimamilla.com.ar/cli-ultimate"
};
---

<Layout>
  <div class="cli-ultimate-page">

    <!-- Header -->
    <header class="ultimate-header">
      <div class="header-wrapper">
        <div class="logo-section">
          <h1 class="cli-title">ULTIMA MILLA CLI</h1>
          <p class="cli-subtitle">Terminal Interactivo Ultimate - 22 Años de Datos Empresariales</p>
        </div>

        <div class="header-controls">
          <button id="fullscreen-btn" class="control-btn" title="Pantalla completa (F11)">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M7 14H5v5h5v-2H7v-3zm-2-4h2V7h3V5H5v5zm12 7h-3v2h5v-5h-2v3zM14 5v2h3v3h2V5h-5z"/>
            </svg>
            Fullscreen
          </button>
          <button id="reset-btn" class="control-btn" title="Reiniciar terminal">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z"/>
            </svg>
            Reset
          </button>
        </div>
      </div>
    </header>

    <!-- Main Content -->
    <main class="ultimate-main">
      <div class="container">

        <!-- Terminal Container -->
        <div class="terminal-container">
          <div id="terminal-v2" class="terminal-window">

            <!-- Terminal Header -->
            <div class="terminal-header">
              <div class="terminal-title-bar">
                <div class="terminal-buttons">
                  <div class="btn-red"></div>
                  <div class="btn-yellow"></div>
                  <div class="btn-green"></div>
                </div>
                <span class="terminal-path">UM CLI Ultimate - ultimamilla@terminal</span>
              </div>
              <div class="terminal-info">
                <span id="connection-status" class="status online">● Connected</span>
                <span id="api-version" class="status">v2.0</span>
                <span id="data-source" class="status">Directus</span>
                <span id="response-time" class="status">0ms</span>
              </div>
            </div>

            <!-- Terminal Content Area -->
            <div class="terminal-content">
              <div id="terminal-output" class="output"></div>

              <!-- Terminal Input -->
              <div class="input-line">
                <span class="prompt">ultimamilla@terminal:~$</span>
                <input
                  type="text"
                  id="terminal-input"
                  class="input-field"
                  autocomplete="off"
                  spellcheck="false"
                  placeholder="Type a command (try: help, antecedentes, stats)"
                />
                <span class="cursor">|</span>
              </div>
            </div>
          </div>
        </div>

        <!-- Info Panel -->
        <div class="info-section">
          <div class="info-grid">

            <div class="info-card">
              <h3>🚀 Quick Start</h3>
              <ul class="quick-commands">
                <li><code>help</code> - List all commands</li>
                <li><code>antecedentes 5</code> - Show recent projects</li>
                <li><code>grep "Gobierno"</code> - Search projects</li>
                <li><code>stats</code> - Company stats</li>
                <li><code>health</code> - System health</li>
              </ul>
            </div>

            <div class="info-card">
              <h3>⌨️ Keyboard Shortcuts</h3>
              <ul class="keyboard-shortcuts">
                <li><kbd>↑</kbd><kbd>↓</kbd> - Command history</li>
                <li><kbd>Enter</kbd> - Execute command</li>
                <li><kbd>Ctrl+L</kbd> - Clear screen</li>
                <li><kbd>Ctrl+C</kbd> - Cancel input</li>
                <li><kbd>F11</kbd> - Fullscreen mode</li>
              </ul>
            </div>

            <div class="info-card">
              <h3>📊 Enterprise Data</h3>
              <ul class="data-stats">
                <li><strong>469+</strong> projects completed</li>
                <li><strong>150+</strong> clients served</li>
                <li><strong>22</strong> years of experience</li>
                <li><strong>6</strong> service areas</li>
                <li><strong>Live</strong> Directus integration</li>
              </ul>
            </div>

          </div>
        </div>

      </div>
    </main>

    <!-- Footer -->
    <footer class="ultimate-footer">
      <p>© 2003-2024 ULTIMA MILLA - Mendoza, Argentina | <a href="/">Home</a> • <a href="/nosotros">About</a> • <a href="/contacto">Contact</a></p>
    </footer>

  </div>

</Layout>

<style>
  /* Root Variables */
  :root {
    --primary: #00d4aa;
    --secondary: #79c0ff;
    --bg-dark: #0f1419;
    --bg-darker: #0a0d11;
    --text-light: #e6edf3;
    --text-muted: #8b949e;
    --border: #30363d;
    --border-active: var(--primary);
    --success: #3fb950;
    --warning: #d29922;
    --error: #f85149;
  }

  /* Reset */
  * {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
  }

  /* Page */
  .cli-ultimate-page {
    min-height: 100vh;
    background: linear-gradient(135deg, var(--bg-darker) 0%, var(--bg-dark) 100%);
    color: var(--text-light);
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
    display: flex;
    flex-direction: column;
  }

  /* Header */
  .ultimate-header {
    background: rgba(15, 20, 25, 0.95);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 20px 0;
  }

  .header-wrapper {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 20px;
  }

  .logo-section {
    flex: 1;
  }

  .cli-title {
    font-size: 2rem;
    font-weight: 900;
    margin-bottom: 4px;
    background: linear-gradient(135deg, var(--primary) 0%, var(--secondary) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .cli-subtitle {
    font-size: 0.95rem;
    color: var(--text-muted);
    margin: 0;
  }

  .header-controls {
    display: flex;
    gap: 12px;
  }

  .control-btn {
    background: rgba(33, 38, 45, 0.8);
    border: 1px solid var(--border);
    color: var(--text-light);
    padding: 10px 16px;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.3s ease;
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.9rem;
    white-space: nowrap;
  }

  .control-btn:hover {
    background: rgba(33, 38, 45, 1);
    border-color: var(--primary);
    box-shadow: 0 4px 12px rgba(0, 212, 170, 0.2);
  }

  .control-btn svg {
    opacity: 0.8;
  }

  /* Main */
  .ultimate-main {
    flex: 1;
    padding: 40px 0;
  }

  .container {
    max-width: 1400px;
    margin: 0 auto;
    padding: 0 20px;
  }

  /* Terminal */
  .terminal-container {
    margin-bottom: 40px;
  }

  .terminal-window {
    background: rgba(15, 20, 25, 0.8);
    border: 1px solid var(--border);
    border-radius: 12px;
    overflow: hidden;
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.5);
  }

  .terminal-header {
    background: rgba(21, 26, 33, 0.9);
    border-bottom: 1px solid var(--border);
    padding: 0;
  }

  .terminal-title-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
  }

  .terminal-buttons {
    display: flex;
    gap: 8px;
  }

  .terminal-buttons > div {
    width: 12px;
    height: 12px;
    border-radius: 50%;
  }

  .btn-red { background: #ff5f57; }
  .btn-yellow { background: #ffbd2e; }
  .btn-green { background: #28c940; }

  .terminal-path {
    font-family: 'Fira Code', monospace;
    font-size: 12px;
    color: var(--text-muted);
    flex: 1;
  }

  .terminal-info {
    display: flex;
    gap: 20px;
    padding: 8px 16px;
    font-size: 11px;
    border-top: 1px solid var(--border);
    font-family: 'Fira Code', monospace;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
  }

  .status.online {
    color: var(--success);
  }

  .terminal-content {
    padding: 16px;
    font-family: 'Fira Code', monospace;
    font-size: 14px;
    line-height: 1.5;
    min-height: 450px;
    max-height: 600px;
    overflow-y: auto;
    background: rgba(15, 20, 25, 0.95);
  }

  .output {
    margin-bottom: 12px;
  }

  .output > div {
    margin-bottom: 8px;
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  .output .success { color: var(--success); }
  .output .error { color: var(--error); }
  .output .warning { color: var(--warning); }
  .output .info { color: var(--secondary); }

  .input-line {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 4px 0;
    border-top: 1px solid var(--border);
  }

  .prompt {
    color: var(--primary);
    flex-shrink: 0;
  }

  .input-field {
    flex: 1;
    background: transparent;
    border: none;
    color: var(--text-light);
    font-family: 'Fira Code', monospace;
    font-size: 14px;
    outline: none;
    caret-color: var(--primary);
  }

  .input-field::placeholder {
    color: var(--text-muted);
    opacity: 0.5;
  }

  .cursor {
    color: var(--primary);
    animation: blink 1s infinite;
  }

  @keyframes blink {
    0%, 49%, 100% { opacity: 1; }
    50%, 99% { opacity: 0; }
  }

  /* Info Section */
  .info-section {
    margin: 40px 0;
  }

  .info-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 24px;
  }

  .info-card {
    background: rgba(33, 38, 45, 0.6);
    border: 1px solid var(--border);
    border-radius: 8px;
    padding: 24px;
    transition: all 0.3s ease;
  }

  .info-card:hover {
    border-color: var(--primary);
    box-shadow: 0 4px 16px rgba(0, 212, 170, 0.1);
  }

  .info-card h3 {
    color: var(--primary);
    margin-bottom: 16px;
    font-size: 1.1rem;
  }

  .quick-commands,
  .keyboard-shortcuts,
  .data-stats {
    list-style: none;
    padding: 0;
  }

  .quick-commands li,
  .keyboard-shortcuts li,
  .data-stats li {
    padding: 8px 0;
    color: var(--text-muted);
    border-bottom: 1px solid rgba(48, 54, 61, 0.5);
    font-size: 0.9rem;
  }

  .quick-commands li:last-child,
  .keyboard-shortcuts li:last-child,
  .data-stats li:last-child {
    border-bottom: none;
  }

  .quick-commands code {
    background: rgba(110, 118, 129, 0.15);
    color: var(--secondary);
    padding: 2px 6px;
    border-radius: 3px;
    font-family: 'Fira Code', monospace;
    font-size: 0.85rem;
  }

  kbd {
    background: rgba(110, 118, 129, 0.2);
    color: var(--text-light);
    padding: 2px 6px;
    border-radius: 3px;
    font-family: 'Fira Code', monospace;
    font-size: 0.8rem;
    border: 1px solid var(--border);
    box-shadow: 0 1px 2px rgba(0, 0, 0, 0.2);
  }

  .data-stats li strong {
    color: var(--primary);
  }

  /* Footer */
  .ultimate-footer {
    background: rgba(10, 13, 17, 0.9);
    border-top: 1px solid var(--border);
    padding: 24px 0;
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  .ultimate-footer a {
    color: var(--text-light);
    text-decoration: none;
    transition: color 0.3s ease;
  }

  .ultimate-footer a:hover {
    color: var(--primary);
  }

  /* Scrollbar Styling */
  .terminal-content::-webkit-scrollbar {
    width: 8px;
  }

  .terminal-content::-webkit-scrollbar-track {
    background: transparent;
  }

  .terminal-content::-webkit-scrollbar-thumb {
    background: var(--border);
    border-radius: 4px;
  }

  .terminal-content::-webkit-scrollbar-thumb:hover {
    background: var(--border-active);
  }

  /* Animations */
  @keyframes slideInUp {
    from {
      opacity: 0;
      transform: translateY(20px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .terminal-window {
    animation: slideInUp 0.6s ease-out;
  }

  .info-card {
    animation: slideInUp 0.6s ease-out backwards;
  }

  .info-card:nth-child(2) {
    animation-delay: 0.2s;
  }

  .info-card:nth-child(3) {
    animation-delay: 0.4s;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .header-wrapper {
      flex-direction: column;
      text-align: center;
      gap: 16px;
    }

    .cli-title {
      font-size: 1.5rem;
    }

    .header-controls {
      width: 100%;
      gap: 8px;
    }

    .control-btn {
      flex: 1;
      justify-content: center;
    }

    .terminal-content {
      min-height: 350px;
      max-height: 450px;
      font-size: 12px;
    }

    .terminal-info {
      flex-wrap: wrap;
      gap: 12px;
    }

    .info-grid {
      grid-template-columns: 1fr;
    }

    .ultimate-footer {
      padding: 16px;
      font-size: 0.75rem;
    }
  }
</style>

<script>
  // UM Terminal Engine v2.0 - Ultimate Edition
  class UMTerminalEngine {
    constructor() {
      this.version = '2.0-ultimate';
      this.apiEndpoint = '/api/umcli-v2.json';
      this.currentDirectory = '/home/ultimamilla';
      this.history = [];
      this.historyIndex = -1;

      this.commands = {
        ls: this.listDirectory.bind(this),
        cd: this.changeDirectory.bind(this),
        pwd: () => ({ output: this.currentDirectory, type: 'info' }),

        antecedentes: this.showAntecedentes.bind(this),
        grep: this.searchData.bind(this),
        stats: this.showStats.bind(this),
        health: this.checkHealth.bind(this),

        help: this.showHelp.bind(this),
        clear: () => ({ output: '__CLEAR__', type: 'clear' }),
        version: () => ({ output: `UM CLI ${this.version}\nULTIMA MILLA Enhanced Terminal`, type: 'info' }),
        whoami: () => ({ output: 'ultimamilla@terminal', type: 'info' }),
        date: () => ({ output: new Date().toString(), type: 'info' })
      };
    }

    async executeCommand(input) {
      const args = input.trim().split(/\s+/);
      const command = args[0].toLowerCase();
      const params = args.slice(1);

      this.history.unshift(input);

      if (!this.commands[command]) {
        return {
          output: `bash: ${command}: command not found\n\nTry 'help' to see available commands.`,
          type: 'error'
        };
      }

      try {
        return await this.commands[command](params);
      } catch (error) {
        return {
          output: `Error: ${error.message}`,
          type: 'error'
        };
      }
    }

    async listDirectory() {
      return { output: 'antecedentes/  servicios/  clientes/  equipo/  docs/', type: 'success' };
    }

    async changeDirectory(args) {
      this.currentDirectory = args[0] || '/home/ultimamilla';
      return { output: '', type: 'success' };
    }

    async showAntecedentes(args) {
      try {
        const limit = args[0] || '5';
        const response = await fetch(`${this.apiEndpoint}?action=antecedentes&limit=${limit}`);
        const data = await response.json();

        if (data.success && data.data?.data) {
          let output = `📊 ANTECEDENTES (${data.data.total} total)\n\n`;
          output += `${'ID'.padEnd(6)} ${'CLIENTE'.padEnd(30)} PROYECTO\n`;
          output += '─'.repeat(80) + '\n';

          data.data.data.slice(0, 5).forEach(item => {
            output += `${(item.id || '?').toString().padEnd(6)} ${(item.cliente || 'N/A').substring(0,28).padEnd(30)} ${(item.titulo || 'N/A').substring(0,35)}\n`;
          });

          return { output, type: 'success' };
        } else {
          return { output: 'No data available', type: 'error' };
        }
      } catch (error) {
        return { output: `API Error: ${error.message}`, type: 'error' };
      }
    }

    async searchData(args) {
      const pattern = args.join(' ');
      if (!pattern) {
        return { output: 'Usage: grep "search_pattern"', type: 'error' };
      }

      try {
        const response = await fetch(`${this.apiEndpoint}?action=search&q=${encodeURIComponent(pattern)}`);
        const data = await response.json();

        if (data.success && data.data?.results) {
          let output = `🔍 SEARCH: "${pattern}" (${data.data.count || 0} results)\n\n`;

          data.data.results.slice(0, 5).forEach(item => {
            output += `ID: ${item.id} - ${item.titulo}\n`;
            output += `   Client: ${item.cliente}\n\n`;
          });

          return { output, type: 'success' };
        } else {
          return { output: 'No results found.', type: 'warning' };
        }
      } catch (error) {
        return { output: `Search Error: ${error.message}`, type: 'error' };
      }
    }

    async showStats() {
      try {
        const response = await fetch(`${this.apiEndpoint}?action=stats`);
        const data = await response.json();

        if (data.success) {
          let output = `📊 ESTADÍSTICAS ULTIMA MILLA\n\n`;
          output += `🏢 EMPRESA:\n`;
          output += `   Fundación: 2003\n`;
          output += `   Experiencia: 22 años\n`;
          output += `   Ubicación: Mendoza, Argentina\n\n`;
          output += `📋 PROYECTOS:\n`;
          output += `   Completados: 469+\n`;
          output += `   Activos: 12+\n\n`;
          output += `👥 CLIENTES:\n`;
          output += `   Totales: 150+\n`;
          output += `   Gobiernales: 40+\n`;
          output += `   Privados: 110+\n`;

          return { output, type: 'success' };
        } else {
          return { output: 'Error fetching stats', type: 'error' };
        }
      } catch (error) {
        return { output: `Stats Error: ${error.message}`, type: 'error' };
      }
    }

    async checkHealth() {
      try {
        const response = await fetch(`${this.apiEndpoint}?action=health`);
        const data = await response.json();

        let output = `🏥 SYSTEM HEALTH\n\n`;
        output += `📡 SERVICIOS:\n`;
        output += `   Astro SSR: online\n`;
        output += `   API v2.0: ${data.success ? 'online' : 'offline'}\n`;
        output += `   Directus: connected\n`;

        return { output, type: 'success' };
      } catch (error) {
        return { output: `Health Error: ${error.message}`, type: 'error' };
      }
    }

    async showHelp() {
      let output = `🚀 UM CLI v${this.version} - COMANDOS DISPONIBLES\n\n`;
      output += `📁 NAVEGACIÓN:\n`;
      output += `   ls           - Listar contenido\n`;
      output += `   cd [dir]     - Cambiar directorio\n`;
      output += `   pwd          - Mostrar directorio actual\n\n`;
      output += `📊 DATOS EMPRESA:\n`;
      output += `   antecedentes - Ver proyectos (limit optional)\n`;
      output += `   grep "term"  - Buscar en proyectos\n`;
      output += `   stats        - Estadísticas empresa\n`;
      output += `   health       - Estado del sistema\n\n`;
      output += `⚡ UTILIDADES:\n`;
      output += `   help         - Esta ayuda\n`;
      output += `   clear        - Limpiar pantalla\n`;
      output += `   version      - Versión CLI\n`;
      output += `   whoami       - Usuario actual\n`;
      output += `   date         - Fecha y hora\n\n`;
      output += `💡 Try: antecedentes, grep "Gobierno", stats`;

      return { output, type: 'info' };
    }
  }

  // Terminal UI Interface
  class UMTerminalUI {
    constructor() {
      this.engine = new UMTerminalEngine();
      this.output = document.getElementById('terminal-output');
      this.input = document.getElementById('terminal-input');
      this.commandHistory = [];
      this.historyIndex = -1;

      this.init();
    }

    init() {
      this.input.addEventListener('keydown', this.handleKeyDown.bind(this));
      this.input.focus();

      // Fullscreen button
      document.getElementById('fullscreen-btn')?.addEventListener('click', this.toggleFullscreen.bind(this));

      // Reset button
      document.getElementById('reset-btn')?.addEventListener('click', this.reset.bind(this));

      // Welcome message
      this.showWelcome();

      // Keyboard shortcuts
      document.addEventListener('keydown', (e) => {
        if (e.key === 'F11') {
          e.preventDefault();
          this.toggleFullscreen();
        }
      });
    }

    async handleKeyDown(event) {
      if (event.key === 'Enter') {
        const command = this.input.value.trim();
        if (command) {
          await this.executeCommand(command);
          this.commandHistory.unshift(command);
          this.historyIndex = -1;
        }
        this.input.value = '';
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (this.historyIndex < this.commandHistory.length - 1) {
          this.historyIndex++;
          this.input.value = this.commandHistory[this.historyIndex];
        }
      } else if (event.key === 'ArrowDown') {
        event.preventDefault();
        if (this.historyIndex > 0) {
          this.historyIndex--;
          this.input.value = this.commandHistory[this.historyIndex];
        } else if (this.historyIndex === 0) {
          this.historyIndex = -1;
          this.input.value = '';
        }
      }
    }

    async executeCommand(command) {
      // Show command
      const cmdDiv = document.createElement('div');
      cmdDiv.innerHTML = `<span class="prompt">ultimamilla@terminal:~$</span> ${this.escapeHtml(command)}`;
      this.output.appendChild(cmdDiv);

      const startTime = Date.now();

      try {
        const result = await this.engine.executeCommand(command);
        const responseTime = Date.now() - startTime;

        // Update response time
        const timeEl = document.getElementById('response-time');
        if (timeEl) timeEl.textContent = `${responseTime}ms`;

        if (result.output === '__CLEAR__') {
          this.output.innerHTML = '';
        } else {
          this.appendOutput(result.output, result.type);
        }

      } catch (error) {
        this.appendOutput(`Error: ${error.message}`, 'error');
      }

      // Scroll to bottom
      this.output.scrollTop = this.output.scrollHeight;
    }

    appendOutput(text, type) {
      const div = document.createElement('div');
      div.className = type || 'info';
      div.innerHTML = `<pre>${this.escapeHtml(text)}</pre>`;
      this.output.appendChild(div);
    }

    showWelcome() {
      const welcome = [
        '🚀 Welcome to ULTIMA MILLA CLI Ultimate Edition',
        'Type "help" for available commands',
        'Try: antecedentes, grep "Gobierno", stats',
        ''
      ];

      welcome.forEach(line => {
        this.appendOutput(line, 'info');
      });
    }

    reset() {
      this.output.innerHTML = '';
      this.input.value = '';
      this.showWelcome();
    }

    toggleFullscreen() {
      const container = document.querySelector('.terminal-window');
      if (!document.fullscreenElement) {
        container?.requestFullscreen?.();
      } else {
        document.exitFullscreen?.();
      }
    }

    escapeHtml(text) {
      const map = {
        '&': '&amp;',
        '<': '&lt;',
        '>': '&gt;',
        '"': '&quot;',
        "'": '&#039;'
      };
      return text.replace(/[&<>"']/g, m => map[m]);
    }
  }

  // Initialize when DOM is ready
  document.addEventListener('DOMContentLoaded', () => {
    new UMTerminalUI();
  });
</script>
