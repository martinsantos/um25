---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Servicios IT - Versión Completa | ULTIMA MILLA">
<style>
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
@keyframes slideIn{from{width:0}to{width:100%}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-15px)}}
input::placeholder,textarea::placeholder{color:#64748b}
</style>

<!-- HERO CON ESTADÍSTICAS GRANDES -->
<section style="position:relative;min-height:700px;background:linear-gradient(135deg,#0f172a 0%,#1e293b 100%);color:white;overflow:hidden">
<div style="position:absolute;inset:0;opacity:.05;background-image:url('data:image/svg+xml,%3Csvg width=%2260%22 height=%2260%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cpath d=%22M30 0L60 30L30 60L0 30z%22 fill=%22%2306b6d4%22/%3E%3C/svg%3E')"></div>
<div style="position:absolute;top:-150px;right:-150px;width:700px;height:700px;background:radial-gradient(circle,rgba(6,182,212,.2) 0%,transparent 70%);filter:blur(100px)"></div>
<div style="max-width:1400px;margin:0 auto;padding:100px 40px;position:relative;z-index:10">
<div style="max-width:900px;margin-bottom:80px">
<div style="display:inline-flex;align-items:center;gap:10px;padding:10px 24px;background:rgba(6,182,212,.15);border:1px solid rgba(6,182,212,.3);border-radius:50px;margin-bottom:32px">
<div style="width:8px;height:8px;background:#06b6d4;border-radius:50%;animation:pulse 2s ease-in-out infinite"></div>
<span style="font-size:13px;font-weight:700;color:#06b6d4;text-transform:uppercase;letter-spacing:1.5px">Servicios IT Integrales</span>
</div>
<h1 style="font-size:clamp(48px,7vw,72px);font-weight:900;line-height:1.1;margin-bottom:28px;letter-spacing:-.02em">Protección Integral y Confianza Para Sus Activos Digitales</h1>
<p style="font-size:20px;line-height:1.7;color:#cbd5e1;margin-bottom:40px">Soluciones de ciberseguridad con estándares de tecnología de Marca y Niveles certificados, resultados comprobados y soporte 24/7.</p>
<a href="#contacto" style="display:inline-flex;align-items:center;gap:12px;padding:18px 36px;background:linear-gradient(135deg,#06b6d4,#0ea5e9);color:white;font-weight:700;font-size:16px;border-radius:12px;text-decoration:none;box-shadow:0 10px 40px rgba(6,182,212,.3)">Hable con un Experto<svg style="width:20px;height:20px" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg></a>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:32px">
<div style="background:linear-gradient(135deg,rgba(6,182,212,.1) 0%,rgba(15,23,42,.5) 100%);border:1px solid rgba(6,182,212,.2);border-radius:24px;padding:40px;text-align:center">
<div style="font-size:56px;font-weight:900;color:#06b6d4;margin-bottom:12px">64.1M</div>
<div style="font-size:18px;font-weight:700;color:white;margin-bottom:8px">Datos Protegidos</div>
<div style="font-size:14px;color:#06b6d4;font-weight:600">+20% vs año anterior</div>
</div>
<div style="background:linear-gradient(135deg,rgba(6,182,212,.1) 0%,rgba(15,23,42,.5) 100%);border:1px solid rgba(6,182,212,.2);border-radius:24px;padding:40px;text-align:center">
<div style="font-size:56px;font-weight:900;color:#06b6d4;margin-bottom:12px">212</div>
<div style="font-size:18px;font-weight:700;color:white;margin-bottom:8px">Días Promedio</div>
<div style="font-size:14px;color:#06b6d4;font-weight:600">+5% vs año anterior</div>
</div>
<div style="background:linear-gradient(135deg,rgba(6,182,212,.1) 0%,rgba(15,23,42,.5) 100%);border:1px solid rgba(6,182,212,.2);border-radius:24px;padding:40px;text-align:center">
<div style="font-size:56px;font-weight:900;color:#06b6d4;margin-bottom:12px">150%</div>
<div style="font-size:18px;font-weight:700;color:white;margin-bottom:8px">Aumento Rendimiento</div>
<div style="font-size:14px;color:#06b6d4;font-weight:600">+8% vs año anterior</div>
</div>
</div>
</div>
</section>

<!-- FEATURES CON ICONOS -->
<section style="background:linear-gradient(180deg,#0f172a 0%,#1e293b 100%);padding:100px 40px">
<div style="max-width:1400px;margin:0 auto">
<div style="text-align:center;margin-bottom:80px">
<h2 style="font-size:clamp(40px,5vw,56px);font-weight:900;color:white;margin-bottom:24px">Protección Integral Adaptada a Ti</h2>
</div>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(350px,1fr));gap:32px">
<div style="background:rgba(15,23,42,.5);border:1px solid rgba(6,182,212,.05);border-radius:24px;padding:48px">
<div style="width:72px;height:72px;background:linear-gradient(135deg,rgba(6,182,212,.2),rgba(6,182,212,.1));border:2px solid rgba(6,182,212,.4);border-radius:20px;display:flex;align-items:center;justify-content:center;margin-bottom:28px;font-size:32px">🛡️</div>
<h3 style="font-size:24px;font-weight:800;color:white;margin-bottom:16px">Detección Proactiva</h3>
<p style="font-size:16px;color:#94a3b8;line-height:1.7">Identificamos y mitigamos amenazas antes de que afecten tu operación.</p>
</div>
<div style="background:rgba(15,23,42,.5);border:1px solid rgba(6,182,212,.05);border-radius:24px;padding:48px">
<div style="width:72px;height:72px;background:linear-gradient(135deg,rgba(6,182,212,.2),rgba(6,182,212,.1));border:2px solid rgba(6,182,212,.4);border-radius:20px;display:flex;align-items:center;justify-content:center;margin-bottom:28px;font-size:32px">⚡</div>
<h3 style="font-size:24px;font-weight:800;color:white;margin-bottom:16px">Respuesta a Incidentes</h3>
<p style="font-size:16px;color:#94a3b8;line-height:1.7">Equipo disponible 24/7 para neutralizar amenazas en tiempo real.</p>
</div>
<div style="background:rgba(15,23,42,.5);border:1px solid rgba(6,182,212,.05);border-radius:24px;padding:48px">
<div style="width:72px;height:72px;background:linear-gradient(135deg,rgba(6,182,212,.2),rgba(6,182,212,.1));border:2px solid rgba(6,182,212,.4);border-radius:20px;display:flex;align-items:center;justify-content:center;margin-bottom:28px;font-size:32px">🔄</div>
<h3 style="font-size:24px;font-weight:800;color:white;margin-bottom:16px">Gestión Continua</h3>
<p style="font-size:16px;color:#94a3b8;line-height:1.7">Monitoreo constante y actualizaciones automáticas de seguridad.</p>
</div>
</div>
</div>
</section>

<!-- METODOLOGÍA EN PASOS -->
<section style="background:#0f172a;padding:100px 40px;border-top:1px solid rgba(255,255,255,.05)">
<div style="max-width:1200px;margin:0 auto">
<div style="text-align:center;margin-bottom:80px">
<h2 style="font-size:clamp(40px,5vw,56px);font-weight:900;color:white;margin-bottom:24px">Nuestra Metodología</h2>
</div>
<div style="display:grid;gap:24px">
<div style="display:grid;grid-template-columns:80px 1fr;gap:32px;align-items:start;padding:24px;background:linear-gradient(90deg,rgba(6,182,212,.05) 0%,rgba(15,23,42,.5) 50%);border:1px solid rgba(6,182,212,.2);border-left:4px solid #06b6d4;border-radius:16px">
<div style="width:80px;height:80px;background:linear-gradient(135deg,#06b6d4,#0ea5e9);border-radius:20px;display:flex;align-items:center;justify-content:center;font-size:32px;font-weight:900;color:white;box-shadow:0 10px 30px rgba(6,182,212,.3)">01</div>
<div><h3 style="font-size:26px;font-weight:800;color:white;margin-bottom:12px">Monitoreo 24/7</h3><p style="font-size:17px;color:#94a3b8;line-height:1.7">Vigilancia constante de tu infraestructura para detectar y resolver problemas.</p></div>
</div>
<div style="display:grid;grid-template-columns:80px 1fr;gap:32px;align-items:start;padding:24px;background:linear-gradient(90deg,rgba(6,182,212,.05) 0%,rgba(15,23,42,.5) 50%);border:1px solid rgba(6,182,212,.2);border-left:4px solid #0ea5e9;border-radius:16px">
<div style="width:80px;height:80px;background:linear-gradient(135deg,#0ea5e9,#0284c7);border-radius:20px;display:flex;align-items:center;justify-content:center;font-size:32px;font-weight:900;color:white;box-shadow:0 10px 30px rgba(14,165,233,.3)">02</div>
<div><h3 style="font-size:26px;font-weight:800;color:white;margin-bottom:12px">Respuesta a Incidentes</h3><p style="font-size:17px;color:#94a3b8;line-height:1.7">En caso de brecha, nuestro equipo neutraliza la amenaza y recupera operación.</p></div>
</div>
<div style="display:grid;grid-template-columns:80px 1fr;gap:32px;align-items:start;padding:24px;background:linear-gradient(90deg,rgba(6,182,212,.05) 0%,rgba(15,23,42,.5) 50%);border:1px solid rgba(6,182,212,.2);border-left:4px solid #10b981;border-radius:16px">
<div style="width:80px;height:80px;background:linear-gradient(135deg,#10b981,#059669);border-radius:20px;display:flex;align-items:center;justify-content:center;font-size:32px;font-weight:900;color:white;box-shadow:0 10px 30px rgba(16,185,129,.3)">03</div>
<div><h3 style="font-size:26px;font-weight:800;color:white;margin-bottom:12px">Gestión Continua</h3><p style="font-size:17px;color:#94a3b8;line-height:1.7">Monitoreo 24/7 y actualizaciones constantes para mantener tu seguridad.</p></div>
</div>
</div>
</div>
</section>

<!-- CTA FINAL -->
<section id="contacto" style="background:linear-gradient(135deg,#0f172a 0%,#1e293b 100%);padding:120px 40px">
<div style="max-width:900px;margin:0 auto;text-align:center">
<h2 style="font-size:clamp(36px,4vw,48px);font-weight:900;color:white;margin-bottom:24px">Proteja su Negocio Hoy</h2>
<p style="font-size:18px;color:#94a3b8;margin-bottom:40px">No espere a que ocurra una brecha. Contáctenos para una evaluación gratuita.</p>
<form action="/api/contact" method="POST" style="max-width:600px;margin:0 auto">
<div style="display:grid;gap:20px">
<input type="text" name="nombre" placeholder="Nombre completo" required style="padding:18px 24px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:12px;color:white;font-size:16px">
<input type="email" name="email" placeholder="Email corporativo" required style="padding:18px 24px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:12px;color:white;font-size:16px">
<textarea name="mensaje" placeholder="Cuéntenos sobre su proyecto..." rows="4" required style="padding:18px 24px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:12px;color:white;font-size:16px"></textarea>
<button type="submit" style="padding:20px;background:linear-gradient(135deg,#06b6d4,#0ea5e9);color:white;font-weight:700;font-size:18px;border-radius:12px;border:none;cursor:pointer;box-shadow:0 10px 40px rgba(6,182,212,.3)">Enviar Solicitud</button>
</div>
</form>
</div>
</section>
</Layout>
