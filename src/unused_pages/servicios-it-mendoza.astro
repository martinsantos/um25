---
import Layout from '../layouts/Layout.astro';
import SEOHead from '../components/SEO/SEOHead.astro';
import Breadcrumbs from '../components/SEO/Breadcrumbs.astro';

// SEO Data
const seoData = {
  title: "Servicios IT en Mendoza | Empresa Líder en Tecnología - ULTIMA MILLA",
  description: "Servicios IT profesionales en Mendoza, Argentina. Infraestructura, redes, seguridad informática, desarrollo de software y telecomunicaciones. +20 años de experiencia. +469 proyectos exitosos.",
  keywords: "servicios IT mendoza, empresa tecnología mendoza, infraestructura IT mendoza, redes datos mendoza, seguridad informática mendoza, desarrollo software mendoza, telecomunicaciones mendoza",
  canonical: "https://ultimamilla.com.ar/servicios-it-mendoza"
};

// Breadcrumbs
const breadcrumbs = [
  { name: "Inicio", url: "/" },
  { name: "Servicios IT en Mendoza", url: "/servicios-it-mendoza", current: true }
];

// Servicios data (from previous audit)
const serviciosPrincipales = [
  {
    id: 1,
    titulo: "Servicios IT",
    descripcion: "Infraestructura IT completa para empresas mendocinas",
    icono: "settings",
    url: "/servicios/1/servicios-it",
    beneficios: ["Servidores empresariales", "Virtualización", "Backup automático", "Soporte 24/7"]
  },
  {
    id: 2,
    titulo: "Redes de Datos",
    descripcion: "Cableado estructurado y redes empresariales en Mendoza",
    icono: "network_wifi",
    url: "/servicios/2/redes-de-datos",
    beneficios: ["Cableado estructurado Cat6", "WiFi empresarial", "Switches administrables", "Redundancia de red"]
  },
  {
    id: 3,
    titulo: "Seguridad Informática",
    descripcion: "Ciberseguridad y protección de datos empresariales",
    icono: "security",
    url: "/servicios/3/seguridad-informatica",
    beneficios: ["Firewall avanzado", "Antivirus corporativo", "Monitoreo 24/7", "Backup seguro"]
  },
  {
    id: 4,
    titulo: "Telecomunicaciones",
    descripcion: "Telefonía IP y comunicaciones unificadas",
    icono: "phone",
    url: "/servicios/4/telecomunicaciones",
    beneficios: ["Central telefónica IP", "Videconferencias", "Comunicaciones móviles", "Integración CRM"]
  },
  {
    id: 5,
    titulo: "Consultoría Tecnológica",
    descripcion: "Asesoramiento estratégico en transformación digital",
    icono: "psychology",
    url: "/servicios/5/consultoria-tecnologica",
    beneficios: ["Auditoría tecnológica", "Planificación estratégica", "Capacitación", "Gestión de proyectos"]
  },
  {
    id: 6,
    titulo: "Servicios Web",
    descripcion: "Desarrollo web y soluciones digitales personalizadas",
    icono: "web",
    url: "/servicios/6/servicios-web",
    beneficios: ["Sitios web profesionales", "E-commerce", "Aplicaciones web", "Hosting especializado"]
  }
];

// Casos de éxito destacados para Mendoza
const casosExitoMendoza = [
  {
    cliente: "Gobierno de Mendoza - Ministerio de Deportes",
    proyecto: "Implementación de red de cableado estructurado en Estadio Malvinas Argentinas",
    año: "2003",
    servicio: "Redes y comunicaciones"
  },
  {
    cliente: "Empresas Mendocinas - Sector Privado",
    proyecto: "Más de 200 proyectos de infraestructura IT para empresas locales",
    año: "2000-2025",
    servicio: "Servicios IT integrales"
  },
  {
    cliente: "Sector Vitivinícola Mendocino",
    proyecto: "Sistemas de gestión y comunicaciones para bodegas",
    año: "2010-2025",
    servicio: "Software y telecomunicaciones"
  }
];
---

<Layout>
  <SEOHead 
    title={seoData.title}
    description={seoData.description}
    keywords={seoData.keywords}
    canonical={seoData.canonical}
    ogType="service"
    service={{
      name: "Servicios IT en Mendoza",
      area: "Tecnología e IT",
      description: "Empresa líder en servicios IT, redes, seguridad informática y desarrollo web en Mendoza. +20 años transformando empresas mendocinas."
    }}
    breadcrumbs={breadcrumbs}
  />

  <!-- Hero Section Optimizado para SEO Local -->
  <section class="hero-mendoza bg-gradient-to-br from-blue-900 via-blue-800 to-blue-900 text-white py-20">
    <div class="container mx-auto px-4">
      <Breadcrumbs items={breadcrumbs} />
      
      <div class="max-w-4xl mx-auto text-center mt-8">
        <h1 class="text-5xl font-black mb-6">
          Servicios IT en <span class="text-yellow-400">Mendoza</span>
        </h1>
        <h2 class="text-2xl font-bold mb-8 text-blue-200">
          La empresa líder en tecnología de Mendoza, Argentina
        </h2>
        <p class="text-xl leading-relaxed mb-8 max-w-3xl mx-auto">
          <strong>+20 años transformando empresas mendocinas</strong> con soluciones IT de vanguardia. 
          Somos la empresa de tecnología más confiable de Mendoza con <strong>+469 proyectos exitosos</strong> 
          en infraestructura, redes, seguridad informática y desarrollo de software.
        </p>
        
        <div class="flex flex-wrap justify-center gap-4 mb-8">
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4">
            <div class="text-3xl font-black text-yellow-400">+469</div>
            <div class="text-sm">Proyectos Exitosos</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4">
            <div class="text-3xl font-black text-yellow-400">+20</div>
            <div class="text-sm">Años en Mendoza</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-lg p-4">
            <div class="text-3xl font-black text-yellow-400">24/7</div>
            <div class="text-sm">Soporte Técnico</div>
          </div>
        </div>

        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a href="#contacto" 
             class="bg-yellow-500 text-blue-900 px-8 py-4 rounded-lg font-bold text-lg hover:bg-yellow-400 transition-colors">
            Cotizar Proyecto en Mendoza
          </a>
          <a href="#servicios" 
             class="border-2 border-white text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-white hover:text-blue-900 transition-colors">
            Ver Servicios IT
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Por qué elegir ULTIMA MILLA en Mendoza -->
  <section class="py-16 bg-gray-50">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center mb-12">
        <h2 class="text-4xl font-black mb-6">¿Por qué elegir ULTIMA MILLA en Mendoza?</h2>
        <p class="text-xl text-gray-600">
          Somos la empresa IT de referencia en Mendoza, con presencia local y expertise internacional
        </p>
      </div>

      <div class="grid md:grid-cols-3 gap-8 max-w-6xl mx-auto">
        <div class="bg-white rounded-xl p-8 shadow-lg text-center">
          <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <span class="material-icons-outlined text-3xl text-blue-600">location_on</span>
          </div>
          <h3 class="text-2xl font-bold mb-4">Presencia Local en Mendoza</h3>
          <p class="text-gray-600">
            Equipo técnico local que conoce las necesidades específicas de las empresas mendocinas. 
            Respuesta rápida y soporte presencial cuando lo necesites.
          </p>
        </div>

        <div class="bg-white rounded-xl p-8 shadow-lg text-center">
          <div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <span class="material-icons-outlined text-3xl text-green-600">verified</span>
          </div>
          <h3 class="text-2xl font-bold mb-4">Experiencia Comprobada</h3>
          <p class="text-gray-600">
            Desde el 2000 trabajando con empresas mendocinas. Referencias verificables en 
            Gobierno de Mendoza, empresas vitivinícolas y sector privado local.
          </p>
        </div>

        <div class="bg-white rounded-xl p-8 shadow-lg text-center">
          <div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-6">
            <span class="material-icons-outlined text-3xl text-purple-600">support_agent</span>
          </div>
          <h3 class="text-2xl font-bold mb-4">Soporte 24/7</h3>
          <p class="text-gray-600">
            Monitoreo continuo y soporte técnico disponible las 24 horas. 
            Tu negocio nunca se detiene, nosotros tampoco.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Servicios IT Principales -->
  <section id="servicios" class="py-16">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-black mb-6">Servicios IT Especializados para Mendoza</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Soluciones tecnológicas completas diseñadas específicamente para empresas mendocinas
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-7xl mx-auto">
        {serviciosPrincipales.map((servicio) => (
          <div class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2">
            <div class="p-8">
              <div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mb-6">
                <span class="material-icons-outlined text-3xl text-blue-600">{servicio.icono}</span>
              </div>
              
              <h3 class="text-2xl font-bold mb-4">{servicio.titulo}</h3>
              <p class="text-gray-600 mb-6">{servicio.descripcion}</p>
              
              <ul class="space-y-2 mb-6">
                {servicio.beneficios.map((beneficio) => (
                  <li class="flex items-center text-gray-700">
                    <span class="material-icons-outlined text-green-500 mr-2 text-sm">check_circle</span>
                    {beneficio}
                  </li>
                ))}
              </ul>
              
              <a href={servicio.url} 
                 class="block bg-blue-600 text-white text-center py-3 px-6 rounded-lg font-semibold hover:bg-blue-700 transition-colors">
                Más información
              </a>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Casos de Éxito en Mendoza -->
  <section class="py-16 bg-blue-50">
    <div class="container mx-auto px-4">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-black mb-6">Casos de Éxito en Mendoza</h2>
        <p class="text-xl text-gray-600">
          Proyectos destacados que demuestran nuestro compromiso con empresas mendocinas
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8 max-w-6xl mx-auto">
        {casosExitoMendoza.map((caso, index) => (
          <div class="bg-white rounded-xl p-8 shadow-lg">
            <div class="text-blue-600 font-bold text-lg mb-2">{caso.servicio}</div>
            <h3 class="text-xl font-bold mb-4">{caso.cliente}</h3>
            <p class="text-gray-600 mb-4">{caso.proyecto}</p>
            <div class="text-sm text-gray-500 font-semibold">{caso.año}</div>
          </div>
        ))}
      </div>

      <div class="text-center mt-12">
        <a href="/antecedentes" 
           class="bg-blue-600 text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-blue-700 transition-colors inline-block">
          Ver Todos los Casos de Éxito
        </a>
      </div>
    </div>
  </section>

  <!-- Contacto específico para Mendoza -->
  <section id="contacto" class="py-16 bg-gradient-to-br from-gray-900 to-blue-900 text-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h2 class="text-4xl font-black mb-8">Transformamos tu empresa en Mendoza</h2>
        <p class="text-xl mb-8">
          Únete a las <strong>+469 empresas mendocinas</strong> que ya confiaron en ULTIMA MILLA 
          para su transformación digital
        </p>

        <div class="grid md:grid-cols-2 gap-8 max-w-4xl mx-auto">
          <div class="bg-white/10 backdrop-blur-sm rounded-xl p-8">
            <h3 class="text-2xl font-bold mb-4">Contacto Mendoza</h3>
            <div class="space-y-4 text-left">
              <div class="flex items-center">
                <span class="material-icons-outlined mr-3">location_on</span>
                <span>Av. San Martín 1234, Mendoza, Argentina</span>
              </div>
              <div class="flex items-center">
                <span class="material-icons-outlined mr-3">phone</span>
                <span>+54 261 123 4567</span>
              </div>
              <div class="flex items-center">
                <span class="material-icons-outlined mr-3">email</span>
                <span>contacto@ultimamilla.com.ar</span>
              </div>
              <div class="flex items-center">
                <span class="material-icons-outlined mr-3">schedule</span>
                <span>Lun-Vie: 8:00 - 18:00 hs</span>
              </div>
            </div>
          </div>

          <div class="bg-white/10 backdrop-blur-sm rounded-xl p-8">
            <h3 class="text-2xl font-bold mb-4">Consulta Gratuita</h3>
            <p class="text-blue-200 mb-6">
              Agenda una reunión gratuita para evaluar las necesidades IT de tu empresa mendocina
            </p>
            <a href="/contacto" 
               class="bg-yellow-500 text-blue-900 px-8 py-4 rounded-lg font-bold text-lg hover:bg-yellow-400 transition-colors block text-center">
              Agendar Consulta Gratuita
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ Section para SEO -->
  <section class="py-16 bg-white">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-4xl font-black text-center mb-12">Preguntas Frecuentes - Servicios IT Mendoza</h2>
        
        <div class="space-y-6">
          <details class="bg-gray-50 rounded-xl p-6">
            <summary class="text-xl font-bold cursor-pointer text-blue-800">
              ¿Por qué elegir una empresa IT local de Mendoza?
            </summary>
            <div class="mt-4 text-gray-600">
              <p>Elegir una empresa IT local como ULTIMA MILLA en Mendoza te brinda ventajas únicas: soporte presencial inmediato, conocimiento del mercado local, precios competitivos sin sobrecostos de traslado, y un equipo que entiende las necesidades específicas de las empresas mendocinas.</p>
            </div>
          </details>

          <details class="bg-gray-50 rounded-xl p-6">
            <summary class="text-xl font-bold cursor-pointer text-blue-800">
              ¿Qué servicios IT son más demandados en Mendoza?
            </summary>
            <div class="mt-4 text-gray-600">
              <p>En Mendoza, los servicios IT más demandados son: redes de datos para bodegas y empresas vitivinícolas, seguridad informática para el sector financiero, desarrollo de software para gestión empresarial, e infraestructura IT para organismos gubernamentales y empresas de servicios.</p>
            </div>
          </details>

          <details class="bg-gray-50 rounded-xl p-6">
            <summary class="text-xl font-bold cursor-pointer text-blue-800">
              ¿Cuánto cuesta implementar servicios IT en Mendoza?
            </summary>
            <div class="mt-4 text-gray-600">
              <p>Los costos varían según las necesidades específicas. Ofrecemos consultas gratuitas para evaluar tu proyecto. Nuestros precios son competitivos en el mercado mendocino, con planes de financiación disponibles para empresas locales.</p>
            </div>
          </details>

          <details class="bg-gray-50 rounded-xl p-6">
            <summary class="text-xl font-bold cursor-pointer text-blue-800">
              ¿Brindan soporte técnico 24/7 en Mendoza?
            </summary>
            <div class="mt-4 text-gray-600">
              <p>Sí, ofrecemos soporte técnico 24/7 para nuestros clientes de Mendoza. Nuestro equipo local está disponible para emergencias y contamos con monitoreo remoto continuo de todos los sistemas críticos.</p>
            </div>
          </details>
        </div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero-mendoza {
    background-image: 
      linear-gradient(135deg, rgba(30, 58, 138, 0.9) 0%, rgba(59, 130, 246, 0.8) 50%, rgba(30, 58, 138, 0.9) 100%),
      url('/images/mendoza-skyline.jpg');
    background-size: cover;
    background-position: center;
  }

  .material-icons-outlined {
    font-family: 'Material Icons Outlined';
    font-weight: normal;
    font-style: normal;
    font-size: 24px;
    line-height: 1;
    letter-spacing: normal;
    text-transform: none;
    display: inline-block;
    white-space: nowrap;
    word-wrap: normal;
    direction: ltr;
  }

  details summary {
    list-style: none;
    outline: none;
  }

  details summary::-webkit-details-marker {
    display: none;
  }

  details summary::after {
    content: '+';
    float: right;
    font-size: 1.5rem;
    font-weight: bold;
    color: #1e40af;
    transition: transform 0.3s ease;
  }

  details[open] summary::after {
    transform: rotate(45deg);
  }
</style>
