---
// VERSIÓN ALTERNATIVA - SERVICIOS WEB
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Servicios Web - Nueva Estética | ULTIMA MILLA">
  <style>
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
    @keyframes gradient { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
  </style>

  <!-- HERO -->
  <section style="position: relative; min-height: 650px; background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #312e81 100%); color: white; overflow: hidden;">
    <div style="position: absolute; inset: 0; opacity: 0.04; background-image: url('data:image/svg+xml,%3Csvg width=&quot;80&quot; height=&quot;80&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cpath d=&quot;M0 0h40v40H0z&quot; fill=&quot;none&quot; stroke=&quot;%2306b6d4&quot; stroke-width=&quot;1&quot;/%3E%3C/svg%3E');"></div>
    <div style="position: absolute; top: 0; right: 0; width: 600px; height: 600px; background: radial-gradient(circle, rgba(99, 102, 241, 0.2) 0%, transparent 70%); filter: blur(100px);"></div>
    <div style="position: absolute; bottom: 0; left: 0; width: 500px; height: 500px; background: radial-gradient(circle, rgba(6, 182, 212, 0.15) 0%, transparent 70%); filter: blur(100px);"></div>

    <div style="max-width: 1400px; margin: 0 auto; padding: 140px 40px 80px; position: relative; z-index: 10;">
      <div style="max-width: 950px; margin: 0 auto; text-align: center;">
        <div style="display: inline-flex; align-items: center; gap: 10px; padding: 10px 24px; background: linear-gradient(135deg, rgba(99, 102, 241, 0.15), rgba(6, 182, 212, 0.15)); border: 1px solid rgba(99, 102, 241, 0.3); border-radius: 50px; margin-bottom: 32px;">
          <div style="width: 8px; height: 8px; background: #6366f1; border-radius: 50%; animation: pulse 2s ease-in-out infinite;"></div>
          <span style="font-size: 13px; font-weight: 700; color: #a5b4fc; text-transform: uppercase; letter-spacing: 1.5px;">Desarrollo Web</span>
        </div>

        <h1 style="font-size: clamp(52px, 7vw, 80px); font-weight: 900; line-height: 1.05; margin-bottom: 32px; letter-spacing: -0.03em; background: linear-gradient(135deg, #ffffff 0%, #a5b4fc 50%, #06b6d4 100%); background-size: 200% 200%; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; animation: gradient 5s ease infinite;">
          Experiencias Web que Convierten
        </h1>

        <p style="font-size: 22px; line-height: 1.7; color: #cbd5e1; margin-bottom: 48px; max-width: 800px; margin-left: auto; margin-right: auto;">
          Diseño y desarrollo de aplicaciones web modernas, rápidas y escalables con las últimas tecnologías.
        </p>

        <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
          <a href="#portfolio" style="display: inline-flex; align-items: center; gap: 12px; padding: 20px 40px; background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; font-weight: 700; font-size: 17px; border-radius: 12px; text-decoration: none; box-shadow: 0 12px 45px rgba(99, 102, 241, 0.35);">
            Ver Portfolio
            <svg style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
          </a>
          <a href="#contacto" style="display: inline-flex; align-items: center; gap: 12px; padding: 20px 40px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.2); color: white; font-weight: 700; font-size: 17px; border-radius: 12px; text-decoration: none; backdrop-filter: blur(10px);">
            Cotizar Proyecto
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- TECNOLOGÍAS -->
  <section style="background: #0f172a; padding: 100px 40px;">
    <div style="max-width: 1400px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 80px;">
        <div style="display: inline-block; padding: 8px 20px; background: rgba(99, 102, 241, 0.1); border: 1px solid rgba(99, 102, 241, 0.2); border-radius: 50px; margin-bottom: 24px;">
          <span style="font-size: 13px; font-weight: 800; color: #6366f1; text-transform: uppercase;">Stack Tecnológico</span>
        </div>
        <h2 style="font-size: clamp(40px, 5vw, 56px); font-weight: 900; color: white; margin-bottom: 24px;">
          Tecnologías de Vanguardia
        </h2>
        <p style="font-size: 20px; color: #94a3b8; max-width: 800px; margin: 0 auto;">
          Utilizamos las herramientas más modernas y probadas de la industria
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 24px;">
        <div style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.05) 0%, rgba(15, 23, 42, 0.5) 100%); border: 1px solid rgba(99, 102, 241, 0.2); border-radius: 16px; padding: 32px; text-align: center;">
          <div style="font-size: 48px; margin-bottom: 16px;">⚛️</div>
          <h3 style="font-size: 18px; font-weight: 800; color: white; margin-bottom: 8px;">React / Next.js</h3>
          <p style="font-size: 14px; color: #94a3b8;">Frontend moderno</p>
        </div>

        <div style="background: linear-gradient(135deg, rgba(6, 182, 212, 0.05) 0%, rgba(15, 23, 42, 0.5) 100%); border: 1px solid rgba(6, 182, 212, 0.2); border-radius: 16px; padding: 32px; text-align: center;">
          <div style="font-size: 48px; margin-bottom: 16px;">🟢</div>
          <h3 style="font-size: 18px; font-weight: 800; color: white; margin-bottom: 8px;">Node.js / Express</h3>
          <p style="font-size: 14px; color: #94a3b8;">Backend escalable</p>
        </div>

        <div style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.05) 0%, rgba(15, 23, 42, 0.5) 100%); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 16px; padding: 32px; text-align: center;">
          <div style="font-size: 48px; margin-bottom: 16px;">🗄️</div>
          <h3 style="font-size: 18px; font-weight: 800; color: white; margin-bottom: 8px;">PostgreSQL / MongoDB</h3>
          <p style="font-size: 14px; color: #94a3b8;">Bases de datos</p>
        </div>

        <div style="background: linear-gradient(135deg, rgba(168, 85, 247, 0.05) 0%, rgba(15, 23, 42, 0.5) 100%); border: 1px solid rgba(168, 85, 247, 0.2); border-radius: 16px; padding: 32px; text-align: center;">
          <div style="font-size: 48px; margin-bottom: 16px;">☁️</div>
          <h3 style="font-size: 18px; font-weight: 800; color: white; margin-bottom: 8px;">AWS / Azure</h3>
          <p style="font-size: 14px; color: #94a3b8;">Cloud hosting</p>
        </div>

        <div style="background: linear-gradient(135deg, rgba(251, 146, 60, 0.05) 0%, rgba(15, 23, 42, 0.5) 100%); border: 1px solid rgba(251, 146, 60, 0.2); border-radius: 16px; padding: 32px; text-align: center;">
          <div style="font-size: 48px; margin-bottom: 16px;">🎨</div>
          <h3 style="font-size: 18px; font-weight: 800; color: white; margin-bottom: 8px;">Tailwind CSS</h3>
          <p style="font-size: 14px; color: #94a3b8;">Diseño responsive</p>
        </div>

        <div style="background: linear-gradient(135deg, rgba(14, 165, 233, 0.05) 0%, rgba(15, 23, 42, 0.5) 100%); border: 1px solid rgba(14, 165, 233, 0.2); border-radius: 16px; padding: 32px; text-align: center;">
          <div style="font-size: 48px; margin-bottom: 16px;">🚀</div>
          <h3 style="font-size: 18px; font-weight: 800; color: white; margin-bottom: 8px;">CI/CD</h3>
          <p style="font-size: 14px; color: #94a3b8;">Deploy automático</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PROCESO -->
  <section style="background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%); padding: 100px 40px;">
    <div style="max-width: 1400px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 80px;">
        <h2 style="font-size: clamp(40px, 5vw, 56px); font-weight: 900; color: white; margin-bottom: 24px;">
          Nuestro Proceso de Desarrollo
        </h2>
        <p style="font-size: 20px; color: #94a3b8; max-width: 800px; margin: 0 auto;">
          Metodología ágil con entregas incrementales y comunicación constante
        </p>
      </div>

      <div style="display: grid; gap: 32px; max-width: 1000px; margin: 0 auto;">
        <div style="display: grid; grid-template-columns: 80px 1fr; gap: 32px; align-items: start;">
          <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #6366f1, #4f46e5); border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 900; color: white; box-shadow: 0 10px 30px rgba(99, 102, 241, 0.3);">
            01
          </div>
          <div>
            <h3 style="font-size: 26px; font-weight: 800; color: white; margin-bottom: 12px;">Descubrimiento & Planificación</h3>
            <p style="font-size: 17px; color: #94a3b8; line-height: 1.7;">Entendemos tus objetivos, audiencia y requisitos técnicos. Definimos alcance, cronograma y arquitectura.</p>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 80px 1fr; gap: 32px; align-items: start;">
          <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #06b6d4, #0284c7); border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 900; color: white; box-shadow: 0 10px 30px rgba(6, 182, 212, 0.3);">
            02
          </div>
          <div>
            <h3 style="font-size: 26px; font-weight: 800; color: white; margin-bottom: 12px;">Diseño & Prototipado</h3>
            <p style="font-size: 17px; color: #94a3b8; line-height: 1.7;">Creamos wireframes y prototipos interactivos. Validamos UX/UI antes de comenzar el desarrollo.</p>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 80px 1fr; gap: 32px; align-items: start;">
          <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #10b981, #059669); border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 900; color: white; box-shadow: 0 10px 30px rgba(16, 185, 129, 0.3);">
            03
          </div>
          <div>
            <h3 style="font-size: 26px; font-weight: 800; color: white; margin-bottom: 12px;">Desarrollo & Testing</h3>
            <p style="font-size: 17px; color: #94a3b8; line-height: 1.7;">Sprints de 2 semanas con entregas incrementales. Testing continuo y revisiones de código.</p>
          </div>
        </div>

        <div style="display: grid; grid-template-columns: 80px 1fr; gap: 32px; align-items: start;">
          <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #a855f7, #9333ea); border-radius: 20px; display: flex; align-items: center; justify-content: center; font-size: 32px; font-weight: 900; color: white; box-shadow: 0 10px 30px rgba(168, 85, 247, 0.3);">
            04
          </div>
          <div>
            <h3 style="font-size: 26px; font-weight: 800; color: white; margin-bottom: 12px;">Deploy & Soporte</h3>
            <p style="font-size: 17px; color: #94a3b8; line-height: 1.7;">Lanzamiento en producción con monitoreo activo. Soporte post-lanzamiento y mejoras continuas.</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="contacto" style="background: #0f172a; padding: 120px 40px; border-top: 1px solid rgba(255, 255, 255, 0.05);">
    <div style="max-width: 1000px; margin: 0 auto;">
      <div style="background: linear-gradient(135deg, rgba(99, 102, 241, 0.1) 0%, rgba(6, 182, 212, 0.05) 100%); border: 1px solid rgba(99, 102, 241, 0.2); border-radius: 32px; padding: 80px 60px; text-align: center;">
        <h2 style="font-size: clamp(36px, 4vw, 48px); font-weight: 900; color: white; margin-bottom: 24px;">
          ¿Listo para Comenzar tu Proyecto?
        </h2>
        <p style="font-size: 18px; color: #94a3b8; margin-bottom: 40px; max-width: 700px; margin-left: auto; margin-right: auto;">
          Cuéntanos sobre tu idea y te enviaremos una propuesta personalizada en 48 horas
        </p>

        <form action="/api/contact" method="POST" style="max-width: 600px; margin: 0 auto;">
          <div style="display: grid; gap: 20px;">
            <input type="text" name="nombre" placeholder="Nombre completo" required style="padding: 18px 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; color: white; font-size: 16px;" />
            <input type="email" name="email" placeholder="Email" required style="padding: 18px 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; color: white; font-size: 16px;" />
            <textarea name="proyecto" placeholder="Describe tu proyecto web..." rows="5" required style="padding: 18px 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; color: white; font-size: 16px;"></textarea>
            <button type="submit" style="padding: 20px; background: linear-gradient(135deg, #6366f1, #4f46e5); color: white; font-weight: 700; font-size: 18px; border-radius: 12px; border: none; cursor: pointer; box-shadow: 0 10px 40px rgba(99, 102, 241, 0.3);">
              Solicitar Cotización
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>
