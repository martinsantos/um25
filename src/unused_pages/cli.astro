---
import Layout from '../layouts/Layout.astro';
import SEOHead from '../components/SEO/SEOHead.astro';
import UMTerminalProfessional from '../components/UMTerminalProfessional.astro';

// SEO metadata optimizado para página CLI
const seoData = {
  title: "ULTIMA MILLA CLI | Terminal Interactivo | Explora 22 Años de Historia IT",
  description: "Terminal interactivo ULTIMA MILLA CLI: Explora 469+ proyectos, 150+ clientes y 22 años de experiencia IT en Mendoza. Comandos Linux auténticos con datos reales.",
  keywords: "terminal interactivo, CLI empresarial, ULTIMA MILLA, comandos Linux, exploración datos IT, terminal mendoza, CLI innovador",
  canonical: "https://ultimamilla.com.ar/cli"
};

// No usamos breadcrumbs en esta página para mantenerla limpia
---

<Layout>
  <SEOHead 
    title={seoData.title}
    description={seoData.description}
    keywords={seoData.keywords}
    canonical={seoData.canonical}
    ogType="website"
  />

  <div class="cli-page" data-cache-bust="2025-09-01-19-45">
    <!-- Header minimalista -->
    <header class="cli-header">
      <div class="header-content">
        <div class="brand-info">
          <h1 class="cli-title">ULTIMA MILLA CLI</h1>
          <p class="cli-subtitle">Terminal Interactivo - Explora 22 años de historia IT</p>
        </div>
        <div class="quick-info">
          <div class="stat-item">
            <span class="stat-number">469+</span>
            <span class="stat-label">Proyectos</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">150+</span>
            <span class="stat-label">Clientes</span>
          </div>
          <div class="stat-item">
            <span class="stat-number">22</span>
            <span class="stat-label">Años</span>
          </div>
        </div>
      </div>
    </header>

    <!-- Terminal principal -->
    <main class="cli-main">
      <div class="terminal-container">
        <UMTerminalProfessional />
      </div>
    </main>

    <!-- Sugerencias de comandos -->
    <section class="cli-suggestions">
      <div class="suggestions-content">
        <h2 class="suggestions-title">🚀 Comandos Sugeridos</h2>
        <div class="suggestions-grid">
          <button class="suggestion-btn" data-command="help">
            <span class="cmd">help</span>
            <span class="desc">Lista todos los comandos</span>
          </button>
          <button class="suggestion-btn" data-command="ls servicios">
            <span class="cmd">ls servicios</span>
            <span class="desc">Ver nuestros servicios IT</span>
          </button>
          <button class="suggestion-btn" data-command="grep 'Quilmes'">
            <span class="cmd">grep "Quilmes"</span>
            <span class="desc">Proyectos con Quilmes</span>
          </button>
          <button class="suggestion-btn" data-command="stats --all">
            <span class="cmd">stats --all</span>
            <span class="desc">Estadísticas generales</span>
          </button>
          <button class="suggestion-btn" data-command="top --clientes">
            <span class="cmd">top --clientes</span>
            <span class="desc">Principales clientes</span>
          </button>
          <button class="suggestion-btn" data-command="sudo ultimamilla.py --demo">
            <span class="cmd">sudo ultimamilla.py</span>
            <span class="desc">Demo completa</span>
          </button>
        </div>
      </div>
    </section>

    <!-- Footer minimalista -->
    <footer class="cli-footer">
      <div class="footer-content">
        <p>© 2024 ULTIMA MILLA - Mendoza, Argentina</p>
        <div class="footer-links">
          <a href="/">Inicio</a>
          <a href="/nosotros">Nosotros</a>
          <a href="/contacto">Contacto</a>
        </div>
      </div>
    </footer>
  </div>
</Layout>

<!-- Script para cargar el motor MEGA del UM CLI -->
<script is:inline src="/UMTerminalEngine.js"></script>

<style>
  .cli-page {
    min-height: 100vh;
    background: linear-gradient(135deg, #0f1419 0%, #1e2025 100%);
    color: #e6edf3;
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif;
  }

  /* Header */
  .cli-header {
    padding: 2rem 0;
    border-bottom: 1px solid #30363d;
  }

  .header-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 2rem;
  }

  .brand-info {
    flex: 1;
  }

  .cli-title {
    font-size: 2.5rem;
    font-weight: 900;
    margin: 0 0 0.5rem 0;
    background: linear-gradient(135deg, #00d4aa 0%, #79c0ff 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }

  .cli-subtitle {
    font-size: 1.1rem;
    color: #8b949e;
    margin: 0;
  }

  .quick-info {
    display: flex;
    gap: 2rem;
  }

  .stat-item {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .stat-number {
    font-size: 2rem;
    font-weight: 900;
    color: #00d4aa;
    line-height: 1;
  }

  .stat-label {
    font-size: 0.875rem;
    color: #8b949e;
    margin-top: 0.25rem;
  }

  /* Main content */
  .cli-main {
    padding: 3rem 0;
    flex: 1;
  }

  .terminal-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Sugerencias */
  .cli-suggestions {
    padding: 2rem 0 3rem 0;
    border-top: 1px solid #30363d;
  }

  .suggestions-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .suggestions-title {
    font-size: 1.5rem;
    font-weight: 700;
    margin: 0 0 1.5rem 0;
    text-align: center;
    color: #e6edf3;
  }

  .suggestions-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1rem;
  }

  .suggestion-btn {
    background: rgba(33, 38, 45, 0.8);
    border: 1px solid #30363d;
    border-radius: 8px;
    padding: 1rem;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: left;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .suggestion-btn:hover {
    background: rgba(33, 38, 45, 1);
    border-color: #00d4aa;
    transform: translateY(-2px);
  }

  .suggestion-btn .cmd {
    font-family: 'Fira Code', monospace;
    font-size: 0.9rem;
    color: #00d4aa;
    font-weight: 600;
  }

  .suggestion-btn .desc {
    font-size: 0.85rem;
    color: #8b949e;
  }

  /* Footer */
  .cli-footer {
    border-top: 1px solid #30363d;
    padding: 2rem 0;
    margin-top: auto;
  }

  .footer-content {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
  }

  .footer-content p {
    margin: 0;
    color: #8b949e;
    font-size: 0.9rem;
  }

  .footer-links {
    display: flex;
    gap: 2rem;
  }

  .footer-links a {
    color: #8b949e;
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s ease;
  }

  .footer-links a:hover {
    color: #00d4aa;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .header-content {
      flex-direction: column;
      text-align: center;
    }

    .cli-title {
      font-size: 2rem;
    }

    .quick-info {
      gap: 1.5rem;
    }

    .suggestions-grid {
      grid-template-columns: 1fr;
    }

    .footer-content {
      flex-direction: column;
      text-align: center;
    }

    .footer-links {
      gap: 1rem;
    }
  }

  /* Animaciones */
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .terminal-container {
    animation: fadeInUp 0.6s ease-out;
  }

  .cli-suggestions {
    animation: fadeInUp 0.8s ease-out;
  }
</style>

<script>
  // Event listeners para botones de sugerencias
  document.addEventListener('DOMContentLoaded', () => {
    const suggestionButtons = document.querySelectorAll('.suggestion-btn');
    suggestionButtons.forEach(button => {
      button.addEventListener('click', () => {
        const command = button.dataset.command;
        if (command) {
          // Buscar el input del terminal y ejecutar comando
          const terminalInput = document.getElementById('terminal-input');
          if (terminalInput) {
            terminalInput.value = command;
            terminalInput.focus();
            
            // Simular Enter
            const event = new KeyboardEvent('keydown', {
              key: 'Enter',
              bubbles: true
            });
            terminalInput.dispatchEvent(event);
            
            // Scroll suave hacia el terminal
            document.getElementById('um-terminal-enhanced-container').scrollIntoView({
              behavior: 'smooth',
              block: 'center'
            });
          }
        }
      });
    });
  });

  // Animación de entrada para elementos
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.animation = 'fadeInUp 0.6s ease-out forwards';
      }
    });
  }, observerOptions);

  // Observar elementos cuando se carga la página
  document.addEventListener('DOMContentLoaded', () => {
    const elements = document.querySelectorAll('.cli-suggestions');
    elements.forEach(el => observer.observe(el));
  });
</script>
</Layout>
