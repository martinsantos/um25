---
// VERSIÓN ALTERNATIVA - NUEVA ESTÉTICA OSCURA PROFESIONAL
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
---

<Layout 
  title="Servicios IT - Nueva Estética | ULTIMA MILLA"
  description="Versión alternativa con diseño moderno y profesional"
>
  <style>
    @keyframes pulse {
      0%, 100% { opacity: 1; }
      50% { opacity: 0.5; }
    }
    @keyframes bounce {
      0%, 100% { transform: translateX(-50%) translateY(0); }
      50% { transform: translateX(-50%) translateY(10px); }
    }
    input::placeholder, textarea::placeholder {
      color: #64748b;
    }
  </style>

  <!-- HERO OSCURO -->
  <section style="position: relative; min-height: 600px; background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); color: white; overflow: hidden;">
    <div style="position: absolute; inset: 0; opacity: 0.05; background-image: url('data:image/svg+xml,%3Csvg width=&quot;60&quot; height=&quot;60&quot; viewBox=&quot;0 0 60 60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cg fill=&quot;none&quot; fill-rule=&quot;evenodd&quot;%3E%3Cg fill=&quot;%2306b6d4&quot; fill-opacity=&quot;1&quot;%3E%3Cpath d=&quot;M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z&quot;/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
    
    <div style="position: absolute; top: -200px; right: -200px; width: 600px; height: 600px; background: radial-gradient(circle, rgba(6, 182, 212, 0.15) 0%, transparent 70%); border-radius: 50%; filter: blur(60px);"></div>

    <div style="max-width: 1400px; margin: 0 auto; padding: 120px 40px 80px; position: relative; z-index: 10;">
      <div style="max-width: 900px;">
        <div style="display: inline-flex; align-items: center; gap: 10px; padding: 10px 24px; background: rgba(6, 182, 212, 0.1); border: 1px solid rgba(6, 182, 212, 0.3); border-radius: 50px; margin-bottom: 32px;">
          <div style="width: 8px; height: 8px; background: #06b6d4; border-radius: 50%; animation: pulse 2s ease-in-out infinite;"></div>
          <span style="font-size: 13px; font-weight: 700; color: #06b6d4; text-transform: uppercase; letter-spacing: 1.5px;">Servicios IT</span>
        </div>

        <h1 style="font-size: clamp(48px, 6vw, 72px); font-weight: 900; line-height: 1.1; margin-bottom: 28px; letter-spacing: -0.02em;">
          Protección Integral y Confianza Para Sus Activos Digitales
        </h1>

        <p style="font-size: 20px; line-height: 1.7; color: #cbd5e1; margin-bottom: 40px; max-width: 700px;">
          Soluciones de ciberseguridad con estándares de tecnología de Marca y Niveles certificados, resultados comprobados y soporte 24/7.
        </p>

        <div style="display: flex; gap: 16px; flex-wrap: wrap;">
          <a href="#contacto" style="display: inline-flex; align-items: center; gap: 12px; padding: 18px 36px; background: linear-gradient(135deg, #06b6d4, #0ea5e9); color: white; font-weight: 700; font-size: 16px; border-radius: 12px; text-decoration: none; box-shadow: 0 10px 40px rgba(6, 182, 212, 0.3); transition: all 0.3s ease;">
            Hable con un Experto
            <svg style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div style="position: absolute; bottom: 40px; left: 50%; transform: translateX(-50%); animation: bounce 2s ease-in-out infinite;">
      <svg style="width: 24px; height: 24px; color: #06b6d4;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
      </svg>
    </div>
  </section>

  <!-- STATS -->
  <section style="background: #0f172a; padding: 80px 40px; border-top: 1px solid rgba(255, 255, 255, 0.05);">
    <div style="max-width: 1400px; margin: 0 auto;">
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px;">
        <div style="background: linear-gradient(135deg, rgba(15, 23, 42, 0.8) 0%, rgba(30, 41, 59, 0.8) 100%); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 24px; padding: 48px 32px; text-align: center;">
          <div style="font-size: 56px; font-weight: 900; color: #06b6d4; margin-bottom: 12px;">64.1M</div>
          <div style="font-size: 18px; font-weight: 700; color: white; margin-bottom: 8px;">Datos Protegidos</div>
          <div style="font-size: 14px; color: #06b6d4; font-weight: 600;">+20% vs año anterior</div>
        </div>
        <div style="background: linear-gradient(135deg, rgba(15, 23, 42, 0.8) 0%, rgba(30, 41, 59, 0.8) 100%); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 24px; padding: 48px 32px; text-align: center;">
          <div style="font-size: 56px; font-weight: 900; color: #0ea5e9; margin-bottom: 12px;">212</div>
          <div style="font-size: 18px; font-weight: 700; color: white; margin-bottom: 8px;">Días Promedio</div>
          <div style="font-size: 14px; color: #0ea5e9; font-weight: 600;">+5% vs año anterior</div>
        </div>
        <div style="background: linear-gradient(135deg, rgba(15, 23, 42, 0.8) 0%, rgba(30, 41, 59, 0.8) 100%); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 24px; padding: 48px 32px; text-align: center;">
          <div style="font-size: 56px; font-weight: 900; color: #10b981; margin-bottom: 12px;">150%</div>
          <div style="font-size: 18px; font-weight: 700; color: white; margin-bottom: 8px;">Aumento Rendimiento</div>
          <div style="font-size: 14px; color: #10b981; font-weight: 600;">+8% vs año anterior</div>
        </div>
      </div>
    </div>
  </section>

  <!-- FEATURES -->
  <section style="background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%); padding: 100px 40px;">
    <div style="max-width: 1400px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 80px;">
        <h2 style="font-size: clamp(40px, 5vw, 56px); font-weight: 900; color: white; margin-bottom: 24px;">
          Protección Integral Adaptada a TI
        </h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 32px;">
        <div style="background: rgba(15, 23, 42, 0.5); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 24px; padding: 48px;">
          <div style="width: 72px; height: 72px; background: linear-gradient(135deg, rgba(6, 182, 212, 0.2), rgba(6, 182, 212, 0.1)); border: 2px solid rgba(6, 182, 212, 0.4); border-radius: 20px; display: flex; align-items: center; justify-content: center; margin-bottom: 28px; font-size: 32px;">
            🛡️
          </div>
          <h3 style="font-size: 24px; font-weight: 800; color: white; margin-bottom: 16px;">Detección Proactiva</h3>
          <p style="font-size: 16px; color: #94a3b8; line-height: 1.7;">Identificamos y mitigamos amenazas antes de que afecten tu operación.</p>
        </div>

        <div style="background: rgba(15, 23, 42, 0.5); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 24px; padding: 48px;">
          <div style="width: 72px; height: 72px; background: linear-gradient(135deg, rgba(14, 165, 233, 0.2), rgba(14, 165, 233, 0.1)); border: 2px solid rgba(14, 165, 233, 0.4); border-radius: 20px; display: flex; align-items: center; justify-content: center; margin-bottom: 28px; font-size: 32px;">
            ⚡
          </div>
          <h3 style="font-size: 24px; font-weight: 800; color: white; margin-bottom: 16px;">Respuesta a Incidentes</h3>
          <p style="font-size: 16px; color: #94a3b8; line-height: 1.7;">Equipo disponible 24/7 para neutralizar amenazas en tiempo real.</p>
        </div>

        <div style="background: rgba(15, 23, 42, 0.5); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 24px; padding: 48px;">
          <div style="width: 72px; height: 72px; background: linear-gradient(135deg, rgba(16, 185, 129, 0.2), rgba(16, 185, 129, 0.1)); border: 2px solid rgba(16, 185, 129, 0.4); border-radius: 20px; display: flex; align-items: center; justify-content: center; margin-bottom: 28px; font-size: 32px;">
            🔄
          </div>
          <h3 style="font-size: 24px; font-weight: 800; color: white; margin-bottom: 16px;">Gestión Continua</h3>
          <p style="font-size: 16px; color: #94a3b8; line-height: 1.7;">Monitoreo constante y actualizaciones automáticas de seguridad.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="contacto" style="background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%); padding: 120px 40px;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <div style="background: rgba(15, 23, 42, 0.5); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 32px; padding: 80px 60px;">
        <div style="text-align: center; margin-bottom: 60px;">
          <h2 style="font-size: clamp(40px, 5vw, 56px); font-weight: 900; color: white; margin-bottom: 24px;">
            Proteja su Negocio Hoy
          </h2>
        </div>

        <form action="/api/contact" method="POST" style="max-width: 700px; margin: 0 auto;">
          <div style="display: grid; gap: 24px; margin-bottom: 32px;">
            <input type="text" name="nombre" placeholder="Nombre completo" required style="padding: 18px 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; color: white; font-size: 16px;" />
            <input type="email" name="email" placeholder="Email corporativo" required style="padding: 18px 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; color: white; font-size: 16px;" />
            <textarea name="mensaje" placeholder="Cuéntenos sobre su proyecto..." rows="5" required style="padding: 18px 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; color: white; font-size: 16px;"></textarea>
          </div>

          <button type="submit" style="width: 100%; padding: 20px; background: linear-gradient(135deg, #06b6d4, #0ea5e9); color: white; font-weight: 700; font-size: 18px; border-radius: 12px; border: none; cursor: pointer;">
            Enviar Solicitud
          </button>
        </form>
      </div>
    </div>
  </section>
</Layout>
