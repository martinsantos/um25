---
// src/pages/test-mobile-components.astro
// Test page for new mobile-optimized components

import Layout from '@/layouts/Layout.astro';
import HeaderMobileOptimized from '@/components/HeaderMobileOptimized.astro';
import HeroBannerMobileOptimized from '@/components/HeroBannerMobileOptimized.astro';
import AntecedentesGridMobileOptimized from '@/components/AntecedentesGridMobileOptimized.astro';
import FooterMobileOptimized from '@/components/FooterMobileOptimized.astro';

// Remove the default header since we're using our optimized version
const hideHeader = true;
---

<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Test - Componentes Móviles Optimizados</title>
  <meta name="description" content="Página de prueba para componentes móviles optimizados de Ultima Milla" />
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
    }
  </style>
</head>
<body>
  <!-- Header Optimizado -->
  <HeaderMobileOptimized title="Ultima Milla" />

  <!-- Hero Banner Optimizado -->
  <HeroBannerMobileOptimized
    title="Soluciones IT"
    subtitle="que transforman negocios"
    ctaText="Conversemos"
    ctaLink="/contacto"
    secondaryCtaText="Ver Casos"
    secondaryCtaLink="/antecedentes"
  />

  <!-- Antecedentes Grid Optimizado -->
  <AntecedentesGridMobileOptimized
    limit={12}
    title="Últimos Casos de Éxito"
    description="Explora nuestros proyectos más recientes y descubre cómo hemos transformado empresas"
  />

  <!-- Footer Optimizado -->
  <FooterMobileOptimized />

  <!-- Test Info Banner -->
  <div style="background-color: #f0f9ff; border-top: 4px solid #06b6d4; padding: 2rem; text-align: center;">
    <h2 style="color: #0369a1; margin-bottom: 1rem;">✅ Componentes Móviles Optimizados Cargados</h2>
    <p style="color: #475569; margin-bottom: 0.5rem;">Esta es una página de prueba que valida:</p>
    <ul style="list-style: none; color: #475569;">
      <li>✓ HeaderMobileOptimized - Menú hamburguesa funcional</li>
      <li>✓ HeroBannerMobileOptimized - Tipografía fluid y estadísticas</li>
      <li>✓ AntecedentesGridMobileOptimized - Grid adaptativo 1→2→3 columnas</li>
      <li>✓ FooterMobileOptimized - Acordeones en móvil</li>
    </ul>
    <p style="color: #64748b; margin-top: 1rem; font-size: 0.875rem;">
      Abre las DevTools (F12) y cambia a vista móvil (320px, 768px, 1024px) para validar responsividad
    </p>
  </div>
</body>
</html>
