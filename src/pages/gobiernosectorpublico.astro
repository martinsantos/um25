---
import Layout from '../layouts/Layout.astro';
import { directus, DEFAULT_IMAGE, getAntecedenteImageUrl } from '../utils/directus';
import { generateSlug } from '../utils/slugUtils';

// Configuración SEO específica para gobierno - ULTRA OPTIMIZADA para Argentina y Mendoza
const seoConfig = {
  title: "Tecnología para Sector Público y Gobierno | Digitalización del Estado | ULTIMA MILLA",
  description: "Soluciones IT para organismos públicos: redes gubernamentales, digitalización estatal, modernización municipal y sistemas críticos con máxima seguridad.",
  keywords: "servicios tecnologicos gobierno, infraestructura sector publico mendoza, redes gubernamentales cuyo, telecomunicaciones municipios patagonia, corrientes debiles entidades publicas, digitalizacion estado, modernizacion municipalidades",
  ogImage: "/images/services/servicios-it.jpg",
  canonical: "https://ultimamilla.com.ar/gobiernosectorpublico",
  locale: "es_AR",
  region: "Cuyo, Patagonia, Argentina",
  author: "Ultima Milla",
  robots: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
};

// Cargar antecedentes del sector gobierno
import { antecedentesReales } from '../data/antecedentes_completos.js';
import AntecedentesGridMobileOptimized from '../components/AntecedentesGridMobileOptimized.astro';

let antecedentes = [];
let serviciosRelacionados = [];
let error = null;

const keywords = [
  // Core government - BE MORE SPECIFIC
  'gobierno', 'municipalidad', 'intendencia', 'comuna', 'municipio',
  'ministerio', 'secretaria de estado', 'subsecretaria',
  'direccion general', 'departamento general',
  // Judicial & Legislative
  'poder judicial', 'corte suprema', 'suprema corte', 'juzgado', 'fiscalia',
  'tribunal',  'legislatura', 'camara de diputados', 'senado',
  // Federal entities
  'afip', 'inta', 'inti', 'conicet', 'cnea', 'senasa',
  // Provincial/Local - EXCLUDE HEALTH
  'dgi', 'rentas mendoza', 'irrigacion', 'atm mendoza', 'ase',
  'parques nacionales', 'secretaria de ambiente',
  'anses', 'pami',
  // Municipal - need to be PRECISE so they don't conflict with health/education
  'municipalidad de maipu', 'municipalidad de guaymallen',
  'municipalidad de san martin', 'municipalidad de godoy cruz',
  'municipalidad de lujan', 'municipalidad de las heras',
  'municipalidad de capital', 'municipalidad de san rafael'
];

const filterAntecedentes = async (data) => {
  const filtered = data.filter(item => {
    const cliente = (item.Cliente || '').toLowerCase();
    const titulo = (item.Titulo || '').toLowerCase();
    const area = (item.Area || '').toLowerCase();
    return keywords.some(k => cliente.includes(k) || titulo.includes(k) || area.includes(k));
  });

  const withImages = await Promise.all(
    filtered.map(async (item) => ({
      ...item,
      Nombre: item.Titulo,
      mapeo_imagenes_completo: await getAntecedenteImageUrl(item),
      slug: `${item.id}/${generateSlug(item.Titulo)}`
    }))
  );

  return withImages.sort((a, b) => new Date(b.Fecha || '2000-01-01') - new Date(a.Fecha || '2000-01-01'));
};

try {
  // Obtener antecedentes de gobierno desde Directus
  const response = await directus.getAntecedentes({
    limit: 500,
    page: 1
  });

  if (response && response.data && response.data.length > 0) {
    antecedentes = await filterAntecedentes(response.data);
    console.log(`✅ Cargados ${antecedentes.length} antecedentes de gobierno`);
  }
} catch (err) {
  console.error('Error cargando antecedentes:', err);
  error = err;
}

// Fallback a datos locales si no hay resultados de API
if (antecedentes.length === 0) {
  console.log('Usando antecedentes locales para Gobierno');
  antecedentes = await filterAntecedentes(antecedentesReales);
}

// Limitar a 6 para la vista (ELIMINADO - Ahora se maneja en el componente con "Ver más")
// antecedentes = antecedentes.slice(0, 6);

  // Servicios relacionados con el sector gobierno
  // Structured Data para SEO
  const structuredData = {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Infraestructura IT para Gobierno",
    "provider": {
      "@type": "Organization",
      "name": "Ultima Milla",
      "url": "https://www.ultimamilla.com.ar",
      "logo": "https://www.ultimamilla.com.ar/images/um-logo.png",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Mendoza",
        "addressRegion": "Mendoza",
        "addressCountry": "AR"
      }
    },
    "areaServed": [
      {
        "@type": "City",
        "name": "Mendoza"
      },
      {
        "@type": "Country",
        "name": "Argentina"
      }
    ],
    "audience": {
      "@type": "BusinessAudience",
      "name": "Gobierno y Empresas de Construcción"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Servicios IT para Gobierno",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Cableado Estructurado para Obras"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Sistemas de Seguridad CCTV y Control de Accesos"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Conectividad Temporal para Canteros"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Telefonía IP Empresarial"
          }
        }
      ]
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "50"
    }
  };

  serviciosRelacionados = [
    {
      id: 1,
      nombre: "Redes de Datos",
      descripcion: "Infraestructura de redes para entidades públicas",
      icon: "network",
      slug: "redes-datos"
    },
    {
      id: 2,
      nombre: "Seguridad Informática",
      descripcion: "Protección de sistemas y datos gubernamentales",
      icon: "shield",
      slug: "seguridad-informatica"
    },
    {
      id: 3,
      nombre: "Telecomunicaciones",
      descripcion: "Sistemas de comunicación integrados para gobierno",
      icon: "wifi",
      slug: "telecomunicaciones"
    },
    {
      id: 4,
      nombre: "Servicios IT",
      descripcion: "Consultoría y soluciones IT para sector público",
      icon: "phone",
      slug: "servicios-it"
    },
    {
      id: 5,
      nombre: "Software Personalizado",
      descripcion: "Desarrollo de sistemas para entidades públicas",
      icon: "alert",
      slug: "software-personalizado"
    },
    {
      id: 6,
      nombre: "Soporte Técnico 24/7",
      descripcion: "Asistencia técnica especializada continua",
      icon: "support",
      slug: "soporte-tecnico"
    }
  ];

// Función para obtener imagen del antecedente (Ya no es necesaria aquí, la maneja el componente)
// const antecedentesConImagenes = ... (Eliminado)
---

<Layout
  title={seoConfig.title}
  description={seoConfig.description}
  keywords={seoConfig.keywords}
  image={seoConfig.ogImage}
  canonical={seoConfig.canonical}
>
  <main style="background: #f5f5f5;">
    <!-- HERO EXACTO DEL BOCETO -->
    <section style="position: relative; min-height: 350px; display: flex; align-items: center; background: linear-gradient(rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0.65)), url('https://images.unsplash.com/photo-1523726491678-bf852e717f6a?w=1920&q=80') center/cover; color: white;">
