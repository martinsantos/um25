---
import LayoutV4 from '../layouts/LayoutV4.astro';
import HeroPageV4 from '../components/v4/HeroPageV4.astro';

// SEO Data optimizado para contacto local
const seoData = {
  title: "Contacto ULTIMA MILLA Mendoza | Consulta Gratuita Servicios IT | Empresa Tecnológica",
  description: "Contacta con ULTIMA MILLA en Mendoza para una consulta gratuita. +20 años en servicios IT. Presencia local, soporte 24/7. Houssay 1159, Guaymallén, Mendoza.",
  keywords: "contacto ultima milla mendoza, consulta gratuita IT mendoza, empresa tecnología mendoza, servicios IT mendoza contacto, soporte técnico mendoza, oficina mendoza",
};

// Breadcrumb data
const breadcrumb = [
  { label: 'Inicio', href: '/' },
  { label: 'Contacto', href: '/contacto' },
];

// Stats data
const stats = [
  { value: '469+', label: 'Proyectos' },
  { value: '22+', label: 'Años' },
  { value: '24/7', label: 'Soporte' },
];
---

<LayoutV4 title={seoData.title} description={seoData.description} keywords={seoData.keywords}>

  <!-- Hero Section V4 -->
  <HeroPageV4
    title="Hablemos de su"
    titleHighlight="Próximo Proyecto"
    subtitle="Nuestro equipo está listo para ayudarlo a transformar su infraestructura tecnológica."
    breadcrumb={breadcrumb}
    badge={{ icon: 'message', text: 'Contacto' }}
    stats={stats}
  />

  <!-- Proceso de Trabajo Section -->
  <section class="bg-um-primary-bg border-b border-um-primary/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-10 lg:py-12">
      <div class="text-center mb-6 sm:mb-8">
        <h2 class="text-lg sm:text-xl font-bold text-um-dark">Nuestro Proceso de Trabajo</h2>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6">
        <div class="flex items-center gap-3 sm:gap-4">
          <div class="w-8 h-8 sm:w-10 sm:h-10 bg-um-accent rounded-full flex items-center justify-center text-white font-bold flex-shrink-0 text-sm sm:text-base">1</div>
          <div>
            <div class="font-semibold text-um-dark text-sm sm:text-base">Consulta</div>
            <div class="text-xs sm:text-sm text-um-gray">Análisis de necesidades</div>
          </div>
        </div>
        <div class="flex items-center gap-3 sm:gap-4">
          <div class="w-8 h-8 sm:w-10 sm:h-10 bg-um-accent rounded-full flex items-center justify-center text-white font-bold flex-shrink-0 text-sm sm:text-base">2</div>
          <div>
            <div class="font-semibold text-um-dark text-sm sm:text-base">Propuesta</div>
            <div class="text-xs sm:text-sm text-um-gray">Diseño técnico y cotización</div>
          </div>
        </div>
        <div class="flex items-center gap-3 sm:gap-4">
          <div class="w-8 h-8 sm:w-10 sm:h-10 bg-um-accent rounded-full flex items-center justify-center text-white font-bold flex-shrink-0 text-sm sm:text-base">3</div>
          <div>
            <div class="font-semibold text-um-dark text-sm sm:text-base">Desarrollo</div>
            <div class="text-xs sm:text-sm text-um-gray">Implementación y testing</div>
          </div>
        </div>
        <div class="flex items-center gap-3 sm:gap-4">
          <div class="w-8 h-8 sm:w-10 sm:h-10 bg-um-accent rounded-full flex items-center justify-center text-white font-bold flex-shrink-0 text-sm sm:text-base">4</div>
          <div>
            <div class="font-semibold text-um-dark text-sm sm:text-base">Entrega</div>
            <div class="text-xs sm:text-sm text-um-gray">Documentación y soporte</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Form + Info Section -->
  <section class="py-10 sm:py-14 lg:py-20 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 sm:gap-10 lg:gap-12">

        <!-- Form (3 cols) -->
        <div class="lg:col-span-3">
          <h2 class="text-xl sm:text-2xl font-bold text-um-dark mb-4 sm:mb-6">Cuéntenos sobre su Proyecto</h2>

          <form id="contactForm" class="space-y-4 sm:space-y-6">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
              <div>
                <label for="name" class="block text-sm font-medium text-um-dark mb-2">Nombre Completo *</label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-um-primary/20 focus:border-um-primary transition-colors"
                  placeholder="Juan Pérez"
                />
                <span class="text-red-500 text-sm hidden" id="nameError"></span>
              </div>
              <div>
                <label for="company" class="block text-sm font-medium text-um-dark mb-2">Empresa *</label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  required
                  class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-um-primary/20 focus:border-um-primary transition-colors"
                  placeholder="Su Empresa S.A."
                />
              </div>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
              <div>
                <label for="email" class="block text-sm font-medium text-um-dark mb-2">Email Corporativo *</label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-um-primary/20 focus:border-um-primary transition-colors"
                  placeholder="juan@empresa.com"
                />
                <span class="text-red-500 text-sm hidden" id="emailError"></span>
              </div>
              <div>
                <label for="phone" class="block text-sm font-medium text-um-dark mb-2">Teléfono</label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-um-primary/20 focus:border-um-primary transition-colors"
                  placeholder="+54 261 000-0000"
                />
              </div>
            </div>

            <div>
              <label for="projectType" class="block text-sm font-medium text-um-dark mb-2">Tipo de Proyecto *</label>
              <select
                id="projectType"
                name="projectType"
                required
                class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-um-primary/20 focus:border-um-primary bg-white transition-colors"
              >
                <option value="">Seleccione una opción</option>
                <option value="redes">Infraestructura de Redes</option>
                <option value="seguridad">Seguridad Electrónica</option>
                <option value="telecom">Telecomunicaciones</option>
                <option value="software">Desarrollo de Software</option>
                <option value="soporte">Soporte IT</option>
                <option value="consultoria">Consultoría</option>
                <option value="incendios">Detección de Incendios</option>
                <option value="electricos">Tableros Eléctricos</option>
                <option value="otro">Otro</option>
              </select>
              <span class="text-red-500 text-sm hidden" id="projectTypeError"></span>
            </div>

            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
              <div>
                <label for="budget" class="block text-sm font-medium text-um-dark mb-2">Presupuesto Estimado</label>
                <select
                  id="budget"
                  name="budget"
                  class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-um-primary/20 focus:border-um-primary bg-white transition-colors"
                >
                  <option value="">Seleccione un rango</option>
                  <option value="10k">Menos de USD 10.000</option>
                  <option value="10-50k">USD 10.000 - 50.000</option>
                  <option value="50-100k">USD 50.000 - 100.000</option>
                  <option value="100k+">Más de USD 100.000</option>
                  <option value="ns">No estoy seguro</option>
                </select>
              </div>
              <div>
                <label for="timeline" class="block text-sm font-medium text-um-dark mb-2">Timeline Preferido</label>
                <select
                  id="timeline"
                  name="timeline"
                  class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-um-primary/20 focus:border-um-primary bg-white transition-colors"
                >
                  <option value="">Seleccione una opción</option>
                  <option value="urgente">Urgente (menos de 1 mes)</option>
                  <option value="1-3">1 a 3 meses</option>
                  <option value="3-6">3 a 6 meses</option>
                  <option value="6+">Más de 6 meses</option>
                  <option value="flexible">Flexible</option>
                </select>
              </div>
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-um-dark mb-2">Descripción del Proyecto *</label>
              <textarea
                id="message"
                name="message"
                required
                rows="5"
                class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-um-primary/20 focus:border-um-primary resize-none transition-colors"
                placeholder="Describa brevemente su proyecto, necesidades actuales y objetivos..."
              ></textarea>
              <span class="text-red-500 text-sm hidden" id="messageError"></span>
            </div>

            <!-- Campo honeypot oculto para detectar bots -->
            <input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off" />

            <div class="flex items-start gap-3">
              <input
                type="checkbox"
                id="privacy"
                name="privacy"
                required
                class="mt-1 w-4 h-4 rounded border-gray-300 text-um-accent focus:ring-um-accent"
              />
              <label for="privacy" class="text-sm text-um-gray">
                Acepto la <a href="/privacidad" class="text-um-primary hover:underline">política de privacidad</a> y autorizo el tratamiento de mis datos para recibir información comercial.
              </label>
            </div>

            <button
              type="submit"
              class="w-full py-4 bg-um-accent text-white font-bold rounded-xl hover:bg-um-accent-dark transition-colors flex items-center justify-center gap-2 min-h-[48px]"
            >
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
              </svg>
              Enviar Consulta
            </button>

            <!-- Mensajes de estado -->
            <div id="successMessage" class="hidden bg-green-50 border border-green-200 text-green-700 p-4 rounded-xl">
              Mensaje enviado exitosamente. Nos pondremos en contacto contigo pronto.
            </div>
            <div id="errorMessage" class="hidden bg-red-50 border border-red-200 text-red-700 p-4 rounded-xl">
              Hubo un error al enviar el mensaje. Por favor, intenta nuevamente.
            </div>
          </form>
        </div>

        <!-- Contact Info (2 cols) -->
        <div class="lg:col-span-2 space-y-6 sm:space-y-8">

          <!-- Direct Contact -->
          <div class="bg-gray-50 rounded-2xl p-6 sm:p-8">
            <h3 class="font-bold text-um-dark mb-4 sm:mb-6 text-base sm:text-lg">Contacto Directo</h3>

            <div class="space-y-4 sm:space-y-5">
              <a href="mailto:contacto@ultimamilla.com.ar" class="flex items-start gap-4 group">
                <div class="w-12 h-12 bg-um-primary rounded-xl flex items-center justify-center flex-shrink-0 group-hover:bg-um-primary-dark transition-colors">
                  <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div>
                  <div class="text-sm text-um-gray">Email</div>
                  <div class="font-semibold text-um-dark group-hover:text-um-primary transition-colors">contacto@ultimamilla.com.ar</div>
                </div>
              </a>
            </div>
          </div>

          <!-- Address -->
          <div class="bg-gray-50 rounded-2xl p-6 sm:p-8">
            <h3 class="font-bold text-um-dark mb-4 sm:mb-6 text-base sm:text-lg">Nuestra Oficina</h3>

            <div class="flex items-start gap-3 sm:gap-4 mb-4 sm:mb-6">
              <div class="w-12 h-12 bg-um-primary rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-5 h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold text-um-dark">Houssay 1159</div>
                <div class="text-um-gray">Guaymallén, Mendoza 5500</div>
                <div class="text-um-gray">Argentina</div>
              </div>
            </div>

            <div class="flex items-start gap-3 sm:gap-4">
              <div class="w-10 h-10 sm:w-12 sm:h-12 bg-um-primary rounded-xl flex items-center justify-center flex-shrink-0">
                <svg class="w-4 h-4 sm:w-5 sm:h-5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <div class="font-semibold text-um-dark text-sm sm:text-base">Horario de Atención</div>
                <div class="text-um-gray text-sm sm:text-base">Lunes a Viernes: 8:00 - 18:00</div>
                <div class="text-um-gray text-sm sm:text-base">Soporte 24/7 para clientes</div>
              </div>
            </div>
          </div>

          <!-- Map -->
          <div class="bg-gray-200 rounded-2xl h-48 sm:h-56 lg:h-64 overflow-hidden">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3350.5!2d-68.82!3d-32.89!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x967e0f1e9a1a1a1a%3A0x1a1a1a1a1a1a1a1a!2sHoussay%201159%2C%20Guaymall%C3%A9n%2C%20Mendoza!5e0!3m2!1ses!2sar!4v1704067200000"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="no-referrer-when-downgrade"
              class="grayscale hover:grayscale-0 transition-all duration-500"
              title="Ubicación de Ultima Milla en Mendoza"
            ></iframe>
          </div>

        </div>
      </div>
    </div>
  </section>

</LayoutV4>

<script>
  // Form handling
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const successMessage = document.getElementById('successMessage');
  const errorMessage = document.getElementById('errorMessage');
  const errorElements = {
    name: document.getElementById('nameError'),
    email: document.getElementById('emailError'),
    message: document.getElementById('messageError')
  };

  function isValidEmail(email: string) {
    const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
    return re.test(email);
  }

  function showError(field: keyof typeof errorElements, message: string) {
    const errorElement = errorElements[field];
    if (errorElement) {
      errorElement.textContent = message;
      errorElement.classList.remove('hidden');
    }
  }

  function clearErrors() {
    Object.values(errorElements).forEach(element => {
      if (element) {
        element.textContent = '';
        element.classList.add('hidden');
      }
    });
    successMessage?.classList.add('hidden');
    errorMessage?.classList.add('hidden');
  }

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      clearErrors();

      const formData = new FormData(form);
      const data = Object.fromEntries(formData);
      let hasErrors = false;

      // Validations
      if (!data.name) {
        showError('name', 'El nombre es requerido');
        hasErrors = true;
      }

      if (!data.email) {
        showError('email', 'El email es requerido');
        hasErrors = true;
      } else if (!isValidEmail(data.email.toString())) {
        showError('email', 'Por favor ingresa un email válido');
        hasErrors = true;
      }

      if (!data.message) {
        showError('message', 'El mensaje es requerido');
        hasErrors = true;
      }

      if (hasErrors) return;

      try {
        const submitData = {
          name: data.name,
          email: data.email,
          company: data.company || '',
          phone: data.phone || '',
          projectType: data.projectType || '',
          budget: data.budget || '',
          timeline: data.timeline || '',
          message: data.message,
          website: data.website || '' // Honeypot field
        };

        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(submitData)
        });

        const result = await response.json();

        if (result.success) {
          if (successMessage) {
            successMessage.textContent = result.message || 'Mensaje enviado exitosamente. Te contactaremos pronto.';
            successMessage.classList.remove('hidden');
            form.reset();
          }
        } else {
          if (errorMessage) {
            errorMessage.textContent = result.message || 'Error al enviar el mensaje. Por favor, intenta nuevamente.';
            errorMessage.classList.remove('hidden');
          }
        }
      } catch (error) {
        console.error('Error al enviar formulario:', error);
        if (errorMessage) {
          errorMessage.textContent = 'Error de conexión. Por favor, intenta nuevamente o contacta por email.';
          errorMessage.classList.remove('hidden');
        }
      }
    });
  }
</script>

<style>
  /* Estilos para el layout de contacto */
  #contact-layout {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  
  @media (min-width: 1024px) {
    #contact-layout {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    #contact-layout > div:last-child {
      position: sticky;
      top: 2rem;
      align-self: flex-start;
    }
  }

  @media (max-width: 1023px) {
    #contact-layout > div:first-child {
      order: 1;
    }
    #contact-layout > div:last-child {
      order: 2;
      text-align: center;
    }
  }
</style>
