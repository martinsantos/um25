---
import LayoutV4 from '../layouts/LayoutV4.astro';
import MetricStrip from '../components/um/MetricStrip.astro';
import UMButton from '../components/um/UMButton.astro';
import SectionHeader from '../components/um/SectionHeader.astro';

const seoData = {
  title: 'Contacto | ULTIMA MILLA',
  description: 'Contacte a ULTIMA MILLA para servicios IT integrales: redes, seguridad electrónica, telecomunicaciones, software, soporte, energía IT e infraestructura crítica.',
  keywords: 'contacto ultima milla, servicios IT Mendoza, soporte IT, infraestructura tecnologica, seguridad electronica, telecomunicaciones'
};

const startedAt = Date.now();

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contacto ULTIMA MILLA',
  url: 'https://ultimamilla.com.ar/contacto',
  about: {
    '@type': 'Organization',
    name: 'ULTIMA MILLA',
    email: 'contacto@ultimamilla.com.ar',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Houssay 1159',
      addressLocality: 'Guaymallén',
      addressRegion: 'Mendoza',
      addressCountry: 'AR'
    }
  }
};
---

<LayoutV4 title={seoData.title} description={seoData.description} keywords={seoData.keywords} structuredData={structuredData}>
  <section class="contact-dossier">
    <div class="um-container contact-dossier__grid">
      <div class="contact-dossier__copy">
        <nav class="contact-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Inicio</a>
          <span>/</span>
          <span>Contacto</span>
        </nav>
        <span class="um-kicker">Contacto</span>
        <h1>Enviá contexto técnico. Respondemos con el próximo paso.</h1>
        <p>
          Partner de infraestructura crítica desde Mendoza (Argentina): redes, seguridad, soporte,
          software, energía o licitación. Envíe contexto mínimo y respondemos con el próximo paso técnico.
        </p>

        <div class="contact-dossier__actions" aria-label="Acciones principales de contacto">
          <UMButton href="#contactForm">Solicitar diagnóstico</UMButton>
          <UMButton href="mailto:contacto@ultimamilla.com.ar" variant="secondary">Escribir por email</UMButton>
        </div>

        <MetricStrip
          class="contact-proofline"
          metrics={[
            { value: '24/7', label: 'soporte para clientes activos' },
            { value: '469+', label: 'antecedentes documentados' },
            { value: '22+', label: 'años de trayectoria técnica' },
          ]}
        />
      </div>

      <article class="contact-form-panel contact-form-panel--hero">
        <span class="um-kicker">Solicitud</span>
        <h2>Consulta rápida</h2>
        <p class="contact-form-panel__lead">
          Cuatro campos visibles alcanzan. Si hay pliego, urgencia o múltiples sedes, dejalo escrito en el mensaje.
        </p>

        <form id="contactForm" class="contact-form" method="post" action="/api/contact" novalidate>
          <div class="field-grid">
            <label>
              <span>Nombre *</span>
              <input type="text" id="name" name="name" required autocomplete="name" placeholder="Nombre y apellido" />
              <small id="nameError" class="field-error hidden"></small>
            </label>
            <label>
              <span>Email *</span>
              <input type="email" id="email" name="email" required autocomplete="email" placeholder="nombre@empresa.com" />
              <small id="emailError" class="field-error hidden"></small>
            </label>
          </div>

          <label>
            <span>Empresa u organismo</span>
            <input type="text" id="company" name="company" autocomplete="organization" placeholder="Opcional" />
          </label>

          <label>
            <span>Mensaje *</span>
            <textarea id="message" name="message" required rows="5" placeholder="Servicio requerido, sitio o sedes, urgencia, restricción principal y objetivo esperado."></textarea>
            <small id="messageError" class="field-error hidden"></small>
          </label>

          <input type="text" id="website" name="website" class="contact-hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
          <input type="hidden" id="startedAt" name="startedAt" value={startedAt} />

          <div class="contact-submit-row">
            <button type="submit" class="um-btn-primary contact-submit">Enviar consulta</button>
          </div>
          <p class="contact-submit-note">No usamos captcha visible. El filtro antispam corre en segundo plano.</p>

          <div id="successMessage" class="form-message success hidden" role="status">
            Mensaje enviado. Vamos a responder por email con próximos pasos.
          </div>
          <div id="errorMessage" class="form-message error hidden" role="alert">
            No se pudo enviar. Revisá los datos o escribí a contacto@ultimamilla.com.ar.
          </div>
        </form>
      </article>
    </div>
  </section>

  <section class="contact-intents">
    <div class="um-container">
      <SectionHeader kicker="Por intención" title="Elegí el próximo paso según tu situación" />
      <div class="contact-intents__grid">
        <a class="contact-intent" href="#contactForm" data-intent="diagnostico">
          <span>Diagnóstico inicial</span>
          <strong>Caída, incidente o urgencia operativa</strong>
          <p>Indicá sistema afectado, sede y ventana de intervención.</p>
        </a>
        <a class="contact-intent" href="#contactForm" data-intent="relevamiento">
          <span>Relevamiento técnico</span>
          <strong>Red, CCTV, energía o software en sitio</strong>
          <p>Compartí alcance, cantidad de sedes y restricciones del edificio.</p>
        </a>
        <a class="contact-intent" href="#contactForm" data-intent="abono">
          <span>Abono / soporte</span>
          <strong>Continuidad 24/7 para operación activa</strong>
          <p>Detallá activos críticos, SLA esperado y horarios de atención.</p>
        </a>
        <a class="contact-intent" href="#contactForm" data-intent="pliego">
          <span>Licitación / pliego</span>
          <strong>Documentación y alcance para compras</strong>
          <p>Adjuntá pliego, fechas y requisitos de certificación en el mensaje.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="contact-action">
    <div class="um-container contact-action__grid">

      <aside class="contact-context">
        <div class="contact-context__block">
          <SectionHeader kicker="Para acelerar la respuesta" title="Qué conviene incluir" />
          <ul>
            <li>Servicio principal o sistema afectado.</li>
            <li>Sede, ciudad o cantidad de sitios involucrados.</li>
            <li>Urgencia real, ventana de intervención o fecha de pliego.</li>
            <li>Riesgo operativo: caída, seguridad, auditoría, crecimiento o mantenimiento.</li>
          </ul>
        </div>

        <div class="contact-context__block contact-context__block--line">
          <span>Alcances frecuentes</span>
          <p>
            Abonos de soporte, relevamientos de red, CCTV/SDI, detección de incendios, tableros para
            salas técnicas, software operativo y documentación para licitaciones.
          </p>
        </div>

        <div class="contact-address">
          <span>Dirección</span>
          <strong>Houssay 1159, Guaymallén, Mendoza</strong>
          <a href="https://www.google.com/maps/search/?api=1&query=Houssay%201159%20Guaymallen%20Mendoza" target="_blank" rel="noopener">Ver ubicación</a>
        </div>
      </aside>

      <aside class="contact-quick-card um-invert">
        <span>Base operativa</span>
        <strong>Mendoza, Cuyo y cobertura nacional</strong>
        <p>
          Redes, seguridad electrónica, telecomunicaciones, software operativo, soporte y energía
          para organizaciones que necesitan continuidad.
        </p>
        <a href="mailto:contacto@ultimamilla.com.ar">contacto@ultimamilla.com.ar</a>
      </aside>
    </div>
  </section>
</LayoutV4>

<script>
  const form = document.getElementById('contactForm');
  const successMessage = document.getElementById('successMessage');
  const errorMessage = document.getElementById('errorMessage');
  const startedAtInput = document.getElementById('startedAt');
  const submitButton = form?.querySelector('button[type="submit"]');
  const errorElements = {
    name: document.getElementById('nameError'),
    email: document.getElementById('emailError'),
    message: document.getElementById('messageError')
  };

  if (startedAtInput instanceof HTMLInputElement) {
    startedAtInput.value = String(Date.now());
  }

  function isValidEmail(email) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email);
  }

  function showError(field, message) {
    const errorElement = errorElements[field];
    if (errorElement) {
      errorElement.textContent = message;
      errorElement.classList.remove('hidden');
    }
  }

  function clearErrors() {
    Object.values(errorElements).forEach((element) => {
      if (element) {
        element.textContent = '';
        element.classList.add('hidden');
      }
    });
    successMessage?.classList.add('hidden');
    errorMessage?.classList.add('hidden');
  }

  const intentSubjects: Record<string, string> = {
    diagnostico: 'Diagnóstico / incidente',
    relevamiento: 'Relevamiento técnico',
    abono: 'Abono / soporte 24/7',
    pliego: 'Pliego o licitación'
  };

  document.querySelectorAll<HTMLAnchorElement>('.contact-intent[data-intent]').forEach((card) => {
    card.addEventListener('click', () => {
      const intent = card.dataset.intent;
      const message = document.getElementById('message');
      if (!(message instanceof HTMLTextAreaElement) || !intent) return;
      const prefix = intentSubjects[intent];
      if (prefix && !message.value.trim().startsWith(prefix)) {
        message.value = `${prefix}: `;
        message.focus();
      }
    });
  });

  if (form instanceof HTMLFormElement) {
    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();

      const formData = new FormData(form);
      const data = Object.fromEntries(formData.entries());
      const name = String(data.name || '').trim();
      const email = String(data.email || '').trim();
      const message = String(data.message || '').trim();
      let hasErrors = false;

      if (name.length < 2) {
        showError('name', 'Ingresá tu nombre.');
        hasErrors = true;
      }

      if (!isValidEmail(email)) {
        showError('email', 'Ingresá un email válido.');
        hasErrors = true;
      }

      if (message.length < 12) {
        showError('message', 'Agregá un poco más de contexto.');
        hasErrors = true;
      }

      if (hasErrors) {
        return;
      }

      if (submitButton instanceof HTMLButtonElement) {
        submitButton.disabled = true;
        submitButton.textContent = 'Enviando...';
      }

      try {
        const response = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await response.json();

        if (response.ok && result.success) {
          form.reset();
          if (startedAtInput instanceof HTMLInputElement) {
            startedAtInput.value = String(Date.now());
          }
          successMessage?.classList.remove('hidden');
        } else {
          if (errorMessage) {
            errorMessage.textContent = result.message || 'No se pudo enviar. Revisá los datos.';
            errorMessage.classList.remove('hidden');
          }
        }
      } catch {
        errorMessage?.classList.remove('hidden');
      } finally {
        if (submitButton instanceof HTMLButtonElement) {
          submitButton.disabled = false;
          submitButton.textContent = 'Enviar consulta';
        }
      }
    });
  }
</script>

<style>
  .contact-dossier {
    background: var(--skin-page, #fff);
    border-bottom: 0;
    padding: clamp(24px, 3.2vw, 42px) 0 clamp(34px, 5vw, 56px);
    overflow-x: clip;
  }

  .contact-dossier__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.96fr) minmax(360px, 0.72fr);
    grid-template-areas:
      "copy form";
    gap: clamp(28px, 5vw, 70px);
    align-items: start;
  }

  .contact-dossier__copy {
    grid-area: copy;
  }

  .contact-breadcrumb {
    display: flex;
    gap: 10px;
    align-items: center;
    margin-bottom: 28px;
    color: var(--skin-muted, #64748B);
    font-size: 16px;
  }

  .contact-breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .contact-breadcrumb a:hover {
    color: var(--um-red);
  }

  .contact-dossier h1 {
    max-width: 820px;
    margin: 18px 0 22px;
    color: var(--skin-text, #0B0B0B);
    font-family: var(--um-font-display);
    font-size: clamp(2.1rem, 3.45vw, 3.08rem);
    font-weight: var(--um-weight-title);
    line-height: 1.08;
    letter-spacing: 0;
  }

  .contact-dossier__copy > p {
    max-width: 690px;
    color: var(--skin-muted, #475569);
    font-size: clamp(1.04rem, 1.4vw, 1.18rem);
    line-height: 1.7;
  }

  .contact-dossier__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 28px;
  }

  .contact-dossier__actions :where(.um-btn-primary, .um-btn-secondary) {
    box-sizing: border-box;
  }

  .contact-proofline:global(.um-metric-strip) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 18px;
    margin-top: 24px;
    padding: 18px 0 0;
  }

  .contact-proofline:global(.um-metric-strip) > * {
    min-width: 0;
    padding-inline: clamp(12px, 1.6vw, 18px);
  }

  .contact-proofline:global(.um-metric-strip) strong {
    display: block;
    color: var(--skin-text, #0B0B0B);
    font-family: var(--um-font-display);
    font-size: clamp(1.45rem, 2vw, 1.9rem);
    font-weight: 600;
    line-height: 1;
  }

  .contact-proofline:global(.um-metric-strip) span {
    display: block;
    max-width: 170px;
    margin-top: 8px;
    color: var(--skin-muted, #64748B);
    font-size: 16px;
    font-weight: 600;
    line-height: 1.45;
  }

  .contact-submit-note {
    max-width: 34ch;
    margin-top: 10px;
    color: var(--skin-muted, #64748B);
    font-size: 16px;
    line-height: 1.45;
  }

  .contact-quick-card {
    position: relative;
    min-height: 380px;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    overflow: hidden;
    background: #050505;
    padding: clamp(26px, 3vw, 36px);
    color: #fff;
    border: 0;
  }

  .contact-quick-card::before,
  .contact-quick-card::after {
    display: none;
  }

  .contact-quick-card span {
    position: relative;
    color: rgba(255,255,255,0.68);
    font-size: 16px;
    font-weight: 600;
  }

  .contact-quick-card strong {
    position: relative;
    display: block;
    max-width: min(100%, 320px);
    margin-top: 18px;
    color: #fff;
    font-family: var(--um-font-display);
    font-size: clamp(1.65rem, 2.8vw, 2.45rem);
    font-weight: 600;
    line-height: 1.12;
  }

  .contact-quick-card p {
    position: relative;
    max-width: 42ch;
    margin: 18px 0 28px;
    color: rgba(255,255,255,0.76);
    font-size: 16px;
    line-height: 1.68;
  }

  .contact-quick-card a {
    position: relative;
    width: fit-content;
    max-width: 100%;
    color: #fff;
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 2px solid var(--um-red);
    padding-bottom: 6px;
    overflow-wrap: anywhere;
  }

  .contact-intents {
    background: #FFFFFF;
    border-top: 1px solid var(--skin-line, #e5e7eb);
    border-bottom: 1px solid var(--skin-line, #e5e7eb);
    padding: clamp(40px, 5vw, 64px) 0;
  }

  .contact-intents__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    margin-top: clamp(24px, 3vw, 36px);
    border-top: 1px solid var(--skin-line, #d9dadd);
  }

  .contact-intent {
    display: grid;
    gap: 8px;
    min-height: 180px;
    padding: clamp(18px, 2.2vw, 24px);
    border-right: 1px solid var(--skin-line, #d9dadd);
    background: #fff;
    color: inherit;
    text-decoration: none;
    transition: background-color 180ms ease, border-color 180ms ease;
  }

  .contact-intent:last-child {
    border-right: 0;
  }

  .contact-intent:hover {
    background: rgba(220, 38, 38, 0.03);
    border-color: color-mix(in srgb, var(--um-red) 42%, var(--skin-line, #d9dadd));
  }

  .contact-intent:focus-visible {
    outline: 2px solid var(--um-red);
    outline-offset: -2px;
  }

  .contact-intent > span {
    color: var(--um-red);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .contact-intent strong {
    color: var(--skin-text, #0b0b0b);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .contact-intent p {
    margin: 0;
    color: var(--skin-muted, #5f6368);
    font-size: 1rem;
    line-height: 1.55;
  }

  .contact-action {
    background: #fff;
    padding: clamp(44px, 6vw, 76px) 0;
    overflow-x: clip;
  }

  .contact-action__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.72fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: start;
  }

  .contact-form-panel {
    background: var(--skin-panel, #fff);
    padding: clamp(24px, 3vw, 34px);
    border: 0;
    box-shadow: inset 0 1px 0 rgba(17,17,17,0.08);
  }

  .contact-form-panel--hero {
    grid-area: form;
    align-self: start;
  }

  .contact-form-panel h2,
  .contact-context h2 {
    margin: 10px 0 12px;
    color: var(--skin-text, #0B0B0B);
    font-family: var(--um-font-display);
    font-size: clamp(1.45rem, 1.9vw, 1.9rem);
    font-weight: 600;
    line-height: 1.1;
    letter-spacing: 0;
  }

  .contact-form-panel__lead {
    max-width: 680px;
    margin: 0 0 18px;
    color: var(--skin-muted, #475569);
    font-size: 16px;
    line-height: 1.58;
  }

  .contact-form {
    display: grid;
    gap: 14px;
  }

  .field-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 16px;
  }

  .contact-form label {
    display: grid;
    gap: 7px;
  }

  .contact-form label > span {
    color: var(--skin-text, #111827);
    font-size: 16px;
    font-weight: 600;
  }

  .contact-form input,
  .contact-form textarea {
    width: 100%;
    border: 1px solid var(--skin-line, #D6DAE1);
    border-radius: 0;
    background: var(--skin-panel, #fff);
    color: var(--skin-text, #0B0B0B);
    font: 400 16px/1.5 var(--um-font-body);
    padding: 13px 16px;
    outline: none;
    transition: border-color .18s ease, box-shadow .18s ease;
  }

  .contact-form textarea {
    resize: vertical;
    min-height: 94px;
  }

  .contact-form input:focus,
  .contact-form textarea:focus {
    border-color: var(--um-red);
    box-shadow: 0 0 0 3px rgba(220,38,38,0.12);
  }

  .contact-hp {
    position: absolute !important;
    left: -10000px !important;
    width: 1px !important;
    height: 1px !important;
    opacity: 0 !important;
  }

  .field-error {
    color: #DC2626;
    font-size: 16px;
    line-height: 1.4;
  }

  .contact-submit-row {
    display: flex;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
    padding-top: 4px;
  }

  .contact-submit-row p {
    max-width: 330px;
    margin: 0;
    color: var(--skin-muted, #64748B);
    font-size: 16px;
    line-height: 1.5;
  }

  .contact-submit:disabled {
    cursor: wait;
    opacity: 0.68;
  }

  .form-message {
    border: 1px solid;
    padding: 16px 18px;
    font-size: 16px;
    line-height: 1.55;
  }

  .form-message.success {
    border-color: rgba(22,101,52,0.28);
    background: #F0FDF4;
    color: #166534;
  }

  .form-message.error {
    border-color: rgba(185,28,28,0.28);
    background: #FEF2F2;
    color: #111111;
  }

  .hidden {
    display: none !important;
  }

  .contact-context {
    display: grid;
    gap: 14px;
  }

  .contact-context__block,
  .contact-address {
    background: var(--skin-panel, #fff);
    padding: clamp(22px, 2.6vw, 30px);
    box-shadow: inset 0 1px 0 rgba(216, 221, 227, 0.82);
  }

  .contact-context__block ul {
    display: grid;
    gap: 12px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .contact-context__block li {
    position: relative;
    padding-left: 22px;
    color: var(--skin-muted, #475569);
    font-size: 16px;
    line-height: 1.6;
  }

  .contact-context__block li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 11px;
    width: 9px;
    height: 2px;
    background: var(--um-red);
  }

  .contact-context__block--line {
    box-shadow: inset 3px 0 0 var(--um-red), inset 0 1px 0 rgba(216, 221, 227, 0.82);
  }

  .contact-context__block--line span,
  .contact-address span {
    display: block;
    color: var(--skin-muted, #64748B);
    font-size: 16px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .contact-context__block--line p {
    margin: 10px 0 0;
    color: var(--skin-text, #0B0B0B);
    font-size: 16px;
    line-height: 1.62;
  }

  .contact-address strong {
    display: block;
    margin: 12px 0 20px;
    color: var(--skin-text, #0B0B0B);
    font-family: var(--um-font-display);
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .contact-address a {
    color: var(--um-red);
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    border-bottom: 1px solid currentColor;
  }

  @media (max-width: 1280px) and (max-height: 860px) {
    .contact-dossier {
      padding-top: 28px;
      padding-bottom: 36px;
    }

    .contact-breadcrumb {
      margin-bottom: 16px;
    }

    .contact-dossier h1 {
      margin: 12px 0 14px;
      font-size: clamp(1.9rem, 2.6vw, 2.5rem);
    }

    .contact-dossier__actions {
      margin-top: 18px;
    }
