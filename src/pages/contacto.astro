---
import LayoutV4 from '../layouts/LayoutV4.astro';
import IntentLinkGraph from '../components/um/IntentLinkGraph.astro';
import ContactForm from '../components/cine/ContactForm.astro';
import EmailLink from '../components/common/EmailLink.astro';
import { contactStrategicLinkGroups } from '../data/strategicLinkGraph';
import { resolveReplicaH1 } from '../utils/replicaProdCopy';
import { getAntecedentesCatalogCount } from '../utils/verifiedProof';

const contactoH1 = resolveReplicaH1('/contacto', 'Enviá contexto técnico. Respondemos con el próximo paso.');

const seoData = {
  title: 'Enviá contexto técnico. Respondemos con el próximo paso | ULTIMA MILLA',
  description: 'Contacte a ULTIMA MILLA para servicios IT integrales: redes, seguridad electrónica, telecomunicaciones, software, soporte, energía IT e infraestructura crítica.',
  keywords: 'contacto ultima milla, servicios IT Mendoza, soporte IT, infraestructura tecnologica, seguridad electronica, telecomunicaciones'
};

const contactSignificantLinks = Array.from(
  new Set(contactStrategicLinkGroups.flatMap((group) => group.items.map((item) => item.href))),
).map((href) => new URL(href, 'https://www.ultimamilla.com.ar').toString());

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ContactPage',
  name: 'Contacto ULTIMA MILLA',
  url: 'https://www.ultimamilla.com.ar/contacto',
  about: {
    '@type': 'Organization',
    name: 'ULTIMA MILLA',
    email: 'contacto@ultimamilla.com.ar',
    address: {
      '@type': 'PostalAddress',
      streetAddress: 'Houssay 1159',
      addressLocality: 'Guaymallén',
      addressRegion: 'Mendoza',
      addressCountry: 'AR'
    }
  },
  significantLink: contactSignificantLinks,
  hasPart: contactSignificantLinks.slice(0, 12).map((url) => ({ '@type': 'WebPage', url }))
};

const proof = [
  { value: '22+', label: 'años de trayectoria' },
  { value: String(getAntecedentesCatalogCount()), label: 'proyectos documentados' },
  { value: '24/7', label: 'soporte con abono' },
];
const checklist = [
  'Servicio principal o sistema afectado.',
  'Sede, ciudad o cantidad de sitios.',
  'Urgencia real, ventana de intervención o fecha de pliego.',
  'Riesgo operativo: caída, seguridad, auditoría, crecimiento o mantenimiento.',
];
const hubs = [
  { name: 'Mendoza', role: 'Sede central', href: '/servicios-it-empresas-mendoza' },
  { name: 'San Juan', role: 'Cuyo', href: '/servicios-it-empresas-argentina' },
  { name: 'San Luis', role: 'Cuyo', href: '/servicios-it-empresas-argentina' },
  { name: 'Neuquén', role: 'Patagonia', href: '/servicios-it-empresas-argentina' },
];
---

<LayoutV4 skin="black" title={seoData.title} description={seoData.description} keywords={seoData.keywords} structuredData={structuredData}>
  <div class="ctc">
    <section class="ctc-hero" aria-labelledby="ctcTitle">
      <div class="ctc-hero__bg" aria-hidden="true">
        <img src="/cine/media/cine-fachada-poster.jpg" alt="" width="1920" height="1080" fetchpriority="high" decoding="async" />
      </div>
      <div class="ctc-shell ctc-hero__grid">
        <div class="ctc-intro">
          <nav class="ctc-crumbs" aria-label="Migas de pan"><a href="/">Inicio</a><span aria-hidden="true">/</span><span>Contacto</span></nav>
          <p class="ctc-eyebrow">Contacto</p>
          <h1 id="ctcTitle">{contactoH1}</h1>
          <p class="ctc-lead">Contanos qué necesitás, dónde y para cuándo. Un técnico te responde por email con el próximo paso: diagnóstico, relevamiento, propuesta o documentación.</p>
        </div>
        <div class="ctc-aside">
          <dl class="ctc-proof">
            {proof.map((p) => <div><dt>{p.label}</dt><dd>{p.value}</dd></div>)}
          </dl>
          <div class="ctc-direct">
            <div>
              <span>Email</span>
              <strong class="ctc-mail"><EmailLink subject="Consulta desde la web ULTIMA MILLA" /></strong>
              <button type="button" class="ctc-copy" data-copy-email>Copiar</button>
            </div>
            <div>
              <span>Oficina</span>
              <strong>Houssay 1159, Guaymallén, Mendoza</strong>
              <a class="ctc-map" href="https://www.google.com/maps/search/?api=1&query=Houssay%201159%20Guaymallen%20Mendoza" target="_blank" rel="noopener">Ver en el mapa ↗</a>
            </div>
            <div>
              <span>Horario</span>
              <strong>Lunes a viernes, 8 a 18 h</strong>
              <p>Clientes con abono: guardia 24/7.</p>
            </div>
          </div>
        </div>
        <div class="ctc-panel" id="formulario">
          <p class="ctc-panel__kicker">Consulta</p>
          <h2>Escribinos</h2>
          <ContactForm />
        </div>
      </div>
    </section>

    <section class="ctc-info" aria-label="Información útil">
      <div class="ctc-shell ctc-info__grid">
        <div>
          <h2>Para responderte más rápido</h2>
          <ul class="ctc-check">
            {checklist.map((c) => <li>{c}</li>)}
          </ul>
        </div>
        <div>
          <h2>Alcances frecuentes</h2>
          <p>Abonos de soporte, relevamientos de red, CCTV y control de accesos, detección de incendios, tableros para salas técnicas, software operativo y documentación para licitaciones.</p>
          <a class="ctc-link" href="/certificaciones">Documentación para compras y auditorías →</a>
        </div>
        <div>
          <h2>Cobertura</h2>
          <ul class="ctc-hubs">
            {hubs.map((h) => <li><a href={h.href}><strong>{h.name}</strong><span>{h.role}</span></a></li>)}
          </ul>
        </div>
      </div>
    </section>

    <IntentLinkGraph
      kicker="Para avanzar"
      title="Completá el contexto de tu consulta"
      text="Revisá alcances técnicos, antecedentes comparables, sectores o presupuesto para que el pedido llegue con información útil."
      groups={contactStrategicLinkGroups}
    />
  </div>
</LayoutV4>

<script>
  // La dirección se arma en el cliente desde EmailLink: el HTML SSR no expone el email literal.
  document.querySelectorAll<HTMLButtonElement>('.ctc-copy[data-copy-email]').forEach((b) => b.addEventListener('click', async () => {
    const link = b.previousElementSibling?.querySelector<HTMLElement>('[data-um-email-link]');
    const address = link ? `${link.dataset.emailUser}@${link.dataset.emailDomain}` : '';
    try { await navigator.clipboard.writeText(address); b.textContent = 'Copiado'; }
    catch { const s = getSelection(); const r = document.createRange(); r.selectNodeContents(b.previousElementSibling as Node); s?.removeAllRanges(); s?.addRange(r); b.textContent = 'Seleccionado'; }
    setTimeout(() => { b.textContent = 'Copiar'; }, 2000);
  }));
</script>

<style>
  :global(body[data-skin]) main { background: var(--x-ink); }
  .ctc { background: var(--x-ink); color: var(--x-text); font-family: var(--um-font-editorial); }
  .ctc-shell { width: min(var(--um-container-wide, 1400px), calc(100% - 2 * var(--x-gutter))); margin-inline: auto; }

  .ctc-hero { position: relative; isolation: isolate; overflow: hidden; padding-block: clamp(32px, 4vw, 56px) var(--x-section); }
  .ctc-hero__bg { position: absolute; inset: 0; z-index: -1; }
  .ctc-hero__bg img { width: 100%; height: 100%; object-fit: cover; opacity: .3; }
  .ctc-hero__bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(90deg, var(--x-ink) 0%, rgba(10, 10, 11, .9) 40%, rgba(10, 10, 11, .6) 100%), linear-gradient(0deg, var(--x-ink) 0%, transparent 30%); }
  .ctc-hero__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); grid-template-areas: 'intro panel' 'aside panel'; column-gap: clamp(32px, 6vw, 96px); row-gap: 0; align-items: start; }
  .ctc-intro { grid-area: intro; }
  .ctc-aside { grid-area: aside; }
  .ctc-panel { grid-area: panel; }

  .ctc-crumbs { display: flex; gap: 8px; margin-bottom: 48px; font-size: var(--x-fs-meta); color: var(--x-muted); }
  .ctc-crumbs { align-items: center; }
  .ctc-crumbs a { display: inline-flex; align-items: center; min-height: 44px; min-width: 44px; color: var(--x-text-2); text-decoration: none; transition: color 160ms var(--x-ease); }
  .ctc-crumbs a:hover { color: var(--x-text); }
  .ctc-map { display: inline-flex; align-items: center; min-height: 44px; }
  .ctc-eyebrow,
  .ctc-panel__kicker { display: flex; align-items: center; gap: 12px; margin: 0 0 24px; font-size: var(--x-fs-kicker); font-weight: 600; line-height: 1.2; letter-spacing: .12em; text-transform: uppercase; color: var(--x-muted); }
  .ctc-eyebrow::before,
  .ctc-panel__kicker::before { content: ''; flex: none; width: 28px; height: 2px; background: var(--x-red); }
  .ctc-intro h1 { margin: 0; max-width: 15ch; font-size: var(--x-fs-h1) !important; line-height: 1.02 !important; font-weight: 600 !important; letter-spacing: -.025em !important; text-wrap: balance; color: var(--x-text); }
  .ctc-lead { margin: 24px 0 0; max-width: 46ch; font-size: var(--x-fs-lead); line-height: 1.55; color: var(--x-text-2); }
  .ctc-proof { display: flex; flex-wrap: wrap; margin: 48px 0 0; border-top: 1px solid var(--x-line); }
  .ctc-proof div { display: flex; flex-direction: column-reverse; gap: 8px; padding: 16px 24px 0 0; margin-right: 24px; border-right: 1px solid var(--x-line); }
  .ctc-proof div:last-child { border-right: 0; margin-right: 0; }
  .ctc-proof dt { font-size: var(--x-fs-meta); line-height: 1.45; color: var(--x-muted); }
  .ctc .ctc-proof dd { margin: 0; color: var(--x-text); font-size: 2rem; line-height: 1; font-weight: 600; letter-spacing: -.02em; font-variant-numeric: tabular-nums; }
  .ctc-direct { display: grid; gap: 16px; margin-top: 48px; }
  .ctc-direct > div { display: grid; grid-template-columns: 96px 1fr; column-gap: 16px; row-gap: 4px; align-items: baseline; padding-top: 16px; border-top: 1px solid var(--x-line); }
  .ctc-direct span { grid-row: span 2; font-size: var(--x-fs-kicker); font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--x-muted); }
  .ctc-direct strong { font-size: 1.0625rem; font-weight: 600; color: var(--x-text); user-select: all; }
  .ctc-direct strong :global(a) { font-size: inherit; color: inherit; text-decoration: none; }
  .ctc-direct strong :global(a:hover) { text-decoration: underline; text-decoration-color: var(--x-red); text-underline-offset: 3px; }
  .ctc-direct a, .ctc-direct p { margin: 0; font-size: var(--x-fs-meta); color: var(--x-text-2); }
  .ctc-direct a { text-decoration: none; transition: color 160ms var(--x-ease); }
  .ctc-direct a:hover { color: var(--x-text); }
  .ctc-copy { justify-self: start; min-height: 44px; min-width: 44px; padding: 0 12px; border: 1px solid var(--x-line-strong); border-radius: 0; background: transparent; color: var(--x-text); font: 600 var(--x-fs-meta) var(--um-font-editorial); cursor: pointer; transition: border-color 160ms var(--x-ease); }
  .ctc-copy:hover { border-color: var(--x-text); }
  .ctc-copy:focus-visible { outline: 2px solid var(--x-text); outline-offset: 2px; }

  .ctc-panel { scroll-margin-top: clamp(84px, 10vw, 112px); padding: clamp(24px, 3vw, 48px); background: rgba(17, 18, 20, .92); border: 1px solid var(--x-line); backdrop-filter: blur(14px); }
  .ctc-panel__kicker { margin-bottom: 16px; }
  .ctc-panel h2 { margin: 0 0 32px; font-size: var(--x-fs-h2) !important; line-height: 1.08 !important; font-weight: 600 !important; letter-spacing: -.02em !important; color: var(--x-text); }

  .ctc-info { padding-block: var(--x-section); border-top: 1px solid var(--x-line); background: var(--x-panel); }
  .ctc-info__grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(32px, 4vw, 64px); }
  .ctc-info h2 { margin: 0 0 16px; font-size: var(--x-fs-h3) !important; line-height: 1.3 !important; font-weight: 600 !important; letter-spacing: 0 !important; color: var(--x-text); }
  .ctc-info p { margin: 0; font-size: 1rem; line-height: 1.6; color: var(--x-text-2); }
  .ctc-check { list-style: none; margin: 0; padding: 0; display: grid; gap: 12px; }
  .ctc-check li { position: relative; padding-left: 24px; font-size: 1rem; line-height: 1.55; color: var(--x-text-2); }
  .ctc-check li::before { content: ''; position: absolute; left: 0; top: .72em; width: 12px; height: 1px; background: var(--x-muted); }
  .ctc-link { display: inline-flex; align-items: center; min-height: 44px; margin-top: 8px; font-weight: 600; color: var(--x-text); text-decoration: none; border-bottom: 1px solid var(--x-line-strong); padding-bottom: 4px; transition: border-color 160ms var(--x-ease); }
  .ctc-link:hover { border-color: var(--x-text); }
  .ctc-hubs { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--x-line); }
  .ctc-hubs a { display: flex; justify-content: space-between; align-items: baseline; gap: 12px; padding: 16px 0; border-bottom: 1px solid var(--x-line); color: var(--x-text); text-decoration: none; }
  .ctc-hubs strong { font-size: 1.0625rem; font-weight: 600; }
  .ctc-hubs span { font-size: var(--x-fs-meta); color: var(--x-muted); transition: color 160ms var(--x-ease); }
  .ctc-hubs a:hover span { color: var(--x-text); }

  /* Cierre "Para avanzar": componente compartido, tematizado oscuro sólo en /contacto */
  .ctc :global(.um-intent-link-graph) { padding-block: var(--x-section); background: var(--x-ink) !important; border-top: 1px solid var(--x-line); border-bottom: 0; }
  .ctc :global(.um-intent-link-graph__inner) { width: min(var(--um-container-wide, 1400px), calc(100% - 2 * var(--x-gutter))); }
  .ctc :global(.um-intent-link-graph__header) { margin-bottom: 48px; }
  .ctc :global(.um-intent-link-graph__kicker) { display: flex; align-items: center; gap: 12px; font-size: var(--x-fs-kicker); font-weight: 600; letter-spacing: .12em; color: var(--x-muted); }
  .ctc :global(.um-intent-link-graph__kicker::before) { content: ''; flex: none; width: 28px; height: 2px; background: var(--x-red); }
  .ctc :global(.um-intent-link-graph h2) { margin-top: 12px; color: var(--x-text) !important; font-size: var(--x-fs-h2) !important; line-height: 1.08 !important; font-weight: 600 !important; letter-spacing: -.02em !important; }
  .ctc :global(.um-intent-link-graph__header > p:last-child) { color: var(--x-text-2); font-size: 1.0625rem; line-height: 1.6; max-width: 62ch; }
  .ctc :global(.um-intent-link-graph__list) { gap: 24px; }
  .ctc :global(.um-intent-link-graph__item) { border: 1px solid var(--x-line) !important; border-radius: 0; background: var(--x-panel) !important; padding: 24px; transition: border-color 160ms var(--x-ease), background-color 160ms var(--x-ease); }
  .ctc :global(.um-intent-link-graph__item:hover),
  .ctc :global(.um-intent-link-graph__item:focus-visible) { background: var(--x-panel-2) !important; border-color: var(--x-line-strong) !important; }
  .ctc :global(.um-intent-link-graph__item:focus-visible) { outline: 2px solid var(--x-text); outline-offset: 2px; }
  .ctc :global(.um-intent-link-graph__eyebrow) { color: var(--x-muted); font-size: var(--x-fs-kicker); font-weight: 600; letter-spacing: .12em; }
  .ctc :global(.um-intent-link-graph__item strong) { margin-top: 12px; color: var(--x-text) !important; font-family: var(--um-font-editorial); font-size: 1.0625rem; line-height: 1.35; }
  .ctc :global(.um-intent-link-graph__item > span:not(.um-intent-link-graph__eyebrow)) { color: var(--x-text-2); font-size: 1rem; line-height: 1.55; }
  .ctc :global(.um-intent-link-graph__item em) { color: var(--x-text); font-weight: 600; margin-top: 24px; }

  @media (max-width: 960px) {
    .ctc-hero__grid { grid-template-columns: minmax(0, 1fr); grid-template-areas: 'intro' 'panel' 'aside'; row-gap: 48px; }
    .ctc-info__grid { grid-template-columns: 1fr; gap: 48px; }
    .ctc-direct > div { grid-template-columns: 1fr; }
    .ctc-direct span { grid-row: auto; }
  }
  @media (max-width: 640px) {
    .ctc-crumbs { margin-bottom: 20px; }
    /* H1 relativo al ancho: 48 px fijos desbordaban la columna a 320 px. */
    .ctc-intro h1 { font-size: clamp(2.25rem, 11vw, 3rem) !important; }
    .ctc-panel { padding: 24px 16px; margin-inline: calc(-1 * var(--x-gutter) + 0px); border-left: 0; border-right: 0; }
    .ctc-panel h2 { margin-bottom: 24px; }
    .ctc :global(.um-intent-link-graph__list) { gap: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .ctc *, .ctc :global(*) { transition: none !important; }
  }
</style>
