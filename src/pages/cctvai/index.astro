---
import LayoutV4 from '../../layouts/LayoutV4.astro';
import { getProductoComercialBySlug } from '../../lib/directus';
import { buildCctvAiProductTemplate } from '../../utils/commercialProductTemplate';

const productRecord = await getProductoComercialBySlug('cctv-ai-integrado');
const {
  productUrl,
  heroImage,
  hero,
  proof,
  value,
  integrations,
  options,
  pilotSteps,
  demoEvents,
  limits,
  seo,
  structuredData,
} = buildCctvAiProductTemplate(productRecord);
---

<LayoutV4
  title={seo.title}
  description={seo.description}
  keywords={seo.keywords}
  image={heroImage}
  canonical={productUrl}
  structuredData={structuredData}
>
  <section class="cctvai-hero" aria-labelledby="cctvai-title">
    <div class="um-container cctvai-hero__grid">
      <div class="cctvai-hero__copy">
        <nav class="cctvai-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Inicio</a>
          <span>/</span>
          <a href="/servicios">Servicios</a>
          <span>/</span>
          <span>CCTV AI</span>
        </nav>
        <p class="cctvai-kicker">{hero.kicker}</p>
        <h1 id="cctvai-title">{hero.title}</h1>
        <p class="cctvai-hero__lead">{hero.lead}</p>
        <div class="cctvai-hero__actions">
          <a class="um-btn-primary" href="/contacto">Solicitar diagnóstico</a>
          <a class="um-btn-secondary cctvai-btn-dark" href="#dashboard-demo">Abrir dashboard demo</a>
        </div>
        <dl class="cctvai-proof" aria-label="Alcance recomendado">
          {proof.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      <figure class="cctvai-hero__media">
        <img
          src={heroImage}
          alt={hero.imageAlt}
          width="1600"
          height="900"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>
          <span>{hero.modeLabel}</span>
          <strong>{hero.modeValue}</strong>
        </figcaption>
      </figure>
    </div>
  </section>

  <nav class="cctvai-nav" aria-label="Secciones CCTV AI">
    <div class="um-container cctvai-nav__inner">
      <a href="#valor">Valor</a>
      <a href="#opciones">Comparación</a>
      <a href="#piloto">Piloto</a>
      <a href="#dashboard-demo">Dashboard demo</a>
      <a href="#limites">Límites</a>
    </div>
  </nav>

  <section id="valor" class="cctvai-section cctvai-value">
    <div class="um-container">
      <div class="cctvai-section-head">
        <p class="cctvai-kicker">{value.kicker}</p>
        <h2>{value.title}</h2>
        <p>{value.text}</p>
      </div>

      <div class="cctvai-value__grid">
        {(value.cards || []).map((card, index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cctvai-section cctvai-integrations">
    <div class="um-container cctvai-integrations__grid">
      <div class="cctvai-section-head cctvai-section-head--sticky">
        <p class="cctvai-kicker">Integraciones</p>
        <h2>CCTV, software y soporte dentro de una misma operación.</h2>
        <p>
          UMSA CCTV AI vive entre seguridad electrónica, software a medida y soporte. UMSA configura,
          integra, opera, ajusta o analiza según el caso del cliente.
        </p>
      </div>

      <div class="cctvai-integration-list">
        {integrations.map((item, index) => (
          <article class="um-click-surface cctvai-integration-item">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{item.title}</h3>
            <p>{item.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="opciones" class="cctvai-section cctvai-options">
    <div class="um-container">
      <div class="cctvai-section-head">
        <p class="cctvai-kicker">Comparación comercial</p>
        <h2>Referencia de mercado vs. producto UMSA CCTV AI.</h2>
        <p>
          Publicamos una sola opción: UMSA CCTV AI. La alternativa de mercado se muestra como referencia
          para comparar costo, alcance y funciones reales antes de decidir.
        </p>
      </div>

      <div class="cctvai-mode-grid">
        <article class="cctvai-mode-card cctvai-mode-card--market">
          <p>Referencia de mercado</p>
          <h3>Más cara, más cerrada.</h3>
          <ul>
            <li>Licencias y servidor del fabricante</li>
            <li>Reglas estándar por ecosistema</li>
            <li>Menos integración con operación real</li>
          </ul>
        </article>
        <article class="cctvai-mode-card cctvai-mode-card--umsa">
          <p>Producto publicado</p>
          <h3>UMSA CCTV AI.</h3>
          <ul>
            <li>Piloto de 30 días sobre 6 cámaras</li>
            <li>Alertas, clips, dashboard e informes</li>
            <li>Ajuste de reglas y forense UMSA</li>
          </ul>
        </article>
      </div>

      <div class="cctvai-options-table" role="table" aria-label="Comparación CCTV AI">
        <div class="cctvai-options-table__head" role="row">
          <span role="columnheader">Alternativa</span>
          <span role="columnheader">Qué se evalúa</span>
          <span role="columnheader">Inversión</span>
          <span role="columnheader">Funciones incluidas</span>
          <span role="columnheader">Lectura comercial</span>
        </div>
        {options.map((option) => (
          <div
            class:list={[
              'cctvai-options-row',
              option.model === 'Producto publicado' && 'cctvai-options-row--recommended',
            ]}
            role="row"
          >
            <span role="cell" data-label="Alternativa">{option.model}</span>
            <strong role="cell" data-label="Qué se evalúa">{option.name}</strong>
            <span role="cell" data-label="Inversión">{option.price}</span>
            <p role="cell" data-label="Funciones incluidas">{option.scope}</p>
            <p role="cell" data-label="Lectura comercial">{option.fit}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section id="piloto" class="cctvai-section cctvai-pilot">
    <div class="um-container cctvai-pilot__grid">
      <div class="cctvai-section-head">
        <p class="cctvai-kicker">Piloto recomendado</p>
        <h2>30 días sobre 6 cámaras críticas antes de escalar.</h2>
        <p>
          Se valida calidad de imagen, ángulos, horarios, falsos positivos, utilidad de alertas y formato
          de reporte. La combinación final se decide con evidencia real.
        </p>
      </div>

      <div class="cctvai-pilot__steps">
        {pilotSteps.map((step) => (
          <article>
            <span>{step.label}</span>
            <h3>{step.title}</h3>
            <p>{step.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section id="dashboard-demo" class="cctvai-section cctvai-demo" aria-labelledby="dashboard-demo-title">
    <div class="um-container">
      <div class="cctvai-section-head">
        <p class="cctvai-kicker">Dashboard demo</p>
        <h2 id="dashboard-demo-title">Scrub forense: del video al informe.</h2>
        <p>
          Demo con imágenes generadas. Simula cómo UMSA revisa clips, clasifica eventos,
          adjunta evidencia visual y deja recomendaciones claras para la operación.
        </p>
      </div>

      <div class="cctvai-demo-shell" data-cctvai-demo>
        <header class="cctvai-demo-shell__bar">
          <div>
            <span>UMSA CCTV AI</span>
            <strong>Planta demo / 6 cámaras críticas</strong>
          </div>
          <dl>
            <div>
              <dt>Eventos</dt>
              <dd>2</dd>
            </div>
            <div>
              <dt>Falsos positivos</dt>
              <dd>controlables</dd>
            </div>
            <div>
              <dt>Estado</dt>
              <dd>piloto</dd>
            </div>
          </dl>
        </header>

        <div class="cctvai-demo-grid">
          <div class="cctvai-viewer">
            <figure class="cctvai-viewer__frame">
              <img
                data-demo-image
                src={demoEvents[0].image}
                alt="Vista demo CCTV AI"
                width="1672"
                height="941"
                loading="lazy"
                decoding="async"
              />
              <span data-demo-box class={`cctvai-demo-box ${demoEvents[0].box}`}></span>
              <span class="cctvai-scanline" aria-hidden="true"></span>
              <figcaption>
                <span data-demo-camera>{demoEvents[0].camera}</span>
                <strong data-demo-time>{demoEvents[0].time}</strong>
              </figcaption>
            </figure>

            <div class="cctvai-scrub">
              <label for="cctvai-scrubber">Línea de tiempo forense</label>
              <input
                id="cctvai-scrubber"
                data-demo-range
                type="range"
                min="0"
                max={demoEvents.length - 1}
                step="1"
                value="0"
              />
              <div class="cctvai-scrub__events" aria-label="Eventos de la demo">
                {demoEvents.map((event, index) => (
                  <button
                    type="button"
                    data-demo-jump={index}
                    class:list={['cctvai-scrub__event', index === 0 && 'is-active']}
                  >
                    <span>{event.time}</span>
                    <strong>{event.type}</strong>
                  </button>
                ))}
              </div>
            </div>
          </div>

          <aside class="cctvai-incident" aria-live="polite">
            <p class="cctvai-incident__eyebrow">Ficha del hallazgo</p>
            <h3 data-demo-title>{demoEvents[0].title}</h3>
            <p data-demo-summary>{demoEvents[0].summary}</p>
            <dl class="cctvai-incident__ledger">
              <div>
                <dt>Tipo</dt>
                <dd data-demo-type>{demoEvents[0].type}</dd>
              </div>
              <div>
                <dt>Confianza demo</dt>
                <dd data-demo-confidence>{demoEvents[0].confidence}</dd>
              </div>
              <div>
                <dt>Severidad</dt>
                <dd data-demo-severity>{demoEvents[0].severity}</dd>
              </div>
              <div>
                <dt>Estado</dt>
                <dd data-demo-status>{demoEvents[0].status}</dd>
              </div>
            </dl>
            <div class="cctvai-incident__report">
              <span>Informe forense UMSA</span>
              <p><strong>Evidencia:</strong> <span data-demo-evidence>{demoEvents[0].evidence}</span></p>
              <p><strong>Duración:</strong> <span data-demo-duration>{demoEvents[0].duration}</span></p>
              <p><strong>Recomendación:</strong> <span data-demo-recommendation>{demoEvents[0].recommendation}</span></p>
            </div>
          </aside>
        </div>
      </div>
    </div>
  </section>

  <section id="limites" class="cctvai-section cctvai-limits">
    <div class="um-container cctvai-limits__grid">
      <div class="cctvai-section-head">
        <p class="cctvai-kicker">Límites responsables</p>
        <h2>No prometemos detecciones frágiles antes de validar imagen real.</h2>
        <p>
          El producto marca evidencia y contexto. No reemplaza operadores, investigación humana ni
          decisiones internas del cliente.
        </p>
      </div>

      <div class="cctvai-limits__list">
        {limits.map((limit) => (
          <article>
            <h3>{limit.title}</h3>
            <p>{limit.text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="cctvai-final">
    <div class="um-container cctvai-final__inner">
      <div>
        <p class="cctvai-kicker">Próximo paso</p>
        <h2>Definir 6 cámaras críticas y medir valor real durante 30 días.</h2>
      </div>
      <div class="cctvai-final__actions">
        <a class="um-btn-primary" href="/contacto">Solicitar diagnóstico</a>
        <a class="um-btn-secondary cctvai-btn-dark" href="/servicios/102/sistemas-de-seguridad-electronica-cctv-control-acceso-sistemas-de-deteccion-de-incendios-sdi">Ver seguridad electrónica</a>
      </div>
    </div>
  </section>
</LayoutV4>

<script define:vars={{ demoEvents }}>
  const root = document.querySelector('[data-cctvai-demo]');

  if (root) {
    const range = root.querySelector('[data-demo-range]');
    const image = root.querySelector('[data-demo-image]');
    const box = root.querySelector('[data-demo-box]');
    const jumpButtons = Array.from(root.querySelectorAll('[data-demo-jump]'));
    const fields = {
      camera: root.querySelector('[data-demo-camera]'),
      time: root.querySelector('[data-demo-time]'),
      title: root.querySelector('[data-demo-title]'),
      summary: root.querySelector('[data-demo-summary]'),
      type: root.querySelector('[data-demo-type]'),
      confidence: root.querySelector('[data-demo-confidence]'),
      severity: root.querySelector('[data-demo-severity]'),
      status: root.querySelector('[data-demo-status]'),
      evidence: root.querySelector('[data-demo-evidence]'),
      duration: root.querySelector('[data-demo-duration]'),
      recommendation: root.querySelector('[data-demo-recommendation]'),
    };

    const renderEvent = (index) => {
      const safeIndex = Math.max(0, Math.min(demoEvents.length - 1, Number(index) || 0));
      const event = demoEvents[safeIndex];

      if (!event) return;
      if (range) range.value = String(safeIndex);
      if (image) image.src = event.image;
      if (box) box.className = `cctvai-demo-box ${event.box}`;

      Object.entries(fields).forEach(([key, node]) => {
        if (node && event[key] !== undefined) node.textContent = event[key];
      });

      jumpButtons.forEach((button, buttonIndex) => {
        button.classList.toggle('is-active', buttonIndex === safeIndex);
      });
    };

    range?.addEventListener('input', (event) => renderEvent(event.currentTarget.value));
    jumpButtons.forEach((button) => {
      button.addEventListener('click', () => renderEvent(button.dataset.demoJump));
    });
  }
</script>

<style>
  .cctvai-hero {
    background: #070707;
    color: #fff;
    padding: 34px 0 54px;
  }

  .cctvai-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.54fr) minmax(360px, 0.46fr);
    gap: 54px;
    align-items: center;
  }

  .cctvai-hero__copy,
  .cctvai-hero__media,
  .cctvai-section-head,
  .cctvai-demo-shell,
  .cctvai-viewer,
  .cctvai-incident {
    min-width: 0;
  }

  .cctvai-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 28px;
    color: rgba(255, 255, 255, 0.58);
    font-size: 1rem;
    font-weight: 700;
  }

  .cctvai-breadcrumb a:hover {
    color: #fff;
  }

  .cctvai-kicker {
    margin: 0 0 12px;
    color: #dc2626;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .cctvai-hero h1 {
    max-width: 780px;
    margin: 0;
    font-family: var(--um-font-display);
    font-size: 3.45rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.04;
    text-wrap: balance;
  }

  .cctvai-hero__lead {
    max-width: 720px;
    margin: 22px 0 0;
    color: rgba(255, 255, 255, 0.74);
    font-size: 1.16rem;
    line-height: 1.68;
  }

  .cctvai-hero__actions,
  .cctvai-final__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .cctvai-btn-dark {
    border: 1px solid rgba(255, 255, 255, 0.34) !important;
    background: rgba(255, 255, 255, 0.12) !important;
    color: #fff !important;
  }

  .cctvai-btn-dark:hover,
  .cctvai-btn-dark:focus-visible {
    border-color: #fff !important;
    background: #fff !important;
