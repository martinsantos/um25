    font-size: 0.92rem;
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .cctvai-hero__media strong {
    color: #fff;
    font-size: 1rem;
    line-height: 1.35;
  }

  .cctvai-nav {
    position: sticky;
    top: 80px;
    z-index: 20;
    border-bottom: 1px solid #dedede;
    background: rgba(255, 255, 255, 0.96);
    backdrop-filter: blur(14px);
  }

  .cctvai-nav__inner {
    display: flex;
    gap: 24px;
    overflow-x: auto;
    padding: 14px 0;
    scrollbar-width: none;
  }

