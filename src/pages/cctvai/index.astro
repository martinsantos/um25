    color: #27272a;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
  }

  .cctvai-nav a:hover,
  .cctvai-nav a:focus-visible {
    color: #dc2626;
  }

  .cctvai-section {
    background: #fff;
    color: #121212;
    padding: 74px 0;
  }

  .cctvai-section + .cctvai-section {
    border-top: 1px solid #e5e5e5;
  }

  #valor,
  #opciones,
  #piloto,
  #dashboard-demo,
  #limites {
    scroll-margin-top: 150px;
  }

  .cctvai-section-head {
    max-width: 860px;
    margin-bottom: 34px;
  }

  .cctvai-section-head h2,
  .cctvai-final h2 {
