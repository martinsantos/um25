  .cctvai-value__grid p,
  .cctvai-mode-grid p,
  .cctvai-limits__list p,
  .cctvai-pilot__steps p,
  .cctvai-integration-item p {
    margin: 12px 0 0;
    color: #62666d;
    font-size: 1rem;
    line-height: 1.58;
  }

  .cctvai-integrations {
    background: #f6f6f6;
  }

  .cctvai-integrations__grid,
  .cctvai-pilot__grid,
  .cctvai-limits__grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.36fr) minmax(0, 0.64fr);
    gap: 44px;
    align-items: start;
  }

  .cctvai-section-head--sticky {
    position: sticky;
    top: 92px;
  }

  .cctvai-integration-list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
