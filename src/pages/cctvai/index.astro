    font-size: 1.06rem;
    font-weight: 700;
    line-height: 1.32;
  }

  .cctvai-hero__media {
    position: relative;
    margin: 0;
    overflow: hidden;
    border: 1px solid rgba(255, 255, 255, 0.16);
    background: #101010;
  }

  .cctvai-hero__media img {
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    filter: contrast(1.08) saturate(0.94);
  }

  .cctvai-hero__media figcaption {
    display: grid;
    grid-template-columns: minmax(0, 0.45fr) minmax(0, 0.55fr);
    gap: 16px;
    padding: 16px;
    border-top: 1px solid rgba(255, 255, 255, 0.16);
    background: #0c0c0c;
  }

  .cctvai-hero__media span,
  .cctvai-demo-shell__bar span,
  .cctvai-incident__eyebrow,
  .cctvai-incident__report span {
