    color: #111;
    font-family: var(--um-font-display);
    font-size: 2.55rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.12;
    text-wrap: balance;
  }

  .cctvai-section-head p:not(.cctvai-kicker) {
