---
import Layout from '../layouts/Layout.astro';
import { directus, DEFAULT_IMAGE, getAntecedenteImageUrl } from '../utils/directus';
import { generateSlug } from '../utils/slugUtils';

// Configuración SEO específica para software - ULTRA OPTIMIZADA para Argentina y Mendoza
const seoConfig = {
  title: "Desarrollo de Software a Medida Mendoza | Aplicaciones Web y Móvil | ULTIMA MILLA",
  description: "Desarrollo de software personalizado para empresas en Mendoza. Aplicaciones web, móviles, integraciones y transformación digital con tecnología de punta.",
  keywords: "desarrollo software mendoza, software a medida cuyo patagonia, aplicaciones empresas organizaciones, desarrollo web argentina, transformacion digital mendoza, integracion sistemas, servicios tecnologicos software",
  ogImage: "/images/services/servicios-web.jpg",
  canonical: "https://ultimamilla.com.ar/software",
  locale: "es_AR",
  region: "Cuyo, Patagonia, Argentina",
  author: "Ultima Milla",
  robots: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
};

// Cargar antecedentes del sector software
import { antecedentesReales } from '../data/antecedentes_completos.js';
import FeaturedAntecedentes from '../components/FeaturedAntecedentes.astro';
import { sortByImpact } from '../utils/antecedentesScoring.js';

// Filtrar antecedentes específicos de SOFTWARE
const filterAntecedentes = (data) => {
  const keywords = ['software a medida', 'software', 'desarrollo', 'aplicacion', 'app', 'web', 'plataforma', 'sistema'];

  const filtered = data
    .filter(item => {
      const titulo = (item.Titulo || '').toLowerCase();
      const area = (item.Area || '').toLowerCase();
      const desc = (item.Descripcion || '').toLowerCase();

      // Buscar keywords relacionadas a software
      return keywords.some(k =>
        titulo.includes(k) ||
        area.includes(k) ||
        (titulo.includes('software') && desc.includes('desarrollo'))
      );
    });

  // Ordenar por impacto (relevancia) - mejores casos primero
  const sortedByImpact = sortByImpact(filtered);

  return sortedByImpact;
};

let antecedentes = [];
let serviciosRelacionados = [];
let error = null;

try {
  // Obtener antecedentes de software desde Directus
  const response = await directus.getAntecedentes({
    limit: 500,
    page: 1
  });

  if (response && response.data && response.data.length > 0) {
    antecedentes = filterAntecedentes(response.data);
    console.log(`✅ Cargados ${antecedentes.length} antecedentes de software`);
  }
} catch (err) {
  console.error('Error cargando antecedentes:', err);
  error = err;
}

// Fallback a datos locales si no hay resultados de API
if (antecedentes.length === 0) {
  console.log('Usando antecedentes locales para Software');
  antecedentes = filterAntecedentes(antecedentesReales);
}

// Procesar imágenes para cada antecedente
// Image processing using static import from line 3
// const { getAntecedenteImageUrl } = await import('../utils/directus.js');
antecedentes = await Promise.all(
  antecedentes.map(async (item) => {
    let img = null;
    try {
      img = await getAntecedenteImageUrl(item);
    } catch(e) {
      console.error(`[SoftwarePage] Error loading image for ${item.id}`, e);
    }
    return {
      ...item,
      Nombre: item.Titulo || item.Nombre,
      mapeo_imagenes_completo: img
    };
  })
);

  // Servicios relacionados con el sector software
  // Structured Data para SEO
  const structuredData = {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Infraestructura IT para Software",
    "provider": {
      "@type": "Organization",
      "name": "Ultima Milla",
      "url": "https://www.ultimamilla.com.ar",
      "logo": "https://www.ultimamilla.com.ar/images/um-logo.png",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Mendoza",
        "addressRegion": "Mendoza",
        "addressCountry": "AR"
      }
    },
    "areaServed": [
      {
        "@type": "City",
        "name": "Mendoza"
      },
      {
        "@type": "Country",
        "name": "Argentina"
      }
    ],
    "audience": {
      "@type": "BusinessAudience",
      "name": "Software y Empresas de Construcción"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Servicios IT para Software",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Cableado Estructurado para Obras"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Sistemas de Seguridad CCTV y Control de Accesos"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Conectividad Temporal para Canteros"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Telefonía IP Empresarial"
          }
        }
      ]
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "50"
    }
  };

  serviciosRelacionados = [
    {
      id: 1,
      nombre: "Servicios IT",
      descripcion: "Consultoría y desarrollo de soluciones IT personalizadas",
      icon: "network",
      slug: "servicios-it"
    },
    {
      id: 2,
      nombre: "Redes de Datos",
      descripcion: "Infraestructura de redes robusta y escalable",
      icon: "shield",
      slug: "redes-datos"
    },
    {
      id: 3,
      nombre: "Seguridad Informática",
      descripcion: "Protección de sistemas y datos empresariales",
      icon: "wifi",
      slug: "seguridad-informatica"
    },
    {
      id: 4,
      nombre: "Telecomunicaciones",
      descripcion: "Sistemas de comunicación integrados",
      icon: "phone",
      slug: "telecomunicaciones"
    },
    {
      id: 5,
      nombre: "Software Personalizado",
      descripcion: "Desarrollo de aplicaciones a medida",
      icon: "alert",
      slug: "software-personalizado"
    },
    {
      id: 6,
      nombre: "Soporte Técnico 24/7",
      descripcion: "Asistencia técnica especializada continua",
      icon: "support",
      slug: "soporte-tecnico"
    }
  ];

---

<Layout
  title={seoConfig.title}
  description={seoConfig.description}
  keywords={seoConfig.keywords}
  image={seoConfig.ogImage}
  canonical={seoConfig.canonical}
>
  <main style="background: #f5f5f5;">
    <!-- HERO EXACTO DEL BOCETO -->
    <section style="position: relative; min-height: 350px; display: flex; align-items: center; background: linear-gradient(rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0.65)), url('https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=1920&q=80') center/cover; color: white;">
      <div style="max-width: 1200px; margin: 0 auto; padding: 50px 40px; width: 100%;">
        <!-- Badge Simple -->
        <div style="display: inline-flex; align-items: center; gap: 12px; padding: 12px 20px; background: linear-gradient(135deg, rgba(6, 182, 212, 0.3), rgba(6, 182, 212, 0.1)); border-radius: 20px; margin-bottom: 20px; border: 1px solid rgba(6, 182, 212, 0.4); backdrop-filter: blur(10px);">
          <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #06b6d4, #0891b2); border-radius: 12px; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 20px rgba(6, 182, 212, 0.4);">
            <span style="font-size: 24px;">💾</span>
          </div>
          <span style="font-size: 13px; font-weight: 800; color: #06b6d4; text-transform: uppercase; letter-spacing: 1.2px;">Sector Software</span>
        </div>

        <!-- Title Simple -->
        <h1 style="font-size: 48px; font-weight: 900; margin-bottom: 20px; line-height: 1.2; color: white;">
          Desarrollo de Software<br/>a Medida
        </h1>

        <!-- Subtitle Simple -->
        <p style="font-size: 18px; font-weight: 400; color: rgba(255, 255, 255, 0.9); max-width: 600px; margin-bottom: 32px; line-height: 1.6;">
          Soluciones integrales para la gestión y ejecución de proyectos de construcción con precisión.
        </p>

        <!-- CTA Button Simple -->
        <a href="#contacto" style="display: inline-block; background: #06b6d4; color: white; padding: 14px 32px; border-radius: 6px; font-weight: 700; font-size: 15px; text-decoration: none; transition: all 0.3s ease;" onmouseover="this.style.background='#e55a2b'" onmouseout="this.style.background='#06b6d4'">
          Explorar Nuestras Soluciones
        </a>
      </div>
    </section>

    <!-- 3 CARDS EXACTAS DEL BOCETO -->
    <section style="background: #f5f5f5; padding: 50px 40px;">
      <div style="max-width: 1200px; margin: 0 auto;">
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px;">
          <!-- Card 1 EXACTA -->
          <div style="text-align: center; padding: 40px 30px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            <div style="width: 80px; height: 80px; background: white; border: 3px solid #e0e0e0; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
              <svg style="width: 40px; height: 40px; color: #333;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-4m-5 0H9m0 0H5m4 0V9a1 1 0 011-1h4a1 1 0 011 1v12M9 7h6"></path>
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Proyectos a Gran Escala</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Gestionamos proyectos complejos con precisión y eficiencia.</p>
          </div>

          <!-- Card 2 EXACTA -->
          <div style="text-align: center; padding: 40px 30px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            <div style="width: 80px; height: 80px; background: white; border: 3px solid #e0e0e0; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
              <svg style="width: 40px; height: 40px; color: #333;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Innovación Tecnológica</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Implementamos las últimas tecnologías para optimizar cada fase.</p>
          </div>

          <!-- Card 3 EXACTA -->
          <div style="text-align: center; padding: 40px 30px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            <div style="width: 80px; height: 80px; background: white; border: 3px solid #e0e0e0; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
              <svg style="width: 40px; height: 40px; color: #333;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Seguridad y Certificación</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Cumplimiento riguroso de normativas y estándares de seguridad.</p>
          </div>
        </div>
      </div>
    </section>


    <!-- SERVICIOS EXACTOS DEL BOCETO -->
<!-- SERVICIOS: ECOSISTEMA DIGITAL (Data-Driven) -->
    <section id="servicios" style="background: white; padding: 50px 40px;">
      <div style="max-width: 1200px; margin: 0 auto;">
