---
import EnhancedImage from "./EnhancedImage.astro";
import { generateSlug } from '../utils/slugUtils.js';

// Componente para mostrar antecedentes destacados
const { antecedentes } = Astro.props;

// Función para obtener imagen del antecedente (Lógica centralizada)
const getImageUrl = async (item) => {
  try {
    // Si ya tiene imagen válida (URL completa o path relativo conocido)
    if (item.imageUrl) return item.imageUrl;
    if (item.Imagen && (item.Imagen.startsWith('http') || item.Imagen.startsWith('/'))) return item.Imagen;

    // Importar la función de mapeo
    const { buscarImagenPorDatos } = await import('../data/mapeo_imagenes_completo.js');
    
    // Buscar la imagen específica
    const nombreArchivo = buscarImagenPorDatos(
      item.Cliente,
      item.Area || item.Unidad_de_negocio, 
      item.Titulo,
      item.id
    );
    
    if (nombreArchivo) {
      return `/imagenes_antecedentes_versionproduccion/${nombreArchivo}`;
    }
  } catch (error) {
    console.log('[FEATURED] ⚠️ Error en mapeo:', error.message);
  }
  
  return null; // Dejar que el onerror maneje el default
};

// Procesar antecedentes para asegurar que tengan slug e imagen
const processedAntecedentes = await Promise.all(
  antecedentes.map(async (item) => ({
    ...item,
    slug: item.slug || `${item.id}/${generateSlug(item.Titulo)}`,
    imageUrl: await getImageUrl(item)
  }))
);
---

<div id="antecedentes-grid" class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8" data-initial-count="6">
  {processedAntecedentes.map((proyecto, index) => (
    <a 
      href={`/antecedentes/${proyecto.slug}`} 
      class={`group flex flex-col h-full antecedente-item ${index >= 6 ? 'hidden' : ''}`}
      data-index={index}
    >
      <article class="flex flex-col h-full bg-white rounded-xl overflow-hidden shadow-sm border border-slate-200 hover:shadow-xl hover:border-blue-300 transition-all duration-300 transform hover:-translate-y-1">
        <!-- Image -->
        <div class="relative aspect-[16/9] overflow-hidden bg-slate-100">
          <img
            src={proyecto.imageUrl}
            alt={proyecto.Titulo}
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            loading="lazy"
            onerror="this.src='/images/antecedentes-hero-bg.jpg'; this.onerror=null;"
          />
          <div class="absolute top-4 left-4">
            <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-medium bg-slate-900 text-white shadow-sm">
              {proyecto.Area || 'Proyecto'}
            </span>
          </div>
        </div>
        
        <!-- Content -->
        <div class="flex flex-col flex-grow p-6">
          <div class="mb-2">
            <span class="text-xs font-bold text-blue-600 uppercase tracking-wide">
              {proyecto.Cliente}
            </span>
          </div>
          
          <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-700 transition-colors line-clamp-2">
            {proyecto.Titulo}
          </h3>
          
          <p class="text-slate-600 text-sm mb-6 line-clamp-3 flex-grow leading-relaxed">
            {proyecto.Descripcion ? proyecto.Descripcion.replace(/<[^>]*>/g, '').substring(0, 150) + '...' : ''}
          </p>
          
          <div class="pt-4 border-t border-slate-100 mt-auto flex items-center justify-between">
            <span class="text-xs font-medium text-slate-500">
              {proyecto.Unidad_de_negocio || 'Consultoría'}
            </span>
            <span class="text-blue-600 text-sm font-semibold group-hover:underline flex items-center">
              Ver caso <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </span>
          </div>
        </div>
      </article>
    </a>
  ))}
</div>

{processedAntecedentes.length > 6 && (
  <div class="mt-12 text-center" id="load-more-container">
    <button 
      id="load-more-btn"
      class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors duration-200 shadow-md"
    >
      Ver más casos
      <svg class="ml-2 -mr-1 w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
      </svg>
    </button>
    <p class="mt-2 text-sm text-slate-500">
      Mostrando <span id="showing-count">6</span> de {processedAntecedentes.length} casos
    </p>
  </div>
)}

<script is:inline>
  (function() {
    function initLoadMore() {
      const loadMoreBtn = document.getElementById('load-more-btn');
      const container = document.getElementById('load-more-container');
      const showingCountSpan = document.getElementById('showing-count');
      const items = document.querySelectorAll('.antecedente-item');
      const totalItems = items.length;
      let currentlyShowing = 6;
      const batchSize = 6;

      if (loadMoreBtn) {
        // Remove existing listeners to avoid duplicates if re-initialized
        const newBtn = loadMoreBtn.cloneNode(true);
        loadMoreBtn.parentNode.replaceChild(newBtn, loadMoreBtn);
        
        newBtn.addEventListener('click', () => {
          let newCount = currentlyShowing + batchSize;
          
          items.forEach((item, index) => {
            if (index < newCount) {
              item.classList.remove('hidden');
            }
          });

          currentlyShowing = newCount;
          
          if (showingCountSpan) {
            showingCountSpan.textContent = Math.min(currentlyShowing, totalItems);
          }

          if (currentlyShowing >= totalItems) {
            container.style.display = 'none';
          }
        });
      }
    }

    // Run on load
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initLoadMore);
    } else {
      initLoadMore();
    }
    
    // Support Astro view transitions if used
    document.addEventListener('astro:page-load', initLoadMore);
  })();
</script>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
