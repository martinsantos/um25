---
import Layout from '../layouts/Layout.astro';
import { directus, DEFAULT_IMAGE } from '../utils/directus';
import { generateSlug } from '../utils/slugUtils';

// Configuración SEO específica para Aeropuertos - ULTRA OPTIMIZADA para Argentina y Mendoza
const seoConfig = {
  title: "Tecnología para Aeropuertos Mendoza | Infraestructura IT Crítica | ULTIMA MILLA",
  description: "Soluciones IT especializadas para aeropuertos: redes críticas de alta disponibilidad, telecomunicaciones y sistemas de seguridad aeroportuaria.",
  keywords: "servicios tecnologicos aeropuertos, infraestructura it aeroportuaria, telecomunicaciones aeropuertos mendoza, redes criticas patagonia, cableado estructurado aeroportos, corrientes debiles aviacion",
  ogImage: "/images/services/ciberseguridad.jpg",
  canonical: "https://ultimamilla.com.ar/aeropuertos",
  locale: "es_AR",
  region: "Cuyo, Patagonia, Argentina",
  author: "Ultima Milla",
  robots: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
};

// Cargar antecedentes del sector aeropuertos
import { antecedentesReales } from '../data/antecedentes_completos.js';
import AntecedentesGridMobileOptimized from '../components/AntecedentesGridMobileOptimized.astro';

let antecedentes = [];
let serviciosRelacionados = [];
let error = null;

const keywords = [
  'aeropuerto', 'aeroparque', 'aa2000', 'aeropuertos argentina',
  'aviacion', 'terminal aerea', 'torre de control', 'pista',
  'mendoza', 'ezeiza', 'aeroparque', 'san juan', 'san luis',
  'neuquen', 'bariloche', 'cordoba', 'rosario', 'salta',
  'anac', 'orsna', 'eana', 'aerolinea', 'hangar',
  'terminal', 'migraciones', 'aduana', 'equipaje', 'embarque',
  'plumerillo', 'radar', 'balizamiento', 'psa'
];

const filterAntecedentes = (data) => {
  return data.filter(item => {
    const cliente = (item.Cliente || '').toLowerCase();
    const titulo = (item.Titulo || '').toLowerCase();
    const area = (item.Area || '').toLowerCase();
    return keywords.some(k => cliente.includes(k) || titulo.includes(k) || area.includes(k));
  }).map(item => ({
    ...item,
    Nombre: item.Titulo,
    mapeo_imagenes_completo: item.Imagen,
    slug: `${item.id}/${generateSlug(item.Titulo)}`
  })).sort((a, b) => new Date(b.Fecha || '2000-01-01') - new Date(a.Fecha || '2000-01-01'));
};

try {
  // Obtener antecedentes desde Directus
  const response = await directus.getAntecedentes({
    limit: 500,
    page: 1
  });

  if (response && response.data && response.data.length > 0) {
    antecedentes = filterAntecedentes(response.data);
    console.log(`✅ Cargados ${antecedentes.length} antecedentes de aeropuertos`);
  }
} catch (err) {
  console.error('Error cargando antecedentes:', err);
  error = err;
}

// Fallback a datos locales si no hay resultados de API
if (antecedentes.length === 0) {
  console.log('Usando antecedentes locales para Aeropuertos');
  antecedentes = filterAntecedentes(antecedentesReales);
}

// Limitar a 6 para la vista (ELIMINADO - Ahora se maneja en el componente con "Ver más")
// antecedentes = antecedentes.slice(0, 6);

// Servicios relacionados con el sector aeropuertos
serviciosRelacionados = [
  {
    id: 1,
    nombre: "Cableado Estructurado para Obras",
    descripcion: "Infraestructura de redes para aeropuertos",
    icon: "network",
    slug: "cableado-estructurado-obras"
  },
  {
    id: 2,
    nombre: "Seguridad Informática y Control",
    descripcion: "Protección de sistemas críticos para obras",
    icon: "shield",
    slug: "sistemas-seguridad-control"
  },
  {
    id: 3,
    nombre: "Conectividad Temporal",
    descripcion: "Sistemas de comunicación integrados en construcción",
    icon: "wifi",
    slug: "conectividad-temporal"
  },
  {
    id: 4,
    nombre: "Telefonía IP Empresarial",
    descripcion: "Información en tiempo real y wayfinding digital y canteros",
    icon: "phone",
    slug: "telefonia-ip"
  },
  {
    id: 5,
    nombre: "Sistemas de Detección de Incendios",
    descripcion: "Detección temprana y alarmas para protección de obras",
    icon: "alert",
    slug: "deteccion-incendios"
  },
  {
    id: 6,
    nombre: "Soporte Técnico 24/7",
    descripcion: "Mantenimiento preventivo y correctivo para operaciones continuas",
    icon: "support",
    slug: "soporte-tecnico"
  }
];
---

