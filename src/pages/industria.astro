          <p style="font-size: 16px; color: #666; max-width: 700px; margin: 0 auto; line-height: 1.6;">
            Tecnología aplicada para maximizar la productividad y seguridad en entornos industriales.
          </p>
        </div>

        <!-- Services Grid 2x2 -->
        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 30px; max-width: 900px; margin: 0 auto;">
          <!-- Servicio 1 -->
          <div style="padding: 30px; background: #fafafa; border-radius: 8px; border-left: 4px solid #059669;">
            <div style="width: 50px; height: 50px; background: #059669; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
              <svg style="width: 28px; height: 28px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">IoT Industrial</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Sensores inteligentes y análisis de datos en tiempo real.</p>
          </div>

          <!-- Servicio 2 -->
          <div style="padding: 30px; background: #fafafa; border-radius: 8px; border-left: 4px solid #059669;">
            <div style="width: 50px; height: 50px; background: #059669; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
              <svg style="width: 28px; height: 28px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Redes Industriales</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Infraestructura de red robusta para ambientes de planta.</p>
          </div>

          <!-- Servicio 3 -->
          <div style="padding: 30px; background: #fafafa; border-radius: 8px; border-left: 4px solid #059669;">
            <div style="width: 50px; height: 50px; background: #059669; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
              <svg style="width: 28px; height: 28px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Seguridad OT</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Protección específica para sistemas de control industrial.</p>
          </div>

          <!-- Servicio 4 -->
          <div style="padding: 30px; background: #fafafa; border-radius: 8px; border-left: 4px solid #059669;">
            <div style="width: 50px; height: 50px; background: #059669; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
              <svg style="width: 28px; height: 28px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Video Analítica</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Control de calidad y seguridad mediante visión artificial.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CASOS DE ÉXITO -->
    {antecedentesConImagenes.length > 0 && (
      <section style="background: #f8fafc; padding: 100px 32px; border-top: 1px solid #e2e8f0;">
        <div style="max-width: 75rem; margin: 0 auto;">
          <div style="text-align: center; margin-bottom: 72px;">
            <div style="display: inline-block; padding: 8px 20px; background: linear-gradient(135deg, #059669, #10b981); border-radius: 50px; margin-bottom: 20px;">
              <span style="font-size: 13px; font-weight: 800; color: white; letter-spacing: 1px; text-transform: uppercase;">✨ Experiencia Industrial</span>
            </div>
            <h2 style="font-size: clamp(36px, 5.5vw, 52px); font-weight: 900; color: #0f172a; margin-bottom: 20px; letter-spacing: -0.02em;">Proyectos Industriales</h2>
            <p style="font-size: 19px; color: #64748b; max-width: 750px; margin: 0 auto; line-height: 1.7; font-weight: 500;">
              Casos de éxito en plantas industriales y manufactura.
            </p>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 32px;">
          {antecedentesConImagenes.map((proyecto) => (
            <a href={`/antecedentes/${proyecto.slug}`} style="display: block; text-decoration: none; height: 100%;">
              <article style="background: white; border-radius: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); overflow: hidden; border: 2px solid #e2e8f0; height: 100%;" onmouseover="this.style.transform='translateY(-12px)'; this.style.boxShadow='0 20px 50px rgba(5,150,105,0.25)'; this.style.borderColor='#059669'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 20px rgba(0,0,0,0.08)'; this.style.borderColor='#e2e8f0'">
                {/* Imagen del proyecto */}
                <div style="position: relative; overflow: hidden; aspect-ratio: 4/3;">
                  <img
                    src={proyecto.imageUrl}
                    alt={proyecto.Titulo}
                    style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease;"
                    loading="lazy"
                    onerror="this.src='/images/antecedentes-hero-bg.jpg'; this.onerror=null;"
                    onmouseover="this.style.transform='scale(1.08)'"
                    onmouseout="this.style.transform='scale(1)'"
                  />
                  
                  {/* Badge */}
                  <div style="position: absolute; top: 20px; left: 20px;">
                    <span style="display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 50px; font-size: 12px; font-weight: 900; background: linear-gradient(135deg, #059669, #10b981); color: white; box-shadow: 0 8px 20px rgba(5,150,105,0.4); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.2);">
                      <span style="font-size: 16px;">🏭</span>
                      INDUSTRIA
                    </span>
                  </div>
                </div>

                {/* Contenido */}
                <div style="padding: 28px;">
                  <div style="margin-bottom: 20px;">
                    <h3 style="font-size: 20px; font-weight: 900; color: #0f172a; margin-bottom: 12px; line-height: 1.3; letter-spacing: -0.01em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                      {proyecto.Titulo}
                    </h3>
                    {proyecto.Cliente && (
                      <div style="display: flex; align-items: center; gap: 8px; font-size: 14px; color: #64748b; margin-bottom: 12px; font-weight: 600;">
                        <svg style="width: 18px; height: 18px; color: #059669;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-4m-5 0H9m0 0H5m4 0V9a1 1 0 011-1h4a1 1 0 011 1v12M9 7h6"></path>
                        </svg>
                        {proyecto.Cliente}
                      </div>
                    )}
                  </div>

                  <p style="color: #64748b; font-size: 14px; line-height: 1.7; margin-bottom: 20px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; font-weight: 500;">
                    {proyecto.Descripcion?.substring(0, 120)}...
                  </p>

                  <div style="display: flex; align-items: center; justify-content: space-between; padding-top: 20px; border-top: 2px solid #f1f5f9;">
                    <div style="display: flex; align-items: center; gap: 6px; font-size: 13px; color: #94a3b8; font-weight: 600;">
                      <svg style="width: 16px; height: 16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                      </svg>
                      {(() => {
                        if (!proyecto.Fecha) return '2024';
                        const fecha = new Date(proyecto.Fecha);
                        return isNaN(fecha.getTime()) ? '2024' : fecha.toLocaleDateString('es-ES', { year: 'numeric', month: 'short' });
                      })()}
                    </div>
                  </div>
                </div>
              </article>
            </a>
          ))}
          </div>
        </div>
      </section>
    )}

    <!-- FORMULARIO -->
    <section id="contacto" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); padding: 100px 32px; position: relative; overflow: hidden;">
      <div style="max-width: 75rem; margin: 0 auto; position: relative; z-index: 10;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center;">
          <!-- Left Content -->
          <div>
            <div style="display: inline-block; padding: 8px 20px; background: rgba(16, 185, 129, 0.2); border-radius: 50px; margin-bottom: 24px; border: 1px solid rgba(16, 185, 129, 0.3);">
              <span style="font-size: 13px; font-weight: 800; color: #34d399; letter-spacing: 1px; text-transform: uppercase;">📞 Contáctenos</span>
            </div>
            <h2 style="font-size: clamp(36px, 5vw, 56px); font-weight: 900; color: white; margin-bottom: 24px; line-height: 1.1; letter-spacing: -0.02em;">
              Impulse su Industria<br/>al Siguiente Nivel
            </h2>
            <p style="font-size: 18px; color: #cbd5e1; line-height: 1.8; margin-bottom: 40px; font-weight: 500;">
              Contáctenos para descubrir cómo nuestras soluciones de Industria 4.0 pueden optimizar su producción.
            </p>
          </div>
          
          <!-- Right Form -->
          <div style="background: white; border-radius: 24px; padding: 48px; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
            <form action="/api/contact" method="POST" style="display: flex; flex-direction: column; gap: 24px;">
              <div>
                <label style="display: block; font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Nombre</label>
                <input type="text" name="nombre" required style="width: 100%; padding: 14px 18px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 15px;" placeholder="Nombre Completo" />
              </div>
              <div>
                <label style="display: block; font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Empresa</label>
                <input type="text" name="empresa" required style="width: 100%; padding: 14px 18px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 15px;" placeholder="Empresa" />
              </div>
              <div>
                <label style="display: block; font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Email</label>
                <input type="email" name="email" required style="width: 100%; padding: 14px 18px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 15px;" placeholder="email@empresa.com" />
              </div>
              <div>
                <label style="display: block; font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Mensaje</label>
                <textarea name="mensaje" required rows="4" style="width: 100%; padding: 14px 18px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 15px;" placeholder="Detalles del requerimiento..."></textarea>
              </div>
              <button type="submit" style="width: 100%; padding: 18px; background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; border-radius: 12px; font-size: 16px; font-weight: 800; cursor: pointer;">
                Solicitar Contacto
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* RESPONSIVE MOBILE - FUERZA OVERRIDE CON !important */
  @media (max-width: 768px) {
    [style*="grid-template-columns: repeat(3, 1fr)"] { grid-template-columns: 1fr !important; }
    [style*="grid-template-columns: repeat(2, 1fr)"] { grid-template-columns: 1fr !important; }
    [style*="grid-template-columns: 1fr 1fr"] { grid-template-columns: 1fr !important; gap: 40px !important; }
    h1[style] { font-size: 32px !important; }
    h2[style] { font-size: 28px !important; }
    h3[style] { font-size: 18px !important; }
    section[style*="padding"] { padding: 40px 20px !important; }
    #contacto form { padding: 24px !important; }
    [style*="padding: 30px"] { padding: 20px !important; }
  }
</style>
