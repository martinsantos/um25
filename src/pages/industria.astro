/**
 * Constructoras Sector Page - V4 Design System
 * ✨ NUEVA VERSIÓN: 100% controlado desde Directus
 */

import LayoutV4 from '../layouts/LayoutV4.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { generateSlug } from '../utils/slugUtils.js';
import { getSectorBySlug, getIconSVGPath, getAntecedentesForSector } from '../utils/sectoresHelpers.ts';
import { getFAQSchema, sectorFAQs } from '../data/sectorFAQs';

// Obtener sector desde Directus
const sectorSlug = 'industria';
const sectorData = await getSectorBySlug(sectorSlug);

if (!sectorData) {
  // Fallback si Directus falla
  return Astro.redirect('/sectores');
}

const {
  nombre,
  emoji,
  hero_image,
  descripcion,
  keywords,
  color_theme,
  seo_title,
  seo_description,
  seo_keywords,
  stats,
  value_props,
  servicios: serviciosRelacionados,
} = sectorData;

// Fetch antecedentes with automatic fallback to snapshots
const antecedentes = await getAntecedentesForSector(keywords, nombre);

// Map color theme to Tailwind classes
const colorMap: Record<string, any> = {
  sky: { bg: 'bg-sky-50', text: 'text-sky-600', hover: 'hover:bg-sky-500', gradient: 'from-sky-600 to-sky-700' },
  purple: { bg: 'bg-purple-50', text: 'text-purple-600', hover: 'hover:bg-purple-500', gradient: 'from-purple-600 to-purple-700' },
  blue: { bg: 'bg-blue-50', text: 'text-blue-600', hover: 'hover:bg-blue-500', gradient: 'from-blue-600 to-blue-700' },
  emerald: { bg: 'bg-emerald-50', text: 'text-emerald-600', hover: 'hover:bg-emerald-500', gradient: 'from-emerald-600 to-emerald-700' },
  amber: { bg: 'bg-amber-50', text: 'text-amber-600', hover: 'hover:bg-amber-500', gradient: 'from-amber-600 to-amber-700' },
  indigo: { bg: 'bg-indigo-50', text: 'text-indigo-600', hover: 'hover:bg-indigo-500', gradient: 'from-indigo-600 to-indigo-700' },
  cyan: { bg: 'bg-cyan-50', text: 'text-cyan-600', hover: 'hover:bg-cyan-500', gradient: 'from-cyan-600 to-cyan-700' },
  orange: { bg: 'bg-orange-50', text: 'text-orange-600', hover: 'hover:bg-orange-500', gradient: 'from-orange-600 to-orange-700' },
  red: { bg: 'bg-red-50', text: 'text-red-600', hover: 'hover:bg-red-500', gradient: 'from-red-600 to-red-700' },
};

const colors = colorMap[color_theme] || colorMap.amber;
const faqSchema = getFAQSchema(sectorSlug);
