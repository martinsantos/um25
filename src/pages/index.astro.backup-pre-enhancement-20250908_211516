<!-- Contact System Script -->
<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const form = document.getElementById('footerContactForm');
    if (!form) return;

    const msg = document.getElementById('footer_message_status');
    const btn = document.getElementById('footer_submit');
    const spinner = document.getElementById('footer_spinner');
    const btnText = btn?.querySelector('span');

    function showSpinner(show) {
      if (!spinner || !btn || !btnText) return;
      spinner.classList.toggle('hidden', !show);
      btnText.textContent = show ? 'Enviando...' : 'Enviar Mensaje';
      btn.disabled = show;
      btn.style.opacity = show ? '0.7' : '1';
    }

    function showMessage(text, isSuccess) {
      if (!msg) return;
      msg.textContent = text;
      msg.style.color = isSuccess ? '#16a34a' : '#dc2626';
      msg.style.opacity = '1';
    }

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);

      // Validaciones
      if (data.honeypot) {
        showMessage('Error de validación.', false);
        return;
      }

      if (!data.name || !data.email || !data.message) {
        showMessage('Por favor completa todos los campos obligatorios (*)', false);
        return;
      }

      // Deshabilitar botón y mostrar spinner
      showSpinner(true);
      showMessage('', false); // Limpiar mensaje anterior

      try {
        // Enviar los datos
        console.log('Enviando datos al servidor...', data);
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(data)
        });

        console.log('Respuesta del servidor:', res.status);
        const json = await res.json();
        console.log('Datos de respuesta:', json);

        if (res.ok && json.success) {
          showMessage('¡Gracias! Tu mensaje ha sido enviado. Te contactaremos pronto.', true);
          form.reset();
        } else {
          showMessage(json.message || 'Error al enviar el mensaje. Por favor intenta nuevamente.', false);
        }
      } catch (err) {
        console.error('Error al enviar formulario:', err);
        showMessage('Error de conexión. Por favor verifica tu conexión e intenta nuevamente.', false);
      } finally {
        showSpinner(false);
      }
    });
  });
</script>

<!-- Script para terminal en banner hero -->
<script is:inline>
  // Inicializar terminal en banner hero
  document.addEventListener('DOMContentLoaded', () => {
    // Esperar a que el script terminalEnhanced.js se cargue
    function initHeroTerminal() {
      if (typeof window.terminalEnhanced === 'undefined') {
        setTimeout(initHeroTerminal, 100);
        return;
      }
      
      try {
        // Configurar el terminal para el banner hero
        const terminalOutput = document.getElementById('terminalOutput');
        if (terminalOutput) {
          // Simular una sesión de terminal con animación de tipeo
          const terminalLines = [
            { prompt: 'root@ultimamilla:~$', command: 'cat /info/empresa.txt', delay: 1000 },
            { output: '🏢 ULTIMA MILLA - Empresa IT Líder en Mendoza', delay: 1500 },
            { output: '📅 Fundada: 2000 | 🚀 22+ años de experiencia', delay: 2000 },
            { output: '✅ +469 proyectos exitosos completados', delay: 2500 },
            { output: '🎯 Especialistas en: Redes, Seguridad, Software', delay: 3000 },
            { prompt: 'root@ultimamilla:~$', command: 'ls servicios/', delay: 4000 },
            { output: 'seguridad-informatica/  redes-comunicaciones/  software-servicios/', delay: 4500 },
            { prompt: 'root@ultimamilla:~$', command: 'echo "¡Bienvenido a ULTIMA MILLA!"', delay: 5500 },
            { output: '🎉 ¡Bienvenido a ULTIMA MILLA! 🎉', delay: 6000 },
            { output: '💡 Tip: Visita /cli para el terminal completo', delay: 6500 }
          ];
          
          function typewriter(text, element, speed = 50) {
            return new Promise(resolve => {
              let i = 0;
              const timer = setInterval(() => {
                if (i < text.length) {
                  element.innerHTML += text.charAt(i);
                  i++;
                } else {
                  clearInterval(timer);
                  resolve();
                }
              }, speed);
            });
          }
          
          async function animateTerminal() {
            for (const line of terminalLines) {
              await new Promise(resolve => setTimeout(resolve, line.delay));
              
              const lineDiv = document.createElement('div');
              lineDiv.className = 'terminal-line';
              
              if (line.prompt && line.command) {
                const promptSpan = document.createElement('span');
                promptSpan.className = 'terminal-prompt';
                const commandSpan = document.createElement('span');
                commandSpan.className = 'terminal-command';
                
                lineDiv.appendChild(promptSpan);
                lineDiv.appendChild(commandSpan);
                terminalOutput.appendChild(lineDiv);
                
                await typewriter(line.prompt + ' ', promptSpan, 30);
                await typewriter(line.command, commandSpan, 40);
              } else if (line.output) {
                const outputSpan = document.createElement('span');
                outputSpan.className = line.output.includes('🎉') ? 'terminal-result' : 'terminal-success';
                lineDiv.appendChild(outputSpan);
                terminalOutput.appendChild(lineDiv);
                
                await typewriter(line.output, outputSpan, 25);
              }
              
              // Auto scroll
              terminalOutput.scrollTop = terminalOutput.scrollHeight;
            }
            
            // Agregar prompt final parpadeante
            setTimeout(() => {
              const finalLine = document.createElement('div');
              finalLine.className = 'terminal-line';
              const finalPrompt = document.createElement('span');
              finalPrompt.className = 'terminal-prompt';
              finalPrompt.innerHTML = 'root@ultimamilla:~$ <span style="animation: blink 1s infinite;">_</span>';
              finalLine.appendChild(finalPrompt);
              terminalOutput.appendChild(finalLine);
              terminalOutput.scrollTop = terminalOutput.scrollHeight;
            }, 1000);
          }
          
          // Iniciar animación después de 2 segundos
          setTimeout(animateTerminal, 2000);
        }
      } catch (error) {
        console.warn('Error inicializando terminal hero:', error);
      }
    }
    
    initHeroTerminal();
  });
</script>

