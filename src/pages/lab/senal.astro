---
// Review page for the code-only brand animation. Not linked from the site.
---
<html lang="es">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>Señal · Última Milla</title>
  <style is:global>
    @font-face{font-family:'UM Sans';src:url('/fonts/um-sans/UMSans-Regular.woff2') format('woff2');font-weight:400}
    @font-face{font-family:'UM Sans';src:url('/fonts/um-sans/UMSans-Bold.woff2') format('woff2');font-weight:700}
    html,body{margin:0;height:100%;background:#0a1118;color:#fff;font-family:'UM Sans',Arial,sans-serif}
    .senal{position:relative;width:100%;height:100vh;height:100svh;overflow:hidden}
    .senal canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
    .senal__cap{position:absolute;left:clamp(20px,5vw,80px);bottom:clamp(28px,8vh,96px);width:min(620px,calc(100% - 40px))}
    .senal::after{content:'';position:absolute;inset:0;pointer-events:none;background:linear-gradient(90deg,rgba(10,17,24,.75) 0%,rgba(10,17,24,0) 45%),linear-gradient(0deg,rgba(10,17,24,.6) 0%,rgba(10,17,24,0) 35%)}
    .senal__cap{z-index:2}
    .senal__cap p{position:absolute;bottom:0;left:0;width:100%;margin:0;opacity:0;transform:translateY(12px);transition:opacity .9s ease,transform 1.1s cubic-bezier(.2,.7,.1,1)}
    .senal__cap small{display:flex;align-items:center;gap:14px;font-size:13px;letter-spacing:.22em;text-transform:uppercase;color:rgba(255,255,255,.6)}
    .senal__cap small b{width:32px;height:2px;background:#DC2626}
    .senal__cap strong{display:block;margin-top:14px;font-size:clamp(34px,4.6vw,72px);line-height:1.02;letter-spacing:-.025em}
    .senal__cap[data-step="0"] p:nth-child(1),.senal__cap[data-step="1"] p:nth-child(2),.senal__cap[data-step="2"] p:nth-child(3),.senal__cap[data-step="3"] p:nth-child(4){opacity:1;transform:none}
    .senal__logo{font-weight:700;letter-spacing:-.02em}
    .senal__logo i{color:#DC2626;font-style:normal}
  </style>
</head>
<body>
  <section class="senal" data-senal>
    <div class="senal__cap" data-senal-caption data-step="0" aria-live="polite">
      <p><small><b></b>Infraestructura</small><strong>Una ciudad entera, conectada.</strong></p>
      <p><small><b></b>La red</small><strong>Cada dato recorre la ciudad.</strong></p>
      <p><small><b></b>La última milla</small><strong>Y llega exactamente a donde tiene que llegar.</strong></p>
      <p><small><b></b>Última Milla</small><strong class="senal__logo">ultimamilla<i>.</i>com<i>.</i>ar</strong></p>
    </div>
  </section>
  <script>
    import { mountSenal } from '../../scripts/senal/city.js';
    mountSenal(document.querySelector('[data-senal]') as HTMLElement);
  </script>
</body>
</html>
