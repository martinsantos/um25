---
/**
 * TEST PAGE: Componentes V4
 *
 * Página de prueba para visualizar todos los componentes V4 creados.
 * Esta página NO debe desplegarse a producción.
 *
 * URL: /test-components-v4
 */

import Layout from '../layouts/Layout.astro';
import StatsBar from '../components/v4/StatsBar.astro';
import ServiceCard from '../components/v4/ServiceCard.astro';
import ProductCard from '../components/v4/ProductCard.astro';
import CTASection from '../components/v4/CTASection.astro';

// Datos de prueba para StatsBar
const testStats = [
  { value: '150+', label: 'Proyectos Completados' },
  { value: '22+', label: 'Años de Experiencia' },
  { value: '99.9%', label: 'Uptime Garantizado' },
  { value: '24/7', label: 'Soporte Técnico' }
];

// Datos de prueba para ProductCard
const testProducto = {
  titulo: 'Fibra Óptica de Alta Capacidad',
  descripcion: 'Implementamos redes de fibra óptica monomodo y multimodo con capacidades de hasta 100 Gbps, ideales para conexiones de larga distancia y altas demandas de ancho de banda.',
  imagen: 'https://ultimamilla.com.ar/images/services/productos/infraestructura/1.1.png',
  features: [
    'Fusiones y conectorizaciones certificadas OTDR',
    'Cables armados para exteriores e interiores',
    'Bandeja de empalmes y distribución'
  ],
  destacado: 'Con garantía extendida de 25 años en materiales',
  marcas: ['Furukawa', 'Commscope', 'Corning']
};
---

<Layout title="Test Componentes V4" description="Página de prueba para componentes V4">
  <main class="min-h-screen bg-white pt-20">

    <!-- Header de la página -->
    <div class="bg-um-dark text-white py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h1 class="text-4xl font-bold mb-2">Componentes V4 - Prueba</h1>
        <p class="text-gray-300">Vista previa de todos los componentes del sistema de diseño V4</p>
      </div>
    </div>

    <!-- StatsBar -->
    <section class="py-12 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-um-dark mb-6">1. StatsBar Component</h2>
        <p class="text-um-gray mb-8">Barra de estadísticas para mostrar métricas clave. Responsive con grid de 2 a 4 columnas.</p>

        <div class="bg-white rounded-xl shadow-lg overflow-hidden">
          <StatsBar stats={testStats} />
        </div>

        <details class="mt-4">
          <summary class="cursor-pointer text-um-primary font-semibold hover:underline">Ver código de ejemplo</summary>
          <pre class="mt-2 p-4 bg-gray-100 rounded-lg overflow-x-auto text-sm"><code>{`<StatsBar stats={[
  { value: '150+', label: 'Proyectos Completados' },
  { value: '22+', label: 'Años de Experiencia' },
  { value: '99.9%', label: 'Uptime Garantizado' },
  { value: '24/7', label: 'Soporte Técnico' }
]} />`}</code></pre>
        </details>
      </div>
    </section>

    <!-- ServiceCard -->
    <section class="py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-um-dark mb-6">2. ServiceCard Component</h2>
        <p class="text-um-gray mb-8">Card de servicio con imagen de fondo, ícono, título y descripción. Usado en homepage.</p>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <ServiceCard
            id={101}
            slug="infraestructura-de-redes"
            titulo="Infraestructura de Redes"
            subtitulo="Cableado, fibra óptica y radioenlaces"
            imagen="https://ultimamilla.com.ar/directus-assets/a404fe13-25dc-409d-9789-02cbf9fb93c1"
            icon="network"
            iconColor="bg-blue-600/90"
          />

          <ServiceCard
            id={102}
            titulo="Seguridad Electrónica"
            subtitulo="CCTV, Control de Acceso, Alarmas"
            imagen="https://ultimamilla.com.ar/directus-assets/992632c1-5d88-48ea-9bc5-53c59109694e"
            icon="shield"
            iconColor="bg-red-600/90"
          />

          <ServiceCard
            id={103}
            titulo="Telecomunicaciones"
            subtitulo="Datos, voz y video convergentes"
            imagen="https://ultimamilla.com.ar/directus-assets/caffbcaa-2457-4fc9-9960-2e0601f27736"
            icon="radio"
            iconColor="bg-cyan-600/90"
          />

          <ServiceCard
            id={104}
            titulo="Desarrollo de Software"
            subtitulo="Web, mobile y sistemas ERP"
            imagen="https://ultimamilla.com.ar/directus-assets/be4911d3-7a71-457e-a081-97d0472c4aa9"
            icon="code"
            iconColor="bg-purple-600/90"
          />
        </div>

        <details class="mt-8">
          <summary class="cursor-pointer text-um-primary font-semibold hover:underline">Ver código de ejemplo</summary>
          <pre class="mt-2 p-4 bg-gray-100 rounded-lg overflow-x-auto text-sm"><code>{`<ServiceCard
  id={101}
  slug="infraestructura-de-redes"
  titulo="Infraestructura de Redes"
  subtitulo="Cableado, fibra óptica y radioenlaces"
  imagen="https://..."
  icon="network"
  iconColor="bg-blue-600/90"
/>`}</code></pre>
        </details>
      </div>
    </section>

    <!-- ProductCard -->
    <section class="py-12 bg-gray-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-um-dark mb-6">3. ProductCard Component</h2>
        <p class="text-um-gray mb-8">Card de producto con imagen, descripción, features y marcas. Se alterna posición de imagen.</p>

        <div class="space-y-12">
          <!-- Producto 1: Imagen izquierda -->
          <ProductCard
            titulo={testProducto.titulo}
            descripcion={testProducto.descripcion}
            imagen={testProducto.imagen}
            features={testProducto.features}
            destacado={testProducto.destacado}
            marcas={testProducto.marcas}
            imagePosition="left"
            orden={0}
          />

          <!-- Producto 2: Imagen derecha -->
          <ProductCard
            titulo="Cableado Estructurado Certificado"
            descripcion="Diseño e instalación de redes de cableado Cat5e, Cat6 y Cat6A con certificación punto por punto y garantía del fabricante de 25 años. Cumplimiento normas TIA/EIA-568-C."
            imagen="https://ultimamilla.com.ar/images/services/productos/infraestructura/1.3.png"
            features={[
              'Certificación individual Fluke de cada punto',
              'Garantía de 25 años del fabricante',
              'Cumplimiento TIA/EIA-568-C e ISO/IEC 11801'
            ]}
            destacado="Cada punto instalado viene con su certificación Fluke individual"
            marcas={['Panduit', 'Commscope', 'Furukawa']}
            imagePosition="right"
            orden={1}
          />
        </div>

        <details class="mt-8">
          <summary class="cursor-pointer text-um-primary font-semibold hover:underline">Ver código de ejemplo</summary>
          <pre class="mt-2 p-4 bg-gray-100 rounded-lg overflow-x-auto text-sm"><code>{`<ProductCard
  titulo="Fibra Óptica de Alta Capacidad"
  descripcion="Implementamos redes de fibra óptica..."
  imagen="https://..."
  features={[
    'Fusiones certificadas OTDR',
    'Cables armados',
    'Bandeja de empalmes'
  ]}
  destacado="Con garantía de 25 años"
  marcas={['Furukawa', 'Commscope', 'Corning']}
  imagePosition="left"
  orden={0}
/>`}</code></pre>
        </details>
      </div>
    </section>

    <!-- CTASection -->
    <section class="py-12">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <h2 class="text-3xl font-bold text-um-dark mb-6">4. CTASection Component</h2>
        <p class="text-um-gray mb-8">Sección de llamada a la acción con fondo, badge, título y botones.</p>
      </div>

      <CTASection
        badge="Comience su transformación"
        badgeIcon="rocket"
        titulo="¿Listo para modernizar su infraestructura IT?"
        descripcion="Contáctenos hoy para una consultoría gratuita y descubra cómo podemos impulsar su negocio."
        primaryButtonText="Agendar Consultoría Gratis"
        primaryButtonUrl="/contacto"
        secondaryButtonText="+54 261 623 4567"
        secondaryButtonUrl="tel:+542616234567"
        secondaryButtonIcon="phone"
        backgroundImage="https://ultimamilla.com.ar/directus-assets/caffbcaa-2457-4fc9-9960-2e0601f27736"
        darkOverlay={90}
      />

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8">
        <details>
          <summary class="cursor-pointer text-um-primary font-semibold hover:underline">Ver código de ejemplo</summary>
          <pre class="mt-2 p-4 bg-gray-100 rounded-lg overflow-x-auto text-sm"><code>{`<CTASection
  badge="Comience su transformación"
  badgeIcon="rocket"
  titulo="¿Listo para modernizar su infraestructura IT?"
  descripcion="Contáctenos hoy para una consultoría gratuita..."
  primaryButtonText="Agendar Consultoría Gratis"
  primaryButtonUrl="/contacto"
  secondaryButtonText="+54 261 623 4567"
  secondaryButtonUrl="tel:+542616234567"
  secondaryButtonIcon="phone"
/>`}</code></pre>
        </details>
      </div>
    </section>

    <!-- Footer informativo -->
    <footer class="bg-um-dark text-white py-8">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <p class="text-gray-400 text-sm">
          Esta es una página de prueba para visualizar componentes V4.
        </p>
        <p class="text-gray-500 text-xs mt-2">
          NO debe estar visible en producción. Agregar a robots.txt y sitemap excludes.
        </p>
      </div>
    </footer>

  </main>
</Layout>

<style>
  details summary {
    list-style: none;
  }

  details summary::-webkit-details-marker {
    display: none;
  }

  pre code {
    font-family: 'Courier New', monospace;
    font-size: 14px;
    line-height: 1.6;
  }
</style>
