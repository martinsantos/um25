---
import LayoutV4 from '../layouts/LayoutV4.astro';
import UMButton from '../components/um/UMButton.astro';
import { SERVICE_SPEC_LIST } from '../data/serviceSpecs';
import { getDatasheetPublicPath } from '../utils/datasheets';

const fichas = SERVICE_SPEC_LIST.map((spec) => ({
  ...spec,
  pdf: getDatasheetPublicPath(spec.slug),
  print: `/servicios/${spec.code}/ficha`,
}));

const blocks = [
  {
    code: '01',
    title: 'Protocolos y entregables de obra',
    body: 'Cada proyecto cierra con protocolos de prueba, entregables y documentación de obra según el alcance contratado, listos para recepción técnica y auditoría.',
    evidence: 'Protocolos de prueba, entregables y registro del alcance ejecutado.',
  },
  {
    code: '02',
    title: 'Certificación de puntos de cableado',
    body: 'Cableado estructurado y canalizaciones certificados punto por punto con equipamiento Fluke, con reporte de mediciones por canal y documentación de obra.',
    evidence: 'Reporte de certificación por punto y documentación de obra.',
  },
  {
    code: '03',
    title: 'Seguridad de la información por proyecto',
    body: 'Accesos, respaldos y continuidad se acuerdan con cada cliente —corporativo, sector público o planta— y quedan documentados como parte del proyecto.',
    evidence: 'Accesos, resguardos y responsabilidades definidos por proyecto.',
  },
  {
    code: '04',
    title: 'Ingeniería de detección de incendios (SDI)',
    body: 'Ingeniería, instalación y mantenimiento de SDI en aeropuertos, salud, industria y edificios corporativos, según las normas aplicables a cada obra (IRAM, NFPA 72) y los requisitos del cliente.',
    evidence: 'Ingeniería documentada con las normas aplicadas en cada obra.',
  },
  {
    code: '05',
    title: 'Dossiers para licitaciones y auditorías',
    body: 'Para pliegos, seguros y auditorías de proveedor, ULTIMA MILLA arma un dossier con antecedentes, protocolos y documentación técnica del rubro.',
    evidence: 'Dossier a medida del pliego o de la auditoría, bajo solicitud.',
  },
];
---

<LayoutV4
  title="Documentación técnica y cumplimiento | ULTIMA MILLA"
  description="Protocolos, certificación de puntos de cableado, ingeniería SDI y documentación de obra de ULTIMA MILLA. Dossiers para licitaciones y auditorías de proveedor bajo solicitud."
  keywords="documentación técnica proyectos IT, SDI Mendoza, cableado estructurado certificación puntos, cumplimiento licitaciones Argentina"
>
  <section class="um-container cert-page">
    <header class="cert-page__hero">
      <div>
        <span class="cert-page__eyebrow">Documentación técnica</span>
        <h1>Documentación técnica para compras, auditorías y licitaciones</h1>
        <p>
          ULTIMA MILLA entrega con cada proyecto los protocolos, las mediciones y la documentación
          de obra que respaldan lo ejecutado, listos para compras, auditoría o pliego.
        </p>
        <div class="cert-page__hero-actions">
          <UMButton href="/contacto">Solicitar documentación</UMButton>
          <a href="/antecedentes">Ver antecedentes</a>
        </div>
      </div>
      <aside class="cert-page__brief" aria-label="Respaldo por proyecto">
        <span>Respaldo por proyecto</span>
        <strong>Cada obra se entrega medida, documentada y trazable.</strong>
        <p>Dossiers para licitaciones y auditorías de proveedor, bajo solicitud comercial.</p>
      </aside>
    </header>

    <div class="cert-page__ledger" aria-label="Documentación técnica por disciplina">
      {blocks.map((block) => (
        <article>
          <span>{block.code}</span>
          <div>
            <h2>{block.title}</h2>
            <p>{block.body}</p>
          </div>
          <strong>{block.evidence}</strong>
        </article>
      ))}
    </div>

    <section class="cert-page__downloads" id="fichas" aria-labelledby="cert-downloads-title">
      <header>
        <span class="cert-page__eyebrow">Centro de descargas</span>
        <h2 id="cert-downloads-title">Fichas técnicas por frente de servicio</h2>
        <p>Alcance, normas de referencia, entregables, nivel de servicio y equipamiento típico de cada frente, en una hoja A4. Los valores se ajustan por sitio en el relevamiento.</p>
      </header>
      <ol class="cert-page__files">
        {fichas.map((f) => (
          <li>
            <span class="cert-page__code">SRV.{f.code}</span>
            <div>
              <strong>{f.name}</strong>
              <p>{f.keyDeliverable} · {f.keyStandard}</p>
            </div>
            <div class="cert-page__file-actions">
              {f.pdf ? <a href={f.pdf} download>PDF <span aria-hidden="true">↓</span></a> : <a href={f.print} target="_blank" rel="noopener">Imprimible <span aria-hidden="true">↗</span></a>}
              <a href={`${f.href}#ficha-tecnica`}>Ver en el servicio</a>
            </div>
          </li>
        ))}
      </ol>
    </section>

    <section class="cert-page__norms" aria-labelledby="cert-norms-title">
      <header>
        <span class="cert-page__eyebrow">Referencias normativas</span>
        <h2 id="cert-norms-title">Qué norma rige cada frente</h2>
      </header>
      <div class="cert-page__norms-grid">
        {SERVICE_SPEC_LIST.map((spec) => (
          <article>
            <span class="cert-page__code">SRV.{spec.code}</span>
            <strong>{spec.name}</strong>
            <ul>
              {spec.standards.map((n) => <li>{n}</li>)}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <div class="cert-page__cta">
      <p>¿Necesita un dossier para licitación, seguro o auditoría de proveedor?</p>
      <UMButton href="/contacto">Solicitar documentación</UMButton>
    </div>
  </section>
</LayoutV4>

<style>
  .cert-page {
    padding: clamp(42px, 6vw, 82px) 0 clamp(56px, 7vw, 88px);
  }

  .cert-page__hero {
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(280px, 0.38fr);
    gap: clamp(28px, 6vw, 86px);
    align-items: end;
    padding-bottom: clamp(32px, 5vw, 54px);
  }

  .cert-page__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 18px;
    color: var(--um-red);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  /* La piel blanca pinta todo <p> del main en gris con !important; el rótulo es un
     <span> en bloque para quedar fuera de esa regla y seguir en rojo. */
  .cert-page__eyebrow {
    display: flex;
  }

  .cert-page__eyebrow::before {
    content: "";
    width: 34px;
    height: 2px;
    background: currentColor;
  }

  .cert-page__hero h1 {
    margin: 0;
    max-width: 12.8em;
    color: var(--skin-text, #111);
    font-family: var(--um-font-display);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.06;
    text-wrap: balance;
  }

  .cert-page__hero p {
    max-width: 58ch;
    margin: 18px 0 0;
    color: var(--skin-muted, #4b5563);
    font-size: 1.0625rem;
    line-height: 1.62;
  }

  .cert-page__hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    margin-top: 28px;
  }

  .cert-page__hero-actions > a:not(.um-btn-primary):not(.um-btn-secondary) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--skin-text, #111);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: underline;
    text-decoration-color: var(--um-red);
    text-decoration-thickness: 2px;
    text-underline-offset: 7px;
  }

  .cert-page__brief {
    background: #080808;
    color: #fff;
    padding: clamp(24px, 3vw, 34px);
  }

  .cert-page__brief span {
    display: block;
    color: var(--um-red);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .cert-page__brief strong {
    display: block;
    margin-top: 18px;
    color: #fff;
    font-family: var(--um-font-display);
    font-size: clamp(1.35rem, 2vw, 1.85rem);
    font-weight: 600;
    line-height: 1.16;
    text-wrap: balance;
  }

  .cert-page__brief p {
    color: rgba(255,255,255,0.76);
  }

  .cert-page__ledger {
    display: grid;
    margin-top: clamp(28px, 4vw, 46px);
  }

  .cert-page__ledger article {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: clamp(18px, 3vw, 44px);
    align-items: start;
    padding: clamp(22px, 3vw, 32px) clamp(22px, 3vw, 36px) clamp(22px, 3vw, 32px) 0;
    border-bottom: 1px solid var(--skin-line, #d9dadd);
  }

  .cert-page__ledger article > span {
    color: var(--um-red);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .cert-page__ledger h2 {
    margin: 0;
    color: var(--skin-text, #111);
    font-family: var(--um-font-display);
    font-size: clamp(1.25rem, 1.7vw, 1.65rem);
    font-weight: 600;
    line-height: 1.18;
    text-wrap: balance;
  }

  .cert-page__ledger p {
    margin: 12px 0 0;
    color: var(--skin-muted, #4b5563);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .cert-page__ledger strong {
    display: block;
    grid-column: 2;
    max-width: 56ch;
    margin-top: 14px;
    color: var(--skin-text, #111);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .cert-page__downloads,
  .cert-page__norms {
    margin-top: clamp(40px, 6vw, 72px);
    padding-top: clamp(28px, 4vw, 40px);
    border-top: 1px solid var(--skin-line, #d9dadd);
  }

  .cert-page__downloads header,
  .cert-page__norms header {
    max-width: 68ch;
  }

  .cert-page__downloads h2,
  .cert-page__norms h2 {
    margin: 0;
    color: var(--skin-text, #111);
    font-family: var(--um-font-display);
    font-size: clamp(1.6rem, 2.6vw, 2.2rem);
    font-weight: 600;
    line-height: 1.12;
    text-wrap: balance;
  }

  .cert-page__downloads header p:last-child {
    margin: 14px 0 0;
    color: var(--skin-muted, #4b5563);
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .cert-page__files {
    list-style: none;
    margin: 26px 0 0;
    padding: 0;
    border-top: 1px solid var(--skin-line, #d9dadd);
  }

  .cert-page__files li {
    display: grid;
    grid-template-columns: 96px minmax(0, 1fr) auto;
    gap: 16px 24px;
    align-items: center;
    padding: 16px 0;
    border-bottom: 1px solid var(--skin-line, #d9dadd);
  }

  .cert-page__code {
    font-family: var(--um-font-mono);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.06em;
    color: var(--um-red);
  }

  .cert-page__files strong {
    display: block;
    color: var(--skin-text, #111);
    font-size: 1.125rem;
    font-weight: 600;
  }

  .cert-page__files p {
    margin: 4px 0 0;
    color: var(--skin-muted, #4b5563);
    font-size: 1rem;
    line-height: 1.5;
  }

  .cert-page__file-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
  }

  .cert-page__file-actions a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--skin-text, #111);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--um-red);
    text-underline-offset: 5px;
  }

  .cert-page__file-actions a:first-child {
    padding: 0 16px;
    background: var(--um-red);
    color: #fff;
    text-decoration: none;
  }

  .cert-page__file-actions a:first-child:hover,
  .cert-page__file-actions a:first-child:focus-visible {
    background: #b91c1c;
  }

  .cert-page__norms-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    margin-top: 26px;
    background: var(--skin-line, #d9dadd);
    border: 1px solid var(--skin-line, #d9dadd);
  }

  .cert-page__norms-grid article {
    background: var(--skin-page, #fff);
    padding: 20px;
    min-width: 0;
  }

  .cert-page__norms-grid strong {
    display: block;
    margin: 8px 0 10px;
    color: var(--skin-text, #111);
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .cert-page__norms-grid ul {
    margin: 0;
    padding-left: 16px;
    color: var(--skin-muted, #4b5563);
    font-size: 1rem;
    line-height: 1.5;
  }

  .cert-page__norms-grid li + li {
    margin-top: 6px;
  }

  @media (max-width: 1100px) {
    .cert-page__norms-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 760px) {
    .cert-page__files li {
      grid-template-columns: 1fr;
      gap: 8px;
    }

    .cert-page__norms-grid {
      grid-template-columns: 1fr;
    }

    .cert-page__file-actions a:first-child {
      width: 100%;
      justify-content: center;
    }
  }

  .cert-page__cta {
    margin-top: clamp(32px, 4vw, 48px);
    padding-top: 24px;
    border-top: 1px solid var(--skin-line, #d9dadd);
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
  }

  .cert-page__cta p {
    margin: 0;
    max-width: 42ch;
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  @media (max-width: 820px) {
    .cert-page__hero,
    .cert-page__ledger article {
      grid-template-columns: 1fr;
    }

    .cert-page__hero h1 {
      font-size: clamp(2.125rem, 8.4vw, 2.35rem);
      line-height: 1.08;
    }

    .cert-page__hero-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .cert-page__ledger article {
      gap: 12px;
    }

    .cert-page__ledger strong {
      grid-column: 1;
    }
  }
</style>
