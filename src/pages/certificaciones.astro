---
import LayoutV4 from '../layouts/LayoutV4.astro';
import UMButton from '../components/um/UMButton.astro';

const blocks = [
  {
    code: '01',
    title: 'Calidad y trazabilidad de obra',
    body: 'Entregables, protocolos de prueba y documentación de proyecto según el alcance contratado. No publicamos certificados de gestión de la empresa (p. ej. ISO 9001) en el sitio: si su proceso de compras los exige, solicítelos por el canal comercial.',
    evidence: 'Protocolos, entregables y respaldo del alcance ejecutado.',
  },
  {
    code: '02',
    title: 'Seguridad de la información en proyectos',
    body: 'Prácticas de acceso, respaldo y continuidad acordadas por proyecto (corporativo, sector público, planta). Evidencias y políticas se comparten en licitaciones o auditorías de proveedor cuando corresponde — no como certificación ISO 27001 corporativa visible en la web.',
    evidence: 'Accesos, resguardos y responsabilidades definidos por proyecto.',
  },
  {
    code: '03',
    title: 'Detección de incendios (SDI) y corrientes débiles',
    body: 'Experiencia en ingeniería, instalación y mantenimiento de SDI en aeropuertos, salud, industria y edificios corporativos (ver antecedentes por sector). Las referencias normativas (IRAM, NFPA u otras) se aplican según el proyecto y el requisito del cliente, no como sello de certificación de ULTIMA MILLA.',
    evidence: 'Referencias normativas aplicadas al rubro y requisito del cliente.',
  },
  {
    code: '04',
    title: 'Cableado e instalaciones asociadas',
    body: 'Cableado estructurado y canalizaciones con pruebas de canal y documentación de obra cuando el alcance lo incluye (certificación de puntos, no certificación ISO de la empresa).',
    evidence: 'Pruebas de canal, planos y documentación cuando el alcance lo incluye.',
  },
];
---

<LayoutV4
  title="Documentación técnica y cumplimiento | ULTIMA MILLA"
  description="Marco de documentación de proyectos, SDI y cableado de ULTIMA MILLA. Certificados y dossiers se entregan bajo solicitud comercial."
  keywords="documentación técnica proyectos IT, SDI Mendoza, cableado estructurado certificación puntos, cumplimiento licitaciones Argentina"
>
  <section class="cert-page">
    <div class="um-container">
      <nav class="cert-page__breadcrumb" aria-label="Breadcrumb">
        <a href="/">Inicio</a>
        <span aria-hidden="true">/</span>
        <span>Documentación técnica</span>
      </nav>

      <header class="cert-page__hero">
        <div class="cert-page__intro">
          <p class="cert-page__eyebrow">Cumplimiento técnico</p>
          <h1>Documentación técnica para compras, auditorías y licitaciones</h1>
          <p class="cert-page__lead">
            Qué puede acreditar ULTIMA MILLA en un proceso de compra y qué no se publica
            como certificación corporativa sin respaldo verificable.
          </p>
          <div class="cert-page__hero-actions">
            <UMButton href="/contacto">Solicitar documentación</UMButton>
            <a href="/antecedentes">Ver antecedentes</a>
          </div>
        </div>

        <figure class="cert-page__evidence">
          <img
            src="/img/servicios/redes.webp"
            alt="Equipo de red en operación con enlaces activos"
            width="1672"
            height="941"
            loading="eager"
            fetchpriority="high"
            decoding="async"
          />
          <figcaption>
            <span>Evidencia operativa</span>
            <strong>Pruebas, registro y documentación vinculados al alcance ejecutado.</strong>
          </figcaption>
        </figure>
      </header>

      <aside class="cert-page__brief" aria-label="Criterio de documentación">
        <span>Criterio vigente</span>
        <strong>No inventamos sellos. Entregamos respaldo por proyecto cuando corresponde.</strong>
        <p>Dossiers, protocolos y referencias normativas se comparten bajo solicitud comercial.</p>
      </aside>

      <div class="cert-page__ledger" aria-label="Áreas de documentación técnica">
        {blocks.map((block) => (
          <article>
            <span>{block.code}</span>
            <div>
              <h2>{block.title}</h2>
              <p>{block.body}</p>
            </div>
            <strong>{block.evidence}</strong>
          </article>
        ))}
      </div>

      <div class="cert-page__cta">
        <p>¿Necesita dossier para licitación, seguro o auditoría de proveedor?</p>
        <UMButton href="/contacto">Solicitar documentación</UMButton>
      </div>
    </div>
  </section>
</LayoutV4>

<style>
  .cert-page {
    background: var(--skin-page, #fff);
    padding: clamp(26px, 3.5vw, 46px) 0 clamp(56px, 7vw, 88px);
    overflow-x: clip;
  }

  .cert-page__breadcrumb {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: clamp(28px, 4vw, 48px);
    color: var(--skin-muted, #5f6368);
    font-size: 1rem;
    line-height: 1.4;
  }

  .cert-page__breadcrumb a {
    color: inherit;
    text-decoration: none;
  }

  .cert-page__breadcrumb a:hover,
  .cert-page__breadcrumb a:focus-visible {
    color: var(--um-red);
  }

  .cert-page__breadcrumb a:focus-visible {
    outline: 2px solid var(--um-red);
    outline-offset: 4px;
  }

  .cert-page__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.03fr) minmax(360px, 0.8fr);
    gap: clamp(32px, 5.5vw, 78px);
    align-items: center;
    padding-bottom: clamp(32px, 4.5vw, 52px);
  }

  .cert-page__intro {
    min-width: 0;
  }

  .cert-page__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 18px;
    color: var(--um-red);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .cert-page__eyebrow::before {
    content: "";
    width: 34px;
    height: 2px;
    background: currentColor;
  }

  .cert-page__hero h1 {
    margin: 0;
    max-width: 12.8em;
    color: var(--skin-text, #111);
    font-family: var(--um-font-display);
    font-size: clamp(2.5rem, 4vw, 3.5rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.06;
    text-wrap: balance;
  }

  .cert-page__lead {
    max-width: 58ch;
    margin: 18px 0 0;
    color: var(--skin-muted, #4b5563);
    font-size: clamp(1.0625rem, 1.4vw, 1.18rem);
    line-height: 1.62;
    text-wrap: pretty;
  }

  .cert-page__hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
    align-items: center;
    margin-top: 28px;
  }

  .cert-page__hero-actions > a:not(.um-btn-primary):not(.um-btn-secondary) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--skin-text, #111);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
    text-decoration: underline;
    text-decoration-color: var(--um-red);
    text-decoration-thickness: 2px;
    text-underline-offset: 7px;
  }

  .cert-page__hero-actions > a:not(.um-btn-primary):not(.um-btn-secondary):focus-visible {
    outline: 2px solid var(--um-red);
    outline-offset: 5px;
  }

  .cert-page__evidence {
    min-width: 0;
    margin: 0;
    background: #080808;
  }

  .cert-page__evidence img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    object-position: center;
  }

  .cert-page__evidence figcaption {
    display: grid;
    gap: 8px;
    padding: 20px clamp(20px, 2.4vw, 28px) 24px;
    color: #fff;
  }

  .cert-page__evidence figcaption span {
    color: #c9cdd2;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .cert-page__evidence figcaption strong {
    max-width: 36ch;
    color: #fff;
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.46;
  }

  .cert-page__brief {
    display: grid;
    grid-template-columns: minmax(140px, 0.24fr) minmax(0, 0.9fr) minmax(240px, 0.62fr);
    gap: clamp(20px, 3vw, 42px);
    align-items: start;
    background: #f2f3f4;
    color: var(--skin-text, #111);
    padding: clamp(22px, 3vw, 30px) clamp(22px, 3vw, 34px);
    border-left: 3px solid var(--um-red);
  }

  .cert-page__brief span {
    display: block;
    color: var(--um-red);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .cert-page__brief strong {
    display: block;
    color: var(--skin-text, #111);
    font-family: var(--um-font-display);
    font-size: clamp(1.2rem, 1.6vw, 1.5rem);
    font-weight: 600;
    line-height: 1.22;
    text-wrap: balance;
  }

  .cert-page__brief p {
    margin: 0;
    color: var(--skin-muted, #4b5563);
    font-size: 1rem;
    line-height: 1.55;
  }

  .cert-page__ledger {
    display: grid;
    margin-top: clamp(28px, 4vw, 46px);
  }

  .cert-page__ledger article {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: clamp(18px, 3vw, 44px);
    align-items: start;
    padding: clamp(22px, 3vw, 32px) clamp(22px, 3vw, 36px) clamp(22px, 3vw, 32px) 0;
    border-bottom: 1px solid var(--skin-line, #d9dadd);
  }

  .cert-page__ledger article > span {
    color: var(--um-red);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .cert-page__ledger h2 {
    margin: 0;
    color: var(--skin-text, #111);
    font-family: var(--um-font-display);
    font-size: clamp(1.25rem, 1.7vw, 1.65rem);
    font-weight: 600;
    line-height: 1.18;
    text-wrap: balance;
  }

  .cert-page__ledger p {
    margin: 12px 0 0;
    color: var(--skin-muted, #4b5563);
    font-size: 1.0625rem;
    line-height: 1.65;
  }

  .cert-page__ledger strong {
    display: block;
    grid-column: 2;
    max-width: 56ch;
    margin-top: 14px;
    color: var(--skin-text, #111);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.45;
  }

  .cert-page__cta {
    margin-top: clamp(32px, 4vw, 48px);
    padding-top: 24px;
    border-top: 1px solid var(--skin-line, #d9dadd);
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    align-items: center;
    justify-content: space-between;
  }

  .cert-page__cta p {
    margin: 0;
    max-width: 42ch;
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  @media (max-width: 820px) {
    .cert-page__hero,
    .cert-page__ledger article {
      grid-template-columns: 1fr;
    }

    .cert-page__hero h1 {
      font-size: clamp(2.125rem, 8.4vw, 2.35rem);
      line-height: 1.08;
    }

    .cert-page__hero-actions {
      align-items: stretch;
      flex-direction: column;
    }

    .cert-page__ledger article {
      gap: 12px;
    }

    .cert-page__ledger strong {
      grid-column: 1;
    }

    .cert-page__brief {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }

  @media (max-width: 560px) {
    .cert-page {
      padding-top: 22px;
    }

    .cert-page__breadcrumb {
      margin-bottom: 26px;
    }

    .cert-page__hero-actions {
      align-items: stretch;
    }

    .cert-page__hero-actions :global(.um-btn-primary),
    .cert-page__hero-actions > a:not(.um-btn-primary):not(.um-btn-secondary) {
      width: 100%;
      justify-content: center;
    }

    .cert-page__evidence img {
      aspect-ratio: 16 / 10;
    }
  }
</style>
