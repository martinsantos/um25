---
/**
 * Sector Page — Dynamic Route (SSR)
 * Handles all sector slugs using Directus data.
 */

import LayoutV4 from '../layouts/LayoutV4.astro';
import SectorTemplateEditorial from '../components/templates/SectorTemplateEditorial.astro';
import SectorTemplateAtlas from '../components/templates/SectorTemplateAtlas.astro';
import GeoHubDossier from '../components/templates/GeoHubDossier.astro';
import { generateSlug } from '../utils/slugUtils.js';
import { getSectorBySlug, getAntecedentesForSector } from '../utils/sectoresHelpers.ts';
import { getFAQSchema, sectorFAQs } from '../data/sectorFAQs';
import { getSectorVisualSpec } from '../data/sectorVisualSystem';
import { getDevTemplateVariant } from '../utils/templateVariant';
import { buildGeoHubStructuredData, getGeoCommercialHub } from '../data/geoCommercialHubs';

const sectorSlug = Astro.params.sector || '';
const geoHub = getGeoCommercialHub(sectorSlug);
const sectorData = geoHub ? null : await getSectorBySlug(sectorSlug);

if (!geoHub && !sectorData) {
  return Astro.redirect('/sectores', 301);
}

const {
  nombre = '',
  hero_image,
  descripcion = '',
  keywords = [],
  seo_title,
  seo_description,
  seo_keywords,
  stats,
  value_props,
  servicios: serviciosRelacionados,
} = sectorData || {};

const visual = getSectorVisualSpec(sectorSlug);
const heroImage = visual?.image || hero_image;
const pageHeadline = visual?.headline || `Tecnología para ${nombre}`;
const pageSummary = visual?.summary || descripcion;
const antecedentes = geoHub ? [] : await getAntecedentesForSector(keywords, nombre);
const displayedAntecedentes = antecedentes.slice(0, 3);
const displayedServiciosRelacionados = (serviciosRelacionados || []).slice(0, 3);
const sanitizeSectorStats = (items: any[] = []) => items.map((stat: any) => {
  const label = String(stat?.label || '');
  const value = String(stat?.value || '');
  if (/99[\.,]\d+%/.test(value) || /uptime|disponibilidad/i.test(label)) {
    return { ...stat, label: 'Operación', value: '24/7' };
  }
  return stat;
});
const displayStats = sanitizeSectorStats(stats || []);
const faqSchema = getFAQSchema(sectorSlug);
const formatYear = (value: string | Date | undefined) => {
  if (!value) return 'S/D';
  const date = new Date(value);
  return Number.isNaN(date.getTime()) ? String(value).slice(0, 4) : String(date.getFullYear());
};
const templateVariant = getDevTemplateVariant(Astro.url, import.meta.env.DEV);
const templateSector = {
  ...(visual || {}),
  ...sectorData,
  nombre,
  label: visual?.label || nombre,
  slug: sectorSlug,
  pageHeadline,
  pageSummary,
  heroImage,
  image: visual?.image || heroImage,
  stats: displayStats,
  operatingNeed: visual?.operatingNeed,
  proof: visual?.proof,
  services: visual?.services,
};
const templateServiciosRelacionados = (serviciosRelacionados || []).map((servicio: any) => ({
  ...servicio,
  slug: generateSlug(servicio.nombre || servicio.Titulo || 'servicio')
}));
const compactServiceTitle = (value: unknown): string => {
  const title = String(value || '')
    .replace(/\s*\|.*$/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  const replacements: Record<string, string> = {
    'Infraestructura de Redes': 'Redes e infraestructura',
    'Sistemas de Seguridad Electrónica': 'Seguridad electrónica',
    'Telecomunicaciones.': 'Telecomunicaciones',
    'Desarrollo de Software a Medida': 'Software operativo',
    'Soporte Técnico 24/7': 'Soporte técnico 24/7',
    'Consultoría IT y Transformación Digital': 'Consultoría IT',
    'Sistemas de Detección y Alarma de Incendios': 'Detección de incendios',
    'Servicios Eléctricos para IT': 'Energía para IT'
  };
  return replacements[title] || title || 'Servicio IT';
};
const compactCaseTitle = (value: unknown, client?: unknown): string => {
  const title = String(value || '')
    .replace(/Sistena/gi, 'Sistema')
    .replace(/\s+\(\d+\)$/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  const organization = String(client || '').replace(/\s+/g, ' ').trim();
  if (!title) return organization || 'Proyecto técnico';

  const parts = title.split(/\s[-–]\s/).map((part) => part.trim()).filter(Boolean);
  let base = parts[0] || title;
  base = base
    .replace(/Soporte de Infraestructura IT de Alta Disponibilidad/gi, 'Soporte IT de alta disponibilidad')
    .replace(/Implementación de Redes de Datos y Fibra Óptica/gi, 'Redes y fibra óptica')
    .replace(/Instalación eléctrica para Data Center/gi, 'Energía para data center')
    .replace(/Sistema Detección de Incendios/gi, 'Detección de incendios');

  const target = parts[1] && !/^\d{4}|abril|mayo|junio|julio|agosto|septiembre|octubre|noviembre|diciembre/i.test(parts[1])
    ? parts[1]
    : organization;
  const composed = target ? `${base}: ${target}` : base;
  return composed.length > 78 ? `${composed.slice(0, 75).trimEnd()}...` : composed;
};
---

{geoHub ? (
<LayoutV4
  title={geoHub.seoTitle}
  description={geoHub.description}
  keywords={geoHub.keywords}
  structuredData={buildGeoHubStructuredData(geoHub)}
>
  <GeoHubDossier hub={geoHub} />
</LayoutV4>
) : (
<LayoutV4 title={seo_title} description={seo_description} keywords={seo_keywords} image={heroImage} structuredData={faqSchema}>
  {templateVariant === 'editorial' && (
    <SectorTemplateEditorial
      mode="detail"
      sector={templateSector}
      antecedentes={antecedentes}
      valueProps={value_props || []}
      serviciosRelacionados={templateServiciosRelacionados}
    />
  )}
  {templateVariant === 'atlas' && (
    <SectorTemplateAtlas
      mode="detail"
      sector={templateSector}
      antecedentes={antecedentes}
      valueProps={value_props || []}
      serviciosRelacionados={templateServiciosRelacionados}
    />
  )}

  {!templateVariant && (
  <div>
  <section class="sector-detail-hero">
    <div class="sector-detail-hero__image" style={`background-image: url('${heroImage}');`}></div>
    <div class="sector-detail-hero__wash"></div>

    <div class="um-container sector-detail-hero__content">
      <nav class="sector-detail-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Inicio</a>
        <span>/</span>
        <a href="/sectores">Sectores</a>
        <span>/</span>
        <span>{nombre}</span>
      </nav>

      <div class="sector-detail-hero__grid">
        <div>
          <span class="sector-detail-label">{visual?.label || nombre}</span>
          <h1>{pageHeadline}</h1>
          <p>{pageSummary}</p>
          <div class="sector-detail-actions">
            <a href="/contacto">Solicitar diagnóstico</a>
            <a href="/antecedentes">Ver antecedentes</a>
          </div>
        </div>
        <aside class="sector-detail-proof">
          <div class="sector-detail-proof__intro">
            <span>Dossier operativo</span>
            <p>{visual?.proof || `Capacidades aplicadas a ${nombre}.`}</p>
          </div>
          {displayStats.map((stat: any) => (
            <div>
              <strong>{stat.value}</strong>
              <span>{stat.label}</span>
            </div>
          ))}
          <div>
            <strong>{antecedentes.length}+</strong>
            <span>antecedentes</span>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <section class="sector-operating">
    <div class="um-container sector-operating__grid">
      <div>
        <span class="um-kicker">Contexto operativo</span>
        <h2>{visual?.operatingNeed || `Necesidades técnicas de ${nombre}`}</h2>
      </div>
      <div>
        <p>{visual?.proof || descripcion}</p>
        {visual?.services && (
          <div class="sector-service-tags">
            {visual.services.map((service) => <span>{service}</span>)}
          </div>
        )}
      </div>
    </div>
  </section>

  {value_props && value_props.length > 0 && (
    <section class="sector-value-props">
      <div class="um-container">
        <div class="sector-section-head">
          <span class="um-kicker">Criterios técnicos</span>
          <h2>Criterios técnicos de operación</h2>
        </div>
        <div class="sector-value-grid">
          {value_props.map((prop: any, index: number) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{prop.titulo}</h3>
              <p>{prop.descripcion}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {displayedServiciosRelacionados.length > 0 && (
    <section class="sector-services">
      <div class="um-container">
        <div class="sector-section-head">
          <span class="um-kicker">Servicios conectados</span>
          <h2>Servicios aplicados al mercado</h2>
        </div>

        <div class="sector-services-grid">
          {displayedServiciosRelacionados.map((servicio: any) => (
            <a href={`/servicios/${servicio.id}/${generateSlug(servicio.nombre)}`}>
              <h3>{compactServiceTitle(servicio.nombre)}</h3>
              <p>{servicio.descripcion}</p>
              <span>
                Ver servicio
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" />
                </svg>
              </span>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {displayedAntecedentes.length > 0 && (
    <section class="sector-projects">
      <div class="um-container">
        <div class="sector-section-head">
          <span class="um-kicker">Antecedentes</span>
          <h2>Evidencia en {nombre}</h2>
        </div>

        <div class="sector-projects-grid">
          {displayedAntecedentes.map((ant) => (
            <article class="sector-evidence-card">
              <a href={`/antecedentes/${ant.id}/${ant.slug || generateSlug(ant.Titulo || ant.Nombre || 'proyecto')}`}>
                <div class="sector-evidence-card__media">
                  {ant.imageUrl ? (
                    <img
                      src={ant.imageUrl}
                      alt={ant.Titulo || ant.Nombre || 'Antecedente técnico'}
                      loading="lazy"
                    />
                  ) : (
                    <div class="sector-evidence-card__folio">
                      <span>{nombre}</span>
                    </div>
                  )}
                </div>
                <div class="sector-evidence-card__body">
                  <span>{ant.Cliente || ant.Area || 'Antecedente técnico'}</span>
                  <h3>{compactCaseTitle(ant.Titulo || ant.Nombre, ant.Cliente)}</h3>
                  <p>{ant.Descripcion || 'Alcance técnico documentado para operación empresarial.'}</p>
                  <dl>
                    <div>
                      <dt>Año</dt>
                      <dd>{formatYear(ant.Fecha)}</dd>
                    </div>
                    <div>
                      <dt>Área</dt>
                      <dd>{ant.Area || ant.Unidad_de_negocio || nombre}</dd>
                    </div>
                  </dl>
                  <strong>
                    Ver dossier
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M5 12h14m-6-6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" stroke-linejoin="miter" />
                    </svg>
                  </strong>
                </div>
              </a>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  {sectorFAQs[sectorSlug] && sectorFAQs[sectorSlug].length > 0 && (
    <section class="sector-faq">
      <div class="um-container sector-faq__inner">
        <h2>Preguntas frecuentes</h2>
        <div class="sector-faq-list">
          {sectorFAQs[sectorSlug].map((faq: any) => (
            <details>
              <summary>
                <span>{faq.question}</span>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="m6 9 6 6 6-6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="square" />
                </svg>
              </summary>
              <div>{faq.answer}</div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="sector-final">
    <div class="um-container">
      <h2>Definamos el alcance técnico para {nombre}.</h2>
      <div>
        <a href="/contacto" class="um-btn-primary">Solicitar diagnóstico</a>
        <a href="/antecedentes" class="um-btn-secondary">Ver antecedentes</a>
      </div>
    </div>
  </section>
  </div>
  )}
</LayoutV4>
)}

<style>
  .sector-detail-hero {
    position: relative;
    overflow: hidden;
    min-height: clamp(500px, 62vh, 640px);
    background: #080808;
    color: #fff;
  }

  .sector-detail-hero__image,
  .sector-detail-hero__wash {
    position: absolute;
    inset: 0;
  }

  .sector-detail-hero__image {
    background-position: center right;
    background-size: cover;
    filter: saturate(0.86) contrast(1.08);
  }

  .sector-detail-hero__wash {
    background:
      linear-gradient(90deg, rgba(8,8,8,0.97) 0%, rgba(8,8,8,0.78) 48%, rgba(8,8,8,0.34) 100%),
      linear-gradient(0deg, rgba(8,8,8,0.88) 0%, rgba(8,8,8,0.12) 72%);
  }

  .sector-detail-hero__content {
    position: relative;
    z-index: 1;
    padding-top: clamp(24px, 3.4vw, 48px);
    padding-bottom: clamp(52px, 7vw, 92px);
  }

  .sector-detail-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-bottom: clamp(34px, 6vw, 72px);
    color: rgba(255,255,255,0.58);
    font-size: 1rem;
    font-weight: 700;
  }

  .sector-detail-breadcrumb a:hover {
    color: #fff;
  }

  .sector-detail-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.66fr) minmax(330px, 0.34fr);
    gap: clamp(34px, 6vw, 78px);
    align-items: center;
  }

  .sector-detail-hero__grid > * {
    min-width: 0;
  }

  .sector-detail-label {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    margin-bottom: 1rem;
    color: #fff;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .sector-detail-label::before {
    content: "";
    width: 34px;
    height: 2px;
    background: var(--um-red);
  }

  .sector-detail-hero h1 {
    max-width: 800px;
    color: #fff;
    font-size: clamp(2.5rem, 2.85vw, 3.1rem);
    line-height: 1.1;
    font-weight: var(--um-weight-title, 600);
    letter-spacing: 0;
    text-wrap: balance;
  }

  .sector-detail-hero p {
    max-width: 680px;
    margin-top: 1.25rem;
    color: rgba(255,255,255,0.74);
    font-size: clamp(1rem, 1.08vw, 1.12rem);
    line-height: 1.68;
  }

  .sector-detail-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: clamp(22px, 3vw, 34px);
  }

  .sector-detail-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 50px;
    padding: 0 1.25rem;
    border: 1px solid rgba(255,255,255,0.32);
    color: #fff;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
  }

  .sector-detail-actions a:first-child {
    border-color: var(--um-red);
    background: var(--um-red);
  }

  .sector-detail-actions a:hover {
    border-color: #fff;
    background: #fff;
    color: #080808;
  }

  .sector-detail-proof {
    display: grid;
    width: 100%;
    border: 0;
    background: rgba(255,255,255,0.16);
  }

  .sector-detail-proof__intro {
    padding: 1.25rem 1.2rem 1.1rem;
    background: rgba(8,8,8,0.78);
    border-bottom: 1px solid rgba(255,255,255,0.13);
  }

  .sector-detail-proof__intro span {
    display: block;
    color: #fff;
    font-family: var(--um-font-display);
    font-size: 1.14rem;
    font-weight: var(--um-weight-title, 600);
    line-height: 1.2;
  }

  .sector-detail-proof__intro p {
    margin-top: 0.65rem;
    color: rgba(255,255,255,0.72);
    font-size: 1rem;
    line-height: 1.5;
  }

  .sector-detail-proof > div:not(.sector-detail-proof__intro) {
    padding: 1.1rem 1.25rem 1.2rem;
    background: rgba(8,8,8,0.68);
    border-bottom: 1px solid rgba(255,255,255,0.13);
  }

  .sector-detail-proof > div:last-child {
    border-bottom: 0;
  }

  .sector-detail-proof strong {
    display: block;
    color: #fff;
    font-size: clamp(1.18rem, 1.7vw, 1.75rem);
    line-height: 1.12;
    font-weight: 700;
  }

  .sector-detail-proof span {
    display: block;
    margin-top: 0.55rem;
    color: rgba(255,255,255,0.62);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
    text-transform: uppercase;
  }

  .sector-operating,
  .sector-services,
  .sector-faq {
    background: #fff;
    padding: clamp(54px, 7vw, 92px) 0;
  }

  .sector-operating__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 7vw, 96px);
    align-items: start;
  }

  .sector-operating h2,
  .sector-section-head h2,
  .sector-faq h2,
  .sector-final h2 {
    color: #111;
    font-size: clamp(1.82rem, 2.35vw, 2.55rem);
    line-height: 1.12;
    font-weight: var(--um-weight-title, 600);
    text-wrap: balance;
  }

  .sector-operating h2 {
    margin-top: 1rem;
  }

  .sector-operating p {
    color: var(--um-muted);
    font-size: clamp(1rem, 1.08vw, 1.1rem);
    line-height: 1.78;
  }

  .sector-service-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 1.6rem;
  }

  .sector-service-tags span {
    border: 1px solid var(--um-line);
    padding: 0.55rem 0.7rem;
    color: #374151;
    font-size: 1rem;
    font-weight: 700;
  }

  .sector-value-props {
    background: #F5F6F7;
    padding: clamp(54px, 7vw, 92px) 0;
  }

  .sector-section-head {
    display: grid;
    grid-template-columns: 0.6fr 1fr;
    gap: clamp(24px, 5vw, 70px);
    align-items: end;
    margin-bottom: clamp(34px, 6vw, 72px);
  }

  .sector-value-grid,
  .sector-services-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--um-line);
    background: var(--um-line);
  }

  .sector-value-grid article,
  .sector-services-grid a {
    min-height: 250px;
    padding: clamp(22px, 3vw, 34px);
    background: #fff;
  }

  .sector-value-grid span {
    color: var(--um-red);
    font-size: 1rem;
    font-weight: 700;
  }

  .sector-value-grid h3,
  .sector-services-grid h3 {
    margin-top: 1rem;
    color: #111;
    font-size: 1.25rem;
    line-height: 1.2;
    font-weight: var(--um-weight-title, 600);
  }

  .sector-value-grid p,
  .sector-services-grid p {
    margin-top: 0.9rem;
    color: var(--um-muted);
    line-height: 1.68;
  }

  .sector-services-grid a {
    display: flex;
    flex-direction: column;
    min-height: 330px;
    transition: background-color 180ms ease;
  }

  .sector-services-grid a:hover {
    background: #FAFAFA;
  }

  .sector-services-grid span {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    width: fit-content;
    margin-top: auto;
    padding-top: 1.4rem;
    color: var(--um-red);
    font-size: 1rem;
    font-weight: 700;
  }

  .sector-services-grid p {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 5;
    overflow: hidden;
  }

  .sector-services-grid svg {
    width: 1rem;
    height: 1rem;
  }

  .sector-projects {
    background: #F5F6F7;
    padding: clamp(54px, 7vw, 92px) 0;
  }

  .sector-projects-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: clamp(18px, 2vw, 24px);
  }

  .sector-evidence-card {
    background: #fff;
    min-width: 0;
    overflow: hidden;
    border-top: 1px solid var(--um-line);
  }

  .sector-evidence-card a {
    display: grid;
    grid-template-rows: 240px 1fr;
    min-height: 0;
    height: 100%;
    color: #111;
  }

  .sector-evidence-card:first-child {
    grid-column: span 7;
  }

  .sector-evidence-card:first-child a {
    grid-template-rows: 360px 1fr;
    min-height: 100%;
  }

  .sector-evidence-card:nth-child(2),
  .sector-evidence-card:nth-child(3) {
    grid-column: span 5;
  }

  .sector-evidence-card:nth-child(n + 4) {
    grid-column: span 4;
  }

  .sector-evidence-card:not(:first-child) a {
    min-height: 100%;
  }

  .sector-evidence-card:not(:first-child) h3 {
    font-size: clamp(1.08rem, 1.25vw, 1.28rem);
  }

  .sector-evidence-card:not(:first-child) p {
    -webkit-line-clamp: 3;
  }

  .sector-evidence-card__media {
    position: relative;
    overflow: hidden;
    background: #E6E8EA;
  }

  .sector-evidence-card__media::after {
    content: "";
    position: absolute;
    inset: auto 0 0 0;
    height: 3px;
    background: var(--um-red);
    transform: scaleX(0.24);
    transform-origin: left center;
  }

  .sector-evidence-card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.86) contrast(1.04);
    transition: none;
  }

  .sector-evidence-card__folio {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    padding: 1.5rem;
    background:
      linear-gradient(135deg, rgba(17,17,17,0.04), rgba(17,17,17,0.1)),
      #F5F6F7;
  }

  .sector-evidence-card__folio span {
    color: #111;
    font-family: var(--um-font-display);
    font-size: 1.25rem;
    font-weight: var(--um-weight-title);
    line-height: 1.2;
  }

  .sector-evidence-card__body {
    display: flex;
    flex-direction: column;
