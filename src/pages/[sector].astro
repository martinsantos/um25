---
/**
 * Sector Page — Dynamic Route (SSR)
 * Handles all sector slugs using Directus data.
 */

import LayoutV4 from '../layouts/LayoutV4.astro';
import SectorTemplateEditorial from '../components/templates/SectorTemplateEditorial.astro';
import SectorTemplateAtlas from '../components/templates/SectorTemplateAtlas.astro';
import SectorTemplateUM26 from '../components/templates/SectorTemplateUM26.astro';
import GeoHubDossier from '../components/templates/GeoHubDossier.astro';
import { generateSlug } from '../utils/slugUtils.js';
import { getSectorBySlug, getAntecedentesForSector } from '../utils/sectoresHelpers.ts';
import { getFAQSchema } from '../data/sectorFAQs';
import { getSectorVisualSpec } from '../data/sectorVisualSystem';
import { editorialImageDimensions, editorialImages, getSectorEditorialImage } from '../data/editorialImageSystem';
import { resolveCmsImageUrl } from '../utils/directusImageResolver';
import { buildGeoHubStructuredData, getGeoCommercialHub } from '../data/geoCommercialHubs';
import {
  buildSectorStrategicLinkGroups,
  buildStrategicWebPageStructuredData,
  getLegacyRedirectTarget,
} from '../data/strategicLinkGraph';
import { getReplicaProdEntry, isReplicaIdenticalCopy, resolveReplicaH1 } from '../utils/replicaProdCopy';

const requestedSectorSlug = Astro.params.sector || '';
const sectorSlugAliases: Record<string, string> = {
  gobierno: 'gobiernosectorpublico',
};
const sectorSlug = sectorSlugAliases[requestedSectorSlug] || requestedSectorSlug;
const publicSectorSlug = requestedSectorSlug;
const legacyRedirectTarget = getLegacyRedirectTarget(publicSectorSlug);

if (legacyRedirectTarget) {
  return Astro.redirect(legacyRedirectTarget, 301);
}

const geoHub = getGeoCommercialHub(publicSectorSlug);
const sectorData = geoHub ? null : await getSectorBySlug(sectorSlug);

if (!geoHub && !sectorData) {
  return Astro.redirect('/sectores', 301);
}

const {
  nombre = '',
  hero_image,
  descripcion = '',
  keywords = [],
  seo_title,
  seo_description,
  seo_keywords,
  stats,
  value_props,
  servicios: serviciosRelacionados,
} = sectorData || {};

const visual = getSectorVisualSpec(publicSectorSlug) || getSectorVisualSpec(sectorSlug);
const heroImage = resolveCmsImageUrl(hero_image, visual?.image || getSectorEditorialImage(sectorSlug));
const editorialHeadline = visual?.headline || `Tecnología para ${nombre}`;
const editorialSeoTitle = getReplicaProdEntry(`/${publicSectorSlug}`)?.title || seo_title || editorialHeadline;
const pageHeadline = isReplicaIdenticalCopy()
  ? resolveReplicaH1(`/${publicSectorSlug}`, seo_title || editorialHeadline)
  : editorialHeadline;
const pageSummary = visual?.summary || descripcion;
const antecedentes = geoHub ? [] : await getAntecedentesForSector(keywords, nombre);
const sanitizeSectorStats = (items: any[] = []) => items.map((stat: any) => {
  const label = String(stat?.label || '');
  const value = String(stat?.value || '');
  if (/99[\.,]\d+%/.test(value) || /uptime|disponibilidad/i.test(label)) {
    return { ...stat, label: 'Operación', value: '24/7' };
  }
  return stat;
});
const displayStats = sanitizeSectorStats(stats || []);
const faqSchema = getFAQSchema(sectorSlug);
const devTemplateParam = import.meta.env.DEV && !isReplicaIdenticalCopy()
  ? Astro.url.searchParams.get('template')
  : null;
const templateVariant = devTemplateParam === 'editorial' || devTemplateParam === 'atlas'
  ? devTemplateParam
  : 'um26';
const templateSector = {
  ...(visual || {}),
  ...sectorData,
  nombre,
  label: visual?.label || nombre,
  slug: publicSectorSlug,
  pageHeadline,
  pageSummary,
  heroImage,
  image: visual?.image || heroImage,
  stats: displayStats,
  operatingNeed: visual?.operatingNeed,
  proof: visual?.proof,
  services: visual?.services,
};
const templateServiciosRelacionados = (serviciosRelacionados || []).map((servicio: any) => ({
  ...servicio,
  slug: generateSlug(servicio.nombre || servicio.Titulo || 'servicio')
}));
const sectorStrategicLinkGroups = geoHub ? [] : buildSectorStrategicLinkGroups({
  currentPath: `/${publicSectorSlug}`,
  sectorSlug,
  sectorName: templateSector.label || nombre,
  title: pageHeadline,
  summary: pageSummary || seo_description,
  text: [
    templateSector.operatingNeed,
    templateSector.proof,
    Array.isArray(templateSector.services) ? templateSector.services.join(' ') : '',
  ].filter(Boolean).join(' '),
  relatedServices: templateServiciosRelacionados,
  relatedCases: antecedentes.slice(0, 4),
});
const sectorStructuredData = geoHub ? [] : [
  ...(faqSchema ? [faqSchema] : []),
  buildStrategicWebPageStructuredData({
    url: `https://www.ultimamilla.com.ar/${publicSectorSlug}`,
    name: pageHeadline,
    description: seo_description || pageSummary,
    groups: sectorStrategicLinkGroups,
  }),
];
---

{geoHub ? (
<LayoutV4
  title={geoHub.seoTitle}
  description={geoHub.description}
  keywords={geoHub.keywords}
  canonical={`https://www.ultimamilla.com.ar/${geoHub.slug}`}
  image={editorialImages.defaultOg}
  imageWidth={editorialImageDimensions.width}
  imageHeight={editorialImageDimensions.height}
  structuredData={buildGeoHubStructuredData(geoHub)}
>
  <GeoHubDossier hub={geoHub} />
</LayoutV4>
) : (
<LayoutV4 title={editorialSeoTitle} description={seo_description} keywords={seo_keywords} image={heroImage} imageWidth={editorialImageDimensions.width} imageHeight={editorialImageDimensions.height} structuredData={sectorStructuredData}>
  {templateVariant === 'um26' && (
    <SectorTemplateUM26
      sector={templateSector}
      antecedentes={antecedentes}
      valueProps={value_props || []}
      serviciosRelacionados={templateServiciosRelacionados}
    />
  )}
  {templateVariant === 'editorial' && (
    <SectorTemplateEditorial
      mode="detail"
      sector={templateSector}
      antecedentes={antecedentes}
      valueProps={value_props || []}
      serviciosRelacionados={templateServiciosRelacionados}
    />
  )}
  {templateVariant === 'atlas' && (
    <SectorTemplateAtlas
      mode="detail"
      sector={templateSector}
      antecedentes={antecedentes}
      valueProps={value_props || []}
      serviciosRelacionados={templateServiciosRelacionados}
    />
  )}
</LayoutV4>
)}
