  title: "Tecnología y Telecomunicaciones para Minería | Mendoza, San Juan y Patagonia | ULTIMA MILLA",
  description: "Servicios tecnológicos para empresas mineras en Argentina. Zona de incumbencia: Mendoza, Cuyo, Patagonia. Telecomunicaciones críticas, corrientes débiles, detección de incendio, cableado estructurado y conectividad remota. Enlaces de radio, fibra óptica y campamentos mineros.",
  keywords: "servicios tecnologicos mineria, zona incumbencia san juan mendoza, telecomunicaciones mineras, corrientes debiles mineria, deteccion incendio mineria, cableado estructurado remote, conectividad satelital, radioenlaces cordillera, campamentos mineros tecnologia",
  // ogImage: "/images/services/mineria-hero.jpg",
  canonical: "https://ultimamilla.com.ar/mineria",
  locale: "es_AR",
  region: "Cuyo, Patagonia, Argentina",
  author: "Ultima Milla",
  robots: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
};

// Cargar antecedentes del sector software
import { antecedentesReales } from '../data/antecedentes_completos.js';
import FeaturedAntecedentes from '../components/FeaturedAntecedentes.astro';

// Filtrar antecedentes específicos de MINERÍA
// Como no hay antecedentes con "minería" explícita, mostramos proyectos de 
// telecomunicaciones, redes, CCTV y sistemas remotos que son aplicables al sector
const filterAntecedentes = (data) => {
  const keywords = ['telecomunicaciones', 'radioenlace', 'fibra optica', 'cctv', 
                    'radio enlace', 'satelital', 'remoto', 'campamento', 'scada',
                    'telemetria', 'monitoreo', 'iot'];
  
  return data
    .filter(item => {
      const cliente = (item.Cliente || '').toLowerCase();
      const titulo = (item.Titulo || '').toLowerCase();
      const area = (item.Area || '').toLowerCase();
      const desc = (item.Descripcion || '').toLowerCase();
      
      // Buscar keywords relacionadas a tecnología para minería
      return keywords.some(k => 
        cliente.includes(k) || 
        titulo.includes(k) || 
        area.includes(k) ||
        desc.includes(k)
      );
    })
    .map(item => ({
      ...item,
      slug: `${item.id}/${generateSlug(item.Titulo)}`
    }))
    .sort((a, b) => new Date(b.Fecha) - new Date(a.Fecha));
};

let antecedentes = [];
let serviciosRelacionados = [];
let error = null;

try {
  // Obtener antecedentes de software desde Directus
  const response = await directus.getAntecedentes({
    limit: 500,
    page: 1
  });

  if (response && response.data && response.data.length > 0) {
    antecedentes = filterAntecedentes(response.data);
    console.log(`✅ Cargados ${antecedentes.length} antecedentes de software`);
  }
} catch (err) {
  console.error('Error cargando antecedentes:', err);
  error = err;
}

// Fallback a datos locales si no hay resultados de API
if (antecedentes.length === 0) {
  console.log('Usando antecedentes locales para Software');
  antecedentes = filterAntecedentes(antecedentesReales);
}

