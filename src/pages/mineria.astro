---
import Layout from '../layouts/Layout.astro';
import FAQSchema from '../components/SEO/FAQSchema.astro';
import { directus, DEFAULT_IMAGE, getAntecedenteImageUrl } from '../utils/directus';
import { generateSlug } from '../utils/slugUtils';

// FAQs para el sector minería
const mineriaFAQs = [
  {
    question: "¿Qué servicios de telecomunicaciones ofrecen para minería?",
    answer: "Ofrecemos radioenlaces punto a punto, conectividad satelital, redes de fibra óptica, comunicaciones VHF/UHF, y sistemas de monitoreo remoto para campamentos y faenas mineras en Mendoza, San Juan y la Cordillera."
  },
  {
    question: "¿Trabajan en zonas remotas de alta montaña?",
    answer: "Sí, tenemos amplia experiencia en proyectos de telecomunicaciones y corrientes débiles a más de 4.000 metros de altura en la Cordillera de los Andes, con soluciones diseñadas para condiciones extremas."
  },
  {
    question: "¿Qué sistemas de seguridad instalan para minería?",
    answer: "Implementamos sistemas de detección de incendio certificados, CCTV para monitoreo de operaciones, control de acceso biométrico, y sistemas de alarma perimetral para sitios mineros críticos."
  },
  {
    question: "¿Ofrecen soporte técnico en sitios mineros remotos?",
    answer: "Sí, brindamos soporte técnico 24/7 con tiempos de respuesta garantizados, incluyendo asistencia remota y presencial en faenas mineras de difícil acceso."
  }
];

// Configuración SEO específica para Minería - ULTRA OPTIMIZADA para Argentina y Mendoza
const seoConfig = {
  title: "Tecnología y Telecomunicaciones para Minería | Mendoza, San Juan y Patagonia | ULTIMA MILLA",
  description: "Servicios tecnológicos para empresas mineras en Argentina. Zona de incumbencia: Mendoza, Cuyo, Patagonia. Telecomunicaciones críticas, corrientes débiles, detección de incendio, cableado estructurado y conectividad remota. Enlaces de radio, fibra óptica y campamentos mineros.",
  keywords: "servicios tecnologicos mineria, zona incumbencia san juan mendoza, telecomunicaciones mineras, corrientes debiles mineria, deteccion incendio mineria, cableado estructurado remote, conectividad satelital, radioenlaces cordillera, campamentos mineros tecnologia",
  ogImage: "/images/services/redes-comunicaciones.jpg",
  canonical: "https://ultimamilla.com.ar/mineria",
  locale: "es_AR",
  region: "Cuyo, Patagonia, Argentina",
  author: "Ultima Milla",
  robots: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
};

// Cargar antecedentes del sector software
import { antecedentesReales } from '../data/antecedentes_completos.js';
import FeaturedAntecedentes from '../components/FeaturedAntecedentes.astro';
import { sortByImpact } from '../utils/antecedentesScoring.js';

// Filtrar antecedentes específicos de MINERÍA
// Como no hay antecedentes con "minería" explícita, mostramos proyectos de
// telecomunicaciones, redes, CCTV y sistemas remotos que son aplicables al sector
const filterAntecedentes = (data) => {
  const keywords = ['telecomunicaciones', 'radioenlace', 'fibra optica', 'cctv',
                    'radio enlace', 'satelital', 'remoto', 'campamento', 'scada',
                    'telemetria', 'monitoreo', 'iot'];

  const filtered = data
    .filter(item => {
      const cliente = (item.Cliente || '').toLowerCase();
      const titulo = (item.Titulo || '').toLowerCase();
      const area = (item.Area || '').toLowerCase();
      const desc = (item.Descripcion || '').toLowerCase();

      // Buscar keywords relacionadas a tecnología para minería
      return keywords.some(k =>
        cliente.includes(k) ||
        titulo.includes(k) ||
        area.includes(k) ||
        desc.includes(k)
      );
    });

  // Ordenar por impacto (relevancia) - mejores casos primero
  const sortedByImpact = sortByImpact(filtered);

  return sortedByImpact;
};

let antecedentes = [];
let serviciosRelacionados = [];
let error = null;

try {
  // Obtener antecedentes de minería desde Directus
  const response = await directus.getAntecedentes({
    limit: 500,
    page: 1
  });

  if (response && response.data && response.data.length > 0) {
    antecedentes = filterAntecedentes(response.data);
    console.log(`✅ Cargados ${antecedentes.length} antecedentes de minería`);
  }
} catch (err) {
  console.error('Error cargando antecedentes:', err);
  error = err;
}

// Fallback a datos locales si no hay resultados de API
if (antecedentes.length === 0) {
  console.log('Usando antecedentes locales para Minería');
  antecedentes = filterAntecedentes(antecedentesReales);
}

// Procesar imágenes y slugs para cada antecedente
const { getAntecedenteImageUrl } = await import('../utils/directus.js');
const { generateSlug } = await import('../utils/slugUtils.js');
antecedentes = await Promise.all(
  antecedentes.map(async (item) => ({
    ...item,
    Nombre: item.Titulo || item.Nombre,
    mapeo_imagenes_completo: await getAntecedenteImageUrl(item),
    slug: generateSlug(item.Titulo || item.Nombre)
  }))
);

  // Servicios relacionados con el sector software
  // Structured Data para SEO
  const structuredData = {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Infraestructura IT para Software",
    "provider": {
      "@type": "Organization",
      "name": "Ultima Milla",
      "url": "https://www.ultimamilla.com.ar",
      "logo": "https://www.ultimamilla.com.ar/images/um-logo.png",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Mendoza",
        "addressRegion": "Mendoza",
        "addressCountry": "AR"
      }
    },
    "areaServed": [
      {
        "@type": "City",
        "name": "Mendoza"
      },
      {
        "@type": "Country",
        "name": "Argentina"
      }
    ],
    "audience": {
      "@type": "BusinessAudience",
      "name": "Software y Empresas de Construcción"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Servicios IT para Software",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Cableado Estructurado para Obras"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Sistemas de Seguridad CCTV y Control de Accesos"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Conectividad Temporal para Canteros"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Telefonía IP Empresarial"
          }
        }
      ]
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "50"
    }
  };

  serviciosRelacionados = [
    {
      id: 1,
      nombre: "Servicios IT",
      descripcion: "Consultoría y desarrollo de soluciones IT personalizadas",
      icon: "network",
      slug: "servicios-it"
    },
    {
      id: 2,
      nombre: "Redes de Datos",
      descripcion: "Infraestructura de redes robusta y escalable",
      icon: "shield",
      slug: "redes-datos"
    },
    {
      id: 3,
      nombre: "Seguridad Informática",
      descripcion: "Protección de sistemas y datos empresariales",
      icon: "wifi",
      slug: "seguridad-informatica"
    },
    {
      id: 4,
      nombre: "Telecomunicaciones",
      descripcion: "Sistemas de comunicación integrados",
      icon: "phone",
      slug: "telecomunicaciones"
    },
    {
      id: 5,
      nombre: "Software Personalizado",
      descripcion: "Desarrollo de aplicaciones a medida",
      icon: "alert",
      slug: "software-personalizado"
    },
    {
      id: 6,
      nombre: "Soporte Técnico 24/7",
      descripcion: "Asistencia técnica especializada continua",
      icon: "support",
      slug: "soporte-tecnico"
    }
  ];

---

<Layout
  title={seoConfig.title}
  description={seoConfig.description}
  keywords={seoConfig.keywords}
  image={seoConfig.ogImage}
  canonical={seoConfig.canonical}
>
  <FAQSchema items={mineriaFAQs} />

  <main style="background: #f5f5f5;">
    <!-- HERO EXACTO DEL BOCETO -->
    <section style="position: relative; min-height: 350px; display: flex; align-items: center; background: linear-gradient(rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0.65)), url('https://images.unsplash.com/photo-1517694712202-14dd9538aa97?w=1920&q=80') center/cover; color: white;">
      <div style="max-width: 1200px; margin: 0 auto; padding: 50px 40px; width: 100%;">
        <!-- Badge Simple -->
        <div style="display: inline-flex; align-items: center; gap: 12px; padding: 12px 20px; background: linear-gradient(135deg, rgba(6, 182, 212, 0.3), rgba(6, 182, 212, 0.1)); border-radius: 20px; margin-bottom: 20px; border: 1px solid rgba(6, 182, 212, 0.4); backdrop-filter: blur(10px);">
          <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #d97706, #f59e0b); border-radius: 12px; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 20px rgba(6, 182, 212, 0.4);">
            <span style="font-size: 24px;">⛏️</span>
          </div>
          <span style="font-size: 13px; font-weight: 800; color: #d97706; text-transform: uppercase; letter-spacing: 1.2px;">Sector Minería</span>
        </div>

        <!-- Title Simple -->
        <h1 style="font-size: 48px; font-weight: 900; margin-bottom: 20px; line-height: 1.2; color: white;">
          Tecnología Crítica para<br/>Ambientes Extremos
        </h1>

        <!-- Subtitle -->
        <p style="font-size: 18px; font-weight: 400; color: rgba(255, 255, 255, 0.9); max-width: 600px; margin-bottom: 32px; line-height: 1.6;">
          Soluciones de conectividad, seguridad y automatización diseñadas para operar en las condiciones más exigentes de la minería.
        </p>

        <!-- CTA Button -->
        <a href="#contacto" style="display: inline-block; background: #d97706; color: white; padding: 14px 32px; border-radius: 6px; font-weight: 700; font-size: 15px; text-decoration: none; transition: all 0.3s ease;" onmouseover="this.style.background='#b45309'" onmouseout="this.style.background='#d97706'">
          Soluciones para Minería
        </a>
      </div>
    </section>

    <!-- 3 CARDS EXACTAS DEL BOCETO -->
    <section style="background: #f5f5f5; padding: 50px 40px;">
      <div style="max-width: 1200px; margin: 0 auto;">
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px;">
          <!-- Card 1 EXACTA -->
          <div style="text-align: center; padding: 40px 30px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            <div style="width: 80px; height: 80px; background: white; border: 3px solid #e0e0e0; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
              <svg style="width: 40px; height: 40px; color: #333;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-4m-5 0H9m0 0H5m4 0V9a1 1 0 011-1h4a1 1 0 011 1v12M9 7h6"></path>
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Conectividad Remota</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Enlaces de alta disponibilidad en zonas aisladas y de difícil acceso.</p>
          </div>

          <!-- Card 2 EXACTA -->
          <div style="text-align: center; padding: 40px 30px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            <div style="width: 80px; height: 80px; background: white; border: 3px solid #e0e0e0; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
              <svg style="width: 40px; height: 40px; color: #333;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Seguridad Industrial</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Sistemas CCTV y control de accesos robustos para ambientes hostiles.</p>
          </div>

          <!-- Card 3 EXACTA -->
          <div style="text-align: center; padding: 40px 30px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            <div style="width: 80px; height: 80px; background: white; border: 3px solid #e0e0e0; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
              <svg style="width: 40px; height: 40px; color: #333;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">IoT y Telemetría</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Monitoreo en tiempo real de activos y condiciones ambientales.</p>
          </div>
        </div>
      </div>
    </section>


    <!-- SERVICIOS EXACTOS DEL BOCETO -->
    <section id="servicios" style="background: white; padding: 50px 40px;">
      <div style="max-width: 1200px; margin: 0 auto;">
        <!-- Header Simple -->
        <div style="text-align: center; margin-bottom: 60px;">
          <h2 style="font-size: 36px; font-weight: 700; color: #333; margin-bottom: 16px;">Soluciones para Minería</h2>
          <p style="font-size: 16px; color: #666; max-width: 700px; margin: 0 auto; line-height: 1.6;">
            Infraestructura tecnológica diseñada para garantizar la continuidad operativa en yacimientos y plantas de procesamiento.
          </p>
        </div>

        <!-- Services Grid 2x2 -->
        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 30px; max-width: 900px; margin: 0 auto;">
          <!-- Servicio 1: Servicios IT (ID 1) -->
          <a href="/servicios/1/servicios-it" style="text-decoration: none; display: block; padding: 30px; background: #fafafa; border-radius: 8px; border-left: 4px solid #d97706; transition: all 0.3s ease;" onmouseover="this.style.background='#f0f0f0'; this.style.transform='translateY(-4px)'" onmouseout="this.style.background='#fafafa'; this.style.transform='translateY(0)'">
            <div style="width: 50px; height: 50px; background: #d97706; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
              <svg style="width: 28px; height: 28px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Servicios IT</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Consultoría y soporte técnico especializado</p>
          </a>

          <!-- Servicio 2: Redes de Datos (ID 2) -->
          <a href="/servicios/2/redes-de-datos" style="text-decoration: none; display: block; padding: 30px; background: #fafafa; border-radius: 8px; border-left: 4px solid #d97706; transition: all 0.3s ease;" onmouseover="this.style.background='#f0f0f0'; this.style.transform='translateY(-4px)'" onmouseout="this.style.background='#fafafa'; this.style.transform='translateY(0)'">
            <div style="width: 50px; height: 50px; background: #d97706; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
              <svg style="width: 28px; height: 28px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Redes de Datos</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Cableado estructurado y fibra óptica</p>
          </a>

          <!-- Servicio 3: Seguridad Informática (ID 3) -->
          <a href="/servicios/3/seguridad-informatica" style="text-decoration: none; display: block; padding: 30px; background: #fafafa; border-radius: 8px; border-left: 4px solid #d97706; transition: all 0.3s ease;" onmouseover="this.style.background='#f0f0f0'; this.style.transform='translateY(-4px)'" onmouseout="this.style.background='#fafafa'; this.style.transform='translateY(0)'">
            <div style="width: 50px; height: 50px; background: #d97706; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
              <svg style="width: 28px; height: 28px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0" />
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Seguridad Informática</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Protección de sistemas y datos</p>
