---
import Layout from '../layouts/Layout.astro';
import { directus, DEFAULT_IMAGE } from '../utils/directus';
import { generateSlug } from '../utils/slugUtils';

// Configuración SEO específica para Minería - ULTRA OPTIMIZADA para Argentina y Mendoza
const seoConfig = {
  title: "Tecnología y Telecomunicaciones para Minería | ULTIMA MILLA",
  description: "Expertos en conectividad crítica y sistemas IT para minería en San Juan, Mendoza y Patagonia. Enlaces de radio, fibra óptica y campamentos mineros.",
  keywords: "tecnologia mineria argentina, telecomunicaciones mineras, internet satelital mineria, radioenlaces cordillera, san juan mineria, litio argentina, cobre mendoza",
  ogImage: "/images/services/mineria-hero.jpg",
  canonical: "https://ultimamilla.com.ar/mineria",
  locale: "es_AR",
  region: "Cuyo, Patagonia, Argentina",
  author: "Ultima Milla",
  robots: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
};

// Cargar antecedentes del sector minería
let antecedentes = [];
let serviciosRelacionados = [];
let error = null;

try {
  // Obtener antecedentes desde Directus
  const response = await directus.getAntecedentes({
    limit: 500,
    page: 1
  });

  if (response && response.data && response.data.length > 0) {
    // Filtrar antecedentes de minería con keywords exhaustivas
    const keywords = [
      'minera', 'mining', 'yacimiento', 'cantera', 'barrick', 'valle', 'potasio', 
      'rio colorado', 'hierro', 'indio', 'sales', 'litio', 'cobre', 'oro', 'plata', 
      'exploracion', 'perforacion', 'geologia', 'campamento', 'remoto'
    ];
    
    antecedentes = response.data
      .filter(item => {
        const cliente = item.Cliente?.toLowerCase() || '';
        const titulo = item.Titulo?.toLowerCase() || '';
        const area = item.Area?.toLowerCase() || '';
        
        return keywords.some(k => cliente.includes(k) || titulo.includes(k) || area.includes(k));
      })
      .map(item => ({
        ...item,
        slug: `${item.id}/${generateSlug(item.Titulo)}`
      }))
      .sort((a, b) => new Date(b.Fecha) - new Date(a.Fecha));

    console.log(`✅ Cargados ${antecedentes.length} antecedentes de minería`);
  }

  // Structured Data para SEO
  const structuredData = {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Tecnología para Minería",
    "provider": {
      "@type": "Organization",
      "name": "Ultima Milla",
      "url": "https://www.ultimamilla.com.ar",
      "logo": "https://www.ultimamilla.com.ar/images/um-logo.png",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Mendoza",
        "addressRegion": "Mendoza",
        "addressCountry": "AR"
      }
    },
    "areaServed": [
      { "@type": "City", "name": "Mendoza" },
      { "@type": "City", "name": "San Juan" },
      { "@type": "AdministrativeArea", "name": "Patagonia" },
      { "@type": "Country", "name": "Argentina" }
    ],
    "audience": {
      "@type": "BusinessAudience",
      "name": "Empresas Mineras y de Exploración"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Servicios IT para Minería",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Conectividad en Zonas Remotas" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "CCTV para Ambientes Extremos" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "IoT y Telemetría" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Infraestructura de Campamentos" } }
      ]
    }
  };

} catch (err) {
  console.error('Error cargando antecedentes:', err);
  error = err;
}

// Función para obtener imagen del antecedente
import { buscarImagenPorDatos } from '../data/mapeo_imagenes_completo';

function getImageUrl(proyecto) {
  if (!proyecto) return DEFAULT_IMAGE;

  // Si ya viene con imagen desde Directus (URL completa o path)
  if (proyecto.Imagen && (proyecto.Imagen.startsWith('/imagenes_') || proyecto.Imagen.startsWith('http'))) {
    return proyecto.Imagen;
  }

  const imagenNombre = buscarImagenPorDatos(
    proyecto.Cliente,
    proyecto.Area || proyecto.Unidad_de_negocio,
    proyecto.Titulo,
    proyecto.id
  );
  return imagenNombre 
    ? `/imagenes_antecedentes_versionproduccion/${imagenNombre}`
    : DEFAULT_IMAGE;
}

const antecedentesConImagenes = antecedentes.map(proyecto => ({
  ...proyecto,
  imageUrl: getImageUrl(proyecto)
}));
---

<Layout
  title={seoConfig.title}
  description={seoConfig.description}
  keywords={seoConfig.keywords}
  image={seoConfig.ogImage}
  canonical={seoConfig.canonical}
>
  <main style="background: #f5f5f5;">
    <!-- HERO -->
    <section style="position: relative; min-height: 400px; display: flex; align-items: center; background: linear-gradient(rgba(15, 23, 42, 0.75), rgba(15, 23, 42, 0.75)), url('https://images.unsplash.com/photo-1579547945413-497e1b99dac0?w=1920&q=80') center/cover; color: white;">
      <div style="max-width: 1200px; margin: 0 auto; padding: 50px 40px; width: 100%;">
        <!-- Badge -->
        <div style="display: inline-flex; align-items: center; gap: 12px; padding: 12px 20px; background: linear-gradient(135deg, rgba(217, 119, 6, 0.3), rgba(217, 119, 6, 0.1)); border-radius: 20px; margin-bottom: 20px; border: 1px solid rgba(217, 119, 6, 0.4); backdrop-filter: blur(10px);">
          <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #d97706, #f59e0b); border-radius: 12px; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 20px rgba(217, 119, 6, 0.4);">
            <span style="font-size: 24px;">⛏️</span>
          </div>
          <span style="font-size: 13px; font-weight: 800; color: #fbbf24; text-transform: uppercase; letter-spacing: 1.2px;">Sector Minería</span>
        </div>

        <!-- Title -->
        <h1 style="font-size: 48px; font-weight: 900; margin-bottom: 20px; line-height: 1.2; color: white;">
          Tecnología Crítica para<br/>Ambientes Extremos
        </h1>

        <!-- Subtitle -->
        <p style="font-size: 18px; font-weight: 400; color: rgba(255, 255, 255, 0.9); max-width: 600px; margin-bottom: 32px; line-height: 1.6;">
          Soluciones de conectividad, seguridad y automatización diseñadas para operar en las condiciones más exigentes de la minería.
        </p>

        <!-- CTA Button -->
        <a href="#contacto" style="display: inline-block; background: #d97706; color: white; padding: 14px 32px; border-radius: 6px; font-weight: 700; font-size: 15px; text-decoration: none; transition: all 0.3s ease;" onmouseover="this.style.background='#b45309'" onmouseout="this.style.background='#d97706'">
          Soluciones para Minería
        </a>
      </div>
    </section>

    <!-- 3 CARDS -->
    <section style="background: #f5f5f5; padding: 50px 40px;">
      <div style="max-width: 1200px; margin: 0 auto;">
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px;">
          <!-- Card 1 -->
          <div style="text-align: center; padding: 40px 30px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            <div style="width: 80px; height: 80px; background: white; border: 3px solid #e0e0e0; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
              <svg style="width: 40px; height: 40px; color: #333;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"></path>
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Conectividad Remota</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Enlaces de alta disponibilidad en zonas aisladas y de difícil acceso.</p>
          </div>

          <!-- Card 2 -->
          <div style="text-align: center; padding: 40px 30px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            <div style="width: 80px; height: 80px; background: white; border: 3px solid #e0e0e0; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
              <svg style="width: 40px; height: 40px; color: #333;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Seguridad Industrial</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Sistemas CCTV y control de accesos robustos para ambientes hostiles.</p>
          </div>

          <!-- Card 3 -->
          <div style="text-align: center; padding: 40px 30px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            <div style="width: 80px; height: 80px; background: white; border: 3px solid #e0e0e0; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
              <svg style="width: 40px; height: 40px; color: #333;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">IoT y Telemetría</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Monitoreo en tiempo real de activos y condiciones ambientales.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICIOS -->
    <section id="servicios" style="background: white; padding: 50px 40px;">
      <div style="max-width: 1200px; margin: 0 auto;">
        <!-- Header -->
        <div style="text-align: center; margin-bottom: 60px;">
          <h2 style="font-size: 36px; font-weight: 700; color: #333; margin-bottom: 16px;">Soluciones para Minería</h2>
          <p style="font-size: 16px; color: #666; max-width: 700px; margin: 0 auto; line-height: 1.6;">
            Infraestructura tecnológica diseñada para garantizar la continuidad operativa en yacimientos y plantas de procesamiento.
          </p>
        </div>

        <!-- Services Grid 2x2 -->
        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 30px; max-width: 900px; margin: 0 auto;">
          <!-- Servicio 1 -->
          <div style="padding: 30px; background: #fafafa; border-radius: 8px; border-left: 4px solid #d97706;">
            <div style="width: 50px; height: 50px; background: #d97706; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
              <svg style="width: 28px; height: 28px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0" />
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Enlaces Críticos</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Conectividad satelital y radioenlaces de larga distancia.</p>
          </div>

          <!-- Servicio 2 -->
          <div style="padding: 30px; background: #fafafa; border-radius: 8px; border-left: 4px solid #d97706;">
            <div style="width: 50px; height: 50px; background: #d97706; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
              <svg style="width: 28px; height: 28px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Video Vigilancia</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Cámaras térmicas y antiexplosivas para monitoreo perimetral.</p>
          </div>

          <!-- Servicio 3 -->
          <div style="padding: 30px; background: #fafafa; border-radius: 8px; border-left: 4px solid #d97706;">
            <div style="width: 50px; height: 50px; background: #d97706; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
              <svg style="width: 28px; height: 28px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-4m-5 0H9m0 0H5m4 0V9a1 1 0 011-1h4a1 1 0 011 1v12M9 7h6" />
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Campamentos</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Infraestructura IT completa para campamentos y oficinas temporales.</p>
          </div>

          <!-- Servicio 4 -->
          <div style="padding: 30px; background: #fafafa; border-radius: 8px; border-left: 4px solid #d97706;">
            <div style="width: 50px; height: 50px; background: #d97706; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
              <svg style="width: 28px; height: 28px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z" />
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Automatización</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Integración de sistemas SCADA y control industrial.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CASOS DE ÉXITO -->
    {antecedentesConImagenes.length > 0 && (
      <section style="background: #f8fafc; padding: 100px 32px; border-top: 1px solid #e2e8f0;">
        <div style="max-width: 75rem; margin: 0 auto;">
          <div style="text-align: center; margin-bottom: 72px;">
            <div style="display: inline-block; padding: 8px 20px; background: linear-gradient(135deg, #d97706, #f59e0b); border-radius: 50px; margin-bottom: 20px;">
              <span style="font-size: 13px; font-weight: 800; color: white; letter-spacing: 1px; text-transform: uppercase;">✨ Experiencia Minera</span>
            </div>
            <h2 style="font-size: clamp(36px, 5.5vw, 52px); font-weight: 900; color: #0f172a; margin-bottom: 20px; letter-spacing: -0.02em;">Proyectos en Minería</h2>
            <p style="font-size: 19px; color: #64748b; max-width: 750px; margin: 0 auto; line-height: 1.7; font-weight: 500;">
              Soluciones implementadas en los principales yacimientos de la región.
            </p>
          </div>

          <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 32px;">
          {antecedentesConImagenes.map((proyecto) => (
            <a href={`/antecedentes/${proyecto.slug}`} style="display: block; text-decoration: none; height: 100%;">
              <article style="background: white; border-radius: 24px; box-shadow: 0 4px 20px rgba(0,0,0,0.08); transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); overflow: hidden; border: 2px solid #e2e8f0; height: 100%;" onmouseover="this.style.transform='translateY(-12px)'; this.style.boxShadow='0 20px 50px rgba(217,119,6,0.25)'; this.style.borderColor='#d97706'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 4px 20px rgba(0,0,0,0.08)'; this.style.borderColor='#e2e8f0'">
                {/* Imagen del proyecto */}
                <div style="position: relative; overflow: hidden; aspect-ratio: 4/3;">
                  <img 
                    src={proyecto.imageUrl}
                    alt={proyecto.Titulo}
                    style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.6s ease;"
                    loading="lazy"
                    onerror="this.src='/images/default.jpg'"
                    onmouseover="this.style.transform='scale(1.08)'"
                    onmouseout="this.style.transform='scale(1)'"
                  />
                  
                  {/* Badge */}
                  <div style="position: absolute; top: 20px; left: 20px;">
                    <span style="display: inline-flex; align-items: center; gap: 8px; padding: 10px 18px; border-radius: 50px; font-size: 12px; font-weight: 900; background: linear-gradient(135deg, #d97706, #f59e0b); color: white; box-shadow: 0 8px 20px rgba(217,119,6,0.4); backdrop-filter: blur(8px); border: 1px solid rgba(255,255,255,0.2);">
                      <span style="font-size: 16px;">⛏️</span>
                      MINERÍA
                    </span>
                  </div>
                </div>

                {/* Contenido */}
                <div style="padding: 28px;">
                  <div style="margin-bottom: 20px;">
                    <h3 style="font-size: 20px; font-weight: 900; color: #0f172a; margin-bottom: 12px; line-height: 1.3; letter-spacing: -0.01em; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;">
                      {proyecto.Titulo}
                    </h3>
                    {proyecto.Cliente && (
                      <div style="display: flex; align-items: center; gap: 8px; font-size: 14px; color: #64748b; margin-bottom: 12px; font-weight: 600;">
                        <svg style="width: 18px; height: 18px; color: #d97706;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-4m-5 0H9m0 0H5m4 0V9a1 1 0 011-1h4a1 1 0 011 1v12M9 7h6"></path>
                        </svg>
                        {proyecto.Cliente}
                      </div>
                    )}
                  </div>

                  <p style="color: #64748b; font-size: 14px; line-height: 1.7; margin-bottom: 20px; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; font-weight: 500;">
                    {proyecto.Descripcion?.substring(0, 120)}...
                  </p>

                  <div style="display: flex; align-items: center; justify-content: space-between; padding-top: 20px; border-top: 2px solid #f1f5f9;">
                    <div style="display: flex; align-items: center; gap: 6px; font-size: 13px; color: #94a3b8; font-weight: 600;">
                      <svg style="width: 16px; height: 16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                      </svg>
                      {(() => {
                        if (!proyecto.Fecha) return '2024';
                        const fecha = new Date(proyecto.Fecha);
                        return isNaN(fecha.getTime()) ? '2024' : fecha.toLocaleDateString('es-ES', { year: 'numeric', month: 'short' });
                      })()}
                    </div>
                  </div>
                </div>
              </article>
            </a>
          ))}
          </div>
        </div>
      </section>
    )}

    <!-- FORMULARIO -->
    <section id="contacto" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); padding: 100px 32px; position: relative; overflow: hidden;">
      <div style="max-width: 75rem; margin: 0 auto; position: relative; z-index: 10;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center;">
          <!-- Left Content -->
          <div>
            <div style="display: inline-block; padding: 8px 20px; background: rgba(217, 119, 6, 0.2); border-radius: 50px; margin-bottom: 24px; border: 1px solid rgba(217, 119, 6, 0.3);">
              <span style="font-size: 13px; font-weight: 800; color: #fbbf24; letter-spacing: 1px; text-transform: uppercase;">📞 Contáctenos</span>
            </div>
            <h2 style="font-size: clamp(36px, 5vw, 56px); font-weight: 900; color: white; margin-bottom: 24px; line-height: 1.1; letter-spacing: -0.02em;">
              Soluciones Críticas para<br/>Minería
            </h2>
            <p style="font-size: 18px; color: #cbd5e1; line-height: 1.8; margin-bottom: 40px; font-weight: 500;">
              Contáctenos para diseñar la infraestructura tecnológica que su operación minera necesita.
            </p>
          </div>
          
          <!-- Right Form -->
          <div style="background: white; border-radius: 24px; padding: 48px; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
            <form action="/api/contact" method="POST" style="display: flex; flex-direction: column; gap: 24px;">
              <div>
                <label style="display: block; font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Nombre</label>
                <input type="text" name="nombre" required style="width: 100%; padding: 14px 18px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 15px;" placeholder="Nombre Completo" />
              </div>
              <div>
                <label style="display: block; font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Empresa Minera</label>
                <input type="text" name="empresa" required style="width: 100%; padding: 14px 18px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 15px;" placeholder="Empresa" />
              </div>
              <div>
                <label style="display: block; font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Email</label>
                <input type="email" name="email" required style="width: 100%; padding: 14px 18px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 15px;" placeholder="email@empresa.com" />
              </div>
              <div>
                <label style="display: block; font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Mensaje</label>
                <textarea name="mensaje" required rows="4" style="width: 100%; padding: 14px 18px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 15px;" placeholder="Detalles del requerimiento..."></textarea>
              </div>
              <button type="submit" style="width: 100%; padding: 18px; background: linear-gradient(135deg, #d97706, #f59e0b); color: white; border: none; border-radius: 12px; font-size: 16px; font-weight: 800; cursor: pointer;">
                Solicitar Contacto
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>
