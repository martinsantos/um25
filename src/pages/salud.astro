---
import Layout from '../layouts/Layout.astro';
import { directus, DEFAULT_IMAGE } from '../utils/directus';
import { generateSlug } from '../utils/slugUtils';

// Configuración SEO específica para salud - ULTRA OPTIMIZADA MUNDIAL
const seoConfig = {
  title: "Salud Mendoza Argentina | Tecnología Médica | Sistemas Hospitalarios | HIS",
  description: "Especialistas en tecnología para el sector salud en Mendoza y Argentina. Sistemas hospitalarios, HIS, infraestructura médica, cumplimiento normativo. Tecnología para clínicas y hospitales.",
  keywords: "salud mendoza argentina, tecnologia medica, sistemas hospitalarios, HIS mendoza, infraestructura clinica, tecnologia salud argentina, sistemas informacion hospitalaria, cumplimiento normativo salud, IT hospitales mendoza, redes medicas, tecnologia clinica, mendoza salud",
  ogImage: "/images/salud-hero.jpg",
  canonical: "https://ultimamilla.com.ar/salud",
  locale: "es_AR",
  region: "AR-M"
};

// Cargar antecedentes del sector salud
let antecedentes = [];
let serviciosRelacionados = [];
let error = null;

try {
  // Obtener antecedentes de salud desde Directus
  const response = await directus.getAntecedentes({
    limit: 500,
    page: 1
  });

  if (response && response.data && response.data.length > 0) {
    // Filtrar antecedentes del sector salud
    antecedentes = response.data
      .filter(item => 
        item.vertical === 'salud' ||
        item.Cliente?.toLowerCase().includes('hospital') ||
        item.Cliente?.toLowerCase().includes('salud') ||
        item.Cliente?.toLowerCase().includes('clinica')
      )
      .map(item => ({
        ...item,
        slug: `${item.id}/${generateSlug(item.Titulo)}`
      }))
      .sort((a, b) => new Date(b.Fecha) - new Date(a.Fecha));

    console.log(`✅ Cargados ${antecedentes.length} antecedentes del sector salud`);
  }

  // Servicios relacionados con el sector salud
  serviciosRelacionados = [
    {
      id: 1,
      titulo: "Redes y Cableado Estructurado",
      descripcion: "Infraestructura de red certificada para hospitales y clínicas, cumpliendo normativas sanitarias",
      icon: "network",
      slug: "servicios-it"
    },
    {
      id: 2,
      titulo: "Sistemas de Comunicaciones",
      descripcion: "Telefonía IP, intercomunicadores y sistemas de llamada para enfermería",
      icon: "phone",
      slug: "redes-de-datos"
    },
    {
      id: 3,
      titulo: "Seguridad y Detección",
      descripcion: "Sistemas de detección de incendios y seguridad informática para instituciones de salud",
      icon: "shield",
      slug: "seguridad-informatica"
    },
    {
      id: 4,
      titulo: "Soporte Técnico Especializado",
      descripcion: "Mantenimiento preventivo y correctivo de infraestructura tecnológica hospitalaria",
      icon: "support",
      slug: "servicios-gestionados"
    }
  ];

} catch (err) {
  console.error('Error al cargar datos de salud:', err);
  error = err.message;
}

// Función para obtener imagen del antecedente
async function getImageUrl(proyecto) {
  try {
    const { buscarImagenPorDatos } = await import('../data/mapeo_imagenes_completo.js');
    const nombreArchivo = buscarImagenPorDatos(
      proyecto.Cliente,
      proyecto.Area || proyecto.Unidad_de_negocio, 
      proyecto.Titulo,
      proyecto.id
    );
    
    if (nombreArchivo) {
      return `/imagenes_antecedentes_versionproduccion/${nombreArchivo}`;
    }
  } catch (error) {
    console.log('⚠️ Error en mapeo de imagen:', error.message);
  }
  return DEFAULT_IMAGE;
}

// Procesar imágenes
const antecedentesConImagenes = await Promise.all(
  antecedentes.map(async (proyecto) => ({
    ...proyecto,
    imageUrl: await getImageUrl(proyecto)
  }))
);

// Estadísticas del sector
const stats = {
  proyectos: antecedentes.length,
  clientes: new Set(antecedentes.map(a => a.Cliente)).size,
  aniosExperiencia: new Date().getFullYear() - Math.min(...antecedentes.map(a => new Date(a.Fecha).getFullYear()))
};
---

<Layout 
  title={seoConfig.title}
  description={seoConfig.description}
  ogImage={seoConfig.ogImage}
>
  <!-- Meta Tags Adicionales para SEO -->
  <meta slot="head" name="keywords" content={seoConfig.keywords} />
  <meta slot="head" name="geo.region" content="AR-M" />
  <meta slot="head" name="geo.placename" content="Mendoza" />
  <meta slot="head" name="geo.position" content="-32.889458;-68.845839" />
  <link slot="head" rel="canonical" href={seoConfig.canonical} />
  
  <!-- Open Graph Adicional -->
  <meta slot="head" property="og:type" content="website" />
  <meta slot="head" property="og:locale" content={seoConfig.locale} />
  <meta slot="head" property="og:url" content={seoConfig.canonical} />
  <meta slot="head" property="og:site_name" content="Última Milla" />
  
  <!-- Twitter Card -->
  <meta slot="head" name="twitter:card" content="summary_large_image" />
  <meta slot="head" name="twitter:title" content={seoConfig.title} />
  <meta slot="head" name="twitter:description" content={seoConfig.description} />
  
  <!-- Schema Markup Mejorado para SEO -->
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Service",
    "name": "Servicios IT para el Sector Salud en Mendoza",
    "provider": {
      "@type": "Organization",
      "name": "Última Milla",
      "url": "https://www.ultimamilla.com.ar",
      "logo": "https://www.ultimamilla.com.ar/images/logo.png",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Mendoza",
        "addressRegion": "Mendoza",
        "addressCountry": "AR"
      }
    },
    "areaServed": {
      "@type": "State",
      "name": "Mendoza, Argentina"
    },
    "serviceType": ["Cableado Estructurado Hospitalario", "Redes de Datos para Clínicas", "Telefonía IP Hospitales", "Sistemas de Detección de Incendios", "Seguridad Informática Salud"],
    "description": seoConfig.description,
    "offers": {
      "@type": "Offer",
      "availability": "https://schema.org/InStock",
      "areaServed": "Mendoza, Argentina"
    }
  })} />

  <main style="background: #f0fdf4;">
    <!-- HERO MODERNO CON IMAGEN DE FONDO MÉDICA -->
    <section style="position: relative; min-height: 600px; display: flex; align-items: center; background: linear-gradient(rgba(5, 150, 105, 0.85), rgba(6, 95, 70, 0.9)), url('https://images.unsplash.com/photo-1576091160399-112ba8d25d1d?w=1920&q=80') center/cover; color: white;">
      <div style="max-width: 80rem; margin: 0 auto; padding: 80px 24px; position: relative; z-index: 10; width: 100%;">
        <!-- Badge -->
        <div style="display: inline-flex; align-items: center; gap: 8px; border-radius: 9999px; background: rgba(16, 185, 129, 0.2); backdrop-filter: blur(10px); border: 1px solid rgba(16, 185, 129, 0.3); padding: 10px 20px; margin-bottom: 24px;">
          <div style="width: 10px; height: 10px; border-radius: 50%; background: #10b981; box-shadow: 0 0 12px rgba(16, 185, 129, 0.8);"></div>
          <span style="font-size: 13px; font-weight: 700; color: #6ee7b7; letter-spacing: 1px; text-transform: uppercase;">Salud</span>
        </div>

        <!-- Title -->
        <h1 style="font-size: clamp(40px, 7vw, 64px); font-weight: 900; letter-spacing: -0.02em; margin-bottom: 20px; line-height: 1.1; text-shadow: 2px 4px 8px rgba(0,0,0,0.3);">
          Impulsando la Salud del Mañana
        </h1>

        <!-- Subtitle -->
        <p style="font-size: 20px; font-weight: 500; color: rgba(255, 255, 255, 0.95); max-width: 650px; margin-bottom: 40px; line-height: 1.6;">
          Salud, vida y tecnología se unen para una gestión hospitalaria inteligente y una atención al paciente excepcional.
        </p>

        <!-- CTA Button -->
        <a href="#servicios" style="display: inline-flex; align-items: center; gap: 12px; background: #10b981; color: white; padding: 16px 40px; border-radius: 8px; font-weight: 700; font-size: 16px; text-decoration: none; box-shadow: 0 8px 20px rgba(16, 185, 129, 0.4); transition: all 0.3s ease; border: none; cursor: pointer;">
          Descubrir Nuestras Soluciones
          <svg style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
      </div>
    </section>

    <!-- VALORES PRINCIPALES -->
    <section style="background: white; padding: 80px 24px;">
      <div style="max-width: 80rem; margin: 0 auto;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px;">
          <!-- Card 1 -->
          <div style="text-align: center; padding: 40px 24px; background: #f0fdf4; border-radius: 16px; border: 2px solid #d1fae5; transition: all 0.3s ease;" onmouseover="this.style.borderColor='#10b981'; this.style.transform='translateY(-8px)'; this.style.boxShadow='0 12px 24px rgba(16,185,129,0.15)'" onmouseout="this.style.borderColor='#d1fae5'; this.style.transform='translateY(0)'; this.style.boxShadow='none'">
            <div style="width: 64px; height: 64px; background: linear-gradient(135deg, #10b981, #059669); border-radius: 16px; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
              <svg style="width: 32px; height: 32px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
              </svg>
            </div>
            <h3 style="font-size: 20px; font-weight: 800; color: #1a1a1a; margin-bottom: 12px;">Excelencia del Paciente</h3>
            <p style="font-size: 15px; color: #6c757d; line-height: 1.6;">Nos enfocamos en mejorar la experiencia del paciente en cada punto de contacto.</p>
          </div>

          <!-- Card 2 -->
          <div style="text-align: center; padding: 40px 24px; background: #f0fdf4; border-radius: 16px; border: 2px solid #d1fae5; transition: all 0.3s ease;" onmouseover="this.style.borderColor='#10b981'; this.style.transform='translateY(-8px)'; this.style.boxShadow='0 12px 24px rgba(16,185,129,0.15)'" onmouseout="this.style.borderColor='#d1fae5'; this.style.transform='translateY(0)'; this.style.boxShadow='none'">
            <div style="width: 64px; height: 64px; background: linear-gradient(135deg, #10b981, #059669); border-radius: 16px; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
              <svg style="width: 32px; height: 32px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <h3 style="font-size: 20px; font-weight: 800; color: #1a1a1a; margin-bottom: 12px;">Privacidad de Datos</h3>
            <p style="font-size: 15px; color: #6c757d; line-height: 1.6;">Garantizamos la confidencialidad y seguridad de la información médica sensible.</p>
          </div>

          <!-- Card 3 -->
          <div style="text-align: center; padding: 40px 24px; background: #f0fdf4; border-radius: 16px; border: 2px solid #d1fae5; transition: all 0.3s ease;" onmouseover="this.style.borderColor='#10b981'; this.style.transform='translateY(-8px)'; this.style.boxShadow='0 12px 24px rgba(16,185,129,0.15)'" onmouseout="this.style.borderColor='#d1fae5'; this.style.transform='translateY(0)'; this.style.boxShadow='none'">
            <div style="width: 64px; height: 64px; background: linear-gradient(135deg, #10b981, #059669); border-radius: 16px; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
              <svg style="width: 32px; height: 32px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 style="font-size: 20px; font-weight: 800; color: #1a1a1a; margin-bottom: 12px;">Tecnología Médica Avanzada</h3>
            <p style="font-size: 15px; color: #6c757d; line-height: 1.6;">Integramos las últimas innovaciones para mejorar el diagnóstico y tratamiento.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICIOS OFRECIDOS -->
    <section id="servicios" style="background: #f0fdf4; padding: 80px 24px;">
      <div style="max-width: 80rem; margin: 0 auto;">
        <!-- Header -->
        <div style="text-align: center; margin-bottom: 60px;">
          <h2 style="font-size: clamp(32px, 5vw, 48px); font-weight: 900; color: #1a1a1a; margin-bottom: 16px;">Servicios Ofrecidos</h2>
          <p style="font-size: 18px; color: #6c757d; max-width: 700px; margin: 0 auto;">
            Ofrecemos un catálogo de soluciones tecnológicas innovadoras para mejorar cada aspecto de la gestión hospitalaria y la atención al paciente.
          </p>
        </div>

        <!-- Services Grid - Premium Cards -->

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          {serviciosRelacionados.map(servicio => (
            <a href={`/servicios/${servicio.id}/${servicio.slug}`} class="group">
              <div class="bg-gradient-to-br from-teal-50 to-cyan-50 rounded-xl p-6 h-full border-2 border-teal-100 hover:border-teal-400 transition-all duration-300 hover:shadow-xl hover:-translate-y-2">
                <div class="w-16 h-16 bg-teal-600 rounded-xl flex items-center justify-center mb-4 group-hover:bg-teal-700 transition-colors">
                  {servicio.icon === 'network' && (
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 9l3 3-3 3m5 0h3M5 20h14a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                    </svg>
                  )}
                  {servicio.icon === 'phone' && (
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                  )}
                  {servicio.icon === 'shield' && (
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                    </svg>
                  )}
                  {servicio.icon === 'support' && (
                    <svg class="w-8 h-8 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
                    </svg>
                  )}
                </div>
                <h3 class="text-xl font-bold text-gray-900 mb-3 group-hover:text-teal-600 transition-colors">
                  {servicio.titulo}
                </h3>
                <p class="text-gray-600 leading-relaxed">
                  {servicio.descripcion}
                </p>
              </div>
            </a>
          ))}
        </div>
      </div>
    </div>

    <!-- Proyectos Destacados del Sector Salud -->
    <div class="container mx-auto px-4 py-16">
      <div class="text-center mb-12">
        <h2 class="text-4xl font-bold text-gray-900 mb-4">Proyectos en Instituciones de Salud</h2>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          Conozca nuestra experiencia trabajando con hospitales y centros de salud en Mendoza
        </p>
      </div>

      {error && (
        <div class="bg-red-50 border-l-4 border-red-400 p-4 rounded mb-8">
          <p class="text-sm text-red-700">Error al cargar proyectos: {error}</p>
        </div>
      )}

      {antecedentesConImagenes.length === 0 && !error && (
        <div class="text-center py-12 bg-white rounded-lg shadow-sm border border-gray-200">
          <p class="text-gray-600">No se encontraron proyectos del sector salud</p>
        </div>
      )}

      {antecedentesConImagenes.length > 0 && (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {antecedentesConImagenes.map((proyecto) => (
            <a href={`/antecedentes/${proyecto.slug}`} class="block group cursor-pointer">
              <article class="bg-white rounded-2xl shadow-lg hover:shadow-2xl hover:shadow-teal-500/25 transition-all duration-300 transform hover:-translate-y-2 hover:scale-[1.02] hover:ring-4 hover:ring-teal-300/50 overflow-hidden border-2 border-transparent hover:border-teal-400 h-full">
                {/* Imagen del proyecto */}
                <div class="relative overflow-hidden aspect-[4/3]">
                  <img 
                    src={proyecto.imageUrl}
                    alt={proyecto.Titulo}
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    loading="lazy"
                    onerror="this.src='/images/default.jpg'"
                  />
                  
                  {/* Badge de salud */}
                  <div class="absolute top-4 left-4">
                    <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-teal-100 text-teal-800 border border-teal-200">
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                      </svg>
                      Sector Salud
                    </span>
                  </div>
                </div>

                {/* Contenido de la tarjeta */}
                <div class="p-6">
                  <div class="mb-4">
                    <h3 class="text-xl font-black text-gray-900 mb-2 line-clamp-2 group-hover:text-teal-600 transition-colors">
                      {proyecto.Titulo}
                    </h3>
                    {proyecto.Cliente && (
                      <div class="flex items-center text-sm text-gray-600 mb-2">
                        <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-4m-5 0H9m0 0H5m4 0V9a1 1 0 011-1h4a1 1 0 011 1v12M9 7h6"></path>
                        </svg>
                        {proyecto.Cliente}
                      </div>
                    )}
                  </div>

                  <p class="text-gray-600 line-clamp-3 text-sm leading-relaxed mb-4">
                    {proyecto.Descripcion?.substring(0, 120)}...
                  </p>

                  <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                    <div class="flex items-center text-xs text-gray-500">
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                      </svg>
                      {proyecto.Fecha ? new Date(proyecto.Fecha).toLocaleDateString('es-ES', { year: 'numeric', month: 'short' }) : '2024'}
                    </div>
                    {proyecto.Area && (
                      <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-teal-100 text-teal-700">
                        {proyecto.Area}
                      </span>
                    )}
                  </div>
                </div>
              </article>
            </a>
          ))}
        </div>
      )}
    </div>

    <!-- Call to Action -->
    <div class="bg-gradient-to-r from-teal-600 to-cyan-600 py-16">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-4xl font-bold text-white mb-6">
          ¿Necesita tecnología para su institución de salud?
        </h2>
        <p class="text-xl text-teal-100 mb-8 max-w-2xl mx-auto">
          Contáctenos para una consulta personalizada sobre sus necesidades tecnológicas
        </p>
        <a 
          href="/contacto" 
          class="inline-flex items-center px-8 py-4 bg-white text-teal-600 font-bold rounded-xl hover:bg-teal-50 transition-colors duration-200 shadow-xl hover:shadow-2xl transform hover:-translate-y-1"
        >
          Solicitar Consultoría
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </main>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
