---
import Layout from '../layouts/Layout.astro';
import { directus, DEFAULT_IMAGE } from '../utils/directus';
import { generateSlug } from '../utils/slugUtils';

// Configuración SEO específica para constructoras - ULTRA OPTIMIZADA para Argentina y Mendoza
const seoConfig = {
  title: "Tecnología IT Constructoras Mendoza Argentina | PROCON LAUGGERO KRISTICH | Infraestructura Obras",
  description: "⛑️ Especialistas en infraestructura IT para constructoras en Mendoza y Argentina. Sistemas tecnológicos completos para PROCON, LAUGGERO, KRISTICH. Redes estructuradas, comunicaciones IP, seguridad CCTV y control de accesos para obras y canteros. +50 proyectos documentados, 20+ años de experiencia. Soporte 24/7.",
  keywords: "constructoras mendoza, infraestructura IT constructoras argentina, tecnología para obras mendoza, PROCON mendoza IT, LAUGGERO constructoras tecnología, KRISTICH infraestructura, redes estructuradas constructoras, cableado certificado obras, comunicaciones IP constructoras, CCTV obras mendoza, control accesos biométrico canteros, seguridad electrónica construccion, telefonía IP obras, conectividad temporal canteros, sistemas gestión constructora, IT construcción argentina, tecnología oficinas técnicas, servidores construccion, redes wifi obras, integración tecnológica constructoras mendoza",
  ogImage: "/images/constructoras-hero.jpg",
  canonical: "https://www.ultimamilla.com.ar/constructoras",
  locale: "es_AR",
  region: "AR-M",
  author: "Ultima Milla",
  robots: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
};

// Cargar antecedentes del sector constructoras
let antecedentes = [];
let serviciosRelacionados = [];
let error = null;

try {
  // Obtener antecedentes de constructoras desde Directus
  const response = await directus.getAntecedentes({
    limit: 500,
    page: 1
  });

  if (response && response.data && response.data.length > 0) {
    // Filtrar antecedentes de salud (solo Hospital)
    antecedentes = response.data
      .filter(item => 
        item.Cliente?.toLowerCase().includes('hospital')
      )
      .map(item => ({
        ...item,
        slug: `${item.id}/${generateSlug(item.Titulo)}`
      }))
      .sort((a, b) => new Date(b.Fecha) - new Date(a.Fecha));

    console.log(`✅ Cargados ${antecedentes.length} antecedentes de salud`);
  }

  // Servicios relacionados con el sector constructoras
  // Structured Data para SEO
  const structuredData = {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Infraestructura IT para Constructoras",
    "provider": {
      "@type": "Organization",
      "name": "Ultima Milla",
      "url": "https://www.ultimamilla.com.ar",
      "logo": "https://www.ultimamilla.com.ar/images/um-logo.png",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Mendoza",
        "addressRegion": "Mendoza",
        "addressCountry": "AR"
      }
    },
    "areaServed": [
      {
        "@type": "City",
        "name": "Mendoza"
      },
      {
        "@type": "Country",
        "name": "Argentina"
      }
    ],
    "audience": {
      "@type": "BusinessAudience",
      "name": "Constructoras y Empresas de Construcción"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Servicios IT para Constructoras",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Cableado Estructurado para Obras"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Sistemas de Seguridad CCTV y Control de Accesos"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Conectividad Temporal para Canteros"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Telefonía IP Empresarial"
          }
        }
      ]
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "50"
    }
  };

  serviciosRelacionados = [
    {
      id: 1,
      nombre: "Cableado Estructurado para Obras",
      descripcion: "HIS, EMR y sistemas de gestión hospitalaria integrados",
      icon: "network",
      slug: "cableado-estructurado-obras"
    },
    {
      id: 2,
      nombre: "Sistemas de Seguridad y Control",
      descripcion: "Sistemas de comunicación integrados para hospitales y clínicas para obras",
      icon: "shield",
      slug: "sistemas-seguridad-control"
    },
    {
      id: 3,
      nombre: "Conectividad Temporal",
      descripcion: "Protección de información médica sensible y privacidad en construcción",
      icon: "wifi",
      slug: "conectividad-temporal"
    },
    {
      id: 4,
      nombre: "Telefonía IP Empresarial",
      descripcion: "Asistencia técnica especializada para sistemas médicos y canteros",
      icon: "phone",
      slug: "telefonia-ip"
    },
    {
      id: 5,
      nombre: "Sistemas de Detección de Incendios",
      descripcion: "Detección temprana y alarmas para protección de obras",
      icon: "alert",
      slug: "deteccion-incendios"
    },
    {
      id: 6,
      nombre: "Soporte Técnico 24/7",
      descripcion: "Mantenimiento preventivo y correctivo para operaciones continuas",
      icon: "support",
      slug: "soporte-tecnico"
    }
  ];
} catch (err) {
  console.error('Error cargando antecedentes:', err);
  error = err;
}

// Función para obtener imagen del antecedente
import { buscarImagenPorDatos } from '../data/mapeo_imagenes_completo';

function getImageUrl(proyecto) {
  if (!proyecto) return DEFAULT_IMAGE;

  // Si ya viene con imagen desde Directus (URL completa o path)
  if (proyecto.Imagen && (proyecto.Imagen.startsWith('/imagenes_') || proyecto.Imagen.startsWith('http'))) {
    return proyecto.Imagen;
  }

  const imagenNombre = buscarImagenPorDatos(
    proyecto.Cliente,
    proyecto.Area || proyecto.Unidad_de_negocio,
    proyecto.Titulo,
    proyecto.id
  );
  return imagenNombre 
    ? `/imagenes_antecedentes_versionproduccion/${imagenNombre}`
    : DEFAULT_IMAGE;
}

const antecedentesConImagenes = antecedentes.map(proyecto => ({
  ...proyecto,
  imageUrl: getImageUrl(proyecto)
}));
---

<Layout
