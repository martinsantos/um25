---
import Layout from '../layouts/Layout.astro';
import { directus, DEFAULT_IMAGE } from '../utils/directus';
import { generateSlug } from '../utils/slugUtils';

// Configuración SEO específica para Salud - ULTRA OPTIMIZADA para Argentina y Mendoza
const seoConfig = {
  title: "Tecnología para Clínicas y Hospitales Mendoza | Sistemas Médicos Seguros | ULTIMA MILLA",
  description: "Soluciones IT para instituciones de salud: redes hospitalarias, seguridad de datos médicos, telecomunicaciones críticas y cumplimiento normativo en Mendoza.",
  keywords: "servicios tecnologicos salud, infraestructura hospitales mendoza cuyo, redes medicas patagonia, telecomunicaciones hospitalarias, corrientes debiles clinicas, historia clinica electronica, seguridad datos pacientes",
  ogImage: "/images/services/seguridad-informatica.jpg",
  canonical: "https://ultimamilla.com.ar/salud",
  locale: "es_AR",
  region: "Cuyo, Patagonia, Argentina",
  author: "Ultima Milla",
  robots: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
};

// Cargar antecedentes del sector salud
import { antecedentesReales } from '../data/antecedentes_completos.js';
import AntecedentesGridMobileOptimized from '../components/AntecedentesGridMobileOptimized.astro';

let antecedentes = [];
let serviciosRelacionados = [];
let error = null;

const keywords = [
  'hospital', 'clinica', 'sanatorio', 'centro medico', 'centro de salud',
  'osep', 'osde', 'swiss medical', 'galeno', 'omint', 'sancor salud',
  'obra social', 'prepaga', 'atencion medica',
  'perrupato', 'lagomaggiore', 'italiano', 'español', 'frances',
  'notti', 'heller', 'schestakow', 'lencinas', 'paroissien',
  'fuesmen', 'fundacion escuela', 'diagnostic', 'imagen',
  'laboratorio', 'farmacia', 'drogueria', 'medicamento',
  'ambulancia', 'emergencia', 'trauma', 'quirofano'
];

const filterAntecedentes = (data) => {
  return data.filter(item => {
    const cliente = (item.Cliente || '').toLowerCase();
    const titulo = (item.Titulo || '').toLowerCase();
    const area = (item.Area || '').toLowerCase();
    return keywords.some(k => cliente.includes(k) || titulo.includes(k) || area.includes(k));
  }).map(item => ({
    ...item,
    Nombre: item.Titulo,
    mapeo_imagenes_completo: item.Imagen,
    slug: `${item.id}/${generateSlug(item.Titulo)}`
  })).sort((a, b) => new Date(b.Fecha || '2000-01-01') - new Date(a.Fecha || '2000-01-01'));
};

try {
  // Obtener antecedentes de salud desde Directus
  const response = await directus.getAntecedentes({
    limit: 500,
    page: 1
  });

  if (response && response.data && response.data.length > 0) {
    antecedentes = filterAntecedentes(response.data);
    console.log(`✅ Cargados ${antecedentes.length} antecedentes de salud`);
  }
} catch (err) {
  console.error('Error cargando antecedentes:', err);
  error = err;
}

// Fallback a datos locales si no hay resultados de API
if (antecedentes.length === 0) {
  console.log('Usando antecedentes locales para Salud');
  antecedentes = filterAntecedentes(antecedentesReales);
}

