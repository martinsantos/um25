  'hospital', 'clinica', 'sanatorio', 'centro medico', 'centro de salud',
  'osep', 'osde', 'swiss medical', 'galeno', 'omint', 'sancor salud',
  'obra social', 'prepaga', 'atencion medica',
  'perrupato', 'lagomaggiore', 'italiano', 'español', 'frances',
  'notti', 'heller', 'schestakow', 'lencinas', 'paroissien',
  'fuesmen', 'fundacion escuela', 'diagnostic', 'imagen',
  'laboratorio', 'farmacia', 'drogueria', 'medicamento',
  'ambulancia', 'emergencia', 'trauma', 'quirofano'
];

const filterAntecedentes = (data) => {
  return data.filter(item => {
    const cliente = (item.Cliente || '').toLowerCase();
    const titulo = (item.Titulo || '').toLowerCase();
    const area = (item.Area || '').toLowerCase();
    return keywords.some(k => cliente.includes(k) || titulo.includes(k) || area.includes(k));
  }).sort((a, b) => new Date(b.Fecha || '2000-01-01') - new Date(a.Fecha || '2000-01-01'));
};

try {
  // Obtener antecedentes de salud desde Directus
  const response = await directus.getAntecedentes({
    limit: 500,
    page: 1
  });

  if (response && response.data && response.data.length > 0) {
    antecedentes = filterAntecedentes(response.data);
    console.log(`✅ Cargados ${antecedentes.length} antecedentes de salud`);
  }
} catch (err) {
  console.error('Error cargando antecedentes:', err);
  error = err;
}

// Fallback a datos locales si no hay resultados de API
if (antecedentes.length === 0) {
  console.log('Usando antecedentes locales para Salud');
  antecedentes = filterAntecedentes(antecedentesReales);
}

