---
/**
 * Sala de control (prototipo de portada, 2026-10-29). La película ocupa toda la pantalla y la
 * navegación vive adentro: las etiquetas que siguen a los equipos son los enlaces a cada
 * sistema; los ocho sistemas son canales que sintonizan el recorrido de ese sistema en el lugar
 * actual; los cinco lugares son el carrete de abajo y los capítulos que siguen al bajar.
 * Motor de película y etiquetas: el mismo del banner actual (/cine/cine-banner-accessible-2910.js).
 * Textos: sólo frases ya existentes en el sitio y datos del catálogo. No indexable.
 */
import '../styles/cine-banner.css';
import ContactForm from '../components/cine/ContactForm.astro';
import { getAntecedentes } from '../lib/um26-directus';
import { getAntecedenteSectorLabel } from '../utils/antecedenteSectorPresentation';
import { getAntecedentesCatalogCount } from '../utils/verifiedProof';
import { NAV_SERVICES } from '../data/navigation';
import { HOME_SCENES, SECTORS, SCENE_TITLES, V4_CUTS, type Scene } from '../data/cine/scenes';

export const prerender = false;

const catalog = await getAntecedentes({ limit: 1000 });
const total = getAntecedentesCatalogCount();

const thumbOf = (image: string) =>
  /^\/images\/antecedentes\/generated\/.+-principal\.webp$/.test(image) ? image.replace(/-principal\.webp$/, '-principal-480.webp') : image;
const cleanText = (value: unknown) => String(value ?? '').replace(/\b(Rubro|Cliente|Sector|Área|Area)\s*:\s*/gi, '').replace(/\s*(\.{3}|…)\s*$/u, '').replace(/\s+/g, ' ').trim();
const clientCase = (client: string) => client === client.toUpperCase()
  ? client.toLowerCase().replace(/(^|\s)(\S)/g, (m: string) => m.toUpperCase()).replace(/\b(De|Del|La|Las|Los|Y|E|Sa|Srl)\b/g, (w: string) => (/^(Sa|Srl)$/.test(w) ? w.toUpperCase() : w.toLowerCase()))
  : client;
const cleanTitle = (raw: unknown, client: string) => {
  let title = cleanText(raw);
  if (title.includes('|')) title = title.split('|')[0].trim() || title;
  const suffix = ` - ${client}`.toLowerCase();
  if (client && title.toLowerCase().endsWith(suffix)) title = title.slice(0, -suffix.length).trim();
  return title.replace(/\s*\(\d+\)\s*$/, '').replace(/\s+-\s+/g, ' · ');
};
const cases = [...catalog]
  .sort((a, b) => (b.year - a.year) || (b.month - a.month) || (b.id - a.id))
  .map((item) => {
    const client = clientCase(cleanText(item.client));
    return { href: `/antecedentes/${item.id}/${item.slug}`, client, title: cleanTitle(item.title, client), year: item.year, sector: item.sector_slug, sectorLabel: getAntecedenteSectorLabel(item.sector_slug) || '', codes: item.service_codes.map(String), image: item.image && item.image.startsWith('/images/antecedentes/') ? thumbOf(item.image) : '' };
  });

// Lugares (las cinco escenas) con sus sectores, sus obras con foto y su cuenta.
const places = HOME_SCENES.map((s) => {
  const sectors = SECTORS.filter((row) => row.scene === s.scene).map((row) => row.slug);
  const mine = cases.filter((c) => sectors.includes(c.sector));
  return { scene: s.scene, name: s.name, text: s.text, title: SCENE_TITLES[s.scene], sectors, count: mine.length, proof: mine.filter((c) => c.image).slice(0, 3), href: `/${s.sector}` };
});
const scenes = places.map((p) => p.scene);
// Recorridos por escena y por sistema (clave "<escena>-<sistema>"), como los usa el motor.
const SERVICE_KEY: Record<string, string> = { '101': 'redes', '102': 'seguridad', '103': 'telecom', '104': 'software', '105': 'soporte', '106': 'consultoria', '107': 'incendios', '108': 'electricos' };
const SERVICE_COLOR: Record<string, string> = { '101': '#2bb3d6', '102': '#e0679f', '103': '#a07ae0', '104': '#6f9be6', '105': '#9aa3ad', '106': '#9aa3ad', '107': '#ef5a44', '108': '#d9a23a' };
const variants = Object.fromEntries(scenes.map((scene) => [scene, Object.keys(V4_CUTS).filter((k) => k.startsWith(`${scene}-`))]));
const variantsAttr = Object.entries(variants).map(([s, v]) => `${s}:${v.join('|')}`).join(';');
const posterFor = (key: string) => V4_CUTS[key]?.poster?.replace(/\.jpg$/, '.avif') || `/cine/media/cine-${key.split('-')[0]}-poster.avif`;
const fallbacks = Object.fromEntries([...scenes, ...Object.values(variants).flat()].map((key) => [key, posterFor(key)]));
const channels = NAV_SERVICES.map((s) => ({ code: s.code, name: s.name, text: s.text, href: s.href, key: SERVICE_KEY[s.code], color: SERVICE_COLOR[s.code], count: cases.filter((c) => c.codes.includes(s.code)).length }));
const start = Math.floor(Math.random() * scenes.length);
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Sala de control · Prototipo | ULTIMA MILLA</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/um-sans/v2.0.0/UMSans2-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/um-sans/v2.0.0/um-sans.css" />
  </head>
  <body>
    <!-- Sala: la película, con el motor del banner actual y un HUD mínimo encima -->
    <section class="sala umc umc--home" data-umc data-scenes={scenes.join(',')} data-scene={scenes[start]} data-start={start} data-variants={variantsAttr} data-fallbacks={JSON.stringify(fallbacks)} data-channel="" aria-label="Sala de control">
      <div class="umc-stage" aria-hidden="true">
        <img class="umc-poster" src={fallbacks[scenes[start]]} data-default={fallbacks[scenes[start]]} alt="" width="1920" height="1080" fetchpriority="high" decoding="async" />
        <video class="umc-video" muted playsinline preload="none" disablepictureinpicture></video>
        <video class="umc-video" muted playsinline preload="none" disablepictureinpicture></video>
        <div class="sala__grade"></div>
        <div class="umc-ar"></div>
      </div>

      <header class="hud hud--top">
        <a class="hud__logo" href="/">ultimamilla<i>.</i>com<i>.</i>ar</a>
        <p class="hud__status">
          <span><b class="num">{total}</b> proyectos documentados</span>
          <span>Más de 22 años de servicios IT</span>
          <span>Mendoza <b class="num" data-clock>--:--</b></span>
          <span>Soporte 24/7</span>
        </p>
      </header>

      <!-- Canales: los ocho sistemas. Sintonizar uno cambia el recorrido y deja sólo sus etiquetas. -->
      <nav class="hud hud--channels" aria-label="Sistemas">
        <p class="hud__label">Sistemas</p>
        <ol class="channels">
          {channels.map((c) => (
            <li>
              <button type="button" class="channel" data-channel-code={c.code} data-channel-key={c.key} style={`--c:${c.color}`} aria-pressed="false">
                <i></i><b>{c.name}</b><em class="num">{c.count}</em>
                <a class="channel__go" href={c.href} aria-label={`Abrir ${c.name}`}>→</a>
              </button>
            </li>
          ))}
        </ol>
      </nav>

      <div class="hud hud--copy">
        <h1>Servicios IT para operaciones que no pueden detenerse<span class="umc-dot">.</span></h1>
        <a class="umc-btn" href="/contacto">Pedir un relevamiento<span aria-hidden="true">↗</span></a>
      </div>

      <div class="umc-foot hud hud--foot">
        <div class="umc-rail" role="group" aria-label="Lugares">
          {places.map((p, i) => (
            <button type="button" data-umc-scene={p.scene} data-title={p.title} aria-pressed={i === start ? 'true' : 'false'}>
              <span class="umc-rail__t">{p.name}<small>{p.text}</small></span>
              <i class="umc-rail__bar"><b></b></i>
            </button>
          ))}
        </div>
        <p class="umc-caption" data-umc-caption>{places[start].title}</p>
        <div class="umc-tools">
          <button class="umc-tool umc-tool--icon" type="button" data-umc-motion aria-label="Pausar el recorrido">
            <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14"/></svg>
            <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5v14l12-7L7 5Z"/></svg>
          </button>
        </div>
      </div>
    </section>

    <!-- Capítulos: al bajar, cada lugar sintoniza su escena en la sala, que queda fija atrás. -->
    <main class="chapters">
      {places.map((p) => (
        <section class="chapter" data-chapter={p.scene} aria-labelledby={`ch-${p.scene}`}>
          <div class="chapter__panel">
            <p class="chapter__kicker">{p.title}</p>
            <h2 id={`ch-${p.scene}`}>Lo que ya instalamos en {p.name.toLowerCase()}.</h2>
            <p class="chapter__text">{p.text}</p>
            <ul class="chapter__proof">
              {p.proof.map((c) => (
                <li><a href={c.href}><img src={c.image} alt="" width="480" height="300" loading="lazy" decoding="async" /><b>{c.client}</b><span>{c.title}</span><em>{[c.sectorLabel, c.year].filter(Boolean).join(' · ')}</em></a></li>
              ))}
            </ul>
            <a class="chapter__all" href={p.href}>Ver los {p.count} proyectos <span aria-hidden="true">→</span></a>
          </div>
        </section>
      ))}

      <section class="chapter chapter--contact" aria-labelledby="ch-contacto">
        <div class="chapter__panel chapter__panel--wide">
          <h2 id="ch-contacto">Contanos qué tiene que seguir funcionando.</h2>
          <p class="chapter__text">Indicá qué necesitás, dónde y para cuándo. Un técnico te responde por email con el próximo paso: diagnóstico, relevamiento, propuesta o documentación.</p>
          <ContactForm />
          <p class="chapter__direct">contacto@ultimamilla.com.ar · Houssay 1159, Guaymallén, Mendoza · Lunes a viernes, 8 a 18 h</p>
        </div>
      </section>
    </main>
    <script src="/cine/cine-banner-accessible-2910.js" type="module" is:inline></script>
  </body>
</html>

<style is:global>
  :root { --font: var(--um-font-family, 'UM Sans 2', 'UM Sans 1.2 Compatibility', Arial, system-ui, sans-serif); --ink: #07080a; --red: #dc2626; --gutter: clamp(16px, 3vw, 40px); }
  * { box-sizing: border-box; }
  html { background: var(--ink); color: #fff; font-family: var(--font); font-synthesis: none; -webkit-font-smoothing: antialiased; }
  body { margin: 0; font-size: 1rem; line-height: 1.5; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  :focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  .num { font-variant-numeric: tabular-nums; }
  h1, h2 { margin: 0; letter-spacing: -.02em; text-wrap: balance; }

  /* La sala: pantalla completa y fija; los capítulos se deslizan por encima. */
  .sala.umc { position: sticky; top: 0; z-index: 0; min-height: 100svh; height: 100svh; display: block; }
  .sala .umc-stage { left: 0; right: 0; }
  .sala__grade { position: absolute; inset: 0; pointer-events: none; background: linear-gradient(180deg, rgba(7,8,10,.55) 0%, transparent 22%), linear-gradient(0deg, rgba(7,8,10,.85) 0%, rgba(7,8,10,.45) 22%, transparent 48%), linear-gradient(90deg, rgba(7,8,10,.5) 0%, transparent 30%); }
  .hud { position: absolute; z-index: 3; }
  .hud--top { left: var(--gutter); right: var(--gutter); top: 18px; display: flex; justify-content: space-between; align-items: center; gap: 24px; }
  .hud__logo { font-weight: 600; font-size: 1.25rem; letter-spacing: -.02em; }
  .hud__logo i { font-style: normal; color: var(--red); }
  .hud__status { margin: 0; display: flex; gap: 22px; color: rgba(255,255,255,.78); }
  .hud__status b { font-weight: 600; color: #fff; }
  .hud__status span + span::before { content: '·'; margin-right: 22px; color: rgba(255,255,255,.4); }

  .hud--channels { right: var(--gutter); top: 50%; transform: translateY(-50%); width: min(300px, 26vw); }
  .hud__label { margin: 0 0 8px; color: rgba(255,255,255,.6); }
  .channels { list-style: none; margin: 0; padding: 0; border-top: 1px solid rgba(255,255,255,.18); }
  .channel { position: relative; display: grid; grid-template-columns: 10px minmax(0, 1fr) auto; gap: 12px; align-items: center; width: 100%; min-height: 44px; padding: 7px 0; border-bottom: 1px solid rgba(255,255,255,.18); text-align: left; color: rgba(255,255,255,.72); transition: color .2s ease; }
  .channel i { width: 10px; height: 10px; background: var(--c); opacity: .55; transition: opacity .2s ease, box-shadow .2s ease; }
  .channel b { font-weight: 600; }
  .channel em { font-style: normal; color: rgba(255,255,255,.5); }
  .channel:hover, .channel[aria-pressed="true"] { color: #fff; }
  .channel[aria-pressed="true"] i { opacity: 1; box-shadow: 0 0 0 3px color-mix(in srgb, var(--c) 35%, transparent); }
  .channel__go { position: absolute; right: 0; top: 50%; transform: translateY(-50%); width: 44px; height: 44px; display: grid; place-items: center; opacity: 0; color: #fff; transition: opacity .2s ease; }
  .channel[aria-pressed="true"] .channel__go, .channel:hover .channel__go { opacity: 1; }
  .channel[aria-pressed="true"] em, .channel:hover em { opacity: 0; }
  /* Con un canal sintonizado, sólo quedan a la vista las etiquetas de ese sistema. */
  .sala[data-channel="101"] .umc-tag:not([href*="/servicios/101/"]), .sala[data-channel="102"] .umc-tag:not([href*="/servicios/102/"]), .sala[data-channel="103"] .umc-tag:not([href*="/servicios/103/"]), .sala[data-channel="104"] .umc-tag:not([href*="/servicios/104/"]), .sala[data-channel="107"] .umc-tag:not([href*="/servicios/107/"]), .sala[data-channel="108"] .umc-tag:not([href*="/servicios/108/"]) { opacity: 0 !important; pointer-events: none !important; }
  /* Etiquetas: más presentes, son la navegación. */
  .sala .umc-tag__card { max-width: 300px; padding: 11px 14px 12px; background: rgba(8,10,13,.82); }
  .sala .umc-tag__card small { font-size: 1rem; letter-spacing: 0; text-transform: none; color: var(--c); font-weight: 600; }
  .sala .umc-tag__card strong { font-size: 1.0625rem; }
  .sala .umc-tag__card::after { content: '→'; display: block; margin-top: 2px; color: rgba(255,255,255,.7); }

  .hud--copy { left: var(--gutter); bottom: 150px; max-width: min(640px, 50vw); transition: opacity .35s ease; }
  .sala.is-reading .hud--copy { opacity: 0; pointer-events: none; }
  .hud--copy h1 { font-size: clamp(1.75rem, 2.8vw, 2.6rem); line-height: 1.06; font-weight: 700; text-shadow: 0 2px 30px rgba(0,0,0,.4); }
  .hud--copy .umc-btn { margin-top: 20px; }

  .sala .umc-foot { position: absolute; left: var(--gutter); right: var(--gutter); bottom: 0; margin: 0 0 22px; z-index: 3; }
  .sala .umc-caption { flex: none; }

  /* Capítulos */
  /* Los capítulos se deslizan sobre la sala; fuera de sus paneles no bloquean el HUD. */
  .chapters { position: relative; z-index: 2; margin-top: -100svh; padding-top: 100svh; pointer-events: none; }
  .chapter__panel { pointer-events: auto; }
  .chapter { min-height: 100svh; display: flex; align-items: flex-end; padding: 0 var(--gutter) clamp(32px, 6vh, 72px); }
  .chapter__panel { width: min(680px, 100%); padding: clamp(20px, 3vw, 32px); background: rgba(7,8,10,.82); border: 1px solid rgba(255,255,255,.14); backdrop-filter: blur(14px); }
  .chapter__panel--wide { width: min(880px, 100%); }
  .chapter__kicker { margin: 0 0 8px; color: rgba(255,255,255,.62); }
  .chapter h2 { font-size: clamp(1.6rem, 2.6vw, 2.25rem); line-height: 1.1; font-weight: 600; }
  .chapter__text { margin: 10px 0 0; color: rgba(255,255,255,.8); }
  .chapter__proof { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 14px; list-style: none; margin: 20px 0 0; padding: 0; }
  .chapter__proof a { display: grid; gap: 6px; min-width: 0; }
  .chapter__proof img { display: block; width: 100%; aspect-ratio: 16 / 10; object-fit: cover; background: #15181c; }
  .chapter__proof b { font-weight: 600; line-height: 1.3; }
  .chapter__proof span { color: rgba(255,255,255,.72); line-height: 1.35; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .chapter__proof em { font-style: normal; color: rgba(255,255,255,.5); }
  .chapter__proof a:hover b { text-decoration: underline; text-decoration-color: var(--red); text-underline-offset: 3px; }
  .chapter__all { display: inline-block; margin-top: 18px; font-weight: 600; text-decoration: underline; text-decoration-color: var(--red); text-underline-offset: 4px; }
  .chapter__direct { margin: 18px 0 0; color: rgba(255,255,255,.62); }
  .chapter--contact { align-items: flex-start; padding-top: 88px; }

  @media (max-width: 1100px) { .hud--channels { width: min(260px, 30vw); } }
  @media (max-width: 820px) {
    /* Teléfono: el HUD fluye en columna sobre la escena (barra, copia, sistemas, carrete), sin superposiciones. */
    .sala.umc { display: flex; flex-direction: column; justify-content: flex-end; padding: 16px var(--gutter) 14px; }
    .sala .umc-stage { bottom: 0; height: auto; }
    .hud { position: static; transform: none; width: auto; margin: 0; }
    .hud--top { position: absolute; left: var(--gutter); right: var(--gutter); top: 16px; }
    .hud__status span:not(:first-child) { display: none; }
    .hud--copy { order: 1; max-width: none; margin-bottom: 18px; }
    .hud--copy h1 { font-size: 1.6rem; }
    .hud--copy .umc-btn { margin-top: 12px; min-height: 44px; }
    .hud--channels { order: 2; margin-bottom: 14px; }
    .hud__label { display: none; }
    .channels { display: flex; gap: 8px; overflow-x: auto; scrollbar-width: none; border: 0; padding-bottom: 4px; }
    .channels::-webkit-scrollbar { display: none; }
    .channels li { flex: none; }
    .channel { grid-template-columns: 8px auto; gap: 8px; padding: 6px 12px; border: 1px solid rgba(255,255,255,.25); border-bottom-width: 1px; background: rgba(7,8,10,.55); white-space: nowrap; }
    .channel em, .channel__go { display: none; }
    .sala .umc-foot { order: 3; position: static; margin: 0; }
    .chapter__proof { grid-template-columns: 1fr 1fr; }
    .chapter__proof li:nth-child(3) { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .channel, .channel i, .channel__go { transition: none; } }
</style>

<script>
  const sala = document.querySelector<HTMLElement>('.sala')!;
  const channels = [...sala.querySelectorAll<HTMLButtonElement>('[data-channel-code]')];
  const rail = [...sala.querySelectorAll<HTMLButtonElement>('[data-umc-scene]')];
  let channel = '';

  // Reloj de Mendoza en el HUD: hora real, sin segundos.
  const clock = sala.querySelector<HTMLElement>('[data-clock]');
  const tick = () => { if (clock) clock.textContent = new Intl.DateTimeFormat('es-AR', { hour: '2-digit', minute: '2-digit', hourCycle: 'h23', timeZone: 'America/Argentina/Mendoza' }).format(new Date()); };
  tick(); setInterval(tick, 15000);

  // Sintonizar un canal: el recorrido de ese sistema en el lugar actual; de nuevo, lo apaga.
  const currentScene = () => sala.dataset.scene || rail.find((b) => b.getAttribute('aria-pressed') === 'true')?.dataset.umcScene || '';
  const tune = (code: string) => {
    channel = channel === code ? '' : code;
    sala.dataset.channel = channel;
    channels.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.channelCode === channel)));
    const key = channels.find((b) => b.dataset.channelCode === channel)?.dataset.channelKey;
    const scene = currentScene().split('-')[0];
    sala.dispatchEvent(new CustomEvent('umc:cut', { detail: key ? `${scene}-${key}` : scene }));
  };
  channels.forEach((b) => b.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('.channel__go')) return; tune(b.dataset.channelCode!); }));

  // Al cambiar de lugar (carrete o capítulo), el canal sintonizado se mantiene.
  const keepChannel = () => { if (!channel) return; const key = channels.find((b) => b.dataset.channelCode === channel)?.dataset.channelKey; setTimeout(() => sala.dispatchEvent(new CustomEvent('umc:cut', { detail: `${currentScene().split('-')[0]}-${key}` })), 450); };
  rail.forEach((b) => b.addEventListener('click', keepChannel));

  // Capítulos: cuando uno entra en pantalla, la sala sintoniza su lugar.
  // Sin película en marcha (teléfono con datos, o antes de que arranque), el lugar cambia con su póster.
  const fallbacks = JSON.parse(sala.dataset.fallbacks || '{}') as Record<string, string>;
  const poster = sala.querySelector<HTMLImageElement>('.umc-poster')!;
  const caption = sala.querySelector<HTMLElement>('[data-umc-caption]')!;
  const playing = () => Boolean(sala.querySelector('.umc-video.is-on'));
  const showScene = (scene: string) => {
    const target = rail.find((b) => b.dataset.umcScene === scene);
    if (!target) return;
    if (playing()) { if (target.getAttribute('aria-pressed') !== 'true') target.click(); return; }
    const key = channels.find((b) => b.dataset.channelCode === channel)?.dataset.channelKey;
    const cut = key && fallbacks[`${scene}-${key}`] ? `${scene}-${key}` : scene;
    poster.src = fallbacks[cut] || poster.src;
    poster.classList.remove('is-hidden');
    sala.dataset.scene = scene;
    rail.forEach((b) => b.setAttribute('aria-pressed', String(b === target)));
    const name = channels.find((b) => b.dataset.channelCode === channel)?.querySelector('b')?.textContent;
    caption.textContent = `${target.dataset.title || ''}${name ? ` · ${name}` : ''}`;
  };
  channels.forEach((b) => b.addEventListener('click', () => { if (!playing()) showScene(currentScene().split('-')[0]); }));

  const chapters = [...document.querySelectorAll<HTMLElement>('[data-chapter]')];
  const io = new IntersectionObserver((entries) => {
    entries.forEach((e) => { if (e.isIntersecting) showScene(e.target.getAttribute('data-chapter') || ''); });
  }, { threshold: 0.55 });
  chapters.forEach((c) => io.observe(c));
  // Mientras se leen los capítulos, la copia del encabezado se retira; los controles quedan.
  const onScroll = () => sala.classList.toggle('is-reading', window.scrollY > window.innerHeight * 0.35);
  addEventListener('scroll', onScroll, { passive: true }); onScroll();
</script>
