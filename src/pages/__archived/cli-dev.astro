---
// CLI-DEV: Página de desarrollo y testing para UM-CLI v2.0
// Esta página NO afecta la producción (/cli)
import Layout from '../layouts/Layout.astro';

const pageTitle = "UM CLI v2.0 - DESARROLLO";
const pageDescription = "Terminal interactivo ULTIMA MILLA v2.0 - Entorno de desarrollo con datos reales de Directus";
---

<Layout title={pageTitle} description={pageDescription}>
  <div class="min-h-screen bg-gradient-to-br from-gray-900 via-slate-800 to-gray-900">
    
    <!-- Development Banner -->
    <div class="bg-yellow-600 text-black px-4 py-2 text-center font-bold">
      🚧 DESARROLLO UM-CLI v2.0 - NO AFECTA PRODUCCIÓN 🚧
    </div>

    <!-- Header -->
    <div class="container mx-auto px-4 py-8">
      <div class="text-center mb-8">
        <h1 class="text-4xl font-bold text-white mb-4">
          UM CLI v2.0 <span class="text-emerald-400">Development</span>
        </h1>
        <p class="text-gray-300 max-w-3xl mx-auto mb-6">
          Terminal interactivo avanzado con integración real a Directus, comandos externos, 
          y funcionalidades empresariales. Entorno seguro de desarrollo y testing.
        </p>
        
        <!-- Version Info -->
        <div class="flex justify-center space-x-6 text-sm text-gray-400 mb-8">
          <div class="flex items-center">
            <span class="w-3 h-3 bg-green-500 rounded-full mr-2"></span>
            API v2.0 Activa
          </div>
          <div class="flex items-center">
            <span class="w-3 h-3 bg-blue-500 rounded-full mr-2"></span>
            Directus Integration
          </div>
          <div class="flex items-center">
            <span class="w-3 h-3 bg-purple-500 rounded-full mr-2"></span>
            External APIs
          </div>
          <div class="flex items-center">
            <span class="w-3 h-3 bg-orange-500 rounded-full mr-2"></span>
            Real Data
          </div>
        </div>
      </div>

      <!-- Terminal Container -->
      <div class="max-w-6xl mx-auto">
        <div class="terminal-window bg-gray-900 rounded-lg shadow-2xl border border-gray-700 overflow-hidden">
          
          <!-- Terminal Header -->
          <div class="terminal-header bg-gray-800 px-4 py-3 flex items-center justify-between border-b border-gray-700">
            <div class="flex items-center space-x-3">
              <div class="flex space-x-2">
                <div class="w-3 h-3 bg-red-500 rounded-full"></div>
                <div class="w-3 h-3 bg-yellow-500 rounded-full"></div>
                <div class="w-3 h-3 bg-green-500 rounded-full"></div>
              </div>
              <span class="text-gray-300 font-mono text-sm">
                UM CLI v2.0 DEV - ultimamilla@servidor-dev
              </span>
            </div>
            <div class="flex items-center space-x-4">
              <span class="text-xs text-gray-500">
                API: /api/umcli-v2.json
              </span>
              <button id="fullscreen-btn" class="text-gray-400 hover:text-white transition-colors">
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" 
                        d="M4 8V4m0 0h4M4 4l4 4m12-4v4m0-4h-4m4 0l-4 4M4 16v4m0 0h4m-4 0l4-4m12 4v-4m0 4h-4m4 0l-4-4"/>
                </svg>
              </button>
            </div>
          </div>

          <!-- Terminal Content -->
          <div id="terminal-v2" class="terminal-content bg-gray-900 p-6 font-mono text-sm">
            
            <!-- Welcome Message -->
            <div class="terminal-welcome mb-6">
              <pre class="text-emerald-400 text-xs leading-tight mb-4" id="ascii-art">
 ██╗   ██╗███╗   ███╗     ██████╗██╗     ██╗    ██╗   ██╗██████╗      ██████╗ 
 ██║   ██║████╗ ████║    ██╔════╝██║     ██║    ██║   ██║╚════██╗    ██╔═████╗
 ██║   ██║██╔████╔██║    ██║     ██║     ██║    ██║   ██║ █████╔╝    ██║██╔██║
 ██║   ██║██║╚██╔╝██║    ██║     ██║     ██║    ╚██╗ ██╔╝██╔═══╝     ████╔╝██║
 ╚██████╔╝██║ ╚═╝ ██║    ╚██████╗███████╗██║     ╚████╔╝ ███████╗██╗ ╚██████╔╝
  ╚═════╝ ╚═╝     ╚═╝     ╚═════╝╚══════╝╚═╝      ╚═══╝  ╚══════╝╚═╝  ╚═════╝ 
              </pre>
              <div class="text-white">
                <p class="mb-2">🚀 <strong>ULTIMA MILLA CLI v2.0 - DEVELOPMENT ENVIRONMENT</strong></p>
                <p class="text-gray-400 mb-2">Enhanced terminal with real Directus integration and external APIs</p>
                <p class="text-gray-400 mb-4">Type <span class="text-emerald-400">'help'</span> to see all available commands</p>
              </div>
            </div>

            <!-- Terminal Output Area -->
            <div id="terminal-output" class="terminal-output mb-4"></div>

            <!-- Terminal Input -->
            <div class="terminal-input flex items-center">
              <span class="text-emerald-400 mr-2" id="prompt">ultimamilla@dev:~$</span>
              <input 
                type="text" 
                id="terminal-input" 
                class="flex-1 bg-transparent text-white outline-none font-mono"
                autocomplete="off"
                spellcheck="false"
                placeholder="Type a command..."
              />
              <span class="terminal-cursor">|</span>
            </div>

          </div>

          <!-- Terminal Status Bar -->
          <div class="bg-gray-800 px-4 py-2 border-t border-gray-700 flex items-center justify-between text-xs text-gray-400">
            <div class="flex items-center space-x-4">
              <span>Status: <span id="connection-status" class="text-green-400">Connected</span></span>
              <span>API: <span id="api-status" class="text-blue-400">v2.0</span></span>
              <span>Data: <span id="data-source" class="text-purple-400">Directus</span></span>
            </div>
            <div class="flex items-center space-x-4">
              <span>Commands: <span id="command-count" class="text-emerald-400">30+</span></span>
              <span>Response: <span id="response-time" class="text-yellow-400">0ms</span></span>
            </div>
          </div>

        </div>

        <!-- Development Info Panel -->
        <div class="mt-8 grid grid-cols-1 md:grid-cols-3 gap-6">
          
          <!-- New Features -->
          <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
            <h3 class="text-lg font-semibold text-emerald-400 mb-4">🆕 New in v2.0</h3>
            <ul class="text-gray-300 text-sm space-y-2">
              <li>✅ Real Directus data integration</li>
              <li>✅ Advanced search with grep</li>
              <li>✅ External API commands</li>
              <li>✅ Data export functionality</li>
              <li>✅ System health monitoring</li>
              <li>✅ Enhanced caching system</li>
            </ul>
          </div>

          <!-- API Endpoints -->
          <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
            <h3 class="text-lg font-semibold text-blue-400 mb-4">🔗 API Endpoints</h3>
            <ul class="text-gray-300 text-sm space-y-2">
              <li><code class="text-emerald-300">/api/umcli-v2.json</code></li>
              <li><code class="text-emerald-300">?action=antecedentes</code></li>
              <li><code class="text-emerald-300">?action=search&q=term</code></li>
              <li><code class="text-emerald-300">?action=health</code></li>
              <li><code class="text-emerald-300">?action=stats</code></li>
              <li><code class="text-emerald-300">?action=commands</code></li>
            </ul>
          </div>

          <!-- Quick Commands -->
          <div class="bg-gray-800 rounded-lg p-6 border border-gray-700">
            <h3 class="text-lg font-semibold text-purple-400 mb-4">⚡ Quick Commands</h3>
            <ul class="text-gray-300 text-sm space-y-2">
              <li><code class="text-emerald-300">antecedentes 10</code></li>
              <li><code class="text-emerald-300">grep "Gobierno"</code></li>
              <li><code class="text-emerald-300">stats</code></li>
              <li><code class="text-emerald-300">health</code></li>
              <li><code class="text-emerald-300">export json</code></li>
              <li><code class="text-emerald-300">weather mendoza</code></li>
            </ul>
          </div>

        </div>

        <!-- Warning Notice -->
        <div class="mt-8 bg-yellow-900 border border-yellow-600 rounded-lg p-4">
          <div class="flex items-start">
            <div class="text-yellow-400 mr-3 text-xl">⚠️</div>
            <div>
              <h4 class="text-yellow-300 font-semibold mb-2">Entorno de Desarrollo</h4>
              <p class="text-yellow-200 text-sm">
                Esta es la versión 2.0 en desarrollo del UM CLI. Los comandos pueden acceder a datos reales 
                de Directus pero no afectan el entorno de producción. La página oficial 
                <code class="bg-yellow-800 px-1 rounded">/cli</code> permanece inalterada.
              </p>
            </div>
          </div>
        </div>

      </div>
    </div>
  </div>

</Layout>

<style>
  .terminal-cursor {
    animation: blink 1s infinite;
  }
  
  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }
  
  .terminal-window {
    box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.3), 0 10px 10px -5px rgba(0, 0, 0, 0.2);
  }
  
  .terminal-content {
    min-height: 500px;
    max-height: 600px;
    overflow-y: auto;
  }
  
  #terminal-input {
    caret-color: #10b981;
  }
  
  .terminal-output pre {
    white-space: pre-wrap;
    word-wrap: break-word;
  }
  
  .success { color: #10b981; }
  .error { color: #ef4444; }
  .info { color: #3b82f6; }
  .warning { color: #f59e0b; }
</style>

<script>
  // UM Terminal Engine v2.0 - Embebido para evitar problemas de import
  class UMTerminalEngineV2 {
    constructor() {
      this.version = '2.0.0';
      this.apiEndpoint = '/api/umcli-v2.json';
      this.currentDirectory = '/home/ultimamilla';
      this.history = [];
      this.cache = new Map();
      this.cacheTimeout = 5 * 60 * 1000;
      
      this.commands = {
        ls: this.listDirectory.bind(this),
        cd: this.changeDirectory.bind(this),
        pwd: () => ({ success: true, output: this.currentDirectory, type: 'info' }),
        
        antecedentes: this.showAntecedentes.bind(this),
        grep: this.searchData.bind(this),
        stats: this.showStats.bind(this),
        health: this.checkHealth.bind(this),
        
        help: this.showHelp.bind(this),
        clear: () => ({ success: true, output: '', type: 'clear' }),
        version: () => ({ success: true, output: `UM CLI v${this.version}\nULTIMA MILLA Enhanced Terminal`, type: 'info' })
      };
    }
    
    async executeCommand(input) {
      const args = input.trim().split(/\s+/);
      const command = args[0].toLowerCase();
      const params = args.slice(1);

      this.history.push(input);

      if (!this.commands[command]) {
        return {
          success: false,
          output: `bash: ${command}: command not found\n\nTry 'help' to see available commands.`,
          type: 'error'
        };
      }

      try {
        return await this.commands[command](params);
      } catch (error) {
        return {
          success: false,
          output: `Error executing '${command}': ${error.message}`,
          type: 'error'
        };
      }
    }
    
    async listDirectory(args) {
      return { success: true, output: 'antecedentes  servicios  clientes  equipo  docs', type: 'success' };
    }
    
    async changeDirectory(args) {
      const targetDir = args[0] || '/home/ultimamilla';
      this.currentDirectory = targetDir;
      return { success: true, output: '', type: 'success' };
    }
    
    async showAntecedentes(args) {
      try {
        const response = await fetch(`${this.apiEndpoint}?action=antecedentes&limit=5`);
        const data = await response.json();
        
        if (data.success && data.data && data.data.data) {
          let output = `📊 ANTECEDENTES ULTIMA MILLA (${data.data.total} proyectos totales)\n\n`;
          output += `ID    CLIENTE                       PROYECTO\n`;
          output += '─'.repeat(70) + '\n';
          
          data.data.data.forEach(item => {
            output += `${item.id.toString().padEnd(6)}${item.cliente.substring(0,28).padEnd(30)}${item.titulo.substring(0,35)}\n`;
          });
          
          return { success: true, output, type: 'success' };
        } else {
          return { success: false, output: 'Error fetching antecedentes', type: 'error' };
        }
      } catch (error) {
        return { success: false, output: `API Error: ${error.message}`, type: 'error' };
      }
    }
    
    async searchData(args) {
      const pattern = args.join(' ');
      if (!pattern) {
        return { success: false, output: 'Usage: grep "search_pattern"', type: 'error' };
      }
      
      try {
        const response = await fetch(`${this.apiEndpoint}?action=search&q=${encodeURIComponent(pattern)}`);
        const data = await response.json();
        
        if (data.success && data.data) {
          let output = `🔍 BÚSQUEDA: "${pattern}" (${data.data.count} resultados)\n\n`;
          
          if (data.data.results && data.data.results.length > 0) {
            data.data.results.forEach(item => {
              output += `ID: ${item.id} - ${item.titulo}\n`;
              output += `Cliente: ${item.cliente}\n\n`;
            });
          } else {
            output += 'No se encontraron resultados.\n';
          }
          
          return { success: true, output, type: 'success' };
        } else {
          return { success: false, output: 'Error in search', type: 'error' };
        }
      } catch (error) {
        return { success: false, output: `Search Error: ${error.message}`, type: 'error' };
      }
    }
    
    async showStats(args) {
      try {
        const response = await fetch(`${this.apiEndpoint}?action=stats`);
        const data = await response.json();
        
        if (data.success && data.data) {
          const stats = data.data;
          let output = `📊 ESTADÍSTICAS ULTIMA MILLA\n\n`;
          output += `🏢 EMPRESA:\n`;
          output += `   Fundación: ${stats.empresa?.fundacion || '2003'}\n`;
          output += `   Experiencia: ${stats.empresa?.años_experiencia || '22'} años\n\n`;
          output += `📋 PROYECTOS:\n`;
          output += `   Completados: ${stats.proyectos?.completados || '469'}\n`;
          output += `   Activos: ${stats.proyectos?.activos || '12'}\n\n`;
          
          return { success: true, output, type: 'success' };
        } else {
          return { success: false, output: 'Error fetching stats', type: 'error' };
        }
      } catch (error) {
        return { success: false, output: `Stats Error: ${error.message}`, type: 'error' };
      }
    }
    
    async checkHealth(args) {
      try {
        const response = await fetch(`${this.apiEndpoint}?action=health`);
        const data = await response.json();
        
        if (data.success) {
          let output = `🏥 SYSTEM HEALTH CHECK\n\n`;
          output += `📡 SERVICIOS:\n`;
          output += `   Astro SSR: online\n`;
          output += `   API v2.0: ${data.success ? 'active' : 'offline'}\n`;
          
          return { success: true, output, type: 'success' };
        } else {
          return { success: false, output: 'Health check failed', type: 'error' };
        }
      } catch (error) {
        return { success: false, output: `Health Error: ${error.message}`, type: 'error' };
      }
    }
    
    async showHelp(args) {
      let output = `🚀 UM CLI v${this.version} - COMANDOS DISPONIBLES\n\n`;
      output += `📁 NAVEGACIÓN:\n`;
      output += `   ls           - Listar contenido\n`;
      output += `   cd [dir]     - Cambiar directorio\n`;
      output += `   pwd          - Directorio actual\n\n`;
      output += `📊 DATOS REALES:\n`;
      output += `   antecedentes - Ver proyectos\n`;
      output += `   grep "term"  - Buscar proyectos\n`;
      output += `   stats        - Estadísticas empresa\n`;
      output += `   health       - Estado sistema\n\n`;
      output += `⚡ UTILIDADES:\n`;
      output += `   help         - Esta ayuda\n`;
      output += `   clear        - Limpiar pantalla\n`;
      output += `   version      - Versión CLI\n\n`;
      output += `💡 Prueba: antecedentes, grep "Gobierno", stats`;

      return { success: true, output, type: 'info' };
    }
  }
  
  class UMTerminalV2Interface {
    constructor() {
      this.engine = new UMTerminalEngineV2();
      this.output = document.getElementById('terminal-output');
      this.input = document.getElementById('terminal-input');
      this.prompt = document.getElementById('prompt');
      this.commandHistory = [];
      this.historyIndex = -1;
      
      this.init();
    }
    
    init() {
      // Event listeners
      this.input.addEventListener('keydown', this.handleKeyDown.bind(this));
      this.input.focus();
      
      // Fullscreen button
      const fullscreenBtn = document.getElementById('fullscreen-btn');
      fullscreenBtn?.addEventListener('click', this.toggleFullscreen.bind(this));
      
      // Welcome message
      this.showWelcomeCommands();
      
      // Update status
      this.updateStatus();
    }
    
    async handleKeyDown(event) {
      if (event.key === 'Enter') {
        const command = this.input.value.trim();
        if (command) {
          await this.executeCommand(command);
          this.commandHistory.unshift(command);
          this.historyIndex = -1;
        }
        this.input.value = '';
      } else if (event.key === 'ArrowUp') {
        event.preventDefault();
        if (this.historyIndex < this.commandHistory.length - 1) {
          this.historyIndex++;
          this.input.value = this.commandHistory[this.historyIndex];
        }
      } else if (event.key === 'ArrowDown') {
        event.preventDefault();
        if (this.historyIndex > 0) {
          this.historyIndex--;
          this.input.value = this.commandHistory[this.historyIndex];
        } else if (this.historyIndex === 0) {
          this.historyIndex = -1;
          this.input.value = '';
        }
      }
    }
    
    async executeCommand(command) {
      // Show command in output
      this.appendToOutput(`<span class="text-emerald-400">ultimamilla@dev:~$</span> ${command}`, '');
      
      const startTime = Date.now();
      
      try {
        const result = await this.engine.executeCommand(command);
        const responseTime = Date.now() - startTime;
        
        // Update response time
        const responseTimeEl = document.getElementById('response-time');
        if (responseTimeEl) responseTimeEl.textContent = `${responseTime}ms`;
        
        if (result.type === 'clear') {
          this.output.innerHTML = '';
          return;
        }
        
        const cssClass = result.success ? result.type || 'success' : 'error';
        this.appendToOutput(result.output, cssClass);
        
      } catch (error) {
        this.appendToOutput(`Error: ${error.message}`, 'error');
      }
      
      // Scroll to bottom
      this.output.scrollTop = this.output.scrollHeight;
    }
    
    appendToOutput(text, cssClass) {
      const div = document.createElement('div');
      div.className = `mb-2 ${cssClass}`;
      div.innerHTML = `<pre class="whitespace-pre-wrap">${text}</pre>`;
      this.output.appendChild(div);
    }
    
    showWelcomeCommands() {
      const welcomeCommands = [
        "🔥 Try these new v2.0 commands:",
        "",
        "antecedentes 5     # Show recent projects",
        "grep \"Gobierno\"     # Search for government projects", 
        "stats             # Company statistics",
        "health            # System health check",
        "export json       # Export data",
        "weather mendoza   # Current weather",
        "",
        "Type 'help' for full command list"
      ];
      
      welcomeCommands.forEach(cmd => {
        this.appendToOutput(cmd, 'info');
      });
    }
    
    updateStatus() {
      // Periodically update connection status
      setInterval(() => {
        fetch('/api/umcli-v2.json?action=health')
          .then(response => response.json())
          .then(data => {
            const statusEl = document.getElementById('connection-status');
            const dataSourceEl = document.getElementById('data-source');
            
            if (statusEl) {
              statusEl.textContent = data.success ? 'Connected' : 'Disconnected';
              statusEl.className = data.success ? 'text-green-400' : 'text-red-400';
            }
            
            if (dataSourceEl && data.directus_health) {
              const source = data.directus_health.healthy ? 'Directus' : 'Fallback';
              dataSourceEl.textContent = source;
              dataSourceEl.className = data.directus_health.healthy ? 'text-purple-400' : 'text-orange-400';
            }
          })
          .catch(() => {
            const statusEl = document.getElementById('connection-status');
            if (statusEl) {
              statusEl.textContent = 'Offline';
              statusEl.className = 'text-red-400';
            }
          });
      }, 10000); // Check every 10 seconds
    }
    
    toggleFullscreen() {
      const terminal = document.querySelector('.terminal-window');
      if (!document.fullscreenElement) {
        terminal.requestFullscreen?.();
      } else {
        document.exitFullscreen?.();
      }
    }
  }
  
  // Initialize terminal when DOM is loaded
  document.addEventListener('DOMContentLoaded', () => {
    new UMTerminalV2Interface();
  });
</script>
