---
// CLI Mobile Perfect - Diseño móvil perfecto para UM-CLI v2.0
import Layout from '../layouts/Layout.astro';
import UMTerminalMobilePerfect from '../components/UMTerminalMobilePerfect.astro';
---

<Layout 
  title="UM CLI v2.0 Mobile Perfect - ULTIMA MILLA" 
  description="Terminal interactivo móvil perfecto - ULTIMA MILLA v2.0 con diseño sticky optimizado para smartphones"
>
  <main class="mobile-cli-page">
    <!-- Mobile Perfect Terminal -->
    <UMTerminalMobilePerfect />
    
    <!-- Content that scrolls below -->
    <section class="content-below">
      <div class="container">
        <h2>Contenido adicional</h2>
        <p>Este contenido se desplaza naturalmente debajo del terminal.</p>
        
        <div class="feature-cards">
          <div class="feature-card">
            <h3>🚀 Comandos Avanzados</h3>
            <p>Más de 30 comandos disponibles para explorar nuestros servicios y proyectos.</p>
          </div>
          
          <div class="feature-card">
            <h3>📊 Datos Reales</h3>
            <p>Conectado directamente con Directus CMS para mostrar información actualizada.</p>
          </div>
          
          <div class="feature-card">
            <h3>🔍 Búsquedas</h3>
            <p>Sistema de grep integrado para buscar en nuestros 469+ proyectos.</p>
          </div>
        </div>
        
        <div class="cta-section">
          <h3>¿Listo para comenzar?</h3>
          <p>Regresa al terminal arriba y prueba estos comandos:</p>
          <ul>
            <li><code>help</code> - Ver todos los comandos</li>
            <li><code>antecedentes</code> - Explorar proyectos</li>
            <li><code>stats</code> - Ver estadísticas</li>
          </ul>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
.mobile-cli-page {
  background: linear-gradient(180deg, #0a0a0a 0%, #1a1a2e 50%, #16213e 100%);
  min-height: 200vh;
}

.content-below {
  background: linear-gradient(180deg, #16213e 0%, #0f1419 100%);
  padding: 60px 0;
  color: #e6e6e6;
}

.container {
  max-width: 1200px;
  margin: 0 auto;
  padding: 0 20px;
}

.content-below h2 {
  text-align: center;
  color: #64ffda;
  font-size: 2.5rem;
  margin-bottom: 2rem;
  font-weight: 700;
}

.content-below p {
  text-align: center;
  color: #8892b0;
  font-size: 1.1rem;
  margin-bottom: 3rem;
  max-width: 600px;
  margin-left: auto;
  margin-right: auto;
}

.feature-cards {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
  gap: 2rem;
  margin-bottom: 4rem;
}

.feature-card {
  background: rgba(26, 26, 46, 0.6);
  border: 1px solid rgba(100, 255, 218, 0.2);
  border-radius: 12px;
  padding: 2rem;
  text-align: center;
  transition: all 0.3s ease;
}

.feature-card:hover {
  transform: translateY(-5px);
  box-shadow: 0 10px 30px rgba(100, 255, 218, 0.1);
  border-color: rgba(100, 255, 218, 0.4);
}

.feature-card h3 {
  color: #64ffda;
  font-size: 1.3rem;
  margin-bottom: 1rem;
}

.feature-card p {
  color: #e6e6e6;
  font-size: 1rem;
  text-align: left;
  margin-bottom: 0;
}

.cta-section {
  text-align: center;
  background: rgba(0, 0, 0, 0.3);
  border-radius: 12px;
  padding: 3rem;
  border: 1px solid rgba(100, 255, 218, 0.2);
}

.cta-section h3 {
  color: #64ffda;
  font-size: 1.8rem;
  margin-bottom: 1rem;
}

.cta-section p {
  color: #8892b0;
  margin-bottom: 2rem;
}

.cta-section ul {
  list-style: none;
  padding: 0;
  display: flex;
  flex-direction: column;
  gap: 1rem;
  max-width: 400px;
  margin: 0 auto;
}

.cta-section li {
  background: rgba(100, 255, 218, 0.1);
  border: 1px solid rgba(100, 255, 218, 0.2);
  border-radius: 8px;
  padding: 1rem;
  font-family: 'Fira Code', monospace;
}

.cta-section code {
  color: #64ffda;
  font-weight: 600;
}

/* Mobile Responsive */
@media (max-width: 768px) {
  .container {
    padding: 0 15px;
  }
  
  .content-below h2 {
    font-size: 2rem;
  }
  
  .feature-cards {
    grid-template-columns: 1fr;
    gap: 1.5rem;
  }
  
  .feature-card {
    padding: 1.5rem;
  }
  
  .cta-section {
    padding: 2rem;
  }
  
  .cta-section ul {
    gap: 0.8rem;
  }
  
  .cta-section li {
    padding: 0.8rem;
  }
}
</style>

<script>
// Scroll to top functionality for mobile
document.addEventListener('DOMContentLoaded', function() {
  // Add smooth scroll behavior
  const links = document.querySelectorAll('a[href^="#"]');
  links.forEach(link => {
    link.addEventListener('click', function(e) {
      e.preventDefault();
      const target = document.querySelector(this.getAttribute('href'));
      if (target) {
        target.scrollIntoView({ behavior: 'smooth' });
      }
    });
  });
});
</script>
