---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
---
<Layout title="Desarrollo de Software - Versión Ultimate | ULTIMA MILLA">
<style>
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
@keyframes rotate3D{0%,100%{transform:rotateY(0deg)}50%{transform:rotateY(180deg)}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-15px)}}
@keyframes glow{0%,100%{box-shadow:0 0 20px rgba(139,92,246,.3)}50%{box-shadow:0 0 40px rgba(139,92,246,.6)}}
@keyframes gradientShift{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
.dev-card{transition:all .4s cubic-bezier(.4,0,.2,1);transform-style:preserve-3d}
.dev-card:hover{transform:translateY(-8px) rotateX(5deg);box-shadow:0 20px 40px rgba(0,0,0,.3),0 0 30px rgba(139,92,246,.2)}
input::placeholder,textarea::placeholder{color:#64748b}
</style>

<section style="position:relative;min-height:650px;background:linear-gradient(135deg,#1e1b4b 0%,#0f172a 50%,#4c1d95 100%);color:white;overflow:hidden">
<div style="position:absolute;inset:0;opacity:.04;background-image:url('data:image/svg+xml,%3Csvg width=%2260%22 height=%2260%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cpath d=%22M30 0L60 30L30 60L0 30z%22 fill=%22%238b5cf6%22/%3E%3C/svg%3E')"></div>
<div style="position:absolute;top:-100px;left:-100px;width:700px;height:700px;background:radial-gradient(circle,rgba(139,92,246,.2) 0%,transparent 70%);filter:blur(100px);animation:float 8s ease-in-out infinite"></div>
<div style="max-width:1400px;margin:0 auto;padding:140px 40px 80px;position:relative;z-index:10;text-align:center">
<div style="display:inline-flex;align-items:center;gap:10px;padding:10px 24px;background:rgba(139,92,246,.15);border:1px solid rgba(139,92,246,.3);border-radius:50px;margin-bottom:32px">
<div style="width:8px;height:8px;background:#8b5cf6;border-radius:50%;animation:pulse 2s ease-in-out infinite"></div>
<span style="font-size:13px;font-weight:700;color:#c4b5fd;text-transform:uppercase;letter-spacing:1.5px">Desarrollo Custom Ultimate</span>
</div>
<h1 style="font-size:clamp(52px,7vw,80px);font-weight:900;line-height:1.05;margin-bottom:32px;letter-spacing:-.03em;background:linear-gradient(135deg,#ffffff 0%,#c4b5fd 50%,#8b5cf6 100%);background-size:300% 300%;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;animation:gradientShift 8s ease infinite">Software a Medida para su Negocio</h1>
<p style="font-size:22px;line-height:1.7;color:#cbd5e1;margin-bottom:48px;max-width:800px;margin-left:auto;margin-right:auto">Soluciones personalizadas que se adaptan perfectamente a sus necesidades empresariales con tecnología de vanguardia</p>
<a href="#servicios" style="display:inline-flex;align-items:center;gap:12px;padding:20px 40px;background:linear-gradient(135deg,#8b5cf6,#6d28d9);color:white;font-weight:700;font-size:17px;border-radius:12px;text-decoration:none;box-shadow:0 12px 45px rgba(139,92,246,.4);animation:glow 3s ease-in-out infinite">Explorar Servicios<svg style="width:20px;height:20px" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg></a>
</div>
</section>

<section id="servicios" style="background:#0f172a;padding:100px 40px">
<div style="max-width:1400px;margin:0 auto">
<h2 style="font-size:clamp(40px,5vw,56px);font-weight:900;color:white;margin-bottom:60px;text-align:center">Nuestros Servicios de Desarrollo</h2>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:32px">
<div class="dev-card" style="background:linear-gradient(135deg,rgba(139,92,246,.05) 0%,rgba(15,23,42,.5) 100%);border:1px solid rgba(139,92,246,.2);border-radius:24px;padding:48px;text-align:center">
<div style="width:80px;height:80px;background:linear-gradient(135deg,#8b5cf6,#6d28d9);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;animation:rotate3D 4s ease-in-out infinite"><span style="font-size:36px">🌐</span></div>
<h3 style="font-size:26px;font-weight:800;color:white;margin-bottom:16px">Desarrollo Web</h3>
<p style="font-size:16px;color:#94a3b8;line-height:1.7">Sitios y aplicaciones web modernas, responsivas y escalables con las últimas tecnologías</p>
</div>
<div class="dev-card" style="background:linear-gradient(135deg,rgba(139,92,246,.05) 0%,rgba(15,23,42,.5) 100%);border:1px solid rgba(139,92,246,.2);border-radius:24px;padding:48px;text-align:center">
<div style="width:80px;height:80px;background:linear-gradient(135deg,#8b5cf6,#6d28d9);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;animation:rotate3D 4s ease-in-out infinite .5s"><span style="font-size:36px">📱</span></div>
<h3 style="font-size:26px;font-weight:800;color:white;margin-bottom:16px">Aplicaciones Móviles</h3>
<p style="font-size:16px;color:#94a3b8;line-height:1.7">Apps nativas y multiplataforma para iOS y Android con UX excepcional</p>
</div>
<div class="dev-card" style="background:linear-gradient(135deg,rgba(139,92,246,.05) 0%,rgba(15,23,42,.5) 100%);border:1px solid rgba(139,92,246,.2);border-radius:24px;padding:48px;text-align:center">
<div style="width:80px;height:80px;background:linear-gradient(135deg,#8b5cf6,#6d28d9);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;animation:rotate3D 4s ease-in-out infinite 1s"><span style="font-size:36px">💼</span></div>
<h3 style="font-size:26px;font-weight:800;color:white;margin-bottom:16px">Software Empresarial</h3>
<p style="font-size:16px;color:#94a3b8;line-height:1.7">Sistemas de gestión y automatización que optimizan tus procesos</p>
</div>
<div class="dev-card" style="background:linear-gradient(135deg,rgba(139,92,246,.05) 0%,rgba(15,23,42,.5) 100%);border:1px solid rgba(139,92,246,.2);border-radius:24px;padding:48px;text-align:center">
<div style="width:80px;height:80px;background:linear-gradient(135deg,#8b5cf6,#6d28d9);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 24px;animation:rotate3D 4s ease-in-out infinite 1.5s"><span style="font-size:36px">🔗</span></div>
<h3 style="font-size:26px;font-weight:800;color:white;margin-bottom:16px">APIs y Microservicios</h3>
<p style="font-size:16px;color:#94a3b8;line-height:1.7">Integración y desarrollo de servicios escalables y seguros</p>
</div>
</div>
</div>
</section>

<section style="background:linear-gradient(180deg,#0f172a 0%,#1e293b 100%);padding:100px 40px">
<div style="max-width:1200px;margin:0 auto">
<h2 style="font-size:clamp(40px,5vw,56px);font-weight:900;color:white;margin-bottom:60px;text-align:center">Stack Tecnológico Avanzado</h2>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:32px">
<div style="background:linear-gradient(135deg,rgba(6,182,212,.05) 0%,rgba(15,23,42,.5) 100%);border:1px solid rgba(6,182,212,.2);border-radius:16px;padding:32px;text-align:center;transform-style:preserve-3d;transition:all .4s ease" onmouseover="this.style.transform='translateY(-8px) rotateX(5deg)';this.style.boxShadow='0 20px 40px rgba(6,182,212,.2)'" onmouseout="this.style.transform='translateY(0) rotateX(0)';this.style.boxShadow='none'">
<div style="width:60px;height:60px;background:linear-gradient(135deg,#06b6d4,#0ea5e9);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;animation:rotate3D 4s ease-in-out infinite"><span style="font-size:28px">⚛️</span></div>
<h3 style="font-size:20px;font-weight:800;color:white;margin-bottom:12px">React / Next.js</h3>
<p style="font-size:15px;color:#94a3b8;line-height:1.6">Frontend moderno con SSR</p>
</div>
<div style="background:linear-gradient(135deg,rgba(139,92,246,.05) 0%,rgba(15,23,42,.5) 100%);border:1px solid rgba(139,92,246,.2);border-radius:16px;padding:32px;text-align:center;transform-style:preserve-3d;transition:all .4s ease" onmouseover="this.style.transform='translateY(-8px) rotateX(-5deg)';this.style.boxShadow='0 20px 40px rgba(139,92,246,.2)'" onmouseout="this.style.transform='translateY(0) rotateX(0)';this.style.boxShadow='none'">
<div style="width:60px;height:60px;background:linear-gradient(135deg,#8b5cf6,#6d28d9);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;animation:rotate3D 4s ease-in-out infinite .5s"><span style="font-size:28px">🟢</span></div>
<h3 style="font-size:20px;font-weight:800;color:white;margin-bottom:12px">Node.js / Express</h3>
<p style="font-size:15px;color:#94a3b8;line-height:1.6">Backend escalable y rápido</p>
</div>
<div style="background:linear-gradient(135deg,rgba(16,185,129,.05) 0%,rgba(15,23,42,.5) 100%);border:1px solid rgba(16,185,129,.2);border-radius:16px;padding:32px;text-align:center;transform-style:preserve-3d;transition:all .4s ease" onmouseover="this.style.transform='translateY(-8px) rotateX(3deg)';this.style.boxShadow='0 20px 40px rgba(16,185,129,.2)'" onmouseout="this.style.transform='translateY(0) rotateX(0)';this.style.boxShadow='none'">
<div style="width:60px;height:60px;background:linear-gradient(135deg,#10b981,#059669);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;animation:rotate3D 4s ease-in-out infinite 1s"><span style="font-size:28px">🗄️</span></div>
<h3 style="font-size:20px;font-weight:800;color:white;margin-bottom:12px">PostgreSQL / MongoDB</h3>
<p style="font-size:15px;color:#94a3b8;line-height:1.6">Bases de datos avanzadas</p>
</div>
<div style="background:linear-gradient(135deg,rgba(251,146,60,.05) 0%,rgba(15,23,42,.5) 100%);border:1px solid rgba(251,146,60,.2);border-radius:16px;padding:32px;text-align:center;transform-style:preserve-3d;transition:all .4s ease" onmouseover="this.style.transform='translateY(-8px) rotateX(-3deg)';this.style.boxShadow='0 20px 40px rgba(251,146,60,.2)'" onmouseout="this.style.transform='translateY(0) rotateX(0)';this.style.boxShadow='none'">
<div style="width:60px;height:60px;background:linear-gradient(135deg,#fb923c,#ea580c);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;animation:rotate3D 4s ease-in-out infinite 1.5s"><span style="font-size:28px">🎨</span></div>
<h3 style="font-size:20px;font-weight:800;color:white;margin-bottom:12px">TypeScript / GraphQL</h3>
<p style="font-size:15px;color:#94a3b8;line-height:1.6">Desarrollo tipado y APIs modernas</p>
</div>
<div style="background:linear-gradient(135deg,rgba(239,68,68,.05) 0%,rgba(15,23,42,.5) 100%);border:1px solid rgba(239,68,68,.2);border-radius:16px;padding:32px;text-align:center;transform-style:preserve-3d;transition:all .4s ease" onmouseover="this.style.transform='translateY(-8px) rotateX(4deg)';this.style.boxShadow='0 20px 40px rgba(239,68,68,.2)'" onmouseout="this.style.transform='translateY(0) rotateX(0)';this.style.boxShadow='none'">
<div style="width:60px;height:60px;background:linear-gradient(135deg,#ef4444,#dc2626);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;animation:rotate3D 4s ease-in-out infinite 2s"><span style="font-size:28px">☁️</span></div>
<h3 style="font-size:20px;font-weight:800;color:white;margin-bottom:12px">Docker / Kubernetes</h3>
<p style="font-size:15px;color:#94a3b8;line-height:1.6">Contenedorización y orquestación</p>
</div>
<div style="background:linear-gradient(135deg,rgba(14,165,233,.05) 0%,rgba(15,23,42,.5) 100%);border:1px solid rgba(14,165,233,.2);border-radius:16px;padding:32px;text-align:center;transform-style:preserve-3d;transition:all .4s ease" onmouseover="this.style.transform='translateY(-8px) rotateX(-4deg)';this.style.boxShadow='0 20px 40px rgba(14,165,233,.2)'" onmouseout="this.style.transform='translateY(0) rotateX(0)';this.style.boxShadow='none'">
<div style="width:60px;height:60px;background:linear-gradient(135deg,#0ea5e9,#0284c7);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;animation:rotate3D 4s ease-in-out infinite 2.5s"><span style="font-size:28px">🚀</span></div>
<h3 style="font-size:20px;font-weight:800;color:white;margin-bottom:12px">CI/CD Avanzado</h3>
<p style="font-size:15px;color:#94a3b8;line-height:1.6">Pipelines automatizados con testing</p>
</div>
</div>
</div>
</section>

<section style="background:#0f172a;padding:100px 40px;border-top:1px solid rgba(255,255,255,.05)">
<div style="max-width:1000px;margin:0 auto;text-align:center">
<h2 style="font-size:clamp(36px,4vw,48px);font-weight:900;color:white;margin-bottom:24px">Desarrolle su Solución</h2>
<p style="font-size:18px;color:#94a3b8;margin-bottom:40px">Cotización sin compromiso para su proyecto personalizado</p>
<form action="/api/contact" method="POST" style="max-width:600px;margin:0 auto">
<div style="display:grid;gap:20px">
<input type="text" name="nombre" placeholder="Nombre completo" required style="padding:18px 24px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:12px;color:white;font-size:16px">
<input type="email" name="email" placeholder="Email" required style="padding:18px 24px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:12px;color:white;font-size:16px">
<textarea name="proyecto" placeholder="Describe tu proyecto de software..." rows="5" required style="padding:18px 24px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:12px;color:white;font-size:16px"></textarea>
<button type="submit" style="padding:20px;background:linear-gradient(135deg,#8b5cf6,#6d28d9);color:white;font-weight:700;font-size:18px;border-radius:12px;border:none;cursor:pointer;box-shadow:0 10px 40px rgba(139,92,246,.3);animation:glow 2s ease-in-out infinite">Solicitar Cotización</button>
</div>
</form>
</div>
</section>
</Layout>
