---
// VERSIÓN ULTIMATE - SEGURIDAD INFORMÁTICA
// INTEGRA TODOS LOS ELEMENTOS DE LOS BOCETOS + ELEMENTOS ADICIONALES
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Seguridad Informática - Versión Ultimate | ULTIMA MILLA">
  <style>
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
    @keyframes slideIn { from { width: 0; } to { width: 100%; } }
    @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-15px); } }
    @keyframes glow { 0%, 100% { box-shadow: 0 0 20px rgba(6, 182, 212, 0.3); } 50% { box-shadow: 0 0 40px rgba(6, 182, 212, 0.6); } }
    @keyframes rotate3D { 0%, 100% { transform: rotateY(0deg); } 50% { transform: rotateY(180deg); } }
    @keyframes bounceIn { 0% { opacity: 0; transform: scale(0.3); } 50% { opacity: 1; transform: scale(1.05); } 70% { transform: scale(0.9); } 100% { opacity: 1; transform: scale(1); } }
    @keyframes gradientShift { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }

    .threat-card { transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1); }
    .threat-card:hover { transform: translateY(-8px) rotateX(5deg); box-shadow: 0 20px 40px rgba(0,0,0,0.3), 0 0 30px rgba(239, 68, 68, 0.2); }
    .tech-stack { transition: all 0.3s ease; }
    .tech-stack:hover { transform: translateY(-5px) scale(1.05); }
    .timeline-item { position: relative; padding-left: 50px; margin-bottom: 40px; }
    .timeline-item::before { content: ''; position: absolute; left: 15px; top: 0; bottom: -40px; width: 2px; background: linear-gradient(to bottom, #06b6d4, #0ea5e9); }
    .timeline-item::after { content: ''; position: absolute; left: 8px; top: 15px; width: 14px; height: 14px; background: #06b6d4; border-radius: 50%; border: 3px solid #0f172a; }
    .diagram-flow { position: relative; }
    .diagram-flow::before { content: ''; position: absolute; left: 50%; top: 0; bottom: 0; width: 2px; background: linear-gradient(to bottom, #06b6d4, #0ea5e9, #10b981); transform: translateX(-50%); }
    .video-play { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 60px; height: 60px; background: rgba(6, 182, 212, 0.9); border-radius: 50%; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.3s ease; }
    .video-play:hover { background: #06b6d4; transform: translate(-50%, -50%) scale(1.1); }

    input::placeholder, textarea::placeholder { color: #64748b; }
  </style>

  <!-- HERO ULTIMATE CON ESTADÍSTICAS GRANDES -->
  <section style="position: relative; min-height: 700px; background: linear-gradient(135deg, #1e1b4b 0%, #0f172a 100%); color: white; overflow: hidden;">
    <div style="position: absolute; inset: 0; opacity: 0.05; background-image: url('data:image/svg+xml,%3Csvg width=%2260%22 height=%2260%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cpath d=%22M30 0L60 30L30 60L0 30z%22 fill=%22%2306b6d4%22/%3E%3C/svg%3E');"></div>
    <div style="position: absolute; top: -150px; right: -150px; width: 700px; height: 700px; background: radial-gradient(circle, rgba(6, 182, 212, 0.2) 0%, transparent 70%); filter: blur(100px);"></div>

    <div style="max-width: 1400px; margin: 0 auto; padding: 100px 40px; position: relative; z-index: 10;">
      <!-- Título Principal con Gradiente Animado -->
      <div style="max-width: 900px; margin-bottom: 80px;">
        <div style="display: inline-flex; align-items: center; gap: 10px; padding: 10px 24px; background: rgba(6, 182, 212, 0.15); border: 1px solid rgba(6, 182, 212, 0.3); border-radius: 50px; margin-bottom: 32px;">
          <div style="width: 8px; height: 8px; background: #06b6d4; border-radius: 50%; animation: pulse 2s ease-in-out infinite;"></div>
          <span style="font-size: 13px; font-weight: 700; color: #06b6d4; text-transform: uppercase; letter-spacing: 1.5px;">Defensa Cibernética Ultimate</span>
        </div>

        <h1 style="font-size: clamp(48px, 7vw, 72px); font-weight: 900; line-height: 1.1; margin-bottom: 28px; letter-spacing: -0.02em; background: linear-gradient(135deg, #ffffff 0%, #06b6d4 50%, #0ea5e9 100%); background-size: 300% 300%; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; animation: gradientShift 8s ease infinite;">
          Cada segundo cuenta. Previene la próxima brecha antes de que ocurra.
        </h1>

        <p style="font-size: 20px; line-height: 1.7; color: #cbd5e1; margin-bottom: 40px;">
          Visualiza el panorama de amenazas en tiempo real y descubre cómo protegemos tus activos más críticos con tecnología de vanguardia.
        </p>

        <div style="display: flex; gap: 16px; flex-wrap: wrap;">
          <a href="#quiz" style="display: inline-flex; align-items: center; gap: 12px; padding: 18px 36px; background: linear-gradient(135deg, #06b6d4, #0ea5e9); color: white; font-weight: 700; font-size: 16px; border-radius: 12px; text-decoration: none; box-shadow: 0 10px 40px rgba(6, 182, 212, 0.3); animation: glow 3s ease-in-out infinite;">
            Evaluación de Riesgo
            <svg style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
            </svg>
          </a>
          <a href="#tecnologias" style="display: inline-flex; align-items: center; gap: 12px; padding: 18px 36px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); color: white; font-weight: 700; font-size: 16px; border-radius: 12px; text-decoration: none; backdrop-filter: blur(10px);">
            Stack Tecnológico
          </a>
        </div>
      </div>

      <!-- ESTADÍSTICAS GRANDES CON ANIMACIÓN -->
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 32px;">
        <div style="background: linear-gradient(135deg, rgba(6, 182, 212, 0.1) 0%, rgba(15, 23, 42, 0.5) 100%); border: 1px solid rgba(6, 182, 212, 0.2); border-radius: 24px; padding: 40px; text-align: center; animation: bounceIn 1s ease-out;">
          <div style="font-size: 56px; font-weight: 900; color: #06b6d4; margin-bottom: 12px;">64.1M</div>
          <div style="font-size: 18px; font-weight: 700; color: white; margin-bottom: 8px;">Casos Frenados de Brecha</div>
          <div style="font-size: 14px; color: #06b6d4; font-weight: 600;">+15% vs año anterior</div>
        </div>

        <div style="background: linear-gradient(135deg, rgba(6, 182, 212, 0.1) 0%, rgba(15, 23, 42, 0.5) 100%); border: 1px solid rgba(6, 182, 212, 0.2); border-radius: 24px; padding: 40px; text-align: center; animation: bounceIn 1s ease-out 0.2s both;">
          <div style="font-size: 56px; font-weight: 900; color: #06b6d4; margin-bottom: 12px;">212</div>
          <div style="font-size: 18px; font-weight: 700; color: white; margin-bottom: 8px;">Tiempo Medio de Detección</div>
          <div style="font-size: 14px; color: #06b6d4; font-weight: 600;">-5% vs año anterior</div>
        </div>

        <div style="background: linear-gradient(135deg, rgba(6, 182, 212, 0.1) 0%, rgba(15, 23, 42, 0.5) 100%); border: 1px solid rgba(6, 182, 212, 0.2); border-radius: 24px; padding: 40px; text-align: center; animation: bounceIn 1s ease-out 0.4s both;">
          <div style="font-size: 56px; font-weight: 900; color: #06b6d4; margin-bottom: 12px;">150%</div>
          <div style="font-size: 18px; font-weight: 700; color: white; margin-bottom: 8px;">Aumento de Ransomware</div>
          <div style="font-size: 14px; color: #06b6d4; font-weight: 600;">En el último trimestre</div>
        </div>
      </div>
    </div>
  </section>

  <!-- QUIZ INTERACTIVO AVANZADO -->
  <section id="quiz" style="background: #0f172a; padding: 100px 40px; border-top: 1px solid rgba(255, 255, 255, 0.05);">
    <div style="max-width: 1200px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 80px;">
        <h2 style="font-size: clamp(40px, 5vw, 56px); font-weight: 900; color: white; margin-bottom: 24px;">
          ¿Cuál es tu Nivel de Riesgo Real?
        </h2>
        <p style="font-size: 20px; color: #94a3b8; max-width: 800px; margin: 0 auto;">
          Responde estas preguntas para obtener una evaluación completa de tu postura de seguridad
        </p>
      </div>

      <div style="max-width: 900px; margin: 0 auto; background: rgba(15, 23, 42, 0.5); border: 1px solid rgba(6, 182, 212, 0.2); border-radius: 24px; padding: 60px;">
        <!-- Pregunta 1 -->
        <div style="margin-bottom: 40px;">
          <h3 style="font-size: 24px; font-weight: 800; color: white; margin-bottom: 32px;">
            1. ¿Utiliza su organización autenticación multifactor (MFA) para todos los accesos críticos?
          </h3>
          <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px;">
            <button style="padding: 16px 24px; background: rgba(6, 182, 212, 0.1); border: 2px solid rgba(6, 182, 212, 0.3); border-radius: 12px; color: white; font-size: 16px; font-weight: 700; cursor: pointer; transition: all 0.3s; animation: bounceIn 0.8s ease-out;">
              ✓ Sí, en todo
            </button>
            <button style="padding: 16px 24px; background: rgba(255, 193, 7, 0.1); border: 2px solid rgba(255, 193, 7, 0.3); border-radius: 12px; color: white; font-size: 16px; font-weight: 700; cursor: pointer; transition: all 0.3s; animation: bounceIn 0.8s ease-out 0.1s both;">
              ⚠ Parcialmente
            </button>
            <button style="padding: 16px 24px; background: rgba(239, 68, 68, 0.1); border: 2px solid rgba(239, 68, 68, 0.3); border-radius: 12px; color: white; font-size: 16px; font-weight: 700; cursor: pointer; transition: all 0.3s; animation: bounceIn 0.8s ease-out 0.2s both;">
              ✗ No / No estoy seguro
            </button>
          </div>
        </div>

        <!-- Indicador de riesgo avanzado -->
        <div style="margin-bottom: 40px;">
          <p style="font-size: 14px; color: #94a3b8; margin-bottom: 12px; font-weight: 600;">Tu nivel de riesgo estimado:</p>
          <div style="width: 100%; height: 20px; background: rgba(255, 255, 255, 0.05); border-radius: 10px; overflow: hidden; border: 1px solid rgba(6, 182, 212, 0.2); position: relative;">
            <div style="width: 35%; height: 100%; background: linear-gradient(90deg, #06b6d4, #0ea5e9); animation: slideIn 2s ease-out; position: relative;">
              <div style="position: absolute; right: -8px; top: -4px; width: 16px; height: 28px; background: #06b6d4; border-radius: 3px; animation: pulse 1.5s ease-in-out infinite;"></div>
            </div>
          </div>
          <div style="display: flex; justify-between; margin-top: 8px;">
            <span style="font-size: 12px; color: #10b981;">BAJO</span>
            <span style="font-size: 12px; color: #06b6d4; font-weight: 700;">RIESGO MODERADO (35%)</span>
            <span style="font-size: 12px; color: #ef4444;">ALTO</span>
          </div>
        </div>

        <!-- Recomendaciones -->
        <div style="background: rgba(6, 182, 212, 0.05); border: 1px solid rgba(6, 182, 212, 0.2); border-radius: 16px; padding: 24px; margin-bottom: 40px;">
          <h4 style="font-size: 18px; font-weight: 800; color: white; margin-bottom: 16px;">Recomendaciones basadas en tu evaluación:</h4>
          <ul style="list-style: none; padding: 0;">
            <li style="padding: 8px 0; color: #94a3b8; display: flex; align-items: center; gap: 12px;">
              <div style="width: 8px; height: 8px; background: #06b6d4; border-radius: 50%; flex-shrink: 0;"></div>
              Implementar MFA en todos los accesos críticos
            </li>
            <li style="padding: 8px 0; color: #94a3b8; display: flex; align-items: center; gap: 12px;">
              <div style="width: 8px; height: 8px; background: #0ea5e9; border-radius: 50%; flex-shrink: 0;"></div>
              Realizar auditoría de vulnerabilidades trimestral
            </li>
            <li style="padding: 8px 0; color: #94a3b8; display: flex; align-items: center; gap: 12px;">
              <div style="width: 8px; height: 8px; background: #10b981; border-radius: 50%; flex-shrink: 0;"></div>
              Entrenar al equipo en seguridad cibernética
            </li>
          </ul>
        </div>

        <div style="text-align: center;">
          <a href="#contacto" style="display: inline-flex; align-items: center; gap: 10px; padding: 16px 32px; background: linear-gradient(135deg, #06b6d4, #0ea5e9); color: white; font-weight: 700; font-size: 16px; border-radius: 10px; text-decoration: none; animation: glow 2s ease-in-out infinite;">
            Obtener Plan de Seguridad Completo →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- STACK TECNOLÓGICO VISUAL -->
  <section id="tecnologias" style="background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%); padding: 100px 40px;">
    <div style="max-width: 1400px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 80px;">
        <h2 style="font-size: clamp(40px, 5vw, 56px); font-weight: 900; color: white; margin-bottom: 24px;">
          Stack Tecnológico de Vanguardia
        </h2>
        <p style="font-size: 20px; color: #94a3b8; max-width: 800px; margin: 0 auto;">
          Utilizamos las tecnologías más avanzadas para proteger tu organización
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 24px;">
        <div class="tech-stack" style="background: linear-gradient(135deg, rgba(6, 182, 212, 0.05) 0%, rgba(15, 23, 42, 0.5) 100%); border: 1px solid rgba(6, 182, 212, 0.2); border-radius: 16px; padding: 32px; text-align: center;">
          <div style="width: 60px; height: 60px; background: linear-gradient(135deg, #06b6d4, #0ea5e9); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; animation: rotate3D 4s ease-in-out infinite;">
            <span style="font-size: 28px;">🛡️</span>
          </div>
          <h3 style="font-size: 20px; font-weight: 800; color: white; margin-bottom: 12px;">AI & Machine Learning</h3>
          <p style="font-size: 15px; color: #94a3b8; line-height: 1.6;">Detección de anomalías con algoritmos avanzados</p>
        </div>

        <div class="tech-stack" style="background: linear-gradient(135deg, rgba(14, 165, 233, 0.05) 0%, rgba(15, 23, 42, 0.5) 100%); border: 1px solid rgba(14, 165, 233, 0.2); border-radius: 16px; padding: 32px; text-align: center;">
          <div style="width: 60px; height: 60px; background: linear-gradient(135deg, #0ea5e9, #0284c7); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; animation: rotate3D 4s ease-in-out infinite 0.5s;">
            <span style="font-size: 28px;">🔒</span>
          </div>
          <h3 style="font-size: 20px; font-weight: 800; color: white; margin-bottom: 12px;">Zero Trust</h3>
          <p style="font-size: 15px; color: #94a3b8; line-height: 1.6;">Arquitectura de seguridad sin confianza inherente</p>
        </div>

        <div class="tech-stack" style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.05) 0%, rgba(15, 23, 42, 0.5) 100%); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 16px; padding: 32px; text-align: center;">
          <div style="width: 60px; height: 60px; background: linear-gradient(135deg, #10b981, #059669); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; animation: rotate3D 4s ease-in-out infinite 1s;">
            <span style="font-size: 28px;">☁️</span>
          </div>
          <h3 style="font-size: 20px; font-weight: 800; color: white; margin-bottom: 12px;">Cloud Security</h3>
          <p style="font-size: 15px; color: #94a3b8; line-height: 1.6;">Protección integral en entornos cloud híbridos</p>
        </div>

        <div class="tech-stack" style="background: linear-gradient(135deg, rgba(168, 85, 247, 0.05) 0%, rgba(15, 23, 42, 0.5) 100%); border: 1px solid rgba(168, 85, 247, 0.2); border-radius: 16px; padding: 32px; text-align: center;">
          <div style="width: 60px; height: 60px; background: linear-gradient(135deg, #a855f7, #9333ea); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; animation: rotate3D 4s ease-in-out infinite 1.5s;">
            <span style="font-size: 28px;">🚀</span>
          </div>
          <h3 style="font-size: 20px; font-weight: 800; color: white; margin-bottom: 12px;">Blockchain</h3>
          <p style="font-size: 15px; color: #94a3b8; line-height: 1.6;">Registros inmutables para auditoría de seguridad</p>
        </div>

        <div class="tech-stack" style="background: linear-gradient(135deg, rgba(251, 146, 60, 0.05) 0%, rgba(15, 23, 42, 0.5) 100%); border: 1px solid rgba(251, 146, 60, 0.2); border-radius: 16px; padding: 32px; text-align: center;">
          <div style="width: 60px; height: 60px; background: linear-gradient(135deg, #fb923c, #ea580c); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; animation: rotate3D 4s ease-in-out infinite 2s;">
            <span style="font-size: 28px;">🤖</span>
          </div>
          <h3 style="font-size: 20px; font-weight: 800; color: white; margin-bottom: 12px;">Automatización</h3>
          <p style="font-size: 15px; color: #94a3b8; line-height: 1.6;">Respuesta automática a incidentes de seguridad</p>
        </div>

        <div class="tech-stack" style="background: linear-gradient(135deg, rgba(239, 68, 68, 0.05) 0%, rgba(15, 23, 42, 0.5) 100%); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 16px; padding: 32px; text-align: center;">
          <div style="width: 60px; height: 60px; background: linear-gradient(135deg, #ef4444, #dc2626); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; animation: rotate3D 4s ease-in-out infinite 2.5s;">
            <span style="font-size: 28px;">🔍</span>
          </div>
          <h3 style="font-size: 20px; font-weight: 800; color: white; margin-bottom: 12px;">Threat Intelligence</h3>
          <p style="font-size: 15px; color: #94a3b8; line-height: 1.6;">Análisis de inteligencia de amenazas global</p>
        </div>
      </div>
    </div>
  </section>

  <!-- AMENAZAS CON ICONOS 3D -->
  <section style="background: #0f172a; padding: 100px 40px; border-top: 1px solid rgba(255, 255, 255, 0.05);">
    <div style="max-width: 1400px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 80px;">
        <h2 style="font-size: clamp(40px, 5vw, 56px); font-weight: 900; color: white; margin-bottom: 24px;">
          Amenazas Cibernéticas Más Comunes
        </h2>
        <p style="font-size: 20px; color: #94a3b8; max-width: 800px; margin: 0 auto;">
          Identificamos y neutralizamos estas amenazas antes de que afecten tu negocio
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 32px;">
        <div class="threat-card" style="background: linear-gradient(135deg, rgba(239, 68, 68, 0.05) 0%, rgba(15, 23, 42, 0.5) 100%); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 24px; padding: 40px; text-align: center; position: relative; overflow: hidden;">
          <div style="position: absolute; top: -20px; right: -20px; width: 80px; height: 80px; background: rgba(239, 68, 68, 0.1); border-radius: 50%; filter: blur(20px);"></div>
          <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #ef4444, #dc2626); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px; transform-style: preserve-3d; animation: rotate3D 6s ease-in-out infinite;">
            <span style="font-size: 36px;">💰</span>
          </div>
          <h3 style="font-size: 24px; font-weight: 800; color: white; margin-bottom: 16px;">Ransomware</h3>
          <p style="font-size: 16px; color: #94a3b8; line-height: 1.7; margin-bottom: 20px;">Cifrado de datos con demanda de rescate. Causó $8.2B en pérdidas globales en 2023.</p>
          <div style="display: flex; justify-between; text-align: left; margin-top: 20px; padding-top: 20px; border-top: 1px solid rgba(239, 68, 68, 0.2);">
            <div><div style="font-size: 12px; color: #94a3b8;">INCIDENTES</div><div style="font-size: 20px; font-weight: 900; color: #ef4444;">+150%</div></div>
            <div><div style="font-size: 12px; color: #94a3b8;">COSTO MEDIO</div><div style="font-size: 20px; font-weight: 900; color: #ef4444;">$4.5M</div></div>
          </div>
        </div>

        <div class="threat-card" style="background: linear-gradient(135deg, rgba(251, 146, 60, 0.05) 0%, rgba(15, 23, 42, 0.5) 100%); border: 1px solid rgba(251, 146, 60, 0.2); border-radius: 24px; padding: 40px; text-align: center; position: relative; overflow: hidden;">
          <div style="position: absolute; top: -20px; right: -20px; width: 80px; height: 80px; background: rgba(251, 146, 60, 0.1); border-radius: 50%; filter: blur(20px);"></div>
          <div style="width: 80px; height: 80px; background: linear-gradient(135deg, #fb923c, #ea580c); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px; transform-style: preserve-3d; animation: rotate3D 6s ease-in-out infinite 1s;">
            <span style="font-size: 36px;">🎣</span>
          </div>
          <h3 style="font-size: 24px; font-weight: 800; color: white; margin-bottom: 16px;">Phishing</h3>
          <p style="font-size: 16px; color: #94a3b8; line-height: 1.7; margin-bottom: 20px;">Ataques de ingeniería social que roban credenciales y datos sensibles.</p>
          <div style="display: flex; justify-between; text-align: left; margin-top: 20px; padding-top: 20px; border-top: 1px solid rgba(251, 146, 60, 0.2);">
            <div><div style="font-size: 12px; color: #94a3b8;">EXITO</div><div style="font-size: 20px; font-weight: 900; color: #fb923c;">32%</div></div>
            <div><div style="font-size: 12px; color: #94a3b8;">TIEMPO</div><div style="font-size: 20px; font-weight: 900; color: #fb923c;">2.1 min</div></div>
          </div>
        </div>

        <div class="threat-card" style="background: linear-gradient(135deg, rgba(168, 85, 247, 0.05) 0%, rgba(15, 23, 42, 0.5) 100%); border: 1px solid rgba(168, 85, 247, 0.2); border-radius: 24px; padding: 40px; text-align: center; position: relative; overflow: hidden;">
          <div style="position: absolute; top: -20px; right: -20px; width: 80px; height: 80px; background: rgba(168, 85, 247, 0.1); border-radius: 50%; filter: blur(20px);"></div>
