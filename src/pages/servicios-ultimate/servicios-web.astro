---
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
---
<Layout title="Servicios Web - Versión Ultimate | ULTIMA MILLA">
<style>
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
@keyframes rotate3D{0%,100%{transform:rotateY(0deg)}50%{transform:rotateY(180deg)}}
@keyframes float{0%,100%{transform:translateY(0)}50%{transform:translateY(-15px)}}
@keyframes glow{0%,100%{box-shadow:0 0 20px rgba(99,102,241,.3)}50%{box-shadow:0 0 40px rgba(99,102,241,.6)}}
@keyframes gradientShift{0%{background-position:0% 50%}50%{background-position:100% 50%}100%{background-position:0% 50%}}
.tech-stack{transition:all .4s cubic-bezier(.4,0,.2,1);transform-style:preserve-3d}
.tech-stack:hover{transform:translateY(-8px) rotateX(5deg);box-shadow:0 20px 40px rgba(0,0,0,.3),0 0 30px rgba(99,102,241,.2)}
input::placeholder,textarea::placeholder{color:#64748b}
</style>

<section style="position:relative;min-height:650px;background:linear-gradient(135deg,#1e1b4b 0%,#0f172a 50%,#312e81 100%);color:white;overflow:hidden">
<div style="position:absolute;inset:0;opacity:.04;background-image:url('data:image/svg+xml,%3Csvg width=%2280%22 height=%2280%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Ccircle cx=%2240%22 cy=%2240%22 r=%222%22 fill=%22%236366f1%22/%3E%3C/svg%3E')"></div>
<div style="position:absolute;top:0;right:0;width:600px;height:600px;background:radial-gradient(circle,rgba(99,102,241,.2) 0%,transparent 70%);filter:blur(100px)"></div>
<div style="max-width:1400px;margin:0 auto;padding:140px 40px 80px;position:relative;z-index:10;text-align:center">
<div style="display:inline-flex;align-items:center;gap:10px;padding:10px 24px;background:linear-gradient(135deg,rgba(99,102,241,.15),rgba(6,182,212,.15));border:1px solid rgba(99,102,241,.3);border-radius:50px;margin-bottom:32px">
<div style="width:8px;height:8px;background:#6366f1;border-radius:50%;animation:pulse 2s ease-in-out infinite"></div>
<span style="font-size:13px;font-weight:700;color:#a5b4fc;text-transform:uppercase;letter-spacing:1.5px">Desarrollo Web Ultimate</span>
</div>
<h1 style="font-size:clamp(52px,7vw,80px);font-weight:900;line-height:1.05;margin-bottom:32px;letter-spacing:-.03em;background:linear-gradient(135deg,#ffffff 0%,#a5b4fc 50%,#06b6d4 100%);background-size:300% 300%;-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;animation:gradientShift 8s ease infinite">Experiencias Web que Convierten</h1>
<p style="font-size:22px;line-height:1.7;color:#cbd5e1;margin-bottom:48px;max-width:800px;margin-left:auto;margin-right:auto">Diseño y desarrollo de aplicaciones web modernas, rápidas y escalables con las últimas tecnologías.</p>
<a href="#tecnologias" style="display:inline-flex;align-items:center;gap:12px;padding:20px 40px;background:linear-gradient(135deg,#6366f1,#4f46e5);color:white;font-weight:700;font-size:17px;border-radius:12px;text-decoration:none;box-shadow:0 12px 45px rgba(99,102,241,.4);animation:glow 3s ease-in-out infinite">Explorar Tecnologías<svg style="width:20px;height:20px" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg></a>
</div>
</section>

<section id="tecnologias" style="background:#0f172a;padding:100px 40px">
<div style="max-width:1400px;margin:0 auto">
<h2 style="font-size:clamp(40px,5vw,56px);font-weight:900;color:white;margin-bottom:60px;text-align:center">Tecnologías de Vanguardia</h2>
<div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:24px">
<div class="tech-stack" style="background:linear-gradient(135deg,rgba(99,102,241,.05) 0%,rgba(15,23,42,.5) 100%);border:1px solid rgba(99,102,241,.2);border-radius:16px;padding:32px;text-align:center">
<div style="width:60px;height:60px;background:linear-gradient(135deg,#6366f1,#4f46e5);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;animation:rotate3D 4s ease-in-out infinite"><span style="font-size:28px">⚛️</span></div>
<h3 style="font-size:20px;font-weight:800;color:white;margin-bottom:12px">React / Next.js</h3>
<p style="font-size:15px;color:#94a3b8;line-height:1.6">Frontend moderno y escalable</p>
</div>
<div class="tech-stack" style="background:linear-gradient(135deg,rgba(6,182,212,.05) 0%,rgba(15,23,42,.5) 100%);border:1px solid rgba(6,182,212,.2);border-radius:16px;padding:32px;text-align:center">
<div style="width:60px;height:60px;background:linear-gradient(135deg,#06b6d4,#0ea5e9);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;animation:rotate3D 4s ease-in-out infinite .5s"><span style="font-size:28px">🟢</span></div>
<h3 style="font-size:20px;font-weight:800;color:white;margin-bottom:12px">Node.js / Express</h3>
<p style="font-size:15px;color:#94a3b8;line-height:1.6">Backend robusto y rápido</p>
</div>
<div class="tech-stack" style="background:linear-gradient(135deg,rgba(16,185,129,.05) 0%,rgba(15,23,42,.5) 100%);border:1px solid rgba(16,185,129,.2);border-radius:16px;padding:32px;text-align:center">
<div style="width:60px;height:60px;background:linear-gradient(135deg,#10b981,#059669);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;animation:rotate3D 4s ease-in-out infinite 1s"><span style="font-size:28px">🗄️</span></div>
<h3 style="font-size:20px;font-weight:800;color:white;margin-bottom:12px">PostgreSQL / MongoDB</h3>
<p style="font-size:15px;color:#94a3b8;line-height:1.6">Bases de datos avanzadas</p>
</div>
<div class="tech-stack" style="background:linear-gradient(135deg,rgba(168,85,247,.05) 0%,rgba(15,23,42,.5) 100%);border:1px solid rgba(168,85,247,.2);border-radius:16px;padding:32px;text-align:center">
<div style="width:60px;height:60px;background:linear-gradient(135deg,#a855f7,#9333ea);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;animation:rotate3D 4s ease-in-out infinite 1.5s"><span style="font-size:28px">☁️</span></div>
<h3 style="font-size:20px;font-weight:800;color:white;margin-bottom:12px">AWS / Azure</h3>
<p style="font-size:15px;color:#94a3b8;line-height:1.6">Cloud hosting escalable</p>
</div>
<div class="tech-stack" style="background:linear-gradient(135deg,rgba(251,146,60,.05) 0%,rgba(15,23,42,.5) 100%);border:1px solid rgba(251,146,60,.2);border-radius:16px;padding:32px;text-align:center">
<div style="width:60px;height:60px;background:linear-gradient(135deg,#fb923c,#ea580c);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;animation:rotate3D 4s ease-in-out infinite 2s"><span style="font-size:28px">🎨</span></div>
<h3 style="font-size:20px;font-weight:800;color:white;margin-bottom:12px">Tailwind CSS</h3>
<p style="font-size:15px;color:#94a3b8;line-height:1.6">Diseño responsive moderno</p>
</div>
<div class="tech-stack" style="background:linear-gradient(135deg,rgba(14,165,233,.05) 0%,rgba(15,23,42,.5) 100%);border:1px solid rgba(14,165,233,.2);border-radius:16px;padding:32px;text-align:center">
<div style="width:60px;height:60px;background:linear-gradient(135deg,#0ea5e9,#0284c7);border-radius:50%;display:flex;align-items:center;justify-content:center;margin:0 auto 20px;animation:rotate3D 4s ease-in-out infinite 2.5s"><span style="font-size:28px">🚀</span></div>
<h3 style="font-size:20px;font-weight:800;color:white;margin-bottom:12px">CI/CD</h3>
<p style="font-size:15px;color:#94a3b8;line-height:1.6">Deploy automático y testing</p>
</div>
</div>
</div>
</section>

<section style="background:linear-gradient(180deg,#0f172a 0%,#1e293b 100%);padding:100px 40px">
<div style="max-width:1200px;margin:0 auto">
<h2 style="font-size:clamp(40px,5vw,56px);font-weight:900;color:white;margin-bottom:60px;text-align:center">Nuestro Proceso de Desarrollo</h2>
<div style="display:grid;gap:32px;max-width:1000px;margin:0 auto">
<div style="display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center">
<div style="order:1"><div style="background:rgba(99,102,241,.1);border:1px solid rgba(99,102,241,.2);border-radius:16px;padding:32px"><h3 style="font-size:24px;font-weight:800;color:white;margin-bottom:12px">Fase 1: Descubrimiento</h3><p style="font-size:16px;color:#94a3b8;line-height:1.6">Entendemos tus objetivos, audiencia y requisitos técnicos.</p></div></div>
<div style="order:2;text-align:right"><div style="width:120px;height:120px;background:linear-gradient(135deg,#6366f1,#4f46e5);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:48px;font-weight:900;color:white;margin:0 auto;animation:rotate3D 6s ease-in-out infinite">01</div></div>
</div>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center">
<div style="order:2"><div style="width:120px;height:120px;background:linear-gradient(135deg,#06b6d4,#0ea5e9);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:48px;font-weight:900;color:white;margin:0 auto;animation:rotate3D 6s ease-in-out infinite 1s">02</div></div>
<div style="order:1"><div style="background:rgba(6,182,212,.1);border:1px solid rgba(6,182,212,.2);border-radius:16px;padding:32px"><h3 style="font-size:24px;font-weight:800;color:white;margin-bottom:12px">Fase 2: Diseño</h3><p style="font-size:16px;color:#94a3b8;line-height:1.6">Creamos wireframes y prototipos interactivos con UX moderna.</p></div></div>
</div>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center">
<div style="order:1"><div style="background:rgba(16,185,129,.1);border:1px solid rgba(16,185,129,.2);border-radius:16px;padding:32px"><h3 style="font-size:24px;font-weight:800;color:white;margin-bottom:12px">Fase 3: Desarrollo</h3><p style="font-size:16px;color:#94a3b8;line-height:1.6">Sprints ágiles con entregas incrementales y testing continuo.</p></div></div>
<div style="order:2;text-align:right"><div style="width:120px;height:120px;background:linear-gradient(135deg,#10b981,#059669);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:48px;font-weight:900;color:white;margin:0 auto;animation:rotate3D 6s ease-in-out infinite 2s">03</div></div>
</div>
<div style="display:grid;grid-template-columns:1fr 1fr;gap:40px;align-items:center">
<div style="order:2"><div style="width:120px;height:120px;background:linear-gradient(135deg,#a855f7,#9333ea);border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:48px;font-weight:900;color:white;margin:0 auto;animation:rotate3D 6s ease-in-out infinite 3s">04</div></div>
<div style="order:1"><div style="background:rgba(168,85,247,.1);border:1px solid rgba(168,85,247,.2);border-radius:16px;padding:32px"><h3 style="font-size:24px;font-weight:800;color:white;margin-bottom:12px">Fase 4: Deploy & Soporte</h3><p style="font-size:16px;color:#94a3b8;line-height:1.6">Lanzamiento en producción con monitoreo y soporte continuo.</p></div></div>
</div>
</div>
</div>
</section>

<section id="contacto" style="background:#0f172a;padding:120px 40px;border-top:1px solid rgba(255,255,255,.05)">
<div style="max-width:1000px;margin:0 auto;text-align:center">
<h2 style="font-size:clamp(36px,4vw,48px);font-weight:900;color:white;margin-bottom:24px">¿Listo para Comenzar tu Proyecto?</h2>
<p style="font-size:18px;color:#94a3b8;margin-bottom:40px;max-width:700px;margin-left:auto;margin-right:auto">Cuéntanos sobre tu idea y te enviaremos una propuesta personalizada en 48 horas</p>
<form action="/api/contact" method="POST" style="max-width:600px;margin:0 auto">
<div style="display:grid;gap:20px">
<input type="text" name="nombre" placeholder="Nombre completo" required style="padding:18px 24px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:12px;color:white;font-size:16px">
<input type="email" name="email" placeholder="Email" required style="padding:18px 24px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:12px;color:white;font-size:16px">
<textarea name="proyecto" placeholder="Describe tu proyecto web..." rows="5" required style="padding:18px 24px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:12px;color:white;font-size:16px"></textarea>
<button type="submit" style="padding:20px;background:linear-gradient(135deg,#6366f1,#4f46e5);color:white;font-weight:700;font-size:18px;border-radius:12px;border:none;cursor:pointer;box-shadow:0 10px 40px rgba(99,102,241,.3);animation:glow 2s ease-in-out infinite">Solicitar Cotización</button>
</div>
</form>
</div>
</section>
</Layout>
