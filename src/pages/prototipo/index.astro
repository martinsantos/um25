---
/**
 * Prototipo 2026-10-29 · portada "El lugar".
 * Una sola idea para todo el sitio: el cliente tiene un lugar que no puede parar; nosotros
 * somos los sistemas que corren por dentro. La portada es ese lugar en corte, con los ocho
 * sistemas que se encienden al elegirlos y, al lado, las obras reales donde ya lo hicimos.
 * Mismas piezas en todo el sitio: corte isométrico, recorrido en video, filas y mosaico.
 */
import Shell from '../../components/prototipo/Shell.astro';
import { getAntecedentes } from '../../lib/um26-directus';
import { getAntecedenteSectorLabel } from '../../utils/antecedenteSectorPresentation';
import { NAV_SERVICES } from '../../data/navigation';
import { HOME_SCENES, SECTORS, type Scene } from '../../data/cine/scenes';
import { fetchBlogBand } from '../../utils/getBlogData';

export const prerender = false;

const catalog = await getAntecedentes({ limit: 1000 });
const total = catalog.length;

const thumbOf = (image: string) =>
  /^\/images\/antecedentes\/generated\/.+-principal\.webp$/.test(image) ? image.replace(/-principal\.webp$/, '-principal-480.webp') : image;
const cleanText = (value: unknown) => String(value ?? '').replace(/\b(Rubro|Cliente|Sector|Área|Area)\s*:\s*/gi, '').replace(/\s*(\.{3}|…)\s*$/u, '').replace(/\s+/g, ' ').trim();
const clientCase = (client: string) => client === client.toUpperCase()
  ? client.toLowerCase().replace(/(^|\s)(\S)/g, (m: string) => m.toUpperCase()).replace(/\b(De|Del|La|Las|Los|Y|E|Sa|Srl)\b/g, (w: string) => (/^(Sa|Srl)$/.test(w) ? w.toUpperCase() : w.toLowerCase()))
  : client;
const cleanTitle = (raw: unknown, client: string) => {
  let title = cleanText(raw);
  if (title.includes('|')) title = title.split('|')[0].trim() || title;
  const suffix = ` - ${client}`.toLowerCase();
  if (client && title.toLowerCase().endsWith(suffix)) title = title.slice(0, -suffix.length).trim();
  return title.replace(/\s*\(\d+\)\s*$/, '').replace(/\s+-\s+/g, ' · ');
};

const cases = [...catalog]
  .sort((a, b) => (b.year - a.year) || (b.month - a.month) || (b.id - a.id))
  .map((item) => {
    const client = clientCase(cleanText(item.client));
    return {
      href: `/prototipo/proyecto/${item.id}`,
      client,
      title: cleanTitle(item.title, client),
      year: item.year,
      sector: item.sector_slug,
      sectorLabel: getAntecedenteSectorLabel(item.sector_slug) || '',
      codes: item.service_codes.map(String),
      image: item.image && item.image.startsWith('/images/antecedentes/') ? thumbOf(item.image) : '',
    };
  });

// Lugares: las cinco escenas de la portada actual, con sus sectores y su dibujo isométrico.
const SITE: Record<Scene, string> = { hospital: 'clinic', aeropuerto: 'terminal', bodega: 'winery', fachada: 'building', planta: 'plant' };
const SERVICE_KEY: Record<string, string> = { '101': 'redes', '102': 'seguridad', '103': 'telecom', '104': 'software', '105': 'soporte', '106': 'consultoria', '107': 'incendios', '108': 'electricos' };
const places = HOME_SCENES.map((s) => ({
  scene: s.scene,
  name: s.name,
  text: s.text,
  svg: `/cine/iso/site-${SITE[s.scene]}-v2.svg`,
  sectors: SECTORS.filter((row) => row.scene === s.scene).map((row) => row.slug),
}));
const systems = NAV_SERVICES.map((s) => ({ code: s.code, name: s.name, text: s.text, href: `/prototipo/sistema/${s.code}`, key: SERVICE_KEY[s.code] }));

// Obras por lugar × sistema: las tres más recientes con foto, y el conteo.
const proof: Record<string, Record<string, { items: typeof cases; count: number }>> = {};
for (const place of places) {
  proof[place.scene] = {};
  const inPlace = cases.filter((c) => place.sectors.includes(c.sector));
  for (const code of ['all', ...systems.map((s) => s.code)]) {
    const matched = code === 'all' ? inPlace : inPlace.filter((c) => c.codes.includes(code));
    proof[place.scene][code] = { items: matched.filter((c) => c.image).slice(0, 3), count: matched.length };
  }
}
const placeHref = (scene: Scene) => `/prototipo/proyectos?sector=${places.find((p) => p.scene === scene)?.sectors[0] || ''}`;

const recent = cases.filter((c) => c.image).slice(0, 6);
let notes: { slug: string; titulo: string; resumen: string; fecha: string }[] = [];
try {
  notes = (await fetchBlogBand(3)).map((p) => ({ slug: p.slug, titulo: p.titulo, resumen: p.resumen, fecha: p.fecha_publicacion }));
} catch { notes = []; }
const fmtDate = (iso: string) => { const d = new Date(iso); return Number.isNaN(d.getTime()) ? '' : d.toLocaleDateString('es-AR', { day: 'numeric', month: 'long', year: 'numeric' }); };
---
<Shell title="El lugar" active="inicio">
  <main>
    <section class="hero wrap" id="sistemas" data-hero data-proof={JSON.stringify(proof)} data-places={JSON.stringify(places.map((p) => ({ scene: p.scene, name: p.name, svg: p.svg, href: placeHref(p.scene) })))} data-keys={JSON.stringify(SERVICE_KEY)}>
      <div class="hero__head">
        <h1>¿Qué tiene que seguir funcionando?</h1>
        <p class="hero__lead">Redes, seguridad electrónica, telecomunicaciones, software a medida, soporte 24/7 y energía IT. Evidencia operativa visible antes de contratar.</p>
      </div>

      <div class="places" role="tablist" aria-label="Lugares" id="lugares">
        {places.map((p, i) => (
          <button class="place" type="button" role="tab" aria-selected={i === 0 ? 'true' : 'false'} data-place={p.scene}>
            <b>{p.name}</b><small>{p.text}</small>
          </button>
        ))}
      </div>

      <div class="court">
        <div class="board" data-board data-project-service="101">
          <div class="board__art" data-art aria-hidden="true"></div>
          <p class="board__now"><span data-now-place>{places[0].name}</span> · <span data-now-system>{systems[0].name}</span></p>
          <button class="board__film" type="button" data-film>Ver el recorrido</button>
        </div>
        <ol class="systems">
          {systems.map((s, i) => (
            <li>
              <a href={s.href} class:list={['system', { 'is-on': i === 0 }]} data-system={s.code} data-name={s.name}>
                <b>{s.name}</b>
                <span>{s.text}</span>
                <em class="num" data-count={s.code}>{proof[places[0].scene][s.code].count}</em>
              </a>
            </li>
          ))}
        </ol>
      </div>

      <div class="proof">
        <div class="band__head">
          <h2><span data-proof-title>Lo que ya instalamos en {places[0].name.toLowerCase()}.</span></h2>
          <a class="link" data-proof-all href={placeHref(places[0].scene)}>Ver los <span data-proof-count>{proof[places[0].scene].all.count}</span> proyectos</a>
        </div>
        <ul class="tiles tiles--3" data-proof-tiles>
          {proof[places[0].scene]['101'].items.map((c) => (
            <li class="tile"><a href={c.href}><figure><img src={c.image} alt="" width="480" height="300" loading="eager" decoding="async" /></figure><b>{c.client}</b><span>{c.title}</span><em>{[c.sectorLabel, c.year].filter(Boolean).join(' · ')}</em></a></li>
          ))}
        </ul>
        <p class="proof__empty" data-proof-empty hidden>Sin proyectos para esta combinación.</p>
      </div>
    </section>

    <section class="band" id="proyectos">
      <div class="band__head">
        <h2><span class="num">{total}</span> proyectos documentados.</h2>
        <a class="link" href="/prototipo/proyectos">Ver los {total} proyectos</a>
      </div>
      <ul class="tiles">
        {recent.map((c) => (
          <li class="tile"><a href={c.href}><figure><img src={c.image} alt="" width="480" height="300" loading="lazy" decoding="async" /></figure><b>{c.client}</b><span>{c.title}</span><em>{[c.sectorLabel, c.year].filter(Boolean).join(' · ')}</em></a></li>
        ))}
      </ul>
    </section>

    {notes.length > 0 && (
      <section class="band" id="notas">
        <div class="band__head">
          <h2>Ideas técnicas para decidir mejor.</h2>
          <a class="link" href="/blog">Ver el blog</a>
        </div>
        <ol class="rows">
          {notes.map((n) => (
            <li><a href={`/blog/${n.slug}`}><b>{n.titulo}</b><span>{n.resumen}</span><em>{fmtDate(n.fecha)}</em></a></li>
          ))}
        </ol>
      </section>
    )}

    <section class="band contact" id="contacto">
      <div>
        <h2>Contanos qué tiene que seguir funcionando.</h2>
        <p class="muted contact__text">Indicá qué necesitás, dónde y para cuándo. Un técnico te responde por email con el próximo paso: diagnóstico, relevamiento, propuesta o documentación.</p>
        <dl class="contact__direct">
          <div><dt>Email</dt><dd>contacto@ultimamilla.com.ar</dd></div>
          <div><dt>Oficina</dt><dd>Houssay 1159, Guaymallén, Mendoza</dd></div>
          <div><dt>Horario</dt><dd>Lunes a viernes, 8 a 18 h</dd></div>
        </dl>
      </div>
      <form class="contact__form" action="/contacto" method="get">
        <label><span>Nombre</span><input type="text" name="name" autocomplete="name" placeholder="Nombre y apellido" required /></label>
        <label><span>Email de trabajo</span><input type="email" name="email" autocomplete="email" placeholder="mail@empresa.com" required /></label>
        <label><span>Empresa u organismo</span><input type="text" name="company" autocomplete="organization" placeholder="Opcional" /></label>
        <label><span>Mensaje</span><textarea name="message" rows="4" placeholder="Contanos qué necesitás, en qué sede y para cuándo." required></textarea></label>
        <button class="btn" type="submit">Enviar consulta <span aria-hidden="true">→</span></button>
      </form>
    </section>
  </main>

  <dialog class="film" data-film-dialog>
    <div class="film__bar"><p data-film-title></p><button type="button" data-film-close>Cerrar</button></div>
    <video controls playsinline preload="metadata" data-film-video></video>
  </dialog>
</Shell>

<style is:global>
  .hero { padding-top: clamp(28px, 4vw, 56px); }
  .hero__head { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 16px clamp(24px, 4vw, 64px); align-items: end; }
  .hero h1 { font-size: clamp(2.4rem, 5vw, 4.6rem); line-height: .98; font-weight: 700; letter-spacing: -.035em; max-width: 14ch; }
  .hero__lead { font-size: 1.125rem; color: var(--ink-2); max-width: 44ch; }

  /* Lugares: pestañas que cambian el corte */
  .places { display: flex; gap: 8px; margin-top: clamp(24px, 3vw, 40px); padding-bottom: 12px; overflow-x: auto; scrollbar-width: none; border-bottom: 1px solid var(--line); }
  .places::-webkit-scrollbar { display: none; }
  .place { flex: none; display: grid; gap: 2px; min-height: 44px; padding: 10px 14px; border: 1px solid var(--line); text-align: left; transition: background .2s ease, color .2s ease; }
  .place b { font-weight: 600; }
  .place small { font-size: 1rem; color: var(--ink-3); }
  .place:hover { border-color: var(--ink); }
  .place[aria-selected="true"] { background: var(--ink); color: #fff; border-color: var(--ink); }
  .place[aria-selected="true"] small { color: rgba(255,255,255,.7); }

  /* Corte + sistemas */
  .court { display: grid; grid-template-columns: minmax(0, 8fr) minmax(280px, 4fr); gap: clamp(20px, 3vw, 48px); margin-top: 24px; align-items: start; }
  .board { position: relative; aspect-ratio: 5 / 3; background: var(--board); overflow: hidden; }
  .board__art { position: absolute; inset: 4%; }
  .board__art svg { position: absolute; inset: 0; width: 100%; height: 100%; display: block; overflow: visible; }
  .board__now { position: absolute; left: 18px; bottom: 16px; margin: 0; color: rgba(255,255,255,.85); }
  .board__film { position: absolute; right: 16px; bottom: 12px; min-height: 44px; padding: 0 14px; border: 1px solid rgba(255,255,255,.3); color: #fff; }
  .board__film:hover { border-color: #fff; }
  /* Rutas: todas como traza, la del sistema activo encendida (misma regla que el despiece actual). */
  .board .sp-route path { stroke-width: 1.2; }
  .board .sp-route { opacity: .09; transition: opacity 600ms ease; }
  .board .sp-pin, .board .sp-leader, .board .sp-effect { opacity: 0; transition: opacity 600ms ease; }
  .board .sp-effect { pointer-events: none; }
  .board[data-project-service="106"] .sp-route { opacity: .7; }
  .board[data-project-service="101"] .sp-route--101, .board[data-project-service="102"] .sp-route--102, .board[data-project-service="103"] .sp-route--103, .board[data-project-service="104"] .sp-route--104, .board[data-project-service="105"] .sp-route--105, .board[data-project-service="107"] .sp-route--107, .board[data-project-service="108"] .sp-route--108 { opacity: .94; }
  .board[data-project-service="101"] .sp-pin--101, .board[data-project-service="102"] .sp-pin--102, .board[data-project-service="103"] .sp-pin--103, .board[data-project-service="104"] .sp-pin--104, .board[data-project-service="105"] .sp-pin--105, .board[data-project-service="106"] .sp-pin--106, .board[data-project-service="107"] .sp-pin--107, .board[data-project-service="108"] .sp-pin--108 { opacity: 1; }
  .board[data-project-service="101"] [data-project-device="101"], .board[data-project-service="102"] [data-project-device="102"], .board[data-project-service="103"] [data-project-device="103"], .board[data-project-service="104"] [data-project-device="104"], .board[data-project-service="105"] [data-project-device="105"], .board[data-project-service="107"] [data-project-device="107"], .board[data-project-service="108"] [data-project-device="108"] { stroke: #fff; stroke-opacity: 1; stroke-width: 1; }
  .board[data-project-service="101"] .sp-effect--101, .board[data-project-service="102"] .sp-effect--102, .board[data-project-service="107"] .sp-effect--107 { opacity: 1; }
  @keyframes draw-route { from { stroke-dashoffset: 2400; } to { stroke-dashoffset: 0; } }
  .board[data-project-service="101"] .sp-route--101 path, .board[data-project-service="102"] .sp-route--102 path, .board[data-project-service="103"] .sp-route--103 path, .board[data-project-service="104"] .sp-route--104 path, .board[data-project-service="105"] .sp-route--105 path, .board[data-project-service="107"] .sp-route--107 path, .board[data-project-service="108"] .sp-route--108 path { stroke-dasharray: 2400; animation: draw-route 2600ms cubic-bezier(.22, 1, .36, 1) 1 both; }

  .systems { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .system { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 2px 16px; padding: 12px 0; border-bottom: 1px solid var(--line); color: var(--ink-2); transition: color .2s ease; }
  .system b { font-weight: 600; color: var(--ink); display: inline-block; padding-bottom: 1px; border-bottom: 2px solid transparent; transition: border-color .2s ease; }
  .system span { grid-column: 1; line-height: 1.4; }
  .system em { grid-row: 1 / span 2; align-self: start; font-style: normal; color: var(--ink-3); }
  .system.is-on b, .system:hover b { border-bottom-color: var(--red); }
  .system.is-on em { color: var(--ink); }

  .proof { margin-top: clamp(28px, 4vw, 48px); padding-bottom: clamp(40px, 6vw, 80px); }
  .proof__empty { color: var(--ink-2); }

  .contact { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(28px, 5vw, 80px); }
  .contact__text { margin-top: 12px; max-width: 46ch; }
  .contact__direct { margin: 28px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .contact__direct div { display: grid; grid-template-columns: 96px 1fr; gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .contact__direct dt { color: var(--ink-3); }
  .contact__direct dd { margin: 0; }
  .contact__form { display: grid; gap: 14px; }
  .contact__form label { display: grid; gap: 6px; }
  .contact__form span { color: var(--ink-2); }
  .contact__form input, .contact__form textarea { font: inherit; padding: 12px 14px; border: 1px solid var(--line); background: #fff; color: var(--ink); }
  .contact__form input:focus, .contact__form textarea:focus { border-color: var(--ink); outline: none; }
  .contact__form .btn { justify-self: start; }

  .film { width: min(1200px, 94vw); padding: 0; border: 0; background: var(--board); color: #fff; }
  .film::backdrop { background: rgba(0,0,0,.7); }
  .film__bar { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 12px 16px; }
  .film__bar button { min-height: 40px; padding: 0 12px; border: 1px solid rgba(255,255,255,.3); }
  .film video { display: block; width: 100%; aspect-ratio: 16 / 9; background: #000; }

  @media (max-width: 1100px) { .court { grid-template-columns: minmax(0, 1fr); } .board { aspect-ratio: 16 / 10; } }
  @media (max-width: 860px) {
    .hero__head { grid-template-columns: 1fr; }
    .board { aspect-ratio: 4 / 3; }
    .board__film { position: static; margin: 0; }
    .board__now { position: static; padding: 12px 0 0; color: var(--ink-2); }
    .board { display: grid; grid-template-rows: 1fr auto auto; gap: 8px; padding-bottom: 12px; background: transparent; }
    .board__art { position: relative; inset: auto; aspect-ratio: 4 / 3; background: var(--board); }
    .board__art svg { inset: 4%; width: 92%; height: 92%; }
    .board__film { justify-self: start; color: var(--ink); border-color: var(--ink); }
    .contact { grid-template-columns: 1fr; }
  }
  @media (prefers-reduced-motion: reduce) { .board .sp-route path { animation: none !important; } .board .sp-route, .board .sp-pin { transition: none; } }
</style>

<script>
  const hero = document.querySelector<HTMLElement>('[data-hero]')!;
  const proof = JSON.parse(hero.dataset.proof || '{}') as Record<string, Record<string, { items: { href: string; client: string; title: string; year: number; sectorLabel: string; image: string }[]; count: number }>>;
  const places = JSON.parse(hero.dataset.places || '[]') as { scene: string; name: string; svg: string; href: string }[];
  const keys = JSON.parse(hero.dataset.keys || '{}') as Record<string, string>;
  const board = hero.querySelector<HTMLElement>('[data-board]')!;
  const art = hero.querySelector<HTMLElement>('[data-art]')!;
  const nowPlace = hero.querySelector<HTMLElement>('[data-now-place]')!;
  const nowSystem = hero.querySelector<HTMLElement>('[data-now-system]')!;
  const tabs = [...hero.querySelectorAll<HTMLButtonElement>('[data-place]')];
  const systems = [...hero.querySelectorAll<HTMLAnchorElement>('[data-system]')];
  const proofTitle = hero.querySelector<HTMLElement>('[data-proof-title]')!;
  const proofAll = hero.querySelector<HTMLAnchorElement>('[data-proof-all]')!;
  const proofCount = hero.querySelector<HTMLElement>('[data-proof-count]')!;
  const proofTiles = hero.querySelector<HTMLElement>('[data-proof-tiles]')!;
  const proofEmpty = hero.querySelector<HTMLElement>('[data-proof-empty]')!;
  const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
  const svgCache = new Map<string, Promise<string>>();
  let scene = places[0].scene, system = systems[0]?.dataset.system || '101';

  // El corte se trae una sola vez por lugar; el viewBox se ajusta al dibujo real.
  const loadArt = (p: { svg: string }) => {
    if (!svgCache.has(p.svg)) svgCache.set(p.svg, fetch(p.svg).then((r) => (r.ok ? r.text() : '')));
    return svgCache.get(p.svg)!.then((svg) => {
      if (!svg) return;
      art.innerHTML = svg;
      const el = art.querySelector<SVGSVGElement>('svg'), root = el?.querySelector<SVGGraphicsElement>('.sp-root');
      if (el && root) { try { const b = root.getBBox(); const pad = Math.max(b.width, b.height) * .04; el.setAttribute('viewBox', `${b.x - pad} ${b.y - pad} ${b.width + pad * 2} ${b.height + pad * 2}`); el.setAttribute('preserveAspectRatio', 'xMidYMid meet'); } catch { /* sin bbox */ } }
    });
  };

  const esc = (s: string) => s.replace(/[&<>"]/g, (c) => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;' }[c] as string));
  const render = () => {
    const place = places.find((p) => p.scene === scene)!;
    const entry = proof[scene]?.[system] || { items: [], count: 0 };
    board.dataset.projectService = system;
    nowPlace.textContent = place.name;
    nowSystem.textContent = systems.find((s) => s.dataset.system === system)?.dataset.name || '';
    systems.forEach((s) => { s.classList.toggle('is-on', s.dataset.system === system); const c = s.querySelector('[data-count]'); if (c) c.textContent = String(proof[scene]?.[s.dataset.system!]?.count ?? 0); });
    tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.place === scene)));
    const sys = nowSystem.textContent || '';
    proofTitle.textContent = `Lo que ya instalamos en ${place.name.toLowerCase()}.`;
    proofAll.href = `${place.href}&servicio=${system}`;
    proofCount.textContent = String(entry.count);
    proofTiles.innerHTML = entry.items.map((c) => `<li class="tile"><a href="${c.href}"><figure><img src="${c.image}" alt="" width="480" height="300" loading="lazy" decoding="async"></figure><b>${esc(c.client)}</b><span>${esc(c.title)}</span><em>${esc([c.sectorLabel, c.year].filter(Boolean).join(' · '))}</em></a></li>`).join('');
    proofEmpty.hidden = entry.items.length > 0;
    void sys;
  };

  tabs.forEach((t) => t.addEventListener('click', () => { scene = t.dataset.place!; loadArt(places.find((p) => p.scene === scene)!); render(); }));
  systems.forEach((s) => {
    const pick = () => { if (system !== s.dataset.system) { system = s.dataset.system!; render(); } };
    if (fine) { s.addEventListener('pointerenter', pick); s.addEventListener('focus', pick); }
    // Táctil: el primer toque enciende el sistema; el segundo abre su ficha.
    s.addEventListener('click', (e) => { if (!fine && system !== s.dataset.system) { e.preventDefault(); pick(); } });
  });

  // Recorrido en video del lugar y el sistema activos (mismos archivos que el banner actual).
  const dialog = document.querySelector<HTMLDialogElement>('[data-film-dialog]')!;
  const video = dialog.querySelector<HTMLVideoElement>('[data-film-video]')!;
  const filmTitle = dialog.querySelector<HTMLElement>('[data-film-title]')!;
  hero.querySelector('[data-film]')!.addEventListener('click', () => {
    const key = keys[system];
    video.src = `/cine/media/cine-${scene}${key ? `-${key}` : ''}.mp4`;
    filmTitle.textContent = `${nowPlace.textContent} · ${nowSystem.textContent}`;
    dialog.showModal();
    video.play().catch(() => { /* el usuario puede reproducir con los controles */ });
  });
  dialog.querySelector('[data-film-close]')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('close', () => { video.pause(); video.removeAttribute('src'); video.load(); });
  dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

  loadArt(places[0]);
  render();
</script>
