---
/**
 * Prototipo 2026-10-29 · ficha única, caso "proyecto" (antecedente).
 * Mismo componente que la ficha de sistema. Sin códigos en el encabezado, sin filas que
 * repitan el título; la descripción sólo si dice algo que el título no dice.
 */
import Shell from '../../../components/prototipo/Shell.astro';
import Ficha from '../../../components/prototipo/Ficha.astro';
import { getAntecedentes, getServicios } from '../../../lib/um26-directus';
import { getAntecedenteSectorLabel } from '../../../utils/antecedenteSectorPresentation';
import { formatAntecedenteDate } from '../../../utils/antecedentesCuration';

export const prerender = false;

const { id } = Astro.params;
const catalog = await getAntecedentes({ limit: 1000 });
const item = catalog.find((c) => String(c.id) === String(id));
if (!item) return Astro.rewrite('/404');
const servicios = await getServicios();
const serviceName = (code: number) => servicios.find((s) => s.code === code)?.name || '';

const cleanText = (value: unknown) => String(value ?? '').replace(/\b(Rubro|Cliente|Sector|Área|Area)\s*:\s*/gi, '').replace(/\s+/g, ' ').trim();
const rowTitle = (raw: unknown, who: unknown) => { const t = cleanText(raw).replace(/\s*\(\d+\)\s*$/, ''); const suffix = ` - ${cleanText(who)}`.toLowerCase(); return cleanText(who) && t.toLowerCase().endsWith(suffix) ? t.slice(0, -suffix.length).trim() : t; };
const comparable = (v: unknown) => cleanText(v).toLowerCase().replace(/\(\d+\)/g, ' ').replace(/[.,:;()]/g, ' ').replace(/\s+/g, ' ').trim();
const client = cleanText(item.client);
const rawTitle = cleanText(item.title).replace(/\s*\(\d+\)\s*$/, '');
const title = (() => { const suffix = ` - ${client}`.toLowerCase(); return client && rawTitle.toLowerCase().endsWith(suffix) ? rawTitle.slice(0, -suffix.length).trim() : rawTitle; })();
const scope = (item.scope || []).map(cleanText).filter((s) => s && comparable(s) !== comparable(title) && comparable(s) !== comparable(client));
const summary = cleanText(item.summary)
  .replace(/^Ejecución integral de\s+/i, '')
  .replace(/,?\s*asegurando continuidad operativa y cumplimiento de estándares técnicos de calidad\.?/gi, '.')
  .replace(/\s*Cliente:\s*[^.]+\.?\s*(?:Sector:\s*[^.]+\.?)?\s*$/i, '')
  .trim();
// Lo que queda de la descripción al quitar título, cliente y alcance: si no llega a tres palabras, no dice nada nuevo.
const sectorLabel = getAntecedenteSectorLabel(item.sector_slug) || '';
const leftover = [rawTitle, title, client, sectorLabel, ...scope, ...rawTitle.split(/\s*[:\-–·]\s*/)].filter((part) => comparable(part).length > 2).reduce((acc, part) => (part ? acc.split(comparable(part)).join(' ') : acc), comparable(summary)).replace(/\b(para|de|del|y|e|en|el|la|los|las|&)\b|&/g, ' ').trim();
const body = summary && leftover.split(/\s+/).filter(Boolean).length >= 4 ? summary : '';
const date = formatAntecedenteDate(`${item.year}-${String(item.month || 1).padStart(2, '0')}-01`);
const image = item.image && item.image.startsWith('/images/antecedentes/') ? item.image : '/cine/media/cine-fachada-poster.avif';

const related = catalog
  .filter((c) => c.id !== item.id && (c.sector_slug === item.sector_slug || c.service_codes.some((code) => item.service_codes.includes(code))))
  .map((c) => ({ c, score: (c.sector_slug === item.sector_slug ? 2 : 0) + c.service_codes.filter((code) => item.service_codes.includes(code)).length * 3 - Math.min(Math.abs(c.year - item.year), 10) / 10 }))
  .sort((a, b) => b.score - a.score)
  .filter(({ c }, i, arr) => arr.findIndex((o) => `${rowTitle(o.c.title, o.c.client)}|${o.c.client}`.toLowerCase() === `${rowTitle(c.title, c.client)}|${c.client}`.toLowerCase()) === i)
  .slice(0, 4)
  .map(({ c }) => ({ href: `/prototipo/proyecto/${c.id}`, b: cleanText(c.client), span: rowTitle(c.title, c.client), em: [getAntecedenteSectorLabel(c.sector_slug), c.year].filter(Boolean).join(' · ') }));
---
<Shell title={title} active="proyectos">
  <Ficha
    kind="Proyecto"
    kindHref="/prototipo/proyectos"
    title={title}
    facts={[
      { dt: 'Cliente', dd: client },
      ...(sectorLabel ? [{ dt: 'Lugar', dd: sectorLabel, href: `/prototipo/proyectos?sector=${item.sector_slug}` }] : []),
      ...(date ? [{ dt: 'Finalización', dd: date }] : []),
      ...(item.service_codes.length ? [{ dt: 'Sistemas', dd: item.service_codes.map(serviceName).filter(Boolean).join(' · ') }] : []),
      { dt: 'Referencia', dd: `UM-${item.id}` },
    ]}
    stage={{ image, width: 1600, height: 1000 }}
    sections={[
      ...(body || scope.length ? [{ title: 'Qué se hizo.', ...(body ? { rows: [{ a: body }] } : {}), ...(scope.length ? { items: scope } : {}) }] : []),
    ]}
    related={related}
    relatedTitle={`Proyectos relacionados.`}
    relatedHref={`/prototipo/proyectos?sector=${item.sector_slug}`}
    relatedLabel={`Ver todos en ${sectorLabel || 'proyectos'}`}
  />
</Shell>
