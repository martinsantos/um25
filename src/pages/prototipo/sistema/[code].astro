---
/**
 * Prototipo 2026-10-29 · ficha única, caso "sistema" (frente de servicio).
 * Mismo componente que la ficha de proyecto: datos fijos a la izquierda, contenido a la derecha.
 */
import Shell from '../../../components/prototipo/Shell.astro';
import Ficha from '../../../components/prototipo/Ficha.astro';
import { getAntecedentes } from '../../../lib/um26-directus';
import { getAntecedenteSectorLabel } from '../../../utils/antecedenteSectorPresentation';
import { NAV_SERVICES } from '../../../data/navigation';
import { SERVICE_SCENES } from '../../../data/cine/scenes';
import { getServiceSpec } from '../../../data/serviceSpecs';
import { serviceSingleDemoCapabilities } from '../../../data/serviceSingleDemoSystem';

export const prerender = false;

const { code } = Astro.params;
const service = NAV_SERVICES.find((s) => s.code === String(code));
if (!service) return Astro.rewrite('/404');

const SERVICE_KEY: Record<string, string> = { '101': 'redes', '102': 'seguridad', '103': 'telecom', '104': 'software', '105': 'soporte', '106': 'consultoria', '107': 'incendios', '108': 'electricos' };
const spec = getServiceSpec(code);
const capabilities = serviceSingleDemoCapabilities[Number(code)] || [];
const catalog = await getAntecedentes({ limit: 1000 });
const mine = catalog.filter((c) => c.service_codes.includes(Number(code))).sort((a, b) => (b.year - a.year) || (b.month - a.month));
const sectorCounts = new Map<string, number>();
mine.forEach((c) => sectorCounts.set(c.sector_slug, (sectorCounts.get(c.sector_slug) || 0) + 1));
const sectorsApplied = [...sectorCounts.entries()].sort((a, b) => b[1] - a[1]).map(([slug, n]) => `${getAntecedenteSectorLabel(slug) || slug} (${n})`).join(' · ');
const scene = SERVICE_SCENES[String(code)]?.scene || 'fachada';
const cleanText = (value: unknown) => String(value ?? '').replace(/\b(Rubro|Cliente|Sector|Área|Area)\s*:\s*/gi, '').replace(/\s+/g, ' ').trim();
const rowTitle = (raw: unknown, who: unknown) => { const t = cleanText(raw).replace(/\s*\(\d+\)\s*$/, ''); const suffix = ` - ${cleanText(who)}`.toLowerCase(); return cleanText(who) && t.toLowerCase().endsWith(suffix) ? t.slice(0, -suffix.length).trim() : t; };
// Una fila por obra: los lotes repetidos (mismo título y cliente) no se listan varias veces.
const rowKey = (c: { title: string; client: string }) => `${rowTitle(c.title, c.client)}|${cleanText(c.client)}`.toLowerCase();
const related = mine.filter((c, i, arr) => arr.findIndex((o) => rowKey(o) === rowKey(c)) === i).slice(0, 6).map((c) => ({
  href: `/prototipo/proyecto/${c.id}`,
  b: cleanText(c.client),
  span: rowTitle(c.title, c.client),
  em: [getAntecedenteSectorLabel(c.sector_slug), c.year].filter(Boolean).join(' · '),
}));
---
<Shell title={service.name} active="sistema">
  <Ficha
    kind="Sistema"
    kindHref="/prototipo#sistemas"
    title={service.name}
    lead={spec?.promise || service.text}
    facts={[
      { dt: 'Proyectos', dd: `${mine.length} documentados` },
      { dt: 'Lugares', dd: sectorsApplied || '—' },
      { dt: 'Entregable', dd: spec?.keyDeliverable || '—' },
      { dt: 'Norma', dd: spec?.keyStandard || '—' },
      { dt: 'Ficha técnica', dd: 'Descargar la ficha técnica (PDF)', href: `/servicios/${service.code}/ficha` },
    ]}
    stage={{ image: `/cine/media/cine-${scene}-${SERVICE_KEY[service.code]}-poster.avif`, width: 1920, height: 1080, caption: `Recorrido · ${service.name}` }}
    sections={[
      ...(capabilities.length ? [{ title: `Qué cubre ${service.name}.`, rows: capabilities.map((c) => ({ a: c.title, b: c.description })) }] : []),
      ...(spec?.scope.length ? [{ title: 'Alcance.', items: spec.scope }] : []),
      ...(spec?.standards.length ? [{ title: 'Normas.', items: spec.standards }] : []),
      ...(spec?.deliverables.length ? [{ title: 'Entregables.', items: spec.deliverables }] : []),
      ...(spec?.serviceLevel.length ? [{ title: 'Garantía y soporte.', items: spec.serviceLevel }] : []),
    ]}
    related={related}
    relatedTitle={`Proyectos de ${service.name}.`}
    relatedHref={`/prototipo/proyectos?servicio=${service.code}`}
    relatedLabel={`Ver los ${mine.length} proyectos`}
  />
</Shell>
