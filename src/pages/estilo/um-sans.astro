---
import LayoutV4 from '../../layouts/LayoutV4.astro';

export interface Props {
  publicRoute?: boolean;
}

const isPublicRoute = Astro.props.publicRoute === true || Astro.url.pathname === '/estilo/fuente';

const displayWeights = [
  { name: 'Editorial SemiBold', value: 600, role: 'Títulos editoriales' },
  { name: 'Editorial Bold', value: 700, role: 'Acciones y énfasis' },
  { name: 'Editorial ExtraBold', value: 800, role: 'Hero y campaña' },
  { name: 'Editorial Black', value: 900, role: 'Cifras de impacto' },
];

const textWeights = [
  { name: 'Text Light', value: 300, role: 'Citas amplias' },
  { name: 'Text Regular', value: 400, role: 'Lectura sostenida' },
  { name: 'Text Medium', value: 500, role: 'Interfaz y metadata' },
  { name: 'Text SemiBold', value: 600, role: 'Subtítulos y navegación' },
  { name: 'Text Bold', value: 700, role: 'Acciones y énfasis' },
];

const roles = [
  ['Hero', '56 / 0,98', 700, 'Operaciones que no pueden detenerse.'],
  ['Título', '40 / 1,04', 600, 'Infraestructura con alcance verificable.'],
  ['Subtítulo', '28 / 1,18', 600, 'Del diagnóstico a la operación.'],
  ['Lead', '21 / 1,52', 400, 'Evidencia, alcance y un próximo paso claro.'],
  ['Cuerpo', '18 / 1,66', 400, 'Cada intervención se releva, documenta y entrega.'],
  ['Interfaz', '16 / 1,42', 500, 'Cliente · Sector · Alcance · Año'],
] as const;

const features = [
  ['kern', 'AVATAR · TÉCNICA', 'Espaciado contextual en titulares y mayúsculas.'],
  ['liga', 'oficina · fibra', 'Ligaduras estándar sin alterar lectura técnica.'],
  ['mark', 'ÁÉÍÓÚÜÑ', 'Anclajes para diacríticos y español completo.'],
  ['zero', '0 100 2026', 'Cero barrado opcional para tablas y datos.'],
] as const;

const deliverables = [
  ['Verificado', 'Editorial', 'UM Sans Text 1.2', 'Pesos 300 a 900, romanas, cursivas y variable para títulos, lectura, UI y documentación.'],
  ['En QA', 'Display original', 'UM Sans 2.1 Candidate', 'Corte ExtraBold independiente para titulares de frase; se prueba solo en localhost y no reemplaza lectura ni interfaz.'],
  ['Bloqueado', 'Display original', 'Redibujo completo requerido', 'El prototipo procedural falló la revisión raster de palabras, signos y repertorio; no se carga ni se distribuye.'],
  ['Verificado', 'Repertorio', 'Español y datos', 'Acentos, signos, moneda y cifras críticas están presentes en ambas voces.'],
  ['En QA', 'Specimen', 'Desktop y mobile', 'La página funciona como contrato visual y matriz de regresión.'],
  ['Verificado', 'Web', 'Integración por rol', 'Pesos de impacto solo en H1 y cifras; lectura estable en navegación, botones y datos densos.'],
  ['Bloqueado', 'Cursiva display', 'No se sintetiza', 'La voz display no usa inclinación artificial; las cursivas pertenecen a Text.'],
  ['Bloqueado', 'Variable display', 'Sin binario variable', 'Los masters originales aún no son compatibles para interpolación segura.'],
  ['Externo', 'Legal', 'Autoría, similitud y marca', 'Requiere revisión profesional independiente.'],
  ['Externo', 'Plataformas', 'Windows, Office, Adobe, iOS', 'La distribución comercial exige una matriz física firmada.'],
] as const;

const publicDeliverables = deliverables.filter(([status, area]) =>
  status === 'Verificado' || area === 'Legal' || area === 'Plataformas'
);

const repertoire = [
  'ABCDEFGHIJKLMNOPQRSTUVWXYZ',
  'abcdefghijklmnopqrstuvwxyz',
  'ÁÀÂÄÃÅ ÉÈÊË ÍÌÎÏ ÓÒÔÖÕ ÚÙÛÜ Ñ Ç',
  'áàâäãå éèêë íìîï óòôöõ úùûü ñ ç',
  '0123456789 ¼ ½ ¾',
  '¿? ¡! @ # $ % & * + − = / \\',
  '← ↑ → ↓ ↗ · • … – —',
] as const;
---

<LayoutV4
  title={isPublicRoute ? 'UM Sans | Fuente editorial de ULTIMA MILLA' : 'UM Sans | Specimen editorial integral'}
  description={isPublicRoute
    ? 'UM Sans 1.2 Production: familia editorial de ULTIMA MILLA para títulos, lectura, interfaz y documentación.'
    : 'Specimen interno del sistema tipográfico UM Sans: familia editorial verificada para impacto, lectura, interfaz y documentación; prototipo Display original bloqueado.'}
  noindex={!isPublicRoute}
>
  <div class="ums2" id="contenido-tipografico">
    <header class="ums2-hero" id="concepto">
      <div class="ums2-shell ums2-hero__grid">
        <div>
          <p class="ums2-kicker">UM Sans · sistema tipográfico editorial</p>
          <h1><span class="ums2-family-name">Fibra certificada,</span><span class="ums2-state">operación continua.</span></h1>
        </div>
        <div class="ums2-hero__copy">
          <p>{isPublicRoute
            ? 'Una familia editorial verificada para títulos, lectura, interfaz y documentación. UM Sans 1.2 Production está lista para integrarse con una jerarquía clara y sin glifos experimentales.'
            : 'Una familia editorial verificada para títulos, lectura, interfaz y documentación. El prototipo Display original está retirado hasta completar un redibujo de calidad tipográfica real.'}</p>
          <div class="ums2-actions">
            <a class="ums2-button ums2-button--primary" href="#laboratorio">Probar familia editorial</a>
            <a class="ums2-button" href="#combinaciones">Ver combinaciones</a>
            <a class="ums2-link" href="/fonts/um-sans/release-provenance.json">Procedencia ↗</a>
          </div>
        </div>
      </div>
      <dl class="ums2-shell ums2-ledger" aria-label="Resumen de la familia">
        <div><dt>Sistema</dt><dd>Editorial + UI</dd></div>
        <div><dt>Familia estable</dt><dd>9 pesos</dd></div>
        <div><dt>Variantes</dt><dd>Romanas + cursivas</dd></div>
        <div><dt>Cobertura</dt><dd>Español + datos</dd></div>
        <div><dt>Estado</dt><dd>Producción 1.2</dd></div>
      </dl>
    </header>

    <nav class="ums2-index" aria-label="Índice del specimen">
      <div class="ums2-shell">
        <a href="#familia">Familia</a>
        {!isPublicRoute && <a href="#candidata">Corte rechazado</a>}
        <a href="#laboratorio">Laboratorio</a>
        <a href="#combinaciones">Combinaciones</a>
        <a href="#contextos">Contextos</a>
        <a href="#numerales">Datos</a>
        <a href="#lectura">Lectura</a>
        <a href="#responsive">Responsive</a>
        <a href="#kerning">Kerning</a>
        <a href="#opentype">OpenType</a>
        <a href="#repertorio">Repertorio</a>
        <a href="#escala">Escala</a>
        <a href="#entrega">Entrega</a>
      </div>
    </nav>

    <section class="ums2-section ums2-section--intro">
      <div class="ums2-shell ums2-intro">
        <div>
          <p class="ums2-kicker">01 · Concepto</p>
          <h2>Dos voces.<br />Una identidad.</h2>
        </div>
        <div class="ums2-prose">
          <p>UM Sans Text 1.2 aporta una estructura consistente desde titulares hasta lectura prolongada. El impacto se obtiene con peso, escala, ancho y espacio, sin deformar glifos.</p>
          <p>{isPublicRoute
            ? 'La personalidad se sostiene con proporción, peso y espacio: una voz clara para operaciones que necesitan continuidad.'
            : 'La personalidad no depende de declarar terminada una fuente que todavía falla. El corte original se conserva como investigación bloqueada y no contamina el sistema público.'}</p>
        </div>
      </div>
    </section>

    {!isPublicRoute && <section class="ums2-section ums2-section--candidate" id="candidata">
      <div class="ums2-shell ums2-candidate-grid">
        <div>
          <p class="ums2-kicker">02B · Corte rechazado</p>
          <h2>UM Sans 2.1.<br />No aprobada.</h2>
          <p class="ums2-candidate-note">La revisión raster en palabras reales detectó minúsculas deformadas, color tipográfico irregular y un ritmo impropio para la marca. El corte fue retirado de todas las páginas.</p>
          <p class="ums2-candidate-status">Retirada del runtime · 16.07.2026</p>
        </div>
        <div class="ums2-candidate-proof" aria-label="Referencia estable posterior al rechazo de UM Sans 2.1">
          <p>Fibra certificada,<br />operación continua.</p>
          <span>Referencia estable · UM Sans Text 1.2 · 800</span>
          <a href="/estilo/um-sans-2-manual">Abrir proyecto manual Alpha 0 →</a>
        </div>
      </div>
    </section>}

    <section class="ums2-section" id="familia">
      <div class="ums2-shell">
        <div class="ums2-section-head">
          <div><p class="ums2-kicker">02 · Familia editorial</p><h2>Impacto donde importa.<br />Lectura donde decide.</h2></div>
          <p>La familia se organiza por función. Los pesos 800–900 resuelven impacto; 600–700 jerarquía; 400–500 lectura, interfaz, tablas y documentos.</p>
        </div>
        <div class="ums2-voice-head">
          <p class="ums2-kicker">Registro de impacto verificado</p>
          <h3>Firme, redondo y controlado.</h3>
          <p>Pesos de 600 a 900 de la familia estable.</p>
        </div>
        <div class="ums2-family ums2-family--display">
          {displayWeights.map((weight) => (
            <article class="ums2-weight">
              <div class="ums2-weight__meta">
                <strong>{weight.name}</strong>
                <span>{weight.value}</span>
                <small>{weight.role}</small>
              </div>
              <div class="ums2-weight__samples">
                <p style={`font-weight: ${weight.value}`}>Última milla, primera evidencia.</p>
                <p class="ums2-display-secondary" style={`font-weight: ${weight.value}`}>Operación documentada.</p>
              </div>
              <div class="ums2-downloads" aria-label={`Estado ${weight.name}`}><span>Producción 1.2</span></div>
            </article>
          ))}
        </div>
        <div class="ums2-voice-head ums2-voice-head--text">
          <p class="ums2-kicker">Text verificada</p>
          <h3>Abierta, sobria y resistente.</h3>
          <p>Romanas, cursivas y variable para lectura e interfaz.</p>
        </div>
        <div class="ums2-family ums2-family--text">
          {textWeights.map((weight) => (
            <article class="ums2-weight">
              <div class="ums2-weight__meta">
                <strong>{weight.name}</strong>
                <span>{weight.value}</span>
                <small>{weight.role}</small>
              </div>
              <div class="ums2-weight__samples ums2-weight__samples--text">
                <p style={`font-weight: ${weight.value}`}>Cada proyecto empieza por comprender el sitio.</p>
                <p class="is-italic" style={`font-weight: ${weight.value}`}>Evidencia, alcance y continuidad.</p>
              </div>
              <div class="ums2-downloads"><span>Producción 1.2</span></div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="ums2-section ums2-section--dark" id="laboratorio">
      <div class="ums2-shell">
        <div class="ums2-section-head">
          <div><p class="ums2-kicker">03 · Laboratorio editorial</p><h2>Probá tamaño y masa.</h2></div>
          <p>{isPublicRoute
            ? 'El laboratorio usa los pesos de impacto de la familia verificada y permite probar la lectura con textos reales.'
            : 'El laboratorio usa los pesos de impacto de la familia verificada. El prototipo Display original no se carga.'}</p>
        </div>
        {!isPublicRoute && <div class="ums2-blocker" role="status">
          <strong>GATE TIPOGRÁFICO</strong>
          <p>Solo se integra un corte después de revisar palabras, alfabeto, acentos, cifras y pantallas reales. El prototipo original falló ese gate y permanece bloqueado.</p>
        </div>}
        <form class="ums2-lab-controls" onsubmit="return false">
          <label>
            <span>Peso</span>
            <input id="ums2-weight" type="range" min="600" max="900" step="100" value="700" />
            <output id="ums2-weight-value" for="ums2-weight">700</output>
          </label>
          <span class="ums2-control-note">32 px mínimo · romana</span>
        </form>
        <p
          id="ums2-lab-sample"
          class="ums2-lab-sample"
          contenteditable="true"
          spellcheck="false"
          aria-label="Texto editable para probar UM Sans editorial"
        >Fibra certificada, operación continua.</p>
        <p class="ums2-lab-note">Editá el texto. Probá acentos, cifras, signos y títulos extensos; la muestra no permite cursiva sintética.</p>
      </div>
    </section>

    <section class="ums2-section" id="combinaciones">
      <div class="ums2-shell">
        <div class="ums2-section-head">
          <div><p class="ums2-kicker">04 · Combinaciones</p><h2>Una familia, cinco registros.</h2></div>
          <p>Ejemplos de uso sin cambiar de tipografía ni depender de efectos decorativos.</p>
        </div>
        <div class="ums2-compositions">
          <article class="ums2-composition ums2-composition--campaign">
            <p>Servicios IT · Desde 2000</p>
            <h3>Respuesta rápida.<br />Evidencia clara.</h3>
            <span>Impacto 800 · Hero de campaña</span>
          </article>
          <article class="ums2-composition ums2-composition--editorial">
            <p>Informe técnico 026</p>
            <h3>La continuidad se diseña antes de instalar.</h3>
            <span>Lectura 400 + título 600</span>
          </article>
          <article class="ums2-composition ums2-composition--data">
            <p>Disponibilidad</p>
            <strong>99,98%</strong>
            <span>Impacto 900 · Cifra operativa</span>
          </article>
          <article class="ums2-composition ums2-composition--interface">
            <p>Incidente 2847</p>
            <h3>Fibra principal restaurada</h3>
            <dl><div><dt>Estado</dt><dd>Operativo</dd></div><div><dt>SLA</dt><dd>01:42</dd></div></dl>
          </article>
          <blockquote class="ums2-composition ums2-composition--quote">
            <p>“Documentar bien es parte de dejar funcionando.”</p>
            <cite>Text Italic 400 · Voz editorial</cite>
          </blockquote>
        </div>
      </div>
    </section>

    <section class="ums2-section ums2-section--contexts" id="contextos">
      <div class="ums2-shell">
        <div class="ums2-section-head">
          <div><p class="ums2-kicker">05 · Contextos reales</p><h2>De la campaña al dossier.</h2></div>
          <p>La familia se prueba con contenido de producto, lectura editorial e interfaz operativa. No alcanza con mostrar un alfabeto aislado.</p>
        </div>
        <div class="ums2-contexts">
          <article class="ums2-context ums2-context--marketing">
            <p class="ums2-context__label">Servicios IT · Desde 2000</p>
            <h3>Operación continua.<br />Evidencia visible.</h3>
            <p>Infraestructura, seguridad y soporte para empresas que no pueden detenerse.</p>
            <div><span>Ver antecedentes</span><span>Hablar con un especialista</span></div>
          </article>

          <article class="ums2-context ums2-context--editorial">
            <p class="ums2-context__label">Nota técnica · 07:30</p>
            <h3>La continuidad empieza antes de instalar.</h3>
            <p>Relevar el sitio permite separar restricciones, riesgos y dependencias reales. Ese contexto define materiales, pruebas y documentación.</p>
            <blockquote>“La evidencia permite decidir antes de que la operación se detenga.”</blockquote>
            <small>Informe ejecutivo · continuidad operativa</small>
          </article>

          <article class="ums2-context ums2-context--interface">
            <div class="ums2-ui-head">
              <div><span>NOC / Operaciones</span><strong class="ums2-text-heading">Incidente INC-2847</strong></div>
              <b>Activo</b>
            </div>
            <dl class="ums2-ui-ledger">
              <div><dt>Prioridad</dt><dd>Alta</dd></div>
              <div><dt>SLA</dt><dd>01:42</dd></div>
              <div><dt>Responsable</dt><dd>Mesa técnica</dd></div>
            </dl>
            <label class="ums2-ui-field"><span>Nota operativa</span><input value="Fibra principal restaurada" readonly /></label>
            <button type="button">Abrir evidencia</button>
          </article>
        </div>

        <div class="ums2-table-wrap" aria-label="Ejemplo de tabla documental">
          <table class="ums2-table">
            <caption>Índice documental · Text 500</caption>
            <thead><tr><th>Proyecto</th><th>Sector</th><th>Estado</th><th>Año</th></tr></thead>
            <tbody>
              <tr><td>Red troncal y fibra certificada</td><td>Industria</td><td>Operativo</td><td>2026</td></tr>
              <tr><td>Centro de monitoreo y CCTV</td><td>Aeropuertos</td><td>Verificado</td><td>2025</td></tr>
              <tr><td>Mesa técnica con SLA</td><td>Gobierno</td><td>24/7</td><td>2025</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </section>

    <section class="ums2-section ums2-section--dark ums2-section--numerals" id="numerales">
      <div class="ums2-shell">
        <div class="ums2-section-head">
          <div><p class="ums2-kicker">06 · Datos y cifras</p><h2>Números con la misma voz.</h2></div>
          <p>Prueba de cifras tabulares, porcentajes, moneda, fechas, coordenadas e identificadores técnicos.</p>
        </div>
        <div class="ums2-number-grid">
          <article><span>Trayectoria</span><strong>25</strong><p>años de operación</p></article>
          <article><span>Archivo</span><strong>518</strong><p>antecedentes</p></article>
          <article><span>SLA</span><strong>99,98%</strong><p>disponibilidad</p></article>
          <article><span>Incidente</span><strong>2847</strong><p>INC-2847</p></article>
        </div>
        <dl class="ums2-data-ledger">
          <div><dt>Importe</dt><dd>$ 1.234.567,89</dd></div>
          <div><dt>Fecha</dt><dd>14 / 07 / 2026</dd></div>
          <div><dt>Coordenadas</dt><dd>-32.8908, -68.8272</dd></div>
          <div><dt>Operación</dt><dd>24 / 7 · SLA 01:42</dd></div>
        </dl>
      </div>
    </section>

    <section class="ums2-section ums2-section--reading" id="lectura">
      <div class="ums2-shell ums2-reading">
        <div>
          <p class="ums2-kicker">07 · Lectura</p>
          <h2>La precisión también se lee.</h2>
        </div>
        <div class="ums2-prose">
          <p>Cada proyecto empieza por comprender el sitio, sus restricciones y el nivel de continuidad requerido. UM Sans Text sostiene párrafos largos sin que la identidad compita con la información.</p>
          <p>La jerarquía no depende de títulos excesivamente pesados: 600 organiza; 700 enfatiza; 800 y 900 se reservan para momentos de impacto controlado.</p>
        </div>
      </div>
    </section>

    <section class="ums2-section ums2-section--responsive" id="responsive">
      <div class="ums2-shell">
        <div class="ums2-section-head">
          <div><p class="ums2-kicker">08 · Responsive</p><h2>Una voz que cambia de escala, no de criterio.</h2></div>
          <p>Los títulos reducen tamaño, ancho y cantidad de líneas. El cuerpo conserva 16 px como mínimo y un ancho de lectura estable.</p>
        </div>
        <div class="ums2-responsive-proof">
          <article class="ums2-viewport ums2-viewport--desktop">
            <span>1440 × 900</span>
            <h3>Servicios IT para operaciones que no pueden detenerse.</h3>
            <p>Redes, seguridad, software y soporte con evidencia operativa antes de contratar.</p>
          </article>
          <article class="ums2-viewport ums2-viewport--mobile">
            <span>390 × 900</span>
            <h3>Operaciones que no pueden detenerse.</h3>
            <p>Evidencia, alcance y un próximo paso claro.</p>
          </article>
        </div>
        <div class="ums2-rule-ledger">
          <div><strong>32 px</strong><span>Mínimo para impacto 800</span></div>
          <div><strong>3 líneas</strong><span>Máximo recomendado en mobile</span></div>
          <div><strong>16 px</strong><span>Mínimo visible para Text</span></div>
          <div><strong>68 ch</strong><span>Ancho máximo de lectura</span></div>
        </div>
      </div>
    </section>

    <section class="ums2-section ums2-section--dark" id="kerning">
      <div class="ums2-shell">
        <div class="ums2-section-head">
          <div><p class="ums2-kicker">09 · Kerning</p><h2>Pares bajo presión.</h2></div>
          <p>Pruebas críticas de mayúsculas, acentos, signos, cifras y formas ambiguas.</p>
        </div>
        <div class="ums2-kerning">
          <p>AVATAR · VÍNCULO · TÉCNICA</p>
          <p>¿QUÉ? · ¡OPERACIÓN! · ÑANDÚ</p>
          <p>24/7 · 99,98% · $ 1.234.567,89</p>
          <p>IIl1 · O0 · rn/m · cl/d</p>
        </div>
      </div>
    </section>

    <section class="ums2-section" id="opentype">
      <div class="ums2-shell">
        <div class="ums2-section-head">
          <div><p class="ums2-kicker">10 · OpenType</p><h2>Funciones con propósito.</h2></div>
          <p>El conjunto actual prioriza necesidades concretas de lectura y documentación.</p>
        </div>
        <div class="ums2-feature-list">
          {features.map(([tag, sample, detail]) => (
            <article>
              <code>{tag}</code>
              <p>{sample}</p>
              <span>{detail}</span>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="ums2-section ums2-section--repertoire" id="repertorio">
      <div class="ums2-shell">
        <div class="ums2-section-head">
          <div><p class="ums2-kicker">11 · Repertorio</p><h2>Español completo.<br />Información técnica.</h2></div>
          <p>Los pesos de impacto y lectura comparten el mismo repertorio, espaciado y compatibilidad editorial.</p>
        </div>
        <div class="ums2-repertoire">
          {repertoire.map((line) => <p>{line}</p>)}
        </div>
      </div>
    </section>

    <section class="ums2-section" id="escala">
      <div class="ums2-shell">
        <div class="ums2-section-head">
          <div><p class="ums2-kicker">12 · Escala</p><h2>Roles antes que tamaños arbitrarios.</h2></div>
          <p>Base recomendada para la web ULTIMA MILLA; cada viewport conserva proporción y legibilidad.</p>
        </div>
        <div class="ums2-scale">
          {roles.map(([name, value, weight, sample]) => (
            <article>
              <div><strong>{name}</strong><span>{value}</span><span>{weight}</span></div>
              <p class={`ums2-role ums2-role--${name.toLowerCase()}`} style={`font-weight: ${weight}`}>{sample}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="ums2-section ums2-section--delivery" id="entrega">
      <div class="ums2-shell">
        <div class="ums2-section-head">
          <div><p class="ums2-kicker">13 · Entrega</p><h2>Qué existe. Qué falta.</h2></div>
          <p>Una familia profesional también se define por la precisión de sus límites.</p>
        </div>
