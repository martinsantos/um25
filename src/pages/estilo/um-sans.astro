<script>
  const weight = document.querySelector<HTMLInputElement>('#ums2-weight');
  const weightValue = document.querySelector<HTMLOutputElement>('#ums2-weight-value');
  const sample = document.querySelector<HTMLElement>('#ums2-lab-sample');

  const updateLab = () => {
    if (!weight || !weightValue || !sample) return;
    sample.style.fontWeight = weight.value;
    weightValue.value = weight.value;
  };

  weight?.addEventListener('input', updateLab);
  updateLab();
</script>

