---
import LayoutV4 from '../../layouts/LayoutV4.astro';

const showExperimental = Astro.url.searchParams.get('experimental') === '1';
const reviewMode = showExperimental ? 'experimental' : 'stable';
const reviewLabel = showExperimental
  ? 'Corte experimental · no aprobado'
  : 'Referencia verificada · UM Sans Text 1.2';

const controlRows = [
  ['Mayúsculas', 'HHOH OHOH'],
  ['Ritmo redondo', 'nonono oóo'],
  ['Apertura de e', 'eeee cece rere'],
  ['Secuencia e/r/f', 'referencia eficiente'],
  ['Uniones', 'oficina fibra'],
  ['Asta y panza', 'baba dada papa'],
  ['Texto control', 'continuidad certificada'],
  ['Curva de s', 'sostenida'],
] as const;

const inventory = [
  'Aa Bb Cc Dd Ee Ff Gg Hh Ii Jj Kk Ll Mm',
  'Nn Oo Pp Qq Rr Ss Tt Uu Vv Ww Xx Yy Zz',
  'ÁÉÍÓÚÜÑ áéíóúüñ ¿¡ 0123456789 · … → ↗',
] as const;

const extendedInventory = [
  ['Ligaduras y compuestos', 'U+00C6 · U+00E6 · U+0152 · U+0153 · U+0132 · U+0133'],
  ['Barras y eszett', 'U+00D0 · U+00D8 · U+00DE · U+00DF · U+0110 · U+0111 · U+0126 · U+0127 · U+0166 · U+0167'],
  ['Variantes latinas', 'U+0131 · U+0138 · U+013F · U+0140 · U+0141 · U+0142 · U+0149 · U+014A · U+014B · U+017F'],
] as const;

const rasterSizes = [16, 20, 24, 30, 32, 48, 72] as const;
---

<LayoutV4
  title={`UM Sans 2 Manual Alpha · ${showExperimental ? 'corte experimental' : 'referencia verificada'}`}
  description="Specimen interno noindex de UM Sans 2. La referencia estable se muestra por defecto; el corte manual experimental permanece aislado hasta superar la revisión visual y tipográfica."
  noindex={true}
>
  {showExperimental && <link
    slot="head"
    rel="preload"
    href="/fonts/um-sans-2-editorial-candidate/UMSans2-Bold.woff2?v=2.1-latin-a"
    as="font"
    type="font/woff2"
    crossorigin
  />}

  <main class="manual-type ums2" data-review-mode={reviewMode} id="main-content">
    <header class="manual-type__intro">
      <div class="manual-shell manual-type__intro-grid">
        <div>
          <p class="manual-kicker">Proyecto independiente · UM Sans 2 Manual · Alpha</p>
          <h1>UM Sans 2 Manual</h1>
        </div>
        <div class="manual-type__summary">
          <p>Este specimen separa una referencia tipográfica verificada de un corte manual todavía experimental. La producción bloqueada permanece fuera del sitio hasta que el dibujo, el espaciado y el repertorio pasen una revisión visual real.</p>
          <dl>
            <div><dt>Fuente editable</dt><dd>Builder geométrico UMSA</dd></div>
            <div><dt>Corte</dt><dd>Display Bold</dd></div>
            <div><dt>Estado</dt><dd>{reviewLabel}</dd></div>
          </dl>
          <p class="manual-mode-note">
            {showExperimental
              ? 'Estás viendo el corte experimental. No usar como referencia de marca ni como fuente final.'
              : 'La página abre en la referencia estable para evitar mezclar glifos incompletos con la interfaz.'}
          </p>
          <a class="manual-mode-link" href={showExperimental ? Astro.url.pathname : `${Astro.url.pathname}?experimental=1`}>
            {showExperimental ? 'Volver a la referencia verificada' : 'Abrir corte experimental aislado'}
          </a>
        </div>
      </div>
    </header>

    <section class="manual-type__proof" aria-labelledby="proof-title">
      <div class="manual-shell manual-type__proof-grid">
        <div class="manual-type__proof-copy">
          <p class="manual-kicker">Prueba de voz</p>
          <h2 id="proof-title">Una frase. Un corte. Sin sustituciones.</h2>
          <p>{showExperimental ? 'Esta muestra expone el corte manual experimental para detectar fallas de dibujo en palabras reales. Su estado es de revisión: no representa la voz aprobada de la marca.' : 'Esta muestra usa la familia estable verificada. El corte manual se mantiene aislado para que una forma incompleta no se confunda con una decisión de identidad.'}</p>
        </div>
        <p class="manual-alpha manual-type__hero-sample" class:list={{'manual-alpha--candidate': showExperimental}}>Fibra certificada, operación continua.</p>
      </div>
    </section>

    <section class="manual-type__controls" aria-labelledby="controls-title">
      <div class="manual-shell">
        <div class="manual-section-head">
          <div><p class="manual-kicker">Control de dibujo</p><h2 id="controls-title">Forma, ritmo y espaciado.</h2></div>
          <p>Estas cadenas permiten revisar curvas, contraformas, terminales, unión de astas, acento y color de palabra antes de ampliar el repertorio.</p>
        </div>
        <div class="manual-control-list">
          {controlRows.map(([label, sample], index) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{label}</h3>
              <p class="manual-alpha">{sample}</p>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="manual-type__inventory" aria-labelledby="inventory-title">
      <div class="manual-shell manual-type__inventory-grid">
        <div>
          <p class="manual-kicker">Inventario revisado · repertorio disponible</p>
          <h2 id="inventory-title">Solo aparece lo que puede defenderse.</h2>
          <p>Las muestras activas usan la familia estable verificada. Las construcciones manuales y los caracteres extendidos se muestran abajo como pendientes hasta superar el control de dibujo, espaciado y lectura en palabra.</p>
        </div>
        <div class="manual-type__glyph-lines" aria-label="Glifos disponibles">
          {inventory.map((line) => <p class="manual-alpha">{line}</p>)}
        </div>
        <div class="manual-type__extended" aria-label="Repertorio pendiente de dibujo">
          {extendedInventory.map(([label, sample]) => (
            <div class="manual-type__extended-row manual-type__extended-row--pending">
              <div>
                <span>Pendiente de dibujo óptico</span>
                <h3>{label}</h3>
              </div>
              <div>
                <p class="manual-pending-codepoints">{sample}</p>
                <p class="manual-pending-note">Glifos no dibujados. Se muestra el inventario técnico, no una forma visual falsa ni disponible para producción.</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="manual-type__raster" aria-labelledby="raster-title">
      <div class="manual-shell">
        <div class="manual-section-head">
          <div><p class="manual-kicker">Control de raster</p><h2 id="raster-title">La forma debe sobrevivir a cada escala.</h2></div>
          <p>La alfa se rechaza si la contraforma de la e se cierra, si f/r abren huecos o si el ritmo deja de ser uniforme en cualquiera de estos tamaños.</p>
        </div>
        <div class="manual-raster-list">
          {rasterSizes.map((size) => (
            <article style={`--manual-raster-size: ${size}px`}>
              <span>{size}px</span>
              <div>
                <p class="manual-alpha">eeee cece rere</p>
                <p class="manual-alpha">referencia eficiente</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>

    <section class="manual-type__source" aria-labelledby="source-title">
      <div class="manual-shell">
        <div class="manual-section-head">
          <div><p class="manual-kicker">Fuente de verdad</p><h2 id="source-title">El UFO se edita; el OTF solo prueba.</h2></div>
          <p>La compilación convierte las curvas geométricas UMSA para navegador sin leer ni transformar contornos de una familia de terceros.</p>
        </div>
        <dl class="manual-source-ledger">
          <div><dt>Master</dt><dd>scripts/fonts/build_um_sans_2.py</dd></div>
          <div><dt>Especificación</dt><dd>public/fonts/um-sans-2-editorial-candidate/provenance.json</dd></div>
          <div><dt>Proof web</dt><dd>UMSans2-Bold.woff2 · Candidate 2.1</dd></div>
          <div><dt>Uso autorizado</dt><dd>Solo este specimen local noindex</dd></div>
        </dl>
      </div>
    </section>

    <section class="manual-type__gate" aria-labelledby="gate-title">
      <div class="manual-shell manual-type__gate-grid">
        <div>
          <p class="manual-kicker">Gate de diseño</p>
          <h2 id="gate-title">La siguiente fase empieza solo si este corte funciona.</h2>
        </div>
        <ol>
          <li>Validar curvas y color en palabras en desktop, móvil, impresión y rasterizado pequeño.</li>
          <li>Corregir la topología de las itálicas pesadas y repetir la prueba de contornos.</li>
          <li>Revisar espaciado y kerning con texto real, no solo con glifos aislados.</li>
          <li>Comparar el repertorio completo con lectores nativos y herramientas tipográficas.</li>
          <li>Solo después estudiar la autorización de Regular, Text, variable y producción.</li>
        </ol>
      </div>
    </section>
  </main>
</LayoutV4>

<style is:global>
  @font-face {
    font-family: 'UM Sans 2 Editorial Candidate';
    src: url('/fonts/um-sans-2-editorial-candidate/UMSans2-Bold.woff2?v=2.1-latin-a') format('woff2');
    font-style: normal;
    font-weight: 700;
    font-display: swap;
  }

  .manual-type {
    --manual-red: #dc2626;
    --manual-ink: #111214;
    --manual-muted: #5f646c;
    --manual-line: #d8dade;
    --manual-paper: #f6f6f4;
    --manual-preview-font: var(--um-font-editorial);
    background: #fff;
    color: var(--manual-ink);
    font-family: var(--um-font-body);
    font-size: 16px;
  }

  .manual-type section,
  .manual-type [id] {
    scroll-margin-top: 112px !important;
  }

  .manual-shell {
    width: min(1180px, calc(100% - 48px));
    margin-inline: auto;
  }

  .manual-alpha {
    font-family: var(--manual-preview-font), Arial, sans-serif;
    font-synthesis: none;
    font-weight: 700;
    font-kerning: normal;
    font-feature-settings: 'kern' 1, 'liga' 1;
    letter-spacing: 0;
    text-rendering: auto;
  }

  .manual-type[data-review-mode="experimental"] {
    --manual-preview-font: 'UM Sans 2 Editorial Candidate';
  }

  .manual-alpha--candidate {
    color: #fff;
  }

  .manual-mode-note {
    margin: 22px 0 12px;
    color: var(--manual-muted);
    font-size: 16px;
    line-height: 1.5;
  }

  .manual-mode-link {
    display: inline-block;
    color: var(--manual-ink);
    font-size: 16px;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: var(--manual-red);
    text-decoration-thickness: 2px;
    text-underline-offset: 5px;
  }

  body[data-skin] main .manual-type .manual-alpha {
    color: inherit !important;
  }

  .manual-kicker {
    margin: 0 0 18px;
    color: var(--manual-red);
    font-size: 16px;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.35;
    text-transform: uppercase;
  }

  body[data-skin] main .manual-type .manual-kicker {
    color: var(--manual-red) !important;
  }

  .manual-type h1,
  .manual-type h2,
  .manual-type h3,
  .manual-type p,
  .manual-type dl,
  .manual-type ol {
    margin-top: 0;
  }

  .manual-type h1,
  .manual-type h2,
  .manual-type h3 {
    font-family: var(--um-font-display);
    letter-spacing: 0;
  }

  .manual-type h1 {
    max-width: 680px;
    margin-bottom: 0;
    font-size: clamp(44px, 7vw, 76px);
    font-weight: 700;
    line-height: 1.02;
  }

  .manual-type h2 {
    margin-bottom: 22px;
    font-size: clamp(30px, 4.2vw, 48px);
    font-weight: 650;
    line-height: 1.04;
  }

  .manual-type__intro {
    padding: clamp(68px, 9vw, 112px) 0;
    background: var(--manual-paper);
  }

  .manual-type__intro-grid,
  .manual-type__proof-grid,
  .manual-type__inventory-grid,
  .manual-type__gate-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.12fr) minmax(320px, 0.88fr);
    gap: clamp(48px, 8vw, 110px);
    align-items: start;
  }

  .manual-type__proof-grid > *,
  .manual-control-list article > * {
    min-width: 0;
  }

  .manual-type__summary > p,
  .manual-type__proof-copy > p,
  .manual-section-head > p,
  .manual-type__inventory-grid > div:first-child > p {
    color: var(--manual-muted);
    font-size: 18px;
    line-height: 1.65;
  }

  .manual-type__summary dl {
    margin-bottom: 0;
    border-top: 1px solid var(--manual-line);
  }

  .manual-type__summary dl div {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    padding: 15px 0;
    border-bottom: 1px solid var(--manual-line);
  }

  .manual-type dt {
    color: var(--manual-muted);
    font-weight: 500;
  }

  .manual-type dd {
    margin: 0;
    font-weight: 700;
  }

  .manual-type__proof {
    padding: clamp(72px, 10vw, 132px) 0;
    background: #0b0c0e;
    color: #fff;
  }

  .manual-type__proof-copy > p {
    color: rgba(255, 255, 255, 0.72);
  }

  body[data-skin] main .manual-type__proof .manual-type__proof-copy > p {
    color: rgba(255, 255, 255, 0.76) !important;
  }

  .manual-type__hero-sample {
    max-width: 820px;
    width: 100%;
    margin: 0;
    color: #fff;
    font-size: clamp(48px, 5.8vw, 72px);
    line-height: 1.04;
    letter-spacing: 0;
    text-wrap: pretty;
  }

  .manual-type__proof-grid {
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
  }

  .manual-type__controls,
  .manual-type__inventory,
  .manual-type__raster,
  .manual-type__source,
  .manual-type__gate {
    padding: clamp(72px, 9vw, 116px) 0;
  }

  .manual-section-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.72fr);
    gap: 64px;
    align-items: end;
    margin-bottom: 54px;
  }

  .manual-section-head h2 {
    margin-bottom: 0;
  }

  .manual-control-list {
    border-top: 1px solid var(--manual-line);
  }

  .manual-control-list article {
    display: grid;
    grid-template-columns: 58px minmax(160px, 0.42fr) minmax(0, 1fr);
    gap: 24px;
    align-items: baseline;
    padding: 26px 0;
    border-bottom: 1px solid var(--manual-line);
  }

  .manual-control-list article > span {
    color: var(--manual-red);
    font-weight: 700;
  }

  .manual-control-list h3 {
    margin-bottom: 0;
    font-size: 20px;
    line-height: 1.25;
  }

  .manual-control-list .manual-alpha {
    margin-bottom: 0;
    font-size: clamp(42px, 5.4vw, 68px);
    line-height: 1.06;
    letter-spacing: 0;
  }

  .manual-type__inventory {
    background: var(--manual-paper);
  }

  .manual-type__raster {
    background: #fff;
    border-bottom: 1px solid var(--manual-line);
  }

  .manual-raster-list {
    border-top: 1px solid var(--manual-ink);
  }

  .manual-raster-list article {
    display: grid;
    grid-template-columns: 84px minmax(0, 1fr);
    gap: 28px;
    align-items: start;
    padding: 22px 0;
    border-bottom: 1px solid var(--manual-line);
  }

  .manual-raster-list article > span {
    padding-top: 0.2em;
    color: var(--manual-red);
    font-size: 16px;
    font-weight: 700;
    line-height: 1;
  }

  .manual-raster-list article p {
    margin-bottom: 8px;
    font-size: var(--manual-raster-size);
    line-height: 1.12;
  }

  .manual-raster-list article p:last-child {
    margin-bottom: 0;
  }

  .manual-type__glyph-lines {
    border-left: 3px solid var(--manual-red);
    padding-left: clamp(24px, 4vw, 52px);
  }

  .manual-type__glyph-lines p {
    margin-bottom: 24px;
    font-size: clamp(32px, 5vw, 58px);
    line-height: 1.05;
    overflow-wrap: anywhere;
  }

  .manual-type__extended {
    grid-column: 1 / -1;
    margin-top: 4px;
    border-top: 1px solid var(--manual-line);
  }

  .manual-type__extended-row {
    display: grid;
    grid-template-columns: minmax(180px, 0.35fr) minmax(0, 1fr);
    gap: 32px;
    align-items: baseline;
    padding: 22px 0;
    border-bottom: 1px solid var(--manual-line);
  }

  .manual-type__extended-row > span {
    color: var(--manual-muted);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
  }

  .manual-type__extended-row--pending {
    align-items: start;
  }

  .manual-type__extended-row--pending h3 {
    margin: 10px 0 0;
    font-family: var(--um-font-display);
    font-size: 22px;
    font-weight: 600;
    line-height: 1.2;
  }

  .manual-type__extended-row--pending > div:first-child > span {
    color: var(--manual-red);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.3;
    text-transform: uppercase;
  }

  .manual-pending-codepoints {
    margin: 0;
    color: var(--manual-muted);
    font-family: ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    font-size: 16px;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .manual-pending-note {
    margin: 12px 0 0;
    color: var(--manual-muted);
    font-size: 16px;
    line-height: 1.5;
  }

  .manual-type__extended-row .manual-alpha {
    margin: 0;
    font-size: clamp(30px, 4vw, 52px);
    line-height: 1;
    overflow-wrap: anywhere;
  }

  .manual-type__source {
    border-bottom: 1px solid var(--manual-line);
  }

  .manual-source-ledger {
    border-top: 1px solid var(--manual-ink);
  }

  .manual-source-ledger div {
    display: grid;
    grid-template-columns: minmax(180px, 0.35fr) minmax(0, 1fr);
    gap: 32px;
    padding: 22px 0;
    border-bottom: 1px solid var(--manual-line);
  }

  .manual-source-ledger dd {
    overflow-wrap: anywhere;
  }

  .manual-type__gate-grid ol {
    margin-bottom: 0;
    padding-left: 24px;
  }

  .manual-type__gate-grid li {
    padding: 0 0 18px 8px;
    color: var(--manual-muted);
    font-size: 18px;
    line-height: 1.55;
  }

  @media (max-width: 760px) {
    .manual-shell {
      width: min(100% - 32px, 1180px);
    }

    .manual-type__intro {
      padding: 52px 0 64px;
    }

    .manual-type__intro-grid,
    .manual-type__proof-grid,
    .manual-type__inventory-grid,
    .manual-type__gate-grid,
    .manual-section-head {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .manual-type h1 {
      font-size: clamp(42px, 13vw, 56px);
      line-height: 1;
    }

    .manual-type h2 {
      font-size: clamp(30px, 9vw, 38px);
      line-height: 1.08;
    }

    .manual-type__hero-sample {
      margin-top: 8px;
      max-width: 420px;
      font-size: clamp(30px, 8vw, 38px);
      line-height: 1.02;
      letter-spacing: 0;
      overflow-wrap: normal;
      word-break: normal;
      text-wrap: pretty;
    }

    .manual-section-head {
      margin-bottom: 38px;
    }

    .manual-control-list article {
      grid-template-columns: 40px minmax(0, 1fr);
      gap: 8px 16px;
      padding: 24px 0 28px;
    }

    .manual-control-list article .manual-alpha {
      grid-column: 1 / -1;
      padding-top: 10px;
      font-size: clamp(38px, 11vw, 50px);
      line-height: 1.06;
      letter-spacing: 0;
    }

    .manual-raster-list article {
      grid-template-columns: 52px minmax(0, 1fr);
      gap: 16px;
    }

    .manual-raster-list article div {
      min-width: 0;
      overflow: hidden;
    }

    .manual-raster-list article p {
      overflow-wrap: normal;
      word-break: normal;
    }

    .manual-source-ledger div {
      grid-template-columns: 1fr;
      gap: 7px;
    }

    .manual-type__extended-row {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .manual-type__extended-row .manual-alpha {
      font-size: clamp(28px, 9vw, 42px);
      line-height: 1.08;
    }

    .manual-type__extended-row--pending {
      gap: 18px;
    }

    .manual-pending-codepoints {
      font-size: 16px;
    }
  }
</style>
