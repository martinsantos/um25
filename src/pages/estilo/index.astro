---
import { authenticate, loginDirectus, sessionCookie, clearCookie } from '../../lib/estilo-auth';
import htmlContent from '../../assets/estilo/sistema-estilo-umsa.html?raw';

// ── Manejo de POST (login desde browser) ─────────────────────────────────────
if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const email    = String(form.get('email') || '');
  const password = String(form.get('password') || '');

  const login = await loginDirectus(email, password);

  if (login.ok && login.token) {
    return new Response(null, {
      status: 302,
      headers: {
        Location: '/estilo',
        'Set-Cookie': sessionCookie(login.token),
      },
    });
  }

  // Login fallido → mostrar formulario con error
  return new Response(loginPage(login.error || 'Credenciales inválidas'), {
    status: 401,
    headers: { 'Content-Type': 'text/html; charset=utf-8' },
  });
}

// ── Verificación de auth ──────────────────────────────────────────────────────
const auth = await authenticate(Astro.request);

if (!auth.ok) {
  const isService = !Astro.request.headers.get('Accept')?.includes('text/html');

  // Servicios/agentes → 401 JSON limpio
  if (isService) {
    return new Response(JSON.stringify({ error: 'Unauthorized', hint: 'Authorization: Bearer <directus_token>' }), {
      status: 401,
      headers: { 'Content-Type': 'application/json' },
    });
  }

  // Browser sin auth → formulario de login
  return new Response(loginPage(), {
    status: 200,
    headers: {
      'Content-Type': 'text/html; charset=utf-8',
      'X-Robots-Tag': 'noindex, nofollow, noarchive, nosnippet',
      'Set-Cookie': clearCookie(),
    },
  });
}

// ── Auth OK → devolver el HTML del sistema de diseño ─────────────────────────
return new Response(htmlContent, {
  status: 200,
  headers: {
    'Content-Type': 'text/html; charset=utf-8',
    'Cache-Control': 'private, no-store',
    'X-Robots-Tag': 'noindex, nofollow, noarchive, nosnippet',
    ...(auth.source === 'cookie' && auth.token
      ? { 'Set-Cookie': sessionCookie(auth.token) }
      : {}),
  },
});

// ── Helper: página de login ───────────────────────────────────────────────────
function loginPage(error?: string): string {
  return `<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Acceso restringido — ULTIMA MILLA</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <style>
    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      font-family: 'Inter', sans-serif;
      background: #0a0f1e;
      color: #e2e8f0;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
    }
    .card {
      background: #111827;
      border: 1px solid #1e3a5f;
      border-radius: 12px;
      padding: 2.5rem;
      width: 100%;
      max-width: 380px;
    }
    .logo {
      font-size: 0.7rem;
      font-weight: 600;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: #3b82f6;
      margin-bottom: 0.5rem;
    }
    h1 {
      font-size: 1.25rem;
      font-weight: 600;
      color: #f1f5f9;
      margin-bottom: 2rem;
    }
    label {
      display: block;
      font-size: 0.75rem;
      font-weight: 500;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      color: #94a3b8;
      margin-bottom: 0.4rem;
    }
    input {
      width: 100%;
      background: #0a0f1e;
      border: 1px solid #1e3a5f;
      border-radius: 6px;
      padding: 0.65rem 0.9rem;
      font-size: 0.9rem;
      color: #e2e8f0;
      margin-bottom: 1.2rem;
      outline: none;
      transition: border-color 0.2s;
    }
    input:focus { border-color: #3b82f6; }
    button {
      width: 100%;
      background: #1d4ed8;
      color: #fff;
      border: none;
      border-radius: 6px;
      padding: 0.75rem;
      font-size: 0.9rem;
      font-weight: 600;
      cursor: pointer;
      transition: background 0.2s;
    }
    button:hover { background: #2563eb; }
    .error {
      background: rgba(239,68,68,0.1);
      border: 1px solid rgba(239,68,68,0.3);
      border-radius: 6px;
      padding: 0.6rem 0.9rem;
      font-size: 0.82rem;
      color: #fca5a5;
      margin-bottom: 1.2rem;
    }
    .hint {
      margin-top: 1.5rem;
      font-size: 0.72rem;
      color: #475569;
      line-height: 1.6;
    }
    code {
      font-family: monospace;
      background: #0a0f1e;
      padding: 0.1em 0.4em;
      border-radius: 3px;
      color: #60a5fa;
    }
  </style>
</head>
<body>
  <div class="card">
    <div class="logo">Ultima Milla S.A.</div>
    <h1>Sistema de Diseño</h1>
    ${error ? `<div class="error">${error}</div>` : ''}
    <form method="POST">
      <label for="email">Email</label>
      <input type="email" id="email" name="email" required autofocus placeholder="usuario@ultimamilla.com.ar">
      <label for="password">Contraseña</label>
      <input type="password" id="password" name="password" required placeholder="••••••••">
      <button type="submit">Acceder</button>
    </form>
    <div class="hint">
      Para acceso programático:<br>
      <code>Authorization: Bearer &lt;directus_token&gt;</code>
    </div>
  </div>
</body>
</html>`;
}
---
