---
import LayoutV4 from '../../../layouts/LayoutV4.astro';
import '../../../styles/brand-resources.css';
import reading from '../../../data/brand-template-reading.json';
const base = '/downloads/plantillas-um-sans/2026.10.09-r3';
const templates = [
  { id: 'oferta-completa', sample: 'ejemplo-licitacion', number: '01', title: 'Oferta completa', pages: 'Word · A4', description: 'Una propuesta de principio a fin: alcance, solución técnica, entregables, inversión y condiciones.', details: ['Numeración automática en tres niveles', 'Títulos y cifras con tamaños proporcionales', 'Tablas preparadas para continuar en otra página'], primary: 'DOCX', action: 'Descargar plantilla Word', formats: ['DOTX','ODT','HTML','PDF'] },
  { id: 'resumen-comercial', number: '02', title: 'Resumen comercial', pages: '1 página · A4', description: 'El alcance, la inversión y las condiciones esenciales en una presentación breve.', details: ['Jerarquía clara para leer de un vistazo', 'Espacio para identificar al cliente y al proyecto', 'Tabla de inversión y total'], primary: 'DOCX', action: 'Descargar Word', formats: ['DOTX','ODT','HTML','PDF'] },
  { id: 'membrete', number: '03', title: 'Carta con membrete', pages: '1 página · A4', description: 'Una base de correspondencia para comunicar una decisión, presentar una solicitud o acompañar documentación.', details: ['Destinatario, fecha y referencia', 'Cuerpo de carta con espacio para desarrollar', 'Cierre y firma'], primary: 'DOCX', action: 'Descargar Word', formats: ['DOTX','ODT','HTML','PDF'] },
  { id: 'oferta-economica', sample: 'ejemplo-economico', number: '04', title: 'Planilla económica', pages: 'Excel · Impresión A4', description: 'Cantidades, precios e importes en una misma grilla. El detalle alimenta el subtotal y el total de la oferta.', details: ['15 renglones con cálculo de importes', 'Validación de cantidades y precios', 'Control de datos incompletos antes del total'], primary: 'XLSX', action: 'Descargar plantilla Excel', formats: ['PDF'] },
  { id: 'presupuesto-interno', number: '05', title: 'Presupuesto interno', pages: 'Excel · Cuatro hojas', description: 'Cómputo por renglón y sector, materiales, mano de obra, márgenes y comparación de proveedores.', details: ['Resultado, Costeo, Parámetros y Proveedores', 'Costos USD / ARS y tarifas DH / HH', 'Imprevistos, bonificación e IVA sobre el neto'], primary: 'XLSX', action: 'Descargar libro de presupuesto', formats: ['PDF'] },
];
---
<LayoutV4 title="RECURSOS MARCA UMSA" description="Plantillas de propuesta, resumen, carta y planilla económica. UM Sans 2, marca oficial y vistas previas de los archivos reales.">
  <div id="um-resources" class="resource-library">
    <header class="rl-cover rl-shell">
      <a class="rl-back" href="/estilo/fuente">← UM Sans 2</a>
      <h1>RECURSOS MARCA UMSA</h1>
      <div class="rl-cover-bottom"><p>Plantillas para licitaciones, propuestas y comunicaciones.</p><div><a class="rl-button" href={base+'/Plantillas-UMSans2-2026.10.09-r3.zip'} download>Descargar todo ↗</a><a class="rl-text-link" href="/fonts/um-sans/v2.0.0/UMSans2-2.0.0.zip" download>Fuentes UM Sans 2</a></div></div>
    </header>
    <nav class="rl-index rl-shell" aria-label="Elegir plantilla">{templates.map(t=><a href={'#'+t.id}><span>{t.number}</span>{t.title}</a>)}</nav>
    <div class="rl-collection">
      {templates.map(t=><section class="rl-item rl-shell" id={t.id} aria-labelledby={t.id+'-title'}>
        <div class="rl-info">
        <div class="rl-copy">
          <p class="rl-eyebrow">{t.number} / {t.pages}</p>
          <h2 id={t.id+'-title'}>{t.title}</h2>
          {t.id==='oferta-economica'&&<span id="template-economy-title" class="rl-anchor" />}
          <p class="rl-description">{t.description}</p>
          <ul>{t.details.map(detail=><li>{detail}</li>)}</ul>
        </div>
        <div class="rl-actions">
          <a class="rl-button" href={base+'/'+t.id+'.'+t.primary.toLowerCase()} download>{t.action} ↗</a>
          <details class="rl-download-options"><summary>{'sample' in t?'Otros formatos y ejemplo':'Otros formatos'}</summary>
          <div class="rl-formats" aria-label={'Otros formatos de '+t.title}>{t.formats.map(format=><a href={base+'/'+t.id+'.'+format.toLowerCase()} download={format==='HTML'||format==='PDF'?undefined:true}>{format==='HTML'?'Editar en navegador':format==='PDF'?'Ver PDF':format}</a>)}</div>
          {'sample' in t && <div class="rl-example-downloads"><span>Ejemplo completado</span><a href={base+'/'+t.sample+'.'+t.primary.toLowerCase()} download>{t.primary==='XLSX'?'Excel':'Word'} ↗</a><a href={base+'/'+t.sample+'.pdf'}>PDF ↗</a></div>}
          </details>
        </div>
        </div>
        <div class="rl-paper-column">
          {'sample' in t && <div class="rl-reading-modes" role="group" aria-label={'Contenido de '+t.title}><button type="button" data-reading-choice="example" aria-pressed="true">Ejemplo</button><button type="button" data-reading-choice="blank" aria-pressed="false">Plantilla vacía</button></div>}
          <div class="rl-reading-bar"><span data-reading-label>{'sample' in t?'Ejemplo ficticio':'Vista de lectura'}</span><button type="button" data-resource-preview={base+'/'+('sample' in t?t.sample:t.id)+'.svg'} data-preview-title={t.title} data-preview-pdf={base+'/'+('sample' in t?t.sample:t.id)+'.pdf'} data-blank-preview={base+'/'+t.id} data-example-preview={'sample' in t?base+'/'+t.sample:undefined} aria-label={'Ver composición A4 de '+t.title}>Ver hoja A4 ↗</button></div>
          <div class="rl-reading-frame" role="region" aria-label={'Documento completo de '+t.title}>
            <div class="rl-reading">
              <div class="rl-reading-brand"><img src="/images/brand-document.svg" width="607" height="54" alt="ultimamilla.com.ar" /></div>
              <div class="rl-reading-body" data-reading-mode="blank" hidden={'sample' in t} set:html={reading[t.id as keyof typeof reading]} />
              {'sample' in t && <div class="rl-reading-body" data-reading-mode="example" set:html={reading[t.sample as keyof typeof reading]} />}
              <p class="doc-footer">ULTIMA MILLA S.A. · ultimamilla.com.ar</p>
            </div>
          </div>
          <p class="rl-caption">Documento completo, adaptado a tu pantalla. «Ver hoja A4» muestra la composición de impresión.</p>
        </div>
      </section>)}
    </div>
    <section class="rl-use"><div class="rl-shell">
      <p class="rl-eyebrow">ANTES DE EMPEZAR</p><h2>Prepará tu documento.</h2>
      <div class="rl-use-grid"><article><span>01</span><h3>Instalá la familia.</h3><p>El paquete incluye los cuatro TTF necesarios para editar Word y Excel con UM Sans 2.</p></article><article><span>02</span><h3>Usá los estilos.</h3><p>En Word, aplicá Título 1, 2 o 3. La numeración y las sangrías se ajustan juntas.</p></article><article><span>03</span><h3>Revisá la entrega.</h3><p>Completá los campos, comprobá los importes y exportá el documento final a PDF.</p></article></div>
    </div></section>
    <dialog id="resource-viewer" aria-labelledby="resource-viewer-title"><div class="rl-dialog-head"><strong id="resource-viewer-title">Vista previa</strong><a id="resource-viewer-pdf" href="#">Ver PDF completo ↗</a><button type="button" id="resource-viewer-zoom" aria-pressed="false">Ampliar</button><button type="button" id="resource-viewer-close" aria-label="Cerrar vista previa">Cerrar ×</button></div><div class="rl-dialog-paper"><img id="resource-viewer-image" width="595" height="842" alt="" /></div></dialog>
  </div>
</LayoutV4>
<script>
  import { initResourcePreviews } from '../../../scripts/resourcePreviews';
  initResourcePreviews();
  document.addEventListener('astro:page-load', initResourcePreviews);
</script>
