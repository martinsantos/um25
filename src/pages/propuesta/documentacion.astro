---
/** Documentación técnica (2026-10-30): lo que entrega cada obra (página de certificaciones) y las fichas técnicas de cada servicio. No indexable. */
import '../../styles/proto-despiece.css';
import Head from '../../components/proto/Head.astro';
import Top from '../../components/proto/Top.astro';
import Cierre from '../../components/proto/Cierre.astro';
import { CUMPLIMIENTO } from '../../components/proto/relato';
import { SERVICE_SPEC_LIST } from '../../data/serviceSpecs';
import { getDatasheetPublicPath } from '../../utils/datasheets';

export const prerender = false;
const fichas = SERVICE_SPEC_LIST.map((s) => ({ ...s, pdf: getDatasheetPublicPath(s.slug) }));
---
<!doctype html>
<html lang="es">
  <head>
    <Head title="Documentación técnica para compras, auditorías y licitaciones · ULTIMA MILLA" />
    <style>
      .fichas-tec { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); }
      .fichas-tec li { display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 4fr) minmax(0, 3fr) auto; gap: var(--s2) var(--s4); padding: var(--s3) 0; border-bottom: 1px solid var(--line-2); align-items: baseline; }
      .fichas-tec b { font-size: 1.15rem; font-weight: 600; }
      .fichas-tec span { color: var(--ink-2); }
      .fichas-tec .small { color: var(--ink-3); }
      .fichas-tec a { color: var(--ink); border-bottom: 1px solid var(--red); white-space: nowrap; }
      @media (max-width: 900px) { .fichas-tec li { grid-template-columns: 1fr; gap: 6px; } }
    </style>
  </head>
  <body>
    <Top />
    <main class="wrap">
      <div class="cabecera">
        <h1>Documentación técnica para compras, auditorías y licitaciones<span class="dot">.</span></h1>
        <p>ULTIMA MILLA entrega con cada proyecto los protocolos, las mediciones y la documentación de obra que respaldan lo ejecutado, listos para compras, auditoría o pliego.</p>
      </div>
    </main>
    <section class="sec">
      <div class="wrap">
        <div class="sec__head"><h2>Cada obra se entrega medida, documentada y trazable<span class="dot">.</span></h2><p>Dossiers para licitaciones y auditorías de proveedor, bajo solicitud comercial.</p></div>
        <div class="cols cols-3">{CUMPLIMIENTO.map(([t, d]) => <div class="item"><h3>{t}</h3><p>{d}</p></div>)}</div>
      </div>
    </section>
    <section class="sec">
      <div class="wrap">
        <div class="sec__head"><h2>Fichas técnicas por servicio<span class="dot">.</span></h2><p>Alcance, normas, entregables y nivel de servicio de cada frente, para adjuntar a un pliego o una evaluación de proveedor.</p></div>
        <ol class="fichas-tec">{fichas.map((f) => <li><b>{f.name}</b><span>{f.keyDeliverable}</span><span class="small">{f.keyStandard}</span>{f.pdf ? <a href={f.pdf} download>Descargar PDF</a> : <a href={`/propuesta/servicios/${f.code}`}>Ver servicio</a>}</li>)}</ol>
      </div>
    </section>
    <Cierre />
  </body>
</html>
