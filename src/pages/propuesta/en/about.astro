---
import '../../../styles/proto-despiece.css';
import { ArrowDown, ArrowRight, MapPin } from 'lucide-astro';
import { BUSINESS_ADDRESS } from '../../../config/seo';
import { FOUNDING_DATE } from '../../../config/publicFacts';
import Head from '../../../components/proto/Head.astro';
import Top from '../../../components/proto/Top.astro';
import Apertura from '../../../components/proto/Apertura.astro';
import Cierre from '../../../components/proto/Cierre.astro';
import DocumentacionDeObra from '../../../components/proto/DocumentacionDeObra.astro';
import ObrasPortada from '../../../components/proto/ObrasPortada.astro';
import { loadStories } from '../../../components/proto/isoData';
import { portadaCases, type Project } from '../../../components/proto/portadaCases';

export const prerender = false;
const { stories, total } = await loadStories();
const cover = '/images/editorial/umsa-about-engineering.webp';
const dossier = stories.find(story => story.id === 3102);
const copy: Record<string, Pick<Project, 'title' | 'editorialScope' | 'editorialEvidence'>> = {
  aeropuerto: {
    title: 'Fire detection for operational areas at El Plumerillo Airport',
    editorialScope: 'We installed fire detection in the car park and auxiliary buildings during the airport upgrade. A separate project covered airfield lighting and central maintenance.',
    editorialEvidence: [['3', 'control panels for the airfield lighting project']],
  },
  energia: {
    title: 'New distribution boards for the court’s IT circuits',
    editorialScope: 'We upgraded the distribution boards in Building II in San Martín, using IP65 main enclosures and auxiliary units.',
    editorialEvidence: [['8', 'distribution boards'], ['120', 'connection points per main enclosure']],
  },
  justicia: {
    title: 'User and document verification for the court portal',
    editorialScope: 'We integrated user validation, time-stamped document certification and an enquiry assistant connected to the court’s internal web services.',
  },
};
const works = portadaCases(stories, 'nosotros').flatMap(work => {
  const translation = copy[work.key];
  if (!translation) return [];
  return [{
    ...work, ...translation, measure: undefined,
    links: work.links.map(link => ({
      href: link.href,
      label: work.key === 'aeropuerto' ? (link.href.endsWith('#archivo-10737') ? 'Airport upgrade (ES)' : 'Airfield lighting (ES)') : 'View project (ES)',
    })),
  }];
});
---
<!doctype html>
<html lang="en">
  <head>
    <Head lang="en" title="About ULTIMA MILLA · IT infrastructure Argentina"
      description="Engineering, field execution, documentation and ongoing support from ULTIMA MILLA, an IT infrastructure team based in Mendoza, Argentina."
      image={cover} precargar />
  </head>
  <body>
    <Top lang="en" current="about" />
    <main id="contenido" tabindex="-1">
      <Apertura label="About ULTIMA MILLA" image={cover}>
        <p>Mendoza, Argentina · In the field since {FOUNDING_DATE.slice(0, 4)}</p>
        <h1>A technical company for operations that cannot stop<span class="dot">.</span></h1>
        <p>We design, install and support networks, electronic security, software and electrical infrastructure for organisations that need to keep operating.</p>
        <nav class="action-links" aria-label="Explore the company">
          <a class="btn" href="#documentacion-de-obra">How we document work <ArrowDown size={17} aria-hidden="true" /></a>
          {works.length > 0 && <a class="u" href="#casos">View projects <ArrowDown size={17} aria-hidden="true" /></a>}
        </nav>
      </Apertura>

      <ObrasPortada obras={works} title="Selected projects" destinationLanguage="es-AR"
        jump={{label: `Browse all ${total} projects (ES)`, href: '/antecedentes'}} />

      <section class="sec" aria-labelledby="method-heading">
        <div class="wrap">
          <header class="sec__head">
            <h2 id="method-heading">How we work<span class="dot">.</span></h2>
            <p>We assess the site, integrate the systems, test them and document what the operating team takes over.</p>
          </header>
          <DocumentacionDeObra story={dossier} lang="en" />
        </div>
      </section>

      <section class="sec" aria-labelledby="base-heading">
        <div class="wrap cols cols-5-7">
          <h2 id="base-heading">Based in Mendoza<span class="dot">.</span></h2>
          <div class="location">
            <p><MapPin size={21} aria-hidden="true" /> {BUSINESS_ADDRESS.streetAddress}, {BUSINESS_ADDRESS.addressLocality}, {BUSINESS_ADDRESS.addressRegion}</p>
            <p>We support projects across Cuyo, Patagonia and other regions of Argentina.</p>
            <nav class="action-links" aria-label="Next steps">
              <a class="u" href="/en/services">Compare services <ArrowRight size={16} aria-hidden="true" /></a>
              <a class="u" href="/nosotros" hreflang="es-AR">About us in Spanish <ArrowRight size={16} aria-hidden="true" /></a>
            </nav>
          </div>
        </div>
      </section>
    </main>
    <Cierre lang="en" />
  </body>
</html>

<style>
  .location p:first-child { display:flex; align-items:flex-start; gap:10px; font-weight:600; }
  .location p + p { margin-top:8px; color:var(--ink-2); }
  .location svg { flex:none; margin-top:3px; color:var(--red-text); }
  .location a { display:inline-flex; align-items:center; gap:6px; min-height:44px; }
</style>
