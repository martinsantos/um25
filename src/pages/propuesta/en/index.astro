---
/** English overview (2026-10-30): the texts of the production English pages, in the same system. Not indexable. */
import '../../../styles/proto-despiece.css';
import Head from '../../../components/proto/Head.astro';
import Top from '../../../components/proto/Top.astro';
import Apertura from '../../../components/proto/Apertura.astro';
import TrustStrip from '../../../components/um/TrustStrip.astro';
import Cierre from '../../../components/proto/Cierre.astro';
import { loadStories, isoSrc, filmOf } from '../../../components/proto/isoData';
import { yearsOfExperience } from '../../../config/publicFacts';
export const prerender = false;
const { total } = await loadStories();
---
<!doctype html>
<html lang="en">
  <head><Head title="ULTIMA MILLA · IT services for critical operations" description="Networks, electronic security, telecom, custom software, energy and on-site support for organizations that need continuity, evidence and accountable delivery." image="/cine/media/cine-fachada-poster.jpg" lang="en" precargar /></head>
  <body>
    <Top lang="en" />
    <main id="contenido">
    <Apertura label="Overview" isoSrc={isoSrc('building')} image={filmOf('constructoras').poster} film={filmOf('constructoras').film} poster={filmOf('constructoras').poster} hero>
      <span class="small">IT services since 2003. Mendoza, Argentina.</span>
      <h1>IT services for operations that cannot stop<span class="dot">.</span></h1>
      <p>Networks, electronic security, telecom, custom software, energy and on-site support for organizations that need continuity, evidence and accountable delivery.</p>
      <div class="action-links"><a class="btn" href="/en/contact">Request assessment</a><a class="u" href="/en/services">Services</a><a class="u" href="/en/about">About us</a></div>
      <a class="u" href="/antecedentes">{total} documented projects in catalog</a>
    </Apertura>
    <section class="sec"><div class="wrap cols cols-5-7">
      <h2>Evidence<span class="dot">.</span></h2>
      <div class="prosa">
        <p class="lead">{total} documented projects in catalog. {yearsOfExperience()} years operating infrastructure. 24/7 support for critical environments.</p>
        <p>Detailed service and project pages are available in Spanish. <a class="u" href="/">Versión en español</a></p>
      </div>
    </div></section>
    <TrustStrip locale="en" dark />
    </main>
    <Cierre lang="en" />
  </body>
</html>
