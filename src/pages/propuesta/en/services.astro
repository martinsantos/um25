---
import '../../../styles/proto-despiece.css';
import Head from '../../../components/proto/Head.astro';
import Top from '../../../components/proto/Top.astro';
import TrustStrip from '../../../components/um/TrustStrip.astro';
import Cierre from '../../../components/proto/Cierre.astro';
import CatalogoEditorial from '../../../components/proto/CatalogoEditorial.astro';
import { loadStories, services, SERVICE_PHOTO } from '../../../components/proto/isoData';
import { catalogResultsHref } from '../../../components/proto/catalogFilters';
import { shellServiceCopy } from '../../../config/i18nShell';
import { contactLink } from '../../../lib/contactEntry';

export const prerender = false;
const { stories } = await loadStories();
const items = services.map(({ name, text, code, href }) => {
  const translated = shellServiceCopy('en', code, name, text);
  return {
    name: translated.name,
    summary: translated.text,
    photo: SERVICE_PHOTO[code],
    href,
    count: stories.filter(story => story.serviceCodes.includes(code)).length,
    detailHref: contactLink(Astro.url.pathname, `/en/contact?sistema=${code}`),
    detailLabel: 'Ask about this service',
    archiveHref: catalogResultsHref({ service: code }),
  };
});
---
<!doctype html>
<html lang="en">
  <head>
    <Head lang="en" title="IT services in Mendoza, Argentina · ULTIMA MILLA" description="Explore eight IT services: networks, security, telecommunications, custom software, support, consulting, fire detection and electrical infrastructure." />
  </head>
  <body>
    <Top lang="en" current="services" />
    <main id="contenido" tabindex="-1">
      <div class="wrap">
        <CatalogoEditorial lang="en" title="IT services for operational continuity"
          intro="Compare what we design, install and support. You can contact our team in English from any service."
          items={items} />
      </div>
      <TrustStrip locale="en" dark />
    </main>
    <Cierre lang="en" />
  </body>
</html>
