---
/** Services (English). Not indexable. */
import '../../../styles/proto-despiece.css';
import Head from '../../../components/proto/Head.astro';
import Top from '../../../components/proto/Top.astro';
import Cierre from '../../../components/proto/Cierre.astro';
import { services, SERVICE_PHOTO } from '../../../components/proto/isoData';
export const prerender = false;
const titles: Record<string, string> = { '101': 'Network infrastructure', '102': 'Electronic security', '103': 'Telecommunications', '104': 'Custom software', '105': '24/7 technical support', '106': 'IT consulting', '107': 'Fire detection and alarm', '108': 'Electrical systems for IT' };
const summaries: Record<string, string> = { '101': 'Structured cabling, switching and WiFi for sites that cannot afford downtime.', '102': 'CCTV, access control and intrusion for critical assets.', '103': 'Voice, data and field connectivity for distributed operations.', '104': 'Custom software and integrations tied to real processes.', '105': '24/7 support with accountable response on active environments.', '106': 'IT architecture and evidence-based decisions.', '107': 'Fire detection for critical infrastructure.', '108': 'Reliable power for IT systems.' };
---
<!doctype html>
<html lang="en">
  <head>
    <Head title="IT services in Mendoza, Argentina · ULTIMA MILLA" />
    <style>
      .lista-sv { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s5) clamp(28px, 4vw, 72px); padding-bottom: var(--s6); }
      .sv figure { margin: 0 0 var(--s2); aspect-ratio: 16 / 10; overflow: hidden; background: var(--bg-2); }
      .sv img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .sv h2 { font-size: clamp(1.6rem, 2.4vw, 2.2rem); margin-bottom: 8px; }
      .sv p { color: var(--ink-2); }
      @media (max-width: 900px) { .lista-sv { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <Top lang="en" current="services" />
    <main class="wrap">
      <div class="cabecera"><h1>Integrated IT services for operational continuity<span class="dot">.</span></h1><p>We design, deploy and operate infrastructure for organizations that need stable networks, physical security, operational software and accountable field support.</p></div>
      <ol class="lista-sv">{services.map((s, i) => <li class="sv"><a href={`/propuesta/servicios/${s.code}`}><figure><img src={SERVICE_PHOTO[s.code]} alt="" width="1672" height="941" loading={i < 2 ? 'eager' : 'lazy'} /></figure><h2>{titles[s.code]}<span class="dot">.</span></h2><p>{summaries[s.code]}</p><span class="small">View service (ES) →</span></a></li>)}</ol>
    </main>
    <Cierre lang="en" />
  </body>
</html>
