---
/** Contact (English). Not indexable. */
import '../../../styles/proto-despiece.css';
import Head from '../../../components/proto/Head.astro';
import Top from '../../../components/proto/Top.astro';
import Cierre from '../../../components/proto/Cierre.astro';
export const prerender = false;
---
<!doctype html>
<html lang="en">
  <head><Head title="Contact our IT team in Mendoza · ULTIMA MILLA" /></head>
  <body>
    <Top lang="en" />
    <main id="contenido" class="wrap"><div class="cabecera" style="padding-bottom:var(--s6)"><h1>Contact<span class="dot">.</span></h1><p>For proposals, technical assessments or vendor qualification, use the Spanish contact form (same team, same SLA).</p><a class="btn" href="/propuesta/contacto" style="width:max-content">Open contact form (Spanish) <span aria-hidden="true">→</span></a></div></main>
    <Cierre lang="en" />
  </body>
</html>
