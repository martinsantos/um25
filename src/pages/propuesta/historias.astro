---
/**
 * Propuesta C · "Rayos X" (2026-10-30). Cada lugar cuenta su historia en dos capas: la foto
 * real del lugar y, debajo, su despiece. Al bajar, un corte horizontal recorre la foto y deja
 * ver la isometría: el edificio, el aeropuerto, la bodega, el hospital se vuelven transparentes
 * y aparecen los sistemas que sostienen la operación. A la derecha, la historia de ese lugar:
 * qué hacemos ahí y los proyectos reales. Textos: sólo frases existentes. No indexable.
 */
import { loadStories, readIso, services } from '../../components/proto/isoData';

export const prerender = false;
const { total, places } = await loadStories();
const isos = Object.fromEntries(places.map((p) => [p.site, readIso(p.site)]));
const steps = ['Relevamiento', 'Diseño', 'Ejecución', 'Prueba técnica'];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Rayos X · Propuesta C · ULTIMA MILLA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root { --bg: #0a0b0d; --ink: #f4f4f5; --ink-2: #b4b6bb; --ink-3: #6f737a; --line: rgba(255,255,255,.14); --red: #dc2626; --gutter: clamp(20px, 4vw, 64px); --ease: cubic-bezier(.22, 1, .36, 1); }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; background: var(--bg); color: var(--ink); font: 400 17px/1.5 Manrope, system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
      a { color: inherit; text-decoration: none; }
      h1, h2, h3 { margin: 0; font-weight: 700; letter-spacing: -.03em; line-height: 1; text-wrap: balance; }
      .dot { color: var(--red); }
      .top { position: fixed; inset: 0 0 auto; z-index: 20; display: flex; justify-content: space-between; align-items: center; padding: 18px var(--gutter); mix-blend-mode: difference; }
      .logo { font-weight: 700; font-size: 1.15rem; letter-spacing: -.02em; }
      .logo i { font-style: normal; color: var(--red); }
      nav { display: flex; gap: 28px; font-size: .95rem; font-weight: 500; }
      nav .cta { padding: 8px 14px; border: 1px solid currentColor; }

      /* Apertura */
      .open { min-height: 100svh; display: grid; align-content: end; padding: 120px var(--gutter) 56px; position: relative; overflow: hidden; }
      .open__bg { position: absolute; inset: 0; z-index: 0; }
      .open__bg img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .open__bg::after { content: ''; position: absolute; inset: 0; background: linear-gradient(180deg, rgba(10,11,13,.1), rgba(10,11,13,.85) 75%); }
      .open > * { position: relative; z-index: 1; }
      .open__kicker { margin: 0 0 16px; color: var(--ink-2); }
      .open h1 { font-size: clamp(2.6rem, 6vw, 6rem); max-width: 14ch; }
      .open__lead { margin: 22px 0 0; max-width: 46ch; color: var(--ink-2); font-size: 1.1rem; }
      .open__hint { margin: 48px 0 0; color: var(--ink-3); font-size: .9rem; }

      /* Lugares: foto que se vuelve despiece al bajar. */
      .lugar { position: relative; height: 260vh; }
      .lugar__pin { position: sticky; top: 0; height: 100vh; height: 100svh; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(20px, 3vw, 56px); align-items: center; padding: 0 var(--gutter); overflow: hidden; }
      .xray { position: relative; aspect-ratio: 5 / 3; max-height: 82vh; width: 100%; background: #0e1013; }
      .xray__iso { position: absolute; inset: 0; display: grid; place-items: center; }
      .xray__iso :global(svg) { width: 100%; height: 100%; display: block; overflow: visible; }
      .xray__foto { position: absolute; inset: 0; clip-path: inset(0 0 calc(100% - var(--cut, 100%) * 1%) 0); }
      .xray__foto img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .xray__linea { position: absolute; left: 0; right: 0; top: calc(var(--cut, 100) * 1%); height: 1px; background: var(--red); opacity: var(--linea, 1); }
      .xray__linea::after { content: 'Despiece'; position: absolute; right: 12px; bottom: 6px; font-size: .78rem; letter-spacing: .04em; text-transform: uppercase; color: var(--red); }
      .lugar :global(.sp-route) { opacity: 0; transition: opacity .8s var(--ease); }
      .lugar :global(.sp-route path) { stroke-dasharray: 2400; stroke-dashoffset: 2400; transition: stroke-dashoffset 2.4s var(--ease); }
      .lugar :global(.sp-pin), .lugar :global(.sp-leader), .lugar :global(.sp-effect), .lugar :global(.sp-floor-label) { opacity: 0; transition: opacity .6s var(--ease); }
      .lugar[data-fase="2"] :global(.sp-route), .lugar[data-fase="3"] :global(.sp-route) { opacity: .95; }
      .lugar[data-fase="2"] :global(.sp-route path), .lugar[data-fase="3"] :global(.sp-route path) { stroke-dashoffset: 0; }
      .lugar[data-fase="3"] :global(.sp-pin), .lugar[data-fase="3"] :global(.sp-effect) { opacity: 1; }
      .lugar[data-fase="2"] :global([data-project-device]), .lugar[data-fase="3"] :global([data-project-device]) { stroke: #fff; stroke-opacity: .9; }
      .historia { display: grid; gap: 14px; align-content: center; }
      .historia__n { color: var(--ink-3); font-size: .9rem; font-variant-numeric: tabular-nums; }
      .historia h2 { font-size: clamp(2.2rem, 4vw, 4rem); }
      .historia > p { margin: 0; color: var(--ink-2); font-size: 1.1rem; }
      .historia ol { list-style: none; margin: 18px 0 0; padding: 0; border-top: 1px solid var(--line); }
      .historia ol a { display: grid; gap: 2px; padding: 12px 0; border-bottom: 1px solid var(--line); }
      .historia ol b { font-weight: 600; font-size: 1.02rem; }
      .historia ol span { color: var(--ink-3); font-size: .92rem; }
      .historia .u { width: max-content; margin-top: 14px; padding-bottom: 2px; border-bottom: 2px solid var(--red); font-weight: 600; }
      .fases { display: flex; gap: 18px; margin: 0; padding: 0; list-style: none; color: var(--ink-3); font-size: .9rem; }
      .fases li { transition: color .4s; }
      .fases li.on { color: var(--ink); }

      /* Frentes, cierre y contacto */
      .band { padding: clamp(80px, 12vh, 160px) var(--gutter) 0; }
      .band h2 { font-size: clamp(2rem, 3.6vw, 3.4rem); }
      .band__lead { margin: 14px 0 0; max-width: 52ch; color: var(--ink-2); font-size: 1.05rem; }
      .frentes { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
      .frentes a { background: var(--bg); padding: 20px; display: grid; gap: 6px; min-height: 150px; }
      .frentes b { font-size: 1.1rem; font-weight: 600; }
      .frentes span { color: var(--ink-2); font-size: .95rem; }
      .contacto { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: clamp(32px, 6vw, 96px); padding-bottom: clamp(80px, 12vh, 160px); }
      .contacto p { color: var(--ink-2); max-width: 44ch; }
      .contacto dl { margin: 28px 0 0; display: grid; gap: 10px; }
      .contacto dl div { display: flex; gap: 14px; }
      .contacto dt { color: var(--ink-3); min-width: 72px; }
      .contacto dd { margin: 0; }
      .btn { display: inline-flex; align-items: center; gap: 10px; margin-top: 28px; padding: 16px 24px; background: var(--ink); color: var(--bg); font-weight: 600; }
      footer { padding: 24px var(--gutter); border-top: 1px solid var(--line); color: var(--ink-3); font-size: .9rem; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }

      @media (max-width: 900px) {
        nav a:not(.cta) { display: none; }
        .lugar { height: 220vh; }
        .lugar__pin { grid-template-columns: 1fr; align-content: start; padding-top: 84px; gap: 18px; }
        .xray { max-height: 42vh; }
        .historia h2 { font-size: 2rem; }
        .historia ol a:nth-child(n+3) { display: none; }
        .frentes { grid-template-columns: 1fr 1fr; }
        .contacto { grid-template-columns: 1fr; }
      }
      @media (prefers-reduced-motion: reduce) { .lugar :global(*) { transition-duration: .01s !important; } }
    </style>
  </head>
  <body>
    <header class="top">
      <a class="logo" href="/">ultimamilla<i>.</i>com<i>.</i>ar</a>
      <nav aria-label="Principal"><a href="/servicios">Servicios</a><a href="/sectores">Sectores</a><a href="/antecedentes">Antecedentes</a><a href="/blog">Blog</a><a class="cta" href="#contacto">Contactar</a></nav>
    </header>

    <section class="open">
      <div class="open__bg"><img src="/images/editorial/umsa-about-engineering.webp" alt="" width="1672" height="941" fetchpriority="high" /></div>
      <p class="open__kicker">24 años de servicios IT · Mendoza, Argentina</p>
      <h1>Servicios IT para operaciones que no pueden detenerse<span class="dot">.</span></h1>
      <p class="open__lead">Redes, seguridad electrónica, telecomunicaciones, software a medida, soporte 24/7 y energía IT. Evidencia operativa visible antes de contratar.</p>
      <p class="open__hint">{total} proyectos documentados. Bajá para ver cada lugar por dentro.</p>
    </section>

    {places.map((p, i) => (
      <section class="lugar" data-lugar data-fase="0" aria-label={p.name}>
        <div class="lugar__pin">
          <div class="xray">
            <div class="xray__iso" set:html={isos[p.site]} />
            <div class="xray__foto"><img src={p.image} alt="" width="1672" height="941" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" /></div>
            <div class="xray__linea"></div>
          </div>
          <div class="historia">
            <span class="historia__n">{String(i + 1).padStart(2, '0')} / {String(places.length).padStart(2, '0')}</span>
            <h2>{p.name}<span class="dot">.</span></h2>
            <p>{p.text}</p>
            <ol class="fases" data-fases>{steps.map((s) => <li>{s}</li>)}</ol>
            {p.stories.length > 0 && <ol>{p.stories.map((c) => <li><a href={c.href}><b>{c.client}</b><span>{c.title}{c.year ? ` · ${c.year}` : ''}</span></a></li>)}</ol>}
            <a class="u" href={p.href}>{p.count > 0 ? `${p.count} proyectos` : p.name}</a>
          </div>
        </div>
      </section>
    ))}

    <section class="band" id="servicios">
      <h2>Ocho frentes de servicio<span class="dot">.</span></h2>
      <p class="band__lead">Un mismo equipo releva, instala, documenta y sostiene cada sistema, de la obra a la operación diaria.</p>
      <ul class="frentes">{services.map((s) => <li><a href={s.href}><b>{s.name}</b><span>{s.text}</span></a></li>)}</ul>
    </section>

    <section class="band contacto" id="contacto">
      <div>
        <h2>Contanos qué tiene que seguir funcionando<span class="dot">.</span></h2>
        <p>Indicá qué necesitás, dónde y para cuándo. Un técnico te responde por email con el próximo paso: diagnóstico, relevamiento, propuesta o documentación.</p>
        <dl><div><dt>Email</dt><dd>contacto@ultimamilla.com.ar</dd></div><div><dt>Oficina</dt><dd>Houssay 1159, Guaymallén, Mendoza</dd></div><div><dt>Horario</dt><dd>Lunes a viernes, 8 a 18 h</dd></div></dl>
      </div>
      <div><a class="btn" href="/contacto">Enviar consulta <span aria-hidden="true">→</span></a></div>
    </section>
    <footer><span>ultimamilla.com.ar</span><span>Houssay 1159, Guaymallén, Mendoza · contacto@ultimamilla.com.ar</span></footer>

    <script>
      // El corte baja con el scroll: 0 a 45 % la foto se abre; después se dibujan los recorridos y los pines.
      const lugares = [...document.querySelectorAll<HTMLElement>('[data-lugar]')];
      let raf = 0;
      const update = () => {
        raf = 0;
        lugares.forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.bottom < 0 || r.top > innerHeight) return;
          const p = Math.min(1, Math.max(0, -r.top / (r.height - innerHeight)));
          const cut = 100 - Math.min(1, p / .45) * 100;
          el.style.setProperty('--cut', String(cut));
          el.style.setProperty('--linea', p < .02 || p > .5 ? '0' : '1');
          const fase = p < .1 ? 0 : p < .45 ? 1 : p < .72 ? 2 : 3;
          if (el.dataset.fase !== String(fase)) el.dataset.fase = String(fase);
          el.querySelectorAll<HTMLElement>('[data-fases] li').forEach((li, i) => li.classList.toggle('on', i <= fase - 1 || (fase === 3 && i === 3)));
        });
      };
      addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
      addEventListener('resize', update);
      update();
    </script>
  </body>
</html>
