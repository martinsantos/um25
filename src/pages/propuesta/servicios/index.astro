---
/** Los ocho servicios: lectura completa en escritorio y comparación compacta en móvil. */
import '../../../styles/proto-despiece.css';
import Head from '../../../components/proto/Head.astro';
import Top from '../../../components/proto/Top.astro';
import Cierre from '../../../components/proto/Cierre.astro';
import CatalogoEditorial from '../../../components/proto/CatalogoEditorial.astro';
import { loadStories, services, SERVICE_PHOTO } from '../../../components/proto/isoData';

export const prerender = false;
const { stories } = await loadStories();
const items = services.map((service) => ({
  name: service.name,
  summary: service.text,
  photo: SERVICE_PHOTO[service.code],
  href: `/servicios/${service.code}`,
  count: stories.filter((story) => story.serviceCodes.includes(service.code)).length,
}));
---
<!doctype html>
<html lang="es">
  <head>
    <Head title="Ocho frentes de servicio · ULTIMA MILLA" description="Redes, seguridad electrónica, telecomunicaciones, software a medida, soporte 24/7, consultoría, detección de incendios y eléctricos IT. Un mismo equipo releva, instala, documenta y sostiene cada sistema." image="/images/editorial/umsa-service-redes.webp" />
  </head>
  <body>
    <Top current="servicios" />
    <main id="contenido" class="wrap">
      <CatalogoEditorial
        title="Ocho frentes de servicio"
        intro="Un mismo equipo releva, instala, documenta y sostiene cada sistema, de la obra a la operación diaria."
        action="Ver servicio"
        items={items}
      />
    </main>
    <Cierre />
  </body>
</html>
