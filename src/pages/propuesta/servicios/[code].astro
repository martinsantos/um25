---
/**
 * Página de servicio (2026-10-30), sistema Despiece. Apertura con la película de ese servicio
 * en su escena, que se abre hasta el despiece con sólo ese recorrido encendido. Después, el
 * equipo del servicio en despiece junto a lo que cubre (llamadas), el alcance como cajetín,
 * los cuatro pasos y las fichas de proyectos con ese servicio. Textos: los del servicio en el
 * catálogo y frases existentes. No indexable.
 */
import '../../../styles/proto-despiece.css';
import { getServicioByCode } from '../../../lib/um26-directus';
import { loadStories, readIso, readDevice, services, SERVICE_KEY, type IsoSite } from '../../../components/proto/isoData';
import { SERVICE_SCENES, SOFTWARE_FILM } from '../../../data/cine/scenes';

export const prerender = false;
const code = String(Astro.params.code);
const servicio = await getServicioByCode(Number(code));
const nav = services.find((s) => s.code === code);
if (!servicio || !nav) return new Response(null, { status: 404 });
const { stories } = await loadStories();
const own = stories.filter((c) => c.serviceCodes.includes(code));
const scene = (SERVICE_SCENES[code] || SERVICE_SCENES['101'])!.scene;
const SITE: Record<string, IsoSite> = { fachada: 'building', aeropuerto: 'terminal', bodega: 'winery', hospital: 'clinic', planta: 'plant' };
const iso = readIso(SITE[scene] || 'building');
const device = code === '106' ? '' : readDevice(code);
// Software: la película de transparencias ya es rayos X; su póster es el despiece del equipo.
const poster = code === '104' ? `/cine/media/cine-${SOFTWARE_FILM}-poster.avif` : `/cine/media/cine-${scene}-${SERVICE_KEY[code]}-poster.avif`;
const fallback = `/cine/media/cine-${scene}-poster.avif`;
const n = services.findIndex((s) => s.code === code) + 1;
const thumbOf = (image: string) => /^\/images\/antecedentes\/generated\/.+-principal\.webp$/.test(image) ? image.replace(/-principal\.webp$/, '-principal-480.webp') : image;
const pad = (v: number) => String(v).padStart(2, '0');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{servicio.name} · Servicio · ULTIMA MILLA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      .lugar { position: relative; height: 200vh; }
      .lugar__pin { position: sticky; top: 0; height: 100vh; height: 100svh; display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(20px, 3vw, 56px); align-items: center; padding: 0 var(--gutter); overflow: hidden; }
      .lugar .xray { max-height: 80vh; }
      .lugar :global(.sp-route path) { stroke-dashoffset: 2400; }
      .lugar[data-fase="2"] :global(.sp-route path), .lugar[data-fase="3"] :global(.sp-route path) { stroke-dashoffset: 0; }
      .lugar[data-fase="3"] :global(.sp-effect) { opacity: 1; }
      .copy { display: grid; gap: 14px; align-content: center; }
      .copy h1 { font-size: clamp(2.4rem, 4.4vw, 4.4rem); }
      .copy .tag { margin: 0; font-size: 1.2rem; font-weight: 600; color: var(--ink-2); }
      .copy > p { margin: 0; color: var(--ink-2); font-size: 1.02rem; max-width: 42ch; }

      .band { padding: clamp(80px, 12vh, 160px) var(--gutter) 0; }
      .band h2 { font-size: clamp(2rem, 3.4vw, 3.2rem); }
      .cubre { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: clamp(24px, 4vw, 64px); align-items: center; margin-top: 32px; }
      .equipo { aspect-ratio: 4 / 3; display: grid; place-items: center; background: var(--bg-2); padding: 8%; position: relative; }
      .equipo :global(svg) { width: 100%; height: auto; display: block; }
      .equipo .mono { position: absolute; left: 14px; bottom: 12px; }
      .caps { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
      .caps li { display: grid; grid-template-columns: 26px 1fr; gap: 14px; padding: 13px 0; border-bottom: 1px solid var(--line-2); align-items: center; font-size: 1.05rem; }
      .alcance { margin-top: 32px; }
      .alcance .hoja__body { padding: 0; }
      .alcance dl { margin: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); }
      .alcance dl div { padding: 14px 20px; border-bottom: 1px solid var(--line-2); border-right: 1px solid var(--line-2); }
      .alcance dd { margin: 4px 0 0; color: var(--ink-2); font-size: .98rem; }
      .alcance .cajetin b { white-space: normal; font-weight: 500; color: var(--ink-2); }
      .pasos { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--line-2); border: 1px solid var(--line-2); counter-reset: paso; }
      .pasos li { background: var(--bg); padding: 18px; display: grid; gap: 8px; align-content: start; }
      .pasos li::before { counter-increment: paso; content: counter(paso, decimal-leading-zero); font: 500 .76rem var(--mono); color: var(--ink-3); }
      .pasos b { font-weight: 600; font-size: 1.05rem; }
      .pasos p { margin: 0; color: var(--ink-2); font-size: .95rem; }
      .grid { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 1px; background: var(--line-2); border: 1px solid var(--line-2); }
      .ficha { background: var(--bg); padding: 14px; min-width: 0; }
      .ficha > a { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; }
      .ficha > a > * { min-width: 0; }
      .ficha__head { display: flex; justify-content: space-between; gap: 8px; }
      .ficha__head .mono { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
      .ficha figure { margin: 0; aspect-ratio: 16 / 10; background: var(--bg-2); overflow: hidden; }
      .ficha img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .ficha b { font-weight: 600; font-size: 1rem; line-height: 1.3; }
      .ficha .t { color: var(--ink-2); font-size: .95rem; line-height: 1.35; overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
      .ficha:hover b { text-decoration: underline; text-decoration-color: var(--red); text-underline-offset: 3px; }
      .more { display: inline-block; margin-top: 24px; }
      .cierre { margin: clamp(80px, 12vh, 160px) var(--gutter) 0; }
      .cierre .hoja__body { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(24px, 4vw, 64px); align-items: end; }
      .cierre h2 { font-size: clamp(2rem, 3.4vw, 3.2rem); }
      .cierre p { color: var(--ink-2); max-width: 44ch; margin: 14px 0 0; }
      .cierre .btn { justify-self: start; }
      @media (max-width: 1100px) { .grid, .pasos { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
      @media (max-width: 900px) {
        .lugar { height: 170vh; }
        .lugar__pin { grid-template-columns: 1fr; align-content: start; padding-top: 80px; gap: 16px; }
        .lugar .xray { max-height: 40vh; }
        .copy h1 { font-size: 2.2rem; }
        .copy > p { display: none; }
        .cubre { grid-template-columns: 1fr; }
        .alcance dl { grid-template-columns: 1fr; }
        .cierre .hoja__body { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <header class="top top--over">
      <a class="logo" href="/propuesta">ultimamilla<i>.</i>com<i>.</i>ar</a>
      <nav aria-label="Principal"><a href="/servicios" aria-current="page">Servicios</a><a href="/sectores">Sectores</a><a href="/propuesta/antecedentes">Antecedentes</a><a href="/blog">Blog</a><a class="cta" href="#contacto">Contactar</a></nav>
    </header>

    <section class="lugar" data-lugar data-fase="0" aria-label={servicio.name}>
      <div class="lugar__pin">
        <div class="copy">
          <span class="mono">Servicio · {pad(n)} / {pad(services.length)}</span>
          <h1>{servicio.name}<span class="dot">.</span></h1>
          <p class="tag">{servicio.tagline}</p>
          <p>{servicio.description}</p>
          <a class="u" href={`/propuesta/antecedentes?service=${code}`}>{own.length > 0 ? `${own.length} proyectos documentados` : 'Ver el muro'}</a>
        </div>
        <div class="xray">
          <div class="xray__ghost"><img src={poster} alt="" width="1920" height="1080" onerror={`this.src='${fallback}'`} /></div>
          <div class="xray__iso iso" data-svc={code} set:html={iso} />
          <div class="xray__foto"><img src={poster} alt="" width="1920" height="1080" fetchpriority="high" onerror={`this.src='${fallback}'`} /></div>
          <div class="xray__linea"></div>
        </div>
      </div>
    </section>

    <section class="band" id="cubre">
      <h2>Qué cubre {servicio.name}<span class="dot">.</span></h2>
      <div class="cubre">
        <div class="equipo">{device ? <div set:html={device} /> : <span style="color:var(--ink-3)">{servicio.tagline}</span>}<span class="mono">Equipo · despiece</span></div>
        <ol class="caps">{servicio.capabilities.map((c, i) => <li><span class="llamada">{pad(i + 1)}</span>{c}</li>)}</ol>
      </div>
      {servicio.scope_operativo.length > 0 && (
        <div class="alcance hoja">
          <div class="hoja__head"><span class="mono">Alcance operativo</span><span class="mono">{servicio.name}</span></div>
          <div class="hoja__body"><dl>{servicio.scope_operativo.map((p) => <div><dt class="mono">{p.label || p.titulo}</dt><dd>{p.value || p.desc}</dd></div>)}</dl></div>
          <div class="cajetin" style="--cols:1"><div><span class="mono">Alcance</span><b>{servicio.alcance_operativo}</b></div></div>
        </div>
      )}
    </section>

    {servicio.proceso.length > 0 && (
      <section class="band">
        <h2>De la medición al resultado<span class="dot">.</span></h2>
        <ol class="pasos">{servicio.proceso.map((s) => <li><b>{s.titulo}</b><p>{s.desc}</p></li>)}</ol>
      </section>
    )}

    {own.length > 0 && (
      <section class="band" id="proyectos">
        <h2>{own.length} proyectos con {servicio.name.toLowerCase()}<span class="dot">.</span></h2>
        <ol class="grid">
          {own.slice(0, 12).map((c, i) => (
            <li class="ficha"><a href={c.href}><div class="ficha__head"><span class="mono">UM-{c.id}</span><span class="mono">{[c.sector, c.year].filter(Boolean).join(' · ')}</span></div><figure>{c.image && <img src={thumbOf(c.image)} alt="" width="480" height="300" loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />}</figure><b>{c.client}</b><span class="t">{c.title}</span></a></li>
          ))}
        </ol>
        <a class="u more" href={`/propuesta/antecedentes?service=${code}`}>Ver los {own.length} proyectos</a>
      </section>
    )}

    <section class="cierre hoja" id="contacto">
      <div class="hoja__head"><span class="mono">Contacto</span><span class="mono">ULTIMA MILLA · Mendoza</span></div>
      <div class="hoja__body">
        <div>
          <h2>Contanos qué tiene que seguir funcionando<span class="dot">.</span></h2>
          <p>Indicá qué necesitás, dónde y para cuándo. Un técnico te responde por email con el próximo paso: diagnóstico, relevamiento, propuesta o documentación.</p>
        </div>
        <a class="btn" href="/contacto">Enviar consulta <span aria-hidden="true">→</span></a>
      </div>
      <div class="cajetin" style="--cols:3"><div><span class="mono">Email</span><b>contacto@ultimamilla.com.ar</b></div><div><span class="mono">Oficina</span><b>Houssay 1159, Guaymallén, Mendoza</b></div><div><span class="mono">Horario</span><b>Lunes a viernes, 8 a 18 h</b></div></div>
    </section>
    <footer class="pie"><span>ultimamilla.com.ar</span><span>Houssay 1159, Guaymallén, Mendoza · contacto@ultimamilla.com.ar</span></footer>

    <script>
      const lugar = document.querySelector<HTMLElement>('[data-lugar]')!;
      let raf = 0;
      const update = () => {
        raf = 0;
        const r = lugar.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, -r.top / (r.height - innerHeight)));
        lugar.style.setProperty('--cut', String(100 - Math.min(1, p / .5) * 100));
        lugar.style.setProperty('--linea', p < .02 || p > .52 ? '0' : '1');
        const fase = p < .12 ? 0 : p < .5 ? 1 : p < .78 ? 2 : 3;
        if (lugar.dataset.fase !== String(fase)) lugar.dataset.fase = String(fase);
      };
      addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
      addEventListener('resize', update);
      update();
    </script>
  </body>
</html>
