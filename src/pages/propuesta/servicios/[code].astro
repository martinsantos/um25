---
import { pageContactLink } from '../../../lib/caseJourney';
import { serviceWorkEnquiry } from '../../../components/proto/serviceReference';
import '../../../styles/pilot-fichas.css';
import '../../../styles/proto-despiece.css';
import Head from '../../../components/proto/Head.astro';
import Top from '../../../components/proto/Top.astro';
import DeviceExploded from '../../../components/proto/DeviceExploded.astro';
import SoftwareExperience from '../../../components/proto/SoftwareExperience.astro';
import { detailPhotographs } from '../../../data/photography';
import ServiceEditorialHero from '../../../components/proto/ServiceEditorialHero.astro';
import SecurityProvision from '../../../components/proto/SecurityProvision.astro';
import ServiceProvision from '../../../components/proto/ServiceProvision.astro';
import FlowSection from '../../../components/proto/FlowSection.astro';
import FunctionalSection from '../../../components/proto/FunctionalSection.astro';
import OperationsSection from '../../../components/proto/OperationsSection.astro';
import { operationsSceneForService } from '../../../data/operationsScenes';
import TechnicalSection from '../../../components/proto/TechnicalSection.astro';
import { technicalSceneForService } from '../../../data/technicalScenes';
import { flowForService } from '../../../data/informationFlows';
import { groupServiceProvision, securityProvisionGroups, serviceProvisionItems } from '../../../utils/serviceProvision';
import Ficha from '../../../components/proto/Ficha.astro';
import { shortCaseImageSizes } from '../../../components/proto/catalogImageSizes';
import CaseLinks from '../../../components/proto/CaseLinks.astro';
import { homeWorkReturn } from '../../../components/proto/portadaCases';
import ObraArchivo from '../../../components/proto/ObraArchivo.astro';
import Casos from '../../../components/proto/Casos.astro';
import { remainingCaseProjects } from '../../../components/proto/caseSelection';
import Cierre from '../../../components/proto/Cierre.astro';
import { getServicioByCode } from '../../../lib/um26-directus';
import { EDITORIAL_HERO_SIZES, loadStories, services, SERVICE_PHOTO } from '../../../components/proto/isoData';
import { despieceAgregado, KIT_DE_SERVICIO } from '../../../components/proto/despiece';
import { caseEquipmentFor, publicCaseFor } from '../../../components/proto/casePresentation';
import Partes from '../../../components/proto/Partes.astro';
import { serviceCaseCollection } from '../../../components/proto/serviceCaseCollection';
import DeliveryDocuments from '../../../components/proto/DeliveryDocuments.astro';
import IndiceFicha from '../../../components/proto/IndiceFicha.astro';
import { serviceSingleDemoCopy } from '../../../data/serviceSingleDemoSystem';
import { serviceDecisionGuide } from '../../../data/service-decision-guide';
import { serviceDetailSeo } from '../../../data/serviceDetailSeo';
import { SERVICE_SPECS } from '../../../data/serviceSpecs';
import { SECTORS, SOFTWARE_FILM } from '../../../data/cine/scenes';

import ClientDirectory from '../../../components/proto/ClientDirectory.astro';
import ServiceSectorWorks from '../../../components/proto/ServiceSectorWorks.astro';
import { clientsForStories } from '../../../components/proto/clientDirectory';

export const prerender = false;
const code = String(Astro.params.code);
const servicio = await getServicioByCode(Number(code));
const nav = services.find((s) => s.code === code);
const spec = SERVICE_SPECS[code];
if (!servicio || !nav || !spec) return Astro.rewrite('/404');
const isNetworks = code === '101';
// Software y servicios profesionales se explican con pantallas, trabajo y resultados.
const functionalPilot = ['102', '108'].includes(code);
const technicalScene = technicalSceneForService(code);
const operationsScene = operationsSceneForService(code);
const editorial = ['104', '105', '106'].includes(code) || functionalPilot || Boolean(technicalScene);
const Hero = ServiceEditorialHero;
const security = code === '102';
const Provision = security ? SecurityProvision : ServiceProvision;
const { stories } = await loadStories();
const { own, casos, rankedCases, selectedCases } = serviceCaseCollection(stories, code);
const archiveHref = `/antecedentes?service=${code}#obras-filtradas`;
const archiveText = own.length > 0 ? `Ver los ${own.length} antecedentes` : 'Ver todos los antecedentes';
const agregado = new Map(despieceAgregado(own, caseEquipmentFor).map((p) => [p.key, p]));
const kit = (KIT_DE_SERVICIO[code] || []).map(([key, label]) => ({ key, label, n: agregado.get(key)?.proyectos || 0, u: agregado.get(key)?.unidades || 0 }));
const detailPhoto = detailPhotographs[code];
const photo = detailPhoto?.src || SERVICE_PHOTO[code];
const softwareArchive = code === '104' ? [10817, 10778, 10813].flatMap(id => {
  const record = casos.find(c => c.id === id && !c.publicado);
  return record ? [record] : [];
}) : [];
const otherCases = casos.filter(c => !softwareArchive.some(s => s.id === c.id));
const documentedCases = own.filter((c) => c.documentedScope && !selectedCases.some(({ pub }) => pub.id === c.id));
const moreCases = remainingCaseProjects(rankedCases.filter((c) => !c.documentedScope), selectedCases).slice(0, 8);
const lower = servicio.name.toLowerCase().replace(/\bit\b/g, 'IT');
const bySector = SECTORS.filter(sector => sector.slug !== 'software' && sector.slug !== 'seguridad-electronica')
  .map(sector => ({
    slug: sector.slug,
    name: sector.name,
    count: own.filter(story => story.sectorSlug === sector.slug).length,
    reference: rankedCases.find(story => story.sectorSlug === sector.slug && (publicCaseFor(story) || story.documentedScope)),
  }))
  .filter(sector => sector.count > 0)
  .sort((a, b) => b.count - a.count);
const clientes = clientsForStories(own);
const anios = own.map((c) => c.year).filter(Boolean);
const desde = anios.length ? Math.min(...anios) : 0;
const cifras: [string, string, string?][] = own.length ? [[String(own.length), 'antecedentes registrados', archiveHref], [String(clientes.length), clientes.length === 1 ? 'cliente identificado' : 'clientes identificados', !security && clientes.length ? '#clientes' : undefined], [String(bySector.length), bySector.length === 1 ? 'sector' : 'sectores', bySector.length ? '#obras-por-sector' : undefined], [String(desde), 'primer registro']] : [];
const meta = Object.fromEntries(servicio.metadata.map((m) => [m.label, m.value]));
const condiciones = ['Implementación', 'Garantía', 'Cobertura'].filter((k) => meta[k]).map((k) => `${k}: ${meta[k]}`).join('. ');
const choices = serviceDecisionGuide[Number(code)] ?? [];
const provision = serviceProvisionItems(servicio.products, Number(code)).map((item) => ({
  ...item,
  reference: item.referenceCaseId === undefined ? undefined : own.find((c) => c.id === item.referenceCaseId && c.documentedScope),
}));
// Radioenlaces entre sedes es un caso transversal de Telecomunicaciones.
const sceneGroupByCode: Record<string, string> = {
  '101': 'Fibra óptica', '102': 'Videovigilancia IP', '104': 'Integración y automatización',
  '105': 'Atención y gestión de incidentes', '106': 'Diagnóstico y evaluación',
  '107': 'Detectores según el ambiente', '108': 'Respaldo de energía',
};
const provisionGroups = groupServiceProvision(provision);
const groups = security ? securityProvisionGroups(provision) : provisionGroups;
const sectionLinks = [
  { href: '#alcance', label: 'Qué cubre' },
  ...(provision.length ? [{ href: '#provision', label: 'Qué proveemos' }] : []),
  { href: '#flujo', label: security ? 'Grabación de CCTV' : 'Cómo funciona' },
  ...(security && groups.some(group => group.title === 'Control de Acceso Biométrico')
    ? [{ href: '#lectura-de-credencial', label: 'Lectura de credencial' }] : []),
  ...(softwareArchive.length ? [{ href: '#desarrollos', label: 'Desarrollos realizados' }]
    : selectedCases.length || otherCases.some(c => !c.publicado) ? [{ href: '#casos', label: 'Obras realizadas' }] : []),
  { href: '#metodo', label: 'Cómo trabajamos' },
  { href: '#entregables', label: 'Qué entregamos' },
  ...(bySector.length ? [{ href: '#obras-por-sector', label: 'Obras por sector' }] : []),
];
Astro.locals.serviceWorkEnquiry = serviceWorkEnquiry(code, Astro.url.searchParams, own, groups);
const sceneGroup = provisionGroups.find(group => group.title === sceneGroupByCode[code])?.title;
const showProjectArchive = own.length > 0 || isNetworks;
const copy = serviceSingleDemoCopy[Number(code)]!;
const pageSeo = serviceDetailSeo[code] ?? {
  title: `${servicio.name} · ULTIMA MILLA`,
  description: copy.paragraph,
};
const limpio = (s: string) => s.replace(/(?:desde|con) el frente 105/gi, 'con el equipo de soporte').replace(/\bfrente 10\d\b/gi, 'equipo técnico');
const cierrePorServicio: Record<string, { heading: string; description: string; ctaText: string }> = {
  '101': {
    heading: 'Planifiquemos tu red',
    description: 'Indicá qué sedes necesitás conectar, dónde están y cuántos puestos deben cubrirse.',
    ctaText: 'Consultar por redes',
  },
  '102': {
    heading: 'Definamos qué necesita cubrir la seguridad',
    description: 'Contanos qué espacios necesitás cubrir, qué equipos ya están instalados y en qué horarios opera el sitio.',
    ctaText: 'Consultar seguridad',
  },
  '103': {
    heading: 'Conectemos tus sedes',
    description: 'Decinos qué sedes necesitás enlazar, dónde están y qué equipos deben conectarse.',
    ctaText: 'Consultar conectividad',
  },
  '104': {
    heading: 'Contanos qué proceso querés mejorar',
    description: 'Describí el proceso, los sistemas existentes y qué información necesitás integrar.',
    ctaText: 'Consultar por software',
  },
  '105': {
    heading: 'Definamos cómo sostener tu operación',
    description: 'Contanos qué sedes y equipos requieren soporte, y en qué horarios trabaja la operación.',
    ctaText: 'Consultar soporte 24/7',
  },
  '106': {
    heading: 'Ordenemos tus decisiones tecnológicas',
    description: 'Compartí las sedes, equipos y sistemas actuales, y la decisión técnica que necesitás resolver.',
    ctaText: 'Consultar por consultoría',
  },
  '107': {
    heading: 'Revisemos qué espacios necesitan detección',
    description: 'Indicá qué sectores necesitás cubrir y qué sistema o equipamiento ya existe.',
    ctaText: 'Consultar por detección de incendios',
  },
  '108': {
    heading: 'Revisemos la energía de tu infraestructura',
    description: 'Compartí dónde están los equipos, qué instalación existe y qué puntos necesitás alimentar.',
    ctaText: 'Consultar energía IT',
  },
};
const cierre = cierrePorServicio[code];
---
<!doctype html>
<html lang="es">
  <head>
    <Head title={pageSeo.title} description={pageSeo.description} image={photo} precargar imageSizes={EDITORIAL_HERO_SIZES} />
    <style>
      .service-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-block: 24px; }
      .delivery-terms { margin-top:var(--s4); display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr)); gap:var(--s3) var(--s4); }
      .cubre { position: relative; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s4) clamp(28px, 4vw, 72px); align-items: center; }
      .cubre--guia { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; }
      .caps { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
      .caps h3 { font-size: 1.2rem; line-height: 1.3; }
      .caps p { margin: 8px 0 0; color: var(--ink-2); font-size: 1rem; line-height: 1.6; }
      .technical-scope { margin-top: var(--s4); }
      .technical-scope summary { cursor: pointer; font-weight: 600; padding-block: 12px; }
      .caps li { padding: 18px 0; border-bottom: 1px solid var(--line-2); font-size: 1.1rem; color: var(--ink); }
      .cubre.cubre--editorial { display: block; }
      .cubre--editorial .caps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--s4); }
      .cubre--editorial .caps li { padding-block: 24px; }
      .condiciones { margin-top: var(--s4); color: var(--ink-3); }
      @media (min-width: 901px) {
        :global(.service-editorial) h1.service-detail-title { font-size: clamp(2.5rem, 4vw, 3.5rem); }
        :global(.service-editorial) h1.redes-titulo { font-size: clamp(3.25rem, 4vw, 3.5rem); }
      }
      @media (max-width: 900px) {
        .cubre--editorial .caps { grid-template-columns: minmax(0, 1fr); }
        .cubre { grid-template-columns: minmax(0, 1fr); gap: var(--s4); align-items: start; }
        .caps li { font-size: 1rem; padding: 10px 0; }
      }
      .software-obras { padding-block: 22px 36px; }
      .software-obras h2 { font-size:clamp(1.65rem,3.1vw,3rem);margin:0 0 20px;letter-spacing:-.04em; }
      .software-obras > div { display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,240px),1fr)); gap:20px clamp(20px,3vw,56px); }
    </style>
  </head>
  <body>
    <Top current="servicios" />
    <main id="contenido" tabindex="-1">

    <Hero label={servicio.name} image={photo} metrics={code === '104' ? [] : cifras}
      film={code === '104' ? `/cine/media/cine-${SOFTWARE_FILM}.mp4` : undefined}
      mobileFilm={code === '104' ? `/cine/media/cine-${SOFTWARE_FILM}-sq.mp4` : undefined}
      poster={code === '104' ? photo : undefined}
      naturalPhoto={Boolean(detailPhoto) || ['105', '106'].includes(code)}
      imageAlt={detailPhoto?.title ?? (code === '105' ? 'Técnico revisando las conexiones Ethernet de un equipo montado en rack' : code === '106' ? 'Plano de instalación y elementos de relevamiento técnico sobre una mesa' : '')}>
      <h1 class:list={['service-detail-title', { 'redes-titulo': isNetworks }]} style={code === '103' ? 'font-size:clamp(2rem,3.6vw,3.5rem)' : undefined}>{servicio.name}<span class="dot">.</span></h1>
      <p class="tag">{isNetworks ? 'Cableado, fibra y redes para empresas.' : code === '104' ? 'Portales, trámites e integraciones.' : copy.headline}</p>
      <p>{isNetworks ? 'Desde Mendoza diseñamos e instalamos redes LAN/WAN, Wi-Fi corporativo y switching gestionado. Medimos los enlaces y documentamos la obra según su alcance.' : code === '104' ? 'Para la Suprema Corte de Mendoza integramos la validación de usuarios y la certificación de documentos con sello de tiempo en su portal.' : copy.paragraph}</p>
      <div class="editorial-actions">
        <div class="service-actions">
          <a class="btn" data-contact-follow id="consulta-principal"
            href={pageContactLink(Astro, code === '104' ? '/contacto' : '/contacto?intent=relevamiento')}>
            {code === '104' ? 'Consultar por un desarrollo' : 'Pedir un relevamiento'}
          </a>
          {provision.length > 0 && <a class="u" href="#provision">Ver qué proveemos</a>}
        </div>
        {!showProjectArchive && <a class="u" href={archiveHref}>{archiveText}</a>}
      </div>
    </Hero>
    <IndiceFicha class="wrap" links={sectionLinks} />
    {softwareArchive.length > 0 && <section id="desarrollos" tabindex="-1" class="software-obras wrap" aria-labelledby="software-obras-titulo">
      <h2 id="software-obras-titulo">Sistemas que desarrollamos<span class="dot">.</span></h2>
      <div>{softwareArchive.map(obra => <ObraArchivo obra={obra} returnHref={homeWorkReturn(Astro.url, stories, obra.id)} />)}</div>
    </section>}
    <section class="sec" id="alcance" tabindex="-1">
      <div class="wrap">
        <div class="sec__head"><h2>Qué cubre<span class="dot">.</span></h2></div>
        <div class:list={['cubre', editorial ? 'cubre--editorial' : 'cubre--guia']} data-cubre>
          <ul class="caps" data-caps>{choices.map((choice) => <li><h3>{choice.title}</h3><p>{choice.description}</p></li>)}</ul>
          {!editorial && <DeviceExploded code={code} />}
        </div>
        {!provision.length && servicio.capabilities.length > 0 && <details class="technical-scope"><summary>Especificaciones adicionales</summary><ul class="lista">{servicio.capabilities.map((c) => <li>{c}</li>)}</ul></details>}
      </div>
    </section>

    {provision.length > 0 && (
      <Provision
        items={provision}
        code={code} stories={own} sceneGroup={sceneGroup}
        introduction={isNetworks ? 'Qué instalamos, cómo lo verificamos y qué documentación recibe tu equipo según el alcance acordado.' : undefined}
      >
        {sceneGroup && <div slot="flow">{operationsScene ? <OperationsSection content={operationsScene} /> : technicalScene ? <TechnicalSection content={technicalScene} /> : functionalPilot ? <FunctionalSection code={code} /> : <FlowSection flow={flowForService(code)} />}</div>}
        {servicio.capabilities.length > 0 && <details class="technical-scope"><summary>Especificaciones adicionales</summary><ul class="lista">{servicio.capabilities.map((c) => <li>{c}</li>)}</ul></details>}
      </Provision>
    )}
    {!sceneGroup && (operationsScene ? <OperationsSection content={operationsScene} /> : technicalScene ? <TechnicalSection content={technicalScene} /> : functionalPilot ? <FunctionalSection code={code} /> : <FlowSection flow={flowForService(code)} />)}
    {code === '104' && <SoftwareExperience />}

    <Casos casos={otherCases} stories={stories} title={`Lo que hicimos en ${lower}`} selection={selectedCases} textOnly={code === '104'} />

    {security && <div class="wrap"><a class="u more" href={archiveHref}>{archiveText} →</a></div>}
    <section class="sec" id="metodo" tabindex="-1">
      <div class="wrap cols cols-5-7">
        <h2>Cómo lo hacemos<span class="dot">.</span></h2>
        <div class="cols cols-2">{servicio.proceso.map((s) => <div class="item"><h3>{s.titulo}</h3><p>{s.desc}</p></div>)}</div>
      </div>
    </section>

    <section class="sec" id="entregables" tabindex="-1">
      <div class="wrap">
        <DeliveryDocuments spec={spec} />
        <div class="delivery-terms">
          <div class="item"><h3>Alcance</h3><ul class="lista">{spec.scope.map((s) => <li>{s}</li>)}</ul></div>
          <div class="item"><h3>Normas y criterios</h3><ul class="lista">{spec.standards.map((s) => <li>{s}</li>)}</ul></div>
          <div class="item"><h3>{editorial ? 'Continuidad y acompañamiento' : 'Después de la obra'}</h3><ul class="lista">{spec.serviceLevel.map((s) => <li>{limpio(s)}</li>)}</ul></div>
        </div>
        {condiciones && <p class="condiciones">{condiciones}.</p>}
      </div>
    </section>

    {!editorial && kit.length > 0 && (
      <section class="sec">
        <div class="wrap">
          <div class="sec__head"><h2>Con qué se hace<span class="dot">.</span></h2></div>
          <Partes items={kit.map((p) => ({ key: p.key, label: p.label, meta: servicio.name, n: p.n > 0 ? `${p.n} ${p.n === 1 ? 'antecedente' : 'antecedentes'}` : 'Alcance del servicio' }))} />
        </div>
      </section>
    )}

    {!security && <ClientDirectory clients={clientes} filter={{service: code}} archiveLabel={`Ver todos los antecedentes de ${servicio.name}`} />}

    {own.length > 0 && (
      <ServiceSectorWorks service={code} name={servicio.name} sectors={bySector}
        unclassified={own.filter(story => !story.sectorSlug).length} />
    )}

    {!security && showProjectArchive && (
      <section class="sec">
        <div class="wrap">
          <div class="sec__head"><h2>Más proyectos de {lower}<span class="dot">.</span></h2></div>
          <CaseLinks stories={documentedCases} />
          {code === '104' ? <CaseLinks stories={moreCases} /> : moreCases.length > 0 && <ol class:list={["fichas", { "fichas--short": moreCases.length < 3 }]}>{moreCases.map(c => <Ficha story={c} imageSizes={moreCases.length < 3 ? shortCaseImageSizes : undefined} />)}</ol>}
          <a class="u more" href={archiveHref}>{archiveText}</a>
        </div>
      </section>
    )}

    </main>

    <Cierre heading={cierre?.heading} description={cierre?.description} ctaText={cierre?.ctaText} />


  </body>
</html>
