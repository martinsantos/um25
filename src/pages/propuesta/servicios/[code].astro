---
import '../../../styles/pilot-fichas.css';
import PilotCatalog from '../../../components/proto/PilotCatalog.astro';
import '../../../styles/proto-despiece.css';
import Head from '../../../components/proto/Head.astro';
import Top from '../../../components/proto/Top.astro';
import DeviceExploded from '../../../components/proto/DeviceExploded.astro';
import SoftwareExperience from '../../../components/proto/SoftwareExperience.astro';
import ServiceEditorialHero from '../../../components/proto/ServiceEditorialHero.astro';
import ServiceProvision from '../../../components/proto/ServiceProvision.astro';
import { serviceProvisionItems } from '../../../utils/serviceProvision';
import Ficha from '../../../components/proto/Ficha.astro';
import CaseLinks from '../../../components/proto/CaseLinks.astro';
import Casos from '../../../components/proto/Casos.astro';
import { selectCaseProjects, remainingCaseProjects, pageCaseCandidates } from '../../../components/proto/caseSelection';
import Cierre from '../../../components/proto/Cierre.astro';
import { getServicioByCode } from '../../../lib/um26-directus';
import { loadStories, services, SERVICE_PHOTO, destacados } from '../../../components/proto/isoData';
import { despieceAgregado, KIT_DE_SERVICIO } from '../../../components/proto/despiece';
import { caseEquipmentFor } from '../../../components/proto/casePresentation';
import Partes from '../../../components/proto/Partes.astro';
import { CASOS_SERVICIO, casosDe } from '../../../components/proto/relato';
import { getDatasheetPublicPath } from '../../../utils/datasheets';
import { serviceSingleDemoCopy } from '../../../data/serviceSingleDemoSystem';
import { serviceDecisionGuide } from '../../../data/service-decision-guide';
import { serviceDetailSeo } from '../../../data/serviceDetailSeo';
import { SERVICE_SPECS } from '../../../data/serviceSpecs';
import { SECTORS, SOFTWARE_FILM } from '../../../data/cine/scenes';

import { isNamedClient } from '../../../components/proto/catalogEditorial';

export const prerender = false;
const code = String(Astro.params.code);
const servicio = await getServicioByCode(Number(code));
const nav = services.find((s) => s.code === code);
const spec = SERVICE_SPECS[code];
if (!servicio || !nav || !spec) return Astro.rewrite('/404');
const isNetworks = code === '101';
// Software y servicios profesionales se explican con pantallas, trabajo y resultados.
const editorial = ['104', '105', '106'].includes(code);
const Hero = ServiceEditorialHero;
const Provision = code === '102' ? PilotCatalog : ServiceProvision;
const pdf = getDatasheetPublicPath(spec.slug);
const datasheetHref = pdf || `/servicios/${code}/ficha`;
const datasheetText = pdf ? 'Descargar ficha técnica (PDF)' : 'Ficha técnica · imprimir o guardar PDF';
const { stories } = await loadStories();
const own = stories.filter((c) => c.serviceCodes.includes(code));
const archiveHref = `/antecedentes?service=${code}`;
const archiveText = own.length > 0 ? `Ver los ${own.length} antecedentes` : 'Ver todos los antecedentes';
const agregado = new Map(despieceAgregado(own, caseEquipmentFor).map((p) => [p.key, p]));
const kit = (KIT_DE_SERVICIO[code] || []).map(([key, label]) => ({ key, label, n: agregado.get(key)?.proyectos || 0, u: agregado.get(key)?.unidades || 0 }));
const photo = SERVICE_PHOTO[code];
const casos = casosDe(CASOS_SERVICIO[code] || []);
const showcase = pageCaseCandidates(own, undefined, code);
const rankedCases = destacados(showcase, showcase.length);
const selectedCases = selectCaseProjects(casos, stories, rankedCases);
const documentedCases = own.filter((c) => c.documentedScope && !selectedCases.some(({ pub }) => pub.id === c.id));
const moreCases = remainingCaseProjects(rankedCases.filter((c) => !c.documentedScope), selectedCases).slice(0, 8);
const lower = servicio.name.toLowerCase().replace(/\bit\b/g, 'IT');
const bySector = SECTORS.map((s) => ({ slug: s.slug, name: s.name, count: own.filter((c) => c.sectorSlug === s.slug).length })).filter((s) => s.count > 0).sort((a, b) => b.count - a.count);
const clientes = Object.values(own.filter(s => isNamedClient(s.client)).reduce<Record<string, { name: string; count: number }>>((acc, s) => { const k = s.client.toLowerCase(); (acc[k] ||= { name: s.client, count: 0 }).count++; return acc; }, {})).sort((a, b) => b.count - a.count);
const anios = own.map((c) => c.year).filter(Boolean);
const desde = anios.length ? Math.min(...anios) : 0;
const cifras: [string, string][] = own.length ? [[String(own.length), 'antecedentes registrados'], [String(clientes.length), clientes.length === 1 ? 'cliente identificado' : 'clientes identificados'], [String(bySector.length), bySector.length === 1 ? 'sector' : 'sectores'], [String(desde), 'primer registro']] : [];
const meta = Object.fromEntries(servicio.metadata.map((m) => [m.label, m.value]));
const condiciones = ['Implementación', 'Garantía', 'Cobertura'].filter((k) => meta[k]).map((k) => `${k}: ${meta[k]}`).join('. ');
const choices = serviceDecisionGuide[Number(code)] ?? [];
const provision = serviceProvisionItems(servicio.products, Number(code)).map((item) => ({
  ...item,
  reference: item.referenceCaseId === undefined ? undefined : own.find((c) => c.id === item.referenceCaseId && c.documentedScope),
}));
const showProjectArchive = own.length > 0 || isNetworks;
const copy = serviceSingleDemoCopy[Number(code)]!;
const pageSeo = serviceDetailSeo[code] ?? {
  title: `${servicio.name} · ULTIMA MILLA`,
  description: copy.paragraph,
};
const limpio = (s: string) => s.replace(/(?:desde|con) el frente 105/gi, 'con el equipo de soporte').replace(/\bfrente 10\d\b/gi, 'equipo técnico');
const cierrePorServicio: Record<string, { heading: string; description: string; ctaText: string }> = {
  '101': {
    heading: 'Planifiquemos tu red',
    description: 'Indicá qué sedes necesitás conectar, dónde están y cuántos puestos deben cubrirse.',
    ctaText: 'Consultar por redes',
  },
  '102': {
    heading: 'Definamos qué necesita cubrir la seguridad',
    description: 'Contanos qué espacios necesitás cubrir, qué equipos ya están instalados y en qué horarios opera el sitio.',
    ctaText: 'Consultar seguridad',
  },
  '103': {
    heading: 'Conectemos tus sedes',
    description: 'Decinos qué sedes necesitás enlazar, dónde están y qué equipos deben conectarse.',
    ctaText: 'Consultar conectividad',
  },
  '104': {
    heading: 'Contanos qué proceso querés mejorar',
    description: 'Describí el proceso, los sistemas existentes y qué información necesitás integrar.',
    ctaText: 'Consultar por software',
  },
  '105': {
    heading: 'Definamos cómo sostener tu operación',
    description: 'Contanos qué sedes y equipos requieren soporte, y en qué horarios trabaja la operación.',
    ctaText: 'Consultar soporte 24/7',
  },
  '106': {
    heading: 'Ordenemos tus decisiones tecnológicas',
    description: 'Compartí las sedes, equipos y sistemas actuales, y la decisión técnica que necesitás resolver.',
    ctaText: 'Consultar por consultoría',
  },
  '107': {
    heading: 'Revisemos qué espacios necesitan detección',
    description: 'Indicá qué sectores necesitás cubrir y qué sistema o equipamiento ya existe.',
    ctaText: 'Enviar consulta',
  },
  '108': {
    heading: 'Revisemos la energía de tu infraestructura',
    description: 'Compartí dónde están los equipos, qué instalación existe y qué puntos necesitás alimentar.',
    ctaText: 'Consultar energía IT',
  },
};
const cierre = cierrePorServicio[code];
---
<!doctype html>
<html lang="es">
  <head>
    <Head title={pageSeo.title} description={pageSeo.description} image={photo} precargar />
    <style>
      .service-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; margin-block: 24px; }
      .service-datasheet { display: inline-flex; align-items: center; min-height: 44px; margin-top: var(--s2); }
      .service-sections { display: flex; flex-wrap: wrap; gap: 4px 28px; padding-block: 16px; border-block: 1px solid var(--line); }
      .service-sections a { display: inline-flex; align-items: center; min-height: 44px; font-size: 1rem; font-weight: 600; }
      .service-sections a:hover { text-decoration: underline; text-decoration-color: var(--red); text-underline-offset: 5px; }
      .cubre { position: relative; display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: var(--s4) clamp(28px, 4vw, 72px); align-items: center; }
      .cubre--guia { grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); align-items: start; }
      .caps { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
      .caps h3 { font-size: 1.2rem; line-height: 1.3; }
      .caps p { margin: 8px 0 0; color: var(--ink-2); font-size: 1rem; line-height: 1.6; }
      .technical-scope { margin-top: var(--s4); }
      .technical-scope summary { cursor: pointer; font-weight: 600; padding-block: 12px; }
      .caps li { padding: 18px 0; border-bottom: 1px solid var(--line-2); font-size: 1.1rem; color: var(--ink); }
      .cubre.cubre--editorial { display: block; }
      .cubre--editorial .caps { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: var(--s4); }
      .cubre--editorial .caps li { padding-block: 24px; }
      .condiciones { margin-top: var(--s4); color: var(--ink-3); }
      @media (min-width: 901px) {
        :global(.service-editorial) h1.service-detail-title { font-size: clamp(2.5rem, 4vw, 3.5rem); }
        :global(.service-editorial) h1.redes-titulo { font-size: clamp(3.25rem, 4vw, 3.5rem); }
      }
      @media (max-width: 900px) {
        .cubre--editorial .caps { grid-template-columns: minmax(0, 1fr); }
        .cubre { grid-template-columns: minmax(0, 1fr); gap: var(--s4); align-items: start; }
        .caps li { font-size: 1rem; padding: 10px 0; }
        :global(.service-editorial) .cifras.cifras--compact {
          gap: var(--s1) var(--s2);
          margin-top: 0;
          padding-top: 12px;
        }
        .cifras--compact div { display: flex; flex-wrap: wrap; gap: 2px 6px; align-items: baseline; }
        :global(.service-editorial) .cifras.cifras--compact b { flex-shrink: 0; font-size: 1.125rem; }
        .cifras--compact span { flex: 1 1 min-content; line-height: 1.3; }
      }
    </style>
  </head>
  <body>
    <Top current="servicios" />
    <main id="contenido">

    <Hero label={servicio.name} image={photo} naturalPhoto={['105', '106'].includes(code)} imageAlt={code === '105' ? 'Profesional supervisando equipos en una sala de servidores' : code === '106' ? 'Personas colaborando con computadoras durante un hackatón en Rosario' : ''} film={code === '104' ? `/cine/media/cine-${SOFTWARE_FILM}.mp4` : undefined} poster={code === '104' ? `/cine/media/cine-${SOFTWARE_FILM}-poster.avif` : undefined}>
      <h1 class:list={['service-detail-title', { 'redes-titulo': isNetworks }]} style={code === '103' ? 'font-size:clamp(2rem,3.6vw,3.5rem)' : undefined}>{servicio.name}<span class="dot">.</span></h1>
      <p class="tag">{isNetworks ? 'Cableado, fibra y redes para empresas.' : copy.headline}</p>
      <p>{isNetworks ? 'Desde Mendoza diseñamos e instalamos redes LAN/WAN, Wi-Fi corporativo y switching gestionado. Medimos los enlaces y documentamos la obra según su alcance.' : copy.paragraph}</p>
      {cifras.length > 0 && <div class="cifras cifras--compact">{cifras.map(([n, t]) => <div><b>{n}</b><span>{t}</span></div>)}</div>}
      <div class="editorial-actions">
        <div class="service-actions">
          <a class="btn" href="/contacto">Pedir un relevamiento</a>
          {provision.length > 0 && <a class="u" href="#provision">Ver qué proveemos</a>}
        </div>
        {!showProjectArchive && <a class="u" href={archiveHref}>{archiveText}</a>}
      </div>
    </Hero>
    <nav class="wrap service-sections" aria-label="En esta página">
      <a href="#alcance">Qué cubre</a>
      {provision.length > 0 && <a href="#provision">Qué proveemos</a>}
      {(selectedCases.length > 0 || casos.some(c => !c.publicado)) && <a href="#casos">Casos de aplicación</a>}
      <a href="#metodo">Cómo trabajamos</a>
      <a href="#entregables">Qué entregamos</a>
    </nav>

    <section class="sec" id="alcance">
      <div class="wrap">
        <div class="sec__head"><h2>Qué cubre<span class="dot">.</span></h2></div>
        <div class:list={['cubre', editorial ? 'cubre--editorial' : 'cubre--guia']} data-cubre>
          <ul class="caps" data-caps>{choices.map((choice) => <li><h3>{choice.title}</h3><p>{choice.description}</p></li>)}</ul>
          {!editorial && <DeviceExploded code={code} />}
        </div>
        {!provision.length && servicio.capabilities.length > 0 && <details class="technical-scope"><summary>Especificaciones adicionales</summary><ul class="lista">{servicio.capabilities.map((c) => <li>{c}</li>)}</ul></details>}
      </div>
    </section>

    {provision.length > 0 && (
      <Provision
        items={provision}
        introduction={isNetworks ? 'Qué instalamos, cómo lo verificamos y qué documentación recibe tu equipo según el alcance acordado.' : undefined}
      >
        {servicio.capabilities.length > 0 && <details class="technical-scope"><summary>Especificaciones adicionales</summary><ul class="lista">{servicio.capabilities.map((c) => <li>{c}</li>)}</ul></details>}
      </Provision>
    )}
    {code === '104' && <SoftwareExperience />}

    <Casos casos={casos} stories={stories} title={`Lo que hicimos en ${lower}`} selection={selectedCases} textOnly={code === '104'} />

    <section class="sec" id="metodo">
      <div class="wrap cols cols-5-7">
        <h2>Cómo lo hacemos<span class="dot">.</span></h2>
        <div class="cols cols-2">{servicio.proceso.map((s) => <div class="item"><h3>{s.titulo}</h3><p>{s.desc}</p></div>)}</div>
      </div>
    </section>

    <section class="sec" id="entregables">
      <div class="wrap">
        <div class="sec__head"><h2>Qué entregamos<span class="dot">.</span></h2></div>
        <div class="cols cols-4">
          <div class="item"><h3>Alcance</h3><ul class="lista">{spec.scope.map((s) => <li>{s}</li>)}</ul></div>
          <div class="item"><h3>Normas y criterios</h3><ul class="lista">{spec.standards.map((s) => <li>{s}</li>)}</ul></div>
          <div class="item"><h3>Documentación que recibís</h3><ul class="lista">{spec.deliverables.map((s) => <li>{s}</li>)}</ul></div>
          <div class="item"><h3>{editorial ? 'Continuidad y acompañamiento' : 'Después de la obra'}</h3><ul class="lista">{spec.serviceLevel.map((s) => <li>{limpio(s)}</li>)}</ul></div>
        </div>
        {condiciones && <p class="condiciones">{condiciones}.</p>}
        <a class="u service-datasheet" href={datasheetHref} download={pdf ? true : undefined}>{datasheetText}</a>
      </div>
    </section>

    {!editorial && kit.length > 0 && (
      <section class="sec">
        <div class="wrap">
          <div class="sec__head"><h2>Con qué se hace<span class="dot">.</span></h2></div>
          <Partes items={kit.map((p) => ({ key: p.key, label: p.label, meta: servicio.name, n: p.n > 0 ? `${p.n} ${p.n === 1 ? 'antecedente' : 'antecedentes'}` : 'Alcance del servicio' }))} />
        </div>
      </section>
    )}

    {clientes.length > 0 && (
      <section class="sec">
        <div class="wrap">
          <div class="sec__head"><h2>Para quién lo hicimos<span class="dot">.</span></h2></div>
          <ol class="clientes">
            {clientes.slice(0, 9).map((c) => <li><a href={`/antecedentes?cliente=${encodeURIComponent(c.name)}`}>{c.name}</a><span>{c.count}</span></li>)}
            {clientes.length > 9 && <li class="mas">
              <span>Y {clientes.length - 9} clientes más</span>
              <span></span>
            </li>}
          </ol>
        </div>
      </section>
    )}

    {bySector.length > 0 && (
      <section class="sec">
        <div class="wrap">
          <div class="item">
            <h2>Dónde lo hicimos<span class="dot">.</span></h2>
            <p class="frase">{bySector.map((s, i) => <><a href={`/sectores/${s.slug}`}><b>{s.name}</b></a>{` (${s.count} ${s.count === 1 ? 'antecedente' : 'antecedentes'})`}{i < bySector.length - 2 ? ', ' : i === bySector.length - 2 ? ' y ' : '.'}</>)}</p>
          </div>
        </div>
      </section>
    )}

    {showProjectArchive && (
      <section class="sec">
        <div class="wrap">
          <div class="sec__head"><h2>Más proyectos de {lower}<span class="dot">.</span></h2></div>
          <CaseLinks stories={documentedCases} />
          {code === '104' ? <CaseLinks stories={moreCases} /> : moreCases.length > 0 && <ol class:list={["fichas", { "fichas--short": moreCases.length < 3 }]} style={`--case-cols:${moreCases.length}`}>{moreCases.map((c, i) => <Ficha story={c} eager={i < 4} />)}</ol>}
          <a class="u more" href={archiveHref}>{archiveText}</a>
        </div>
      </section>
    )}

    </main>

    <Cierre heading={cierre?.heading} description={cierre?.description} ctaText={cierre?.ctaText} />


  </body>
</html>
