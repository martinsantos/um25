---
/**
 * Propuesta A · "La obra" (2026-10-30). La portada es el despiece. Negro, y el edificio
 * isométrico ocupa la pantalla: al bajar se construye solo, en el orden en que trabajamos:
 * primero la estructura, después los espacios, los equipos, los recorridos de cada servicio
 * y al final las pruebas (los pines). Los cuatro pasos de la casa van encendiéndose a la
 * izquierda. Después: los ocho frentes sobre otra obra, las historias (antecedentes) y los
 * lugares. Textos: sólo frases existentes. No indexable.
 */
import { loadStories, readIso, services } from '../../components/proto/isoData';

export const prerender = false;
const { total, stories, places } = await loadStories();
const building = readIso('building');
const clinic = readIso('clinic');
const recent = stories.slice(0, 8);
const steps = ['Relevamiento', 'Diseño', 'Ejecución', 'Prueba técnica'];
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>La obra · Propuesta A · ULTIMA MILLA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <style>
      :root { --bg: #0a0b0d; --ink: #f4f4f5; --ink-2: #b4b6bb; --ink-3: #6f737a; --line: rgba(255,255,255,.14); --red: #dc2626; --gutter: clamp(20px, 4vw, 64px); --ease: cubic-bezier(.22, 1, .36, 1); }
      * { box-sizing: border-box; }
      html { scroll-behavior: smooth; }
      body { margin: 0; background: var(--bg); color: var(--ink); font: 400 17px/1.5 Manrope, system-ui, sans-serif; -webkit-font-smoothing: antialiased; }
      a { color: inherit; text-decoration: none; }
      h1, h2, h3 { margin: 0; font-weight: 700; letter-spacing: -.03em; line-height: 1; text-wrap: balance; }
      .dot { color: var(--red); }
      .top { position: fixed; inset: 0 0 auto; z-index: 20; display: flex; justify-content: space-between; align-items: center; padding: 18px var(--gutter); mix-blend-mode: difference; }
      .logo { font-weight: 700; font-size: 1.15rem; letter-spacing: -.02em; }
      .logo i { font-style: normal; color: var(--red); }
      nav { display: flex; gap: 28px; font-size: .95rem; font-weight: 500; }
      nav .cta { padding: 8px 14px; border: 1px solid currentColor; }

      /* Portada: la obra se construye al bajar. */
      .obra { height: 420vh; position: relative; }
      .obra__stage { position: sticky; top: 0; height: 100vh; height: 100svh; overflow: hidden; display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); align-items: center; gap: 0 clamp(16px, 3vw, 48px); padding: 0 var(--gutter); }
      .obra__copy { position: relative; z-index: 2; }
      .obra__kicker { margin: 0 0 18px; color: var(--ink-2); font-size: 1rem; }
      .obra h1 { font-size: clamp(2.4rem, 4.6vw, 4.6rem); }
      .obra__lead { margin: 22px 0 0; max-width: 34ch; color: var(--ink-2); font-size: 1.05rem; line-height: 1.55; }
      .pasos { list-style: none; margin: 40px 0 0; padding: 0; display: grid; gap: 10px; counter-reset: paso; }
      .pasos li { display: grid; grid-template-columns: 34px 1fr; align-items: baseline; font-size: 1.05rem; font-weight: 600; color: var(--ink-3); transition: color .5s var(--ease); }
      .pasos li::before { counter-increment: paso; content: counter(paso, decimal-leading-zero); font-weight: 400; font-size: .85rem; color: var(--ink-3); font-variant-numeric: tabular-nums; }
      .pasos li.on { color: var(--ink); }
      .pasos li.on::before { color: var(--red); }
      .obra__art { position: relative; height: min(84vh, 56vw); }
      .obra__art :global(svg) { width: 100%; height: 100%; overflow: visible; display: block; }
      .obra__meter { position: absolute; left: var(--gutter); right: var(--gutter); bottom: 22px; height: 1px; background: var(--line); }
      .obra__meter i { position: absolute; inset: 0 auto 0 0; width: calc(var(--p, 0) * 100%); background: var(--red); }
      .obra__hint { position: absolute; right: var(--gutter); bottom: 34px; font-size: .85rem; color: var(--ink-3); transition: opacity .4s; }
      .obra[data-step]:not([data-step="0"]) .obra__hint { opacity: 0; }

      /* Capas de la isometría, por paso. */
      .obra :global(.sp-structure) { transition: opacity 1.2s var(--ease); }
      .obra :global(.sp-root > *:not(.sp-structure)) { opacity: 0; transition: opacity 1.2s var(--ease); }
      .obra :global(.sp-route), .obra :global(.sp-pin), .obra :global(.sp-leader), .obra :global(.sp-effect) { opacity: 0; transition: opacity .9s var(--ease); }
      .obra :global(.sp-route path) { stroke-dasharray: 2400; stroke-dashoffset: 2400; transition: stroke-dashoffset 2.6s var(--ease); }
      .obra[data-step="0"] :global(.sp-structure) { opacity: 1; }
      .obra:not([data-step="0"]) :global(.sp-root > *:not(.sp-structure)) { opacity: 1; }
      .obra[data-step="2"] :global([data-project-device]), .obra[data-step="3"] :global([data-project-device]), .obra[data-step="4"] :global([data-project-device]), .obra[data-step="5"] :global([data-project-device]) { stroke: #fff; stroke-opacity: .9; }
      .obra[data-step="3"] :global(.sp-route--101), .obra[data-step="3"] :global(.sp-route--102), .obra[data-step="3"] :global(.sp-route--103),
      .obra[data-step="4"] :global(.sp-route), .obra[data-step="5"] :global(.sp-route) { opacity: .95; }
      .obra[data-step="3"] :global(.sp-route--101 path), .obra[data-step="3"] :global(.sp-route--102 path), .obra[data-step="3"] :global(.sp-route--103 path),
      .obra[data-step="4"] :global(.sp-route path), .obra[data-step="5"] :global(.sp-route path) { stroke-dashoffset: 0; }
      .obra[data-step="5"] :global(.sp-pin), .obra[data-step="5"] :global(.sp-leader), .obra[data-step="5"] :global(.sp-effect) { opacity: 1; }

      /* Bandas */
      .band { padding: clamp(80px, 12vh, 160px) var(--gutter) 0; }
      .band h2 { font-size: clamp(2rem, 3.6vw, 3.4rem); }
      .band__lead { margin: 14px 0 0; max-width: 52ch; color: var(--ink-2); font-size: 1.05rem; }

      /* Los ocho frentes: otra obra (centro de salud), cada frente enciende su recorrido. */
      .frentes { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(24px, 4vw, 64px); align-items: start; margin-top: clamp(28px, 4vh, 48px); }
      .frentes__stage { position: sticky; top: 80px; }
      .frentes__stage :global(svg) { width: 100%; height: auto; overflow: visible; display: block; }
      .frentes :global(.sp-route) { opacity: .08; transition: opacity .7s var(--ease); }
      .frentes :global(.sp-pin), .frentes :global(.sp-leader), .frentes :global(.sp-effect) { opacity: 0; transition: opacity .6s var(--ease); }
      .frentes :global(.sp-floor-label) { opacity: 0; }
      .frentes[data-svc="106"] :global(.sp-route) { opacity: .7; }
      .frentes[data-svc="101"] :global(.sp-route--101), .frentes[data-svc="102"] :global(.sp-route--102), .frentes[data-svc="103"] :global(.sp-route--103), .frentes[data-svc="104"] :global(.sp-route--104), .frentes[data-svc="105"] :global(.sp-route--105), .frentes[data-svc="107"] :global(.sp-route--107), .frentes[data-svc="108"] :global(.sp-route--108) { opacity: .95; }
      .frentes[data-svc="101"] :global(.sp-pin--101), .frentes[data-svc="102"] :global(.sp-pin--102), .frentes[data-svc="103"] :global(.sp-pin--103), .frentes[data-svc="104"] :global(.sp-pin--104), .frentes[data-svc="105"] :global(.sp-pin--105), .frentes[data-svc="106"] :global(.sp-pin--106), .frentes[data-svc="107"] :global(.sp-pin--107), .frentes[data-svc="108"] :global(.sp-pin--108) { opacity: 1; }
      .frentes[data-svc="101"] :global([data-project-device="101"]), .frentes[data-svc="102"] :global([data-project-device="102"]), .frentes[data-svc="104"] :global([data-project-device="104"]), .frentes[data-svc="107"] :global([data-project-device="107"]), .frentes[data-svc="108"] :global([data-project-device="108"]) { stroke: #fff; stroke-opacity: 1; }
      .frentes ol { list-style: none; margin: 0; padding: 0; }
      .frentes li a { display: grid; gap: 4px; padding: 16px 0; border-top: 1px solid var(--line); color: var(--ink-3); transition: color .3s; }
      .frentes li:last-child a { border-bottom: 1px solid var(--line); }
      .frentes li a b { font-weight: 600; font-size: 1.2rem; color: var(--ink-2); padding-bottom: 2px; border-bottom: 2px solid transparent; width: max-content; transition: border-color .3s, color .3s; }
      .frentes li a.on b, .frentes li a:hover b { color: var(--ink); border-color: var(--red); }
      .frentes li a.on, .frentes li a:hover { color: var(--ink-2); }

      /* Historias: cada antecedente es una historia; su lugar, en despiece. */
      .historias { display: grid; grid-auto-flow: column; grid-auto-columns: minmax(300px, 34vw); gap: 20px; margin-top: clamp(28px, 4vh, 48px); padding: 0 var(--gutter) 24px; overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none; }
      .historias::-webkit-scrollbar { display: none; }
      .historia { scroll-snap-align: start; display: grid; grid-template-rows: auto 1fr; border: 1px solid var(--line); padding: 18px; min-height: 360px; }
      .historia__iso { aspect-ratio: 5 / 3; background: #0e1013; margin: -18px -18px 16px; display: grid; place-items: center; overflow: hidden; }
      .historia__iso img { width: 100%; height: 100%; object-fit: cover; opacity: .9; }
      .historia__foto { aspect-ratio: 5 / 3; margin: -18px -18px 16px; overflow: hidden; }
      .historia__foto img { width: 100%; height: 100%; object-fit: cover; }
      .historia b { font-size: 1.15rem; font-weight: 600; display: block; }
      .historia p { margin: 6px 0 0; color: var(--ink-2); font-size: 1rem; }
      .historia em { display: block; margin-top: auto; padding-top: 16px; font-style: normal; color: var(--ink-3); font-size: .9rem; }
      .more { display: inline-block; margin: 8px var(--gutter) 0; padding-bottom: 2px; border-bottom: 2px solid var(--red); font-weight: 600; }

      /* Lugares: seis obras, seis despieces. */
      .lugares { list-style: none; margin: clamp(28px, 4vh, 48px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1px; background: var(--line); border: 1px solid var(--line); }
      .lugares li { display: grid; }
      .lugar { background: var(--bg); padding: 22px; display: grid; gap: 14px; align-content: start; }
      .lugar img { width: 100%; aspect-ratio: 5 / 3; object-fit: cover; display: block; }
      .lugar b { font-size: 1.3rem; font-weight: 600; }
      .lugar span { color: var(--ink-2); font-size: 1rem; }
      .lugar em { font-style: normal; color: var(--ink-3); font-size: .9rem; }

      .contacto { display: grid; grid-template-columns: minmax(0, 6fr) minmax(0, 6fr); gap: clamp(32px, 6vw, 96px); padding-bottom: clamp(80px, 12vh, 160px); }
      .contacto p { color: var(--ink-2); max-width: 44ch; }
      .contacto dl { margin: 28px 0 0; display: grid; gap: 10px; color: var(--ink-2); }
      .contacto dl div { display: flex; gap: 14px; }
      .contacto dt { color: var(--ink-3); min-width: 72px; }
      .contacto dd { margin: 0; color: var(--ink); }
      .btn { display: inline-flex; align-items: center; gap: 10px; margin-top: 28px; padding: 16px 24px; background: var(--ink); color: var(--bg); font: inherit; font-weight: 600; border: 0; cursor: pointer; }
      footer { padding: 24px var(--gutter); border-top: 1px solid var(--line); color: var(--ink-3); font-size: .9rem; display: flex; justify-content: space-between; gap: 16px; flex-wrap: wrap; }

      @media (max-width: 900px) {
        nav a:not(.cta) { display: none; }
        .obra { height: 360vh; }
        .obra__stage { grid-template-columns: 1fr; align-content: start; padding-top: 90px; gap: 20px; }
        .obra h1 { font-size: clamp(2rem, 9vw, 2.8rem); }
        .obra__lead { display: none; }
        .pasos { margin-top: 18px; grid-template-columns: 1fr 1fr; }
        .obra__art { height: 44vh; }
        .frentes { grid-template-columns: 1fr; }
        .frentes__stage { position: static; }
        .historias { grid-auto-columns: 82vw; }
        .lugares { grid-template-columns: 1fr; }
        .contacto { grid-template-columns: 1fr; }
      }
      @media (prefers-reduced-motion: reduce) { .obra :global(*) { transition-duration: .01s !important; } }
    </style>
  </head>
  <body>
    <header class="top">
      <a class="logo" href="/">ultimamilla<i>.</i>com<i>.</i>ar</a>
      <nav aria-label="Principal"><a href="/servicios">Servicios</a><a href="/sectores">Sectores</a><a href="/antecedentes">Antecedentes</a><a href="/blog">Blog</a><a class="cta" href="#contacto">Contactar</a></nav>
    </header>

    <section class="obra" data-obra data-step="0" aria-label="Portada">
      <div class="obra__stage">
        <div class="obra__copy">
          <p class="obra__kicker">24 años de servicios IT · Mendoza, Argentina</p>
          <h1>Servicios IT para operaciones que no pueden detenerse<span class="dot">.</span></h1>
          <p class="obra__lead">Redes, seguridad electrónica, telecomunicaciones, software a medida, soporte 24/7 y energía IT. Evidencia operativa visible antes de contratar.</p>
          <ol class="pasos" data-pasos>{steps.map((s) => <li>{s}</li>)}</ol>
        </div>
        <div class="obra__art" set:html={building} />
        <div class="obra__meter"><i></i></div>
        <p class="obra__hint">Bajá para construir la obra</p>
      </div>
    </section>

    <section class="band" id="servicios">
      <h2>Ocho frentes de servicio<span class="dot">.</span></h2>
      <p class="band__lead">Un mismo equipo releva, instala, documenta y sostiene cada sistema, de la obra a la operación diaria.</p>
      <div class="frentes" data-frentes data-svc="101">
        <div class="frentes__stage" set:html={clinic} />
        <ol>{services.map((s, i) => <li><a href={s.href} data-code={s.code} class:list={{ on: i === 0 }}><b>{s.name}</b><span>{s.text}</span></a></li>)}</ol>
      </div>
    </section>

    <section class="band" style="padding-left:0;padding-right:0">
      <div style="padding: 0 var(--gutter)">
        <h2>{total} proyectos documentados<span class="dot">.</span></h2>
        <p class="band__lead">Cada proyecto es una historia: el lugar, el sistema y el equipo que lo sostiene.</p>
      </div>
      <div class="historias">
        {recent.map((c, i) => {
          const place = places.find((p) => p.slug === c.sectorSlug);
          return (
            <a class="historia" href={c.href}>
              {place && i % 2 === 0 ? <div class="historia__iso"><img src={`/cine/iso/site-${place.site}-v2.svg`} alt="" loading="lazy" /></div> : <div class="historia__foto"><img src={c.image} alt="" loading="lazy" /></div>}
              <b>{c.client}</b>
              <p>{c.title}</p>
              <em>{[c.sector, c.year, c.services[0]].filter(Boolean).join(' · ')}</em>
            </a>
          );
        })}
      </div>
      <a class="more" href="/antecedentes">Ver los {total} proyectos</a>
    </section>

    <section class="band" id="sectores">
      <h2>Lugares<span class="dot">.</span></h2>
      <ul class="lugares">
        {places.map((p) => <li><a class="lugar" href={p.href}><img src={`/cine/iso/site-${p.site}-v2.svg`} alt="" loading="lazy" /><b>{p.name}</b><span>{p.text}</span>{p.count > 0 && <em>{p.count} proyectos</em>}</a></li>)}
      </ul>
    </section>

    <section class="band contacto" id="contacto">
      <div>
        <h2>Contanos qué tiene que seguir funcionando<span class="dot">.</span></h2>
        <p>Indicá qué necesitás, dónde y para cuándo. Un técnico te responde por email con el próximo paso: diagnóstico, relevamiento, propuesta o documentación.</p>
        <dl><div><dt>Email</dt><dd>contacto@ultimamilla.com.ar</dd></div><div><dt>Oficina</dt><dd>Houssay 1159, Guaymallén, Mendoza</dd></div><div><dt>Horario</dt><dd>Lunes a viernes, 8 a 18 h</dd></div></dl>
      </div>
      <div><a class="btn" href="/contacto">Enviar consulta <span aria-hidden="true">→</span></a></div>
    </section>
    <footer><span>ultimamilla.com.ar</span><span>Houssay 1159, Guaymallén, Mendoza · contacto@ultimamilla.com.ar</span></footer>

    <script>
      const obra = document.querySelector<HTMLElement>('[data-obra]')!;
      const pasos = [...obra.querySelectorAll<HTMLElement>('[data-pasos] li')];
      const stepOf = (p: number) => (p < .08 ? 0 : p < .24 ? 1 : p < .4 ? 2 : p < .6 ? 3 : p < .8 ? 4 : 5);
      const pasoOf = [-1, 0, 1, 2, 2, 3];
      let raf = 0;
      const update = () => {
        raf = 0;
        const r = obra.getBoundingClientRect();
        const p = Math.min(1, Math.max(0, -r.top / (r.height - innerHeight)));
        const step = stepOf(p);
        obra.style.setProperty('--p', String(p));
        if (obra.dataset.step !== String(step)) obra.dataset.step = String(step);
        pasos.forEach((li, i) => li.classList.toggle('on', i <= pasoOf[step]));
      };
      addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
      addEventListener('resize', update);
      update();

      // Los ocho frentes: cada ítem enciende su recorrido.
      const frentes = document.querySelector<HTMLElement>('[data-frentes]')!;
      const items = [...frentes.querySelectorAll<HTMLAnchorElement>('[data-code]')];
      const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
      const show = (a: HTMLAnchorElement) => { frentes.dataset.svc = a.dataset.code!; items.forEach((i) => i.classList.toggle('on', i === a)); };
      items.forEach((a) => {
        if (fine) { a.addEventListener('pointerenter', () => show(a)); a.addEventListener('focus', () => show(a)); }
        else a.addEventListener('click', (e) => { if (frentes.dataset.svc !== a.dataset.code) { e.preventDefault(); show(a); } });
      });
      // Sin puntero fino, los frentes se recorren solos mientras la sección está a la vista.
      if (!fine) {
        let i = 0, timer: ReturnType<typeof setInterval> | undefined;
        new IntersectionObserver(([e]) => {
          clearInterval(timer);
          if (e.isIntersecting) timer = setInterval(() => { i = (i + 1) % items.length; show(items[i]); }, 2200);
        }, { threshold: .3 }).observe(frentes);
      }
    </script>
  </body>
</html>
