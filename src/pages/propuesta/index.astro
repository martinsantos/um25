---
/**
 * Portada "Rayos X" (2026-10-30), versión refinada del sistema Despiece. Cada lugar en dos
 * capas: la imagen real (en la apertura, la película de Blender del edificio; después, la
 * foto de cada sector) y, debajo, su despiece. Al bajar, un corte fino recorre la imagen y
 * deja ver los sistemas; la foto queda como un fantasma leve, el lugar no desaparece.
 * Sólo la primera isometría viaja en el HTML; las demás se traen cuando se acercan.
 * Textos: sólo frases existentes. No indexable.
 */
import '../../styles/proto-despiece.css';
import { loadStories, readIso, services, posterOf } from '../../components/proto/isoData';

export const prerender = false;
const { total, places } = await loadStories();
const building = readIso('building');
const steps = ['Relevamiento', 'Diseño', 'Ejecución', 'Prueba técnica'];
const pad = (n: number) => String(n).padStart(2, '0');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>Rayos X · Portada · ULTIMA MILLA</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" /><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap" rel="stylesheet" />
    <style>
      /* Cada lugar: escenario fijo mientras el corte baja. */
      .lugar { position: relative; height: 190vh; }
      .lugar--open { height: 230vh; }
      .lugar__pin { position: sticky; top: 0; height: 100vh; height: 100svh; display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: clamp(20px, 3vw, 56px); align-items: center; padding: 0 var(--gutter); overflow: hidden; }
      .lugar .xray { max-height: 80vh; }
      .lugar :global(.sp-route path) { stroke-dashoffset: 2400; }
      .lugar[data-fase="2"] :global(.sp-route), .lugar[data-fase="3"] :global(.sp-route) { opacity: .9; }
      .lugar[data-fase="2"] :global(.sp-route path), .lugar[data-fase="3"] :global(.sp-route path) { stroke-dashoffset: 0; }
      .lugar[data-fase="3"] :global(.sp-pin), .lugar[data-fase="3"] :global(.sp-effect) { opacity: 1; }
      .lugar[data-fase="2"] :global([data-project-device]), .lugar[data-fase="3"] :global([data-project-device]) { stroke: #fff; stroke-opacity: .8; }
      .copy { display: grid; gap: 14px; align-content: center; }
      .copy h1 { font-size: clamp(2.4rem, 4.4vw, 4.4rem); }
      .copy h2 { font-size: clamp(2.2rem, 4vw, 4rem); }
      .copy > p { margin: 0; color: var(--ink-2); font-size: 1.08rem; max-width: 36ch; }
      .fases { display: flex; gap: 16px; margin: 6px 0 0; padding: 0; list-style: none; }
      .fases li { transition: color .4s; }
      .fases li.on { color: var(--ink); }
      .rows { list-style: none; margin: 14px 0 0; padding: 0; border-top: 1px solid var(--line); }
      .rows a { display: grid; grid-template-columns: 72px 1fr; gap: 2px 12px; padding: 11px 0; border-bottom: 1px solid var(--line-2); align-items: baseline; }
      .rows a .mono { grid-row: 1 / span 2; padding-top: 3px; }
      .rows b { grid-column: 2; font-weight: 600; font-size: 1rem; }
      .rows .t { grid-column: 2; color: var(--ink-3); font-size: .9rem; }
      .copy .u { margin-top: 12px; }
      .n { position: absolute; left: var(--gutter); bottom: 24px; }

      /* Frentes y cierre */
      .band { padding: clamp(80px, 12vh, 160px) var(--gutter) 0; }
      .band h2 { font-size: clamp(2rem, 3.4vw, 3.2rem); }
      .band__lead { margin: 14px 0 0; max-width: 52ch; color: var(--ink-2); font-size: 1.05rem; }
      .frentes { list-style: none; margin: 32px 0 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 clamp(24px, 4vw, 64px); border-top: 1px solid var(--line); }
      .frentes a { display: grid; grid-template-columns: 26px 1fr; gap: 4px 14px; padding: 16px 0; border-bottom: 1px solid var(--line-2); align-items: center; }
      .frentes a .llamada { grid-row: 1 / span 2; }
      .frentes b { grid-column: 2; font-weight: 600; font-size: 1.1rem; }
      .frentes .t { grid-column: 2; color: var(--ink-3); font-size: .95rem; }
      .frentes a:hover .llamada { background: var(--red); border-color: var(--red); color: #fff; }
      .cierre { margin: clamp(80px, 12vh, 160px) var(--gutter) 0; }
      .cierre .hoja__body { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(24px, 4vw, 64px); align-items: end; }
      .cierre h2 { font-size: clamp(2rem, 3.4vw, 3.2rem); }
      .cierre p { color: var(--ink-2); max-width: 44ch; margin: 14px 0 0; }
      .cierre .btn { justify-self: start; }

      @media (max-width: 900px) {
        .lugar { height: 170vh; }
        .lugar__pin { grid-template-columns: 1fr; align-content: start; padding-top: 80px; gap: 16px; }
        .lugar .xray { max-height: 40vh; }
        .copy h1 { font-size: 2.2rem; }
        .copy h2 { font-size: 2rem; }
        .rows a:nth-child(n+3) { display: none; }
        .n { display: none; }
        .frentes { grid-template-columns: 1fr; }
        .cierre .hoja__body { grid-template-columns: 1fr; }
      }
    </style>
  </head>
  <body>
    <header class="top top--over">
      <a class="logo" href="/propuesta">ultimamilla<i>.</i>com<i>.</i>ar</a>
      <nav aria-label="Principal"><a href="/servicios">Servicios</a><a href="/sectores">Sectores</a><a href="/propuesta/antecedentes">Antecedentes</a><a href="/blog">Blog</a><a class="cta" href="#contacto">Contactar</a></nav>
    </header>

    {/* Apertura: la película del edificio se abre hasta su despiece. */}
    <section class="lugar lugar--open" data-lugar data-fase="0" aria-label="Portada">
      <div class="lugar__pin">
        <div class="copy">
          <span class="mono">24 años de servicios IT · Mendoza, Argentina</span>
          <h1>Servicios IT para operaciones que no pueden detenerse<span class="dot">.</span></h1>
          <p>Redes, seguridad electrónica, telecomunicaciones, software a medida, soporte 24/7 y energía IT. Evidencia operativa visible antes de contratar.</p>
          <ol class="fases mono" data-fases>{steps.map((s) => <li>{s}</li>)}</ol>
          <a class="u" href="/propuesta/antecedentes">{total} proyectos documentados</a>
        </div>
        <div class="xray">
          <div class="xray__ghost"><img src={posterOf('constructoras')} alt="" width="1920" height="1080" /></div>
          <div class="xray__iso iso" set:html={building} />
          <div class="xray__foto">
            <video muted playsinline loop preload="none" poster={posterOf('constructoras')} data-film="/cine/media/cine-fachada.mp4" width="1920" height="1080"></video>
          </div>
          <div class="xray__linea"></div>
        </div>
        <span class="n mono">00 / {pad(places.length)} · Edificio</span>
      </div>
    </section>

    {places.map((p, i) => (
      <section class="lugar" data-lugar data-fase="0" aria-label={p.name}>
        <div class="lugar__pin">
          <div class="copy">
            <span class="mono">{pad(i + 1)} / {pad(places.length)}</span>
            <h2>{p.name}<span class="dot">.</span></h2>
            <p>{p.text}</p>
            <ol class="fases mono" data-fases>{steps.map((s) => <li>{s}</li>)}</ol>
            {p.stories.length > 0 && <ol class="rows">{p.stories.map((c) => <li><a href={c.href}><span class="mono">UM-{c.id}</span><b>{c.client}</b><span class="t">{c.title}{c.year ? ` · ${c.year}` : ''}</span></a></li>)}</ol>}
            <a class="u" href={`/propuesta/antecedentes?sector=${p.slug}`}>{p.count > 0 ? `${p.count} proyectos` : `Ver ${p.name.toLowerCase()}`}</a>
          </div>
          <div class="xray">
            <div class="xray__ghost"><img src={p.image} alt="" width="1672" height="941" loading="lazy" /></div>
            <div class="xray__iso iso" data-src={`/cine/iso/site-${p.site}-v2.svg`}></div>
            <div class="xray__foto"><img src={p.image} alt="" width="1672" height="941" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" /></div>
            <div class="xray__linea"></div>
          </div>
        </div>
      </section>
    ))}

    <section class="band" id="servicios">
      <h2>Ocho frentes de servicio<span class="dot">.</span></h2>
      <p class="band__lead">Un mismo equipo releva, instala, documenta y sostiene cada sistema, de la obra a la operación diaria.</p>
      <ul class="frentes">{services.map((s, i) => <li><a href={s.href}><span class="llamada">{pad(i + 1)}</span><b>{s.name}</b><span class="t">{s.text}</span></a></li>)}</ul>
    </section>

    <section class="cierre hoja" id="contacto">
      <div class="hoja__head"><span class="mono">Contacto</span><span class="mono">ULTIMA MILLA · Mendoza</span></div>
      <div class="hoja__body">
        <div>
          <h2>Contanos qué tiene que seguir funcionando<span class="dot">.</span></h2>
          <p>Indicá qué necesitás, dónde y para cuándo. Un técnico te responde por email con el próximo paso: diagnóstico, relevamiento, propuesta o documentación.</p>
        </div>
        <a class="btn" href="/contacto">Enviar consulta <span aria-hidden="true">→</span></a>
      </div>
      <div class="cajetin" style="--cols:3"><div><span class="mono">Email</span><b>contacto@ultimamilla.com.ar</b></div><div><span class="mono">Oficina</span><b>Houssay 1159, Guaymallén, Mendoza</b></div><div><span class="mono">Horario</span><b>Lunes a viernes, 8 a 18 h</b></div></div>
    </section>
    <footer class="pie"><span>ultimamilla.com.ar</span><span>Houssay 1159, Guaymallén, Mendoza · contacto@ultimamilla.com.ar</span></footer>

    <script>
      const lugares = [...document.querySelectorAll<HTMLElement>('[data-lugar]')];
      // Las isometrías de los lugares se traen cuando se acercan; la primera ya viene en el HTML.
      const io = new IntersectionObserver((entries) => entries.forEach((e) => {
        if (!e.isIntersecting) return;
        const el = e.target as HTMLElement; io.unobserve(el);
        fetch(el.dataset.src!).then((r) => (r.ok ? r.text() : '')).then((svg) => { if (svg) el.innerHTML = svg; });
      }), { rootMargin: '900px 0px' });
      document.querySelectorAll<HTMLElement>('.xray__iso[data-src]').forEach((el) => io.observe(el));
      // La película de la apertura sólo en pantallas anchas y sin movimiento reducido.
      const film = document.querySelector<HTMLVideoElement>('video[data-film]');
      if (film && matchMedia('(min-width: 900px)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches) { film.src = film.dataset.film!; film.play().catch(() => {}); }

      let raf = 0;
      const update = () => {
        raf = 0;
        lugares.forEach((el) => {
          const r = el.getBoundingClientRect();
          if (r.bottom < 0 || r.top > innerHeight) return;
          const p = Math.min(1, Math.max(0, -r.top / (r.height - innerHeight)));
          const cut = 100 - Math.min(1, p / .5) * 100;
          el.style.setProperty('--cut', String(cut));
          el.style.setProperty('--linea', p < .02 || p > .52 ? '0' : '1');
          const fase = p < .12 ? 0 : p < .5 ? 1 : p < .78 ? 2 : 3;
          if (el.dataset.fase !== String(fase)) el.dataset.fase = String(fase);
          el.querySelectorAll<HTMLElement>('[data-fases] li').forEach((li, i) => li.classList.toggle('on', i < fase || (fase === 3 && i === 3)));
        });
      };
      addEventListener('scroll', () => { if (!raf) raf = requestAnimationFrame(update); }, { passive: true });
      addEventListener('resize', update);
      update();
    </script>
  </body>
</html>
