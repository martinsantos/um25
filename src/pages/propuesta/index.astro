---
/* Portada pública: catálogo, explorador de servicios y proyectos documentados. */
import '../../styles/proto-despiece.css';
import Head from '../../components/proto/Head.astro';
import Top from '../../components/proto/Top.astro';
import planta from '../../media/home/planta-1440.webp?url';
import plantaSmall from '../../media/home/planta-720.webp?url';
import AperturaPortada from '../../components/proto/AperturaPortada.astro';
import EmpresaPortada from '../../components/proto/EmpresaPortada.astro';
import ExploradorServicios from '../../components/proto/ExploradorServicios.astro';
import ObrasPortada from '../../components/proto/ObrasPortada.astro';
import Casos from '../../components/proto/Casos.astro';
import Cierre from '../../components/proto/Cierre.astro';
import { getServicios } from '../../lib/um26-directus';
import { loadStories, services } from '../../components/proto/isoData';
import ClientDirectory from '../../components/proto/ClientDirectory.astro';
import { clientsForStories } from '../../components/proto/clientDirectory';
import { portadaCases } from '../../components/proto/portadaCases';
import { sectorDirectory } from '../../components/proto/sectorDirectory';
import { SECTOR_NAV_MEDIA } from '../../data/navigationMedia';


import { yearsOfExperience } from '../../config/publicFacts';
export const prerender = false;
const [{ total, stories }, catalog] = await Promise.all([loadStories(), getServicios()]);
const obrasPortada = portadaCases(stories, 'inicio');
const principales = obrasPortada.slice(0, 3);
const masObras = obrasPortada.slice(3);
const enlaceMasObras = masObras.length ? {
  label: masObras.length === 1 ? 'Ver otra obra' : `Ver las otras ${masObras.length} obras`,
  href: '#mas-obras',
} : undefined;
const clientes = clientsForStories(stories);
const lugares = sectorDirectory(stories);
// A calendar-year difference is the conservative count; the founding year
// itself is not a completed year of experience.
const anios = yearsOfExperience();
---
<!doctype html>
<html lang="es">
  <head>
    <Head title="Infraestructura IT, redes y seguridad electrónica en Mendoza · ULTIMA MILLA" description={`Redes, seguridad electrónica, telecomunicaciones, software a medida, soporte 24/7 y energía IT. ${anios} años y ${total} antecedentes registrados desde Mendoza.`} image={planta} />
    <link rel="preload" as="image" type="image/webp" href={planta} imagesrcset={`${plantaSmall} 720w, ${planta} 1440w`} imagesizes="100vw" />
    <script is:inline>
      // Leave the artwork available by default if JavaScript or the observer is unavailable.
      if ('IntersectionObserver' in window) {
        const gate = 'defer-home-scene-art';
        const root = document.documentElement;
        root.classList.add(gate);
        document.addEventListener('DOMContentLoaded', () => {
          try {
            const observer = new IntersectionObserver((entries) => {
              for (const entry of entries) {
                if (!entry.isIntersecting) continue;
                entry.target.setAttribute('data-art-ready', '');
                observer.unobserve(entry.target);
              }
            }, { rootMargin: '280px 0px' });
            document.querySelectorAll('#servicios .service-scene').forEach(scene => observer.observe(scene));
          } catch {
            root.classList.remove(gate);
          }
        }, { once: true });
      }
    </script>
    <style>
      :global(.defer-home-scene-art) #servicios :global(.service-scene:not([data-art-ready]) :is(.ts__object,.fs__sprite)) { background-image:none; }
      :is(#servicios,#lugares):focus-visible { outline:none; }
      #servicios:focus-visible :global(#explorador-titulo), #lugares:focus-visible h2 { text-decoration:underline; text-decoration-color:var(--red-text); text-underline-offset:6px; }
      .sectores-home { margin-top:var(--s5); padding-top:var(--s3); border-top:1px solid var(--line); }
      .sectores-head { display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:0 24px; margin-bottom:16px; }
      .sectores-head h2 { font-size:clamp(1.6rem,2.6vw,2.5rem); }
      .sectores-head a,.lugares a { display:inline-flex; align-items:center; min-height:44px; line-height:1.3; }
      .sectores-head a { gap:8px; font-weight:600; }
      .lugares { margin:0; padding:0; list-style:none; display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,21rem),1fr)); gap:4px clamp(16px,2.5vw,38px); }
      .lugares li { --foto:clamp(60px,7vw,96px); position:relative; min-width:0; display:grid; grid-template-columns:minmax(0,1fr) auto; grid-template-rows:auto 1fr; gap:0 10px; align-content:start; padding:8px 0 12px calc(var(--foto) + 14px); border-top:1px solid var(--line); }
      .lugar { font-size:1.1rem; font-weight:650; letter-spacing:-.02em; }
      .lugar img { position:absolute; inset:12px auto auto 0; width:var(--foto); height:calc(var(--foto) * .91); object-fit:cover; }
      .n { align-self:start; gap:4px; font-size:.875rem; white-space:nowrap; }
      .obra-sector { scroll-margin-top:12px; grid-column:1/-1; align-self:start; justify-self:start; font-size:.95rem; text-wrap:pretty; color:var(--ink-2); }
      .obra-sector span { text-decoration:underline; text-decoration-color:var(--line); text-underline-offset:3px; }
      .sectores-home a:hover,.sectores-home a:focus-visible { text-decoration:underline; text-underline-offset:4px; }
      .sectores-home a:focus-visible { outline:2px solid currentColor; outline-offset:2px; }
      @media(max-width:380px){ .lugares li { --foto:48px; column-gap:6px; padding-left:calc(var(--foto) + 10px); } }
    </style>
  </head>
  <body>
    <Top />
    <main id="contenido" tabindex="-1">

    <AperturaPortada obras={obrasPortada} obrasHref={principales.length ? "#casos" : "/antecedentes"}
      servicios={services.length} sectores={lugares.length} />

    {principales.length ? <ObrasPortada home obras={principales} jump={enlaceMasObras} /> :
      <Casos casos={[]} stories={stories} candidates={stories} title="Obras de ULTIMA MILLA" max={3} portada />}

    <section class="sec" id="servicios" tabindex="-1" aria-labelledby="explorador-titulo">
      <div class="wrap">
        <ExploradorServicios stories={stories} catalog={catalog} />
        <section id="lugares" class="sectores-home" tabindex="-1" aria-labelledby="sectores-home-title">
          <div class="sectores-head">
            <h2 id="sectores-home-title">Sectores<span class="dot">.</span></h2>
            <a href="/sectores#catalogo">Comparar sectores <span aria-hidden="true">→</span></a>
          </div>
          <ul class="lugares">{lugares.map(l => <li>
            <a class="lugar" href={l.href}>
              <img src={SECTOR_NAV_MEDIA[l.slug]} alt="" width="96" height="88" loading="lazy" decoding="async" />
              {l.name}
            </a>
            {l.count > 0 && <a class="n" href={l.archiveHref} aria-label={`Ver ${l.count} ${l.count === 1 ? 'obra' : 'obras'} de ${l.name}`}>
              {l.count} {l.count === 1 ? 'obra' : 'obras'} <span aria-hidden="true">→</span>
            </a>}
            <a class="obra-sector" id={`obra-sector-${l.slug}`} data-regreso-obra={`inicio-sector-${l.slug}`}
              href={l.reference ? l.reference.href + '?desde=inicio&sector=' + l.slug : l.task?.href || l.detailHref}>
              <span>{l.reference?.title || l.task?.title || l.detailLabel}&nbsp;<span aria-hidden="true">↗</span></span>
            </a>
          </li>)}</ul>
        </section>
      </div>
    </section>

    {masObras.length > 0 && <ObrasPortada home obras={masObras} continuation title="Más obras destacadas"
      jump={{label: `Ver los ${total} antecedentes`, href: '/antecedentes'}} />}

    <ClientDirectory title="Para quién lo hicimos" clients={clientes} archiveLabel="Ver todos los antecedentes" />

    <EmpresaPortada stories={stories} />

    </main>

    <Cierre />
  </body>
</html>
