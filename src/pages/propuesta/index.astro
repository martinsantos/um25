---
/**
 * Portada (2026-10-30, v4). Cuenta la empresa con sus propios datos: quiénes son y cómo
 * trabajan (de Nosotros), los lugares por dentro, los casos con el alcance real, los clientes,
 * los ocho frentes y la documentación que entregan (de Certificaciones). No indexable.
 */
import '../../styles/proto-despiece.css';
import Head from '../../components/proto/Head.astro';
import Top from '../../components/proto/Top.astro';
import Apertura from '../../components/proto/Apertura.astro';
import Casos from '../../components/proto/Casos.astro';
import Cierre from '../../components/proto/Cierre.astro';
import { loadStories, services, posterOf } from '../../components/proto/isoData';
import { EMPRESA, CUMPLIMIENTO, CASOS } from '../../components/proto/relato';

export const prerender = false;
const { total, places, stories } = await loadStories();
const clientes = Object.values(stories.reduce<Record<string, { name: string; count: number }>>((acc, s) => { const k = s.client.toLowerCase(); (acc[k] ||= { name: s.client, count: 0 }).count++; return acc; }, {})).sort((a, b) => b.count - a.count).slice(0, 16);
---
<!doctype html>
<html lang="es">
  <head>
    <Head title="Servicios IT para operaciones que no pueden detenerse · ULTIMA MILLA" />
    <style>
      .historia { margin: var(--s5) 0 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s3) clamp(20px, 3vw, 48px); border-top: 1px solid var(--line); }
      .historia li { padding-top: var(--s2); display: grid; gap: 6px; align-content: start; }
      .historia .small { color: var(--ink); }
      .sedes { display: flex; flex-wrap: wrap; gap: 8px 28px; margin: 0; padding: 0; list-style: none; color: var(--ink-2); }
      .sedes b { color: var(--ink); font-weight: 600; margin-right: 8px; }
      .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
      .rows a { display: grid; gap: 2px; padding: 11px 0; border-bottom: 1px solid var(--line-2); }
      .rows b { font-weight: 600; font-size: 1rem; }
      .rows .t { color: var(--ink-3); font-size: .9rem; }
      .frentes { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 clamp(28px, 4vw, 72px); border-top: 1px solid var(--line); }
      .frentes a { display: grid; gap: 4px; padding: 18px 0; border-bottom: 1px solid var(--line-2); }
      .frentes b { font-weight: 600; font-size: 1.15rem; }
      .frentes span { color: var(--ink-2); }
      @media (max-width: 1100px) { .historia { grid-template-columns: 1fr 1fr; } }
      @media (max-width: 900px) { .historia, .frentes { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <Top />
    <main id="contenido">

    <Apertura label="Portada" isoSrc="/cine/iso/site-building-v2.svg" image={posterOf('constructoras')} film="/cine/media/cine-fachada.mp4" open>
      <span class="small">24 años de servicios IT. Mendoza, Argentina.</span>
      <h1>Servicios IT para operaciones que no pueden detenerse<span class="dot">.</span></h1>
      <p>Redes, seguridad electrónica, telecomunicaciones, software a medida, soporte 24/7 y energía IT. Evidencia operativa visible antes de contratar.</p>
      <a class="u" href="/propuesta/antecedentes">{total} proyectos documentados</a>
    </Apertura>

    <section class="sec" id="empresa">
      <div class="wrap">
        <div class="cols cols-5-7">
          <div class="prosa">
            <h2>{EMPRESA.titulo}<span class="dot">.</span></h2>
            <p class="lead">{EMPRESA.lead}</p>
            <p>{EMPRESA.cobertura} {EMPRESA.coberturaDetalle}</p>
            <ul class="sedes">{EMPRESA.sedes.map((s) => <li><b>{s.name}</b>{s.detail || s.role}</li>)}</ul>
          </div>
          <div class="cols cols-2">{EMPRESA.principios.map(([t, d]) => <div class="item"><h3>{t}</h3><p>{d}</p></div>)}</div>
        </div>
        <ol class="historia">{EMPRESA.historia.map(([y, t, d]) => <li><span class="small">{y}</span><h3>{t}</h3><p class="muted">{d}</p></li>)}</ol>
      </div>
    </section>

    {places.map((p, i) => (
      <Apertura label={p.name} isoSrc={`/cine/iso/site-${p.site}-v2.svg`} image={p.image} eager={i === 0}>
        <h2>{p.name}<span class="dot">.</span></h2>
        <p>{p.text}</p>
        {p.stories.length > 0 && <ol class="rows">{p.stories.map((c) => <li><a href={c.href}><b>{c.client}</b><span class="t">{c.title}{c.year ? ` · ${c.year}` : ''}</span></a></li>)}</ol>}
        <a class="u" href={p.count > 0 ? `/propuesta/antecedentes?sector=${p.slug}` : `/propuesta/sectores/${p.slug}`}>{p.count > 0 ? `${p.count} proyectos en ${p.name.toLowerCase()}` : p.name}</a>
      </Apertura>
    ))}

    <Casos casos={CASOS} stories={stories} title="Lo que hicimos, con el alcance de cada obra" max={6} />

    <section class="sec" id="clientes">
      <div class="wrap">
        <div class="sec__head"><h2>Para quién lo hicimos<span class="dot">.</span></h2></div>
        <p class="frase">{clientes.map((c, i) => <><b>{c.name}</b>{c.count > 1 ? ` (${c.count} proyectos)` : ''}{i < clientes.length - 2 ? ', ' : i === clientes.length - 2 ? ' y ' : '.'}</>)}</p>
      </div>
    </section>

    <section class="sec" id="servicios">
      <div class="wrap">
        <div class="sec__head"><h2>Ocho frentes de servicio<span class="dot">.</span></h2><p>Un mismo equipo releva, instala, documenta y sostiene cada sistema, de la obra a la operación diaria.</p></div>
        <ul class="frentes">{services.map((s) => <li><a href={`/propuesta/servicios/${s.code}`}><b>{s.name}</b><span>{s.text}</span></a></li>)}</ul>
      </div>
    </section>

    <section class="sec" id="documentacion">
      <div class="wrap">
        <div class="sec__head"><h2>Cada obra se entrega medida, documentada y trazable<span class="dot">.</span></h2></div>
        <div class="cols cols-3">{CUMPLIMIENTO.map(([t, d]) => <div class="item"><h3>{t}</h3><p>{d}</p></div>)}</div>
      </div>
    </section>

    </main>

    <Cierre />
  </body>
</html>
