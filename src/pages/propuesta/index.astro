---
/* Portada pública: catálogo, explorador de servicios y proyectos documentados. */
import '../../styles/proto-despiece.css';
import Head from '../../components/proto/Head.astro';
import Top from '../../components/proto/Top.astro';
import AperturaPortada from '../../components/proto/AperturaPortada.astro';
import EmpresaPortada from '../../components/proto/EmpresaPortada.astro';
import ExploradorServicios from '../../components/proto/ExploradorServicios.astro';
import Casos from '../../components/proto/Casos.astro';
import Cierre from '../../components/proto/Cierre.astro';
import { loadStories } from '../../components/proto/isoData';
import { sectorRelato } from '../../components/proto/relato';
import { PORTADA_CASOS_IDS } from '../../data/propuesta/casos-destacados';
import type { Caso } from '../../components/proto/relato';
import { publicCaseFor } from '../../components/proto/casePresentation';
import { SECTORS } from '../../data/cine/scenes';
import { matchesCatalog } from '../../components/proto/catalogFilters';

import { isNamedClient } from '../../components/proto/catalogEditorial';

import { yearsOfExperience } from '../../config/publicFacts';
export const prerender = false;
const { total, stories } = await loadStories();
const casosPortada: Caso[] = PORTADA_CASOS_IDS.flatMap((id) => {
  const story = stories.find((s) => s.id === id);
  const detail = story && publicCaseFor(story);
  return story && detail ? [{ id, publicado: id, titulo: detail.title, cliente: story.client, sector: story.sectorSlug, servicios: story.serviceCodes, year: story.year, texto: detail.introduction }] : [];
});
const clientes = Object.values(stories.filter(s => isNamedClient(s.client)).reduce<Record<string, { name: string; count: number }>>((acc, s) => { const k = s.client.toLowerCase(); (acc[k] ||= { name: s.client, count: 0 }).count++; return acc; }, {})).sort((a, b) => b.count - a.count);
const lugares = SECTORS.map((s) => ({ ...s, count: stories.filter((c) => matchesCatalog({sector: c.sectorSlug, services: c.serviceCodes, year: String(c.year), client: c.client, search: '', status: c.status}, {sector: s.slug})).length, headline: sectorRelato(s.slug).headline || s.text })).sort((a, b) => b.count - a.count);
// A calendar-year difference is the conservative count; the founding year
// itself is not a completed year of experience.
const anios = yearsOfExperience();
const cifras: [string, string][] = [[String(anios), 'años de servicios IT'], [String(total), 'antecedentes registrados'], [String(clientes.length), 'clientes identificados'], [String(lugares.length), 'sectores']];
---
<!doctype html>
<html lang="es">
  <head>
    <Head title="Servicios IT para operaciones que no pueden detenerse · ULTIMA MILLA" description={`Redes, seguridad electrónica, telecomunicaciones, software a medida, soporte 24/7 y energía IT. ${anios} años y ${total} antecedentes registrados desde Mendoza.`} image="/images/editorial/umsa-home-operations.webp" precargar />
    <style>
      /* Los sectores: una línea, sin fotos. Las fotos se guardan para los casos. */
      .lugares { margin: var(--s4) 0 0; padding: var(--s3) 0 0; list-style: none; display: flex; flex-wrap: wrap; gap: 10px 28px; border-top: 1px solid var(--line); }
      .lugares a { font-weight: 600; font-size: 1.1rem; }
      .lugares a:hover { text-decoration: underline; text-decoration-color: var(--red); text-underline-offset: 4px; }
      .lugares .n { color: var(--ink-3); font-weight: 400; font-size: 1rem; margin-left: 8px; }

    </style>
  </head>
  <body>
    <Top />
    <main id="contenido">

    <AperturaPortada cifras={cifras} total={total} />

    <section class="sec" id="clientes">
      <div class="wrap">
        <div class="sec__head"><h2>Para quién lo hicimos<span class="dot">.</span></h2></div>
        <ol class="clientes">
          {clientes.slice(0, 12).map((c) => <li><a href={`/antecedentes?cliente=${encodeURIComponent(c.name)}`}>{c.name}</a><span>{c.count}</span></li>)}
          <li class="mas"><a href="/antecedentes">Y {clientes.length - 12} más</a><span></span></li>
        </ol>
      </div>
    </section>

    <section class="sec" id="servicios">
      <div class="wrap">
        <ExploradorServicios stories={stories} />
        <ol class="lugares" id="lugares" aria-label="Sectores">{lugares.map((l) => <li><a href={`/sectores/${l.slug}`}>{l.name}{l.count > 0 && <span class="n">{l.count}</span>}</a></li>)}<li><a class="muted" href="/sectores">Todos los sectores</a></li></ol>
      </div>
    </section>

    <Casos casos={casosPortada} stories={stories} title="Proyectos que muestran cómo trabajamos" max={3} />

    <EmpresaPortada />

    </main>

    <Cierre />
  </body>
</html>
