---
/** Los sectores (2026-10-30): foto a pleno, cabecera de la página de sector y cuántos proyectos. No indexable. */
import '../../../styles/proto-despiece.css';
import Head from '../../../components/proto/Head.astro';
import Top from '../../../components/proto/Top.astro';
import Cierre from '../../../components/proto/Cierre.astro';
import { loadStories, SECTOR_PHOTO } from '../../../components/proto/isoData';
import { sectorRelato } from '../../../components/proto/relato';
import { SECTORS } from '../../../data/cine/scenes';
import { CLASIFICACIONES_DE_SERVICIO } from '../../../components/proto/sectorReal';

export const prerender = false;
const { stories } = await loadStories();
const items = SECTORS.filter((s) => !CLASIFICACIONES_DE_SERVICIO.has(s.slug)).map((s) => { const r = sectorRelato(s.slug); return { ...s, photo: SECTOR_PHOTO[s.slug] || SECTOR_PHOTO.constructoras, headline: r.headline || s.name, summary: r.summary || s.text, count: stories.filter((c) => c.sectorSlug === s.slug).length }; });
---
<!doctype html>
<html lang="es">
  <head>
    <Head title="Sectores · ULTIMA MILLA" />
    <style>
      .intro { padding-block: var(--s5) var(--s4); }
      .intro h1 { max-width: 16ch; }
      .intro p { margin-top: var(--s2); max-width: 52ch; color: var(--ink-2); font-size: 1.2rem; }
      .lista-sv { margin: 0; padding: 0; list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s5) clamp(28px, 4vw, 72px); padding-bottom: var(--s6); }
      .sv { display: grid; gap: var(--s2); }
      .sv figure { margin: 0; aspect-ratio: 16 / 10; overflow: hidden; background: var(--bg-2); }
      .sv img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .sv h2 { font-size: clamp(1.6rem, 2.4vw, 2.2rem); }
      .sv .tag { color: var(--ink); font-size: 1.1rem; font-weight: 500; }
      .sv p { color: var(--ink-2); }
      .sv a:hover h2 { text-decoration: underline; text-decoration-color: var(--red); text-underline-offset: 4px; }
      @media (max-width: 900px) { .lista-sv { grid-template-columns: 1fr; } }
    </style>
  </head>
  <body>
    <Top current="sectores" />
    <main class="wrap">
      <div class="intro">
        <h1>Los lugares donde trabajamos<span class="dot">.</span></h1>
        <p>Desde Mendoza para Cuyo, Patagonia y el país. Base técnica en Mendoza, con cobertura regional para proyectos, mantenimiento y soporte.</p>
      </div>
      <ol class="lista-sv">
        {items.map((s, i) => (
          <li class="sv">
            <a href={`/propuesta/sectores/${s.slug}`}>
              <figure><img src={s.photo} alt="" width="1672" height="941" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" /></figure>
              <div class="item" style="margin-top:var(--s2)">
                <h2>{s.name}<span class="dot">.</span></h2>
                <span class="tag">{s.headline}</span>
                <p>{s.summary}</p>
                {s.count > 0 && <span class="small">{s.count} proyectos documentados</span>}
              </div>
            </a>
          </li>
        ))}
      </ol>
    </main>
    <Cierre />
  </body>
</html>
