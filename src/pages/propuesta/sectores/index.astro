---
/** Los sectores (2026-10-30): foto a pleno, cabecera de la página de sector y cuántos proyectos. No indexable. */
import '../../../styles/proto-despiece.css';
import Head from '../../../components/proto/Head.astro';
import Top from '../../../components/proto/Top.astro';
import Cierre from '../../../components/proto/Cierre.astro';
import { loadStories, SECTOR_PHOTO } from '../../../components/proto/isoData';
import { sectorRelato } from '../../../components/proto/relato';
import { matchesCatalog } from '../../../components/proto/catalogFilters';
import { SECTORS } from '../../../data/cine/scenes';

export const prerender = false;
const { stories } = await loadStories();
const items = SECTORS.map((s) => { const r = sectorRelato(s.slug); return { ...s, photo: SECTOR_PHOTO[s.slug] || SECTOR_PHOTO.constructoras, headline: r.headline || s.name, summary: r.summary || s.text, count: stories.filter((c) => matchesCatalog({sector: c.sectorSlug, services: c.serviceCodes, year: String(c.year), client: c.client, search: '', status: c.status}, {sector: s.slug})).length }; });
---
<!doctype html>
<html lang="es">
  <head>
    <Head title="Sectores · ULTIMA MILLA" description="Aeropuertos, bodegas, constructoras, gobierno, industria, minería, salud, seguridad electrónica y software: los lugares donde ULTIMA MILLA trabaja, con los proyectos documentados en cada uno." image="/images/editorial/umsa-sector-aeropuertos.webp" />
    <style>
      .intro { padding-block: var(--s5) var(--s4); }
      .intro h1 { max-width: 16ch; }
      .intro p { margin-top: var(--s2); max-width: 52ch; color: var(--ink-2); font-size: 1.2rem; }
      .filas { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--line); padding-bottom: var(--s6); }
      .fila a { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 7fr); gap: var(--s3) clamp(28px, 4vw, 72px); align-items: center; padding: 36px 0; border-bottom: 1px solid var(--line-2); }
      .fila figure { margin: 0; aspect-ratio: 16 / 9; overflow: hidden; background: var(--bg-2); }
      .fila img { width: 100%; height: 100%; object-fit: cover; display: block; }
      .fila .texto { display: grid; gap: 10px; }
      .fila h2 { font-size: clamp(1.7rem, 2.6vw, 2.4rem); }
      .fila .tag { color: var(--ink); font-size: 1.15rem; font-weight: 500; }
      .fila p { margin: 0; color: var(--ink-2); max-width: 52ch; }
      .fila .n { color: var(--ink-3); }
      .fila a:hover h2 { text-decoration: underline; text-decoration-color: var(--red); text-underline-offset: 4px; }
      @media (max-width: 900px) { .fila a { grid-template-columns: 1fr; gap: var(--s2); } }
      @media (max-width: 900px) {
        .intro { padding-block: 32px; }
        .intro h1 { font-size: clamp(2rem, 7.5vw, 2.6rem); line-height: 1.08; font-weight: 600; letter-spacing: -.025em; }
        .intro p { font-size: 1.0625rem; line-height: 1.55; }
      }
    </style>
  </head>
  <body>
    <Top current="sectores" />
    <main id="contenido" class="wrap">
      <div class="intro">
        <h1>Soluciones para cada sector<span class="dot">.</span></h1>
        <p>Integramos redes, seguridad, comunicaciones y tecnología según la operación de cada sector. Desde Mendoza, para Cuyo, Patagonia y el país.</p>
      </div>
      <ol class="filas">
        {items.map((s, i) => (
          <li class="fila">
            <a href={`/sectores/${s.slug}`}>
              <figure><img src={s.photo} alt="" width="1672" height="941" loading={i < 2 ? 'eager' : 'lazy'} decoding="async" /></figure>
              <div class="texto">
                {['software', 'seguridad-electronica'].includes(s.slug) && <span class="n">Solución transversal a los sectores</span>}
                <h2>{s.name}<span class="dot">.</span></h2>
                <span class="tag">{s.headline}</span>
                <p>{s.summary}</p>
                {s.count > 0 && <span class="n">{s.count} antecedentes registrados</span>}
              </div>
            </a>
          </li>
        ))}
      </ol>
    </main>
    <Cierre />
  </body>
</html>
