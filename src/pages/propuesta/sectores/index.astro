---
/** Los sectores (2026-10-30): foto a pleno, cabecera de la página de sector y cuántos proyectos. */
import '../../../styles/proto-despiece.css';
import Head from '../../../components/proto/Head.astro';
import Top from '../../../components/proto/Top.astro';
import Cierre from '../../../components/proto/Cierre.astro';
import CatalogoEditorial from '../../../components/proto/CatalogoEditorial.astro';
import { loadStories, SECTOR_PHOTO } from '../../../components/proto/isoData';
import { sectorRelato } from '../../../components/proto/relato';
import { matchesCatalog } from '../../../components/proto/catalogFilters';
import { SECTORS } from '../../../data/cine/scenes';

export const prerender = false;
const { stories } = await loadStories();
const items = SECTORS.map((sector) => ({
  name: sector.name,
  summary: sectorRelato(sector.slug).summary || sector.text,
  photo: SECTOR_PHOTO[sector.slug] || SECTOR_PHOTO.constructoras,
  href: `/sectores/${sector.slug}`,
  count: stories.filter((story) => matchesCatalog({
    sector: story.sectorSlug, services: story.serviceCodes, year: String(story.year),
    client: story.client, search: '', status: story.status,
  }, { sector: sector.slug })).length,
}));
---
<!doctype html>
<html lang="es">
  <head>
    <Head title="Sectores · ULTIMA MILLA" description="Aeropuertos, bodegas, constructoras, gobierno, industria, minería, salud, seguridad electrónica y software: los lugares donde ULTIMA MILLA trabaja, con los proyectos documentados en cada uno." image="/images/editorial/umsa-sector-aeropuertos.webp" />
  </head>
  <body>
    <Top current="sectores" />
    <main id="contenido" class="wrap">
      <CatalogoEditorial
        title="Soluciones para cada sector"
        intro="Integramos redes, seguridad, comunicaciones y tecnología según la operación de cada sector. Desde Mendoza, para Cuyo, Patagonia y el país."
        action="Ver sector"
        items={items}
      />
    </main>
    <Cierre />
  </body>
</html>
