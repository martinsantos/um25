---
/**
 * Sector (2026-10-30, v6). La prueba primero: la apertura con las cifras del sector, para quién,
 * qué se instaló (el banco con las partes que nombran los registros), los casos, el lugar por
 * dentro, los proyectos. Frases completas del sitio. No indexable.
 */
import '../../../styles/proto-despiece.css';
import Head from '../../../components/proto/Head.astro';
import Top from '../../../components/proto/Top.astro';
import ServiceEditorialHero from '../../../components/proto/ServiceEditorialHero.astro';
import Ficha from '../../../components/proto/Ficha.astro';
import Casos from '../../../components/proto/Casos.astro';
import { selectCaseProjects, remainingCaseProjects, pageCaseCandidates } from '../../../components/proto/caseSelection';
import Cierre from '../../../components/proto/Cierre.astro';
import Partes from '../../../components/proto/Partes.astro';
import { getSectorBySlug } from '../../../lib/um26-directus';
import { loadStories, services, SITE_OF, SECTOR_PHOTO, isoSrc, isoRatio, destacados } from '../../../components/proto/isoData';
import { despieceAgregado } from '../../../components/proto/despiece';
import { CASOS_SECTOR, casosDe, sectorRelato, EMPRESA } from '../../../components/proto/relato';
import { SECTORS } from '../../../data/cine/scenes';

import { isNamedClient } from '../../../components/proto/catalogEditorial';

export const prerender = false;
// Keep the established specialized sector pages, including their product content.
const SERVICIO_DE: Record<string, string> = { 'seguridad-electronica': '102', software: '104' };
if (SERVICIO_DE[String(Astro.params.slug)]) return Astro.redirect(`/${Astro.params.slug}`, 301);
const slug = Astro.params.slug === 'gobierno' ? 'gobiernosectorpublico' : String(Astro.params.slug);
const sector = await getSectorBySlug(slug === 'gobiernosectorpublico' ? 'gobierno' : slug);
if (!sector) return Astro.rewrite('/404');
const { stories } = await loadStories();
const own = stories.filter((c) => c.sectorSlug === slug);
// Gobierno es una operación distribuida: no se representa con un edificio genérico.
const site = slug === 'gobiernosectorpublico' ? undefined : SITE_OF[slug];
const photo = SECTOR_PHOTO[slug] || SECTOR_PHOTO.constructoras;
const relato = sectorRelato(slug);
const casos = casosDe(CASOS_SECTOR[slug] || []);
const showcase = pageCaseCandidates(own, slug);
const selectedCases = selectCaseProjects(casos, stories, destacados(showcase, showcase.length));
const moreCases = remainingCaseProjects(destacados(showcase, showcase.length), selectedCases).slice(0, 8);
const name = SECTORS.find((s) => s.slug === slug)?.name || sector.name;
const lower = name.toLowerCase();
const byService = services.map((s) => ({ ...s, count: own.filter((c) => c.serviceCodes.includes(s.code)).length })).filter((s) => s.count > 0 || sector.services.includes(Number(s.code))).sort((a, b) => b.count - a.count);
const physicalCodes = new Set(['101', '102', '103', '107', '108']);
const physicalServices = byService.filter((s) => physicalCodes.has(s.code));
const initialService = physicalServices[0];
const displayedServices = site ? [...physicalServices, ...byService.filter((s) => !physicalCodes.has(s.code))] : byService;
const maxSvc = Math.max(1, ...byService.map((s) => s.count));
const byCode = new Map(services.map((s) => [s.code, s.name]));
const clientes = Object.values(own.filter(s => isNamedClient(s.client)).reduce<Record<string, { name: string; count: number }>>((acc, s) => { const k = s.client.toLowerCase(); (acc[k] ||= { name: s.client, count: 0 }).count++; return acc; }, {})).sort((a, b) => b.count - a.count);
const anios = own.map((c) => c.year).filter(Boolean);
const desde = anios.length ? Math.min(...anios) : 0;
const instalado = despieceAgregado(own).filter((p) => !['104', '105', '106'].includes(p.code)).slice(0, 8);
const cifras: [string, string][] = own.length ? [[String(own.length), 'proyectos documentados'], [String(clientes.length), clientes.length === 1 ? 'cliente identificado' : 'clientes identificados'], [String(byService.filter((s) => s.count > 0).length), 'frentes de servicio'], [String(desde), 'primer proyecto']] : [];
---
<!doctype html>
<html lang="es">
  <head><Head title={`${relato.headline || name} · ULTIMA MILLA`} description={relato.summary || sector.description} image={photo} precargar /><style>.dentro--text { grid-template-columns: 1fr; max-width: 900px; } .dentro--text .dentro__side { width: 100%; }</style></head>
  <body>
    <Top current="sectores" />
    <main id="contenido">

    <ServiceEditorialHero label={name} image={photo}>
      <h1 style="font-size:clamp(2rem,3.6vw,3.6rem)">{relato.headline || name}<span class="dot">.</span></h1>
      <p>{relato.summary || sector.description}</p>
      {cifras.length > 0 && <div class="cifras">{cifras.map(([n, t]) => <div><b>{n}</b><span>{t}</span></div>)}</div>}
      <a class="u" href={own.length > 0 ? `/antecedentes?sector=${slug}` : '/antecedentes'}>{own.length > 0 ? `Ver los ${own.length} proyectos en ${lower}` : 'Ver todos los proyectos'}</a>
    </ServiceEditorialHero>

    <section class="sec">
      <div class="wrap cols cols-5-7">
        <h2>Lo que tiene que seguir funcionando<span class="dot">.</span></h2>
        <div class="prosa">
          <p class="lead">{relato.need} {relato.proof}</p>
        </div>
      </div>
    </section>

    {clientes.length > 0 && (
      <section class="sec">
        <div class="wrap">
          <div class="sec__head"><h2>Para quién lo hicimos en {lower}<span class="dot">.</span></h2></div>
          <ol class="clientes">
            {clientes.slice(0, 9).map((c) => <li><a href={`/antecedentes?cliente=${encodeURIComponent(c.name)}`}>{c.name}</a><span>{c.count}</span></li>)}
            {clientes.length > 9 && <li class="mas"><a href={`/antecedentes?sector=${slug}`}>Y {clientes.length - 9} más</a><span></span></li>}
          </ol>
        </div>
      </section>
    )}

    {instalado.length > 0 && (
      <section class="sec">
        <div class="wrap">
          <div class="sec__head"><h2>Lo que instalamos en {lower}<span class="dot">.</span></h2></div>
          <Partes items={instalado.map((p) => ({ key: p.key, label: p.label, meta: byCode.get(p.code), n: `${p.proyectos} ${p.proyectos === 1 ? 'proyecto' : 'proyectos'}` }))} />
        </div>
      </section>
    )}

    <Casos casos={casos} stories={stories} title={`Lo que hicimos en ${lower}`} selection={selectedCases} />

    <section class="sec">
      <div class="wrap">
        <div class="sec__head"><h2>{site ? `${name} por dentro` : 'Servicios para organismos públicos'}<span class="dot">.</span></h2></div>
        <div class:list={['dentro', { 'dentro--text': !site }]} data-dentro={site ? true : undefined}>
          {site && <div class="dentro__stage iso" data-svc={initialService?.code} data-src={isoSrc(site)}><div class="iso__caja" style={`--r:${isoRatio(site).toFixed(3)}`}></div><span class="ahora">{initialService?.name}</span></div>}
          <div class="dentro__side">
            <ul class="servicios">{displayedServices.map((s) => <li><a href={s.count > 0 ? `/antecedentes?sector=${slug}&service=${s.code}` : `/servicios/${s.code}`} data-code={site && physicalCodes.has(s.code) ? s.code : undefined} data-name={s.name} class:list={{ on: Boolean(site) && s.code === initialService?.code }} style={`--w:${Math.round((s.count / maxSvc) * 100)}`}>{s.name}<span>{s.count ? `${s.count} ${s.count === 1 ? 'proyecto' : 'proyectos'}` : ''}</span><i></i></a></li>)}</ul>
          </div>
        </div>
      </div>
    </section>

    {moreCases.length > 0 && (
      <section class="sec">
        <div class="wrap">
          <div class="sec__head"><h2>Más proyectos en {lower}<span class="dot">.</span></h2></div>
          <ol class:list={["fichas", { "fichas--short": moreCases.length < 3 }]} style={`--case-cols:${moreCases.length}`}>{moreCases.map((c, i) => <Ficha story={c} eager={i < 4} showSector={false} />)}</ol>
          <a class="u more" href={`/antecedentes?sector=${slug}`}>Ver los {own.length} proyectos</a>
        </div>
      </section>
    )}

    <section class="sec">
      <div class="wrap cols cols-5-7">
        <h2>Cómo trabajamos<span class="dot">.</span></h2>
        <div class="cols cols-2">{EMPRESA.principios.map(([t, d]) => <div class="item"><h3>{t}</h3><p>{d}</p></div>)}</div>
      </div>
    </section>

    </main>
    <Cierre />
  </body>
</html>
