---
import '../../../styles/pilot-fichas.css';
import { sectorIntegrationScope } from '../../../data/propuesta/sector-integration';
import { KIT_DE_SERVICIO } from '../../../components/proto/despiece';
import PilotCatalog from '../../../components/proto/PilotCatalog.astro';
/**
 * Sector (2026-10-30, v6). La prueba primero: la apertura con las cifras del sector, para quién,
 * qué se instaló (el banco con las partes que nombran los registros), los casos, el lugar por
 * dentro, los proyectos. Frases completas del sitio. No indexable.
 */
import '../../../styles/proto-despiece.css';
import Head from '../../../components/proto/Head.astro';
import Top from '../../../components/proto/Top.astro';
import ServiceEditorialHero from '../../../components/proto/ServiceEditorialHero.astro';
import Ficha from '../../../components/proto/Ficha.astro';
import CaseLinks from '../../../components/proto/CaseLinks.astro';
import Casos from '../../../components/proto/Casos.astro';
import { selectCaseProjects, remainingCaseProjects, pageCaseCandidates } from '../../../components/proto/caseSelection';
import Cierre from '../../../components/proto/Cierre.astro';
import Partes from '../../../components/proto/Partes.astro';
import SectorIntegration from '../../../components/proto/SectorIntegration.astro';
import { caseEquipmentFor } from '../../../components/proto/casePresentation';
import { sectorDeclaredServices } from '../../../data/propuesta/sector-integration';
import { getSectorBySlug } from '../../../lib/um26-directus';
import { loadStories, services, SITE_OF, SECTOR_PHOTO, destacados } from '../../../components/proto/isoData';
import { despieceAgregado } from '../../../components/proto/despiece';
import { CASOS_SECTOR, casosDe, sectorRelato, EMPRESA } from '../../../components/proto/relato';
import { SECTORS } from '../../../data/cine/scenes';

import { isNamedClient } from '../../../components/proto/catalogEditorial';

export const prerender = false;
// Keep the established specialized sector pages, including their product content.
const SERVICIO_DE: Record<string, string> = { 'seguridad-electronica': '102', software: '104' };
if (SERVICIO_DE[String(Astro.params.slug)]) return Astro.redirect(`/${Astro.params.slug}`, 301);
const slug = Astro.params.slug === 'gobierno' ? 'gobiernosectorpublico' : String(Astro.params.slug);
const sector = await getSectorBySlug(slug === 'gobiernosectorpublico' ? 'gobierno' : slug);
if (!sector) return Astro.rewrite('/404');
const { stories } = await loadStories();
const own = stories.filter((c) => c.sectorSlug === slug);
// Gobierno es una operación distribuida: no se representa con un edificio genérico.
const site = slug === 'gobiernosectorpublico' ? undefined : SITE_OF[slug];
const photo = SECTOR_PHOTO[slug] || SECTOR_PHOTO.constructoras;
const relato = sectorRelato(slug);
const casos = casosDe(CASOS_SECTOR[slug] || []);
const showcase = pageCaseCandidates(own, slug);
const rankedCases = destacados(showcase, showcase.length);
const selectedCases = selectCaseProjects(casos, stories, rankedCases);
const documentedCases = own.filter((c) => c.documentedScope && !selectedCases.some(({ pub }) => pub.id === c.id));
const moreCases = remainingCaseProjects(rankedCases.filter((c) => !c.documentedScope), selectedCases).slice(0, 8);
const name = SECTORS.find((s) => s.slug === slug)?.name || sector.name;
const lower = name.toLowerCase();
const declared = new Set([...sector.services.map(String), ...sectorDeclaredServices(slug)]);
const byService = services.map((s) => ({ ...s, count: own.filter((c) => c.serviceCodes.includes(s.code)).length })).filter((s) => s.count > 0 || declared.has(s.code)).sort((a, b) => b.count - a.count);
const physicalCodes = new Set(['101', '102', '103', '107', '108']);
const physicalServices = byService.filter((s) => physicalCodes.has(s.code));
const displayedServices = site ? [...physicalServices, ...byService.filter((s) => !physicalCodes.has(s.code))] : byService;
const byCode = new Map(services.map((s) => [s.code, s.name]));
const clientes = Object.values(own.filter(s => isNamedClient(s.client)).reduce<Record<string, { name: string; count: number }>>((acc, s) => { const k = s.client.toLowerCase(); (acc[k] ||= { name: s.client, count: 0 }).count++; return acc; }, {})).sort((a, b) => b.count - a.count);
const anios = own.map((c) => c.year).filter(Boolean);
const desde = anios.length ? Math.min(...anios) : 0;
const instalado = despieceAgregado(own, caseEquipmentFor).slice(0, 12);
const cifras: [string, string][] = own.length ? [[String(own.length), 'antecedentes registrados'], [String(clientes.length), clientes.length === 1 ? 'cliente identificado' : 'clientes identificados'], [String(byService.filter((s) => s.count > 0).length), 'frentes de servicio'], [String(desde), 'primer registro']] : [];
---
<!doctype html>
<html lang="es">
  <head><Head title={`${relato.headline || name} · ULTIMA MILLA`} description={relato.summary || sector.description} image={photo} precargar /><style is:global>.sector-back { justify-self: start; width: fit-content; margin-bottom: 4px; padding-bottom: 4px; color: var(--ink-2); font-size: .95rem; border-bottom: 1px solid var(--line); } .sector-back:hover { color: var(--ink); border-color: var(--red); } .sector-back:focus-visible { outline: 2px solid var(--red); outline-offset: 4px; } #servicios-sector { scroll-margin-top: calc(var(--top-h, 66px) + 16px); }</style><style>.dentro--text { grid-template-columns: 1fr; max-width: 900px; } .dentro--text .dentro__side { width: 100%; }</style></head>
  <body>
    <Top current="sectores" />
    <main id="contenido">

    <ServiceEditorialHero label={name} image={photo}>
      <a class="sector-back" href="/sectores">← Todos los sectores</a>
      <h1 style="font-size:clamp(2rem,3.6vw,3.6rem)">{relato.headline || name}<span class="dot">.</span></h1>
      <p>{relato.summary || sector.description}</p>
      {cifras.length > 0 && <div class="cifras">{cifras.map(([n, t]) => <div><b>{n}</b><span>{t}</span></div>)}</div>}
      <div class="editorial-actions">
      <a class="u editorial-primary" href="#integracion">Ver cómo integramos los servicios</a>
      {own.length > 0 && <a class="u" href={`/antecedentes?sector=${slug}`}>Ver los {own.length} antecedentes en {lower}</a>}
      </div>
    </ServiceEditorialHero>

    <section class="sec">
      <div class="wrap cols cols-5-7">
        <h2>Lo que tiene que seguir funcionando<span class="dot">.</span></h2>
        <div class="prosa">
          <p class="lead">{relato.need} {relato.proof}</p>
        </div>
      </div>
    </section>

    {slug === 'bodegas' ? <PilotCatalog winery items={displayedServices.map(s=>({
 title:s.name,summary:sectorIntegrationScope(slug,s.code,s.text),
 parts:(KIT_DE_SERVICIO[s.code] || []).slice(0,3).map(([key,label])=>({key,label})),
 links:[{url:`/servicios/${s.code}#provision`,label:'Ver provisión'},...(s.count ? [{url:`/antecedentes?sector=${slug}&service=${s.code}`,label:`${s.count} antecedentes`}] : [])]
 }))}/> : <SectorIntegration slug={slug} name={name} site={site} items={displayedServices} />}

    {clientes.length > 0 && (
      <section class="sec">
        <div class="wrap">
          <div class="sec__head"><h2>Para quién lo hicimos en {lower}<span class="dot">.</span></h2></div>
          <ol class="clientes">
            {clientes.slice(0, 9).map((c) => <li><a href={`/antecedentes?sector=${slug}&cliente=${encodeURIComponent(c.name)}`}>{c.name}</a><span>{c.count}</span></li>)}
            {clientes.length > 9 && <li class="mas"><a href={`/antecedentes?sector=${slug}`}>Y {clientes.length - 9} más</a><span></span></li>}
          </ol>
        </div>
      </section>
    )}

    {instalado.length > 0 && (
      <section class="sec">
        <div class="wrap">
          <div class="sec__head"><h2>Sistemas documentados en {lower}<span class="dot">.</span></h2><p>Componentes identificados en los registros y casos de este sector. Las cifras indican antecedentes que los mencionan.</p></div>
          <Partes items={instalado.map((p) => ({ key: p.key, label: p.label, meta: byCode.get(p.code), n: `${p.proyectos} ${p.proyectos === 1 ? 'antecedente' : 'antecedentes'}` }))} />
        </div>
      </section>
    )}

    <Casos casos={casos} stories={stories} title={`Lo que hicimos en ${lower}`} selection={selectedCases} />

    {(moreCases.length > 0 || documentedCases.length > 0) && (
      <section class="sec">
        <div class="wrap">
          <div class="sec__head"><h2>Más proyectos en {lower}<span class="dot">.</span></h2></div>
          <CaseLinks stories={documentedCases} />
          {moreCases.length > 0 && <ol class:list={["fichas", { "fichas--short": moreCases.length < 3 }]} style={`--case-cols:${moreCases.length}`}>{moreCases.map((c, i) => <Ficha story={c} eager={i < 4} showSector={false} />)}</ol>}
          <a class="u more" href={`/antecedentes?sector=${slug}`}>Ver los {own.length} antecedentes</a>
        </div>
      </section>
    )}

    <section class="sec">
      <div class="wrap cols cols-5-7">
        <h2>Cómo trabajamos<span class="dot">.</span></h2>
        <div class="cols cols-2">{EMPRESA.principios.map(([t, d]) => <div class="item"><h3>{t}</h3><p>{d}</p></div>)}</div>
      </div>
    </section>

    </main>
    <Cierre />
  </body>
</html>
