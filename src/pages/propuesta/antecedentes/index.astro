---
/**
 * Los proyectos (2026-10-30, v3). Pared de fichas. Sector, servicio y año filtran en vivo; la
 * cifra se recompone. Entre las fichas, los lugares por dentro. Filtro en la URL. No indexable.
 */
import '../../../styles/proto-despiece.css';
import Head from '../../../components/proto/Head.astro';
import Top from '../../../components/proto/Top.astro';
import Ficha from '../../../components/proto/Ficha.astro';
import Cierre from '../../../components/proto/Cierre.astro';
import { loadStories, services, posterOf, SCENE_OF } from '../../../components/proto/isoData';
import { SECTORS } from '../../../data/cine/scenes';

export const prerender = false;
const { stories } = await loadStories();
const total = stories.length;
const sectors = SECTORS.map((s) => ({ slug: s.slug, name: s.name, count: stories.filter((c) => c.sectorSlug === s.slug).length })).filter((s) => s.count > 0);
const svcs = services.map((s) => ({ code: s.code, name: s.name, count: stories.filter((c) => c.serviceCodes.includes(s.code)).length }));
const years = [...new Set(stories.map((c) => c.year).filter(Boolean))].sort((a, b) => b - a);
const recorridos = ['constructoras', 'aeropuertos', 'bodegas', 'salud'];
const recAt = [0, 18, 60, 120];
const sceneTitle: Record<string, string> = { fachada: 'Edificio', aeropuerto: 'Aeropuerto', bodega: 'Bodega', hospital: 'Centro de salud', planta: 'Planta' };
---
<!doctype html>
<html lang="es">
  <head>
    <Head title="Proyectos documentados · ULTIMA MILLA" />
    <style>
      .muro { display: grid; grid-template-columns: minmax(260px, 3fr) minmax(0, 9fr); gap: var(--s4) clamp(28px, 4vw, 72px); align-items: start; padding-block: var(--s4) var(--s6); }
      .panel { position: sticky; top: 80px; display: grid; gap: var(--s4); }
      .count { font-size: clamp(4rem, 7vw, 6.5rem); line-height: .9; letter-spacing: -.05em; font-variant-numeric: tabular-nums; }
      .count i { font-style: normal; color: var(--red); }
      .sentence { font-size: 1.2rem; font-weight: 600; letter-spacing: -.02em; margin-top: 6px; }
      .grupo { display: grid; gap: 6px; }
      .grupo h2 { font-size: .9375rem; font-weight: 500; color: var(--ink-3); }
      .anios { display: flex; flex-wrap: wrap; gap: 6px; }
      .anios button { padding: 6px 10px; border: 1px solid var(--line); color: var(--ink-2); font-size: .9375rem; }
      .anios button[aria-pressed="true"] { border-color: var(--red); color: var(--ink); }
      .servicios [data-zero] { opacity: .35; }
      .clear { display: none; color: var(--ink-2); text-decoration: underline; text-underline-offset: 4px; width: max-content; }
      .clear.on { display: inline-block; }
      .empty { display: none; padding: var(--s4) 0; color: var(--ink-2); }
      .empty.on { display: block; }
      .fichas { grid-template-columns: repeat(3, minmax(0, 1fr)); }
      @media (max-width: 900px) { .muro { grid-template-columns: 1fr; } .panel { position: static; } .fichas { grid-template-columns: 1fr 1fr; } }
    </style>
  </head>
  <body>
    <Top current="antecedentes" />

    <main class="wrap muro" id="contenido" data-muro>
      <aside class="panel">
        <div>
          <span class="small">24 años de servicios IT. Mendoza, Argentina.</span>
          <h1 class="count"><span data-count>{total}</span><i>.</i></h1>
          <p class="sentence" data-sentence aria-live="polite">proyectos documentados</p>
        </div>
        <div class="grupo"><h2>Sector</h2><ul class="servicios">{sectors.map((s) => <li><button type="button" data-lens="sector" data-value={s.slug} aria-pressed="false">{s.name}<span data-n>{s.count}</span><i></i></button></li>)}</ul></div>
        <div class="grupo"><h2>Servicio</h2><ul class="servicios">{svcs.map((s) => <li><button type="button" data-lens="service" data-value={s.code} aria-pressed="false">{s.name}<span data-n>{s.count}</span><i></i></button></li>)}</ul></div>
        <div class="grupo"><h2>Año</h2><div class="anios">{years.map((y) => <button type="button" data-lens="year" data-value={String(y)} aria-pressed="false">{y}</button>)}</div></div>
        <button class="clear" type="button" data-clear>Ver los {total} proyectos</button>
      </aside>

      <section aria-label="Proyectos">
        <ol class="fichas" data-grid>
          {stories.map((c, index) => (
            <>
              {recAt.includes(index) && (() => { const slug = recorridos[recAt.indexOf(index)]; const scene = SCENE_OF[slug]; return (
                <li class="ficha ficha--rec" data-rec>
                  <a href={`/propuesta/sectores/${slug}`}>
                    <figure><img src={posterOf(slug)} alt="" width="1920" height="1080" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" /></figure>
                    <b>{sceneTitle[scene]} por dentro</b>
                    <span class="small">{SECTORS.find((s) => s.slug === slug)?.name}</span>
                  </a>
                </li>
              ); })()}
              <Ficha story={c} eager={index < 9} lazy={index >= 24} />
            </>
          ))}
        </ol>
        <p class="empty" data-empty>Sin proyectos para esta combinación.</p>
      </section>
    </main>

    <Cierre />

    <script>
      const root = document.querySelector<HTMLElement>('[data-muro]')!;
      const fichas = [...root.querySelectorAll<HTMLElement>('[data-ficha]')];
      const total = fichas.length;
      const recs = [...root.querySelectorAll<HTMLElement>('[data-rec]')];
      const lenses = [...root.querySelectorAll<HTMLButtonElement>('[data-lens]')];
      const state: Record<string, string> = {};
      const nameOf = (b: HTMLButtonElement) => [...b.childNodes].filter((n) => n.nodeType === 3).map((n) => n.textContent).join('').trim();
      const names = (kind: string, value: string) => { const b = lenses.find((x) => x.dataset.lens === kind && x.dataset.value === value); return b ? nameOf(b) || value : value; };
      const matches = (el: HTMLElement, skip?: string) =>
        (skip === 'sector' || !state.sector || el.dataset.sector === state.sector) &&
        (skip === 'service' || !state.service || (el.dataset.services || '').split(' ').includes(state.service)) &&
        (skip === 'year' || !state.year || el.dataset.year === state.year);
      const params = new URLSearchParams(location.search);
      ['sector', 'service', 'year'].forEach((k) => { if (params.get(k)) state[k] = params.get(k)!; });
      const apply = () => {
        let n = 0;
        fichas.forEach((el) => { const ok = matches(el); el.hidden = !ok; if (ok) n++; });
        recs.forEach((el) => { el.hidden = Boolean(state.year) || n < 12; });
        lenses.forEach((b) => b.setAttribute('aria-pressed', String(state[b.dataset.lens!] === b.dataset.value)));
        ['sector', 'service'].forEach((kind) => {
          const base = fichas.filter((el) => matches(el, kind));
          lenses.filter((b) => b.dataset.lens === kind).forEach((b) => {
            const c = base.filter((el) => kind === 'service' ? (el.dataset.services || '').split(' ').includes(b.dataset.value!) : el.dataset[kind] === b.dataset.value).length;
            const num = b.querySelector('[data-n]'); if (num) num.textContent = String(c);
            b.style.setProperty('--w', String(Math.round((c / Math.max(1, base.length)) * 100)));
            b.toggleAttribute('data-zero', c === 0 && state[kind] !== b.dataset.value);
          });
        });
        const parts = [state.sector && names('sector', state.sector), state.service && names('service', state.service), state.year].filter(Boolean) as string[];
        root.querySelector('[data-count]')!.textContent = String(n);
        root.querySelector('[data-sentence]')!.textContent = parts.length ? `proyectos · ${parts.join(' · ')}` : 'proyectos documentados';
        root.querySelector('[data-clear]')!.classList.toggle('on', parts.length > 0);
        root.querySelector('[data-empty]')!.classList.toggle('on', n === 0);
        const url = new URL(location.href); ['sector', 'service', 'year'].forEach((k) => state[k] ? url.searchParams.set(k, state[k]) : url.searchParams.delete(k)); history.replaceState(null, '', url);
      };
      lenses.forEach((b) => b.addEventListener('click', () => { const k = b.dataset.lens!; state[k] = state[k] === b.dataset.value ? '' : b.dataset.value!; apply(); }));
      root.querySelector('[data-clear]')!.addEventListener('click', () => { Object.keys(state).forEach((k) => delete state[k]); apply(); });
      apply();
    </script>
  </body>
</html>
