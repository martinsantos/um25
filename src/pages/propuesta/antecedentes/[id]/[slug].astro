---
import { ArrowDown, ArrowLeft, ArrowRight, ArrowUpRight } from "lucide-astro";
import { catalogCaseJourney } from '../../../../components/proto/catalogCaseJourney';
import { caseJourney, pageContactLink, sectorWorkLink } from '../../../../lib/caseJourney';
import { homeProjectJourney } from '../../../../components/proto/portadaCases';
import { serviceJourney } from "../../../../data/propuesta/recorrido";
import { provisionDestination } from "../../../../data/propuesta/workScenes";
import { getServicios } from "../../../../lib/um26-directus";
import { serviceProvisionItems, groupServiceProvision, securityProvisionGroups } from "../../../../utils/serviceProvision";
import { matchesServiceReference } from "../../../../components/proto/serviceReference";
import "../../../../styles/case-presentation.css";
/**
 * Ficha de trabajo (2026-10-31). Cada antecedente como hoja de trabajo: cabecera con la referencia
 * UM, la imagen y los datos; alcance documentado, inventario y sistemas; y otros proyectos del
 * mismo cliente identificado y del mismo sector.
 */
import "../../../../styles/proto-despiece.css";
import Head from "../../../../components/proto/Head.astro";
import Top from "../../../../components/proto/Top.astro";
import { isNamedClient } from "../../../../components/proto/catalogEditorial";
import { catalogHref, clientKey } from "../../../../components/proto/catalogFilters";
import { relatedCaseGroups, relatedCaseJourney, relatedCaseQuery } from "../../../../components/proto/relatedCaseGroups";
import RelatedCases from "../../../../components/proto/RelatedCases.astro";
import FichaIso from "../../../../components/proto/FichaIso.astro";
import Cierre from "../../../../components/proto/Cierre.astro";
import {
  loadStories,
  services,
  srcsetDe,
  variantes,
} from "../../../../components/proto/isoData";
import caseImageDescriptions from "../../../../data/casePhotoAlt.json";
import { photographForCase } from "../../../../data/photography";
import CasoEnDetalle from "../../../../components/proto/CasoEnDetalle.astro";
import CredentialSequence from "../../../../components/proto/CredentialSequence.astro";
import CatalogScene from "../../../../components/proto/CatalogScene.astro";
import ResidentialIntegration from "../../../../components/proto/ResidentialIntegration.astro";
import HospitalIntegration from "../../../../components/proto/HospitalIntegration.astro";
import EquipmentDetailSection from "../../../../components/proto/EquipmentDetailSection.astro";
import { equipmentDetailForCase } from "../../../../data/equipmentDetailScenes";
import InterventionSection from "../../../../components/proto/InterventionSection.astro";
import { interventionSceneForCase } from "../../../../data/interventionScenes";
import {
  catalogPresentationFor,
  catalogSceneForCase,
  catalogOperationsForCase,
} from "../../../../data/catalogCasePresentation";
import TechnicalSection from "../../../../components/proto/TechnicalSection.astro";
import ConnectionSection from "../../../../components/proto/ConnectionSection.astro";
import { connectionSceneForCase } from "../../../../data/connectionScenes";
import OperationsSection from "../../../../components/proto/OperationsSection.astro";
import { operationsSceneForCase } from "../../../../data/operationsScenes";
import { technicalSceneForCase } from "../../../../data/technicalScenes";
import {
  caseIntroduction,
  publicCaseFor,
  publicCaseTitle,
  caseEquipmentFor,
} from "../../../../components/proto/casePresentation";

import {
  buildCaseSeoMeta,
  trimAtWordBoundary,
} from "../../../../utils/seoMetaPolicy";
export const prerender = false;
const id = Number(Astro.params.id);
const { stories } = await loadStories();
const index = stories.findIndex((c) => c.id === id);
if (index < 0) return Astro.rewrite('/404');
const c = stories[index];
const caseDetail = publicCaseFor(c);
const pageTitle = publicCaseTitle(c);
if (Astro.params.slug !== c.slug) return Astro.redirect(c.href + Astro.url.search, 301);
const candidates = services.filter(s => c.serviceCodes.includes(s.code)).map(service => ({
  service,
  references: Object.entries(serviceJourney[service.code]?.groups ?? {}).filter(([, group]) =>
    group.reference && matchesServiceReference(c, group.reference)),
}));
const definitions = candidates.some(item => item.references.length > 0) ? await getServicios() : [];
const svcs = candidates.map(({ service, references }) => {
  const definition = definitions.find(item => item.code === Number(service.code));
  const items = serviceProvisionItems(definition?.products ?? [], Number(service.code));
  const groups = service.code === '102' ? securityProvisionGroups(items) : groupServiceProvision(items);
  const reference = references.find(([title]) => groups.some(group => group.title === title));
  const query = new URLSearchParams({ desde: 'obra', antecedente: String(c.id) });
  if (!reference) return { name: service.name, href: service.href + '?' + query + '#provision', provision: undefined };
  const [group] = reference;
  const destination = provisionDestination(service.code, group);
  query.set('grupo', group);
  return { name: service.name, href: service.href + '?' + query + '#' + destination.id, provision: destination.label };
});
const sectorHref = sectorWorkLink(c)?.href;
const months = [
  "",
  "enero",
  "febrero",
  "marzo",
  "abril",
  "mayo",
  "junio",
  "julio",
  "agosto",
  "septiembre",
  "octubre",
  "noviembre",
  "diciembre",
];
const enCurso = c.estado === "en-curso";
const monthYear = (month: number, year: number) => [months[month], year || ""].filter(Boolean).join(" de ");
const start = monthYear(c.month, c.year);
const [endYear, endMonth] = (c.cierre || "").split("-").map(Number);
const end = monthYear(endMonth, endYear);
function projectPeriod() {
  if (!end) return start;
  if (enCurso) return [start, `cierre previsto en ${end}`].filter(Boolean).join(" · ");
  if (!start) return `Cierre en ${end}`;
  if (start === end) return start;
  const from = c.year === endYear && months[c.month] && months[endMonth] ? months[c.month] : start;
  return `${from} a ${end}`;
}
const periodo = projectPeriod();
const estadoVisible = enCurso ? "En curso" : c.documentedScope && c.estado === "finalizado" ? "Finalizado" : "";
const client = clientKey(c.client);
const clientArchive = isNamedClient(c.client) && stories.some(s => s.id !== c.id && clientKey(s.client) === client)
  ? catalogHref({ cliente: c.client }) + '#obras-filtradas' : undefined;
const selection = catalogCaseJourney(c, Astro.url.searchParams, stories);
const homeJourney = homeProjectJourney(c, Astro.url.searchParams, stories);
const relatedJourney = relatedCaseJourney(c, Astro.url.searchParams, stories);
const journey = homeJourney || selection || relatedJourney || caseJourney(c, Astro.url.searchParams, stories);
Astro.locals.caseJourney = journey;
const returnHref = journey?.href || '/antecedentes';
const returnLabel = journey ? '← ' + journey.label : undefined;
const neighborQuery = selection?.query || '';
const prev = selection?.prev;
const next = selection?.next;
const related = relatedCaseGroups(c, stories);
const relatedArchive = selection ? { id: c.id, ...selection } : relatedJourney?.archive;
const relatedQuery = homeJourney?.relatedQuery || relatedCaseQuery(c, relatedArchive);
const photo = Boolean(c.image);
const imageSet = variantes(c.image);
const imageSrcset = srcsetDe(c.image);
const imageSizes = "(max-width: 500px) calc(100vw - 40px), (max-width: 900px) 92vw, (max-width: 1520px) 52vw, 775px";
const photoAlt =
  photographForCase(c.id)?.context ||
  (caseImageDescriptions as Record<string, string>)[String(c.id)] ||
  "";
const scope = caseEquipmentFor(c);
const technicalScene = technicalSceneForCase(c);
const operationsScene =
  operationsSceneForCase(c) || catalogOperationsForCase(c);
const connectionScene = connectionSceneForCase(c);
const interventionScene = interventionSceneForCase(c);
const equipmentScene = equipmentDetailForCase(c);
const residentialScene = c.id === 3588 && Boolean(catalogPresentationFor(c));
const hospitalScene =
  (c.id === 3085 || c.id === 3102) && Boolean(catalogPresentationFor(c));
const catalogScene =
  c.id === 3082 || technicalScene || operationsScene || connectionScene
    ? undefined
    : catalogSceneForCase(c);
const accessProject = c.id === 3104;
const showEquipment = scope.partes.length > 0 && !interventionScene && !equipmentScene && !hospitalScene;
const showScene = Boolean(accessProject || residentialScene || hospitalScene || equipmentScene ||
  interventionScene || connectionScene || operationsScene || technicalScene || catalogScene);
const sections = [
  {
    show: Boolean(caseDetail || showEquipment),
    id: caseDetail ? "alcance-del-proyecto" : "alcance",
    label: !caseDetail && scope.origen === "servicio" ? "Capacidades vinculadas" : "Qué se hizo",
  },
  { show: showScene, id: "flujo", label: accessProject ? "Ver la lectura de la credencial" : "Cómo funciona" },
  { show: related.length > 0, id: "obras-relacionadas", label: "Obras relacionadas" },
].filter(section => section.show);
const ref = `UM-${c.id}`;
const contactHref = pageContactLink(Astro, `/contacto?antecedente=${c.id}#formulario`);
const introduction = caseDetail?.introduction || caseIntroduction(c.summary, pageTitle, c.client);
const caseSeo = buildCaseSeoMeta({
  title: pageTitle,
  description: introduction,
  client: c.client,
  area: c.sector,
  date: String(c.year),
  identifier: c.id,
});
const seoTitle = caseSeo.title.includes(ref)
  ? caseSeo.title
  : `${trimAtWordBoundary(caseSeo.title, 60 - ref.length - 3)} · ${ref}`;
---

<!doctype html>
<html lang="es">
  <head>
    <Head
      title={seoTitle}
      description={caseSeo.description}
      image={c.image}
    />
    {photo && <link rel="preload" as="image" href={c.image}
      imagesrcset={imageSrcset} imagesizes={imageSrcset ? imageSizes : undefined} fetchpriority="high" />}
    <style>
      .project-actions { display:flex;flex-wrap:wrap;align-items:center;gap:12px 20px;margin-top:8px; }
      .project-actions a {min-height:44px;display:inline-flex;align-items:center;gap:6px;}
      .project-sections { border-top: 1px solid var(--line); }
      .project-sections ul {
        display: flex;
        flex-wrap: wrap;
        gap: 0 16px;
        padding: 0;
        margin: 0;
        list-style: none;
      }
      .project-sections a {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        min-height: 44px;
        font-size: .9375rem;
        font-weight: 550;
        line-height: 1.35;
        color: var(--ink-2);
      }
      .project-sections a:is(:hover,:focus-visible) { color:var(--ink); text-decoration:underline; text-underline-offset:.22em; }
      .project-sections :global(svg) { flex: none; }

      .project-close {
        display:grid;
        grid-template-columns:minmax(0, 6fr) minmax(0, 5fr);
        align-items:start;
        gap:var(--s3) clamp(32px, 5vw, 80px);
        margin-block-end:var(--s5);
        padding:clamp(18px, 3.5vw, 52px);
        color:#141818;
        background:#eceee8;
        border-top:3px solid var(--red);
        scroll-margin-top:calc(var(--top-h) + 16px);
      }
      .project-close--single { grid-template-columns:minmax(0,1fr); }
      .project-close h2 { font-size:clamp(1.7rem, 3vw, 3rem); line-height:1.08; text-wrap:balance; }
      .project-close p { margin:10px 0 18px; max-width:43ch; color:#414c48; }
      .project-close .btn { width:fit-content; background:#141818; color:#fff; border-color:#141818; }
      .project-close .btn:hover { background:#292f2f; }
      .project-close h3 { font-size:1.05rem; letter-spacing:normal; }
      .project-close ul { margin:8px 0 0; padding:0; list-style:none; }
      .project-close li { border-top:1px solid #b9c0ba; }
      .project-close li a { display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:48px; padding-block:8px; }
      .project-close li a:is(:hover,:focus-visible) strong { text-decoration:underline; text-underline-offset:.2em; }
      .project-close li strong,.project-close li small { display:block; }
      .project-close li strong { font-weight:650; line-height:1.3; }
      .project-close li small { color:#414c48; line-height:1.3; }
      .project-close svg { flex:none; }
      .project-close a:focus-visible { outline:2px solid currentColor; outline-offset:3px; }
      .case-return { margin-block:0 var(--s4); }
      .case-return__head { display:flex; flex-wrap:wrap; justify-content:space-between; align-items:center; gap:0 12px; }
      .case-return__head > a { display:inline-flex; align-items:center; min-height:44px; color:var(--ink-2); }
      .case-return__head > p { color:var(--ink-2); font-variant-numeric:tabular-nums; }
      .nav-obras { display:grid; grid-template-columns:repeat(auto-fit, minmax(min(100%, 270px), 1fr)); gap:0 var(--s4); }
      .nav-obras a { display:grid; align-content:start; padding-block:14px; gap:5px; border-top:1px solid var(--line); }
      .nav-obras small { display:flex; align-items:center; gap:8px; font-size:.9375rem; color:var(--ink-2); }
      .nav-obras strong { font-size:1.125rem; line-height:1.35; overflow-wrap:anywhere; }
      .case-return a:is(:hover,:focus-visible) { text-decoration:underline; text-underline-offset:.2em; }
      @media (max-width:700px) {
        .project-close { grid-template-columns:minmax(0,1fr); }
      }
      @media print {
        .project-close,.case-return { display:none; }
      }
      .hoja-cab {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 0 18px;
        margin-top: var(--s3);
        border-bottom: 1px solid var(--line);
      }
      .hoja-cab a, .quien a, .tabla a {
        display: inline-flex;
        align-items: center;
        min-height: 44px;
        text-decoration: underline;
        text-decoration-color: var(--ink-3);
        text-underline-offset: .2em;
      }
      .proyecto a:is(:hover, :focus-visible), .hoja-cab a:is(:hover, :focus-visible) {
        text-decoration-color: currentColor;
      }
      .hoja-cab b {
        margin-inline-start:auto;
        font-size: .9375rem;
        font-variant-numeric: tabular-nums;
        color: var(--ink-2);
        white-space: nowrap;
      }
      .proyecto {
        padding-block: var(--s4) var(--s5);
        display: grid;
        grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
        gap: var(--s4) clamp(28px, 4vw, 72px);
        align-items: start;
      }
      .proyecto:not(.proyecto--sinfoto) > :is(.datos,.tabla) { grid-column: 2; }
      .obra {
        margin: 0;
        grid-column: 1;
        grid-row: 1 / span 2;
        overflow: hidden;
        background: var(--bg-2);
      }
      .obra img {
        width: 100%;
        aspect-ratio: 4 / 3;
        object-fit: cover;
        display: block;
      }
      .obra figcaption {
        padding: 12px 16px;
        font-size: 1rem;
        color: var(--ink-2);
      }
      .datos {
        display: grid;
        gap: var(--s2);
        align-content: start;
      }
      .datos h1 {
        font-size: clamp(1.7rem, 2.6vw, 2.4rem);
      }
      .quien { display: grid; justify-items: start; }
      .quien strong { font-size: 1.1rem; }
      .quien p { color: var(--ink-2); font-size: 1rem; }
      .quien p::first-letter { text-transform: uppercase; }
      .datos .alcance h2 {
        margin-bottom: 6px;
        font-size: 1rem;
      }
      .datos .resumen {
        color: var(--ink-2);
        font-size: 1.0625rem;
      }
      .tabla {
        margin: 0;
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(min(100%, 10rem), 1fr));
        gap: var(--s2) var(--s3);
        padding-top: var(--s2);
        border-top: 1px solid var(--line);
        align-self: start;
      }
      .tabla .con-prestacion { align-items:flex-start; flex-direction:column; justify-content:center; padding-block:6px; }
      .servicio-obra small { display:inline-flex; align-items:center; gap:5px; color:var(--ink-2); font-size:.9rem; line-height:1.35; }
      .servicio-obra small :global(svg) { flex:none; color:var(--red-text); }
      .tabla dt { color: var(--ink-2); font-size: .9375rem; }
      .tabla dd { display: flex; flex-wrap: wrap; gap: 0 14px; margin: 0; font-weight: 500; }
      .proyecto--sinfoto {
        grid-template-columns: 1fr;
        max-width: 72ch;
      }
      @media (max-width: 900px) {
        .proyecto {
          grid-template-columns: 1fr;
        }
        .hoja-cab {
          margin-top: 16px;
        }
        .proyecto {
          gap: 24px;
          padding-top: 24px;
        }
        .proyecto:not(.proyecto--sinfoto) > :is(.datos,.tabla),
        .obra { grid-column: auto; grid-row: auto; }
        .datos h1 {
          font-size: clamp(2rem, 7.5vw, 2.6rem);
          line-height: 1.08;
          font-weight: 600;
          letter-spacing: -0.025em;
        }
      }
    </style>
  </head>
  <body class="hoja-trabajo">
    <Top current="antecedentes" />

    <main id="contenido" tabindex="-1" data-project-reference={c.id}>
      <div class="wrap">
        <nav class="hoja-cab" aria-label="Ubicación en el archivo">
          <a href={returnHref} data-catalog-back data-preserve-origin={Boolean(journey) || undefined}>{returnLabel || 'Antecedentes'}</a>
          {relatedJourney?.archive && <a href={relatedJourney.archive.href}>{relatedJourney.archive.label}</a>}
          <b aria-current="page">{ref}</b>
        </nav>
        <div class:list={["proyecto", { "proyecto--sinfoto": !photo }]}>
          <div class="datos">
            <h1 data-contact-origin-title={`Proyecto ${ref} · ${pageTitle}`}>{pageTitle.replace(/\.$/, '')}<span class="dot">.</span></h1>
            <div class="quien">
              <strong>{clientArchive ? <a href={clientArchive} aria-label={`Ver antecedentes de ${c.client}`}>{c.client}</a> : c.client}</strong>
              {(periodo || estadoVisible) && <p>{[periodo, estadoVisible].filter(Boolean).join(" · ")}</p>}
            </div>
            {
              introduction && (c.documentedScope ? (
                <section class="alcance">
                  <h2>Alcance documentado</h2>
                  <p class="resumen">{introduction}</p>
                </section>
              ) : (
                <p class="resumen">{introduction}</p>
              ))
            }
            <div class="project-actions">
              <a class={accessProject ? 'btn' : 'u'} href={contactHref}>
                {accessProject ? 'Consultar por un acceso similar' : 'Consultar por una obra similar'} <span aria-hidden="true">→</span>
              </a>
            </div>
            {sections.length > 0 && (
              <nav class="project-sections" aria-label="En esta obra">
                <ul>{sections.map(({ id, label }) => (
                  <li><a href={`#${id}`}>{label}<ArrowDown size={15} aria-hidden="true" /></a></li>
                ))}</ul>
              </nav>
            )}
          </div>
          {
            photo && (
              <figure class="obra">
                <img
                  src={c.image}
                  srcset={imageSrcset}
                  sizes={imageSrcset ? imageSizes : undefined}
                  alt={photoAlt}
                  width={imageSet.ancho || 1600}
                  height={imageSet.ancho === 1536 ? 1024 : 1000}
                  fetchpriority="high"
                  decoding="async"
                />
              </figure>
            )
          }
          {(c.sector || svcs.length > 0) && <dl class="tabla">
            {c.sector && <div>
              <dt>Sector</dt>
              <dd>{sectorHref ? <a href={sectorHref}>{c.sector}</a> : c.sector}</dd>
            </div>}
            {svcs.length > 0 && <div>
              <dt>{svcs.length === 1 ? 'Servicio del proyecto' : 'Servicios del proyecto'}</dt>
              <dd>{svcs.map(s => <a class:list={['servicio-obra', s.provision && 'con-prestacion']} href={s.href}>
                <span>{s.name}</span>
                {s.provision && <small>{s.provision} <ArrowRight size={14} aria-hidden="true" /></small>}
              </a>)}</dd>
            </div>}
          </dl>}

        </div>
      </div>
      <>
        {accessProject && <CredentialSequence />}
        {caseDetail && <CasoEnDetalle caso={caseDetail} original={c.summary} />}
        {showEquipment && (
          <section class="sec" id="alcance" tabindex="-1" aria-labelledby="titulo-equipos">
            <div class="wrap">
              <div class="sec__head">
                <h2 id="titulo-equipos">
                  {scope.origen === "servicio"
                    ? "Capacidades de los servicios vinculados"
                    : c.documentedScope ? "Componentes y tareas del proyecto" : "Alcance documentado del proyecto"}
                  <span class="dot">.</span>
                </h2>
              </div>
              <FichaIso story={c} />
            </div>
          </section>
        )}
      </>
      {
        residentialScene ? (
          <ResidentialIntegration />
        ) : hospitalScene ? (
          <HospitalIntegration caseId={c.id as 3085 | 3102} />
        ) : equipmentScene ? (
          <EquipmentDetailSection content={equipmentScene} />
        ) : interventionScene ? (
          <InterventionSection content={interventionScene} />
        ) : connectionScene ? (
          <ConnectionSection content={connectionScene} />
        ) : operationsScene ? (
          <OperationsSection content={operationsScene} />
        ) : technicalScene ? (
          <TechnicalSection content={technicalScene} project />
        ) : (
          !accessProject && catalogScene && <CatalogScene content={catalogScene} />
        )
      }
      <div class="wrap">
        <section id="contacto" class:list={["project-close", { "project-close--single": !svcs.length }]} aria-labelledby="consulta-obra">
          <div>
            <h2 id="consulta-obra">¿Tenés un proyecto similar?</h2>
            <p>Contanos qué necesitás resolver. La consulta lleva la referencia <strong>{ref}</strong>.</p>
            <a class="btn" href={contactHref}>Iniciar consulta <ArrowRight size={17} aria-hidden="true" /></a>
          </div>
          {svcs.length > 0 && (
            <nav aria-labelledby="servicios-obra">
              <h3 id="servicios-obra">Servicios de esta obra</h3>
              <ul role="list">{svcs.map(service => (
                <li><a href={service.href}>
                  <span>
                    <strong>{service.provision || service.name}</strong>
                    {service.provision && <small>{service.name}</small>}
                  </span>
                  <ArrowUpRight size={16} aria-hidden="true" />
                </a></li>
              ))}</ul>
            </nav>
          )}
        </section>
        {selection && (
          <nav class="case-return" aria-label="Navegar los resultados">
            <div class="case-return__head">
              <a href={returnHref} data-catalog-back>{returnLabel}</a>
              {selection.total > 1 && <p>Resultado {selection.position} de {selection.total}</p>}
            </div>
            {(prev || next) && <div class="nav-obras" data-seleccion>
              {prev && <a href={prev.href + neighborQuery}><small><ArrowLeft size={15} aria-hidden="true" /> Anterior en los resultados</small><strong>{publicCaseTitle(prev)}</strong></a>}
              {next && <a href={next.href + neighborQuery}><small>Siguiente en los resultados <ArrowRight size={15} aria-hidden="true" /></small><strong>{publicCaseTitle(next)}</strong></a>}
            </div>}
          </nav>
        )}
      </div>
      <RelatedCases cover={c.image} groups={related} query={relatedQuery} />
      {!selection && <div class="wrap"><nav class="case-return case-return__head" aria-label="Volver a los proyectos">
        <a href={returnHref} data-catalog-back>{returnLabel || '← Todos los antecedentes'}</a>
      </nav></div>}
    </main>

    <Cierre withContact={false} />
    <script>
      for (const link of document.querySelectorAll<HTMLAnchorElement>('.project-sections a')) {
        const section = document.getElementById(link.hash.slice(1));
        if (section && !section.hasAttribute('tabindex')) section.tabIndex = -1;
      }

      const archive = '/antecedentes';
      const previous = document.referrer ? new URL(document.referrer) : null;
      const project = document.querySelector<HTMLElement>('[data-project-reference]')?.dataset.projectReference;
      const localReferrer = previous?.origin === location.origin ? previous : null;
      const fromArchive = localReferrer?.pathname.replace(/\/$/, '') === archive;
      const knownOrigin = Boolean(document.querySelector('[data-preserve-origin]'));
      const target = fromArchive && project ? archive + localReferrer!.search + '#resultado-um-' + project : history.state?.projectReturn;
      if (!knownOrigin && typeof target === 'string' && /^\/antecedentes(?:\?[^#]*)?#resultado-um-\d+$/.test(target)) {
        history.replaceState({ ...history.state, projectReturn: target }, '');
        for (const link of document.querySelectorAll<HTMLAnchorElement>('[data-catalog-back]')) {
          link.href = target;
          link.textContent = '← Volver a resultados';
        }
      }
    </script>
  </body>
</html>
