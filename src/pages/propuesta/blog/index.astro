---
/** Blog (2026-10-30): la lista de entradas, con la categoría como filtro. Datos del blog real. No indexable. */
import '../../../styles/proto-despiece.css';
import Head from '../../../components/proto/Head.astro';
import Top from '../../../components/proto/Top.astro';
import Cierre from '../../../components/proto/Cierre.astro';
import { fetchBlogListing } from '../../../utils/getBlogData';
import { getCategoryLabel, formatBlogDateLong, sanitizeBlogExcerpt } from '../../../utils/blogUtils';

export const prerender = false;
const categoria = Astro.url.searchParams.get('categoria') || '';
const POR_PAGINA = 12;
const pagina = Math.max(1, Number(Astro.url.searchParams.get('p')) || 1);
const { posts, total } = await fetchBlogListing(pagina, POR_PAGINA, categoria || undefined);
const paginas = Math.max(1, Math.ceil(total / POR_PAGINA));
const enlace = (p: number) => `/propuesta/blog?${categoria ? `categoria=${categoria}&` : ''}p=${p}`;
const todas = categoria ? (await fetchBlogListing(1, 60)).posts : posts;
const categorias = [...new Set(todas.map((p) => p.categoria))].sort();
---
<!doctype html>
<html lang="es">
  <head><Head title="Blog · ULTIMA MILLA" /><style>.paginas { display: flex; justify-content: space-between; align-items: center; gap: var(--s3); flex-wrap: wrap; padding: var(--s4) 0 var(--s6); } .paginas span:last-child { display: flex; gap: var(--s3); }</style></head>
  <body>
    <Top current="blog" />
    <main id="contenido" class="wrap">
      <div class="cabecera">
        <h1>Blog<span class="dot">.</span></h1>
        <p>Novedades de ULTIMA MILLA: servicios, proyectos y evolución de la empresa de servicios IT con sede en Guaymallén, Mendoza.</p>
        <nav class="chips" aria-label="Categorías"><a href="/propuesta/blog" aria-current={categoria ? undefined : 'page'}>Todo</a>{categorias.map((c) => <a href={`/propuesta/blog?categoria=${c}`} aria-current={c === categoria ? 'page' : undefined}>{getCategoryLabel(c)}</a>)}</nav>
      </div>
      <ol class="entradas">
        {posts.map((p) => (
          <li class="entrada">
            <span class="small"><span>{formatBlogDateLong(p.fecha_publicacion)}</span><span>{getCategoryLabel(p.categoria)}{p.tiempo_lectura ? ` · ${p.tiempo_lectura} min` : ''}</span></span>
            <a href={`/propuesta/blog/${p.slug}`}><h2>{p.titulo}</h2><p>{sanitizeBlogExcerpt(p.resumen, 220)}</p></a>
          </li>
        ))}
      </ol>
      {posts.length === 0 && <p class="muted" style="padding: var(--s4) 0">No hay entradas en esta categoría.</p>}
      <nav class="paginas" aria-label="Páginas"><span class="small">{total} {total === 1 ? 'entrada' : 'entradas'} · página {pagina} de {paginas}</span><span>{pagina > 1 && <a class="u" href={enlace(pagina - 1)}>← Anteriores</a>}{pagina < paginas && <a class="u" href={enlace(pagina + 1)}>Siguientes →</a>}</span></nav>
    </main>
    <Cierre />
  </body>
</html>
