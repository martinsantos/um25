---
/** Blog (2026-10-30): la lista de entradas, con la categoría como filtro. Datos del blog real. */
import '../../../styles/proto-despiece.css';
import Head from '../../../components/proto/Head.astro';
import Top from '../../../components/proto/Top.astro';
import Cierre from '../../../components/proto/Cierre.astro';
import ObrasPortada from '../../../components/proto/ObrasPortada.astro';
import { portadaCases } from '../../../components/proto/portadaCases';
import { loadStories } from '../../../components/proto/isoData';
import BlogTopicNav from '../../../components/blog/BlogTopicNav.astro';
import { publishableServiceHubs } from '../../../utils/blogTopicMap';
import BlogCategoryTabs from '../../../components/blog/BlogCategoryTabs.astro';
import { blogNoteHref, resolveBlogListingRoute } from '../../../lib/blogListingRoute';
import { blogImageSrcset, blogPostImageAlt, blogPostImageUrl } from '../../../utils/blogHelpers';
import { fetchBlogListing } from '../../../utils/getBlogData';
import { getCategoryLabel, formatBlogDateLong, sanitizeBlogExcerpt } from '../../../utils/blogUtils';

export const prerender = false;
const route = resolveBlogListingRoute(Astro.url);
if (route.invalidCategory) return Astro.rewrite('/404');
if (route.redirectTo) return Astro.redirect(route.redirectTo, 301);
const categoria = route.category || '';
const POR_PAGINA = 10;
const pagina = route.page;
const { posts, total } = await fetchBlogListing(pagina, POR_PAGINA, categoria || undefined);
const paginas = Math.max(1, Math.ceil(total / POR_PAGINA));
if (pagina > paginas) return Astro.rewrite('/404');
const enlace = (p: number) => {
  const params = new URLSearchParams();
  if (categoria) params.set('categoria', categoria);
  if (p > 1) params.set('page', String(p));
  return params.size ? `/blog?${params}` : '/blog';
};
const canonicalPath = route.canonicalPath || '/blog';
const obras = pagina === 1 && !categoria && posts.length ? portadaCases((await loadStories()).stories, 'blog') : [];
const topics = pagina === 1 && !categoria && posts.length > 0 ? publishableServiceHubs() : [];
const showTopics = topics.length > 0;
const primeraPagina = pagina === 1 && !categoria;
const articleGroups = primeraPagina ? [posts.slice(0, 3), posts.slice(3)] : [posts];
const pageTitle = [categoria ? getCategoryLabel(categoria) : 'Blog', ...(pagina > 1 ? [`Página ${pagina}`] : []), 'ULTIMA MILLA'].join(' · ');
---
<!doctype html>
<html lang="es">
  <head><Head title={pageTitle} description="Novedades de ULTIMA MILLA: servicios, proyectos y evolución de la empresa de servicios IT con sede en Guaymallén, Mendoza." canonicalPath={canonicalPath} noindex={Boolean(categoria) && total === 0} /><style>
      .blog-controls { display:flex; flex-wrap:wrap; align-items:baseline; gap:0 24px; }
      .blog-topic-jump { display:inline-flex; align-items:center; gap:6px; min-height:44px; text-underline-offset:.22em; text-decoration:underline; }
      .entradas { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:clamp(16px,2.4vw,36px); }
      .entrada { display:flex; flex-direction:column; align-items:stretch; gap:12px; min-width:0; padding-block:16px; overflow-wrap:anywhere; scroll-margin-top:12px; }
      .entrada > a { display:grid; gap:10px; }
      .entrada h2 { font-size:clamp(1.25rem,1.75vw,1.75rem); line-height:1.2; }
      .entrada p { margin:0; max-width:55ch; color:var(--ink-2); line-height:1.5; }
      .entrada .small { display:flex; flex-wrap:wrap; gap:6px 16px; }
      .entrada__image { display:block; width:100%; aspect-ratio:16/9; object-fit:cover; margin:0; }
      .edicion { grid-template-columns:minmax(0,1.5fr) minmax(0,1fr); grid-template-rows:min-content 1fr; align-items:start; row-gap:10px; border-top:0; }
      .edicion:has(.principal:only-child) { grid-template-columns:minmax(0,1fr); }
      .edicion .entrada { border-top:1px solid var(--line); }
      .edicion .principal { grid-row:span 2; }
      .principal .entrada__image { aspect-ratio:2.1; }
      .principal h2 { font-size:clamp(1.75rem,3.25vw,3.1rem); line-height:1.08; letter-spacing:-.035em; }
      .secundaria > a { grid-template-columns:clamp(94px,28%,154px) minmax(0,1fr); gap:5px 14px; align-items:start; }
      .secundaria img { grid-row:span 2; aspect-ratio:1.3; }
      .secundaria h2 { font-size:clamp(1.15rem,1.7vw,1.55rem); }
      .secundaria p { font-size:.96rem; }
      .entrada:focus-visible { outline:2px solid var(--red); outline-offset:4px; }
      .paginas { display:flex; justify-content:space-between; align-items:center; gap:var(--s3); flex-wrap:wrap; padding:var(--s4) 0 var(--s6); }
      .paginas > span:last-child { display:flex; flex-wrap:wrap; gap:var(--s3); }
      .paginas .u { min-height:44px; display:inline-flex; align-items:center; }
      .blog-empty { padding-block:var(--s4) var(--s6); }
      .blog-empty h2 { margin-bottom:16px; }
      @media(max-width:1100px) { .entradas:not(.edicion) { grid-template-columns:repeat(2,minmax(0,1fr)); } }
      @media(max-width:900px) {
        .cabecera { padding-block:32px; }
        .cabecera h1 { font-size:clamp(2rem,7.5vw,2.6rem); line-height:1.08; font-weight:600; letter-spacing:-.025em; }
        .cabecera p { font-size:1.0625rem; line-height:1.55; }
      }
      @media(max-width:700px) {
        .entradas:not(.edicion),.edicion { grid-template-columns:minmax(0,1fr); grid-template-rows:none; row-gap:0; }
        .edicion .principal { grid-row:auto; }
        .secundaria > a { grid-template-columns:clamp(78px,26vw,130px) minmax(0,1fr); }
        .secundaria img { grid-row:auto; }
        .secundaria p { grid-column:1/-1; }
      }
    </style></head>
  <body>
    <Top current="blog" />
    <main id="contenido" tabindex="-1" class="wrap">
      <div class="cabecera">
        <h1>{categoria ? getCategoryLabel(categoria) : 'Blog'}<span class="dot">.</span></h1>
        {!categoria && <p>Notas de campo y artículos del equipo sobre redes, seguridad, software y operación IT.</p>}
        <div class="blog-controls">
          <BlogCategoryTabs current={categoria || undefined} query />
          {showTopics && <a class="blog-topic-jump" href="#temas">Explorar por tema <span aria-hidden="true">↓</span></a>}
        </div>
      </div>
      {posts.length > 0 && articleGroups.map((articles, part) => <Fragment>
        {articles.length > 0 && <ol id={part === 0 ? 'notas' : 'mas-notas'} start={part === 0 ? undefined : 4}
          class:list={['entradas', { edicion: primeraPagina && part === 0 }]}>
          {articles.map((p, index) => {
            const principal = primeraPagina && part === 0 && index === 0;
            const secundaria = primeraPagina && part === 0 && !principal;
            const image = blogPostImageUrl(p);
            const sizes = principal ? '(max-width: 700px) 94vw, 56vw'
              : secundaria ? '(max-width: 700px) clamp(78px, 26vw, 130px), 154px'
              : '(max-width: 700px) 94vw, (max-width: 1100px) 50vw, 33vw';
            return <li id={`nota-${p.slug}`} tabindex="-1" class:list={['entrada', { principal, secundaria }]}>
              <span class="small"><span>{formatBlogDateLong(p.fecha_publicacion)}</span><span>{getCategoryLabel(p.categoria)}{p.tiempo_lectura ? ` · ${p.tiempo_lectura} min` : ''}</span></span>
              <a href={blogNoteHref(p.slug, canonicalPath + '#nota-' + p.slug)}>
                <img class="entrada__image" src={image} srcset={blogImageSrcset(image)} sizes={sizes} alt={blogPostImageAlt(p)}
                  width="960" height="540" loading={part === 0 && index < 3 ? 'eager' : 'lazy'} fetchpriority={part === 0 && index === 0 ? 'high' : undefined} />
                <h2>{p.titulo}</h2>
                <p>{sanitizeBlogExcerpt(p.resumen, 220)}</p>
              </a>
            </li>;
          })}
        </ol>}
        {part === 0 && showTopics && <BlogTopicNav hubs={topics} />}
      </Fragment>)}
      {posts.length === 0 && (
        <section class="blog-empty" aria-labelledby="blog-empty-title">
          <h2 id="blog-empty-title">{categoria ? `Sin artículos publicados en ${getCategoryLabel(categoria).toLowerCase()}` : 'Sin artículos disponibles'}</h2>
          {categoria && <a class="u" href="/blog">Ver todas las notas <span aria-hidden="true">→</span></a>}
        </section>
      )}
      {total > 0 && <nav class="paginas" aria-label="Páginas"><span class="small">{total} {total === 1 ? 'entrada' : 'entradas'} · página {pagina} de {paginas}</span><span>{pagina > 1 && <a class="u" href={enlace(pagina - 1)}>← Página anterior</a>}{pagina < paginas && <a class="u" href={enlace(pagina + 1)}>Página siguiente →</a>}</span></nav>}
      {obras.length > 0 && <ObrasPortada compact inset obras={obras} title="Del archivo técnico" />}
    </main>
    <Cierre />
  </body>
</html>
