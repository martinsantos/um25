---
/** Blog (2026-10-30): la lista de entradas, con la categoría como filtro. Datos del blog real. */
import '../../../styles/proto-despiece.css';
import Head from '../../../components/proto/Head.astro';
import Top from '../../../components/proto/Top.astro';
import Cierre from '../../../components/proto/Cierre.astro';
import BlogCategoryTabs from '../../../components/blog/BlogCategoryTabs.astro';
import { resolveBlogListingRoute } from '../../../lib/blogListingRoute';
import { blogImageSrcset, blogPostImageAlt, blogPostImageUrl } from '../../../utils/blogHelpers';
import { fetchBlogListing } from '../../../utils/getBlogData';
import { getCategoryLabel, formatBlogDateLong, sanitizeBlogExcerpt } from '../../../utils/blogUtils';

export const prerender = false;
const route = resolveBlogListingRoute(Astro.url);
if (route.invalidCategory) return Astro.rewrite('/404');
if (route.redirectTo) return Astro.redirect(route.redirectTo, 301);
const categoria = route.category || '';
const POR_PAGINA = 10;
const pagina = route.page;
const { posts, total } = await fetchBlogListing(pagina, POR_PAGINA, categoria || undefined);
const paginas = Math.max(1, Math.ceil(total / POR_PAGINA));
if (pagina > paginas) return Astro.rewrite('/404');
const enlace = (p: number) => `/blog?${categoria ? `categoria=${categoria}&` : ''}page=${p}`;
const canonicalPath = route.canonicalPath || '/blog';
const pageTitle = [categoria ? getCategoryLabel(categoria) : 'Blog', ...(pagina > 1 ? [`Página ${pagina}`] : []), 'ULTIMA MILLA'].join(' · ');
---
<!doctype html>
<html lang="es">
  <head><Head title={pageTitle} description="Novedades de ULTIMA MILLA: servicios, proyectos y evolución de la empresa de servicios IT con sede en Guaymallén, Mendoza." canonicalPath={canonicalPath} noindex={Boolean(categoria) && total === 0} /><style>.entradas { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; } .entrada { display: flex; flex-direction: column; gap: 16px; padding-block: 16px; } .entrada h2 { font-size: clamp(1.4rem, 1.8vw, 1.8rem); line-height: 1.2; } .entrada .small { display: flex; flex-wrap: wrap; gap: 8px 20px; } @media(max-width: 1100px) { .entradas { grid-template-columns: repeat(2, minmax(0, 1fr)); } } @media(max-width: 700px) { .entradas { grid-template-columns: 1fr; } } .entrada__image { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; margin-bottom: 24px; } .paginas { display: flex; justify-content: space-between; align-items: center; gap: var(--s3); flex-wrap: wrap; padding: var(--s4) 0 var(--s6); } .paginas span:last-child { display: flex; gap: var(--s3); }
      .blog-empty { padding-block: var(--s4) var(--s6); }
      .blog-empty h2 { margin-bottom: 16px; }
      @media (max-width: 900px) {
        .cabecera { padding-block: 32px; }
        .cabecera h1 { font-size: clamp(2rem, 7.5vw, 2.6rem); line-height: 1.08; font-weight: 600; letter-spacing: -.025em; }
        .cabecera p { font-size: 1.0625rem; line-height: 1.55; }
        .entrada > a { display: grid; gap: 16px; }
        .entrada__image { margin-bottom: 0; }
        .entrada h2 { font-size: 1.5rem; }
        .entrada p { color: var(--ink-2); font-size: 1.0625rem; line-height: 1.6; }
        .paginas .u { min-height: 44px; display: inline-flex; align-items: center; }
      }
    </style></head>
  <body>
    <Top current="blog" />
    <main id="contenido" class="wrap">
      <div class="cabecera">
        <h1>Blog<span class="dot">.</span></h1>
        <p>Novedades de ULTIMA MILLA: servicios, proyectos y evolución de la empresa de servicios IT con sede en Guaymallén, Mendoza.</p>
        <BlogCategoryTabs current={categoria || undefined} query />
      </div>
      {posts.length > 0 && <ol class="entradas">
        {posts.map((p, index) => (
          <li class="entrada">
            <span class="small"><span>{formatBlogDateLong(p.fecha_publicacion)}</span><span>{getCategoryLabel(p.categoria)}{p.tiempo_lectura ? ` · ${p.tiempo_lectura} min` : ''}</span></span>
            <a href={`/blog/${p.slug}`}><img class="entrada__image" src={blogPostImageUrl(p)} srcset={blogImageSrcset(blogPostImageUrl(p))} sizes="(max-width: 700px) 100vw, (max-width: 1100px) 50vw, 33vw" alt={blogPostImageAlt(p)} width="960" height="540" loading={index < 3 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : undefined} /><h2>{p.titulo}</h2><p>{sanitizeBlogExcerpt(p.resumen, 220)}</p></a>
          </li>
        ))}
      </ol>}
      {posts.length === 0 && (
        <section class="blog-empty" aria-labelledby="blog-empty-title">
          <h2 id="blog-empty-title">{categoria ? `Sin artículos publicados en ${getCategoryLabel(categoria).toLowerCase()}` : 'Sin artículos disponibles'}</h2>
          {categoria && <a class="u" href="/blog">Ver todas las notas <span aria-hidden="true">→</span></a>}
        </section>
      )}
      {total > 0 && <nav class="paginas" aria-label="Páginas"><span class="small">{total} {total === 1 ? 'entrada' : 'entradas'} · página {pagina} de {paginas}</span><span>{pagina > 1 && <a class="u" href={enlace(pagina - 1)}>← Anteriores</a>}{pagina < paginas && <a class="u" href={enlace(pagina + 1)}>Siguientes →</a>}</span></nav>}
    </main>
    <Cierre />
  </body>
</html>
