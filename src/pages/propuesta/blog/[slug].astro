---
/** Entrada del blog (2026-10-30): texto a una columna de lectura; después, más entradas de la misma categoría. No indexable. */
import '../../../styles/proto-despiece.css';
import Head from '../../../components/proto/Head.astro';
import Top from '../../../components/proto/Top.astro';
import Cierre from '../../../components/proto/Cierre.astro';
import { fetchBlogPost, fetchBlogListing } from '../../../utils/getBlogData';
import { getCategoryLabel, formatBlogDateLong, addHeadingIds, sanitizeBlogExcerpt } from '../../../utils/blogUtils';
import { canonicalizeInternalBlogLinks } from '../../../utils/blogCanonicalLinks';

export const prerender = false;
const slug = String(Astro.params.slug);
const post = await fetchBlogPost(slug);
if (!post) return new Response(null, { status: 404 });
const { html } = await addHeadingIds(canonicalizeInternalBlogLinks(post.contenido || ''));
const contenido = html.replace(/href="\/blog\//g, 'href="/propuesta/blog/');
const { posts } = await fetchBlogListing(1, 6, post.categoria);
const mas = posts.filter((p) => p.slug !== post.slug).slice(0, 4);
---
<!doctype html>
<html lang="es">
  <head>
    <Head title={`${post.titulo} · Blog · ULTIMA MILLA`} description={sanitizeBlogExcerpt(post.resumen, 160)} />
    <style>
      .post { padding-block: var(--s5) var(--s6); display: grid; grid-template-columns: minmax(0, 3fr) minmax(0, 9fr); gap: var(--s4) clamp(28px, 4vw, 72px); align-items: start; }
      .post__meta { position: sticky; top: 80px; display: grid; gap: var(--s2); color: var(--ink-3); font-size: .9375rem; }
      .post__meta a:hover { color: var(--ink); }
      .post h1 { font-size: clamp(2rem, 3.6vw, 3.4rem); margin-bottom: var(--s2); }
      .post .resumen { font-size: clamp(1.25rem, 1.8vw, 1.5rem); color: var(--ink); line-height: 1.4; margin-bottom: var(--s4); max-width: 60ch; }
      .post figure { margin: 0 0 var(--s4); aspect-ratio: 16 / 9; overflow: hidden; background: var(--bg-2); }
      .post figure img { width: 100%; height: 100%; object-fit: cover; display: block; }
      @media (max-width: 900px) { .post { grid-template-columns: 1fr; } .post__meta { position: static; } }
    </style>
  </head>
  <body>
    <Top current="blog" />
    <main class="wrap">
      <article class="post">
        <aside class="post__meta">
          <a href="/propuesta/blog">← Blog</a>
          <span>{formatBlogDateLong(post.fecha_publicacion)}</span>
          <a href={`/propuesta/blog?categoria=${post.categoria}`}>{getCategoryLabel(post.categoria)}</a>
          {post.tiempo_lectura > 0 && <span>{post.tiempo_lectura} min de lectura</span>}
        </aside>
        <div>
          <h1>{post.titulo}<span class="dot">.</span></h1>
          {post.resumen && <p class="resumen">{sanitizeBlogExcerpt(post.resumen, 300)}</p>}
          {post.imagen_portada && <figure><img src={post.imagen_portada} alt={post.imagen_portada_alt || ''} width="1200" height="675" /></figure>}
          <div class="lectura" set:html={contenido} />
        </div>
      </article>
    </main>
    {mas.length > 0 && (
      <section class="sec"><div class="wrap"><div class="sec__head"><h2>Más en {getCategoryLabel(post.categoria).toLowerCase()}<span class="dot">.</span></h2></div>
        <ol class="entradas">{mas.map((p) => <li class="entrada"><span class="small"><span>{formatBlogDateLong(p.fecha_publicacion)}</span></span><a href={`/propuesta/blog/${p.slug}`}><h2>{p.titulo}</h2><p>{sanitizeBlogExcerpt(p.resumen, 180)}</p></a></li>)}</ol>
      </div></section>
    )}
    <Cierre />
  </body>
</html>
