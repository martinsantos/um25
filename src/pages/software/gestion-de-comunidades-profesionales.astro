  .hero-visual-foot { align-items:end; margin-top:auto; }.hero-visual-foot span:first-child { color:#1b2828; font-size:.87rem; letter-spacing:0; }.hero-visual-foot span:last-child { text-align:right; font-size:.58rem; }
  .hero-screen { width:min(100%,500px); margin:auto; background:#fff; border:1px solid #cbd7d0; box-shadow:0 20px 55px #657c7130; }
