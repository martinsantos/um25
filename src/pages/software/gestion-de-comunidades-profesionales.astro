  .system-id { display:flex; flex-direction:column; gap:12px; margin-top:24px; padding:16px 20px; background:#1e2928; color:#fff; }.system-id span { color:#ef796c; font-size:.6rem; letter-spacing:.1em; }.system-id strong { font-size:1.05rem; }.system-id small { color:#b4c9bd; }
