  const renderJourney = (feature: ModuleKey) => {
    activeModule = feature;
    const title = document.querySelector<HTMLElement>('#quiz-journey-title');
    if (title) title.textContent = modules[feature].title;
    const list = document.querySelector<HTMLOListElement>('#quiz-journey-steps');
    if (list) {
      list.replaceChildren();
      modules[feature].journey.forEach((item) => { const li = document.createElement('li'); li.textContent = item; list.append(li); });
    }
    document.querySelectorAll<HTMLButtonElement>('#quiz-modules button').forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.module === feature));
    });
  };
  const renderResult = (partial: boolean) => {
    if (!flow || !resultPanel || !quiz) return;
    flow.hidden = true; resultPanel.hidden = false; quiz.classList.add('is-result');
    const title = document.querySelector<HTMLElement>('#quiz-result-title');
    if (title) { title.textContent = quizState.needs.length ? 'Un recorrido posible para tu colegio.' : 'Un sistema para empezar a explorar.'; title.focus({ preventScroll: true }); }
    const copy = document.querySelector<HTMLElement>('#quiz-result-copy');
    const activityLabel = labelFor(activityOptions, quizState.activity);
    const activityDetail = quizState.activity === 'otra' && quizState.activityOther.trim() ? `: ${quizState.activityOther.trim()}` : '';
    const secondaryLabels = quizState.secondaryActivities.map((value) => value === 'otra' && quizState.activityOther.trim() ? `Otra actividad: ${quizState.activityOther.trim()}` : labelFor(activityOptions, value));
    if (copy) copy.textContent = (activityLabel ? `Actividad principal indicada: ${activityLabel}${activityDetail}. ` : '') + (quizState.needs.length
      ? 'Tomamos tus prioridades para ordenar los módulos. Elegí uno y mirá cómo sería el recorrido dentro del sistema.'
      : 'Todavía no elegiste necesidades. Podés recorrer los módulos, editar tus respuestas y volver a este resultado cuando quieras.');
    const moduleList = document.querySelector<HTMLElement>('#quiz-modules');
    if (moduleList) {
      moduleList.replaceChildren();
      selectedNeeds().forEach((feature, index) => {
        const button = document.createElement('button'); button.type = 'button'; button.dataset.module = feature;
        button.className = 'quiz-module-card';
        const number = document.createElement('span'); number.textContent = String(index + 1).padStart(2, '0');
        const name = document.createElement('strong'); name.textContent = modules[feature].title;
        const purpose = document.createElement('span'); purpose.textContent = modules[feature].purpose;
        button.append(number, name, purpose);
        button.addEventListener('click', () => renderJourney(feature));
        moduleList.append(button);
      });
    }
    renderJourney(selectedNeeds()[0]);
    const signaturePanel = document.querySelector<HTMLElement>('#quiz-signature');
    const signatureCopy = document.querySelector<HTMLElement>('#quiz-signature-copy');
    if (signaturePanel && signatureCopy) {
      signaturePanel.hidden = !['si', 'evaluar'].includes(quizState.signature);
      if (!signaturePanel.hidden) {
        const procedures = quizState.signatureProcedures.map((value) => labelFor(signatureProcedureOptions, value));
        signatureCopy.textContent = `${quizState.signature === 'si' ? 'Indicaron que necesitan' : 'Quieren evaluar'} firma digital${procedures.length ? ` para ${procedures.join(', ').toLowerCase()}` : ' para sus trámites'}. Podemos definir el circuito y comprobar sus requisitos antes de incorporarla.`;
      }
    }
    const install = document.querySelector<HTMLElement>('#quiz-install-note');
    if (install) install.textContent = installationCopy[quizState.install] || 'Podemos revisar juntos si conviene instalación propia, acompañada o servicio gestionado.';
    const edits = document.querySelector<HTMLElement>('#quiz-edit-list');
    if (edits) {
      edits.replaceChildren();
      const summaries = [
        ['Profesión', labelFor(professionOptions, quizState.profession) || 'A definir'],
        ['Actividad principal', `${activityLabel ? `${activityLabel}${activityDetail}` : 'A definir'}${secondaryLabels.length ? ` · También: ${secondaryLabels.join(', ')}` : ''}`],
        ['Integrantes', labelFor(sizeOptions, quizState.size) || 'A definir'],
        ['Necesidades', quizState.needs.map((value) => labelFor(needOptions, value)).join(', ') || 'A definir'],
        ['Circuitos', relevantGroups().flatMap((group) => quizState[group.key].map((value) => labelFor(group.options, value))).join(', ') || 'A definir'],
        ['Firma digital', labelFor(signatureOptions, quizState.signature) || 'A definir'],
        ['Instalación', labelFor(installOptions, quizState.install) || 'A definir'],
        ['Contexto', freeFields.some((field) => quizState[field.key].trim()) ? 'Datos opcionales completados' : 'Sin datos personales'],
      ];
      summaries.forEach(([name, summary], index) => {
        const button = document.createElement('button'); button.type = 'button'; button.className = 'quiz-edit';
        const label = document.createElement('span'); label.textContent = name;
        const value = document.createElement('strong'); value.textContent = summary;
        const action = document.createElement('span'); action.textContent = 'Editar ↗';
        button.append(label, value, action);
        button.addEventListener('click', () => { step = index; renderStep(); });
        edits.append(button);
      });
    }
    const resultKey = JSON.stringify({ partial, profession: quizState.profession, activity: quizState.activity, secondaryActivities: quizState.secondaryActivities, size: quizState.size, needs: quizState.needs, payments: quizState.payments, procedures: quizState.procedures, channels: quizState.channels, credential: quizState.credential, signature: quizState.signature, signatureProcedures: quizState.signatureProcedures, install: quizState.install });
    if (resultKey !== lastResultKey) { track('gc_quiz_result', partial ? 'partial' : 'complete'); lastResultKey = resultKey; }
  };
  document.querySelector<HTMLButtonElement>('#quiz-start')?.addEventListener('click', () => {
    if (!quiz || !welcome || !resultPanel) return;
    quizState = initialState(); completedSteps.clear(); step = 0; quizAttached = false; lastResultKey = '';
    welcome.hidden = true; resultPanel.hidden = true;
    const inline = document.querySelector<HTMLElement>('#quiz-inline-demo'); if (inline) inline.hidden = true;
    track('gc_quiz_start', 'quiz'); renderStep();
  });
  nextButton?.addEventListener('click', () => {
    if (nextButton.disabled) return;
    markStep();
    if (step === questionMeta.length - 1) renderResult(false);
    else { step += 1; renderStep(); }
  });
  document.querySelector<HTMLButtonElement>('#quiz-skip')?.addEventListener('click', () => {
    if (step === questionMeta.length - 1) renderResult(false);
    else { step += 1; renderStep(); }
  });
  document.querySelector<HTMLButtonElement>('#quiz-see-result')?.addEventListener('click', () => renderResult(true));
  document.querySelector<HTMLButtonElement>('#quiz-back')?.addEventListener('click', () => {
    if (step > 0) { step -= 1; renderStep(); }
    else if (welcome && flow) { flow.hidden = true; welcome.hidden = false; document.querySelector<HTMLButtonElement>('#quiz-start')?.focus(); }
  });
  document.querySelector<HTMLButtonElement>('#quiz-restart')?.addEventListener('click', () => {
    if (!resultPanel || !welcome || !quiz) return;
    resultPanel.hidden = true; welcome.hidden = false; quiz.classList.remove('is-result');
    quizState = initialState(); completedSteps.clear(); quizAttached = false; lastResultKey = '';
    document.querySelector<HTMLIFrameElement>('#quiz-demo-frame')?.removeAttribute('src');
    const inline = document.querySelector<HTMLElement>('#quiz-inline-demo'); if (inline) inline.hidden = true;
    document.querySelector<HTMLButtonElement>('#quiz-start')?.focus();
  });
  document.querySelector<HTMLButtonElement>('#quiz-open-demo')?.addEventListener('click', () => {
    const inline = document.querySelector<HTMLElement>('#quiz-inline-demo');
    const frame = document.querySelector<HTMLIFrameElement>('#quiz-demo-frame');
    if (!inline || !frame) return;
    const firstOpen = inline.hidden;
    inline.hidden = false;
    if (!frame.hasAttribute('src')) frame.src = '/software/gestion-de-comunidades-profesionales/demo/';
    if (firstOpen) track('gc_quiz_demo', activeModule);
    inline.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'instant' : 'smooth', block: 'start' });
  });
  document.querySelector<HTMLButtonElement>('#quiz-contact')?.addEventListener('click', () => {
    const message = document.querySelector<HTMLTextAreaElement>('#gc-form textarea[name="message"]');
    const company = document.querySelector<HTMLInputElement>('#gc-form input[name="company"]');
    const person = document.querySelector<HTMLInputElement>('#gc-form input[name="name"]');
    if (!message || !company || !person) return;
    if (quizState.institution.trim()) company.value = quizState.institution.trim();
    if (quizState.person.trim()) person.value = quizState.person.trim();
    const lines = [
      'Nos gustaría ver una demo con el formato de datos de nuestra institución.',
      `Profesión: ${labelFor(professionOptions, quizState.profession) || 'a definir'}.`,
      `Actividad principal: ${labelFor(activityOptions, quizState.activity) || 'a definir'}${quizState.activity === 'otra' && quizState.activityOther.trim() ? ` (${quizState.activityOther.trim()})` : ''}.`,
      ...(quizState.secondaryActivities.length ? [`Otras actividades: ${quizState.secondaryActivities.map((value) => labelFor(activityOptions, value)).join(', ')}.`] : []),
      ...(quizState.activity !== 'otra' && quizState.secondaryActivities.includes('otra') && quizState.activityOther.trim() ? [`Otra actividad indicada: ${quizState.activityOther.trim()}.`] : []),
      `Integrantes: ${labelFor(sizeOptions, quizState.size) || 'a definir'}.`,
      `Necesidades: ${quizState.needs.map((value) => labelFor(needOptions, value)).join(', ') || 'a definir'}.`,
      ...circuitGroups.flatMap((group) => quizState[group.key].length ? [`${group.title}: ${quizState[group.key].map((value) => labelFor(group.options, value)).join(', ')}.`] : []),
      `Firma digital: ${labelFor(signatureOptions, quizState.signature) || 'a definir'}.`,
      ...(quizState.signatureProcedures.length ? [`Trámites para evaluar firma digital: ${quizState.signatureProcedures.map((value) => labelFor(signatureProcedureOptions, value)).join(', ')}.`] : []),
      `Instalación: ${labelFor(installOptions, quizState.install) || 'a definir'}.`,
      ...(quizState.province.trim() ? [`Provincia: ${quizState.province.trim()}.`] : []),
      ...(quizState.address.trim() ? [`Dirección institucional: ${quizState.address.trim()}.`] : []),
      ...(quizState.details.trim() ? [`Detalle: ${quizState.details.trim()}`] : []),
    ];
    message.value = lines.join('\n').slice(0, 1200);
    if (!quizAttached) track('gc_quiz_contact', 'quiz');
    quizAttached = true;
    showIntentView('contact');
    (company.value ? person : company).focus({ preventScroll: true });
  });
  document.querySelector<HTMLButtonElement>('#quiz-direct-contact')?.addEventListener('click', () => showIntentView('contact'));
  const form = document.querySelector<HTMLFormElement>('#gc-form');
  const status = document.querySelector<HTMLElement>('#gc-status');
  let submitting = false;
  form?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (submitting) return;
    if (!form.reportValidity()) return;
    submitting = true;
    const button = form.querySelector<HTMLButtonElement>('button[type="submit"]');
    if (button) button.disabled = true;
    if (status) status.textContent = 'Enviando consulta…';
    const fields = new FormData(form);
    const utm = new URLSearchParams();
    for (const [key, value] of Object.entries(attribution)) utm.set(key, value);
    const url = new URL(location.href);
    const query = utm.toString();
    const payload = {
      name: String(fields.get('name') || '').trim(), email: String(fields.get('email') || '').trim(),
      company: String(fields.get('company') || '').trim(), message: String(fields.get('message') || '').trim(),
      website: String(fields.get('website') || ''), formVariant: quizAttached ? 'comunidades-profesionales-quiz' : 'comunidades-profesionales',
      originPath: url.pathname, originTitle: document.title, originLabel: 'Solicitar demo',
      originIntent: 'Software para comunidades profesionales',
      originHref: url.origin + url.pathname + (query ? '?' + query : ''),
    };
    try {
      const response = await fetch('/api/contact', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      const result = await response.json();
      if (!response.ok || result.success !== true) throw new Error('send failed');
      if (!result.duplicate) track('gc_inquiry_confirmed', quizAttached ? 'quiz' : 'form');
      form.reset();
      quizAttached = false;
      if (status) status.textContent = 'Recibimos tu solicitud de demo. Te responderemos por email.';
    } catch { if (status) status.textContent = 'No pudimos enviar la solicitud. Intentá nuevamente o escribinos a contacto@ultimamilla.com.ar.'; }
    finally { submitting = false; if (button) button.disabled = false; }
  });
</script>
