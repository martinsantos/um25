---
/**
 * Bodegas Sector Page - V4 Design System
 */

import LayoutV4 from '../layouts/LayoutV4.astro';
import { generateSlug } from '../utils/slugUtils.js';
import { antecedentesReales } from '../data/antecedentes_completos.js';
import { directus, DEFAULT_IMAGE } from '../utils/directus';

const sectorConfig = {
  name: 'Bodegas',
  emoji: '🍷',
  heroImage: 'https://images.unsplash.com/photo-1506377247377-2a5b3b417ebb?w=1920&q=80',
  description: 'Soluciones tecnológicas especializadas para bodegas y la industria vitivinícola de Mendoza.',
  keywords: ['bodega', 'viña', 'finca', 'wines', 'vitivinicola', 'vino', 'domaine', 'bousquet', 'norton', 'trapiche', 'catena', 'zuccardi', 'rutini', 'enologia', 'viñedo', 'malbec'],
};

const seoConfig = {
  title: `Tecnología para ${sectorConfig.name} Vitivinícolas | Mendoza, Cuyo y Patagonia | ULTIMA MILLA`,
  description: `Servicios tecnológicos para bodegas y sector vitivinícola en Argentina. Redes de datos, telecomunicaciones, automatización y conectividad especializada para la industria del vino.`,
  keywords: `servicios tecnologicos bodegas, infraestructura it vitivinicola mendoza, redes bodegas cuyo, telecomunicaciones viñedos, automatizacion bodegas`,
};

const filterAntecedentes = (data: any[]) => {
  return data
    .filter(item => {
      const texto = `${item.Cliente} ${item.Titulo} ${item.Area} ${item.Descripcion}`.toLowerCase();
      return sectorConfig.keywords.some(k => texto.includes(k));
    })
    .map(item => ({ ...item, slug: generateSlug(item.Titulo) }))
    .slice(0, 12);
};

let antecedentes: any[] = [];
try {
  const response = await directus.getAntecedentes({ limit: 500, page: 1 });
  if (response?.data?.length > 0) antecedentes = filterAntecedentes(response.data);
} catch (err) { console.error('Error:', err); }
if (antecedentes.length === 0) antecedentes = filterAntecedentes(antecedentesReales);

const valueProps = [
  { icon: 'thermometer', title: 'Control Ambiental', description: 'Monitoreo de temperatura y humedad en barricas y tanques.' },
  { icon: 'shield', title: 'Seguridad Perimetral', description: 'CCTV y control de accesos para protección de instalaciones.' },
  { icon: 'wifi', title: 'Conectividad Rural', description: 'Enlaces de radio y fibra óptica para fincas remotas.' }
];

const serviciosRelacionados = [
  { id: 101, nombre: 'Redes de Datos', descripcion: 'Cableado estructurado y WiFi para bodegas y fincas' },
  { id: 102, nombre: 'CCTV y Seguridad', descripcion: 'Videovigilancia para tanques, barricas y perímetros' },
  { id: 103, nombre: 'Control de Accesos', descripcion: 'Sistemas para áreas restringidas y producción' },
  { id: 104, nombre: 'Telecomunicaciones', descripcion: 'Radioenlaces para fincas y comunicaciones internas' },
  { id: 107, nombre: 'Detección de Incendios', descripcion: 'Protección para naves de barricas y depósitos' },
  { id: 105, nombre: 'Soporte IT', descripcion: 'Mantenimiento preventivo y correctivo' },
];

const DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL || 'https://admin.ultimamilla.com.ar';
const getImageUrl = (ant: any): string => {
  if (ant.Imagen && typeof ant.Imagen === 'string' && ant.Imagen.includes('-')) return `${DIRECTUS_URL}/assets/${ant.Imagen}`;
  if (ant.ImagenPrincipal && typeof ant.ImagenPrincipal === 'string' && ant.ImagenPrincipal.includes('-')) return `${DIRECTUS_URL}/assets/${ant.ImagenPrincipal}`;
  return '/images/default-antecedente.jpg';
};
---

<LayoutV4 title={seoConfig.title} description={seoConfig.description} keywords={seoConfig.keywords}>
  <section class="relative bg-um-dark pt-20 sm:pt-24 pb-8 sm:pb-12 lg:pb-16 overflow-hidden">
    <div class="absolute inset-0 opacity-40" style={`background-image: url('${sectorConfig.heroImage}'); background-position: center; background-size: cover;`}></div>
    <div class="absolute inset-0 bg-gradient-to-b from-um-dark/70 to-um-dark/90"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <nav class="flex items-center gap-2 text-xs sm:text-sm text-white/70 mb-4 flex-wrap">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a href="/sectores" class="hover:text-white transition-colors">Sectores</a>
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-white">{sectorConfig.name}</span>
      </nav>

      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12 items-center">
        <div>
          <div class="inline-flex items-center gap-2 sm:gap-3 px-4 sm:px-5 py-2 sm:py-3 bg-white/10 backdrop-blur-md rounded-full border border-white/20 mb-4 sm:mb-5">
            <div class="w-8 h-8 sm:w-10 sm:h-10 bg-gradient-to-br from-purple-400 to-purple-600 rounded-lg sm:rounded-xl flex items-center justify-center shadow-lg">
              <span class="text-lg sm:text-2xl">{sectorConfig.emoji}</span>
            </div>
            <span class="text-xs sm:text-sm font-extrabold uppercase tracking-wider text-purple-300">Sector {sectorConfig.name}</span>
          </div>
          <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl font-extrabold text-white mb-4 sm:mb-5 leading-tight">
            Tecnología para<br/>{sectorConfig.name} y Vitivinicultura
          </h1>
          <p class="text-base sm:text-lg lg:text-xl text-gray-200 max-w-xl">{sectorConfig.description}</p>
        </div>

        <div class="flex flex-wrap justify-center lg:justify-end gap-3 sm:gap-4">
          <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 sm:p-5 text-center border border-white/20 min-w-[100px] sm:min-w-[120px]">
            <div class="text-2xl sm:text-3xl font-extrabold text-white">{antecedentes.length}+</div>
            <div class="text-xs sm:text-sm text-white/70 mt-1">Proyectos</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 sm:p-5 text-center border border-white/20 min-w-[100px] sm:min-w-[120px]">
            <div class="text-2xl sm:text-3xl font-extrabold text-white">22+</div>
            <div class="text-xs sm:text-sm text-white/70 mt-1">Años</div>
          </div>
          <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 sm:p-5 text-center border border-white/20 min-w-[100px] sm:min-w-[120px]">
            <div class="text-2xl sm:text-3xl font-extrabold text-white">24/7</div>
            <div class="text-xs sm:text-sm text-white/70 mt-1">Soporte</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-10 sm:py-14 lg:py-16 border-b border-gray-100 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {valueProps.map((prop) => (
          <div class="flex items-start gap-4">
            <div class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-purple-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-um-dark mb-2">{prop.title}</h3>
              <p class="text-sm text-um-gray">{prop.description}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-10 sm:py-14 lg:py-20 bg-um-gray-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 sm:mb-12">
        <span class="text-purple-600 font-semibold text-xs sm:text-sm uppercase tracking-wider">Servicios</span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-um-dark mt-3 sm:mt-4 mb-3 sm:mb-4">Soluciones para {sectorConfig.name}</h2>
        <p class="text-sm sm:text-base text-um-gray max-w-2xl mx-auto">Tecnología especializada para la industria vitivinícola de Mendoza.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
        {serviciosRelacionados.map((servicio) => (
          <a href={`/servicios/${servicio.id}/${generateSlug(servicio.nombre)}`} class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 card-hover group">
            <div class="w-12 h-12 bg-purple-50 rounded-xl flex items-center justify-center mb-4 group-hover:bg-purple-500 transition-colors">
              <svg class="w-6 h-6 text-purple-600 group-hover:text-white transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <h3 class="font-bold text-um-dark mb-2 group-hover:text-um-primary transition-colors">{servicio.nombre}</h3>
            <p class="text-sm text-um-gray mb-4">{servicio.descripcion}</p>
            <span class="text-purple-600 font-semibold text-sm flex items-center gap-1">Ver servicio <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {antecedentes.length > 0 && (
    <section class="py-10 sm:py-14 lg:py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-8 sm:mb-12">
          <span class="text-purple-600 font-semibold text-xs sm:text-sm uppercase tracking-wider">Casos de Éxito</span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-um-dark mt-3 sm:mt-4 mb-3 sm:mb-4">Proyectos en {sectorConfig.name}</h2>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
          {antecedentes.slice(0, 6).map((ant) => (
            <a href={`/antecedentes/${ant.id}/${ant.slug}`} class="group bg-white rounded-xl overflow-hidden shadow-sm border border-gray-100 card-hover">
              <div class="aspect-video overflow-hidden bg-gray-100">
                <img src={getImageUrl(ant)} alt={ant.Titulo} class="w-full h-full object-cover group-hover:scale-110 transition-transform duration-500" loading="lazy" onerror="this.src='/images/default-antecedente.jpg'"/>
              </div>
              <div class="p-5 sm:p-6">
                <span class="text-xs font-semibold text-purple-600 uppercase tracking-wider">{ant.Area || sectorConfig.name}</span>
                <h3 class="font-bold text-um-dark mt-2 mb-2 group-hover:text-um-primary transition-colors line-clamp-2">{ant.Titulo}</h3>
                <p class="text-sm text-um-gray mb-4 line-clamp-2">{ant.Descripcion?.substring(0, 100)}...</p>
                <span class="text-purple-600 font-semibold text-sm flex items-center gap-1">Ver caso <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></span>
              </div>
            </a>
          ))}
        </div>

        <div class="text-center mt-8 sm:mt-12">
          <a href={`/antecedentes?sector=${sectorConfig.name.toLowerCase()}`} class="inline-flex items-center gap-2 px-5 sm:px-6 py-3 border-2 border-purple-500 text-purple-600 font-semibold rounded-xl hover:bg-purple-500 hover:text-white transition-colors text-sm sm:text-base min-h-[44px]">
            Ver Todos los Casos
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg>
          </a>
        </div>
      </div>
    </section>
  )}

  <section class="bg-um-dark py-10 sm:py-14 lg:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="text-purple-400 font-semibold text-xs sm:text-sm uppercase tracking-wider">Contacto</span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mt-3 sm:mt-4 mb-3 sm:mb-4">¿Necesita Soluciones para su Bodega?</h2>
      <p class="text-base sm:text-lg lg:text-xl text-gray-300 mb-6 sm:mb-8">Nuestro equipo especializado en infraestructura vitivinícola está listo para ayudarlo.</p>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
        <a href="/contacto" class="px-6 sm:px-8 py-3 sm:py-4 bg-purple-500 text-white font-bold rounded-xl hover:bg-purple-600 transition-colors shadow-lg shadow-purple-500/25 min-h-[44px] flex items-center justify-center">Solicitar Cotización</a>
        <a href="/servicios" class="px-6 sm:px-8 py-3 sm:py-4 border-2 border-white text-white font-bold rounded-xl hover:bg-white/10 transition-colors min-h-[44px] flex items-center justify-center">Ver Todos los Servicios</a>
      </div>
    </div>
  </section>
</LayoutV4>
