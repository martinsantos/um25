---
import Layout from '../layouts/Layout.astro';
import { directus, DEFAULT_IMAGE } from '../utils/directus';
import { generateSlug } from '../utils/slugUtils';

// Configuración SEO específica para Bodegas
const seoConfig = {
  title: "Tecnología para Bodegas Mendoza | Automatización Vitivinícola | ULTIMA MILLA",
  description: "Soluciones IT para bodegas vitivinícolas: infraestructura de redes, conectividad, automatización y monitoreo especializado en Mendoza y Cuyo.",
  keywords: "servicios tecnologicos bodegas, infraestructura it vitivinicola mendoza, redes bodegas cuyo, telecomunicaciones viñedos, automatizacion bodegas patagonia",
  ogImage: "/images/services/redes-comunicaciones.jpg",
  canonical: "https://ultimamilla.com.ar/bodegas",
  locale: "es_AR",
  region: "Cuyo, Patagonia, Argentina",
  author: "Ultima Milla",
  robots: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
};

// Cargar antecedentes del sector bodegas
import { antecedentesReales } from '../data/antecedentes_completos.js';
import FeaturedAntecedentes from '../components/FeaturedAntecedentes.astro';

let antecedentes = [];
let error = null;

const keywords = [
  'bodega', 'viña', 'finca', 'wines', 'vitivinicola', 'vino', 'domaine',
  'bousquet', 'norton', 'trapiche', 'catena', 'zuccardi', 'rutini',
  'enologia', 'viñedo', 'malbec', 'viticola'
];

const filterAntecedentes = (data) => {
  return data.filter(item => {
    const cliente = (item.Cliente || '').toLowerCase();
    const titulo = (item.Titulo || '').toLowerCase();
    const area = (item.Area || '').toLowerCase();
    return keywords.some(k => cliente.includes(k) || titulo.includes(k) || area.includes(k));
  }).sort((a, b) => new Date(b.Fecha || '2000-01-01') - new Date(a.Fecha || '2000-01-01'));
};

try {
  // Obtener antecedentes desde Directus
  const response = await directus.getAntecedentes({
    limit: 500,
    page: 1
  });

  if (response && response.data && response.data.length > 0) {
    antecedentes = filterAntecedentes(response.data);
    console.log(`✅ Cargados ${antecedentes.length} antecedentes de bodegas`);
  }
} catch (err) {
  console.error('Error cargando antecedentes:', err);
  error = err;
}

// Fallback a datos locales si no hay resultados de API
if (antecedentes.length === 0) {
  console.log('Usando antecedentes locales para Bodegas');
  antecedentes = filterAntecedentes(antecedentesReales);
}

// Procesar imágenes y slugs para cada antecedente
const { getAntecedenteImageUrl } = await import('../utils/directus.js');
const { generateSlug } = await import('../utils/slugUtils.js');
antecedentes = await Promise.all(
  antecedentes.map(async (item) => ({
    ...item,
    Nombre: item.Titulo || item.Nombre,
    mapeo_imagenes_completo: await getAntecedenteImageUrl(item),
    slug: generateSlug(item.Titulo || item.Nombre)
  }))
);
---

<Layout
  title={seoConfig.title}
  description={seoConfig.description}
  keywords={seoConfig.keywords}
  image={seoConfig.ogImage}
  canonical={seoConfig.canonical}
>
  <main style="background: #f5f5f5;">
    <!-- HERO BODEGAS -->
    <section style="position: relative; min-height: 350px; display: flex; align-items: center; background: linear-gradient(rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0.65)), url('https://images.unsplash.com/photo-1506377247377-2a5b3b417ebb?w=1920&q=80') center/cover; color: white;">
      <div style="max-width: 1200px; margin: 0 auto; padding: 50px 40px; width: 100%;">
        <div style="display: inline-flex; align-items: center; gap: 12px; padding: 12px 20px; background: linear-gradient(135deg, rgba(147, 51, 234, 0.3), rgba(147, 51, 234, 0.1)); border-radius: 20px; margin-bottom: 20px; border: 1px solid rgba(147, 51, 234, 0.4); backdrop-filter: blur(10px);">
          <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #9333ea, #a855f7); border-radius: 12px; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 20px rgba(147, 51, 234, 0.4);">
            <span style="font-size: 24px;">🍇</span>
          </div>
          <span style="font-size: 13px; font-weight: 800; color: #c084fc; text-transform: uppercase; letter-spacing: 1.2px;">Sector Vitivinícola</span>
        </div>

        <h1 style="font-size: 48px; font-weight: 900; margin-bottom: 20px; line-height: 1.2; color: white;">
          Tecnología para Bodegas<br/>y Vitivinicultura
        </h1>

        <p style="font-size: 18px; font-weight: 400; color: rgba(255, 255, 255, 0.9); max-width: 600px; margin-bottom: 32px; line-height: 1.6;">
          Infraestructura IT especializada para bodegas, viñedos y operaciones vitivinícolas en Mendoza.
        </p>

        <a href="#contacto" style="display: inline-block; background: #9333ea; color: white; padding: 14px 32px; border-radius: 6px; font-weight: 700; font-size: 15px; text-decoration: none; transition: all 0.3s ease;" onmouseover="this.style.background='#a855f7'" onmouseout="this.style.background='#9333ea'">
          Explorar Nuestras Soluciones
        </a>
      </div>
    </section>

    <!-- 3 CARDS SERVICIOS -->
    <section style="background: #f5f5f5; padding: 50px 40px;">
      <div style="max-width: 1200px; margin: 0 auto;">
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px;">
          <a href="/servicios/1/redes-datos" style="text-decoration: none; display: block; padding: 30px; background: #fafafa; border-radius: 8px; border-left: 4px solid #9333ea; transition: all 0.3s ease;" onmouseover="this.style.background='#f0f0f0'; this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 30px rgba(147,51,234,0.2)'" onmouseout="this.style.background='#fafafa'; this.style.transform='translateY(0)'; this.style.boxShadow='none'">
            <div style="width: 50px; height: 50px; background: #9333ea; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
              <svg style="width: 28px; height: 28px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-4m-5 0H9m0 0H5m4 0V9a1 1 0 011-1h4a1 1 0 011 1v12M9 7h6"></path>
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Redes de Datos</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Infraestructura robusta para operaciones vitivinícolas</p>
          </a>

          <a href="/servicios/2/seguridad" style="text-decoration: none; display: block; padding: 30px; background: #fafafa; border-radius: 8px; border-left: 4px solid #9333ea; transition: all 0.3s ease;" onmouseover="this.style.background='#f0f0f0'; this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 30px rgba(147,51,234,0.2)'" onmouseout="this.style.background='#fafafa'; this.style.transform='translateY(0)'; this.style.boxShadow='none'">
            <div style="width: 50px; height: 50px; background: #9333ea; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
              <svg style="width: 28px; height: 28px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Seguridad</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Protección de sistemas y datos</p>
          </a>

          <a href="/servicios/3/telecomunicaciones" style="text-decoration: none; display: block; padding: 30px; background: #fafafa; border-radius: 8px; border-left: 4px solid #9333ea; transition: all 0.3s ease;" onmouseover="this.style.background='#f0f0f0'; this.style.transform='translateY(-4px)'; this.style.boxShadow='0 10px 30px rgba(147,51,234,0.2)'" onmouseout="this.style.background='#fafafa'; this.style.transform='translateY(0)'; this.style.boxShadow='none'">
            <div style="width: 50px; height: 50px; background: #9333ea; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
              <svg style="width: 28px; height: 28px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0"></path>
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Telecomunicaciones</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Sistemas integrados para bodegas</p>
          </a>
        </div>
      </div>
    </section>

    <!-- CASOS DE ÉXITO -->
    {antecedentes.length > 0 && (
      <section style="background: #f8fafc; padding: 100px 32px; border-top: 1px solid #e2e8f0;">
        <div style="max-width: 75rem; margin: 0 auto;">
          <div style="text-align: center; margin-bottom: 72px;">
            <div style="display: inline-block; padding: 8px 20px; background: linear-gradient(135deg, #a855f7, #9333ea); border-radius: 50px; margin-bottom: 20px;">
              <span style="font-size: 13px; font-weight: 800; color: white; letter-spacing: 1px; text-transform: uppercase;">✨ Casos de Éxito</span>
            </div>
            <h2 style="font-size: clamp(36px, 5.5vw, 52px); font-weight: 900; color: #0f172a; margin-bottom: 20px; letter-spacing: -0.02em;">
              Proyectos Realizados
            </h2>
            <p style="font-size: 19px; color: #64748b; max-width: 750px; margin: 0 auto; line-height: 1.7; font-weight: 500;">
              Nuestras soluciones han impulsado la calidad y excelencia de bodegas vitivinícolas en Mendoza y todo el país.
            </p>
          </div>

          <FeaturedAntecedentes antecedentes={antecedentes} />
        </div>
      </section>
    )}

    <!-- CONTACTO -->
    <section id="contacto" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); padding: 100px 32px; position: relative; overflow: hidden;">
      <div style="position: absolute; top: -100px; right: -100px; width: 400px; height: 400px; background: radial-gradient(circle, rgba(147, 51, 234, 0.15) 0%, transparent 70%); border-radius: 50%;"></div>
      <div style="position: absolute; bottom: -150px; left: -150px; width: 500px; height: 500px; background: radial-gradient(circle, rgba(147, 51, 234, 0.1) 0%, transparent 70%); border-radius: 50%;"></div>

      <div style="max-width: 75rem; margin: 0 auto; position: relative; z-index: 10;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center;">
          <div>
            <div style="display: inline-block; padding: 8px 20px; background: rgba(147, 51, 234, 0.2); border-radius: 50px; margin-bottom: 24px; border: 1px solid rgba(147, 51, 234, 0.3);">
              <span style="font-size: 13px; font-weight: 800; color: #d8b4fe; letter-spacing: 1px; text-transform: uppercase;">📞 Contáctenos</span>
            </div>
            <h2 style="font-size: clamp(36px, 5vw, 56px); font-weight: 900; color: white; margin-bottom: 24px; line-height: 1.1; letter-spacing: -0.02em;">
              ¿Listo para Transformar Su Bodega?
            </h2>
            <p style="font-size: 18px; color: #cbd5e1; line-height: 1.8; margin-bottom: 40px; font-weight: 500;">
              Contáctenos y encontraremos la solución tecnológica perfecta para su operación vitivinícola.
            </p>
            <div style="display: flex; align-items: center; gap: 16px;">
              <div style="width: 56px; height: 56px; background: linear-gradient(135deg, #a855f7, #9333ea); border-radius: 16px; display: flex; align-items: center; justify-content: center;">
                <svg style="width: 28px; height: 28px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 011 1.21V9a2 2 0 00-2-2h-1C9.716 21 3 14.284 3 6V5z"></path>
                </svg>
              </div>
              <div>
                <p style="font-size: 14px; color: #94a3b8; font-weight: 600; margin-bottom: 4px;">Email</p>
                <p style="font-size: 18px; color: white; font-weight: 700;">contacto@ultimamilla.com.ar</p>
              </div>
            </div>
          </div>

          <div style="background: white; border-radius: 24px; padding: 48px; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
            <form action="/api/contact" method="POST" style="display: flex; flex-direction: column; gap: 24px;">
              <div>
                <label style="display: block; font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Nombre</label>
                <input type="text" name="nombre" required style="width: 100%; padding: 14px 18px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 15px; transition: all 0.3s; outline: none;" onfocus="this.style.borderColor='#9333ea'; this.style.boxShadow='0 0 0 4px rgba(147,51,234,0.1)'" onblur="this.style.borderColor='#e2e8f0'; this.style.boxShadow='none'" placeholder="Juan Pérez" />
              </div>
              <div>
                <label style="display: block; font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Empresa</label>
                <input type="text" name="empresa" style="width: 100%; padding: 14px 18px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 15px; transition: all 0.3s; outline: none;" onfocus="this.style.borderColor='#9333ea'; this.style.boxShadow='0 0 0 4px rgba(147,51,234,0.1)'" onblur="this.style.borderColor='#e2e8f0'; this.style.boxShadow='none'" placeholder="Bodega ABC" />
              </div>
              <div>
                <label style="display: block; font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Email</label>
                <input type="email" name="email" required style="width: 100%; padding: 14px 18px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 15px; transition: all 0.3s; outline: none;" onfocus="this.style.borderColor='#9333ea'; this.style.boxShadow='0 0 0 4px rgba(147,51,234,0.1)'" onblur="this.style.borderColor='#e2e8f0'; this.style.boxShadow='none'" placeholder="juan@bodega.com" />
              </div>
              <div>
                <label style="display: block; font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Mensaje</label>
                <textarea name="mensaje" required rows="4" style="width: 100%; padding: 14px 18px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 15px; transition: all 0.3s; outline: none; resize: vertical;" onfocus="this.style.borderColor='#9333ea'; this.style.boxShadow='0 0 0 4px rgba(147,51,234,0.1)'" onblur="this.style.borderColor='#e2e8f0'; this.style.boxShadow='none'" placeholder="Cuéntenos sobre su proyecto..."></textarea>
              </div>
              <button type="submit" style="width: 100%; padding: 18px; background: linear-gradient(135deg, #a855f7, #9333ea); color: white; border: none; border-radius: 12px; font-size: 16px; font-weight: 800; cursor: pointer; transition: all 0.3s; text-transform: uppercase; letter-spacing: 0.5px; box-shadow: 0 10px 30px rgba(147,51,234,0.4);" onmouseover="this.style.transform='translateY(-3px)'; this.style.boxShadow='0 14px 40px rgba(147,51,234,0.5)'" onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='0 10px 30px rgba(147,51,234,0.4)'">
                Solicitar Consultoría Ahora
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  a:focus {
    outline: 2px solid rgba(147, 51, 234, 0.5);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }
</style>
