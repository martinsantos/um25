        <div style="display: inline-flex; align-items: center; gap: 12px; padding: 12px 20px; background: linear-gradient(135deg, rgba(147, 51, 234, 0.3), rgba(147, 51, 234, 0.1)); border-radius: 20px; margin-bottom: 20px; border: 1px solid rgba(147, 51, 234, 0.4); backdrop-filter: blur(10px);">
          <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #9333ea, #a855f7); border-radius: 12px; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 20px rgba(147, 51, 234, 0.4);">
            <span style="font-size: 24px;">📦</span>
