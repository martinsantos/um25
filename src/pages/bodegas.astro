---
<<<<<<< HEAD
import Layout from '../layouts/Layout.astro';
import { directus, DEFAULT_IMAGE } from '../utils/directus';
import { generateSlug } from '../utils/slugUtils';

// Configuración SEO específica para bodegas - ULTRA OPTIMIZADA para Argentina y Mendoza
const seoConfig = {
  title: "Tecnología para Bodegas Vitivinícolas | Mendoza, Cuyo y Patagonia | ULTIMA MILLA",
  description: "Servicios tecnológicos para bodegas y sector vitivinícola en Argentina. Zona de incumbencia: Mendoza, Cuyo, Patagonia. Redes de datos, telecomunicaciones, corrientes débiles, automatización y conectividad especializada para la industria del vino.",
  keywords: "servicios tecnologicos bodegas, infraestructura it vitivinicola mendoza, redes bodegas cuyo, telecomunicaciones viñedos, corrientes debiles fincas, automatizacion bodegas patagonia, conectividad vinos",
  // ogImage: "/images/services/bodegas-hero.jpg",
  canonical: "https://ultimamilla.com.ar/bodegas",
  locale: "es_AR",
  region: "Cuyo, Patagonia, Argentina",
  author: "Ultima Milla",
  robots: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
};

// Cargar antecedentes del sector bodegas
import { antecedentesReales } from '../data/antecedentes_completos.js';
import FeaturedAntecedentes from '../components/FeaturedAntecedentes.astro';

let antecedentes = [];
let serviciosRelacionados = [];
let error = null;

const keywords = [
  'bodega', 'viña', 'finca', 'wines', 'vitivinicola', 'vino', 'domaine', 
  'bousquet', 'norton', 'trapiche', 'catena', 'zuccardi', 'rutini', 
  'enologia', 'viñedo', 'malbec'
];

const filterAntecedentes = (data) => {
  return data.filter(item => {
    const cliente = (item.Cliente || '').toLowerCase();
    const titulo = (item.Titulo || '').toLowerCase();
    const area = (item.Area || '').toLowerCase();
    return keywords.some(k => cliente.includes(k) || titulo.includes(k) || area.includes(k));
  }).sort((a, b) => new Date(b.Fecha || '2000-01-01') - new Date(a.Fecha || '2000-01-01'));
};

try {
  // Obtener antecedentes desde Directus
  const response = await directus.getAntecedentes({
    limit: 500,
    page: 1
  });

  if (response && response.data && response.data.length > 0) {
    antecedentes = filterAntecedentes(response.data);
    console.log(`✅ Cargados ${antecedentes.length} antecedentes de bodegas`);
  }
} catch (err) {
  console.error('Error cargando antecedentes:', err);
  error = err;
}

// Fallback a datos locales si no hay resultados de API
if (antecedentes.length === 0) {
  console.log('Usando antecedentes locales para Bodegas');
  antecedentes = filterAntecedentes(antecedentesReales);
}

// Limitar a 6 para la vista (ELIMINADO - Ahora se maneja en el componente con "Ver más")
// antecedentes = antecedentes.slice(0, 6);

// Servicios relacionados con el sector bodegas
serviciosRelacionados = [
  {
    id: 1,
    nombre: "Redes de Datos",
    descripcion: "Cableado estructurado y fibra óptica para bodegas",
    icon: "network",
    slug: "redes-datos"
  },
  {
    id: 2,
    nombre: "Seguridad Informática",
    descripcion: "Protección de sistemas y datos en operaciones vitivinícolas",
    icon: "shield",
    slug: "seguridad-informatica"
  },
  {
    id: 3,
    nombre: "Telecomunicaciones",
    descripcion: "Sistemas de comunicación integrados para bodegas",
    icon: "wifi",
    slug: "telecomunicaciones"
  },
  {
    id: 4,
    nombre: "Telefonía IP",
    descripcion: "Soluciones de comunicación para operaciones vitivinícolas",
    icon: "phone",
    slug: "telefonia-ip"
  },
  {
    id: 5,
    nombre: "Sistemas de Detección",
    descripcion: "Detección de incendios y alarmas para protección",
    icon: "alert",
    slug: "deteccion-incendios"
  },
  {
    id: 6,
    nombre: "Soporte Técnico 24/7",
    descripcion: "Asistencia técnica especializada para bodegas",
    icon: "support",
    slug: "soporte-tecnico"
  }
];
---

<Layout
