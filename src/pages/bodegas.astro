---
/**
 * Constructoras Sector Page - V4 Design System
 * ✨ NUEVA VERSIÓN: 100% controlado desde Directus
 */

import LayoutV4 from '../layouts/LayoutV4.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { generateSlug } from '../utils/slugUtils.js';
import { getSectorBySlug, getIconSVGPath, getAntecedentesForSector } from '../utils/sectoresHelpers.ts';
import { getFAQSchema, sectorFAQs } from '../data/sectorFAQs';

// Obtener sector desde Directus
const sectorSlug = 'bodegas';
const sectorData = await getSectorBySlug(sectorSlug);

if (!sectorData) {
  // Fallback si Directus falla
  return Astro.redirect('/sectores');
}

const {
  nombre,
  emoji,
  hero_image,
  descripcion,
  keywords,
  color_theme,
  seo_title,
  seo_description,
  seo_keywords,
  stats,
  value_props,
  servicios: serviciosRelacionados,
} = sectorData;

// Fetch antecedentes with automatic fallback to snapshots
const antecedentes = await getAntecedentesForSector(keywords, nombre);

// Map color theme to Tailwind classes
const colorMap: Record<string, any> = {
  sky: { bg: 'bg-sky-50', text: 'text-sky-600', hover: 'hover:bg-sky-500', gradient: 'from-sky-600 to-sky-700' },
  purple: { bg: 'bg-purple-50', text: 'text-purple-600', hover: 'hover:bg-purple-500', gradient: 'from-purple-600 to-purple-700' },
  blue: { bg: 'bg-blue-50', text: 'text-blue-600', hover: 'hover:bg-blue-500', gradient: 'from-blue-600 to-blue-700' },
  emerald: { bg: 'bg-emerald-50', text: 'text-emerald-600', hover: 'hover:bg-emerald-500', gradient: 'from-emerald-600 to-emerald-700' },
  amber: { bg: 'bg-amber-50', text: 'text-amber-600', hover: 'hover:bg-amber-500', gradient: 'from-amber-600 to-amber-700' },
  indigo: { bg: 'bg-indigo-50', text: 'text-indigo-600', hover: 'hover:bg-indigo-500', gradient: 'from-indigo-600 to-indigo-700' },
  cyan: { bg: 'bg-cyan-50', text: 'text-cyan-600', hover: 'hover:bg-cyan-500', gradient: 'from-cyan-600 to-cyan-700' },
  orange: { bg: 'bg-orange-50', text: 'text-orange-600', hover: 'hover:bg-orange-500', gradient: 'from-orange-600 to-orange-700' },
  red: { bg: 'bg-red-50', text: 'text-red-600', hover: 'hover:bg-red-500', gradient: 'from-red-600 to-red-700' },
};

const colors = colorMap[color_theme] || colorMap.amber;
const faqSchema = getFAQSchema(sectorSlug);
---

<LayoutV4 title={seo_title} description={seo_description} keywords={seo_keywords} image={hero_image} structuredData={faqSchema}>
  <section class="relative bg-um-dark pt-20 sm:pt-24 pb-8 sm:pb-12 lg:pb-16 overflow-hidden">
    <div class="absolute inset-0 opacity-40" style={`background-image: url('${hero_image}'); background-position: center; background-size: cover;`}></div>
    <div class="absolute inset-0 bg-gradient-to-b from-um-dark/70 to-um-dark/90"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-2 mb-4 sm:mb-6">
        <a href="/" class="text-white/60 hover:text-white text-xs sm:text-sm transition-colors">Inicio</a>
        <svg class="w-4 h-4 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <a href="/sectores" class="text-white/60 hover:text-white text-xs sm:text-sm transition-colors">Sectores</a>
        <svg class="w-4 h-4 text-white/40" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg>
        <span class="text-white text-xs sm:text-sm">{nombre}</span>
      </div>

      <div class="max-w-3xl">
        <div class="text-4xl sm:text-5xl mb-3" aria-hidden="true">{emoji}</div>
        <h1 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-bold text-white leading-tight mb-4 sm:mb-6">
          Tecnología para {nombre}
        </h1>
        <p class="text-base sm:text-lg lg:text-xl text-white/90 mb-6 sm:mb-8">{descripcion}</p>
        <div class="flex flex-wrap items-center gap-3 sm:gap-4">
          {stats.map((stat: any) => (
            <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 sm:p-5 text-center border border-white/20 min-w-[100px] sm:min-w-[120px]">
              <div class="text-2xl sm:text-3xl font-extrabold text-white">{stat.value}</div>
              <div class="text-xs sm:text-sm text-white/70 mt-1">{stat.label}</div>
            </div>
          ))}
          <div class="bg-white/10 backdrop-blur-sm rounded-xl p-4 sm:p-5 text-center border border-white/20 min-w-[100px] sm:min-w-[120px]">
            <div class="text-2xl sm:text-3xl font-extrabold text-white">{antecedentes.length}+</div>
            <div class="text-xs sm:text-sm text-white/70 mt-1">Proyectos</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="py-10 sm:py-14 lg:py-16 border-b border-gray-100 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 sm:gap-8">
        {value_props && value_props.map((prop: any) => (
          <div class="flex items-start gap-4">
            <div class={`w-12 h-12 ${colors.bg} rounded-xl flex items-center justify-center flex-shrink-0`}>
              <svg class={`w-6 h-6 ${colors.text}`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d={getIconSVGPath(prop.icono)}/>
              </svg>
            </div>
            <div>
              <h3 class="font-bold text-um-dark mb-2">{prop.titulo}</h3>
              <p class="text-sm text-um-gray">{prop.descripcion}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="py-10 sm:py-14 lg:py-20 bg-um-gray-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 sm:mb-12">
        <span class={`${colors.text} font-semibold text-xs sm:text-sm uppercase tracking-wider`}>Servicios</span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-um-dark mt-3 sm:mt-4 mb-3 sm:mb-4">Soluciones para {nombre}</h2>
        <p class="text-sm sm:text-base text-um-gray max-w-2xl mx-auto">Tecnología especializada para el sector.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
        {serviciosRelacionados && serviciosRelacionados.map((servicio: any) => (
          <a href={`/servicios/${servicio.id}/${generateSlug(servicio.nombre)}`} class="bg-white rounded-xl p-6 shadow-sm border border-gray-100 card-hover group">
            <div class={`w-12 h-12 ${colors.bg} rounded-xl flex items-center justify-center mb-4 group-${colors.hover} transition-colors`}>
              <svg class={`w-6 h-6 ${colors.text} group-hover:text-white transition-colors`} fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/>
              </svg>
            </div>
            <h3 class="font-bold text-um-dark mb-2 group-hover:text-um-primary transition-colors">{servicio.nombre}</h3>
            <p class="text-sm text-um-gray mb-4">{servicio.descripcion}</p>
            <span class={`${colors.text} font-semibold text-sm flex items-center gap-1`}>Ver servicio <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/></svg></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  {antecedentes.length > 0 && (
    <section class="py-10 sm:py-14 lg:py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-8 sm:mb-12">
          <span class={`${colors.text} font-semibold text-xs sm:text-sm uppercase tracking-wider`}>Casos de Éxito</span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-um-dark mt-3 sm:mt-4 mb-3 sm:mb-4">Proyectos en {nombre}</h2>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 lg:gap-8">
          {antecedentes.map((ant) => (
            <ProjectCard
              id={String(ant.id)}
              titulo={ant.Titulo || ant.Nombre || 'Proyecto'}
              cliente={ant.Cliente || ''}
              descripcion={ant.Descripcion || ''}
              fecha={ant.Fecha || new Date().toISOString()}
              area={ant.Area || ant.Unidad_de_negocio || nombre}
              servicio={ant.Unidad_de_negocio || nombre}
              imagen={ant.imageUrl}
              slug={ant.slug}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  {sectorFAQs[sectorSlug] && sectorFAQs[sectorSlug].length > 0 && (
    <section class="py-10 sm:py-14 lg:py-20 bg-white border-t border-gray-100">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-8 sm:mb-12">
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-um-dark">Preguntas Frecuentes</h2>
        </div>
        <div class="space-y-4">
          {sectorFAQs[sectorSlug].map((faq: any) => (
            <details class="group bg-gray-50 rounded-xl border border-gray-200 overflow-hidden">
              <summary class="flex items-center justify-between p-5 sm:p-6 cursor-pointer font-semibold text-um-dark hover:bg-gray-100 transition-colors">
                <span class="pr-4">{faq.question}</span>
                <svg class="w-5 h-5 shrink-0 text-gray-400 group-open:rotate-180 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
              </summary>
              <div class="px-5 sm:px-6 pb-5 sm:pb-6 text-um-gray leading-relaxed">{faq.answer}</div>
            </details>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class={`py-10 sm:py-14 lg:py-16 bg-gradient-to-br ${colors.gradient}`}>
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-4 sm:mb-6">¿Listo para transformar su infraestructura tecnológica?</h2>
      <p class="text-base sm:text-lg text-white/90 mb-6 sm:mb-8 max-w-2xl mx-auto">Contactenos hoy para una consultoría gratuita.</p>
      <a href="/contacto" class="inline-block px-6 sm:px-8 py-3 sm:py-4 bg-white text-um-dark rounded-lg font-bold shadow-xl hover:shadow-2xl transition-all hover:scale-105">Solicitar Consultoría Gratuita</a>
    </div>
  </section>
</LayoutV4>

<style>
  .card-hover {
    transition: all 0.3s ease;
  }
  .card-hover:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0,0,0,0.1);
  }
</style>
