  image={seoConfig.ogImage}
  canonical={seoConfig.canonical}
>
  <main style="background: #f5f5f5;">
    <!-- HERO EXACTO DEL BOCETO -->
    <section style="position: relative; min-height: 350px; display: flex; align-items: center; background: linear-gradient(rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0.65)), url('https://images.unsplash.com/photo-1506377247377-2a5b3b417ebb?w=1920&q=80') center/cover; color: white;">
      <div style="max-width: 1200px; margin: 0 auto; padding: 50px 40px; width: 100%;">
