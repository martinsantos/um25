---
import LayoutV4 from '../layouts/LayoutV4.astro';
import SectorTemplateEditorial from '../components/templates/SectorTemplateEditorial.astro';
import SectorTemplateAtlas from '../components/templates/SectorTemplateAtlas.astro';
import { sectorVisualOrder, sectorVisualSystem } from '../data/sectorVisualSystem';
import { getDevTemplateVariant } from '../utils/templateVariant';
import { isReplicaIdenticalCopy } from '../utils/replicaProdCopy';
import {
  buildSectorStrategicLinkGroups,
  buildStrategicWebPageStructuredData,
} from '../data/strategicLinkGraph';

const sectores = sectorVisualOrder.map((slug) => sectorVisualSystem[slug]);
const templateVariant = isReplicaIdenticalCopy()
  ? 'editorial'
  : (getDevTemplateVariant(Astro.url, import.meta.env.DEV) ?? 'editorial');
const requestedSector = new URL(Astro.request.url).searchParams.get('sector') || '';
const sectorFilter = sectores.some((sector) => sector.slug === requestedSector) ? requestedSector : '';
const compactSectorRailLabels: Record<string, string> = {
  gobiernosectorpublico: 'Gobierno',
  'seguridad-electronica': 'Seguridad'
};
const sectorFilterOptions = [{ id: '', label: 'Todos' }].concat(
  sectores.map((sector) => ({ id: sector.slug, label: compactSectorRailLabels[sector.slug] ?? sector.label }))
);
const sectorIndexStrategicLinkGroups = buildSectorStrategicLinkGroups({
  currentPath: '/sectores',
  sectorName: 'Sectores UMSA',
  title: 'Infraestructura IT por sector',
  summary: 'Soluciones tecnológicas por industria con evidencia operativa.',
  text: sectores.map((sector) => `${sector.label} ${sector.summary} ${sector.operatingNeed} ${sector.services.join(' ')}`).join(' '),
});

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Soluciones IT por sector',
    description:
      'Soluciones tecnológicas por industria para aeropuertos, bodegas, gobierno, salud, construcción, industria, minería, seguridad electrónica y software.',
    url: 'https://www.ultimamilla.com.ar/sectores'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: sectores.map((sector, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: sector.label,
      url: `https://www.ultimamilla.com.ar/${sector.slug}`
    }))
  },
  buildStrategicWebPageStructuredData({
    url: 'https://www.ultimamilla.com.ar/sectores',
    name: 'Infraestructura IT por sector',
    description: 'Soluciones tecnológicas por industria con evidencia operativa.',
    groups: sectorIndexStrategicLinkGroups,
  })
];
---

<LayoutV4
  title="Infraestructura IT por sector, con evidencia operativa | ULTIMA MILLA"
  description="Soluciones IT por industria: infraestructura, seguridad electrónica, telecomunicaciones, software y soporte para aeropuertos, bodegas, gobierno, salud, construcción, industria y minería."
  keywords="soluciones IT por sector, tecnologia para aeropuertos, bodegas, gobierno, salud, construccion, industria, mineria, seguridad electronica, software empresarial"
  structuredData={structuredData}
>
  {
    templateVariant === 'atlas' ? (
      <SectorTemplateAtlas
        mode="index"
        sectors={sectores}
        sectorFilter={sectorFilter}
        sectorFilterOptions={sectorFilterOptions}
      />
    ) : (
      <SectorTemplateEditorial
        mode="index"
        sectors={sectores}
        sectorFilter={sectorFilter}
        sectorFilterOptions={sectorFilterOptions}
      />
    )
  }
</LayoutV4>
