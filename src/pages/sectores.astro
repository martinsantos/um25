---
/**
 * Sectores - V4 Design System
 * Industry sectors page with 9 sector cards
 */

import LayoutV4 from '../layouts/LayoutV4.astro';
import HeroPageV4 from '../components/v4/HeroPageV4.astro';

const sectores = [
  {
    slug: 'aeropuertos',
    icon: 'plane',
    title: 'Aeropuertos',
    description: 'Sistemas críticos de comunicación, CCTV de alta seguridad, control de accesos y redes de misión crítica para operaciones aeroportuarias 24/7.',
    projects: '15+',
    gradient: 'from-sky-400 to-sky-600',
    hoverColor: 'hover:text-sky-600',
  },
  {
    slug: 'bodegas',
    icon: 'wine',
    title: 'Bodegas',
    description: 'Automatización de líneas de producción, monitoreo de tanques, control de temperatura y sistemas de trazabilidad para la industria vitivinícola.',
    projects: '45+',
    gradient: 'from-purple-400 to-purple-600',
    hoverColor: 'hover:text-purple-600',
  },
  {
    slug: 'gobiernosectorpublico',
    icon: 'landmark',
    title: 'Gobierno y Sector Público',
    description: 'Infraestructura para municipios, data centers gubernamentales, sistemas de videovigilancia urbana y redes WAN interinstitucionales.',
    projects: '80+',
    gradient: 'from-emerald-400 to-emerald-600',
    hoverColor: 'hover:text-emerald-600',
  },
  {
    slug: 'salud',
    icon: 'heart',
    title: 'Salud',
    description: 'Redes hospitalarias de alta disponibilidad, sistemas de llamado enfermera, CCTV en áreas críticas e integración con equipamiento médico.',
    projects: '35+',
    gradient: 'from-green-400 to-green-600',
    hoverColor: 'hover:text-green-600',
  },
  {
    slug: 'constructoras',
    icon: 'building',
    title: 'Construcción',
    description: 'Pre-cableado estructurado para edificios, sistemas de automatización de edificios inteligentes y soluciones para obra en construcción.',
    projects: '60+',
    gradient: 'from-amber-400 to-amber-600',
    hoverColor: 'hover:text-amber-600',
  },
  {
    slug: 'industria',
    icon: 'factory',
    title: 'Industria',
    description: 'Redes industriales robustas, cableado en ambientes hostiles, integración IT/OT y soluciones de conectividad para plantas de producción.',
    projects: '50+',
    gradient: 'from-slate-400 to-slate-600',
    hoverColor: 'hover:text-slate-600',
  },
  {
    slug: 'mineria',
    icon: 'mountain',
    title: 'Minería',
    description: 'Comunicaciones en zonas remotas, radioenlaces de largo alcance, sistemas anti-intrusión perimetral y redes para campamentos mineros.',
    projects: '25+',
    gradient: 'from-orange-400 to-orange-600',
    hoverColor: 'hover:text-orange-600',
  },
  {
    slug: 'seguridad-electronica',
    icon: 'shield',
    title: 'Seguridad Electrónica',
    description: 'CCTV analítico con IA, control de accesos biométrico, detección perimetral y centros de monitoreo profesionales.',
    projects: '120+',
    gradient: 'from-cyan-400 to-cyan-600',
    hoverColor: 'hover:text-cyan-600',
  },
  {
    slug: 'software',
    icon: 'monitor',
    title: 'Desarrollo de Software',
    description: 'Sistemas a medida, aplicaciones web y móviles, integraciones API, automatización de procesos y consultoría tecnológica.',
    projects: '40+',
    gradient: 'from-indigo-400 to-indigo-600',
    hoverColor: 'hover:text-indigo-600',
  },
];

const stats = [
  { value: '469+', label: 'Proyectos Totales' },
  { value: '9', label: 'Industrias Atendidas' },
  { value: '22+', label: 'Años de Experiencia' },
  { value: '100%', label: 'Satisfacción' },
];

// SVG paths matching homepage icons exactly
const sectorIconPaths: Record<string, string> = {
  plane: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>',
  wine: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 22h8M12 11v11M5.5 3h13l-1.6 7.2a4 4 0 01-3.9 3.2h-2a4 4 0 01-3.9-3.2L5.5 3z"/>',
  building: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>',
  heart: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>',
  landmark: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"/>',
  monitor: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>',
  mountain: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z"/>',
  factory: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>',
  shield: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>',
};
---

<LayoutV4
  title="Sectores | ULTIMA MILLA - Soluciones por Industria"
  description="Conocemos los desafíos específicos de cada sector. Nuestra experiencia nos permite ofrecer soluciones tecnológicas especializadas para aeropuertos, bodegas, gobierno, salud, construcción, industria, minería y más."
  keywords="sectores industria tecnologia, aeropuertos, bodegas vitivinicolas, gobierno sector publico, salud hospitales, construccion edificios, industria mineria, seguridad electronica, software a medida"
>
  <!-- HERO SECTION -->
  <section class="bg-um-dark pt-4 sm:pt-6 pb-6 sm:pb-10 lg:pb-12">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-sm text-gray-400 mb-3 sm:mb-4" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <svg class="w-4 h-4 text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
        <span class="text-white">Sectores</span>
      </nav>

      <div class="grid lg:grid-cols-2 gap-8 lg:gap-12">
        <div>
          <span class="inline-flex items-center gap-2 px-3 sm:px-4 py-1.5 sm:py-2 bg-um-primary/20 text-um-primary-light rounded-full text-xs sm:text-sm font-semibold mb-4 sm:mb-6">
            <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10"/>
            </svg>
            Industrias
          </span>
          <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-5xl xl:text-6xl font-extrabold text-white mb-4 sm:mb-6 leading-tight">
            Soluciones por<br>
            <span class="text-um-primary-light">Industria</span>
          </h1>
          <p class="text-base sm:text-lg lg:text-xl text-gray-300 max-w-xl">
            Conocemos los desafíos específicos de cada sector. Nuestra experiencia nos permite ofrecer soluciones especializadas que realmente funcionan.
          </p>
        </div>

        <!-- Hero Icons Grid (hidden on mobile) -->
        <div class="hidden lg:grid grid-cols-3 gap-4">
          {sectores.map((sector) => (
            <a href={`/${sector.slug}`} class="bg-white/5 border border-white/10 rounded-xl p-4 text-center hover:bg-white/10 transition-colors">
              <svg class="w-8 h-8 text-um-primary-light mx-auto mb-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={sectorIconPaths[sector.icon]} />
              <div class="text-white text-sm font-medium">{sector.title}</div>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- SECTORS GRID -->
  <section class="py-10 sm:py-14 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
        {sectores.map((sector) => (
          <a
            href={`/${sector.slug}`}
            class="sector-card bg-white rounded-2xl overflow-hidden shadow-lg border border-gray-100 group"
          >
            <div class={`h-40 sm:h-48 bg-gradient-to-br ${sector.gradient} flex items-center justify-center relative`}>
              <svg class="w-16 h-16 sm:w-20 sm:h-20 text-white/90" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={sectorIconPaths[sector.icon]} />
              <div class="absolute bottom-3 sm:bottom-4 left-3 sm:left-4 inline-flex items-center gap-2 px-2.5 sm:px-3 py-1 sm:py-1.5 bg-white/20 backdrop-blur-sm rounded-full border border-white/30">
                <span class="text-[10px] sm:text-xs font-bold text-white uppercase tracking-wider">{sector.projects} proyectos</span>
              </div>
            </div>
            <div class="p-4 sm:p-6">
              <h3 class={`text-lg sm:text-xl font-bold text-um-dark mb-2 sm:mb-3 group-hover:text-um-primary transition-colors`}>
                {sector.title}
              </h3>
              <p class="text-um-gray text-sm mb-3 sm:mb-4 line-clamp-3">
                {sector.description}
              </p>
              <div class="flex items-center gap-2 text-um-primary font-semibold text-sm">
                Ver soluciones
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- STATS SECTION -->
  <section class="bg-um-primary-bg py-10 sm:py-14 lg:py-20">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-8 sm:mb-12">
        <h2 class="text-2xl sm:text-3xl font-bold text-um-dark mb-3 sm:mb-4">Experiencia Multisectorial</h2>
        <p class="text-sm sm:text-base text-um-gray max-w-2xl mx-auto">
          Nuestra experiencia en múltiples industrias nos permite aplicar las mejores prácticas de cada sector a todos nuestros proyectos.
        </p>
      </div>
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 lg:gap-8">
        {stats.map((stat) => (
          <div class="text-center">
            <div class="text-3xl sm:text-4xl md:text-5xl font-extrabold text-um-primary">{stat.value}</div>
            <div class="text-sm sm:text-base text-um-gray mt-1 sm:mt-2">{stat.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA SECTION -->
  <section class="bg-um-dark py-10 sm:py-14 lg:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-3 sm:mb-4">¿No Encuentra su Industria?</h2>
      <p class="text-base sm:text-lg lg:text-xl text-gray-300 mb-6 sm:mb-8">
        Contáctenos. Nuestra experiencia nos permite adaptarnos a cualquier sector.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
        <a
          href="/contacto"
          class="px-6 sm:px-8 py-3 sm:py-4 bg-um-accent text-white font-bold rounded-xl hover:bg-um-accent-dark transition-colors shadow-lg shadow-um-accent/25 min-h-[44px] flex items-center justify-center"
        >
          Contactar Ahora
        </a>
        <a
          href="/antecedentes"
          class="px-6 sm:px-8 py-3 sm:py-4 border-2 border-white text-white font-bold rounded-xl hover:bg-white/10 transition-colors min-h-[44px] flex items-center justify-center"
        >
          Ver Todos los Casos
        </a>
      </div>
    </div>
  </section>
</LayoutV4>

<style>
  .sector-card {
    transition: all 0.3s ease;
  }
  .sector-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 25px 50px rgba(0,0,0,0.15);
  }
</style>
