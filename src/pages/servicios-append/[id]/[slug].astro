---
// Volumetric Premium Service Page (Refined v3)
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import { generateSlug } from '../../../utils/slugUtils';
import { serviciosPorId } from '../../../data/servicios_reales_db.js';
import { antecedentesReales } from '../../../data/antecedentes_completos.js';
import { getAntecedenteImageUrl } from '../../../utils/directus';

const PUBLIC_DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL || 'http://directus:8055';
const DIRECTUS_TOKEN = import.meta.env.PUBLIC_DIRECTUS_TOKEN || 'k6P8LAY8_x_y1miB_KTlWnysCnx2Abky';

const { id, slug } = Astro.params;
let servicio = null;

// Fetch from Directus
try {
  const url = `${PUBLIC_DIRECTUS_URL}/items/Servicios/${id}?fields=*`;
  const response = await fetch(url, {
    headers: { Authorization: `Bearer ${DIRECTUS_TOKEN}` }
  });
  if (response.ok) {
    const data = await response.json();
    servicio = data.data;
  }
} catch (error) {
  console.error('Error fetching servicio:', error);
}

// Fallback to local
if (!servicio) {
  servicio = serviciosPorId[parseInt(id)];
}

if (!servicio) {
  return Astro.redirect('/404');
}

const expectedSlug = generateSlug(servicio.Titulo || servicio.Nombre || servicio.title);
if (slug !== expectedSlug) {
  return Astro.redirect(`/servicios-append/${id}/${expectedSlug}`);
}

// Mapping for Volumetric Images
const imageMapping: Record<string, string> = {
  'ciberseguridad': '/images/services/ciberseguridad-volumetric.png',
  'seguridad': '/images/services/ciberseguridad-volumetric.png',
  'desarrollo': '/images/services/desarrollo-software-volumetric.png',
  'software': '/images/services/desarrollo-software-volumetric.png',
  'infraestructura': '/images/services/infraestructura-redes-volumetric.png',
  'redes': '/images/services/infraestructura-redes-volumetric.png',
  'consultoria': '/images/services/consultoria-it-volumetric.png', 
  'consultoría': '/images/services/consultoria-it-volumetric.png', 
  'transformacion': '/images/services/consultoria-it-volumetric.png',
  'transformación': '/images/services/consultoria-it-volumetric.png',
  'soporte': '/images/services/soporte-tecnico-volumetric.png',
  'mesa': '/images/services/soporte-tecnico-volumetric.png',
};

const serviceName = servicio.Nombre || servicio.Titulo || servicio.title || 'Servicio';
const serviceArea = servicio.Area || 'IT';
const serviceDescription = servicio.Descripcion || 'Soluciones tecnológicas profesionales para empresas.';

const getHeroImage = () => {
  const tituloLower = (serviceName || '').toLowerCase();
  for (const [key, value] of Object.entries(imageMapping)) {
    if (tituloLower.includes(key)) return value;
  }
  return '/images/antecedentes-hero-bg.jpg';
};

const heroImageUrl = getHeroImage();

// Parse arrays safely
const serviciosDetalle = servicio.Servicios_Detalle 
  ? (Array.isArray(servicio.Servicios_Detalle) ? servicio.Servicios_Detalle : String(servicio.Servicios_Detalle).split(',').map((s: string) => s.trim()))
  : [];

const caracteristicas = servicio.Caracteristicas 
  ? (Array.isArray(servicio.Caracteristicas) ? servicio.Caracteristicas : String(servicio.Caracteristicas).split(',').map((c: string) => c.trim()))
  : [];

// Related antecedentes
const relatedAntecedentes = antecedentesReales
  .filter((a: any) => a.Area === serviceArea || a.Sector === serviceArea)
  .slice(0, 3);

const relatedWithImages = await Promise.all(relatedAntecedentes.map(async (item: any) => ({
  ...item,
  imageUrl: await getAntecedenteImageUrl(item),
  slug: `${item.id}/${generateSlug(item.Titulo)}`
})));

// FAQ
const faqs = [
  {
    q: `¿Qué incluye el servicio de ${serviceName.split('|')[0].trim()}?`,
    a: serviceDescription
  },
  {
    q: `¿En qué zonas geográficas operan?`,
    a: `Prestamos servicios en Mendoza, todo Cuyo (San Juan, San Luis) y la Patagonia argentina. Soporte remoto a nivel nacional.`
  },
  {
    q: `¿Cuánto tiempo lleva la implementación?`,
    a: `Los tiempos varían según complejidad. Típicamente entre 2 semanas y 3 meses. Evaluación inicial gratuita.`
  },
  {
    q: `¿Ofrecen soporte post-implementación?`,
    a: `Sí, brindamos soporte técnico 24/7 con mesa de ayuda, mantenimiento preventivo y correctivo.`
  }
];

// SEO
const seoTitle = `${serviceName} | Servicios IT Mendoza | ULTIMA MILLA`;
const seoDescription = `${serviceDescription.substring(0, 150)}...`;
const canonicalUrl = `https://ultimamilla.com.ar/servicios-append/${id}/${slug}`;

const schemaService = {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": serviceName,
  "description": serviceDescription,
  "provider": { "@type": "Organization", "name": "ULTIMA MILLA" },
  "areaServed": ["Mendoza", "Cuyo", "Patagonia"]
};

// Form script
const formScript = `
  document.getElementById('service-contact-form').addEventListener('submit', function(e) {
    e.preventDefault();
    const formData = new FormData(this);
    const data = Object.fromEntries(formData);
    const subject = encodeURIComponent(\`Consulta de Servicio: ${serviceName}\`);
    const body = encodeURIComponent(\`Hola, me interesa el servicio ${serviceName}.\\n\\nMis datos:\\nNombre: \${data.nombre}\\nEmpresa: \${data.empresa}\\nConsulta: \${data.mensaje}\`);
    window.location.href = \`mailto:consultas@ultimamilla.com.ar?subject=\${subject}\&body=\${body}\`;
  });
`;

---

<Layout title={seoTitle} description={seoDescription} canonical={canonicalUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(schemaService)}></script>

  <!-- HERO SECTION: 100% Solid White Integration (Anti-Box) -->
  <section class="relative bg-white pt-32 pb-24 md:pb-32 overflow-hidden border-b border-slate-100">
    <!-- No background elements here to ensure perfect blending with PNG/White BG -->
    
    <div class="container mx-auto px-4 md:px-6 relative z-10">
      <div class="flex flex-col lg:flex-row items-center lg:items-start">
        
        <!-- Left: Text Content (Safe Zone) -->
        <div class="w-full lg:w-1/2 space-y-8 animate-fade-in-up">
          <div class="inline-flex items-center gap-2 px-3 py-1 bg-red-50 text-red-600 rounded-full text-xs font-bold tracking-widest uppercase border border-red-100">
            <span class="w-2 h-2 rounded-full bg-red-600 animate-pulse"></span>
            {serviceArea} Solutions
          </div>
          
          <h1 class="text-4xl md:text-5xl lg:text-7xl font-black text-slate-900 leading-[1.1] tracking-tighter">
            {serviceName.split('|')[0].trim()}
            <span class="block text-red-600 mt-2">
              Nano Precision
            </span>
          </h1>
          
          <p class="text-xl text-slate-600 leading-relaxed max-w-xl font-medium">
            {serviceDescription}
          </p>

          <div class="flex flex-wrap gap-4 pt-6">
            <a href="#contacto" class="btn btn-primary shadow-red-600/20 shadow-2xl px-10 py-4 rounded-xl font-black text-lg transform hover:-translate-y-1 transition-all">
              Solicitar Propuesta
            </a>
            <a href="#detalles" class="px-8 py-4 rounded-xl text-slate-500 font-bold hover:bg-slate-50 transition-all">
              Saber más
            </a>
          </div>

          <!-- Trust Indicators -->
          <div class="pt-12 border-t border-slate-100 flex gap-10">
            <div>
              <div class="text-3xl font-black text-slate-900">22+</div>
              <div class="text-[10px] text-slate-400 uppercase font-bold tracking-widest">Años</div>
            </div>
            <div>
              <div class="text-3xl font-black text-slate-900">460+</div>
              <div class="text-[10px] text-slate-400 uppercase font-bold tracking-widest">Éxitos</div>
            </div>
            <div>
              <div class="text-3xl font-black text-slate-900">24/7</div>
              <div class="text-[10px] text-slate-400 uppercase font-bold tracking-widest">SLA</div>
            </div>
          </div>
        </div>

        <!-- Right: Volumetric Asset (Page-Stick Mode) -->
        <div class="w-full lg:absolute lg:right-[-10%] lg:top-1/2 lg:-translate-y-1/2 lg:w-[60%] mt-12 lg:mt-0 pointer-events-none select-none">
          <div class="relative flex justify-center items-center h-full">
            <!-- Subtle Radial Glow (very faint to avoid box detection) -->
            <div class="absolute w-[80%] h-[80%] bg-red-500/[0.02] blur-[150px] rounded-full"></div>
            
            <img 
              src={heroImageUrl} 
              alt={serviceName}
              class="relative z-20 w-full h-auto max-w-[900px] object-contain drop-shadow-[0_60px_100px_rgba(0,0,0,0.1)]"
              style="mix-blend-mode: multiply; filter: contrast(1.05) saturate(1.1);"
            />
            
            <!-- Shadow purely on the white floor -->
            <div class="absolute bottom-[5%] left-1/2 -translate-x-1/2 w-1/2 h-8 bg-slate-900/[0.03] blur-3xl rounded-full"></div>
          </div>
        </div>

      </div>
    </div>
  </section>

  <!-- INFO & FORM SECTION -->
  <section id="detalles" class="py-20 bg-slate-50 border-t border-slate-200">
    <div class="container mx-auto px-4 md:px-6">
      
      <div class="grid lg:grid-cols-[1fr_400px] gap-12">
        
        <!-- Main Content -->
        <main class="space-y-12">
          
          <!-- Servicios Incluidos (Red Bullets) -->
          {serviciosDetalle.length > 0 && (
            <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-100">
              <h2 class="text-2xl font-bold text-slate-900 mb-6 flex items-center gap-3">
                <span class="w-10 h-10 rounded-lg bg-red-50 text-red-600 flex items-center justify-center">
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
                </span>
                Servicios Incluidos
              </h2>
              <div class="grid md:grid-cols-2 gap-4">
                {serviciosDetalle.map((item: string | { nombre?: string }) => (
                  <div class="flex items-start gap-3">
                    <span class="w-1.5 h-1.5 rounded-full bg-red-600 mt-2 flex-shrink-0 shadow-sm shadow-red-200"></span>
                    <span class="text-slate-600 font-medium">{typeof item === 'string' ? item : item.nombre || String(item)}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- Beneficios / Características -->
          {caracteristicas.length > 0 && (
            <div class="bg-white rounded-2xl p-8 shadow-sm border border-slate-100">
              <h2 class="text-2xl font-bold text-slate-900 mb-6">¿Por qué este servicio?</h2>
              <div class="space-y-4">
                {caracteristicas.map((car: string | { nombre?: string }) => (
                  <div class="flex items-center gap-4 p-4 rounded-xl bg-slate-50 border border-slate-100 group hover:border-red-200 transition-colors">
                    <div class="w-8 h-8 rounded-full bg-white text-red-600 flex items-center justify-center shadow-sm font-bold border border-slate-100 group-hover:bg-red-600 group-hover:text-white transition-colors">
                      ✓
                    </div>
                    <span class="text-slate-700 font-medium">{typeof car === 'string' ? car : car.nombre || String(car)}</span>
                  </div>
                ))}
              </div>
            </div>
          )}

          <!-- FAQ Accordion -->
          <div class="space-y-4">
            <h2 class="text-2xl font-bold text-slate-900 mb-2">Preguntas Frecuentes</h2>
            {faqs.map((faq) => (
              <details class="group bg-white border border-slate-200 rounded-xl overflow-hidden">
                <summary class="flex items-center justify-between p-5 cursor-pointer list-none hover:bg-slate-50 transition-colors">
                  <span class="font-semibold text-slate-800 pr-4">{faq.q}</span>
                  <span class="text-slate-400 group-open:text-red-600 transition-colors">
                    <svg class="w-6 h-6 group-open:rotate-180 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
                  </span>
                </summary>
                <div class="px-5 pb-5 pt-0 text-slate-600 leading-relaxed">
                  {faq.a}
                </div>
              </details>
            ))}
          </div>

        </main>

        <!-- Sidebar: Sticky Form -->
        <aside class="lg:sticky lg:top-24 h-fit space-y-8">
          
          <!-- Contact Form Card -->
          <div id="contacto" class="bg-white p-6 md:p-8 rounded-2xl shadow-xl border border-slate-100 relative overflow-hidden">
            <div class="absolute top-0 right-0 w-24 h-24 bg-red-50 rounded-bl-full -mr-4 -mt-4"></div>
            
            <h3 class="text-xl font-bold text-slate-900 mb-2 relative z-10">Solicitar Presupuesto</h3>
            <p class="text-sm text-slate-500 mb-6 relative z-10">Respuesta garantizada en &lt; 30 min</p>
            
            <form id="service-contact-form" class="space-y-4 relative z-10">
              <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wide mb-1">Nombre</label>
                <input type="text" name="nombre" required class="w-full px-4 py-3 rounded-lg bg-slate-50 border border-slate-200 focus:border-red-500 focus:ring-2 focus:ring-red-200 outline-none transition-all" placeholder="Su nombre" />
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wide mb-1">Empresa</label>
                <input type="text" name="empresa" class="w-full px-4 py-3 rounded-lg bg-slate-50 border border-slate-200 focus:border-red-500 focus:ring-2 focus:ring-red-200 outline-none transition-all" placeholder="Nombre de su organización" />
              </div>
              <div>
                <label class="block text-xs font-bold text-slate-500 uppercase tracking-wide mb-1">Consulta</label>
                <textarea name="mensaje" required rows="3" class="w-full px-4 py-3 rounded-lg bg-slate-50 border border-slate-200 focus:border-red-500 focus:ring-2 focus:ring-red-200 outline-none transition-all" placeholder={`Me interesa el servicio de ${serviceName}...`}></textarea>
              </div>
              
              <button type="submit" class="w-full py-4 bg-slate-900 hover:bg-black text-white font-bold rounded-lg shadow-lg hover:shadow-slate-200/50 transform hover:-translate-y-0.5 transition-all flex items-center justify-center gap-2">
                <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" /></svg>
                <span>Enviar Consulta por Email</span>
              </button>
            </form>
          </div>

          <!-- Feature Badge -->
          <div class="bg-gray-900 rounded-xl p-6 text-white text-center shadow-xl">
            <div class="w-12 h-12 rounded-full bg-red-600 flex items-center justify-center mx-auto mb-3 shadow-[0_0_20px_rgba(220,38,38,0.5)]">
              <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            </div>
            <h4 class="font-bold mb-1">Garantía de Calidad</h4>
            <p class="text-xs text-slate-400">Certificación Internacional</p>
          </div>

        </aside>

      </div>
    </div>
  </section>

  <style>
    @keyframes float {
      0%, 100% { transform: translateY(0) scale(1.1); }
      50% { transform: translateY(-15px) scale(1.1); }
    }
    .animate-float {
      animation: float 6s ease-in-out infinite;
    }
    .animate-fade-in-up {
      animation: fadeInUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) forwards;
      opacity: 0;
      transform: translateY(20px);
    }
    @keyframes fadeInUp {
      to { opacity: 1; transform: translateY(0); }
    }
  </style>

  <script set:html={formScript}></script>
</Layout>
