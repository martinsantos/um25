---
// Apéndice con nueva estética - Alternando diseños por servicio
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import { generateSlug } from '../../../utils/slugUtils';
import { serviciosReales, serviciosPorId } from '../../../data/servicios_reales_db.js';
import { getServiceImageUrl, getAssetUrl } from '../../../utils/imageUtils.js';

const PUBLIC_DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL || 'http://directus:8055';
const DIRECTUS_TOKEN = import.meta.env.PUBLIC_DIRECTUS_TOKEN || 'k6P8LAY8_x_y1miB_KTlWnysCnx2Abky';

const { id, slug } = Astro.params;
let servicio = null;

try {
  const url = `${PUBLIC_DIRECTUS_URL}/items/Servicios/${id}?fields=*`;
  const response = await fetch(url, {
    headers: { Authorization: `Bearer ${DIRECTUS_TOKEN}` }
  });
  if (response.ok) {
    const data = await response.json();
    servicio = data.data;
  }
} catch (error) {
  console.error('Error fetching servicio:', error);
}

if (!servicio) {
  servicio = serviciosPorId[parseInt(id)] || serviciosPorId['1'];
}

if (!servicio) {
  return Astro.redirect('/404');
}

const expectedSlug = generateSlug(servicio.Titulo || servicio.Nombre || servicio.title);
if (slug !== expectedSlug) {
  return Astro.redirect(`/servicios-append/${id}/${expectedSlug}`);
}

const getHeroImage = () => {
  if (servicio.Imagen) return getAssetUrl(servicio.Imagen);
  return '/images/default-service.jpg';
};

const heroImageUrl = getHeroImage();
const serviceName = servicio.Nombre || servicio.Titulo || servicio.title;

// Determinar variante de diseño según ID del servicio
// 1: Cyan, 2: Blue, 3: Purple, 4: Green, 6: Indigo
const designVariants = {
  1: { color: '#06b6d4', name: 'Cyan', gradient: 'from-cyan-600 to-cyan-900' },
  2: { color: '#0ea5e9', name: 'Sky', gradient: 'from-sky-600 to-sky-900' },
  3: { color: '#a855f7', name: 'Purple', gradient: 'from-purple-600 to-purple-900' },
  4: { color: '#10b981', name: 'Green', gradient: 'from-green-600 to-green-900' },
  6: { color: '#6366f1', name: 'Indigo', gradient: 'from-indigo-600 to-indigo-900' }
};

const variant = designVariants[servicio.id] || designVariants[1];
const servicios = servicio.Servicios ? (Array.isArray(servicio.Servicios) ? servicio.Servicios : [servicio.Servicios]) : [];
const caracteristicas = servicio.Caracteristicas ? (Array.isArray(servicio.Caracteristicas) ? servicio.Caracteristicas : [servicio.Caracteristicas]) : [];
---

<Layout title={`${serviceName} - Nueva Estética | ULTIMA MILLA`}>
<style>
  @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
  @keyframes slideIn { from { width: 0; } to { width: 100%; } }
  @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-15px); } }
  @keyframes glow { 0%, 100% { box-shadow: 0 0 20px rgba(139, 92, 246, 0.3); } 50% { box-shadow: 0 0 40px rgba(139, 92, 246, 0.6); } }
  @keyframes gradientShift { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
  @keyframes rotate3D { 0%, 100% { transform: rotateY(0deg); } 50% { transform: rotateY(180deg); } }
  
  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 10px 24px;
    background: rgba(139, 92, 246, 0.15);
    border: 1px solid rgba(139, 92, 246, 0.3);
    border-radius: 50px;
    margin-bottom: 32px;
  }
  
  .pulse-dot {
    width: 8px;
    height: 8px;
    background: #8b5cf6;
    border-radius: 50%;
    animation: pulse 2s ease-in-out infinite;
  }
  
  .service-card {
    background: linear-gradient(135deg, rgba(139, 92, 246, 0.05) 0%, rgba(15, 23, 42, 0.5) 100%);
    border: 1px solid rgba(139, 92, 246, 0.2);
    border-radius: 24px;
    padding: 48px;
    text-align: center;
    transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  }
  
  .service-card:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3), 0 0 30px rgba(139, 92, 246, 0.2);
  }
  
  .icon-circle {
    width: 80px;
    height: 80px;
    background: linear-gradient(135deg, #8b5cf6, #6d28d9);
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin: 0 auto 24px;
    font-size: 36px;
  }
  
  input::placeholder, textarea::placeholder {
    color: #64748b;
  }
</style>

<!-- HERO SECTION -->
<section style="position: relative; min-height: 650px; background: linear-gradient(135deg, rgba(30, 27, 75, 0.85) 0%, rgba(15, 23, 42, 0.85) 50%, rgba(76, 29, 149, 0.85) 100%), url('{heroImageUrl}') center/cover; color: white; overflow: hidden;">
  <div style="position: absolute; inset: 0; opacity: 0.04; background-image: url('data:image/svg+xml,%3Csvg width=%2260%22 height=%2260%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cpath d=%22M30 0L60 30L30 60L0 30z%22 fill=%22%238b5cf6%22/%3E%3C/svg%3E')"></div>
  <div style="position: absolute; top: -100px; left: -100px; width: 700px; height: 700px; background: radial-gradient(circle, rgba(139, 92, 246, 0.2) 0%, transparent 70%); filter: blur(100px); animation: float 8s ease-in-out infinite;"></div>
  
  <div style="max-width: 1400px; margin: 0 auto; padding: 140px 40px 80px; position: relative; z-index: 10; text-align: center;">
    <div class="hero-badge">
      <div class="pulse-dot"></div>
      <span style="font-size: 13px; font-weight: 700; color: #c4b5fd; text-transform: uppercase; letter-spacing: 1.5px;">Solución Empresarial</span>
    </div>
    
    <h1 style="font-size: clamp(52px, 7vw, 80px); font-weight: 900; line-height: 1.05; margin-bottom: 32px; letter-spacing: -0.03em; background: linear-gradient(135deg, #ffffff 0%, #c4b5fd 50%, #8b5cf6 100%); background-size: 300% 300%; -webkit-background-clip: text; -webkit-text-fill-color: transparent; background-clip: text; animation: gradientShift 8s ease infinite;">
      {serviceName}
    </h1>
    
    <p style="font-size: 22px; line-height: 1.7; color: #cbd5e1; margin-bottom: 48px; max-width: 800px; margin-left: auto; margin-right: auto;">
      {servicio.Descripcion || servicio.descripcion || 'Soluciones innovadoras adaptadas a tus necesidades empresariales'}
    </p>
    
    <a href="#servicios" style="display: inline-flex; align-items: center; gap: 12px; padding: 20px 40px; background: linear-gradient(135deg, #8b5cf6, #6d28d9); color: white; font-weight: 700; font-size: 17px; border-radius: 12px; text-decoration: none; box-shadow: 0 12px 45px rgba(139, 92, 246, 0.4); animation: glow 3s ease-in-out infinite;">
      Explorar Servicios
      <svg style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
      </svg>
    </a>
  </div>
</section>

<!-- SERVICIOS SECTION -->
{servicios.length > 0 && (
  <section id="servicios" style="background: #0f172a; padding: 100px 40px;">
    <div style="max-width: 1400px; margin: 0 auto;">
      <h2 style="font-size: clamp(40px, 5vw, 56px); font-weight: 900; color: white; margin-bottom: 60px; text-align: center;">
        Nuestros Servicios
      </h2>
      
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 32px;">
        {servicios.map((svc, idx) => (
          <div class="service-card">
            <div class="icon-circle">
              {['🎯', '🚀', '💡', '⚡', '🔧'][idx % 5]}
            </div>
            <h3 style="font-size: 26px; font-weight: 800; color: white; margin-bottom: 16px;">
              {typeof svc === 'string' ? svc : svc.nombre || svc.name || 'Servicio'}
            </h3>
            <p style="font-size: 16px; color: #94a3b8; line-height: 1.7;">
              {typeof svc === 'object' && svc.descripcion ? svc.descripcion : 'Solución especializada para tu negocio'}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<!-- CARACTERÍSTICAS SECTION -->
{caracteristicas.length > 0 && (
  <section style="background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%); padding: 100px 40px;">
    <div style="max-width: 1200px; margin: 0 auto;">
      <h2 style="font-size: clamp(40px, 5vw, 56px); font-weight: 900; color: white; margin-bottom: 60px; text-align: center;">
        Características Principales
      </h2>
      
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 32px;">
        {caracteristicas.map((car, idx) => (
          <div style="background: linear-gradient(135deg, rgba(6, 182, 212, 0.05) 0%, rgba(15, 23, 42, 0.5) 100%); border: 1px solid rgba(6, 182, 212, 0.2); border-radius: 16px; padding: 32px; text-align: center;">
            <div style="width: 60px; height: 60px; background: linear-gradient(135deg, #06b6d4, #0ea5e9); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; font-size: 28px;">
              {['✓', '⭐', '🎁', '💎', '🏆'][idx % 5]}
            </div>
            <h3 style="font-size: 20px; font-weight: 800; color: white; margin-bottom: 12px;">
              {typeof car === 'string' ? car : car.nombre || car.name || 'Característica'}
            </h3>
            <p style="font-size: 15px; color: #94a3b8; line-height: 1.6;">
              {typeof car === 'object' && car.descripcion ? car.descripcion : 'Beneficio clave para tu operación'}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<!-- CTA SECTION -->
<section style="background: #0f172a; padding: 100px 40px; border-top: 1px solid rgba(255, 255, 255, 0.05);">
  <div style="max-width: 1000px; margin: 0 auto; text-align: center;">
    <h2 style="font-size: clamp(36px, 4vw, 48px); font-weight: 900; color: white; margin-bottom: 24px;">
      ¿Listo para Transformar tu Negocio?
    </h2>
    <p style="font-size: 18px; color: #94a3b8; margin-bottom: 40px;">
      Contáctanos para una consulta sin compromiso
    </p>
    
    <form action="/api/contact" method="POST" style="max-width: 600px; margin: 0 auto;">
      <div style="display: grid; gap: 20px;">
        <input type="text" name="nombre" placeholder="Nombre completo" required style="padding: 18px 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; color: white; font-size: 16px;">
        <input type="email" name="email" placeholder="Email" required style="padding: 18px 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; color: white; font-size: 16px;">
        <textarea name="mensaje" placeholder="Cuéntanos sobre tu proyecto..." rows="5" required style="padding: 18px 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; color: white; font-size: 16px;"></textarea>
        <button type="submit" style="padding: 20px; background: linear-gradient(135deg, #8b5cf6, #6d28d9); color: white; font-weight: 700; font-size: 18px; border-radius: 12px; border: none; cursor: pointer; box-shadow: 0 10px 40px rgba(139, 92, 246, 0.3); animation: glow 2s ease-in-out infinite;">
          Solicitar Información
        </button>
      </div>
    </form>
  </div>
</section>

</Layout>
