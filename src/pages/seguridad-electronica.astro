---
import Layout from '../layouts/Layout.astro';
import FAQSchema from '../components/SEO/FAQSchema.astro';
import { directus, DEFAULT_IMAGE, getAntecedenteImageUrl } from '../utils/directus';
import { generateSlug } from '../utils/slugUtils';

// FAQs para seguridad electrónica
const seguridadFAQs = [
  {
    question: "¿Qué sistemas de detección de incendio instalan?",
    answer: "Instalamos sistemas de detección de incendio certificados según normas NFPA, incluyendo detectores de humo, calor, y llama, paneles de control, sistemas de extinción automática y monitoreo centralizado 24/7."
  },
  {
    question: "¿Qué tipos de cámaras CCTV ofrecen?",
    answer: "Ofrecemos cámaras IP de alta definición, cámaras térmicas, PTZ (Pan-Tilt-Zoom), y sistemas con analítica de video inteligente para detección de movimiento, reconocimiento facial y conteo de personas."
  },
  {
    question: "¿Qué es el control de acceso biométrico?",
    answer: "El control de acceso biométrico utiliza características físicas únicas como huellas dactilares, reconocimiento facial o iris para autorizar el ingreso a áreas restringidas, ofreciendo mayor seguridad que los métodos tradicionales."
  },
  {
    question: "¿Qué son las corrientes débiles en instalaciones?",
    answer: "Las corrientes débiles incluyen todos los sistemas de baja tensión: cableado estructurado, CCTV, control de acceso, detección de incendio, alarmas, y automatización de edificios. ULTIMA MILLA es especialista en instalaciones de corrientes débiles para proyectos y obras."
  }
];

// Configuración SEO específica para Seguridad Electrónica - ULTRA OPTIMIZADA
const seoConfig = {
  title: "Seguridad Electrónica y Detección de Incendio | Mendoza, Cuyo y Patagonia | ULTIMA MILLA",
  description: "Servicios tecnológicos de seguridad electrónica para empresas argentinas. Zona de incumbencia: Mendoza, Cuyo, Patagonia. CCTV profesional, control de accesos biométrico, detección de incendios certificada, corrientes débiles. Protección inteligente empresarial.",
  keywords: "seguridad electronica mendoza cuyo, cctv empresas patagonia, control accesos biometrico, deteccion incendio certificada, corrientes debiles seguridad, videovigilancia ip, sistemas seguridad organizaciones",
  ogImage: "/images/services/ciberseguridad.jpg",
  canonical: "https://ultimamilla.com.ar/seguridad-electronica",
  locale: "es_AR",
  region: "Cuyo, Patagonia, Argentina",
  author: "Ultima Milla",
  robots: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
};

// Cargar antecedentes del sector seguridad
import { antecedentesReales } from '../data/antecedentes_completos.js';
import FeaturedAntecedentes from '../components/FeaturedAntecedentes.astro';
import { sortByImpact } from '../utils/antecedentesScoring.js';

// Filtrar antecedentes específicos de SEGURIDAD ELECTRÓNICA
const filterAntecedentes = (data) => {
  const keywords = ['cctv', 'seguridad', 'videovigilancia', 'alarma', 'control de acceso',
                    'deteccion de incendios', 'sdi', 'camara', 'biometr', 'perimetral',
                    'intrusion', 'monitoreo'];

  const filtered = data
    .filter(item => {
      const titulo = (item.Titulo || '').toLowerCase();
      const area = (item.Area || '').toLowerCase();
      const desc = (item.Descripcion || '').toLowerCase();

      // Buscar keywords relacionadas a seguridad electrónica
      return keywords.some(k =>
        titulo.includes(k) ||
        area.includes(k) ||
        desc.includes(k)
      );
    });

  // Ordenar por impacto (relevancia) - mejores casos primero
  const sortedByImpact = sortByImpact(filtered);

  return sortedByImpact;
};

// Cargar antecedentes del sector seguridad
let antecedentes = [];
let serviciosRelacionados = [];
let error = null;

try {
  // Obtener antecedentes desde Directus
  const response = await directus.getAntecedentes({
    limit: 500,
    page: 1
  });

  if (response && response.data && response.data.length > 0) {
    antecedentes = filterAntecedentes(response.data);
    console.log(`✅ Cargados ${antecedentes.length} antecedentes de seguridad electrónica`);
  }
} catch (err) {
  console.error('Error cargando antecedentes:', err);
  error = err;
}

// Fallback a datos locales si no hay resultados de API
if (antecedentes.length === 0) {
  console.log('Usando antecedentes locales para Seguridad Electrónica');
  antecedentes = filterAntecedentes(antecedentesReales);
}

// Procesar imágenes y slugs para cada antecedente
const { getAntecedenteImageUrl } = await import('../utils/directus.js');
const { generateSlug } = await import('../utils/slugUtils.js');
antecedentes = await Promise.all(
  antecedentes.map(async (item) => ({
    ...item,
    Nombre: item.Titulo || item.Nombre,
    mapeo_imagenes_completo: await getAntecedenteImageUrl(item),
    slug: generateSlug(item.Titulo || item.Nombre)
  }))
);

// Structured Data para SEO
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Sistemas de Seguridad Electrónica",
  "provider": {
    "@type": "Organization",
    "name": "Ultima Milla",
    "url": "https://www.ultimamilla.com.ar",
    "logo": "https://www.ultimamilla.com.ar/images/um-logo.png",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Mendoza",
      "addressRegion": "Mendoza",
      "addressCountry": "AR"
    }
  },
  "areaServed": [
    { "@type": "City", "name": "Mendoza" },
    { "@type": "City", "name": "San Juan" },
    { "@type": "City", "name": "San Luis" },
    { "@type": "Country", "name": "Argentina" }
  ],
  "audience": {
    "@type": "BusinessAudience",
    "name": "Empresas, Industrias y Barrios Privados"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Servicios de Seguridad Electrónica",
    "itemListElement": [
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Video Vigilancia IP (CCTV)" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Control de Accesos Biométrico" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Detección de Incendios" } },
      { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Seguridad Perimetral" } }
    ]
  }
};


---

<Layout
  title={seoConfig.title}
  description={seoConfig.description}
  keywords={seoConfig.keywords}
  image={seoConfig.ogImage}
  canonical={seoConfig.canonical}
>
  <FAQSchema items={seguridadFAQs} />

  <main style="background: #f5f5f5;">
    <!-- HERO -->
    <section style="position: relative; min-height: 400px; display: flex; align-items: center; background: linear-gradient(rgba(15, 23, 42, 0.8), rgba(15, 23, 42, 0.8)), url('https://images.unsplash.com/photo-1557597774-9d273605dfa9?w=1920&q=80') center/cover; color: white;">
      <div style="max-width: 1200px; margin: 0 auto; padding: 50px 40px; width: 100%;">
        <!-- Badge -->
        <div style="display: inline-flex; align-items: center; gap: 12px; padding: 12px 20px; background: linear-gradient(135deg, rgba(220, 38, 38, 0.3), rgba(220, 38, 38, 0.1)); border-radius: 20px; margin-bottom: 20px; border: 1px solid rgba(220, 38, 38, 0.4); backdrop-filter: blur(10px);">
          <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #dc2626, #ef4444); border-radius: 12px; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 20px rgba(220, 38, 38, 0.4);">
            <span style="font-size: 24px;">🛡️</span>
          </div>
          <span style="font-size: 13px; font-weight: 800; color: #fca5a5; text-transform: uppercase; letter-spacing: 1.2px;">Seguridad Integral</span>
        </div>

        <!-- Title -->
        <h1 style="font-size: 48px; font-weight: 900; margin-bottom: 20px; line-height: 1.2; color: white;">
          Protección Inteligente<br/>y Videovigilancia
        </h1>

        <!-- Subtitle -->
        <p style="font-size: 18px; font-weight: 400; color: rgba(255, 255, 255, 0.9); max-width: 600px; margin-bottom: 32px; line-height: 1.6;">
          Sistemas avanzados de seguridad electrónica para proteger sus activos más valiosos con tecnología de vanguardia.
        </p>

        <!-- CTA Button -->
        <a href="#contacto" style="display: inline-block; background: #dc2626; color: white; padding: 14px 32px; border-radius: 6px; font-weight: 700; font-size: 15px; text-decoration: none; transition: all 0.3s ease;" onmouseover="this.style.background='#b91c1c'" onmouseout="this.style.background='#dc2626'">
          Soluciones de Seguridad
        </a>
      </div>
    </section>

    <!-- 3 CARDS -->
    <section style="background: #f5f5f5; padding: 50px 40px;">
      <div style="max-width: 1200px; margin: 0 auto;">
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px;">
          <!-- Card 1 -->
          <div style="text-align: center; padding: 40px 30px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            <div style="width: 80px; height: 80px; background: white; border: 3px solid #e0e0e0; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
              <svg style="width: 40px; height: 40px; color: #333;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path>
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Video Vigilancia IP</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Cámaras de alta definición con análisis inteligente de video.</p>
          </div>

          <!-- Card 2 -->
          <div style="text-align: center; padding: 40px 30px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            <div style="width: 80px; height: 80px; background: white; border: 3px solid #e0e0e0; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
              <svg style="width: 40px; height: 40px; color: #333;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path>
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Control de Accesos</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Gestión segura de ingresos mediante biometría y tarjetas.</p>
          </div>

          <!-- Card 3 -->
          <div style="text-align: center; padding: 40px 30px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            <div style="width: 80px; height: 80px; background: white; border: 3px solid #e0e0e0; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
              <svg style="width: 40px; height: 40px; color: #333;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z"></path>
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.879 16.121A3 3 0 1012.015 11L11 14H9c0 .768.293 1.536.879 2.121z"></path>
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Detección de Incendios</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Sistemas certificados de detección temprana y evacuación.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICIOS -->
    <section id="servicios" style="background: white; padding: 50px 40px;">
      <div style="max-width: 1200px; margin: 0 auto;">
        <!-- Header -->
        <div style="text-align: center; margin-bottom: 60px;">
          <h2 style="font-size: 36px; font-weight: 700; color: #333; margin-bottom: 16px;">Sistemas de Seguridad</h2>
          <p style="font-size: 16px; color: #666; max-width: 700px; margin: 0 auto; line-height: 1.6;">
            Integramos múltiples tecnologías para crear ecosistemas de seguridad robustos y confiables.
          </p>
        </div>

        <!-- Services Grid 2x2 -->
        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 30px; max-width: 900px; margin: 0 auto;">
          <!-- Servicio 1 -->
          <div style="padding: 30px; background: #fafafa; border-radius: 8px; border-left: 4px solid #dc2626;">
            <div style="width: 50px; height: 50px; background: #dc2626; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
              <svg style="width: 28px; height: 28px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z" />
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">CCTV Inteligente</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Reconocimiento facial, lectura de patentes y análisis de comportamiento.</p>
          </div>

          <!-- Servicio 2 -->
          <div style="padding: 30px; background: #fafafa; border-radius: 8px; border-left: 4px solid #dc2626;">
            <div style="width: 50px; height: 50px; background: #dc2626; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
              <svg style="width: 28px; height: 28px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Biometría</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Control de acceso por huella, rostro o palma sin contacto.</p>
          </div>

          <!-- Servicio 3 -->
          <div style="padding: 30px; background: #fafafa; border-radius: 8px; border-left: 4px solid #dc2626;">
            <div style="width: 50px; height: 50px; background: #dc2626; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
              <svg style="width: 28px; height: 28px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Seguridad Perimetral</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Barreras infrarrojas, cercos eléctricos y radar de detección.</p>
          </div>

          <!-- Servicio 4 -->
          <div style="padding: 30px; background: #fafafa; border-radius: 8px; border-left: 4px solid #dc2626;">
            <div style="width: 50px; height: 50px; background: #dc2626; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
              <svg style="width: 28px; height: 28px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Integración</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Plataformas unificadas para gestión centralizada de seguridad.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- CASOS DE ÉXITO -->
    {antecedentes.length > 0 && (
      <section style="background: #f8fafc; padding: 100px 32px; border-top: 1px solid #e2e8f0;">
        <div style="max-width: 75rem; margin: 0 auto;">
          <div style="text-align: center; margin-bottom: 72px;">
            <div style="display: inline-block; padding: 8px 20px; background: linear-gradient(135deg, #dc2626, #ef4444); border-radius: 50px; margin-bottom: 20px;">
              <span style="font-size: 13px; font-weight: 800; color: white; letter-spacing: 1px; text-transform: uppercase;">✨ Experiencia en Seguridad</span>
            </div>
            <h2 style="font-size: clamp(36px, 5.5vw, 52px); font-weight: 900; color: #0f172a; margin-bottom: 20px; letter-spacing: -0.02em;">Proyectos de Seguridad</h2>
            <p style="font-size: 19px; color: #64748b; max-width: 750px; margin: 0 auto; line-height: 1.7; font-weight: 500;">
              Implementaciones exitosas en protección de activos y personas.
            </p>
          </div>

          <FeaturedAntecedentes antecedentes={antecedentes} />
        </div>
      </section>
    )}

    <!-- FORMULARIO -->
    <section id="contacto" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); padding: 100px 32px; position: relative; overflow: hidden;">
      <div style="max-width: 75rem; margin: 0 auto; position: relative; z-index: 10;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center;">
          <!-- Left Content -->
          <div>
            <div style="display: inline-block; padding: 8px 20px; background: rgba(220, 38, 38, 0.2); border-radius: 50px; margin-bottom: 24px; border: 1px solid rgba(220, 38, 38, 0.3);">
              <span style="font-size: 13px; font-weight: 800; color: #fca5a5; letter-spacing: 1px; text-transform: uppercase;">📞 Contáctenos</span>
            </div>
            <h2 style="font-size: clamp(36px, 5vw, 56px); font-weight: 900; color: white; margin-bottom: 24px; line-height: 1.1; letter-spacing: -0.02em;">
              Proteja su Empresa<br/>con Tecnología
            </h2>
            <p style="font-size: 18px; color: #cbd5e1; line-height: 1.8; margin-bottom: 40px; font-weight: 500;">
              Contáctenos para diseñar un sistema de seguridad a medida de sus necesidades.
            </p>
          </div>
          
          <!-- Right Form -->
          <div style="background: white; border-radius: 24px; padding: 48px; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
            <form action="/api/contact" method="POST" style="display: flex; flex-direction: column; gap: 24px;">
              <div>
                <label style="display: block; font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Nombre</label>
                <input type="text" name="nombre" required style="width: 100%; padding: 14px 18px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 15px;" placeholder="Nombre Completo" />
              </div>
              <div>
                <label style="display: block; font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Empresa</label>
                <input type="text" name="empresa" required style="width: 100%; padding: 14px 18px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 15px;" placeholder="Empresa" />
              </div>
              <div>
                <label style="display: block; font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Email</label>
                <input type="email" name="email" required style="width: 100%; padding: 14px 18px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 15px;" placeholder="email@empresa.com" />
              </div>
              <div>
                <label style="display: block; font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Mensaje</label>
                <textarea name="mensaje" required rows="4" style="width: 100%; padding: 14px 18px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 15px;" placeholder="Detalles del requerimiento..."></textarea>
              </div>
              <button type="submit" style="width: 100%; padding: 18px; background: linear-gradient(135deg, #dc2626, #ef4444); color: white; border: none; border-radius: 12px; font-size: 16px; font-weight: 800; cursor: pointer;">
                Solicitar Asesoramiento
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* Mobile Responsive Styles */
  @media (max-width: 768px) {
    section > div > div[style*="grid-template-columns: repeat(3, 1fr)"] {
      grid-template-columns: 1fr !important;
    }
    
    section > div > div[style*="grid-template-columns: repeat(2, 1fr)"] {
      grid-template-columns: 1fr !important;
    }
    
    #contacto > div > div[style*="grid-template-columns: 1fr 1fr"] {
      grid-template-columns: 1fr !important;
      gap: 40px !important;
    }
    
    h1 {
      font-size: 32px !important;
    }
    
    h2 {
      font-size: 28px !important;
    }
    
    section {
      padding: 40px 20px !important;
    }
  }
</style>
