---
import LayoutV4 from '../layouts/LayoutV4.astro';

Astro.response.status = 404;
---

<LayoutV4
  title="Página no encontrada | ULTIMA MILLA"
  description="La página que buscas no existe o fue movida."
  noindex={true}
>
  <section class="min-h-[60vh] flex items-center justify-center bg-gradient-to-b from-um-dark to-gray-900 px-4">
    <div class="text-center max-w-xl">
      <div class="text-8xl font-bold text-um-primary mb-4">404</div>
      <h1 class="text-3xl font-bold text-white mb-4">Página no encontrada</h1>
      <p class="text-gray-400 mb-8">
        La página que buscas no existe, fue movida o está temporalmente fuera de servicio.
      </p>
      <div class="flex flex-wrap justify-center gap-4">
        <a href="/" class="px-6 py-3 bg-um-primary text-white rounded-lg hover:bg-um-primary/90 transition font-medium">
          Ir al inicio
        </a>
        <a href="/servicios" class="px-6 py-3 bg-white/10 text-white rounded-lg hover:bg-white/20 transition font-medium">
          Ver servicios
        </a>
        <a href="/antecedentes" class="px-6 py-3 bg-white/10 text-white rounded-lg hover:bg-white/20 transition font-medium">
          Ver proyectos
        </a>
        <a href="/contacto" class="px-6 py-3 bg-white/10 text-white rounded-lg hover:bg-white/20 transition font-medium">
          Contacto
        </a>
      </div>
    </div>
  </section>
</LayoutV4>
