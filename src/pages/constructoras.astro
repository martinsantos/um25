  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .group:hover .group-hover\:scale-105 {
    transform: scale(1.05);
  }

  a:focus {
    outline: 2px solid rgba(217, 119, 6, 0.5);
