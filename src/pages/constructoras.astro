---
import Layout from '../layouts/Layout.astro';
import { directus, DEFAULT_IMAGE } from '../utils/directus';
import { generateSlug } from '../utils/slugUtils';

// Configuración SEO específica para Constructoras - ULTRA OPTIMIZADA para Argentina y Mendoza
const seoConfig = {
  title: "Tecnología para Constructoras Mendoza | Software ERP, Redes, Seguridad | ULTIMA MILLA",
  description: "Soluciones IT especializadas para constructoras en Mendoza. Infraestructura de redes, cableado estructurado, CCTV, detección de incendios y conectividad para obras.",
  keywords: "servicios tecnologicos constructoras, infraestructura it obras mendoza, conectividad temporal canteros cuyo, cableado estructurado construccion patagonia, corrientes debiles obras, deteccion incendio canteros, cctv seguridad construccion",
  ogImage: "/images/services/servicios-it.jpg",
  canonical: "https://ultimamilla.com.ar/constructoras",
  locale: "es_AR",
  region: "Cuyo, Patagonia, Argentina",
  author: "Ultima Milla",
  robots: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
};

// Cargar antecedentes del sector constructoras
import { antecedentesReales } from '../data/antecedentes_completos.js';
import FeaturedAntecedentes from '../components/FeaturedAntecedentes.astro';

let antecedentes = [];
let serviciosRelacionados = [];
let error = null;

const keywords = [
  'construccion', 'constructora', 'obras', 'ingenier', 'urbaniz',
  'edificio', 'torre', 'procon', 'laugero', 'kristich',
  'obra civil', 'contratista', 'inmobiliaria', 'proyecto residencial',
  'proyecto comercial', 'planeamiento urbano'
];

const filterAntecedentes = (data) => {
  return data.filter(item => {
    const cliente = (item.Cliente || '').toLowerCase();
    const titulo = (item.Titulo || '').toLowerCase();
    const area = (item.Area || '').toLowerCase();
    return keywords.some(k => cliente.includes(k) || titulo.includes(k) || area.includes(k));
  }).sort((a, b) => new Date(b.Fecha || '2000-01-01') - new Date(a.Fecha || '2000-01-01'));
};

try {
  // Obtener antecedentes de constructoras desde Directus
  const response = await directus.getAntecedentes({
    limit: 500,
    page: 1
  });

  if (response && response.data && response.data.length > 0) {
    antecedentes = filterAntecedentes(response.data);
    console.log(`✅ Cargados ${antecedentes.length} antecedentes de constructoras`);
  }
} catch (err) {
  console.error('Error cargando antecedentes:', err);
  error = err;
}

// Fallback a datos locales si no hay resultados de API
if (antecedentes.length === 0) {
  console.log('Usando antecedentes locales para Constructoras');
  antecedentes = filterAntecedentes(antecedentesReales);
}

// Procesar imágenes y slugs para cada antecedente
const { getAntecedenteImageUrl } = await import('../utils/directus.js');
const { generateSlug } = await import('../utils/slugUtils.js');
antecedentes = await Promise.all(
  antecedentes.map(async (item) => ({
    ...item,
    Nombre: item.Titulo || item.Nombre,
    mapeo_imagenes_completo: await getAntecedenteImageUrl(item)
  }))
);

// Servicios relacionados con el sector constructoras
// Structured Data para SEO
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Service",
  "serviceType": "Infraestructura IT para Constructoras",
  "provider": {
    "@type": "Organization",
    "name": "Ultima Milla",
    "url": "https://www.ultimamilla.com.ar",
    "logo": "https://www.ultimamilla.com.ar/images/um-logo.png",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Mendoza",
      "addressRegion": "Mendoza",
      "addressCountry": "AR"
    }
  },
  "areaServed": [
    {
      "@type": "City",
      "name": "Mendoza"
    },
    {
      "@type": "Country",
      "name": "Argentina"
    }
  ],
  "audience": {
    "@type": "BusinessAudience",
    "name": "Constructoras y Empresas de Construcción"
  },
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Servicios IT para Constructoras",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Cableado Estructurado para Obras"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Sistemas de Seguridad CCTV y Control de Accesos"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Conectividad Temporal para Canteros"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Telefonía IP Empresarial"
        }
      }
    ]
  },
  "aggregateRating": {
    "@type": "AggregateRating",
    "ratingValue": "4.9",
    "reviewCount": "50"
  }
};

serviciosRelacionados = [
  {
    id: 1,
    nombre: "Cableado Estructurado para Obras",
    descripcion: "Infraestructura de redes de datos de altas prestaciones",
    icon: "network",
    slug: "cableado-estructurado-obras"
  },
  {
    id: 2,
    nombre: "Sistemas de Seguridad y Control",
    descripcion: "CCTV de vigilancia y control de accesos en canteros",
    icon: "shield",
    slug: "sistemas-seguridad-control"
  },
  {
    id: 3,
    nombre: "Conectividad Temporal",
    descripcion: "Soluciones de internet para zonas de obras",
    icon: "wifi",
    slug: "conectividad-temporal"
  },
  {
    id: 4,
    nombre: "Telefonía IP Empresarial",
    descripcion: "Sistemas de comunicación integrados",
    icon: "phone",
    slug: "telefonia-ip"
  },
  {
    id: 5,
    nombre: "Sistemas de Detección de Incendios",
    descripcion: "Detección temprana y alarmas para protección",
    icon: "alert",
    slug: "deteccion-incendios"
  },
  {
    id: 6,
    nombre: "Soporte Técnico 24/7",
    descripcion: "Mantenimiento preventivo y correctivo",
    icon: "support",
    slug: "soporte-tecnico"
  }
];
---

<Layout
  title={seoConfig.title}
  description={seoConfig.description}
  keywords={seoConfig.keywords}
  image={seoConfig.ogImage}
  canonical={seoConfig.canonical}
>
  <main style="background: #f5f5f5;">
    <!-- HERO CONSTRUCTORAS -->
    <section style="position: relative; min-height: 350px; display: flex; align-items: center; background: linear-gradient(rgba(0, 0, 0, 0.65), rgba(0, 0, 0, 0.65)), url('https://images.unsplash.com/photo-1577427537037-87b2d5b9b97b?w=1920&q=80') center/cover; color: white;">
      <div style="max-width: 1200px; margin: 0 auto; padding: 50px 40px; width: 100%;">
        <!-- Badge Simple -->
        <div style="display: inline-flex; align-items: center; gap: 12px; padding: 12px 20px; background: linear-gradient(135deg, rgba(245, 158, 11, 0.3), rgba(245, 158, 11, 0.1)); border-radius: 20px; margin-bottom: 20px; border: 1px solid rgba(245, 158, 11, 0.4); backdrop-filter: blur(10px);">
          <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #f59e0b, #d97706); border-radius: 12px; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 20px rgba(245, 158, 11, 0.4);">
            <span style="font-size: 24px;">🏗</span>
          </div>
