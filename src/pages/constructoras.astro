---
import Layout from '../layouts/Layout.astro';
import { directus, DEFAULT_IMAGE } from '../utils/directus';
import { generateSlug } from '../utils/slugUtils';

// Configuración SEO específica para constructoras - ULTRA OPTIMIZADA para Argentina y Mendoza
const seoConfig = {
  title: "Tecnología IT Constructoras Mendoza Argentina | PROCON LAUGGERO KRISTICH | Infraestructura Obras",
  description: "⛑️ Especialistas en infraestructura IT para constructoras en Mendoza y Argentina. Sistemas tecnológicos completos para PROCON, LAUGGERO, KRISTICH. Redes estructuradas, comunicaciones IP, seguridad CCTV y control de accesos para obras y canteros. +50 proyectos documentados, 20+ años de experiencia. Soporte 24/7.",
  keywords: "constructoras mendoza, infraestructura IT constructoras argentina, tecnología para obras mendoza, PROCON mendoza IT, LAUGGERO constructoras tecnología, KRISTICH infraestructura, redes estructuradas constructoras, cableado certificado obras, comunicaciones IP constructoras, CCTV obras mendoza, control accesos biométrico canteros, seguridad electrónica construccion, telefonía IP obras, conectividad temporal canteros, sistemas gestión constructora, IT construcción argentina, tecnología oficinas técnicas, servidores construccion, redes wifi obras, integración tecnológica constructoras mendoza",
  ogImage: "/images/constructoras-hero.jpg",
  canonical: "https://www.ultimamilla.com.ar/constructoras",
  locale: "es_AR",
  region: "AR-M",
  author: "Ultima Milla",
  robots: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
};

// Cargar antecedentes del sector constructoras
let antecedentes = [];
let serviciosRelacionados = [];
let error = null;

try {
  // Obtener antecedentes de constructoras desde Directus
  const response = await directus.getAntecedentes({
    limit: 500,
    page: 1
  });

  if (response && response.data && response.data.length > 0) {
    // Filtrar antecedentes del sector constructoras
    antecedentes = response.data
      .filter(item => 
        item.vertical === 'constructoras' ||
        item.Cliente?.toLowerCase().includes('procon') ||
        item.Cliente?.toLowerCase().includes('lauggero') ||
        item.Cliente?.toLowerCase().includes('kristich') ||
        item.Cliente?.toLowerCase().includes('constructora') ||
        item.Cliente?.toLowerCase().includes('construcción')
      )
      .map(item => ({
        ...item,
        slug: `${item.id}/${generateSlug(item.Titulo)}`
      }))
      .sort((a, b) => new Date(b.Fecha) - new Date(a.Fecha));

    console.log(`✅ Cargados ${antecedentes.length} antecedentes del sector constructoras`);
  }

  // Servicios relacionados con el sector constructoras
  // Structured Data para SEO
  const structuredData = {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Infraestructura IT para Constructoras",
    "provider": {
      "@type": "Organization",
      "name": "Ultima Milla",
      "url": "https://www.ultimamilla.com.ar",
      "logo": "https://www.ultimamilla.com.ar/images/um-logo.png",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Mendoza",
        "addressRegion": "Mendoza",
        "addressCountry": "AR"
      }
    },
    "areaServed": [
      {
        "@type": "City",
        "name": "Mendoza"
      },
      {
        "@type": "Country",
        "name": "Argentina"
      }
    ],
    "audience": {
      "@type": "BusinessAudience",
      "name": "Constructoras y Empresas de Construcción"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Servicios IT para Constructoras",
      "itemListElement": [
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Cableado Estructurado para Obras"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Sistemas de Seguridad CCTV y Control de Accesos"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Conectividad Temporal para Canteros"
          }
        },
        {
          "@type": "Offer",
          "itemOffered": {
            "@type": "Service",
            "name": "Telefonía IP Empresarial"
          }
        }
      ]
    },
    "aggregateRating": {
      "@type": "AggregateRating",
      "ratingValue": "4.9",
      "reviewCount": "50"
    }
  };

  serviciosRelacionados = [
    {
      id: 1,
      nombre: "Cableado Estructurado para Obras",
      descripcion: "Infraestructura de red certificada para canteros y oficinas de obra",
      icon: "network",
      slug: "cableado-estructurado-obras"
    },
    {
      id: 2,
      nombre: "Sistemas de Seguridad y Control",
      descripcion: "CCTV, control de accesos biométrico y sistemas de alarma para obras",
      icon: "shield",
      slug: "sistemas-seguridad-control"
    },
    {
      id: 3,
      nombre: "Conectividad Temporal",
      descripcion: "Soluciones de red móvil y temporal para canteros en construcción",
      icon: "wifi",
      slug: "conectividad-temporal"
    },
    {
      id: 4,
      nombre: "Telefonía IP Empresarial",
      descripcion: "Sistemas de comunicaciones integrados para oficinas y canteros",
      icon: "phone",
      slug: "telefonia-ip"
    },
    {
      id: 5,
      nombre: "Sistemas de Detección de Incendios",
      descripcion: "Detección temprana y alarmas para protección de obras",
      icon: "alert",
      slug: "deteccion-incendios"
    },
    {
      id: 6,
      nombre: "Soporte Técnico 24/7",
      descripcion: "Mantenimiento preventivo y correctivo para operaciones continuas",
      icon: "support",
      slug: "soporte-tecnico"
    }
  ];
} catch (err) {
  console.error('Error cargando antecedentes:', err);
  error = err;
}

// Función para obtener imagen del antecedente
import { buscarImagenPorDatos } from '../data/mapeo_imagenes_completo';

function getImageUrl(proyecto) {
  if (!proyecto) return DEFAULT_IMAGE;
  const imagenNombre = buscarImagenPorDatos(
    proyecto.Cliente,
    proyecto.Area || proyecto.Unidad_de_negocio,
    proyecto.Titulo,
    proyecto.id
  );
  return imagenNombre 
    ? `/imagenes_antecedentes_versionproduccion/${imagenNombre}`
    : DEFAULT_IMAGE;
}

const antecedentesConImagenes = antecedentes.map(proyecto => ({
  ...proyecto,
  imageUrl: getImageUrl(proyecto)
}));
---

<Layout
  title={seoConfig.title}
  description={seoConfig.description}
  keywords={seoConfig.keywords}
  image={seoConfig.ogImage}
  canonical={seoConfig.canonical}
>
  <main style="background: #f8f9fa;">
    <!-- HERO MODERNO CON IMAGEN DE FONDO -->
    <section style="position: relative; min-height: 600px; display: flex; align-items: center; background: linear-gradient(rgba(0, 0, 0, 0.6), rgba(0, 0, 0, 0.7)), url('https://images.unsplash.com/photo-1541888946425-d81bb19240f5?w=1920&q=80') center/cover; color: white;">
      <div style="max-width: 80rem; margin: 0 auto; padding: 80px 24px; position: relative; z-index: 10; width: 100%;">
        <!-- Badge -->
        <div style="display: inline-flex; align-items: center; gap: 8px; border-radius: 9999px; background: rgba(245, 158, 11, 0.2); backdrop-filter: blur(10px); border: 1px solid rgba(245, 158, 11, 0.3); padding: 10px 20px; margin-bottom: 24px;">
          <div style="width: 10px; height: 10px; border-radius: 50%; background: #f59e0b; box-shadow: 0 0 12px rgba(245, 158, 11, 0.8);"></div>
          <span style="font-size: 13px; font-weight: 700; color: #fbbf24; letter-spacing: 1px; text-transform: uppercase;">Sector Construcción</span>
        </div>

        <!-- Title -->
        <h1 style="font-size: clamp(40px, 7vw, 64px); font-weight: 900; letter-spacing: -0.02em; margin-bottom: 20px; line-height: 1.1; text-shadow: 2px 4px 8px rgba(0,0,0,0.3);">
          Construyendo el Mañana<br/>con Tecnología y Precisión
        </h1>

        <!-- Subtitle -->
        <p style="font-size: 20px; font-weight: 500; color: rgba(255, 255, 255, 0.95); max-width: 600px; margin-bottom: 40px; line-height: 1.6;">
          Soluciones integrales para la gestión y ejecución de proyectos de construcción con precisión.
        </p>

        <!-- CTA Button -->
        <a href="#servicios" style="display: inline-flex; align-items: center; gap: 12px; background: #f59e0b; color: white; padding: 16px 40px; border-radius: 8px; font-weight: 700; font-size: 16px; text-decoration: none; box-shadow: 0 8px 20px rgba(245, 158, 11, 0.4); transition: all 0.3s ease; border: none; cursor: pointer;">
          Explorar Nuestras Soluciones
          <svg style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M13 7l5 5m0 0l-5 5m5-5H6"></path>
          </svg>
        </a>
      </div>
    </section>

    <!-- CARACTERÍSTICAS PRINCIPALES -->
    <section style="background: white; padding: 80px 24px;">
      <div style="max-width: 80rem; margin: 0 auto;">
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 32px;">
          <!-- Card 1 -->
          <div style="text-align: center; padding: 40px 24px; background: #f8f9fa; border-radius: 16px; border: 2px solid #e9ecef; transition: all 0.3s ease;" onmouseover="this.style.borderColor='#f59e0b'; this.style.transform='translateY(-8px)'; this.style.boxShadow='0 12px 24px rgba(245,158,11,0.15)'" onmouseout="this.style.borderColor='#e9ecef'; this.style.transform='translateY(0)'; this.style.boxShadow='none'">
            <div style="width: 64px; height: 64px; background: linear-gradient(135deg, #f59e0b, #d97706); border-radius: 16px; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
              <svg style="width: 32px; height: 32px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"></path>
              </svg>
            </div>
            <h3 style="font-size: 20px; font-weight: 800; color: #1a1a1a; margin-bottom: 12px;">Proyectos a Gran Escala</h3>
            <p style="font-size: 15px; color: #6c757d; line-height: 1.6;">Gestionamos proyectos complejos con precisión y eficiencia en proyectos de construcción.</p>
          </div>

          <!-- Card 2 -->
          <div style="text-align: center; padding: 40px 24px; background: #f8f9fa; border-radius: 16px; border: 2px solid #e9ecef; transition: all 0.3s ease;" onmouseover="this.style.borderColor='#f59e0b'; this.style.transform='translateY(-8px)'; this.style.boxShadow='0 12px 24px rgba(245,158,11,0.15)'" onmouseout="this.style.borderColor='#e9ecef'; this.style.transform='translateY(0)'; this.style.boxShadow='none'">
            <div style="width: 64px; height: 64px; background: linear-gradient(135deg, #f59e0b, #d97706); border-radius: 16px; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
              <svg style="width: 32px; height: 32px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <h3 style="font-size: 20px; font-weight: 800; color: #1a1a1a; margin-bottom: 12px;">Innovación Tecnológica</h3>
            <p style="font-size: 15px; color: #6c757d; line-height: 1.6;">Implementamos las últimas tecnologías para optimizar cada fase de la construcción.</p>
          </div>

          <!-- Card 3 -->
          <div style="text-align: center; padding: 40px 24px; background: #f8f9fa; border-radius: 16px; border: 2px solid #e9ecef; transition: all 0.3s ease;" onmouseover="this.style.borderColor='#f59e0b'; this.style.transform='translateY(-8px)'; this.style.boxShadow='0 12px 24px rgba(245,158,11,0.15)'" onmouseout="this.style.borderColor='#e9ecef'; this.style.transform='translateY(0)'; this.style.boxShadow='none'">
            <div style="width: 64px; height: 64px; background: linear-gradient(135deg, #f59e0b, #d97706); border-radius: 16px; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
              <svg style="width: 32px; height: 32px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path>
              </svg>
            </div>
            <h3 style="font-size: 20px; font-weight: 800; color: #1a1a1a; margin-bottom: 12px;">Seguridad y Certificación</h3>
            <p style="font-size: 15px; color: #6c757d; line-height: 1.6;">Cumplimiento riguroso de normativas y estándares de seguridad en obra.</p>
          </div>
        </div>
      </div>
    </section>


    <!-- SERVICIOS OFRECIDOS -->
    <section id="servicios" style="background: #f8f9fa; padding: 80px 24px;">
      <div style="max-width: 80rem; margin: 0 auto;">
        <!-- Header -->
        <div style="text-align: center; margin-bottom: 60px;">
          <h2 style="font-size: clamp(32px, 5vw, 48px); font-weight: 900; color: #1a1a1a; margin-bottom: 16px;">Servicios Ofrecidos</h2>
          <p style="font-size: 18px; color: #6c757d; max-width: 700px; margin: 0 auto;">
            Ofrecemos un portafolio de servicios tecnológicos diseñados para optimizar cada fase del ciclo de vida del proyecto de construcción.
          </p>
        </div>

        <!-- Services Grid - Premium Cards -->
        <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
          <!-- Card 1 -->
          <div class="group relative overflow-hidden rounded-2xl bg-white p-8 shadow-lg transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl">
            <div class="mb-6 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-amber-100 transition-all duration-300 group-hover:bg-amber-500 group-hover:scale-110">
              <svg class="h-8 w-8 text-amber-600 transition-colors duration-300 group-hover:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9" />
              </svg>
            </div>
            <h3 class="mb-3 text-xl font-bold text-gray-900">Cableado Estructurado para Obras</h3>
            <p class="text-gray-600">Infraestructura de red certificada para canteros y oficinas de obra</p>
          </div>

          <!-- Card 2 -->
          <div class="group relative overflow-hidden rounded-2xl bg-white p-8 shadow-lg transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl">
            <div class="mb-6 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-amber-100 transition-all duration-300 group-hover:bg-amber-500 group-hover:scale-110">
              <svg class="h-8 w-8 text-amber-600 transition-colors duration-300 group-hover:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 class="mb-3 text-xl font-bold text-gray-900">Sistemas de Seguridad y Control</h3>
            <p class="text-gray-600">CCTV, control de accesos biométrico y sistemas de alarma para obras</p>
          </div>

          <!-- Card 3 -->
          <div class="group relative overflow-hidden rounded-2xl bg-white p-8 shadow-lg transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl">
            <div class="mb-6 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-amber-100 transition-all duration-300 group-hover:bg-amber-500 group-hover:scale-110">
              <svg class="h-8 w-8 text-amber-600 transition-colors duration-300 group-hover:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.857 15.355-5.857 21.213 0" />
              </svg>
            </div>
            <h3 class="mb-3 text-xl font-bold text-gray-900">Conectividad Temporal</h3>
            <p class="text-gray-600">Soluciones de red móvil y temporal para canteros en construcción</p>
          </div>

          <!-- Card 4 -->
          <div class="group relative overflow-hidden rounded-2xl bg-white p-8 shadow-lg transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl">
            <div class="mb-6 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-amber-100 transition-all duration-300 group-hover:bg-amber-500 group-hover:scale-110">
              <svg class="h-8 w-8 text-amber-600 transition-colors duration-300 group-hover:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
              </svg>
            </div>
            <h3 class="mb-3 text-xl font-bold text-gray-900">Telefonía IP Empresarial</h3>
            <p class="text-gray-600">Sistemas de comunicaciones integrados para oficinas y canteros</p>
          </div>

          <!-- Card 5 -->
          <div class="group relative overflow-hidden rounded-2xl bg-white p-8 shadow-lg transition-all duration-500 hover:-translate-y-2 hover:shadow-2xl">
            <div class="mb-6 inline-flex h-16 w-16 items-center justify-center rounded-2xl bg-amber-100 transition-all duration-300 group-hover:bg-amber-500 group-hover:scale-110">
              <svg class="h-8 w-8 text-amber-600 transition-colors duration-300 group-hover:text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z" />
              </svg>
            </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">Sistemas de Detección de Incendios</h3>
          <p class="text-sm text-gray-600">Detección temprana y alarmas para protección de obras</p>
        </div>
        
        <div class="bg-white rounded-xl p-6 border-2 border-amber-200 hover:border-amber-500 hover:shadow-lg transition-all duration-300">
          <div class="w-14 h-14 bg-amber-600 rounded-lg flex items-center justify-center mb-4">
            <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
            </svg>
          </div>
          <h3 class="text-lg font-bold text-gray-900 mb-2">Soporte Técnico 24/7</h3>
          <p class="text-sm text-gray-600">Mantenimiento preventivo y correctivo para operaciones continuas</p>
        </div>
      </div>
    </div>

    <!-- Antecedentes Section -->
    {antecedentesConImagenes.length > 0 && (
      <div class="container mx-auto px-4 py-20">
        <div class="text-center mb-16">
          <h2 class="text-4xl font-bold text-gray-900 mb-4">Proyectos Realizados</h2>
          <p class="text-xl text-gray-600 max-w-3xl mx-auto">
            Experiencia comprobada con las principales constructoras del país
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
          {antecedentesConImagenes.map((proyecto) => (
            <a href={`/antecedentes/${proyecto.slug}`} class="block group cursor-pointer">
              <article class="bg-white rounded-2xl shadow-lg hover:shadow-2xl hover:shadow-amber-500/25 transition-all duration-300 transform hover:-translate-y-2 hover:scale-[1.02] hover:ring-4 hover:ring-amber-300/50 overflow-hidden border-2 border-transparent hover:border-amber-400 h-full">
                {/* Imagen del proyecto */}
                <div class="relative overflow-hidden aspect-[4/3]">
                  <img 
                    src={proyecto.imageUrl}
                    alt={proyecto.Titulo}
                    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                    loading="lazy"
                    onerror="this.src='/images/default.jpg'"
                  />
                  
                  {/* Badge de constructoras */}
                  <div style="position: absolute; top: 1rem; left: 1rem;">
                    <span style="display: inline-flex; align-items: center; padding: 0.5rem 1rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 900; background-color: #fbbf24; color: #111827; border: 2px solid #d97706; box-shadow: 0 20px 25px -5px rgba(0, 0, 0, 0.1);">
                      <svg style="width: 1.25rem; height: 1.25rem; margin-right: 0.5rem;" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-4m-5 0H9m0 0H5m4 0V9a1 1 0 011-1h4a1 1 0 011 1v12M9 7h6" />
                      </svg>
                      Constructoras
                    </span>
                  </div>
                </div>

                {/* Contenido de la tarjeta */}
                <div class="p-6">
                  <div class="mb-4">
                    <h3 class="text-xl font-black text-gray-900 mb-2 line-clamp-2 group-hover:text-amber-600 transition-colors">
                      {proyecto.Titulo}
                    </h3>
                    {proyecto.Cliente && (
                      <div class="flex items-center text-sm text-gray-600 mb-2">
                        <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-4m-5 0H9m0 0H5m4 0V9a1 1 0 011-1h4a1 1 0 011 1v12M9 7h6"></path>
                        </svg>
                        {proyecto.Cliente}
                      </div>
                    )}
                  </div>

                  <p class="text-gray-600 line-clamp-3 text-sm leading-relaxed mb-4">
                    {proyecto.Descripcion?.substring(0, 120)}...
                  </p>

                  <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                    <div class="flex items-center text-xs text-gray-500">
                      <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                      </svg>
                      {(() => {
                        if (!proyecto.Fecha) return '2024';
                        const fecha = new Date(proyecto.Fecha);
                        return isNaN(fecha.getTime()) ? '2024' : fecha.toLocaleDateString('es-ES', { year: 'numeric', month: 'short' });
                      })()}
                    </div>
                    {proyecto.Area && (
                      <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-amber-100 text-amber-700">
                        {proyecto.Area}
                      </span>
                    )}
                  </div>
                </div>
              </article>
            </a>
          ))}
        </div>
      </div>
    )}

    <!-- Call to Action -->
    <div class="bg-gradient-to-r from-amber-900 via-orange-900 to-amber-900 py-20">
      <div class="container mx-auto px-4 text-center">
        <h2 class="text-5xl md:text-6xl font-black text-white mb-6">
          ¿Necesita tecnología para su obra?
        </h2>
        <p class="text-2xl text-gray-100 mb-10 max-w-3xl mx-auto font-semibold">
          Contáctenos para una consulta personalizada sobre sus necesidades tecnológicas
        </p>
        <a 
          href="/contacto" 
          class="inline-flex items-center px-10 py-5 bg-amber-400 text-gray-900 font-black text-lg rounded-2xl hover:bg-amber-300 transition-all duration-200 shadow-2xl hover:shadow-3xl transform hover:-translate-y-2 hover:scale-105"
        >
          Solicitar Consultoría
          <svg class="w-6 h-6 ml-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
          </svg>
        </a>
      </div>
    </div>
  </main>
</Layout>

