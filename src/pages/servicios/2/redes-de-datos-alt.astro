---
// VERSIÓN ALTERNATIVA - REDES DE DATOS
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Redes de Datos - Nueva Estética | ULTIMA MILLA">
  <style>
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
    input::placeholder, textarea::placeholder { color: #64748b; }
  </style>

  <!-- HERO -->
  <section style="position: relative; min-height: 600px; background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); color: white; overflow: hidden;">
    <div style="position: absolute; inset: 0; opacity: 0.03; background-image: url('data:image/svg+xml,%3Csvg width=&quot;60&quot; height=&quot;60&quot; viewBox=&quot;0 0 60 60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cg fill=&quot;%230ea5e9&quot;%3E%3Cpath d=&quot;M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4z&quot;/%3E%3C/g%3E%3C/svg%3E');"></div>
    <div style="position: absolute; top: -150px; left: -150px; width: 500px; height: 500px; background: radial-gradient(circle, rgba(14, 165, 233, 0.2) 0%, transparent 70%); filter: blur(80px);"></div>

    <div style="max-width: 1400px; margin: 0 auto; padding: 120px 40px 80px; position: relative; z-index: 10;">
      <div style="max-width: 900px;">
        <div style="display: inline-flex; align-items: center; gap: 10px; padding: 10px 24px; background: rgba(14, 165, 233, 0.15); border: 1px solid rgba(14, 165, 233, 0.3); border-radius: 50px; margin-bottom: 32px;">
          <div style="width: 8px; height: 8px; background: #0ea5e9; border-radius: 50%; animation: pulse 2s ease-in-out infinite;"></div>
          <span style="font-size: 13px; font-weight: 700; color: #0ea5e9; text-transform: uppercase; letter-spacing: 1.5px;">Redes & Comunicaciones</span>
        </div>

        <h1 style="font-size: clamp(48px, 6vw, 72px); font-weight: 900; line-height: 1.1; margin-bottom: 28px; letter-spacing: -0.02em;">
          Infraestructura de Red de Clase Mundial
        </h1>

        <p style="font-size: 20px; line-height: 1.7; color: #cbd5e1; margin-bottom: 40px;">
          Diseño, implementación y gestión de redes empresariales con tecnología de punta y rendimiento garantizado.
        </p>

        <a href="#contacto" style="display: inline-flex; align-items: center; gap: 12px; padding: 18px 36px; background: linear-gradient(135deg, #0ea5e9, #0284c7); color: white; font-weight: 700; font-size: 16px; border-radius: 12px; text-decoration: none; box-shadow: 0 10px 40px rgba(14, 165, 233, 0.3);">
          Consulta Gratuita
          <svg style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CASOS DE ESTUDIO -->
  <section style="background: #0f172a; padding: 100px 40px;">
    <div style="max-width: 1400px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 80px;">
        <div style="display: inline-block; padding: 8px 20px; background: rgba(14, 165, 233, 0.1); border: 1px solid rgba(14, 165, 233, 0.2); border-radius: 50px; margin-bottom: 24px;">
          <span style="font-size: 13px; font-weight: 800; color: #0ea5e9; text-transform: uppercase;">Estudios de Caso</span>
        </div>
        <h2 style="font-size: clamp(40px, 5vw, 56px); font-weight: 900; color: white; margin-bottom: 24px;">
          Respuesta a Incidentes en Acción
        </h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(350px, 1fr)); gap: 32px;">
        <div style="background: linear-gradient(135deg, rgba(30, 41, 59, 0.8) 0%, rgba(15, 23, 42, 0.8) 100%); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 24px; padding: 40px; position: relative; overflow: hidden;">
          <div style="position: absolute; top: 0; left: 0; width: 100%; height: 4px; background: linear-gradient(90deg, #0ea5e9, #06b6d4);"></div>
          <div style="width: 80px; height: 80px; background: rgba(14, 165, 233, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 24px; font-size: 36px;">
            🔍
          </div>
          <h3 style="font-size: 22px; font-weight: 800; color: white; margin-bottom: 12px;">Evaluación de Riesgo Profunda</h3>
          <p style="font-size: 15px; color: #94a3b8; line-height: 1.7; margin-bottom: 20px;">Análisis completo de vulnerabilidades en infraestructura de red crítica con más de 500 endpoints.</p>
          <div style="display: flex; align-items: center; gap: 8px; color: #0ea5e9; font-weight: 700; font-size: 14px;">
            Ver Resultados
            <svg style="width: 16px; height: 16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </div>
        </div>

        <div style="background: linear-gradient(135deg, rgba(30, 41, 59, 0.8) 0%, rgba(15, 23, 42, 0.8) 100%); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 24px; padding: 40px; position: relative; overflow: hidden;">
          <div style="position: absolute; top: 0; left: 0; width: 100%; height: 4px; background: linear-gradient(90deg, #06b6d4, #10b981);"></div>
          <div style="width: 80px; height: 80px; background: rgba(6, 182, 212, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 24px; font-size: 36px;">
            🛡️
          </div>
          <h3 style="font-size: 22px; font-weight: 800; color: white; margin-bottom: 12px;">Respuesta a Brecha Crítica</h3>
          <p style="font-size: 15px; color: #94a3b8; line-height: 1.7; margin-bottom: 20px;">Neutralización de ataque ransomware en menos de 4 horas con recuperación completa de datos.</p>
          <div style="display: flex; align-items: center; gap: 8px; color: #06b6d4; font-weight: 700; font-size: 14px;">
            Ver Resultados
            <svg style="width: 16px; height: 16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </div>
        </div>

        <div style="background: linear-gradient(135deg, rgba(30, 41, 59, 0.8) 0%, rgba(15, 23, 42, 0.8) 100%); border: 1px solid rgba(255, 255, 255, 0.05); border-radius: 24px; padding: 40px; position: relative; overflow: hidden;">
          <div style="position: absolute; top: 0; left: 0; width: 100%; height: 4px; background: linear-gradient(90deg, #10b981, #059669);"></div>
          <div style="width: 80px; height: 80px; background: rgba(16, 185, 129, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin-bottom: 24px; font-size: 36px;">
            📊
          </div>
          <h3 style="font-size: 22px; font-weight: 800; color: white; margin-bottom: 12px;">Implementación de Red Segura</h3>
          <p style="font-size: 15px; color: #94a3b8; line-height: 1.7; margin-bottom: 20px;">Despliegue de arquitectura zero-trust en empresa multinacional con 1200+ usuarios.</p>
          <div style="display: flex; align-items: center; gap: 8px; color: #10b981; font-weight: 700; font-size: 14px;">
            Ver Resultados
            <svg style="width: 16px; height: 16px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ARQUITECTURA -->
  <section style="background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%); padding: 100px 40px;">
    <div style="max-width: 1400px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 80px;">
        <h2 style="font-size: clamp(40px, 5vw, 56px); font-weight: 900; color: white; margin-bottom: 24px;">
          Arquitectura de Red en Capas
        </h2>
        <p style="font-size: 20px; color: #94a3b8; max-width: 800px; margin: 0 auto;">
          Diseño modular y escalable que crece con tu negocio
        </p>
      </div>

      <div style="background: rgba(15, 23, 42, 0.5); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 32px; padding: 60px; max-width: 900px; margin: 0 auto;">
        <div style="display: grid; gap: 24px;">
          <div style="display: grid; grid-template-columns: 100px 1fr; gap: 24px; align-items: center; padding: 24px; background: rgba(14, 165, 233, 0.05); border-left: 4px solid #0ea5e9; border-radius: 12px;">
            <div style="font-size: 48px; font-weight: 900; color: #0ea5e9;">01</div>
            <div>
              <h3 style="font-size: 22px; font-weight: 800; color: white; margin-bottom: 8px;">Capa de Acceso</h3>
              <p style="font-size: 15px; color: #94a3b8; line-height: 1.6;">Switches y puntos de acceso WiFi 6 con segmentación VLAN y autenticación 802.1X.</p>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 100px 1fr; gap: 24px; align-items: center; padding: 24px; background: rgba(6, 182, 212, 0.05); border-left: 4px solid #06b6d4; border-radius: 12px;">
            <div style="font-size: 48px; font-weight: 900; color: #06b6d4;">02</div>
            <div>
              <h3 style="font-size: 22px; font-weight: 800; color: white; margin-bottom: 8px;">Capa de Distribución</h3>
              <p style="font-size: 15px; color: #94a3b8; line-height: 1.6;">Agregación de tráfico con redundancia y balanceo de carga automático.</p>
            </div>
          </div>

          <div style="display: grid; grid-template-columns: 100px 1fr; gap: 24px; align-items: center; padding: 24px; background: rgba(16, 185, 129, 0.05); border-left: 4px solid #10b981; border-radius: 12px;">
            <div style="font-size: 48px; font-weight: 900; color: #10b981;">03</div>
            <div>
              <h3 style="font-size: 22px; font-weight: 800; color: white; margin-bottom: 8px;">Capa de Core</h3>
              <p style="font-size: 15px; color: #94a3b8; line-height: 1.6;">Backbone de alta velocidad con enrutamiento dinámico y QoS empresarial.</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="contacto" style="background: #0f172a; padding: 120px 40px; border-top: 1px solid rgba(255, 255, 255, 0.05);">
    <div style="max-width: 1000px; margin: 0 auto; text-align: center;">
      <h2 style="font-size: clamp(36px, 4vw, 48px); font-weight: 900; color: white; margin-bottom: 24px;">
        ¿Listo para Modernizar su Red?
      </h2>
      <p style="font-size: 18px; color: #94a3b8; margin-bottom: 40px; max-width: 700px; margin-left: auto; margin-right: auto;">
        Solicite una evaluación gratuita de su infraestructura actual
      </p>

      <form action="/api/contact" method="POST" style="max-width: 600px; margin: 0 auto;">
        <div style="display: grid; gap: 20px;">
          <input type="text" name="nombre" placeholder="Nombre completo" required style="padding: 18px 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; color: white; font-size: 16px;" />
          <input type="email" name="email" placeholder="Email corporativo" required style="padding: 18px 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; color: white; font-size: 16px;" />
          <textarea name="mensaje" placeholder="Descripción de su proyecto..." rows="4" required style="padding: 18px 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; color: white; font-size: 16px;"></textarea>
          <button type="submit" style="padding: 20px; background: linear-gradient(135deg, #0ea5e9, #0284c7); color: white; font-weight: 700; font-size: 18px; border-radius: 12px; border: none; cursor: pointer;">
            Solicitar Evaluación Gratuita
          </button>
        </div>
      </form>
    </div>
  </section>
</Layout>
