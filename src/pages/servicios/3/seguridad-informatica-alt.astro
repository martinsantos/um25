---
// VERSIÓN ALTERNATIVA - SEGURIDAD INFORMÁTICA
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Seguridad Informática - Nueva Estética | ULTIMA MILLA">
  <style>
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
  </style>

  <!-- HERO -->
  <section style="position: relative; min-height: 650px; background: linear-gradient(135deg, #1e1b4b 0%, #0f172a 100%); color: white; overflow: hidden;">
    <div style="position: absolute; inset: 0; opacity: 0.04; background-image: url('data:image/svg+xml,%3Csvg width=&quot;40&quot; height=&quot;40&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cpath d=&quot;M0 20h20v20H0z&quot; fill=&quot;%23a855f7&quot;/%3E%3C/svg%3E');"></div>
    <div style="position: absolute; top: -100px; right: -100px; width: 600px; height: 600px; background: radial-gradient(circle, rgba(168, 85, 247, 0.15) 0%, transparent 70%); filter: blur(80px);"></div>

    <div style="max-width: 1400px; margin: 0 auto; padding: 140px 40px 80px; position: relative; z-index: 10;">
      <div style="max-width: 950px; margin: 0 auto; text-align: center;">
        <div style="display: inline-flex; align-items: center; gap: 10px; padding: 10px 24px; background: rgba(168, 85, 247, 0.15); border: 1px solid rgba(168, 85, 247, 0.3); border-radius: 50px; margin-bottom: 32px;">
          <div style="width: 8px; height: 8px; background: #a855f7; border-radius: 50%; animation: pulse 2s ease-in-out infinite;"></div>
          <span style="font-size: 13px; font-weight: 700; color: #a855f7; text-transform: uppercase; letter-spacing: 1.5px;">Defensa Cibernética</span>
        </div>

        <h1 style="font-size: clamp(52px, 7vw, 80px); font-weight: 900; line-height: 1.05; margin-bottom: 32px; letter-spacing: -0.03em;">
          Cada Segundo Cuenta.<br/>Previene la Próxima Brecha
        </h1>

        <p style="font-size: 22px; line-height: 1.7; color: #cbd5e1; margin-bottom: 48px; max-width: 800px; margin-left: auto; margin-right: auto;">
          Visualiza el panorama de amenazas en tiempo real y descubre cómo protegemos tus activos más críticos.
        </p>

        <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
          <a href="#evaluacion" style="display: inline-flex; align-items: center; gap: 12px; padding: 20px 40px; background: linear-gradient(135deg, #a855f7, #9333ea); color: white; font-weight: 700; font-size: 17px; border-radius: 12px; text-decoration: none; box-shadow: 0 12px 45px rgba(168, 85, 247, 0.35);">
            Evaluación Gratuita
            <svg style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- NIVEL DE RIESGO -->
  <section style="background: #0f172a; padding: 100px 40px;">
    <div style="max-width: 1400px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 80px;">
        <h2 style="font-size: clamp(40px, 5vw, 56px); font-weight: 900; color: white; margin-bottom: 24px;">
          ¿Cuál es tu Nivel de Riesgo Real?
        </h2>
        <p style="font-size: 20px; color: #94a3b8; max-width: 800px; margin: 0 auto;">
          Responde estas preguntas para obtener una evaluación preliminar de tu postura de seguridad
        </p>
      </div>

      <div style="max-width: 900px; margin: 0 auto; background: rgba(15, 23, 42, 0.5); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 24px; padding: 60px;">
        <div style="display: grid; gap: 32px;">
          <div style="padding: 24px; background: rgba(168, 85, 247, 0.05); border: 1px solid rgba(168, 85, 247, 0.2); border-radius: 16px;">
            <h3 style="font-size: 20px; font-weight: 800; color: white; margin-bottom: 20px;">
              ¿Utiliza su organización autenticación multifactor (MFA) para todos los accesos críticos?
            </h3>
            <div style="display: grid; gap: 12px;">
              <button style="padding: 16px 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px; color: white; font-size: 16px; text-align: left; cursor: pointer; transition: all 0.3s;">
                Sí, en todo
              </button>
              <button style="padding: 16px 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px; color: white; font-size: 16px; text-align: left; cursor: pointer; transition: all 0.3s;">
                Parcialmente
              </button>
              <button style="padding: 16px 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 10px; color: white; font-size: 16px; text-align: left; cursor: pointer; transition: all 0.3s;">
                No / No estoy seguro
              </button>
            </div>
          </div>

          <div style="text-align: center; padding-top: 20px;">
            <a href="#evaluacion" style="display: inline-flex; align-items: center; gap: 10px; padding: 16px 32px; background: linear-gradient(135deg, #a855f7, #9333ea); color: white; font-weight: 700; font-size: 16px; border-radius: 10px; text-decoration: none;">
              Siguiente →
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- PROTECCIÓN ADAPTADA -->
  <section style="background: linear-gradient(180deg, #0f172a 0%, #1e1b4b 100%); padding: 100px 40px;">
    <div style="max-width: 1400px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 80px;">
        <h2 style="font-size: clamp(40px, 5vw, 56px); font-weight: 900; color: white; margin-bottom: 24px;">
          Tu Postura de Seguridad Actual No Es Definitiva
        </h2>
        <p style="font-size: 20px; color: #94a3b8; max-width: 800px; margin: 0 auto;">
          En el primer paso hacia una protección robusta, nuestro equipo evalúa tu infraestructura y te proporciona un plan de acción personalizado
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 32px;">
        <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(168, 85, 247, 0.2); border-radius: 20px; padding: 40px; text-align: center;">
          <div style="width: 80px; height: 80px; background: linear-gradient(135deg, rgba(168, 85, 247, 0.2), rgba(168, 85, 247, 0.05)); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px; font-size: 36px;">
            🛡️
          </div>
          <h3 style="font-size: 22px; font-weight: 800; color: white; margin-bottom: 16px;">Detección Proactiva</h3>
          <p style="font-size: 16px; color: #94a3b8; line-height: 1.7;">Identificamos amenazas antes de que se conviertan en incidentes con IA y machine learning.</p>
        </div>

        <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(168, 85, 247, 0.2); border-radius: 20px; padding: 40px; text-align: center;">
          <div style="width: 80px; height: 80px; background: linear-gradient(135deg, rgba(168, 85, 247, 0.2), rgba(168, 85, 247, 0.05)); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px; font-size: 36px;">
            ⚡
          </div>
          <h3 style="font-size: 22px; font-weight: 800; color: white; margin-bottom: 16px;">Respuesta a Incidentes</h3>
          <p style="font-size: 16px; color: #94a3b8; line-height: 1.7;">En caso de brecha, nuestro equipo neutraliza la amenaza y recupera la operación normal.</p>
        </div>

        <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(168, 85, 247, 0.2); border-radius: 20px; padding: 40px; text-align: center;">
          <div style="width: 80px; height: 80px; background: linear-gradient(135deg, rgba(168, 85, 247, 0.2), rgba(168, 85, 247, 0.05)); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px; font-size: 36px;">
            🔄
          </div>
          <h3 style="font-size: 22px; font-weight: 800; color: white; margin-bottom: 16px;">Gestión Continua</h3>
          <p style="font-size: 16px; color: #94a3b8; line-height: 1.7;">Monitoreo 24/7 y actualizaciones constantes para mantener tu seguridad al día.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA EVALUACIÓN -->
  <section id="evaluacion" style="background: #0f172a; padding: 120px 40px; border-top: 1px solid rgba(255, 255, 255, 0.05);">
    <div style="max-width: 1000px; margin: 0 auto; text-align: center;">
      <div style="background: linear-gradient(135deg, rgba(168, 85, 247, 0.1) 0%, rgba(147, 51, 234, 0.05) 100%); border: 1px solid rgba(168, 85, 247, 0.2); border-radius: 32px; padding: 80px 60px;">
        <h2 style="font-size: clamp(36px, 4vw, 48px); font-weight: 900; color: white; margin-bottom: 24px;">
          Solicita una Evaluación de Seguridad Gratuita
        </h2>
        <p style="font-size: 18px; color: #94a3b8; margin-bottom: 40px; max-width: 700px; margin-left: auto; margin-right: auto;">
          Nuestro equipo analizará tu infraestructura y te proporcionará un informe detallado sin compromiso
        </p>

        <form action="/api/contact" method="POST" style="max-width: 600px; margin: 0 auto;">
          <div style="display: grid; gap: 20px;">
            <input type="text" name="nombre" placeholder="Nombre completo" required style="padding: 18px 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; color: white; font-size: 16px;" />
            <input type="email" name="email" placeholder="Email corporativo" required style="padding: 18px 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; color: white; font-size: 16px;" />
            <input type="tel" name="telefono" placeholder="Teléfono" style="padding: 18px 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; color: white; font-size: 16px;" />
            <button type="submit" style="padding: 20px; background: linear-gradient(135deg, #a855f7, #9333ea); color: white; font-weight: 700; font-size: 18px; border-radius: 12px; border: none; cursor: pointer; box-shadow: 0 10px 40px rgba(168, 85, 247, 0.3);">
              Solicitar Evaluación Ahora
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>
