---
import Layout from '../../../layouts/Layout.astro';
import { generateSlug } from '../../../utils/slugUtils.js';
import { serviciosReales, serviciosPorId } from '../../../data/servicios_reales_db.js';
import { getServiceImageUrl } from '../../../utils/imageUtils.js';

// Obtener parámetros de la URL
const { id, slug } = Astro.params;

// Buscar el servicio por ID
const servicio = serviciosPorId[parseInt(id)];

// Si no se encuentra el servicio, devolver 404
if (!servicio) {
  return Astro.redirect('/404');
}

// Verificar que el slug coincida (para SEO)
const expectedSlug = generateSlug(servicio.Titulo);
if (slug !== expectedSlug) {
  return Astro.redirect(`/servicios/${id}/${expectedSlug}`);
}

// Usar la función utilitaria compartida para manejar imágenes
const getAssetUrl = getServiceImageUrl;

// Servicios relacionados (misma área, excluyendo el actual)
const serviciosRelacionados = serviciosReales
  .filter(s => s.Area === servicio.Area && s.id !== servicio.id)
  .slice(0, 3);
---

<Layout title={`${servicio.Titulo} - Servicios - Ultima Milla`}>
  <main class="min-h-screen bg-slate-50">
    <!-- Breadcrumb -->
    <nav class="bg-white border-b border-slate-200 sticky top-0 z-40 backdrop-blur-md bg-white/80">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <ol class="flex items-center space-x-2 text-sm text-slate-500">
          <li><a href="/" class="hover:text-blue-600 transition-colors">Inicio</a></li>
          <li><span class="mx-2 text-slate-300">/</span></li>
          <li><a href="/servicios" class="hover:text-blue-600 transition-colors">Servicios</a></li>
          <li><span class="mx-2 text-slate-300">/</span></li>
          <li class="text-blue-600 font-medium truncate max-w-[200px]">{servicio.Titulo}</li>
        </ol>
      </div>
    </nav>

    <!-- Hero Section Split -->
    <section class="relative bg-slate-900 overflow-hidden">
      <div class="absolute inset-0 bg-slate-900">
        <div class="absolute inset-0 bg-gradient-to-br from-blue-900/40 via-slate-900/90 to-slate-900/90 z-10"></div>
        <img 
          src={getAssetUrl(servicio.Imagen)} 
          alt={servicio.Titulo}
          class="w-full h-full object-cover opacity-30 blur-sm scale-105"
          onerror="this.src='/images/default-service.jpg'"
        />
      </div>

      <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 lg:py-24">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 lg:gap-20 items-center">
          <div class="space-y-8">
            <div class="inline-flex items-center space-x-2">
              <span class="px-3 py-1 rounded-full bg-blue-500/20 border border-blue-400/30 text-blue-300 text-sm font-semibold backdrop-blur-sm">
                {servicio.Area}
              </span>
              <span class="px-3 py-1 rounded-full bg-emerald-500/20 border border-emerald-400/30 text-emerald-300 text-sm font-semibold backdrop-blur-sm">
                {servicio.Cliente}
              </span>
            </div>
            
            <h1 class="text-4xl md:text-6xl font-bold text-white leading-tight">
              {servicio.Titulo}
            </h1>
            
            <p class="text-xl text-slate-300 leading-relaxed max-w-xl">
              {servicio.Descripcion.replace(/\\\\/g, '\n')}
            </p>

            <div class="flex flex-wrap gap-4 pt-4">
              <a href="#contacto" class="px-8 py-4 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition-all shadow-lg shadow-blue-600/30 transform hover:-translate-y-1">
                Solicitar Cotización
              </a>
              <a href="#detalles" class="px-8 py-4 bg-white/10 text-white font-bold rounded-xl hover:bg-white/20 transition-all backdrop-blur-sm border border-white/10">
                Ver Detalles
              </a>
            </div>
          </div>

          <div class="relative hidden lg:block">
            <div class="relative rounded-3xl overflow-hidden shadow-2xl shadow-blue-900/50 border border-white/10 transform rotate-2 hover:rotate-0 transition-transform duration-700">
              <div class="aspect-[4/3]">
                <img
                  src={getAssetUrl(servicio.Imagen)}
                  alt={servicio.Titulo}
                  class="w-full h-full object-cover"
                  onerror="this.src='/images/default-service.jpg'"
                />
              </div>
              <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
              <div class="absolute bottom-0 left-0 right-0 p-8">
                <div class="flex items-center justify-between text-white">
                  <div>
                    <p class="text-sm text-slate-300 uppercase tracking-wider mb-1">Unidad de Negocio</p>
                    <p class="text-xl font-bold">{servicio.Unidad_de_negocio}</p>
                  </div>
                  <div class="w-12 h-12 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center">
                    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                    </svg>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Contenido Principal -->
    <section id="detalles" class="py-16 lg:py-24">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 lg:gap-16">
          
          <!-- Columna Principal -->
          <div class="lg:col-span-2 space-y-16">
            
            <!-- Servicios Incluidos -->
            <div>
              <h2 class="text-3xl font-bold text-slate-900 mb-8 flex items-center">
                <span class="w-10 h-10 rounded-lg bg-blue-100 text-blue-600 flex items-center justify-center mr-4">
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                  </svg>
                </span>
                Servicios Incluidos
              </h2>
              <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                {servicio.Servicios && servicio.Servicios.map((item) => (
                  <div class="group bg-white p-6 rounded-2xl border border-slate-100 shadow-sm hover:shadow-md hover:border-blue-200 transition-all duration-300">
                    <div class="flex items-start space-x-4">
                      <div class="flex-shrink-0 w-8 h-8 rounded-full bg-green-100 text-green-600 flex items-center justify-center mt-1 group-hover:scale-110 transition-transform">
                        <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7" />
                        </svg>
                      </div>
                      <p class="text-lg font-medium text-slate-700 group-hover:text-slate-900">{item}</p>
                    </div>
                  </div>
                ))}
              </div>
            </div>

            <!-- Características -->
            <div>
              <h2 class="text-3xl font-bold text-slate-900 mb-8 flex items-center">
                <span class="w-10 h-10 rounded-lg bg-purple-100 text-purple-600 flex items-center justify-center mr-4">
                  <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </span>
                Características Destacadas
              </h2>
              <div class="bg-slate-50 rounded-3xl p-8 border border-slate-100">
                <div class="grid grid-cols-1 md:grid-cols-2 gap-y-6 gap-x-12">
                  {servicio.Caracteristicas && servicio.Caracteristicas.map((item) => (
                    <div class="flex items-center space-x-3">
                      <svg class="w-5 h-5 text-purple-600 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                      </svg>
                      <span class="text-slate-700 font-medium">{item}</span>
                    </div>
                  ))}
                </div>
              </div>
            </div>

          </div>

          <!-- Sidebar -->
          <div class="lg:col-span-1">
            <div class="sticky top-24 space-y-8">
              <!-- Card de Contacto -->
              <div id="contacto" class="bg-white rounded-3xl shadow-xl shadow-blue-900/5 p-8 border border-slate-100 overflow-hidden relative">
                <div class="absolute top-0 right-0 -mr-16 -mt-16 w-32 h-32 bg-blue-500/10 rounded-full blur-2xl"></div>
                
                <h3 class="text-2xl font-bold text-slate-900 mb-6 relative z-10">¿Interesado en este servicio?</h3>
                <p class="text-slate-600 mb-8 relative z-10">
                  Contáctenos para obtener una cotización personalizada para su empresa.
                </p>
                
                <form class="space-y-4 relative z-10">
                  <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Nombre</label>
                    <input type="text" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all" placeholder="Su nombre" />
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Email</label>
                    <input type="email" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all" placeholder="nombre@empresa.com" />
                  </div>
                  <div>
                    <label class="block text-sm font-medium text-slate-700 mb-1">Mensaje</label>
                    <textarea rows="3" class="w-full px-4 py-3 rounded-xl border border-slate-200 focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 outline-none transition-all" placeholder="Detalles de su consulta..."></textarea>
                  </div>
                  <button type="submit" class="w-full py-4 bg-blue-600 text-white font-bold rounded-xl hover:bg-blue-700 transition-all shadow-lg shadow-blue-500/30">
                    Enviar Consulta
                  </button>
                </form>
              </div>

              <!-- Info Adicional -->
              <div class="bg-slate-50 rounded-3xl p-8 border border-slate-100">
                <h4 class="font-bold text-slate-900 mb-4">Información Rápida</h4>
                <ul class="space-y-4 text-sm">
                  <li class="flex justify-between items-center pb-4 border-b border-slate-200 last:border-0 last:pb-0">
                    <span class="text-slate-500">ID Servicio</span>
                    <span class="font-mono font-medium text-slate-900">#{servicio.id.toString().padStart(4, '0')}</span>
                  </li>
                  <li class="flex justify-between items-center pb-4 border-b border-slate-200 last:border-0 last:pb-0">
                    <span class="text-slate-500">Área</span>
                    <span class="font-medium text-slate-900">{servicio.Area}</span>
                  </li>
                  <li class="flex justify-between items-center pb-4 border-b border-slate-200 last:border-0 last:pb-0">
                    <span class="text-slate-500">Cliente Tipo</span>
                    <span class="font-medium text-slate-900">{servicio.Cliente}</span>
                  </li>
                </ul>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

    <!-- Servicios Relacionados -->
    {serviciosRelacionados.length > 0 && (
      <section class="py-16 md:py-24 bg-white border-t border-slate-100">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="flex items-center justify-between mb-12">
            <h2 class="text-3xl font-bold text-slate-900">
              Otros servicios en <span class="text-blue-600">{servicio.Area}</span>
            </h2>
            <a href="/servicios" class="text-blue-600 font-medium hover:text-blue-700 flex items-center">
              Ver todos <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" /></svg>
            </a>
          </div>
          
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
            {serviciosRelacionados.map((relacionado) => {
              const slug = generateSlug(relacionado.Titulo);
              return (
                <a href={`/servicios/${relacionado.id}/${slug}`} class="group block">
                  <article class="bg-slate-50 rounded-2xl overflow-hidden hover:shadow-xl transition-all duration-300 border border-slate-100">
                    <div class="aspect-video relative overflow-hidden">
                      <img
                        src={getAssetUrl(relacionado.Imagen)}
                        alt={relacionado.Titulo}
                        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                        loading="lazy"
                        onerror="this.src='/images/default-service.jpg'"
                      />
                      <div class="absolute inset-0 bg-black/20 group-hover:bg-black/10 transition-colors"></div>
                    </div>
                    
                    <div class="p-6">
                      <h3 class="text-lg font-bold text-slate-900 mb-2 group-hover:text-blue-600 transition-colors">
                        {relacionado.Titulo}
                      </h3>
                      <p class="text-slate-600 text-sm line-clamp-2 mb-4">
                        {relacionado.Descripcion.replace(/\\\\/g, ' ')}
                      </p>
                      <span class="text-xs font-semibold text-blue-600 uppercase tracking-wider">
                        Ver más &rarr;
                      </span>
                    </div>
                  </article>
                </a>
              );
            })}
          </div>
        </div>
      </section>
    )}
  </main>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
