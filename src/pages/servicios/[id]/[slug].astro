---
/**
 * Service Detail Page - V4 Design System + Directus Integration
 * FASE 4: Conectado a Directus con fallback automático a datos JS
 *
 * Usa componentes V4:
 * - StatsBar
 * - ProductCard
 * - CTASection
 *
 * Usa helpers de Directus con fallback:
 * - getServicioById() con fallback a servicios_completos_v4.js
 */

import LayoutV4 from '../../../layouts/LayoutV4.astro';
import StatsBar from '../../../components/v4/StatsBar.astro';
import ProductCard from '../../../components/v4/ProductCard.astro';
import CTASection from '../../../components/v4/CTASection.astro';
import SectionHeader from '../../../components/um/SectionHeader.astro';
import UMButton from '../../../components/um/UMButton.astro';
import IntentLinkGraph from '../../../components/um/IntentLinkGraph.astro';
import EmailLink from '../../../components/common/EmailLink.astro';

import { generateSlug } from '../../../utils/slugUtils.js';
import { getServicioById } from '../../../utils/directusHelpers';
import { getDirectusImageUrl } from '../../../lib/directus.ts';
import { getServiceVisualSpec } from '../../../data/serviceVisualSystem';
import {
  serviceSingleDemoApproachSteps,
  serviceSingleDemoCapabilities,
  serviceSingleDemoCopy,
} from '../../../data/serviceSingleDemoSystem';
import { editorialImageDimensions } from '../../../data/editorialImageSystem';
import {
  plainTextFromHtml,
  readServiceSubtitulo,
  renderEditorialBody,
  sanitizeEditorialText,
  serviceHeroLead,
  sanitizeServiceStats,
  sanitizeServiceBulletList,
  sanitizeServicePageTitle,
  stripBannedLedgerPhrases,
} from '../../../utils/editorialContent';
import { shouldShowProductCardActions } from '../../../data/commercialPlacement';
import {
  buildServiceStrategicLinkGroups,
  buildStrategicWebPageStructuredData,
} from '../../../data/strategicLinkGraph';
import {
  cmsServiceTitle,
  isReplicaIdenticalCopy,
  resolveReplicaH1,
  resolveReplicaTitle,
} from '../../../utils/replicaProdCopy';
import { getDatasheetPublicPath } from '../../../utils/datasheets';

const { id, slug } = Astro.params;

if (!id || !slug) {
  return Astro.redirect('/404');
}

// Obtener servicio de Directus con fallback automático a JS
const servicio = await getServicioById(id);

if (!servicio) {
  return Astro.redirect('/404');
}

// Validar slug
const expectedSlug = servicio.slug || generateSlug(servicio.Titulo);
if (slug !== expectedSlug) {
  return Astro.redirect(`/servicios/${id}/${expectedSlug}`);
}

// Productos del servicio (viene de Directus o de JS)
const productos = servicio.productos || [];
const visual = getServiceVisualSpec(id);
const serviceImage = visual?.image || getDirectusImageUrl(servicio.Imagen);
const demoCopy = serviceSingleDemoCopy[Number(id)];
const serviceDetailPath = `/servicios/${id}/${expectedSlug}`;
const datasheetHref = getDatasheetPublicPath(expectedSlug);
const replicaProd = isReplicaIdenticalCopy();
const cmsTitle = cmsServiceTitle(servicio.Titulo);
const cmsSubtitulo = readServiceSubtitulo(servicio);
const editorialHeroTitle =
  (!replicaProd && demoCopy?.headline) || visual?.shortName || cmsTitle || servicio.Titulo;
const serviceHeroTitle = resolveReplicaH1(serviceDetailPath, editorialHeroTitle);
const serviceBreadcrumbLabel = visual?.shortName || cmsTitle;
const serviceCtaTitle = replicaProd
  ? `¿Listo para implementar ${cmsTitle}?`
  : visual?.shortName
    ? `Convertir ${visual.shortName.toLowerCase()} en un alcance verificable`
    : 'Convertir este servicio en un alcance verificable';
const descriptionSectionTitle = replicaProd ? 'Descripción del Servicio' : 'Alcance operativo';
const processSectionTitle = replicaProd ? 'Nuestro Proceso' : demoCopy?.approachHeading || 'Método de implementación';
const sidebarInfoTitle = replicaProd ? 'Información del Servicio' : 'Metadata del servicio';
const isCommercialProduct = (producto: any) => (
  ['producto', 'productos'].includes(String(producto.categoria_comercial || '').toLowerCase()) ||
  ['producto', 'productos'].includes(String(producto.categoria_informacion || '').toLowerCase()) ||
  Boolean(producto.tipo_producto) ||
  Boolean(producto.slug_producto) ||
  Boolean(producto.url_producto)
);
const commercialProducts = productos.filter(isCommercialProduct);
const hasCommercialProducts = commercialProducts.length > 0;
const productsSectionKicker = replicaProd ? '' : hasCommercialProducts ? 'Producto' : 'Equipamiento';
const productsSectionTitle = replicaProd
  ? 'Productos y Soluciones'
  : hasCommercialProducts
    ? 'Equipamiento y producto aplicado'
    : 'Equipamiento aplicado';
const productsSectionText = replicaProd
  ? ''
  : hasCommercialProducts
    ? 'Soluciones, materiales y producto vinculados al alcance real del servicio.'
    : 'Soluciones, materiales y equipamiento vinculados al alcance real del servicio.';

// SEO
const siteUrl = 'https://www.ultimamilla.com.ar';
const seoTitleRaw = replicaProd
  ? resolveReplicaTitle(serviceDetailPath, cmsTitle)
  : sanitizeServicePageTitle(Number(id), servicio.Titulo, visual?.shortName || serviceHeroTitle);
const seoTitleBase = seoTitleRaw.replace(/\s*\|\s*ULTIMA MILLA\s*$/i, '').trim();
let pageTitle = `${seoTitleBase} | ULTIMA MILLA`;
if (pageTitle.length > 60) {
  pageTitle =
    seoTitleBase.length > 45
      ? `${seoTitleBase.slice(0, 45)}… | ULTIMA MILLA`
      : `${seoTitleBase} | ULTIMA MILLA`;
}
const serviceBodySource = servicio.Descripcion?.replace(/\\/g, '\n') || '';
const serviceDescriptionHtml = await renderEditorialBody(serviceBodySource);
const rawDesc = stripBannedLedgerPhrases(plainTextFromHtml(serviceBodySource, 500));
const pageDescription = rawDesc.length > 155 ? rawDesc.slice(0, 155) + '...' :
  rawDesc.length > 0 && rawDesc.length < 120 ? `${rawDesc} Servicios profesionales de ULTIMA MILLA en Mendoza, Cuyo y Patagonia.`.slice(0, 155) :
  rawDesc || `${seoTitleBase} - Servicios tecnológicos en Mendoza, Cuyo y Patagonia.`;
const bodyPlainLead = plainTextFromHtml(serviceBodySource, 120);
const heroLead = serviceHeroLead(
  cmsSubtitulo,
  replicaProd ? undefined : visual?.proof,
  !replicaProd && demoCopy?.paragraph ? demoCopy.paragraph : pageDescription,
  bodyPlainLead,
);
const porQueElegirnos = sanitizeServiceBulletList(servicio.por_que_elegirnos || []);
const showGenericProcess =
  !replicaProd || porQueElegirnos.length === 0;
const displayStats = sanitizeServiceStats(servicio.stats || []).filter(
  (stat: any) => String(stat?.label || '').trim() && String(stat?.value || '').trim(),
);
const serviceBriefItems = [
  {
    label: 'Necesidad',
    value: visual?.proof || 'Continuidad operativa verificable',
  },
  {
    label: 'Método',
    value: 'Relevamiento, diseño, ejecución y prueba técnica',
  },
  {
    label: 'Salida',
    value: hasCommercialProducts ? 'Producto, implementación y soporte' : 'Implementación con evidencia técnica',
  },
];
const resolveServiceMedia = (image: unknown) => {
  const value = String(image || '').trim();
  if (!value) return serviceImage;
  if (value.startsWith('/') || /^https?:\/\//i.test(value)) return value;
  return getDirectusImageUrl(value) || serviceImage;
};
const demoCapabilities = serviceSingleDemoCapabilities[Number(id)] || [];
const cmsCapabilityFallback = servicio.Soluciones || [];
const serviceCapabilityItems = (demoCapabilities.length ? demoCapabilities : cmsCapabilityFallback)
  .slice(0, 6)
  .map((item: any, index: number) => {
    const title = sanitizeEditorialText(
      item.title || item.titulo || item.nombre || item.headline || `Capacidad ${index + 1}`
    );
    const description =
      plainTextFromHtml(item.description || item.descripcion || item.servicio_asociado || item.headline || '', 170) ||
      visual?.proof ||
      pageDescription;
    return {
      number: item.number || String(index + 1).padStart(2, '0'),
      title,
      description,
      image: resolveServiceMedia(item.imagen || item.image),
      imageAlt: item.imageAlt || `${title} - ${visual?.shortName || cmsTitle}`,
    };
  });
const serviceApproachSteps = serviceSingleDemoApproachSteps[Number(id)] || [
  {
    number: '01',
    title: 'Relevamiento',
    description: 'Medimos sitio, dependencias, riesgos y prioridades antes de definir alcance.',
  },
  {
    number: '02',
    title: 'Diseño e ingeniería',
    description: 'Proyectamos arquitectura, materiales, plazos y responsables con criterio operativo.',
  },
  {
    number: '03',
    title: 'Implementación',
    description: 'Ejecutamos en sitio con mínima interrupción y control técnico de cada etapa.',
  },
  {
    number: '04',
    title: 'Evidencia y soporte',
    description: 'Entregamos pruebas verificables, documentación útil y continuidad posterior.',
  },
];
const canonicalUrl = `${siteUrl}/servicios/${id}/${slug}`;
const serviceStrategicLinkGroups = buildServiceStrategicLinkGroups({
  currentPath: serviceDetailPath,
  serviceId: id,
  serviceName: visual?.shortName || cmsTitle,
  title: serviceHeroTitle,
  summary: pageDescription,
  text: [
    servicio.Titulo,
    servicio.area,
    servicio.Area,
    servicio.Subtitulo,
    productos.map((producto: any) => `${producto.titulo || producto.nombre || ''} ${producto.descripcion || ''}`).join(' '),
  ].filter(Boolean).join(' '),
});

// Structured Data - Service schema
const serviceStructuredData = {
  "@type": "Service",
  "name": seoTitleBase,
  "description": pageDescription,
  "url": canonicalUrl,
  "mainEntityOfPage": canonicalUrl,
  "significantLink": [
    `${siteUrl}/servicios`,
    `${siteUrl}/antecedentes`,
    `${siteUrl}/sectores`,
    `${siteUrl}/contacto`,
  ],
  "image": serviceImage.startsWith('http') ? serviceImage : `${siteUrl}${serviceImage}`,
  "provider": {
    "@type": "Organization",
    "name": "ULTIMA MILLA",
    "url": siteUrl
  },
  "areaServed": [
    { "@type": "City", "name": "Mendoza" },
    { "@type": "City", "name": "San Juan" },
    { "@type": "City", "name": "San Luis" },
    { "@type": "AdministrativeArea", "name": "Patagonia" }
  ],
  ...(servicio.area && { "serviceType": servicio.area }),
  ...(commercialProducts.length > 0 && {
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": `Productos de ${servicio.Titulo}`,
      "itemListElement": commercialProducts.map((p: any) => ({
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": p.titulo,
          ...(p.descripcion && { "description": plainTextFromHtml(p.descripcion, 300) })
        }
      }))
    }
  }),
  "inLanguage": "es"
};
const servicePageStructuredData = [
  serviceStructuredData,
  buildStrategicWebPageStructuredData({
    url: canonicalUrl,
    name: pageTitle,
    description: pageDescription,
    groups: serviceStrategicLinkGroups,
  }),
];

---

<LayoutV4
  title={pageTitle}
  description={pageDescription}
  keywords={`${servicio.Titulo.toLowerCase()}${servicio.area ? `, ${servicio.area.toLowerCase()}` : ''}, servicios tecnologicos mendoza`}
  image={serviceImage}
  imageWidth={editorialImageDimensions.width}
  imageHeight={editorialImageDimensions.height}
  canonical={canonicalUrl}
  structuredData={servicePageStructuredData}
>
  <section class="service-detail-hero">
    <div class="service-detail-hero__image">
      <img
        src={serviceImage}
        alt={visual?.imageAlt || servicio.Titulo}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width={editorialImageDimensions.width}
        height={editorialImageDimensions.height}
      />
    </div>
    <div class="service-detail-hero__wash"></div>

    <div class="um-container service-detail-hero__content">
      <nav class="service-detail-breadcrumb" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <span>/</span>
        <a href="/servicios" class="hover:text-white transition-colors">Servicios</a>
        <span>/</span>
        <span class="service-detail-breadcrumb__current">{serviceBreadcrumbLabel}</span>
      </nav>

      <div class="service-detail-hero__grid">
        <div>
          <span class="service-detail-label">{visual?.eyebrow || servicio.area || 'Servicio IT integral'}</span>
          <h1>{serviceHeroTitle}</h1>
          <p>{heroLead}</p>
          <div class="service-detail-hero__actions" aria-label="Acciones principales del servicio">
            <UMButton href="/contacto">Solicitar diagnóstico</UMButton>
            <UMButton href="/antecedentes" variant="secondary">Ver evidencia</UMButton>
          </div>
        </div>
        <aside class="service-detail-proof">
          <div>
            <strong>{visual?.shortName || 'IT'}</strong>
            <span>frente técnico</span>
          </div>
          <div>
            <strong>{visual?.signal || 'operación'} / 24-7</strong>
            <span>diseño y soporte</span>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- STATS BAR - Componente V4 -->
  {displayStats.length > 1 && (
    <StatsBar stats={displayStats} />
  )}

  <!-- MAIN CONTENT -->
  <section class="service-detail-main">
    <div class="um-container">
      <div class="service-executive-brief" aria-label="Resumen ejecutivo del servicio">
        <div class="service-executive-brief__head">
          <span>Resumen ejecutivo</span>
          <h2>Del diagnóstico al alcance verificable.</h2>
        </div>
        <dl class="service-executive-brief__ledger">
          {serviceBriefItems.map((item) => (
            <div>
              <dt>{item.label}</dt>
              <dd>{item.value}</dd>
            </div>
          ))}
        </dl>
      </div>

      {serviceCapabilityItems.length > 0 && (
        <section class="service-capabilities-showcase" aria-labelledby="service-capabilities-title">
          <header class="service-capabilities-showcase__head">
            <span aria-hidden="true"></span>
            <p>Alcance del servicio</p>
            <h2 id="service-capabilities-title">Qué cubre {visual?.shortName || cmsTitle}.</h2>
            <p>
              {demoCopy?.capabilitiesIntro || 'Un mismo equipo releva, diseña, implementa y sostiene cada frente técnico con evidencia verificable.'}
            </p>
          </header>

          <div class="service-capability-grid" aria-label={`Capacidades de ${visual?.shortName || cmsTitle}`}>
            {serviceCapabilityItems.map((item) => (
              <article class="service-capability-card">
                <div class="service-capability-card__media">
                  <img
                    src={item.image}
                    alt={item.imageAlt}
                    loading="lazy"
                    decoding="async"
                    width={editorialImageDimensions.width}
                    height={editorialImageDimensions.height}
                  />
                  <span>{item.number}</span>
                </div>
                <div class="service-capability-card__copy">
                  <h3>{item.title}</h3>
                  <p>{item.description}</p>
                </div>
              </article>
            ))}
          </div>
        </section>
      )}

      <div class="service-detail-main__grid">

        <!-- Main Content -->
        <div class="service-detail-main__body">
          <h2 class="service-detail-section-title">{descriptionSectionTitle}</h2>
          <div class="prose prose-lg max-w-none text-um-gray mb-12 service-detail-copy editorial-body">
            {serviceDescriptionHtml ? (
              <div set:html={serviceDescriptionHtml} />
            ) : (
              <p>Alcance técnico definido bajo relevamiento de sitio y criterios operativos verificables.</p>
            )}
          </div>

          <!-- Por Qué Elegirnos -->
          {porQueElegirnos.length > 0 && (
            <div class="service-why">
              <h3 class="service-detail-subtitle">Por qué elegirnos</h3>
              <ul class="space-y-3">
                {porQueElegirnos.map((item) => (
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span class="text-um-dark">{sanitizeEditorialText(item)}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <div class="service-detail-main__aside">
          <!-- Quick Info Card -->
          <div class="service-info-card service-info-card--dossier">
            <header class="service-info-head">
              <p>Ficha técnica</p>
              <h2>{sidebarInfoTitle}</h2>
            </header>

            <dl class="service-info-ledger" aria-label="Información operativa del servicio">
              <div>
                <dt>Implementación</dt>
                <dd>2-8 semanas</dd>
              </div>
              <div>
                <dt>Garantía</dt>
                <dd>5 años en materiales</dd>
              </div>
              <div>
                <dt>Cobertura</dt>
                <dd>Mendoza, Cuyo y Patagonia</dd>
              </div>
            </dl>

            {datasheetHref && (
              <a href={datasheetHref} class="service-datasheet-btn" download>
                Ficha técnica (PDF)
              </a>
            )}

            <div class="service-info-actions">
              <UMButton href="/contacto" class="service-info-primary">
                Solicitar diagnóstico
              </UMButton>
              <EmailLink class="um-click-surface service-info-secondary" />
            </div>
          </div>

          <!-- Brands -->
          {servicio.marcas && servicio.marcas.length > 0 && (
            <div class="service-info-card">
              <h3 class="font-bold text-um-dark mb-4 text-lg">Marcas compatibles</h3>
              <div class="flex flex-wrap gap-3">
                {servicio.marcas.map((marca) => (
                  <span class="px-3 py-1 bg-white rounded-[4px] text-base text-um-gray border">{marca}</span>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  {showGenericProcess && (
    <section class="service-approach-band" aria-labelledby="service-approach-title">
      <div class="um-container service-approach-band__grid">
        <figure class="service-approach-band__media">
          <img
            src={serviceImage}
            alt={visual?.imageAlt || servicio.Titulo}
            loading="lazy"
            decoding="async"
            width={editorialImageDimensions.width}
            height={editorialImageDimensions.height}
          />
          <figcaption>{visual?.shortName || cmsTitle} · Mendoza, Cuyo y Patagonia</figcaption>
        </figure>

        <div class="service-approach-band__copy">
          <span class="service-approach-band__rule" aria-hidden="true"></span>
          <p class="service-approach-band__eyebrow">Cómo trabajamos</p>
          <h2 id="service-approach-title">{processSectionTitle}</h2>
          <p>
            {demoCopy?.approachIntro || 'Nadie hereda un problema a medias: el mismo equipo conecta diagnóstico, ingeniería, implementación, prueba y soporte.'}
          </p>

          <ol class="service-approach-steps">
            {serviceApproachSteps.map((step) => (
              <li>
                <span>{step.number}</span>
                <h3>{step.title}</h3>
                <p>{step.description}</p>
              </li>
            ))}
          </ol>
        </div>
      </div>
    </section>
  )}

  <!-- PRODUCTOS Y EQUIPAMIENTO - Usando componente ProductCard V4 -->
  {commercialProducts.length > 0 && (
    <section class="service-products-section">
      <div class="um-container">
        <div class="service-products-head">
          <SectionHeader
            kicker={productsSectionKicker}
            title={productsSectionTitle}
            text={productsSectionText}
          />
        </div>

        <div class="service-products-list">
          {commercialProducts.map((producto, index) => (
            <ProductCard
              titulo={producto.titulo || producto.nombre || 'Equipamiento'}
              descripcion={producto.descripcion || ''}
              imagen={producto.imagen}
              features={producto.features || []}
              destacado={producto.destacado}
              marcas={producto.marcas || []}
              orden={index}
              serviceId={id}
              serviceName={visual?.shortName || servicio.Titulo.split('|')[0]?.trim() || servicio.Titulo}
              serviceCategory={producto.categoria_comercial || servicio.area || servicio.Area || visual?.eyebrow}
              serviceHref={`/servicios/${id}/${slug}`}
              ctaLabel={producto.slug_producto === 'cctv-ai-integrado' ? 'Ver producto' : [102, 107].includes(Number(id)) ? 'Solicitar relevamiento' : 'Cotizar solución'}
              ctaHref={producto.url_producto || (producto.slug_producto === 'cctv-ai-integrado' ? '/cctvai/' : '/contacto')}
              showActions={producto.slug_producto === 'cctv-ai-integrado' || shouldShowProductCardActions({ index, total: commercialProducts.length })}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <IntentLinkGraph
    kicker="Para avanzar"
    title="Ver también"
    text="Servicios relacionados, sectores donde aplica, casos comparables y contacto técnico para relevar alcance."
    groups={serviceStrategicLinkGroups}
  />

  <!-- CTA SECTION - Componente V4 -->
  <CTASection
    badge="Diagnóstico técnico"
    badgeIcon="rocket"
    titulo={serviceCtaTitle}
    descripcion="Revisamos sitio, riesgos, dependencias y objetivo operativo antes de proponer una solución."
    primaryButtonText="Solicitar diagnóstico"
    primaryButtonUrl="/contacto"
    secondaryButtonText="Escribir por email"
    secondaryButtonUrl="/contacto"
    secondaryButtonIcon="mail"
    backgroundImage={serviceImage}
  />
</LayoutV4>

<style>
  /* Line clamp utility */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .service-detail-hero {
    position: relative;
    overflow: hidden;
    min-height: clamp(400px, 50vh, 540px);
    background: #080808;
    color: #fff;
    max-width: 100%;
  }

  .service-detail-hero__image,
  .service-detail-hero__wash {
    position: absolute;
    inset: 0;
  }

  .service-detail-hero__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(1.04) contrast(1.08) brightness(0.86);
  }

  .service-detail-hero__wash {
    background:
      linear-gradient(90deg, rgba(8,8,8,0.94) 0%, rgba(8,8,8,0.84) 34%, rgba(8,8,8,0.38) 68%, rgba(8,8,8,0.08) 100%),
      linear-gradient(0deg, rgba(8,8,8,0.82) 0%, rgba(8,8,8,0.1) 68%);
  }

  .service-detail-hero__content {
    position: relative;
    z-index: 1;
    padding-top: clamp(22px, 2.8vw, 38px);
    padding-bottom: clamp(30px, 3.8vw, 52px);
  }

  .service-detail-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-bottom: clamp(18px, 3vw, 34px);
    color: rgba(255,255,255,0.58);
    font-size: 1rem;
    font-weight: 700;
    min-width: 0;
  }

  .service-detail-breadcrumb span,
  .service-detail-breadcrumb a {
    overflow-wrap: anywhere;
  }

  .service-detail-breadcrumb__current {
    max-width: min(100%, 42ch);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: rgba(255,255,255,0.76);
  }

  .service-detail-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.68fr) minmax(300px, 0.32fr);
    gap: clamp(32px, 5.2vw, 72px);
    align-items: start;
    min-width: 0;
  }

  .service-detail-hero__grid > * {
    min-width: 0;
  }

  .service-detail-label {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1rem;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1rem;
    font-weight: 700;
