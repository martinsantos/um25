---
/**
 * Service Detail Page - V4 Design System + Directus Integration
 * FASE 4: Conectado a Directus con fallback automático a datos JS
 *
 * Usa componentes V4:
 * - StatsBar
 * - ProductCard
 * - CTASection
 *
 * Usa helpers de Directus con fallback:
 * - getServicioById() con fallback a servicios_completos_v4.js
 */

import LayoutV4 from '../../../layouts/LayoutV4.astro';
import StatsBar from '../../../components/v4/StatsBar.astro';
import ProductCard from '../../../components/v4/ProductCard.astro';
import CTASection from '../../../components/v4/CTASection.astro';
import SectionHeader from '../../../components/um/SectionHeader.astro';
import UMButton from '../../../components/um/UMButton.astro';

import { generateSlug } from '../../../utils/slugUtils.js';
import { getServicioById } from '../../../utils/directusHelpers';
import { getDirectusImageUrl } from '../../../lib/directus.ts';
import { getServiceVisualSpec } from '../../../data/serviceVisualSystem';
import {
  plainTextFromHtml,
  readServiceSubtitulo,
  renderEditorialBody,
  sanitizeEditorialText,
  serviceHeroLead,
  sanitizeServiceStats,
  sanitizeServiceBulletList,
  sanitizeServicePageTitle,
  stripBannedLedgerPhrases,
} from '../../../utils/editorialContent';
import { shouldShowProductCardActions } from '../../../data/commercialPlacement';
import {
  cmsServiceTitle,
  isReplicaIdenticalCopy,
  resolveReplicaH1,
  resolveReplicaTitle,
} from '../../../utils/replicaProdCopy';
import { getDatasheetPublicPath } from '../../../utils/datasheets';

const { id, slug } = Astro.params;

if (!id || !slug) {
  return Astro.redirect('/404');
}

// Obtener servicio de Directus con fallback automático a JS
const servicio = await getServicioById(id);

if (!servicio) {
  return Astro.redirect('/404');
}

// Validar slug
const expectedSlug = servicio.slug || generateSlug(servicio.Titulo);
if (slug !== expectedSlug) {
  return Astro.redirect(`/servicios/${id}/${expectedSlug}`);
}

// Productos del servicio (viene de Directus o de JS)
const productos = servicio.productos || [];
const visual = getServiceVisualSpec(id);
const serviceImage = visual?.image || getDirectusImageUrl(servicio.Imagen);
const serviceHeroTitles: Record<number, string> = {
  101: 'Redes y conectividad para operación continua',
  102: 'Seguridad electrónica para activos críticos',
  103: 'Comunicaciones estables para sedes exigentes',
  104: 'Software operativo para procesos reales',
  105: 'Soporte 24/7 para continuidad operativa',
  106: 'Arquitectura IT para decidir con evidencia',
  107: 'Detección de incendios para infraestructura crítica',
  108: 'Energía confiable para sistemas IT'
};
const serviceDetailPath = `/servicios/${id}/${expectedSlug}`;
const datasheetHref = getDatasheetPublicPath(expectedSlug);
const replicaProd = isReplicaIdenticalCopy();
const cmsTitle = cmsServiceTitle(servicio.Titulo);
const cmsSubtitulo = readServiceSubtitulo(servicio);
const editorialHeroTitle =
  serviceHeroTitles[Number(id)] || visual?.shortName || cmsTitle || servicio.Titulo;
const serviceHeroTitle = resolveReplicaH1(serviceDetailPath, editorialHeroTitle);
const serviceBreadcrumbLabel = visual?.shortName || cmsTitle;
const serviceCtaTitle = replicaProd
  ? `¿Listo para implementar ${cmsTitle}?`
  : visual?.shortName
    ? `Convertir ${visual.shortName.toLowerCase()} en un alcance verificable`
    : 'Convertir este servicio en un alcance verificable';
const descriptionSectionTitle = replicaProd ? 'Descripción del Servicio' : 'Alcance operativo';
const processSectionTitle = replicaProd ? 'Nuestro Proceso' : 'Método de implementación';
const sidebarInfoTitle = replicaProd ? 'Información del Servicio' : 'Metadata del servicio';
const productsSectionKicker = replicaProd ? '' : 'Equipamiento';
const productsSectionTitle = replicaProd ? 'Productos y Soluciones' : 'Equipamiento aplicado';
const productsSectionText = replicaProd
  ? ''
  : 'Soluciones, materiales y equipamiento vinculados al alcance real del servicio.';

// SEO
const siteUrl = 'https://www.ultimamilla.com.ar';
const seoTitleRaw = replicaProd
  ? resolveReplicaTitle(serviceDetailPath, cmsTitle)
  : sanitizeServicePageTitle(Number(id), servicio.Titulo, visual?.shortName || serviceHeroTitle);
const seoTitleBase = seoTitleRaw.replace(/\s*\|\s*ULTIMA MILLA\s*$/i, '').trim();
let pageTitle = `${seoTitleBase} | ULTIMA MILLA`;
if (pageTitle.length > 60) {
  pageTitle =
    seoTitleBase.length > 45
      ? `${seoTitleBase.slice(0, 45)}… | ULTIMA MILLA`
      : `${seoTitleBase} | ULTIMA MILLA`;
}
const serviceBodySource = servicio.Descripcion?.replace(/\\/g, '\n') || '';
const serviceDescriptionHtml = await renderEditorialBody(serviceBodySource);
const solutionBodies = servicio.Soluciones?.length
  ? await Promise.all(
      servicio.Soluciones.map((solucion: { descripcion?: string }) =>
        renderEditorialBody(solucion.descripcion || '')
      )
    )
  : [];
const rawDesc = stripBannedLedgerPhrases(plainTextFromHtml(serviceBodySource, 500));
const pageDescription = rawDesc.length > 155 ? rawDesc.slice(0, 155) + '...' :
  rawDesc.length > 0 && rawDesc.length < 120 ? `${rawDesc} Servicios profesionales de ULTIMA MILLA en Mendoza, Cuyo y Patagonia.`.slice(0, 155) :
  rawDesc || `${seoTitleBase} - Servicios tecnológicos en Mendoza, Cuyo y Patagonia.`;
const bodyPlainLead = plainTextFromHtml(serviceBodySource, 120);
const heroLead = serviceHeroLead(
  cmsSubtitulo,
  replicaProd ? undefined : visual?.proof,
  pageDescription,
  bodyPlainLead,
);
const porQueElegirnos = sanitizeServiceBulletList(servicio.por_que_elegirnos || []);
const showGenericProcess =
  !replicaProd || porQueElegirnos.length === 0;
const displayStats = sanitizeServiceStats(servicio.stats || []);
const canonicalUrl = `${siteUrl}/servicios/${id}/${slug}`;

// Structured Data - Service schema
const serviceStructuredData = {
  "@type": "Service",
  "name": seoTitleBase,
  "description": pageDescription,
  "url": canonicalUrl,
  ...(servicio.Imagen && { "image": (() => { const imgUrl = getDirectusImageUrl(servicio.Imagen); return imgUrl.startsWith('http') ? imgUrl : `${siteUrl}${imgUrl}`; })() }),
  "provider": {
    "@type": "Organization",
    "name": "ULTIMA MILLA",
    "url": siteUrl
  },
  "areaServed": [
    { "@type": "City", "name": "Mendoza" },
    { "@type": "City", "name": "San Juan" },
    { "@type": "City", "name": "San Luis" },
    { "@type": "AdministrativeArea", "name": "Patagonia" }
  ],
  ...(servicio.area && { "serviceType": servicio.area }),
  ...(productos.length > 0 && {
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": `Productos de ${servicio.Titulo}`,
      "itemListElement": productos.map((p: any) => ({
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": p.titulo,
          ...(p.descripcion && { "description": plainTextFromHtml(p.descripcion, 300) })
        }
      }))
    }
  }),
  "inLanguage": "es"
};

// SVG icon paths para soluciones
const iconPaths = {
  'monitor': '<rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/>',
  'headphones': '<path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>',
  'cloud': '<path d="M18 10h-1.26A8 8 0 1 0 9 20h9a5 5 0 0 0 0-10z"/>',
  'shield': '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  'cable': '<path d="M4 9a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2"/><path d="M6 9v12"/><path d="M14 15a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2a2 2 0 0 1-2 2h-4a2 2 0 0 1-2-2"/><path d="M18 13v-2"/><path d="M6 13h8"/>',
  'zap': '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>',
  'radio': '<circle cx="12" cy="12" r="2"/><path d="M16.24 7.76a6 6 0 0 1 0 8.49m-8.48-.01a6 6 0 0 1 0-8.49m11.31-2.82a10 10 0 0 1 0 14.14m-14.14 0a10 10 0 0 1 0-14.14"/>',
  'wifi': '<path d="M5 12.55a11 11 0 0 1 14.08 0"/><path d="M1.42 9a16 16 0 0 1 21.16 0"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><line x1="12" y1="20" x2="12.01" y2="20"/>',
  'server': '<rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/>',
  'globe': '<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
  'code': '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  'database': '<ellipse cx="12" cy="5" rx="9" ry="3"/><path d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3"/><path d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5"/>',
  'smartphone': '<rect x="5" y="2" width="14" height="20" rx="2" ry="2"/><line x1="12" y1="18" x2="12.01" y2="18"/>',
  'cpu': '<rect x="4" y="4" width="16" height="16" rx="2" ry="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/>',
  'flame': '<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>'
};
---

<LayoutV4
  title={pageTitle}
  description={pageDescription}
  keywords={`${servicio.Titulo.toLowerCase()}${servicio.area ? `, ${servicio.area.toLowerCase()}` : ''}, servicios tecnologicos mendoza`}
  canonical={canonicalUrl}
  structuredData={serviceStructuredData}
>
  <section class="service-detail-hero">
    <div class="service-detail-hero__image">
      <img
        src={serviceImage}
        alt={visual?.imageAlt || servicio.Titulo}
        loading="eager"
        fetchpriority="high"
        decoding="async"
        width="1920"
        height="1080"
      />
    </div>
    <div class="service-detail-hero__wash"></div>

    <div class="um-container service-detail-hero__content">
      <nav class="service-detail-breadcrumb" aria-label="Breadcrumb">
        <a href="/" class="hover:text-white transition-colors">Inicio</a>
        <span>/</span>
        <a href="/servicios" class="hover:text-white transition-colors">Servicios</a>
        <span>/</span>
        <span class="service-detail-breadcrumb__current">{serviceBreadcrumbLabel}</span>
      </nav>

      <div class="service-detail-hero__grid">
        <div>
          <span class="service-detail-label">{visual?.eyebrow || servicio.area || 'Servicio IT integral'}</span>
          <h1>{serviceHeroTitle}</h1>
          <p>{heroLead}</p>
          <div class="service-detail-hero__actions" aria-label="Acciones principales del servicio">
            <UMButton href="/contacto">Solicitar diagnóstico</UMButton>
            <UMButton href="/antecedentes" variant="secondary">Ver evidencia</UMButton>
          </div>
        </div>
        <aside class="service-detail-proof">
          <div>
            <strong>{visual?.shortName || 'IT'}</strong>
            <span>frente técnico</span>
          </div>
          <div>
            <strong>{visual?.signal || 'operación'} / 24-7</strong>
            <span>diseño y soporte</span>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- STATS BAR - Componente V4 -->
  {displayStats.length > 0 && (
    <StatsBar stats={displayStats} />
  )}

  <!-- MAIN CONTENT -->
  <section class="service-detail-main">
    <div class="um-container">
      <div class="service-detail-main__grid">

        <!-- Main Content -->
        <div class="service-detail-main__body">
          <h2 class="service-detail-section-title">{descriptionSectionTitle}</h2>
          <div class="prose prose-lg max-w-none text-um-gray mb-12 service-detail-copy editorial-body">
            {serviceDescriptionHtml ? (
              <div set:html={serviceDescriptionHtml} />
            ) : (
              <p>Alcance técnico documentado bajo relevamiento de sitio y criterios operativos verificables.</p>
            )}
          </div>

          <!-- Soluciones que Ofrecemos (si existen en formato JS) -->
          {servicio.Soluciones && servicio.Soluciones.length > 0 && (
            <div class="mb-8 sm:mb-12">
              <h3 class="service-detail-subtitle">Soluciones que ofrecemos</h3>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
                {servicio.Soluciones.map((solucion, solutionIndex) => (
                  <div class="service-solution-card">
                    <div>
                      <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="2" set:html={iconPaths[solucion.icon] || iconPaths['globe']} />
                    </div>
                    <h4 class="font-bold text-um-dark mb-2">{solucion.titulo}</h4>
                    {solutionBodies[solutionIndex] ? (
                      <div class="text-base text-um-gray editorial-body editorial-body--compact" set:html={solutionBodies[solutionIndex]} />
                    ) : null}
                  </div>
                ))}
              </div>
            </div>
          )}

          {showGenericProcess && (
            <>
              <h3 class="service-detail-subtitle">{processSectionTitle}</h3>
              <div class="service-process-list">
                <div>
                  <span>01</span>
                  <div>
                    <h4 class="font-bold text-um-dark">Relevamiento</h4>
                    <p class="text-um-gray">Análisis completo de su infraestructura actual y requerimientos futuros.</p>
                  </div>
                </div>
                <div>
                  <span>02</span>
                  <div>
                    <h4 class="font-bold text-um-dark">Diseño</h4>
                    <p class="text-um-gray">Propuesta técnica con planos, materiales y cronograma detallado.</p>
                  </div>
                </div>
                <div>
                  <span>03</span>
                  <div>
                    <h4 class="font-bold text-um-dark">Implementación</h4>
                    <p class="text-um-gray">Ejecución por técnicos especializados con mínima interrupción operativa.</p>
                  </div>
                </div>
                <div>
                  <span>04</span>
                  <div>
                    <h4 class="font-bold text-um-dark">Documentación</h4>
                    <p class="text-um-gray">Testing completo con equipos especializados y entrega de documentación.</p>
                  </div>
                </div>
              </div>
            </>
          )}

          <!-- Por Qué Elegirnos -->
          {porQueElegirnos.length > 0 && (
            <div class="service-why">
              <h3 class="service-detail-subtitle">Por qué elegirnos</h3>
              <ul class="space-y-3">
                {porQueElegirnos.map((item) => (
                  <li class="flex items-start gap-3">
                    <svg class="w-5 h-5 text-red-600 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                    <span class="text-um-dark">{sanitizeEditorialText(item)}</span>
                  </li>
                ))}
              </ul>
            </div>
          )}
        </div>

        <!-- Sidebar -->
        <div class="service-detail-main__aside">
          <!-- Quick Info Card -->
          <div class="service-info-card service-info-card--dossier">
            <header class="service-info-head">
              <p>Ficha técnica</p>
              <h2>{sidebarInfoTitle}</h2>
            </header>

            <dl class="service-info-ledger" aria-label="Información operativa del servicio">
              <div>
                <dt>Implementación</dt>
                <dd>2-8 semanas</dd>
              </div>
              <div>
                <dt>Garantía</dt>
                <dd>5 años en materiales</dd>
              </div>
              <div>
                <dt>Cobertura</dt>
                <dd>Mendoza, Cuyo y Patagonia</dd>
              </div>
            </dl>

            {datasheetHref && (
              <a href={datasheetHref} class="service-datasheet-btn" download>
                Ficha técnica (PDF)
              </a>
            )}

            <div class="service-info-actions">
              <UMButton href="/contacto" class="service-info-primary">
                Solicitar diagnóstico
              </UMButton>
              <a href="mailto:contacto@ultimamilla.com.ar" class="service-info-secondary">
                contacto@ultimamilla.com.ar
              </a>
            </div>
          </div>

          <!-- Brands -->
          {servicio.marcas && servicio.marcas.length > 0 && (
            <div class="service-info-card">
              <h3 class="font-bold text-um-dark mb-4 text-lg">Marcas compatibles</h3>
              <div class="flex flex-wrap gap-3">
                {servicio.marcas.map((marca) => (
                  <span class="px-3 py-1 bg-white rounded-[4px] text-base text-um-gray border">{marca}</span>
                ))}
              </div>
            </div>
          )}
        </div>
      </div>
    </div>
  </section>

  <!-- PRODUCTOS Y EQUIPAMIENTO - Usando componente ProductCard V4 -->
  {productos.length > 0 && (
    <section class="service-products-section">
      <div class="um-container">
        <div class="service-products-head">
          <SectionHeader
            kicker={productsSectionKicker}
            title={productsSectionTitle}
            text={productsSectionText}
          />
        </div>

        <div class="service-products-list">
          {productos.map((producto, index) => (
            <ProductCard
              titulo={producto.titulo || producto.nombre || 'Equipamiento'}
              descripcion={producto.descripcion || ''}
              imagen={producto.imagen}
              features={producto.features || []}
              destacado={producto.destacado}
              marcas={producto.marcas || []}
              orden={index}
              serviceId={id}
              serviceName={visual?.shortName || servicio.Titulo.split('|')[0]?.trim() || servicio.Titulo}
              serviceCategory={servicio.area || servicio.Area || visual?.eyebrow}
              serviceHref={`/servicios/${id}/${slug}`}
              ctaLabel={[102, 107].includes(Number(id)) ? 'Solicitar relevamiento' : 'Cotizar solución'}
              ctaHref="/contacto"
              showActions={shouldShowProductCardActions({ index, total: productos.length })}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- CTA SECTION - Componente V4 -->
  <CTASection
    badge="Diagnóstico técnico"
    badgeIcon="rocket"
    titulo={serviceCtaTitle}
    descripcion="Revisamos sitio, riesgos, dependencias y objetivo operativo antes de proponer una solución."
    primaryButtonText="Solicitar diagnóstico"
    primaryButtonUrl="/contacto"
    secondaryButtonText="contacto@ultimamilla.com.ar"
    secondaryButtonUrl="mailto:contacto@ultimamilla.com.ar"
    secondaryButtonIcon="mail"
    backgroundImage={serviceImage}
  />
</LayoutV4>

<style>
  /* Line clamp utility */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .service-detail-hero {
    position: relative;
    overflow: hidden;
    min-height: clamp(500px, 60vh, 640px);
    background: #080808;
    color: #fff;
  }

  .service-detail-hero__image,
  .service-detail-hero__wash {
    position: absolute;
    inset: 0;
  }

  .service-detail-hero__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.82) contrast(1.12) brightness(0.72);
  }

  .service-detail-hero__wash {
    background:
      linear-gradient(90deg, rgba(8,8,8,0.94) 0%, rgba(8,8,8,0.86) 38%, rgba(8,8,8,0.56) 72%, rgba(8,8,8,0.28) 100%),
      linear-gradient(0deg, rgba(8,8,8,0.9) 0%, rgba(8,8,8,0.22) 72%);
  }

  .service-detail-hero__content {
    position: relative;
    z-index: 1;
    padding-top: clamp(24px, 3.4vw, 48px);
    padding-bottom: clamp(52px, 7vw, 92px);
  }

  .service-detail-breadcrumb {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-bottom: clamp(34px, 6vw, 72px);
    color: rgba(255,255,255,0.58);
    font-size: 1rem;
    font-weight: 700;
    min-width: 0;
  }

  .service-detail-breadcrumb span,
  .service-detail-breadcrumb a {
    overflow-wrap: anywhere;
  }

  .service-detail-breadcrumb__current {
    max-width: min(100%, 42ch);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    color: rgba(255,255,255,0.76);
  }

  .service-detail-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.68fr) minmax(300px, 0.32fr);
    gap: clamp(32px, 5.2vw, 72px);
    align-items: start;
  }

  .service-detail-hero__grid > * {
    min-width: 0;
  }

  .service-detail-label {
    display: inline-flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1rem;
    color: rgba(255, 255, 255, 0.82);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0;
    text-transform: uppercase;
    max-width: 100%;
    overflow-wrap: anywhere;
  }

  .service-detail-label::before {
    content: "";
    width: 34px;
    height: 2px;
    background: #DC2626;
  }

  .service-detail-hero h1 {
    max-width: min(760px, 22ch);
    color: #ffffff !important;
    font-size: clamp(2rem, 2.9vw, 3.15rem);
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: 0;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .service-detail-hero p {
    max-width: 58ch;
    margin-top: 1.25rem;
    color: rgba(255, 255, 255, 0.78) !important;
    font-size: clamp(1rem, 1.08vw, 1.12rem);
    line-height: 1.68;
    overflow-wrap: anywhere;
  }

