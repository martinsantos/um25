---
/**
 * Service Detail Page - tema oscuro (tokens --x-*) + Directus con fallback.
 * Estructura: hero (Blender) → despiece del sector con ESE servicio activo
 * (+ la demo, en 104/105/106) → qué cubre (lista numerada) → casos (lista sobria)
 * → ficha técnica → cierre de contacto único.
 *
 * Usa helpers de Directus con fallback:
 * - getServicioById() con fallback a servicios_completos_v4.js
 */

import LayoutV4 from '../../../layouts/LayoutV4.astro';
import EmailLink from '../../../components/common/EmailLink.astro';
import CineBanner from '../../../components/cine/CineBanner.astro';
import SoftwareFilm from '../../../components/cine/SoftwareFilm.astro';
import SectorCode from '../../../components/cine/SectorCode.astro';
import { productPage } from '../../../data/productPages';
import ServiceSpecSheet from '../../../components/cine/ServiceSpecSheet.astro';
import ShareButton from '../../../components/common/ShareButton.astro';
import { getServiceSpec } from '../../../data/serviceSpecs';
import { SERVICE_SCENES, serviceSceneKey, V4_CUTS } from '../../../data/cine/scenes';
import { SECTOR_FILMS, sectorsForService } from '../../../scripts/senal/sectorSpecs.js';

import { generateSlug } from '../../../utils/slugUtils.js';
import { getServicioById } from '../../../utils/directusHelpers';
import { getDirectusImageUrl } from '../../../lib/directus.ts';
import antecedentesSnapshot from '../../../data/snapshots/antecedentes.json';
import { getServiceVisualSpec } from '../../../data/serviceVisualSystem';
import {
  serviceSingleDemoCapabilities,
  serviceSingleDemoCopy,
} from '../../../data/serviceSingleDemoSystem';
import { editorialImageDimensions } from '../../../data/editorialImageSystem';
import {
  plainTextFromHtml,
  readServiceSubtitulo,
  sanitizeEditorialText,
  serviceHeroLead,
  sanitizeServiceStats,
  sanitizeServiceBulletList,
  sanitizeServicePageTitle,
  stripBannedLedgerPhrases,
} from '../../../utils/editorialContent';
import {
  buildServiceStrategicLinkGroups,
  buildStrategicWebPageStructuredData,
} from '../../../data/strategicLinkGraph';
import {
  cmsServiceTitle,
  isReplicaIdenticalCopy,
  resolveReplicaH1,
  resolveReplicaTitle,
} from '../../../utils/replicaProdCopy';
import { getDatasheetPublicPath } from '../../../utils/datasheets';

const { id, slug } = Astro.params;

if (!id || !slug) {
  return Astro.rewrite('/404');
}

// Obtener servicio de Directus con fallback automático a JS
const servicio = await getServicioById(id);

if (!servicio) {
  return Astro.rewrite('/404');
}

// Validar slug
const expectedSlug = servicio.slug || generateSlug(servicio.Titulo);
if (slug !== expectedSlug) {
  return Astro.redirect(`/servicios/${id}/${expectedSlug}`, 301);
}

// Productos del servicio (viene de Directus o de JS)
const productos = Array.isArray(servicio.productos) ? servicio.productos : [];
const visual = getServiceVisualSpec(id);
const serviceImage = visual?.image || getDirectusImageUrl(servicio.Imagen);
const demoCopy = serviceSingleDemoCopy[Number(id)];
const serviceDetailPath = `/servicios/${id}/${expectedSlug}`;
const datasheetHref = getDatasheetPublicPath(expectedSlug);
const replicaProd = isReplicaIdenticalCopy();
const cmsTitle = cmsServiceTitle(servicio.Titulo);
const cmsSubtitulo = readServiceSubtitulo(servicio);
const editorialHeroTitle =
  (!replicaProd && demoCopy?.headline) || visual?.shortName || cmsTitle || servicio.Titulo;
const serviceHeroTitle = resolveReplicaH1(serviceDetailPath, editorialHeroTitle);
const serviceCtaTitle = replicaProd
  ? `¿Listo para implementar ${String(cmsTitle).replace(/[.\s]+$/, '')}?`
  : visual?.shortName
    ? `Convertir ${visual.shortName.toLowerCase()} en un alcance verificable`
    : 'Convertir este servicio en un alcance verificable';
const isCommercialProduct = (producto: any) => (
  ['producto', 'productos'].includes(String(producto.categoria_comercial || '').toLowerCase()) ||
  ['producto', 'productos'].includes(String(producto.categoria_informacion || '').toLowerCase()) ||
  Boolean(producto.tipo_producto) ||
  Boolean(producto.slug_producto) ||
  Boolean(producto.url_producto)
);
const commercialProducts = productos.filter(isCommercialProduct);
const hasCommercialProducts = commercialProducts.length > 0;
const productCards = hasCommercialProducts ? commercialProducts : productos;

// SEO
const siteUrl = 'https://www.ultimamilla.com.ar';
const seoTitleRaw = replicaProd
  ? resolveReplicaTitle(serviceDetailPath, cmsTitle)
  : sanitizeServicePageTitle(Number(id), servicio.Titulo, visual?.shortName || serviceHeroTitle);
const seoTitleBase = seoTitleRaw.replace(/\s*\|\s*ULTIMA MILLA\s*$/i, '').trim();
let pageTitle = `${seoTitleBase} | ULTIMA MILLA`;
// Nombres cortos ("Soporte 24/7") quedan bajo 30 caracteres: se suma el contexto real.
if (pageTitle.length < 30) pageTitle = `${seoTitleBase} para empresas en Mendoza | ULTIMA MILLA`;
if (pageTitle.length > 60) {
  pageTitle =
    seoTitleBase.length > 45
      ? `${seoTitleBase.slice(0, 45)}… | ULTIMA MILLA`
      : `${seoTitleBase} | ULTIMA MILLA`;
}
const serviceBodySource = servicio.Descripcion?.replace(/\\/g, '\n') || '';
const rawDesc = stripBannedLedgerPhrases(plainTextFromHtml(serviceBodySource, 500));
const pageDescription = rawDesc.length > 155 ? rawDesc.slice(0, 155) + '...' :
  rawDesc.length > 0 && rawDesc.length < 120 ? `${rawDesc} Servicios profesionales de ULTIMA MILLA en Mendoza, Cuyo y Patagonia.`.slice(0, 155) :
  rawDesc || `${seoTitleBase} - Servicios tecnológicos en Mendoza, Cuyo y Patagonia.`;
const bodyPlainLead = plainTextFromHtml(serviceBodySource, 120);
const heroLead = serviceHeroLead(
  cmsSubtitulo,
  replicaProd ? undefined : visual?.proof,
  !replicaProd && demoCopy?.paragraph ? demoCopy.paragraph : pageDescription,
  bodyPlainLead,
);
const porQueElegirnos = sanitizeServiceBulletList(servicio.por_que_elegirnos || []);
const displayStats = sanitizeServiceStats(servicio.stats || []).filter(
  (stat: any) => String(stat?.label || '').trim() && String(stat?.value || '').trim(),
);
const demoCapabilities = serviceSingleDemoCapabilities[Number(id)] || [];
const cmsCapabilityFallback = servicio.Soluciones || [];
// Lista de tareas del servicio: título y una línea. Sin imágenes.
const serviceCapabilityItems = (demoCapabilities.length ? demoCapabilities : cmsCapabilityFallback)
  .slice(0, 6)
  .map((item: any, index: number) => {
    const title = sanitizeEditorialText(
      item.title || item.titulo || item.nombre || item.headline || `Capacidad ${index + 1}`
    );
    const description =
      plainTextFromHtml(item.description || item.descripcion || item.servicio_asociado || item.headline || '') ||
      visual?.proof ||
      pageDescription;
    return {
      number: item.number || String(index + 1).padStart(2, '0'),
      title,
      description,
    };
  });
const canonicalUrl = `${siteUrl}/servicios/${id}/${slug}`;
const serviceStrategicLinkGroups = buildServiceStrategicLinkGroups({
  currentPath: serviceDetailPath,
  serviceId: id,
  serviceName: visual?.shortName || cmsTitle,
  title: serviceHeroTitle,
  summary: pageDescription,
  text: [
    servicio.Titulo,
    servicio.area,
    servicio.Area,
    servicio.Subtitulo,
    productos.map((producto: any) => `${producto.titulo || producto.nombre || ''} ${producto.descripcion || ''}`).join(' '),
  ].filter(Boolean).join(' '),
});

// Structured Data - Service schema
const serviceStructuredData = {
  "@type": "Service",
  // Misma @id que usan los artículos del blog en `about`/`mentions`.
  "@id": `${canonicalUrl}#service`,
  "name": seoTitleBase,
  "description": pageDescription,
  "url": canonicalUrl,
  "mainEntityOfPage": canonicalUrl,
  "significantLink": [
    `${siteUrl}/servicios`,
    `${siteUrl}/antecedentes`,
    `${siteUrl}/sectores`,
    `${siteUrl}/contacto`,
  ],
  "image": serviceImage.startsWith('http') ? serviceImage : `${siteUrl}${serviceImage}`,
  "provider": { "@id": `${siteUrl}/#organization` },
  "areaServed": [
    { "@type": "City", "name": "Mendoza" },
    { "@type": "City", "name": "San Juan" },
    { "@type": "City", "name": "San Luis" },
    { "@type": "AdministrativeArea", "name": "Patagonia" }
  ],
  ...(servicio.area && { "serviceType": servicio.area }),
  ...(productCards.length > 0 && {
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": `Productos de ${servicio.Titulo}`,
      "itemListElement": productCards.map((p: any) => ({
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": p.titulo || p.nombre,
          ...((p.descripcion || p.servicio_asociado || p.headline) && {
            "description": plainTextFromHtml(p.descripcion || p.servicio_asociado || p.headline, 300)
          })
        }
      }))
    }
  }),
  "inLanguage": "es"
};
const servicePageStructuredData = [
  serviceStructuredData,
  buildStrategicWebPageStructuredData({
    url: canonicalUrl,
    name: pageTitle,
    description: pageDescription,
    groups: serviceStrategicLinkGroups,
  }),
];


// ── Limpieza de textos crudos de Directus ──────────────────────────────
const TYPO_FIXES: [RegExp, string][] = [
  [/\bSitema\b/g, 'Sistema'],
  [/\bSistena\b/g, 'Sistema'],
  [/\b([Tt])elefonos\b/g, '$1eléfonos'],
  [/\btelefonico\b/g, 'telefónico'],
  [/\bOptica\b/g, 'Óptica'],
  [/\bIngenieria\b/g, 'Ingeniería'],
  [/\bdebiles\b/g, 'débiles'],
  [/\bremplazo\b/gi, 'Reemplazo'],
  [/\bempalzadora\b/gi, 'empalmadora'],
  [/\bdeteccion\b/g, 'detección'],
  [/\bBaterias\b/g, 'Baterías'],
];
const fixTypos = (value: string) => TYPO_FIXES.reduce((text, [re, rep]) => text.replace(re, rep), value);
const clarifyWarranty = (value: string) =>
  value
    .replace(/garant[ií]a extendida de 25 años en cableado/gi, 'Garantía de fabricante de 25 años en cableado certificado')
    .replace(/garant[ií]a del fabricante de 25 años/gi, 'garantía de fabricante de 25 años en cableado certificado')
    .replace(/garant[ií]a de 25 años/gi, 'garantía de fabricante de 25 años en cableado certificado');
const cleanCmsText = (value: unknown) =>
  clarifyWarranty(
    fixTypos(
      stripBannedLedgerPhrases(value)
        .replace(/\*\*/g, '')
        .replace(/\s*(?:\.{3}|…)\s*$/g, '')
        .replace(/\s+/g, ' ')
        .trim(),
    ),
  );
const normalizeKey = (value: string) =>
  value.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, ' ').trim();
const LOWER_WORDS = new Set(['de', 'del', 'la', 'las', 'los', 'y', 'e', 'en', 'para', 'por', 'el']);
const UPPER_WORDS = new Set(['sa', 's.a', 's.a.', 'srl', 'ltda', 'mza', 'fuesmen', 'aa2000']);
const smartCase = (value: string) => {
  const letters = value.replace(/[^A-Za-zÁÉÍÓÚÑáéíóúñ]/g, '');
  const isUpper = letters && letters === letters.toUpperCase();
  const isLower = letters && letters === letters.toLowerCase();
  if (!isUpper && !isLower) return value.charAt(0).toUpperCase() + value.slice(1);
  return value
    .toLowerCase()
    .split(/\s+/)
    .map((word, index) => {
      if (UPPER_WORDS.has(word)) return word.toUpperCase();
      if (index > 0 && LOWER_WORDS.has(word)) return word;
      return word.charAt(0).toUpperCase() + word.slice(1);
    })
    .join(' ');
};
const MONTH_YEAR_RE = /^(enero|febrero|marzo|abril|mayo|junio|julio|agosto|septiembre|setiembre|octubre|noviembre|diciembre)\s+\d{4}$/i;
const cleanCaseTitle = (rawTitle: string, client: string) => {
  let title = cleanCmsText(String(rawTitle || '').split('|')[0]).replace(/\s*\(\d+\)\s*$/, '');
  const prefix = title.match(/^([^:]{3,42}):\s*(.{12,})$/);
  if (prefix) title = prefix[2];
  const clientKey = normalizeKey(client);
  const clientHead = clientKey.split(' ')[0] || '';
  const segments = title.split(/\s+[-–]\s+/).filter(Boolean);
  const kept = segments.filter((segment, index) => {
    if (index === 0) return true;
    const key = normalizeKey(segment);
    if (MONTH_YEAR_RE.test(segment.trim())) return false;
    if (/cliente confidencial/i.test(segment)) return false;
    if (!key) return false;
    if (clientKey && (clientKey.includes(key) || key.includes(clientKey))) return false;
    if (clientHead.length >= 4 && key.split(' ').includes(clientHead)) return false;
    return true;
  });
  title = kept.join(' - ').replace(/[\s\-–,.]+$/, '').trim();
  return smartCase(title);
};
const SECTOR_LABELS: Record<string, string> = {
  'Aeropuertos & Telecomunicaciones': 'Aeropuertos',
  'Salud & Sector Salud': 'Salud',
  'Infraestructura Hospitalaria': 'Salud',
  'Gobierno & Sector Público': 'Gobierno',
  'Industria & Bodegas': 'Bodegas',
  'Conectividad & Redes': 'Redes',
  'Detección de Incendios & Seguridad': 'Incendios',
  'Video Vigilancia & Seguridad': 'Seguridad',
  'Seguridad Electrónica & SDI': 'Seguridad',
  'Soluciones Tecnológicas': 'Tecnología',
  'Servicios Corporativos': 'Corporativo',
  'Infraestructura de Data Center': 'Data center',
};

// ── Antecedentes del servicio (snapshot real publicado) ────────────────
type CaseRecord = { id: number; Titulo?: string; Cliente?: string; Area?: string; Fecha?: string };
const SERVICE_CASE_MATCHERS: Record<string, { include: RegExp[]; exclude?: RegExp }> = {
  '101': { include: [/fibra/i, /cableado/i, /\bredes?\b/i, /radioenlace/i, /\brack\b/i, /switch/i, /wi-?fi/i], exclude: /incendi|detecci/i },
  '102': { include: [/cctv/i, /videovigilancia/i, /control de acceso/i, /c[aá]maras?\b/i, /alarma/i, /intrusi/i], exclude: /comercio|evento/i },
  '103': { include: [/telef/i, /telecomunic/i, /\bvoz\b/i, /radiocomunic/i, /intercomunic/i, /portero/i, /conectividad/i], exclude: /incendi|detecci/i },
  '104': { include: [/software/i, /digitaliz/i, /aplicaci[oó]n/i, /sistema web/i, /plataforma/i], exclude: /soporte/i },
  '105': { include: [/soporte/i, /mesa de ayuda/i, /mantenimiento/i] },
  '106': { include: [/diagn[oó]stico/i, /consultor[ií]a/i, /auditor/i, /asesor/i, /transformaci[oó]n digital/i, /ingenier[ií]a/i], exclude: /consultorios/i },
  '107': { include: [/incendi/i, /detecci[oó]n/i, /detector/i, /extinci/i] },
  '108': { include: [/el[eé]ctric/i, /\bups\b/i, /tablero/i, /energ[ií]a/i, /puesta a tierra/i, /bater[ií]as/i] },
};
const snapshotCases: CaseRecord[] = Array.isArray(antecedentesSnapshot)
  ? (antecedentesSnapshot as CaseRecord[])
  : ((antecedentesSnapshot as { data?: CaseRecord[] }).data || []);
const CASES_MAX = 6;
const caseMatcher = SERVICE_CASE_MATCHERS[String(id)];
const serviceCases = (() => {
  if (!caseMatcher) return [];
  const ranked = snapshotCases
    .map((record) => {
      const client = smartCase(cleanCmsText(record.Cliente || ''));
      const title = cleanCaseTitle(record.Titulo || '', client);
      const rank = caseMatcher.include.findIndex((re) => re.test(title));
      return { record, client, title, rank };
    })
    .filter((item) =>
      item.rank >= 0 &&
      !/\.{3}|…/.test(String(item.record.Titulo || '')) &&
      item.client &&
      item.title.length >= 8 &&
      !(caseMatcher.exclude && caseMatcher.exclude.test(item.title)),
    )
    .sort((a, b) => a.rank - b.rank || String(b.record.Fecha || '').localeCompare(String(a.record.Fecha || '')));
  const seenClients = new Set<string>();
  const seenTitles = new Set<string>();
  const picked: typeof ranked = [];
  // Primera pasada: clientes y títulos distintos. Segunda: se admite título repetido con otro cliente.
  for (const allowRepeatedTitle of [false, true]) {
    for (const item of ranked) {
      if (picked.length === CASES_MAX || picked.includes(item)) continue;
      const clientKey = normalizeKey(item.client).split(' ').filter((word) => !LOWER_WORDS.has(word)).join(' ');
      const titleKey = normalizeKey(item.title);
      if (seenClients.has(clientKey) || (!allowRepeatedTitle && seenTitles.has(titleKey))) continue;
      seenClients.add(clientKey);
      seenTitles.add(titleKey);
      picked.push(item);
    }
  }
  return picked.map(({ record, client, title }) => ({
    id: record.id,
    href: `/antecedentes/${record.id}/${generateSlug(record.Titulo || '')}`,
    client,
    title,
    sector: SECTOR_LABELS[String(record.Area || '').trim()] || String(record.Area || '').split('&')[0].trim(),
    year: String(record.Fecha || '').slice(0, 4),
  }));
})();

// ── Soluciones incluidas (solo si el servicio no trae lista de tareas) ──
const productTechLine = (producto: any) => {
  const raw = String(producto.descripcion || producto.servicio_asociado || producto.headline || '');
  const technical = raw.match(/\*\*([^*]+)\*\*([\s\S]*)$/);
  const source = technical ? `${technical[1]} ${technical[2]}` : raw;
  return cleanCmsText(plainTextFromHtml(source))
    .replace(/^Producto publicado:\s*/i, '')
    .replace(/:\s*:/g, ':')
    .replace(/^./, (first) => first.toUpperCase());
};
const solutionItems = productCards.map((producto: any, index: number) => ({
  number: String(index + 1).padStart(2, '0'),
  title: smartCase(cleanCmsText(String(producto.titulo || producto.nombre || 'Solución').split('|')[0])),
  detail: productTechLine(producto),
  href: producto.url_producto || (producto.slug_producto === 'cctv-ai-integrado' ? '/cctvai/' : ''),
}));

// Lista «Qué cubre»: las tareas del servicio; si no hay, las soluciones incluidas.
const scopeItems = serviceCapabilityItems.length > 0
  ? serviceCapabilityItems
  : solutionItems.map((item) => ({ number: item.number, title: item.title, description: item.detail }));
// Producto propio con página aparte (p. ej. CCTV AI): un solo enlace, bajo la lista.
const scopeProductLinks = solutionItems.filter((item) => item.href);

// Despiece: la escena de un sector con ESE servicio activo. Se prefiere el sector
// más representativo; si el servicio no figura ahí, el primero que lo incluye.
type SectorSlug = keyof typeof SECTOR_FILMS;
const DESPIECE_PREFERIDO: Record<string, string> = {
  '101': 'constructoras', '102': 'aeropuertos', '103': 'mineria', '104': 'industria',
  '105': 'salud', '106': 'bodegas', '107': 'bodegas', '108': 'salud',
};
const sectoresDelServicio: string[] = sectorsForService(String(id));
const despieceSector = (
  sectoresDelServicio.includes(DESPIECE_PREFERIDO[String(id)]) ? DESPIECE_PREFERIDO[String(id)] : sectoresDelServicio[0]
) as SectorSlug | undefined;

const whyItems = porQueElegirnos.map((item: string) => cleanCmsText(sanitizeEditorialText(item))).filter(Boolean);
const marcas = Array.isArray(servicio.marcas) ? servicio.marcas.map((m: unknown) => cleanCmsText(m)).filter(Boolean) : [];
const serviceShortName = visual?.shortName || cmsTitle;
// Páginas de producto (software, soporte, consultoría): el servicio mostrado como producto,
// en el tono de la landing de comunidades, en lugar de un render de objetos.
const product = productPage(String(id));
const serviceSpec = getServiceSpec(id);
const fichaPrintHref = serviceSpec ? `/servicios/${id}/ficha` : null;
// Plazo y garantía de materiales aplican a los servicios de instalación; software,
// soporte y consultoría se definen por alcance.
const isInstallService = [101, 102, 103, 107, 108].includes(Number(id));
const fichaItems = [
  ...(isInstallService
    ? [
        { label: 'Implementación', value: '2–8 semanas' },
        { label: 'Garantía', value: '5 años en materiales' },
      ]
    : []),
  { label: 'Cobertura', value: 'Mendoza, Cuyo y Patagonia' },
  ...displayStats.slice(0, 3).map((stat: any) => ({ label: cleanCmsText(stat.label), value: cleanCmsText(stat.value) })),
];

---

<LayoutV4
  skin="black"
  title={pageTitle}
  description={pageDescription}
  keywords={`${servicio.Titulo.toLowerCase()}${servicio.area ? `, ${servicio.area.toLowerCase()}` : ''}, servicios tecnologicos mendoza`}
  image={serviceImage}
  imageWidth={editorialImageDimensions.width}
  imageHeight={editorialImageDimensions.height}
  canonical={canonicalUrl}
  structuredData={servicePageStructuredData}
>
  {String(id) === '104' ? (
    <SoftwareFilm
      titleId="service-title"
      kicker={visual?.eyebrow || servicio.area || 'Servicio IT'}
      title={serviceHeroTitle}
      lead={heroLead}
      primary={{ href: '/contacto', label: 'Solicitar diagnóstico' }}
      secondary={{ href: '/antecedentes', label: 'Ver evidencia' }}
      back={{ href: '/servicios', label: '← Todos los servicios' }}
    />
  ) : (
  <CineBanner
    variant="sector"
    scenes={[serviceSceneKey(String(id))]}
    variants={{ [serviceSceneKey(String(id))]: Object.keys(V4_CUTS).filter((k) => V4_CUTS[k].code === String(id)) }}
    systems={(SERVICE_SCENES[String(id)] || SERVICE_SCENES['101']).systems}
    titleId="service-title"
    kicker={visual?.eyebrow || servicio.area || 'Servicio IT'}
    title={serviceHeroTitle}
    lead={heroLead}
    primary={{ href: '/contacto', label: 'Solicitar diagnóstico' }}
    secondary={{ href: '/antecedentes', label: 'Ver evidencia' }}
    back={{ href: '/servicios', label: '← Todos los servicios' }}
  />
  )}

  <div class="svc">
    <!-- 2 · Despiece: la escena de un sector, desarmada por capas, con ESE servicio activo -->
    {despieceSector && (
      <section class="svc-section svc-section--despiece" id="despiece" aria-labelledby="svc-despiece-title">
        <div class="svc-wrap">
          <header class="svc-head svc-head--solo">
            <div>
              <p class="svc-kicker">El servicio, en obra</p>
              <h2 id="svc-despiece-title">{serviceShortName}, capa por capa.</h2>
            </div>
          </header>
        </div>
        <SectorCode sector={despieceSector} service={String(id)} />
      </section>
    )}

    <!-- 3 · Qué cubre: lista plana numerada, título y una línea -->
    {scopeItems.length > 0 && (
      <section class="svc-section" id="alcance" aria-labelledby="svc-scope-title">
        <div class="svc-wrap">
          <header class="svc-head svc-head--solo">
            <div>
              <p class="svc-kicker">Alcance del servicio</p>
              <h2 id="svc-scope-title">Qué cubre {serviceShortName}.</h2>
            </div>
          </header>
          <ol class="svc-list" aria-label={`Qué cubre ${serviceShortName}`}>
            {scopeItems.map((item) => (
              <li>
                <span class="svc-list__num">{item.number}</span>
                <h3>{cleanCmsText(item.title)}</h3>
                <p class="svc-list__text">{cleanCmsText(item.description)}</p>
              </li>
            ))}
          </ol>
          {scopeProductLinks.map((item) => (
            <p class="svc-list__more">
              <a class="svc-textlink" href={item.href}>Ver producto: {item.title} <span aria-hidden="true">→</span></a>
            </p>
          ))}
        </div>
      </section>
    )}

    <!-- 4 · Casos comparables: lista sobria, sin imágenes -->
    {serviceCases.length > 0 && (
      <section class="svc-section" aria-labelledby="svc-cases-title">
        <div class="svc-wrap">
          <header class="svc-head svc-head--solo">
            <div>
              <p class="svc-kicker">Antecedentes</p>
              <h2 id="svc-cases-title">Casos comparables en operación.</h2>
            </div>
          </header>
          <ul class="svc-caselist">
            {serviceCases.map((item) => (
              <li>
                <a class="svc-case" href={item.href}>
                  <span class="svc-case__client">{item.client}</span>
                  <span class="svc-case__title">{item.title}</span>
                  <span class="svc-case__meta">{[item.sector, item.year].filter(Boolean).join(' · ')}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="svc-list__more">
            <a class="svc-textlink" href="/antecedentes">Ver todos los antecedentes <span aria-hidden="true">→</span></a>
          </p>
        </div>
      </section>
    )}

    <!-- 5 · Ficha técnica -->
    {serviceSpec && (
      <section class="svc-section" id="ficha-tecnica" aria-labelledby="svc-spec-title">
        <div class="svc-wrap">
          <header class="svc-head svc-head--solo">
            <div>
              <p class="svc-kicker">Ficha técnica</p>
              <h2 id="svc-spec-title">Alcance, normas y entregables.</h2>
            </div>
          </header>
          <ServiceSpecSheet spec={serviceSpec} pdfHref={datasheetHref} printHref={fichaPrintHref} />
          <p class="svc-share">
            <ShareButton title={`Ficha técnica · ${serviceSpec.name} · ULTIMA MILLA`} text={serviceSpec.promise} url={`${canonicalUrl}#ficha-tecnica`} />
          </p>
        </div>
      </section>
    )}

    <!-- 6 · Cierre de contacto (uno solo) -->
    <section class="svc-section svc-section--close" aria-labelledby="svc-close-title">
      <div class="svc-wrap svc-close">
        <div class="svc-close__cta">
          <p class="svc-kicker">{product ? product.close.kicker : 'Diagnóstico técnico'}</p>
          <h2 id="svc-close-title">{product ? product.close.title : serviceCtaTitle}</h2>
          <p class="svc-close__text">
            {product ? product.close.text : 'Revisamos sitio, riesgos, dependencias y objetivo operativo antes de proponer una solución.'}
          </p>
          <div class="svc-close__actions">
            <a class="svc-btn" href="/contacto">
              {product ? product.close.cta : 'Solicitar diagnóstico'}
              <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 8h9M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
            </a>
            <p class="svc-close__alt">
              o escribir a <EmailLink class="svc-textlink" />
            </p>
          </div>
        </div>

        <aside class="svc-ficha" aria-label="Ficha técnica del servicio">
          <p class="svc-kicker">Datos del servicio</p>
          <dl>
            {fichaItems.map((item) => (
              <div>
                <dt>{item.label}</dt>
                <dd>{item.value}</dd>
              </div>
            ))}
            {whyItems.length > 0 && (
              <div>
                <dt>Estándares</dt>
                <dd>
                  <ul>
                    {whyItems.map((item) => <li>{item}</li>)}
                  </ul>
                </dd>
              </div>
            )}
            {marcas.length > 0 && (
              <div>
                <dt>Marcas</dt>
                <dd>{marcas.join(' · ')}</dd>
              </div>
            )}
            {datasheetHref && (
              <div>
                <dt>Documento</dt>
                <dd><a class="svc-textlink" href={datasheetHref} download>Ficha técnica (PDF)</a></dd>
              </div>
            )}
          </dl>
        </aside>
      </div>
    </section>
  </div>
</LayoutV4>

<style>
  .svc {
    --svc-pad: clamp(64px, 5vw, 80px);
    background: var(--x-ink, #0a0a0b);
    color: var(--x-text, #fafafa);
    font-family: var(--um-font-editorial);
  }

  .svc-wrap {
    width: 100%;
    max-width: var(--um-container-wide, 1400px);
    margin-inline: auto;
    padding-inline: var(--x-gutter, clamp(16px, 3.2vw, 32px));
  }

  .svc-section {
    padding-block: var(--svc-pad);
    border-top: 1px solid var(--x-line);
  }

  /* Despiece: el título va sobre fondo oscuro y la escena (clara) llega al borde inferior. */
  .svc-section--despiece {
    padding-bottom: 0;
  }

  .svc-share {
    margin: 18px 0 0;
    color: var(--x-text);
  }

  .svc :where(h2, h3, p, dd, dt, li) {
    margin: 0;
  }

  /* Kicker */
  .svc-kicker {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 16px;
    color: var(--x-muted);
    font-family: var(--um-font-editorial);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .svc-kicker::before {
    content: "";
    flex: 0 0 28px;
    width: 28px;
    height: 2px;
    background: var(--x-red);
  }

  /* Section head */
  .svc-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
    gap: 24px 64px;
    align-items: end;
    margin-bottom: 48px;
  }

  .svc-head h2 {
    max-width: 18ch;
    color: var(--x-text) !important;
    font-family: var(--um-font-editorial);
    font-size: var(--x-fs-h2, clamp(2.25rem, 3.2vw, 3rem));
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.08;
    text-wrap: balance;
  }

  /* Cabecera sin bajada: un kicker y un título, en una sola columna. */
  .svc-head--solo {
    grid-template-columns: minmax(0, 1fr);
    margin-bottom: 32px;
  }

  .svc-head--solo h2 {
    max-width: 26ch;
  }

  .svc-head__lead {
    max-width: 62ch;
    color: var(--x-text-2) !important;
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .svc-textlink {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--x-text) !important;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--x-line-strong);
    text-underline-offset: 5px;
    transition: text-decoration-color 160ms var(--x-ease), color 160ms var(--x-ease);
  }

  .svc-textlink:hover {
    text-decoration-color: var(--x-red);
  }

  .svc-textlink span {
    transition: transform 160ms var(--x-ease);
  }

  .svc-textlink:hover span {
    transform: translateX(3px);
  }

  /* 3 · Qué cubre: lista plana numerada (número · título · una línea) */
  .svc-list {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--x-line-strong);
  }

  .svc-list > li {
    display: grid;
    grid-template-columns: 56px minmax(0, 0.9fr) minmax(0, 1.4fr);
    gap: 8px 24px;
    align-items: baseline;
    padding: 20px 0;
    border-bottom: 1px solid var(--x-line);
  }

  .svc-list__num {
    color: var(--x-muted);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    font-variant-numeric: tabular-nums;
  }

  .svc-list h3 {
    color: var(--x-text) !important;
    font-family: var(--um-font-editorial);
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .svc-list__text {
    max-width: 62ch;
    color: var(--x-text-2) !important;
    font-size: 1.0625rem;
    line-height: 1.55;
  }

  .svc-list__more {
    margin-top: 24px !important;
  }

  /* 4 · Casos: cliente · título · sector · año, sin imágenes */
  .svc-caselist {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--x-line-strong);
  }

  .svc-caselist > li {
    border-bottom: 1px solid var(--x-line);
  }

  .svc-case {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.6fr) minmax(0, 0.7fr);
    gap: 4px 24px;
    align-items: baseline;
    padding: 16px 0;
    color: inherit;
    text-decoration: none;
  }

  .svc-case:hover .svc-case__title {
    text-decoration: underline;
    text-decoration-color: var(--x-red);
    text-underline-offset: 5px;
  }

  .svc-case:focus-visible {
    outline: 2px solid var(--x-red);
    outline-offset: 2px;
  }

  .svc-case__client,
  .svc-case__meta {
    color: var(--x-muted);
    font-size: 1rem;
    line-height: 1.45;
  }

  .svc-case__title {
    color: var(--x-text);
    font-family: var(--um-font-editorial);
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
  }

  /* 6 · Close */
  .svc-section--close {
    background: var(--x-panel);
  }

  .svc-close {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(320px, 0.8fr);
    gap: 48px 96px;
    align-items: start;
  }

  .svc-close__cta h2 {
    max-width: 20ch;
    color: var(--x-text) !important;
    font-family: var(--um-font-editorial);
    font-size: var(--x-fs-h2, clamp(2.25rem, 3.2vw, 3rem));
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.08;
    text-wrap: balance;
  }

  .svc-close__text {
    max-width: 52ch;
    margin-top: 16px !important;
    color: var(--x-text-2) !important;
    font-size: 1.0625rem;
    line-height: 1.6;
  }

  .svc-close__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    margin-top: 32px;
  }

  .svc-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    padding: 0 24px;
    border-radius: 0;
    background: var(--x-red);
    color: #fff !important;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    transition: background-color 160ms var(--x-ease);
  }

  .svc-btn:hover {
    background: var(--x-red-hover, #b91c1c);
  }

  .svc-btn:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .svc-close__alt {
    color: var(--x-muted) !important;
    font-size: 1rem;
    line-height: 1.5;
  }

  .svc-close__alt .svc-textlink {
    display: inline;
  }

  /* EmailLink es un componente hijo: el estilo .svc-textlink necesita :global para llegar al <a>. */
  .svc-close__alt :global(a[data-um-email-link]) {
    color: var(--x-text) !important;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-color: var(--x-line-strong);
    text-underline-offset: 5px;
    transition: text-decoration-color 160ms var(--x-ease);
  }

  .svc-close__alt :global(a[data-um-email-link]:hover) {
    text-decoration-color: var(--x-red);
  }

  .svc-ficha .svc-kicker {
    margin-bottom: 12px;
  }

  .svc-ficha dl {
    margin: 0;
    border-top: 1px solid var(--x-line-strong);
  }

  .svc-ficha dl > div {
    display: grid;
    grid-template-columns: minmax(120px, 0.4fr) minmax(0, 0.6fr);
    gap: 16px;
    padding: 12px 0;
    border-bottom: 1px solid var(--x-line);
  }

  .svc-ficha dt {
    color: var(--x-muted);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.45;
  }

  .svc-ficha dd {
    min-width: 0;
    color: var(--x-text) !important;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.45;
    overflow-wrap: anywhere;
  }

  .svc-ficha ul {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .svc-ficha li {
    font-weight: 500;
  }

  @media (max-width: 1120px), (pointer: coarse) {
    .svc-textlink {
      min-height: 44px;
    }
  }

  @media (max-width: 1120px) {
    .svc-close {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 760px) {
    .svc-head {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-bottom: 24px;
    }

    .svc-list > li {
      grid-template-columns: 40px minmax(0, 1fr);
      padding: 16px 0;
    }

    .svc-list__text {
      grid-column: 2;
    }

    .svc-case {
      grid-template-columns: minmax(0, 1fr);
      padding: 14px 0;
    }

    .svc-close__actions {
      align-items: stretch;
      flex-direction: column;
    }

    .svc-btn {
      justify-content: center;
    }

    .svc-ficha dl > div {
      grid-template-columns: minmax(104px, 0.38fr) minmax(0, 0.62fr);
      gap: 12px;
      padding: 10px 0;
    }

    /* Ritmo móvil */
    .svc {
      --svc-pad: 56px;
    }

    .svc-textlink {
      min-height: 44px;
    }

    .svc-close {
      gap: 32px;
    }

    .svc-close__actions {
      margin-top: 24px;
      gap: 8px;
    }

    .svc-close__alt .svc-textlink {
      display: inline-flex;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .svc *,
    .svc *::before,
    .svc *::after {
      transition: none !important;
    }
  }

  /* Demo de producto (104, 105, 106): sección "papel", el tono de la landing de comunidades
     profesionales (superficies claras, una frase por idea). El hero cine sigue oscuro. */
  .svc-section--paper {
    --x-text: #182120;
    --x-text-2: #3c423f;
    --x-muted: #5f6368;
    --x-line: rgba(24, 33, 32, 0.14);
    --x-line-strong: rgba(24, 33, 32, 0.28);
    --x-panel: #f4f6f4;
    --x-panel-2: #e9eee9;
    /* La piel oscura pinta p/li/dd del main con --skin-* e !important: acá esos
       tokens pasan a sus valores claros para que el texto se lea sobre papel. */
    --skin-text: #182120;
    --skin-muted: #3c423f;
    --skin-line: rgba(24, 33, 32, 0.14);
    --skin-panel: #f4f6f4;
    --skin-panel-strong: #e9eee9;
    --skin-page: #fcfcf9;
    --skin-section: #fcfcf9;
    --skin-section-alt: #f4f6f4;
    background: #fcfcf9;
    color: #182120;
  }
  .svc-section--paper .svc-kicker { color: #bd352d; }
</style>
