---
import Layout from '../../../layouts/Layout.astro';
import { generateSlug } from '../../../utils/slugUtils.js';
import { directus } from '../../../utils/directus.js';
import { serviciosReales, serviciosPorId } from '../../../data/servicios_reales_db.js';
import { serviciosNuevosPorId } from '../../../data/servicios_nuevos_mock.js';
import { getServiceImageUrl } from '../../../utils/imageUtils.js';
import { getServiceSEO } from '../../../data/servicios_seo_config.js';

import ProjectCard from '../../../components/ProjectCard.astro';
import { getAntecedenteImageUrl } from '../../../utils/directus.js';

const { id, slug } = Astro.params;

if (!id || !slug) {
  return Astro.redirect('/404');
}

// Cargar Antecedentes de Directus con TODOS los datos para las Cards
let antecedentsList = [];
try {
  const antResponse = await directus.getAntecedentes({ 
    limit: -1, 
    fields: 'id,Cliente,Imagen,Titulo,Descripcion,Fecha,Area,Unidad_de_negocio'
  });
  if (antResponse?.data) {
    antecedentsList = antResponse.data;
  }
} catch (error) {
  console.error("Error cargando antecedentes de Directus:", error);
}

// Helper: Find full antecedente object by cliente name
function findAntecedente(clienteName) {
  if (!clienteName) return null;
  const normalizedName = clienteName.toLowerCase().trim().split(' ')[0];
  // Fuzzy match: check if first word of client name matches
  return antecedentsList.find(ant => 
    ant.Cliente && ant.Cliente.toLowerCase().includes(normalizedName)
  );
}



// Intentar cargar el servicio
let servicioRaw = null;
let source = 'directus';
const idNum = parseInt(id);

// 1. DIRECTUS ES LA FUENTE PRINCIPAL para todos los servicios
// Esto permite editar TODOS los campos desde el admin de Directus
try {
  const response = await directus.getServicioById(id);
  if (response) {
    servicioRaw = response;
    source = 'directus';
  }
} catch (e) {
  console.warn(`Servicio ${id} no encontrado en Directus, probando fallback...`);
}

// 2. Fallback a Mock Local solo si Directus no tiene el servicio
if (!servicioRaw && !isNaN(idNum) && serviciosNuevosPorId[idNum]) {
  servicioRaw = serviciosNuevosPorId[idNum];
  source = 'local_new';
}

// 3. Fallback a Legacy Local
if (!servicioRaw && !isNaN(idNum) && serviciosPorId[idNum]) {
  servicioRaw = serviciosPorId[idNum];
  source = 'local_legacy';
}
// 4. Final check
if (!servicioRaw) {
  // Try one last time with string ID lookup if numeric failed
   try {
      const response = await directus.getServicios({
        filter: { original_id: { _eq: id.toString() } },
        limit: 1
      });
      if (response && response.data && response.data.length > 0) {
        servicioRaw = response.data[0];
        source = 'directus_legacy';
      }
   } catch (e) {
      console.error(e);
   }
}
let servicio = null;
if (servicioRaw) {
  if (source === 'local_new') {
    servicio = servicioRaw;
  } else {
    servicio = {
      ...servicioRaw,
      Servicios: servicioRaw.Servicios || [],
      Caracteristicas: servicioRaw.Caracteristicas || [],
      Productos: servicioRaw.Productos || servicioRaw.Servicios_Detalle || [],
      Stats: servicioRaw.Stats || null,
      Antecedentes: servicioRaw.Antecedentes || [],
      AntecedentesIds: servicioRaw.AntecedentesIds || []
    };
  }
} else {
  console.warn(`[SERVICIOS] Registro ${id} no encontrado en Directus, usando fallback local legacy`);
  servicio = serviciosPorId[id];
  source = 'local_legacy';
}

if (!servicio) {
  return Astro.redirect('/404');
}

// --- NUEVA LÓGICA DE ANTECEDENTES REFINADA ---
let finalAntecedentes = [];

// 1. Prioridad: AntecedentesIds de Directus (Relación explícita)
if (servicio && servicio.AntecedentesIds && (Array.isArray(servicio.AntecedentesIds) ? servicio.AntecedentesIds.length > 0 : !!servicio.AntecedentesIds)) {
  const ids = Array.isArray(servicio.AntecedentesIds) ? servicio.AntecedentesIds.map(i => Number(i)) : [Number(servicio.AntecedentesIds)];
  finalAntecedentes = antecedentsList.filter(ant => ids.includes(Number(ant.id)));
  console.log(`[ANTECEDENTES] Encontrados ${finalAntecedentes.length} por IDs para servicio ${id}`);
}

// 2. Fallback: Por Área (Reutilizando patrón de individuales)
if (finalAntecedentes.length === 0 && servicio && servicio.Area) {
  finalAntecedentes = antecedentsList
    .filter(ant => ant.Area === servicio.Area)
    .slice(0, 3);
  console.log(`[ANTECEDENTES] Encontrados ${finalAntecedentes.length} por Área (${servicio.Area}) para servicio ${id}`);
}

// 3. Fallback: Lógica anterior (Mock Antecedentes o Fuzzy match)
if (finalAntecedentes.length === 0 && servicio && servicio.Antecedentes && servicio.Antecedentes.length > 0) {
  finalAntecedentes = servicio.Antecedentes.map(row => {
    const realAntec = findAntecedente(row.Cliente);
    if (realAntec) return realAntec;
    
    // Mapping format for Mock compatibility
    return {
      id: `mock-${row.Cliente}`,
      Titulo: row.Proyecto || 'Proyecto sin título',
      Cliente: row.Cliente,
      Descripcion: row.Alcance || '',
      Fecha: new Date().toISOString(),
      Area: servicio.Titulo || 'Servicios',
      isMock: true
    };
  });
  console.log(`[ANTECEDENTES] Cargados ${finalAntecedentes.length} desde campo Antecedentes (Fuzzy/Mock)`);
}

// Procesar imágenes y slugs para todos los antecedentes finales
const processedAntecedentes = await Promise.all(
  finalAntecedentes.map(async (ant) => {
    const img = await getAntecedenteImageUrl(ant);
    return {
      ...ant,
      CardProps: {
        id: String(ant.id),
        titulo: ant.Titulo || ant.titulo,
        cliente: ant.Cliente || ant.cliente,
        descripcion: ant.Descripcion || ant.descripcion || '',
        fecha: ant.Fecha || ant.fecha || new Date().toISOString(),
        area: ant.Area || ant.area || 'Tecnología',
        servicio: ant.Unidad_de_negocio || ant.servicio || 'Servicio IT',
        imagen: img,
        slug: generateSlug(ant.Titulo || ant.titulo || 'proyecto')
      }
    };
  })
);

const expectedSlug = generateSlug(servicio.Titulo);
if (slug !== expectedSlug) {
  return Astro.redirect(`/servicios/${id}/${expectedSlug}`);
}

// Helper de imágenes
const getImageForService = (titulo) => {
  if (servicio.Imagen && (servicio.Imagen.startsWith('http') || servicio.Imagen.startsWith('/assets/') || servicio.Imagen.startsWith('/directus-assets/'))) {
    return servicio.Imagen;
  }
  if (servicio.Productos && servicio.Productos.length > 0) {
     return servicio.Productos[0].imagen;
  }
  
  if (!titulo) return '/images/services/soportetic.png';
  const tituloLower = titulo.toLowerCase();
  
  const servicioImageMap = {
     'videovigilancia': '/images/services/seguridad.png',
     'cctv': '/images/services/seguridad.png',
     'seguridad': '/images/services/seguridad.png',
     'desarrollo': '/images/services/desarrollo.png',
     'software': '/images/services/desarrollo.png',
     'consultoria': '/images/services/consultoria.png',
     'consultoría': '/images/services/consultoria.png',
     'infraestructura': '/images/services/redinfraestructura.png',
     'redes': '/images/services/redinfraestructura.png',
     'soporte': '/images/services/soportetic.png'
  };

  for (const [keyword, imagePath] of Object.entries(servicioImageMap)) {
    if (tituloLower.includes(keyword)) return imagePath;
  }
  return '/images/services/desarrollo.png';
};

// SEO
const seoId = servicio.original_id ? parseInt(servicio.original_id) : (typeof id === 'string' ? parseInt(id) : id);
const seoConfig = getServiceSEO(seoId);
const pageTitle = seoConfig?.title || `${servicio.Titulo} - Servicios IT - ULTIMA MILLA`;
const pageDescription = seoConfig?.description || servicio.Descripcion;
const pageKeywords = seoConfig?.keywords || '';
const pageCanonical = seoConfig?.canonical || `https://ultimamilla.com.ar/servicios/${id}/${slug}`;
const pageOgImage = seoConfig?.ogImage || getImageForService(servicio.Titulo);

// Generate Schema.org JSON-LD for Service
const serviceSchema = seoConfig?.schema ? {
  "@context": "https://schema.org",
  ...seoConfig.schema,
  "@id": `https://ultimamilla.com.ar/servicios/${id}/${slug}#service`,
  "url": pageCanonical,
  "image": pageOgImage,
  "provider": {
    "@type": "Organization",
    "@id": "https://ultimamilla.com.ar/#organization",
    "name": "Ultima Milla",
    "url": "https://ultimamilla.com.ar"
  },
  "areaServed": seoConfig.regions?.map(r => ({ "@type": "State", "name": r })) || []
} : null;

// Generate Schema.org JSON-LD for FAQ
const faqSchema = seoConfig?.faqs?.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": seoConfig.faqs.map(faq => ({
    "@type": "Question",
    "name": faq.question,
    "acceptedAnswer": {
      "@type": "Answer",
      "text": faq.answer
    }
  }))
} : null;

// Breadcrumb Schema
const breadcrumbSchema = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    { "@type": "ListItem", "position": 1, "name": "Inicio", "item": "https://ultimamilla.com.ar/" },
    { "@type": "ListItem", "position": 2, "name": "Servicios", "item": "https://ultimamilla.com.ar/servicios" },
    { "@type": "ListItem", "position": 3, "name": servicio.Titulo, "item": pageCanonical }
  ]
};
---

<Layout 
  title={pageTitle} 
  description={pageDescription}
  keywords={pageKeywords}
  image={pageOgImage}
  canonical={pageCanonical}
>
  <!-- Schema.org JSON-LD -->
  {serviceSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(serviceSchema)} />
  )}
  {faqSchema && (
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  )}
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} />

  <main class="min-h-screen bg-white">
    <!-- Breadcrumbs: Balanced spacing -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-4 mb-2">
        <nav class="flex py-2" aria-label="Breadcrumb">
            <ol class="inline-flex items-center space-x-1 md:space-x-3">
                <li class="inline-flex items-center">
                    <a href="/" class="inline-flex items-center text-sm font-medium text-gray-700 hover:text-blue-600">Inicio</a>
                </li>
                <li>
                    <div class="flex items-center">
                        <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                        </svg>
                        <a href="/servicios" class="ml-1 text-sm font-medium text-gray-700 hover:text-blue-600 md:ml-2">Servicios</a>
                    </div>
                </li>
                <li aria-current="page">
                    <div class="flex items-center">
                        <svg class="w-3 h-3 text-gray-400 mx-1" aria-hidden="true" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 6 10">
                            <path stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="m1 9 4-4-4-4"/>
                        </svg>
                        <span class="ml-1 text-sm font-medium text-gray-500 md:ml-2">{servicio.Titulo}</span>
                    </div>
                </li>
            </ol>
        </nav>
    </div>

    <!-- Hero Section -->
    <section class="relative bg-white overflow-hidden pt-2 pb-12 md:pt-4 md:pb-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-center">
          <div class="order-2 lg:order-1 space-y-6">
            <div class="inline-block">
              <span class="text-xs font-bold uppercase tracking-widest text-blue-600">
                ● {servicio.Area}
              </span>
            </div>
            
            <h1 class="text-4xl md:text-5xl lg:text-6xl font-black text-slate-900 leading-tight">
              {servicio.Titulo}
            </h1>
            
            {servicio.Subtitulo && (
              <h2 class="text-xl md:text-2xl font-medium text-blue-800">
                {servicio.Subtitulo}
              </h2>
            )}

            <p class="text-lg text-slate-600 leading-relaxed">
              {servicio.Descripcion}
            </p>

            {servicio.Tagline && (
              <p class="text-sm font-bold text-slate-500 uppercase tracking-wide border-l-4 border-blue-500 pl-4">
                {servicio.Tagline}
              </p>
            )}

            <div class="flex flex-wrap gap-4 pt-4">
              <a href="#contacto" class="px-8 py-4 bg-blue-600 text-white font-bold rounded-lg hover:bg-blue-700 transition-all shadow-lg hover:shadow-xl">
                Solicitar Cotización
              </a>
            </div>
          </div>

          <!-- Hero Image: Sin bordes, sin sombras, fondo continuo -->
          <div class="order-1 lg:order-2 flex items-center justify-center">
            <img
              src={getImageForService(servicio.Titulo)}
              alt={servicio.Titulo}
              class="w-full max-w-lg h-auto object-contain mix-blend-multiply"
              loading="eager"
              onerror="this.src='/images/antecedentes-hero-bg.jpg'; this.onerror=null;"
            />
          </div>
        </div>
      </div>
    </section>

    <!-- Stats Section (Solo para servicios nuevos) -->
    {servicio.Stats && (
      <section class="bg-slate-900 py-12 border-y border-slate-800">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 text-center divide-y md:divide-y-0 md:divide-x divide-slate-800">
            {servicio.Stats.map((stat) => (
              <div class="p-4">
                <div class="text-4xl md:text-5xl font-black text-white mb-2 text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-emerald-400">
                  {stat.valor}
                </div>
                <div class="text-sm font-bold text-slate-400 uppercase tracking-widest">
                  {stat.label}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Productos Section: Sin bordes, sin sombras, sin efectos hover -->
    {servicio.Productos && servicio.Productos.length > 0 && (
      <section class="py-20 bg-white">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <h2 class="text-3xl font-black text-center text-slate-900 mb-16 uppercase tracking-wider">
            Productos y Equipamiento
          </h2>
          
          <div class="space-y-24">
            {servicio.Productos.map((prod, idx) => (
              <div class={`flex flex-col md:flex-row items-center gap-12 ${idx % 2 === 1 ? 'md:flex-row-reverse' : ''}`}>
                
                <!-- Imagen con máscara radial para fundir bordes no-blancos -->
                <div class="w-full md:w-1/2 flex justify-center">
                  <div class="relative w-full max-w-md">
                    <img 
                      src={prod.imagen} 
                      alt={prod.nombre}
                      class="w-full h-auto object-contain product-image-blend"
                      onerror="this.src='/images/antecedentes-hero-bg.jpg'; this.onerror=null;"
                    />
                  </div>
                </div>
                
                <div class="w-full md:w-1/2 space-y-6">
                  <h3 class="text-2xl font-bold text-slate-900">{prod.nombre}</h3>
                  <p class="text-slate-600 leading-relaxed text-lg">{prod.descripcion}</p>
                  
                  <!-- Bullets sin doble checkmark: Solo texto, sin SVG interno -->
                  {prod.caracteristicas && (
                    <ul class="space-y-3 mb-6">
                      {prod.caracteristicas.map(c => (
                        <li class="flex items-start space-x-3 text-slate-700">
                          <span class="text-blue-500 font-bold flex-shrink-0">✓</span>
                          <span>{c.replace(/^✓\s*/, '')}</span>
                        </li>
                      ))}
                    </ul>
                  )}

                  {prod.servicio_asociado && (
                    <div class="p-4 bg-blue-50 border-l-4 border-blue-500 rounded-r-lg">
                      <p class="text-blue-900 font-medium text-sm leading-relaxed">
                        {prod.servicio_asociado}
                      </p>
                    </div>
                  )}
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>
    )}

    <!-- Main Content Section -->
    <section class="py-16 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
          
          <div class="lg:col-span-2 space-y-12">
             <!-- Servicios Incluidos -->
             {servicio.Servicios && servicio.Servicios.length > 0 && (
              <div class="bg-white rounded-xl shadow-sm border border-slate-200 p-8">
                <h3 class="text-2xl font-bold text-slate-900 mb-6">Servicios Incluidos</h3>
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  {servicio.Servicios.map((s) => (
                    <div class="flex items-start space-x-3">
                      <span class="text-blue-600 font-bold flex-shrink-0">✓</span>
                      <span class="text-slate-700">{s}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- Por Qué Elegirnos / Características -->
            {(servicio.PorQueElegirnos || servicio.Caracteristicas) && (
              <div class="bg-blue-50 rounded-xl p-8 border border-blue-100">
                 <h3 class="text-2xl font-bold text-slate-900 mb-6">
                   {servicio.PorQueElegirnos ? 'Por Qué Elegirnos' : 'Características'}
                 </h3>
                 <ul class="space-y-4">
                   {(servicio.PorQueElegirnos || servicio.Caracteristicas).map(item => (
                     <li class="flex items-center space-x-3">
                       <span class="flex-shrink-0 w-8 h-8 rounded-full bg-blue-200 flex items-center justify-center text-blue-700 font-bold">✓</span>
                       <span class="text-slate-800 font-medium">{item}</span>
                     </li>
                   ))}
                 </ul>
              </div>
            )}

            <!-- Antecedentes: Estilo Refinado -->
            {processedAntecedentes.length > 0 && (
              <div class="mt-16">
                <h3 class="text-3xl font-bold text-slate-900 mb-8 flex items-center">
                  <span class="w-1 h-8 bg-cyan-500 mr-4"></span>
                  Antecedentes Destacados
                </h3>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                  {processedAntecedentes.map((ant) => (
                    <div class="h-full">
                       <ProjectCard {...ant.CardProps} />
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- Sidebar: Contact Card Simplificado -->
          <div class="lg:col-span-1">
            <div class="sticky top-24">
              <div id="contacto" class="bg-white rounded-2xl border-2 border-slate-200 shadow-lg overflow-hidden">
                
                <!-- Header con gradiente -->
                <div class="bg-gradient-to-r from-blue-600 to-cyan-500 px-6 py-5">
                  <h3 class="text-white font-black text-xl">¿Necesita este servicio?</h3>
                  <p class="text-blue-100 text-sm mt-1">Respuesta en menos de 24hs</p>
                </div>
                
                <!-- Body -->
                <div class="p-6">
                  <p class="text-slate-600 text-sm leading-relaxed mb-6">
                    Nuestro equipo de ingenieros está listo para asesorarlo. Obtenga una cotización personalizada sin compromiso.
                  </p>
                  
                  <a href="/contacto" class="block w-full py-4 bg-blue-600 text-white font-bold rounded-lg text-center hover:bg-blue-700 transition-colors">
                    Contactar Ahora
                  </a>
                  
                  <div class="mt-5 pt-5 border-t border-slate-200 flex flex-col sm:flex-row items-center justify-center gap-3 text-xs text-slate-500">
                    <span class="flex items-center gap-1">
                      <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                      Sin compromiso
                    </span>
                    <span class="flex items-center gap-1">
                      <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                        <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd" />
                      </svg>
                      Presupuesto gratis
                    </span>
                  </div>
                </div>
              </div>
            </div>
          </div>

        </div>
      </div>
    </section>

  </main>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  /* Imagen con máscara radial para fundir bordes no-blancos */
  .product-image-blend {
    mix-blend-mode: multiply;
    filter: drop-shadow(0 0 0 transparent);
  }
  
  /* Contenedor con máscara radial para suavizar bordes */
  .product-image-blend {
    -webkit-mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, black 70%, transparent 100%);
    mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, black 70%, transparent 100%);
  }
</style>
