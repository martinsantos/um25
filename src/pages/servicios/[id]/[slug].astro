---
// Activar SSR
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import { generateSlug } from '../../../utils/slugUtils';

// Importar utilidades necesarias para Directus
const PUBLIC_DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL || 'http://directus-app:8055';
const DIRECTUS_TOKEN = import.meta.env.PUBLIC_DIRECTUS_TOKEN || 'k6P8LAY8_x_y1miB_KTlWnysCnx2Abky';

// Obtener parámetros de la URL
const { id, slug } = Astro.params;

// Fetch dinámico de datos desde Directus
let servicio = null;
let antecedentesRelacionados = [];

try {
  // Obtener servicio desde Directus
  const servicioUrl = `${PUBLIC_DIRECTUS_URL}/items/Servicios/${id}`;
  const servicioResponse = await fetch(servicioUrl, {
    headers: { Authorization: `Bearer ${DIRECTUS_TOKEN}` }
  });
  
  if (servicioResponse.ok) {
    const servicioData = await servicioResponse.json();
    servicio = servicioData.data;
    console.log('Servicio from Directus:', servicio?.Titulo);
  }

  // Obtener antecedentes relacionados por área
  if (servicio?.Area) {
    const antecedentesUrl = `${PUBLIC_DIRECTUS_URL}/items/Antecedentes?filter[area][_eq]=${encodeURIComponent(servicio.Area)}&limit=6`;
    const antecedentesResponse = await fetch(antecedentesUrl, {
      headers: { Authorization: `Bearer ${DIRECTUS_TOKEN}` }
    });
    
    if (antecedentesResponse.ok) {
      const antecedentesData = await antecedentesResponse.json();
      antecedentesRelacionados = antecedentesData.data || [];
    }
  }
} catch (error) {
  console.error('Error fetching data:', error);
}

// Si no se encuentra el servicio, devolver 404
if (!servicio) {
  return Astro.redirect('/404');
}

// Verificar que el slug coincida (para SEO)
const expectedSlug = generateSlug(servicio.Titulo || servicio.title);
if (slug !== expectedSlug) {
  return Astro.redirect(`/servicios/${id}/${expectedSlug}`);
}

// Mapeo dinámico de imágenes por ID
const imageMapping = {
  1: 'servicios-it.jpg',
  2: 'redes-datos.jpg', 
  3: 'seguridad-informatica.jpg',
  4: 'servicios-gestionados.jpg',
  5: 'consultoria.jpg',
  11: 'servicios-web.jpg'
};

const servicioImagen = servicio.Imagen || imageMapping[servicio.id] || 'default-service.jpg';
---

<Layout title={`${servicio.Titulo || servicio.Nombre || servicio.title} - Servicios - Ultima Milla`}>
  <main class="min-h-screen bg-gradient-to-br from-slate-50 to-blue-50">
    <!-- Breadcrumb -->
    <nav class="bg-white shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <ol class="flex items-center space-x-2 text-gray-600">
          <li><a href="/" class="hover:text-blue-600 transition-colors">Inicio</a></li>
          <li><span class="mx-2">/</span></li>
          <li><a href="/servicios" class="hover:text-blue-600 transition-colors">Servicios</a></li>
          <li><span class="mx-2">/</span></li>
          <li class="text-blue-600 font-medium">{servicio.Titulo || servicio.Nombre || servicio.title}</li>
        </ol>
      </div>
    </nav>

    <!-- Hero Section con background-image -->
    <div class="service-hero" style={`background-image: url('/images/services/${servicioImagen}'); background-size: cover; background-position: center; min-height: 400px; position: relative;`}>
      <div class="absolute inset-0 bg-gradient-to-r from-blue-900/80 via-purple-900/70 to-blue-900/80"></div>
      <div class="hero-content relative z-10 flex items-center justify-center min-h-[400px]">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center py-20">
          <div class="inline-block bg-white/20 text-white px-4 py-2 rounded-full text-sm font-semibold mb-4">
            {servicio.Area || 'Servicios'}
          </div>
          <h1 class="text-4xl md:text-5xl font-bold mb-6 text-white">
            {servicio.Titulo}
          </h1>
          <p class="text-xl text-blue-100 mb-8 leading-relaxed max-w-3xl mx-auto">
            {servicio.Descripcion?.split('\n')[0] || ''}
          </p>
          <div class="flex items-center justify-center space-x-6">
            <div class="text-center">
              <div class="text-2xl font-bold text-yellow-300">
                {servicio.Cliente || 'Empresas'}
              </div>
              <div class="text-sm text-blue-200">Tipo de cliente</div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Contenido Principal -->
    <section class="py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-12">
          <!-- Contenido Principal -->
          <div class="lg:col-span-2 space-y-12">
            <!-- Información del Servicio -->
            <div class="bg-white rounded-2xl shadow-lg p-8">
              <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center">
                <svg class="w-8 h-8 text-blue-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Información del Servicio
              </h2>
              
              <div class="prose prose-lg max-w-none text-gray-700">
                {servicio.Descripcion?.split('\n').map(paragraph => 
                  paragraph.trim() && <p class="mb-4">{paragraph}</p>
                )}
              </div>
            </div>

            <!-- Servicios Incluidos -->
            {servicio.Servicios_incluidos && servicio.Servicios_incluidos.trim() && (
              <div class="bg-white rounded-2xl shadow-lg p-8">
                <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center">
                  <svg class="w-8 h-8 text-green-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                  </svg>
                  Servicios Incluidos
                </h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  {servicio.Servicios_incluidos.split(',').map((servicio_item) => (
                    <div class="flex items-center space-x-3 p-4 bg-green-50 rounded-lg">
                      <svg class="w-5 h-5 text-green-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                      </svg>
                      <span class="text-gray-800 font-medium">{servicio_item.trim()}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}

            <!-- Características -->
            {servicio.Caracteristicas && servicio.Caracteristicas.trim() && (
              <div class="bg-white rounded-2xl shadow-lg p-8">
                <h2 class="text-3xl font-bold text-gray-900 mb-8 flex items-center">
                  <svg class="w-8 h-8 text-purple-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11.049 2.927c.3-.921 1.603-.921 1.902 0l1.519 4.674a1 1 0 00.95.69h4.915c.969 0 1.371 1.24.588 1.81l-3.976 2.888a1 1 0 00-.363 1.118l1.518 4.674c.3.922-.755 1.688-1.538 1.118l-3.976-2.888a1 1 0 00-1.176 0l-3.976 2.888c-.783.57-1.838-.197-1.538-1.118l1.518-4.674a1 1 0 00-.363-1.118l-3.976-2.888c-.784-.57-.38-1.81.588-1.81h4.914a1 1 0 00.951-.69l1.519-4.674z"></path>
                  </svg>
                  Características Destacadas
                </h2>
                
                <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                  {servicio.Caracteristicas.split(',').map((caracteristica) => (
                    <div class="flex items-center space-x-3 p-4 bg-purple-50 rounded-lg">
                      <svg class="w-5 h-5 text-purple-600 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
                      </svg>
                      <span class="text-gray-800 font-medium">{caracteristica.trim()}</span>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>

          <!-- Sidebar -->
          <div class="space-y-8">
            <!-- Información del Servicio -->
            <div class="bg-gradient-to-br from-blue-600 to-purple-600 text-white rounded-2xl p-8 shadow-lg">
              <h3 class="text-2xl font-bold mb-6 flex items-center">
                <svg class="w-6 h-6 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
                </svg>
                Información del Servicio
              </h3>
              
              <div class="space-y-6">
                <div class="bg-white/20 rounded-lg p-4">
                  <div class="text-blue-100 text-sm mb-1">Área</div>
                  <div class="text-white font-semibold">{servicio.Area || 'Servicios'}</div>
                </div>
                
                <div class="bg-white/20 rounded-lg p-4">
                  <div class="text-blue-100 text-sm mb-1">Cliente Objetivo</div>
                  <div class="text-white font-semibold">{servicio.Cliente || 'Empresas'}</div>
                </div>
                
                <div class="bg-white/20 rounded-lg p-4">
                  <div class="text-blue-100 text-sm mb-1">ID del Servicio</div>
                  <div class="text-white font-semibold">#{servicio.id.toString().padStart(4, '0')}</div>
                </div>
              </div>
            </div>

            <!-- Contacto -->
            <div class="bg-white rounded-2xl shadow-lg p-8">
              <h3 class="text-2xl font-bold text-gray-900 mb-6 flex items-center">
                <svg class="w-6 h-6 text-blue-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 4.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
                </svg>
                Contacto
              </h3>
              
              <p class="text-gray-600 mb-6">
                ¿Interesado en este servicio? Contáctanos para más información.
              </p>
              
              <div class="space-y-4">
                <a href="/contacto" class="w-full bg-blue-600 text-white py-3 px-6 rounded-lg font-semibold hover:bg-blue-700 transition-colors flex items-center justify-center">
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-3.582 8-8 8a8.955 8.955 0 01-4.126-.98L3 20l1.98-5.874A8.955 8.955 0 013 12c0-4.418 3.582-8 8-8s8 3.582 8 8z"></path>
                  </svg>
                  Solicitar Información
                </a>
                
                <a href="tel:+54113456789" class="w-full bg-gray-100 text-gray-800 py-3 px-6 rounded-lg font-semibold hover:bg-gray-200 transition-colors flex items-center justify-center">
                  <svg class="w-5 h-5 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
                  </svg>
                  +54 11 3456-7890
                </a>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Antecedentes Relacionados Carousel -->
    {antecedentesRelacionados && antecedentesRelacionados.length > 0 && (
      <section class="py-16 bg-gray-50">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
          <div class="text-center mb-12">
            <h2 class="text-3xl font-bold text-gray-900 mb-4">Proyectos Relacionados</h2>
            <p class="text-gray-600 max-w-2xl mx-auto">
              Conocé algunos de nuestros proyectos exitosos en el área de {servicio.Area}
            </p>
          </div>
          
          <div class="relative">
            <div class="flex overflow-x-auto gap-6 pb-4 scrollbar-hide">
              {antecedentesRelacionados.map((antecedente) => (
                <div class="flex-none w-80 bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-xl transition-shadow">
                  <div class="h-48 bg-gradient-to-br from-blue-500 to-purple-600 relative overflow-hidden">
                    {antecedente.imagen_principal && (
                      <img 
                        src={`${PUBLIC_DIRECTUS_URL}/assets/${antecedente.imagen_principal}`}
                        alt={antecedente.titulo}
                        class="w-full h-full object-cover"
                        loading="lazy"
                      />
                    )}
                    <div class="absolute inset-0 bg-gradient-to-t from-black/50 to-transparent"></div>
                  </div>
                  
                  <div class="p-6">
                    <div class="text-sm text-blue-600 font-medium mb-2">{antecedente.area}</div>
                    <h3 class="text-lg font-bold text-gray-900 mb-3 line-clamp-2">
                      {antecedente.titulo}
                    </h3>
                    <p class="text-gray-600 text-sm mb-4 line-clamp-3">
                      {antecedente.descripcion_breve}
                    </p>
                    
                    <a 
                      href={`/antecedentes/${antecedente.id}/${antecedente.slug}`}
                      class="inline-flex items-center text-blue-600 hover:text-blue-800 font-medium text-sm transition-colors"
                    >
                      Ver proyecto
                      <svg class="w-4 h-4 ml-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path>
                      </svg>
                    </a>
                  </div>
                </div>
              ))}
            </div>
            
            {antecedentesRelacionados.length > 3 && (
              <div class="flex justify-center mt-8">
                <a 
                  href={`/antecedentes?area=${encodeURIComponent(servicio.Area)}`}
                  class="bg-blue-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-blue-700 transition-colors"
                >
                  Ver todos los proyectos de {servicio.Area}
                </a>
              </div>
            )}
          </div>
        </div>
      </section>
    )}

  </main>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>
