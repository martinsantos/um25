---
import LayoutV4 from '../../layouts/LayoutV4.astro';

type Service = {
  code: string;
  name: string;
  slug: string;
  tagline: string;
  description: string;
  capabilities: string[];
  sectors: number;
  evidence: number;
  image: string;
};

const services: Service[] = [
  {
    code: '101',
    name: 'Redes',
    slug: 'infraestructura-de-redes-cableado-fibra-optica-radioenlaces',
    tagline: 'Cableado estructurado, fibra optica y enlaces certificados.',
    description:
      'Disenamos e implementamos redes fisicas y logicas para edificios, plantas, campamentos y sedes distribuidas, con documentacion tecnica verificable.',
    capabilities: ['Relevamiento y diseno de topologia', 'Cableado estructurado y fibra optica', 'Certificacion y documentacion', 'Mantenimiento correctivo y preventivo'],
    sectors: 9,
    evidence: 86,
    image: '/img/servicios/redes.webp',
  },
  {
    code: '102',
    name: 'Seguridad electronica',
    slug: 'sistemas-de-seguridad-electronica-cctv-control-acceso-sistemas-de-deteccion-de-incendios-sdi',
    tagline: 'CCTV IP, control de accesos y monitoreo operativo.',
    description:
      'Integramos camaras, grabacion, accesos, alarmas y visualizacion para que la evidencia sea util, disponible y auditable por responsables tecnicos.',
    capabilities: ['CCTV IP y VMS', 'Control de accesos', 'Monitoreo y grabacion', 'Integracion con operacion existente'],
    sectors: 8,
    evidence: 72,
    image: '/img/servicios/seguridad-electronica.webp',
  },
  {
    code: '103',
    name: 'Telecomunicaciones',
    slug: 'telecomunicaciones-datos-voz-video',
    tagline: 'Datos, voz y video para sitios remotos.',
    description:
      'Resolvemos conectividad de ultima milla, radioenlaces, enlaces corporativos y comunicaciones de respaldo para operaciones que no pueden quedar aisladas.',
    capabilities: ['Radioenlaces y enlaces dedicados', 'Voz, datos y video', 'Redundancia y contingencia', 'Operaciones remotas'],
    sectors: 8,
    evidence: 64,
    image: '/img/servicios/telecomunicaciones.webp',
  },
  {
    code: '104',
    name: 'Software a medida',
    slug: 'desarrollo-de-software-a-medida-web-mobile-erp',
    tagline: 'Sistemas, APIs y tableros para procesos propios.',
    description:
      'Desarrollamos plataformas web, moviles, integraciones y tableros para digitalizar procesos reales sin despegar el sistema de la operacion diaria.',
    capabilities: ['Aplicaciones web y moviles', 'APIs e integraciones', 'Dashboards operativos', 'Automatizacion de procesos'],
    sectors: 7,
    evidence: 58,
    image: '/img/servicios/software-a-medida.webp',
  },
  {
    code: '105',
    name: 'Soporte 24/7',
    slug: 'soporte-tecnico-247-mesa-de-ayuda-mantenimiento-it',
    tagline: 'Mesa de ayuda, NOC y mantenimiento con SLA.',
    description:
      'Acompanamos infraestructura instalada con soporte, monitoreo y mantenimiento para reducir tiempos de respuesta y sostener continuidad operativa.',
    capabilities: ['Mesa de ayuda', 'Monitoreo NOC', 'Mantenimiento en sitio', 'Gestion de incidentes y SLA'],
    sectors: 9,
    evidence: 92,
    image: '/img/servicios/soporte-247.webp',
  },
  {
    code: '106',
    name: 'Consultoria IT',
    slug: 'consultoria-it-y-transformacion-digital-arquitectura-auditoria',
    tagline: 'Arquitectura, auditoria y roadmap operativo.',
    description:
      'Evaluamos riesgos, infraestructura, procesos y decisiones tecnologicas para ordenar inversiones y transformar necesidades en alcance ejecutable.',
    capabilities: ['Auditoria tecnica', 'Roadmap de infraestructura', 'Analisis de riesgo', 'Pliegos y especificaciones'],
    sectors: 9,
    evidence: 44,
    image: '/img/servicios/consultoria-it.webp',
  },
  {
    code: '107',
    name: 'Deteccion de incendios',
    slug: 'sistemas-de-deteccion-y-alarma-de-incendios',
    tagline: 'SDI, sensores y paneles para entornos productivos.',
    description:
      'Implementamos deteccion y alarma de incendios con criterio tecnico, pruebas documentadas e integracion con seguridad electronica y operacion edilicia.',
    capabilities: ['Paneles y sensores', 'Pruebas y puesta en marcha', 'Documentacion de zonas', 'Mantenimiento y verificacion'],
    sectors: 7,
    evidence: 39,
    image: '/img/servicios/deteccion-incendios.webp',
  },
  {
    code: '108',
    name: 'Electricos IT',
    slug: 'servicios-electricos-para-it',
    tagline: 'Tableros, UPS y energia limpia para infraestructura.',
    description:
      'Resolvemos la capa electrica que sostiene redes, datacenters, CCTV y equipamiento critico, con instalacion prolija y continuidad medida.',
    capabilities: ['Tableros y protecciones', 'UPS y autonomia', 'Energia para racks', 'Medicion y mantenimiento'],
    sectors: 8,
    evidence: 63,
    image: '/img/servicios/electricos-it.webp',
  },
];

const totalServices = String(services.length).padStart(2, '0');
---

<LayoutV4
  title="Servicios IT para continuidad operativa | ULTIMA MILLA"
  description="8 frentes de servicio IT: redes, seguridad electronica, telecomunicaciones, software, soporte 24/7, consultoria, deteccion de incendios y electricos IT."
  keywords="servicios IT integrales, redes empresariales, seguridad electronica, telecomunicaciones, software a medida, soporte IT 24/7, consultoria IT, deteccion de incendios, electricos para IT"
  image="/img/servicios/redes.webp"
>
  <main class="um26-services">
    <section class="services-hero" aria-labelledby="services-title">
      <img src="/img/servicios/redes.webp" alt="" loading="eager" fetchpriority="high" decoding="async" />
      <div class="services-hero__veil" aria-hidden="true"></div>
      <div class="services-shell services-hero__body">
        <p class="um26-kicker"><span></span>01 / Servicios</p>
        <h1 id="services-title">Ocho frentes de servicio.</h1>
        <p>Una arquitectura tecnica, no proveedores aislados. Redes, seguridad, telecomunicaciones, software, soporte, consultoria, deteccion y energia IT conectados por evidencia operativa.</p>
        <div class="services-hero__actions">
          <a class="um26-btn um26-btn--red" href="/contacto">Solicitar diagnostico</a>
          <a class="um26-btn um26-btn--ghost" href="/antecedentes">Ver antecedentes</a>
        </div>
        <dl class="services-proofline" aria-label="Prueba institucional">
          <div><dt>Servicios</dt><dd>8 frentes integrados</dd></div>
          <div><dt>Archivo</dt><dd>518 antecedentes tecnicos</dd></div>
          <div><dt>Operacion</dt><dd>22+ anos / 24-7</dd></div>
        </dl>
      </div>
      <aside class="services-hero__note" aria-label="Criterio operativo">
        <strong>Diagnostico, implementacion, evidencia y soporte dentro de una misma cadena operativa.</strong>
        <p>El servicio debe verificarse por alcance, sector, antecedente y continuidad posterior.</p>
      </aside>
    </section>

    <section class="services-intro">
      <div class="services-shell services-intro__grid">
        <div>
          <p class="um26-kicker"><span></span>Arquitectura</p>
          <h2>Continuidad operativa primero.</h2>
        </div>
        <p>El diseno se lee en minutos y se audita despues: alcance, riesgo, integracion, responsables, evidencia tecnica y soporte posterior.</p>
      </div>
    </section>

    <section class="services-ledger" aria-label="Frentes de servicio de ULTIMA MILLA">
      <div class="services-shell">
        {services.map((service, index) => (
          <article class:list={['service-row', { 'service-row--reverse': index % 2 === 1 }]}>
                <a
                  href={`/servicios/${service.code}/${service.slug}`}
                  class="service-image"
                  style={`--service-image: url(${service.image})`}
                  aria-label={`Abrir servicio ${service.name}`}
                >
                  <img src={service.image} alt="" loading="eager" decoding="async" />
              <span class="service-image__code">SRV.{service.code}</span>
              <span class="service-image__sectors">{service.sectors} sectores</span>
              <span class="service-image__evidence"><strong>{service.evidence}<b>.</b></strong><em>antecedentes</em></span>
            </a>
            <div class="service-body">
              <p class="service-front"><span></span>Frente {String(index + 1).padStart(2, '0')} / {totalServices}</p>
              <h2><a href={`/servicios/${service.code}/${service.slug}`}>{service.name}</a></h2>
              <p class="service-tagline">{service.tagline}</p>
              <p class="service-description">{service.description}</p>
              <ul>
                {service.capabilities.map((capability) => (
                  <li><span aria-hidden="true"></span>{capability}</li>
                ))}
              </ul>
              <div class="service-footer">
                <span><strong>{service.evidence}<b>.</b></strong> antecedentes</span>
                <a href={`/servicios/${service.code}/${service.slug}`}>Ver detalle</a>
                <a href={`/antecedentes?servicio=${service.code}`}>Ver evidencia</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="services-closing">
      <div class="services-shell services-closing__panel">
        <div>
          <p class="um26-kicker"><span></span>Diagnostico sin costo inicial</p>
          <h2>Que parte de su operacion necesita estabilizar primero?</h2>
          <p>Levantamos un relevamiento tecnico y mostramos antecedentes comparables antes de proponer alcance. Un unico interlocutor para infraestructura IT critica.</p>
        </div>
        <div class="services-closing__actions">
          <a class="um26-btn um26-btn--red" href="/contacto">Solicitar relevamiento</a>
          <a class="um26-btn um26-btn--ghost" href="/sectores">Explorar por sector</a>
          <a class="um26-btn um26-btn--ghost" href="/antecedentes">Ver antecedentes</a>
        </div>
      </div>
    </section>
  </main>

  <style>
    :global(body[data-skin]) main {
      background: #0a0a0b;
    }

    .um26-services {
      background: #0a0a0b;
      color: #fafafa;
    }

    .services-shell {
      width: min(1336px, calc(100% - 126px));
      margin-inline: auto;
    }

    .services-hero {
      position: relative;
      min-height: 78vh;
      overflow: hidden;
      display: flex;
      align-items: flex-end;
      isolation: isolate;
      background: #0a0a0b;
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .services-hero > img,
    .services-hero__veil {
      position: absolute;
      inset: 0;
    }

    .services-hero > img {
      z-index: -3;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .services-hero__veil {
      z-index: -2;
      background:
        linear-gradient(100deg, rgba(10,10,11,0.94), rgba(10,10,11,0.62) 48%, rgba(10,10,11,0.2)),
        linear-gradient(to top, #0a0a0b, rgba(10,10,11,0.36), transparent);
    }

    .services-hero__body {
      position: relative;
      z-index: 1;
      padding: 0 0 72px;
    }

    .um26-kicker {
      display: inline-flex;
      align-items: center;
      gap: 14px;
      margin: 0 0 24px;
      color: #dc2626;
      font-family: var(--um-font-mono);
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .um26-kicker span {
      width: 44px;
      height: 3px;
      background: #dc2626;
    }

    .services-hero h1,
    .services-intro h2,
    .service-body h2,
    .services-closing h2 {
      margin: 0;
      font-family: var(--um-font-display);
      font-weight: 700;
      letter-spacing: 0;
      color: #fff;
    }

    .services-hero h1 {
      max-width: 12ch;
      font-size: clamp(4rem, 7vw, 6.75rem);
      line-height: 0.92;
    }

    .services-hero__body > p:not(.um26-kicker) {
      max-width: 48rem;
      margin: 28px 0 0;
      color: rgba(255,255,255,0.74);
      font-size: clamp(1rem, 1.3vw, 1.25rem);
      line-height: 1.65;
    }

    .services-hero__actions,
    .services-closing__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 34px;
    }

    .um26-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      min-height: 52px;
      padding: 0 24px;
      color: #fff;
      text-decoration: none;
      font-weight: 700;
      font-size: 0.9375rem;
      border: 1px solid rgba(255,255,255,0.26);
      transition: background 0.18s ease, border-color 0.18s ease;
    }

    .um26-btn::after {
      content: ">";
      margin-left: 10px;
    }

    .um26-btn--red {
      background: #dc2626;
      border-color: #dc2626;
    }

    .um26-btn--red:hover {
      background: #ff3b3b;
      border-color: #ff3b3b;
    }

    .um26-btn--ghost {
      background: rgba(10,10,11,0.36);
    }

    .um26-btn--ghost:hover {
      background: rgba(255,255,255,0.08);
      border-color: rgba(255,255,255,0.58);
    }

    .services-proofline {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      max-width: 780px;
      margin: 54px 0 0;
      padding: 0;
      border: 1px solid rgba(255,255,255,0.1);
      background: rgba(10,10,11,0.52);
    }

    .services-proofline div {
      padding: 22px;
      border-left: 1px solid rgba(255,255,255,0.08);
    }

    .services-proofline div:first-child {
      border-left: 0;
    }

    .services-proofline dt {
      color: #dc2626;
      font-family: var(--um-font-mono);
      font-size: 0.625rem;
      text-transform: uppercase;
      letter-spacing: 0.16em;
    }

    .services-proofline dd {
      margin: 8px 0 0;
      color: #fff;
      font-weight: 700;
      line-height: 1.35;
    }

    .services-hero__note {
      position: absolute;
      right: 48px;
      bottom: 72px;
      z-index: 2;
      max-width: 360px;
      padding-left: 22px;
      border-left: 2px solid #dc2626;
      color: rgba(255,255,255,0.72);
    }

    .services-hero__note strong {
      display: block;
      color: #fff;
      font-size: 1.15rem;
      line-height: 1.35;
    }

    .services-hero__note p {
      margin: 12px 0 0;
      line-height: 1.55;
    }

    .services-intro {
      padding: clamp(72px, 8vw, 108px) 0;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      background: #0f0f11;
    }

    .services-intro__grid {
      display: grid;
      grid-template-columns: minmax(0, 0.92fr) minmax(0, 1fr);
      gap: 72px;
      align-items: end;
    }

    .services-intro h2 {
      max-width: 12ch;
      font-size: clamp(2.6rem, 4.1vw, 4.25rem);
      line-height: 0.96;
    }

    .services-intro__grid > p {
      margin: 0;
      color: #a1a1aa;
      font-size: clamp(1rem, 1.45vw, 1.25rem);
      line-height: 1.65;
    }

    .services-ledger {
      padding: clamp(72px, 8vw, 118px) 0;
      background: #0a0a0b;
    }

    .service-row {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      border: 1px solid rgba(255,255,255,0.08);
      border-bottom: 0;
      background: #0a0a0b;
    }

    .service-row:last-child {
      border-bottom: 1px solid rgba(255,255,255,0.08);
    }

    .service-row--reverse .service-image {
      order: 2;
    }

    .service-image {
      position: relative;
      min-height: 440px;
      overflow: hidden;
      display: block;
      color: #fff;
      background: #121214 var(--service-image) center / cover no-repeat !important;
      isolation: isolate;
    }

    .service-image::after {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        linear-gradient(to top, rgba(10,10,11,0.88), rgba(10,10,11,0.18) 58%, rgba(10,10,11,0.04)),
        linear-gradient(120deg, rgba(220,38,38,0.12), transparent 34%);
    }

    .service-image img {
      position: absolute;
      inset: 0;
      z-index: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      opacity: 0;
    }

    .service-image__code,
    .service-image__sectors {
      position: absolute;
      z-index: 2;
      top: 22px;
      font-family: var(--um-font-mono);
      font-size: 0.6875rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .service-image__code {
      left: 22px;
      padding: 6px 9px;
      background: #dc2626;
      color: #fff;
      font-weight: 700;
    }

    .service-image__sectors {
      left: 112px;
      color: rgba(255,255,255,0.7);
    }

    .service-image__evidence {
      position: absolute;
      z-index: 2;
      right: 28px;
      bottom: 28px;
      display: grid;
      justify-items: end;
      color: #fff;
    }

    .service-image__evidence strong {
      font-family: var(--um-font-display);
      font-size: clamp(2.4rem, 4vw, 3.4rem);
      line-height: 1;
      letter-spacing: 0;
    }

    .service-image__evidence b,
    .service-footer b {
      color: #dc2626;
      font-weight: inherit;
    }

    .service-image__evidence em {
      margin-top: 7px;
      color: rgba(255,255,255,0.68);
      font-family: var(--um-font-mono);
      font-style: normal;
      font-size: 0.6875rem;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .service-body {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: clamp(34px, 5vw, 64px);
      background: #0a0a0b;
    }

    .service-front {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      margin: 0 0 22px;
      color: #dc2626;
      font-family: var(--um-font-mono);
      font-size: 0.6875rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .service-front span {
      width: 36px;
      height: 3px;
      background: #dc2626;
    }

    .service-body h2 {
      font-size: clamp(2.4rem, 4.7vw, 4.4rem);
      line-height: 0.94;
    }

    .service-body h2 a {
      color: inherit;
      text-decoration: none;
    }

    .service-row:hover .service-body h2 {
      color: #ff3b3b;
    }

    .service-tagline {
      margin: 18px 0 0;
      color: #dc2626;
      font-size: clamp(1.1rem, 1.5vw, 1.35rem);
      font-weight: 700;
      line-height: 1.35;
    }

    .service-description {
      max-width: 44rem;
      margin: 20px 0 0;
      color: #a1a1aa;
      font-size: clamp(1rem, 1.25vw, 1.125rem);
      line-height: 1.65;
    }

    .service-body ul {
      list-style: none;
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px 22px;
      margin: 28px 0 0;
      padding: 0;
      color: #a1a1aa;
      line-height: 1.45;
    }

    .service-body li {
      display: flex;
      gap: 10px;
      align-items: flex-start;
    }

    .service-body li span {
      width: 7px;
      height: 7px;
      margin-top: 8px;
      flex: 0 0 auto;
      background: #dc2626;
      border-radius: 999px;
    }

    .service-footer {
      display: flex;
      flex-wrap: wrap;
      gap: 14px 24px;
      align-items: center;
      margin-top: 34px;
      padding-top: 24px;
      border-top: 1px solid rgba(255,255,255,0.08);
      color: rgba(255,255,255,0.62);
      font-size: 0.9375rem;
    }

    .service-footer span {
      margin-right: auto;
      color: #fff;
      font-family: var(--um-font-mono);
      text-transform: uppercase;
      letter-spacing: 0.12em;
      font-size: 0.75rem;
    }

    .service-footer strong {
      margin-right: 8px;
      font-family: var(--um-font-display);
      font-size: 1.5rem;
      letter-spacing: 0;
    }

    .service-footer a {
      color: #fff;
      text-decoration: none;
      font-weight: 700;
      border-bottom: 2px solid #dc2626;
      padding-bottom: 3px;
    }

    .service-footer a::after {
      content: ">";
      margin-left: 8px;
      color: #dc2626;
    }

    .services-closing {
      padding: 0 0 clamp(82px, 9vw, 132px);
      background: #0a0a0b;
    }

    .services-closing__panel {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 64px;
      align-items: center;
      padding: clamp(42px, 5vw, 72px);
      border: 1px solid rgba(255,255,255,0.1);
      background:
        radial-gradient(circle at 86% 12%, rgba(220,38,38,0.24), transparent 30%),
        linear-gradient(135deg, #0f0f11, #121214);
    }

    .services-closing h2 {
      max-width: 16ch;
      font-size: clamp(2.5rem, 4.4vw, 4.8rem);
      line-height: 0.94;
    }

    .services-closing p:not(.um26-kicker) {
      max-width: 48rem;
      margin: 22px 0 0;
      color: #a1a1aa;
      line-height: 1.65;
    }

    .services-closing__actions {
      display: grid;
      min-width: min(100%, 360px);
      margin: 0;
    }

    @media (max-width: 1100px) {
      .services-hero__note {
        display: none;
      }

      .services-intro__grid,
      .services-closing__panel {
        grid-template-columns: 1fr;
      }

      .service-row {
        grid-template-columns: 1fr;
      }

      .service-row--reverse .service-image {
        order: 0;
      }
    }

    @media (max-width: 760px) {
      .services-shell {
        width: min(100% - 28px, 1400px);
      }

      .services-hero {
        min-height: 88vh;
      }

      .services-hero__body {
        padding-bottom: 54px;
      }

      .services-hero h1 {
        font-size: clamp(3rem, 15vw, 4.25rem);
      }

      .services-proofline {
        grid-template-columns: 1fr;
        margin-top: 34px;
      }

      .services-proofline div {
        border-left: 0;
        border-top: 1px solid rgba(255,255,255,0.08);
      }

      .services-proofline div:first-child {
