---
/**
 * Servicios Index - V4 Design System
 * Services listing page with filtering and V4 components
 */

import LayoutV4 from '../../layouts/LayoutV4.astro';
import HeroPageV4 from '../../components/v4/HeroPageV4.astro';
import { generateSlug } from '../../utils/slugUtils.js';
import { serviciosCompletos } from '../../data/servicios_completos_v4.js';

// Convertir objeto a array para iteración
const serviciosReales = Object.values(serviciosCompletos);

// Configuración de paginación
const PAGE_SIZE = 12;
const currentPage = parseInt(Astro.url.searchParams.get('page') || '1');
const searchQuery = Astro.url.searchParams.get('search') || '';
const areaFilter = Astro.url.searchParams.get('area') || '';
const clienteFilter = Astro.url.searchParams.get('cliente') || '';

// Filtrar servicios
let serviciosFiltrados = serviciosReales;

if (searchQuery) {
  serviciosFiltrados = serviciosFiltrados.filter(servicio =>
    servicio.Titulo.toLowerCase().includes(searchQuery.toLowerCase()) ||
    servicio.Descripcion.toLowerCase().includes(searchQuery.toLowerCase())
  );
}

if (areaFilter) {
  serviciosFiltrados = serviciosFiltrados.filter(servicio =>
    servicio.Area === areaFilter
  );
}

if (clienteFilter) {
  serviciosFiltrados = serviciosFiltrados.filter(servicio =>
    servicio.Cliente === clienteFilter
  );
}

// Paginación
const totalServicios = serviciosFiltrados.length;
const totalPages = Math.ceil(totalServicios / PAGE_SIZE);
const startIndex = (currentPage - 1) * PAGE_SIZE;
const endIndex = startIndex + PAGE_SIZE;
const serviciosPaginados = serviciosFiltrados.slice(startIndex, endIndex);

// Generar opciones de filtros dinámicamente
const areasUnicas = [...new Set(serviciosReales.map(s => s.Area))].sort();
const clientesUnicos = [...new Set(serviciosReales.map(s => s.Cliente))].sort();

// Imágenes ya tienen URL completa en serviciosCompletos
const getAssetUrl = (url) => url || '/images/default-service.jpg';

// Compute pagination pages
const computePaginationPages = () => {
  const total = totalPages;
  const current = currentPage;
  const maxPages = 5;

  if (total <= maxPages) {
    return Array.from({ length: total }, (_, i) => i + 1);
  }

  if (current <= 3) {
    return [1, 2, 3, 4, 5];
  }

  if (current >= total - 2) {
    return [total - 4, total - 3, total - 2, total - 1, total];
  }

  return [current - 2, current - 1, current, current + 1, current + 2];
};

const paginationPages = computePaginationPages();

// Helper to build pagination URL
const buildPageUrl = (page: number) => {
  let url = `/servicios?page=${page}`;
  if (searchQuery) url += `&search=${searchQuery}`;
  if (areaFilter) url += `&area=${areaFilter}`;
  if (clienteFilter) url += `&cliente=${clienteFilter}`;
  return url;
};
---

<LayoutV4
  title="Servicios | ULTIMA MILLA - Soluciones Tecnológicas Integrales"
  description="Catálogo completo de servicios tecnológicos: telecomunicaciones, cableado estructurado, seguridad electrónica, desarrollo de software, detección de incendio y más. +469 proyectos exitosos en Mendoza, Cuyo y Patagonia."
  keywords="servicios tecnologicos mendoza, telecomunicaciones profesionales, cableado estructurado certificado, seguridad electronica cctv, desarrollo software a medida, deteccion incendio sistemas"
>
  <HeroPageV4
    title="Excelencia en"
    titleHighlight="Servicios Tecnológicos"
    subtitle="Soluciones integrales de infraestructura IT, telecomunicaciones, seguridad electrónica y desarrollo de software para empresas de Argentina."
    breadcrumb={[
      { label: 'Inicio', href: '/' },
      { label: 'Servicios', href: '/servicios' },
    ]}
    badge={{ icon: 'briefcase', text: 'Soluciones Integrales' }}
    backgroundImage="https://www.ultimamilla.com.ar/directus-assets/b104c9b7-708f-4cc7-ab7f-5f8443a2475e"
    stats={[
      { value: `${serviciosReales.length}+`, label: 'Servicios' },
      { value: String(areasUnicas.length), label: 'Áreas' },
      { value: `${clientesUnicos.length}+`, label: 'Sectores' },
    ]}
  />

  <!-- Filtros y Búsqueda -->
  <section class="sticky top-16 sm:top-20 z-30 bg-white border-b border-gray-200 shadow-sm">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3 sm:py-4">
      <form method="GET" class="flex flex-col md:flex-row gap-3 sm:gap-4 items-center justify-between">
        <!-- Búsqueda -->
        <div class="relative w-full md:w-96">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="h-5 w-5 text-um-gray" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="text"
            name="search"
            value={searchQuery}
            placeholder="Buscar servicios..."
            class="block w-full pl-10 pr-3 py-2.5 border border-gray-300 rounded-lg leading-5 bg-white placeholder-um-gray focus:outline-none focus:ring-2 focus:ring-um-primary focus:border-um-primary text-sm min-h-[44px]"
          />
        </div>

        <div class="flex flex-wrap gap-2 sm:gap-3 w-full md:w-auto">
          <select
            name="area"
            class="bg-white border border-gray-300 text-um-dark py-2.5 px-4 pr-8 rounded-lg focus:outline-none focus:ring-2 focus:ring-um-primary focus:border-um-primary text-sm min-h-[44px] flex-1 md:flex-none"
          >
            <option value="">Todas las áreas</option>
            {areasUnicas.map(area => (
              <option value={area} selected={areaFilter === area}>{area}</option>
            ))}
          </select>

          <select
            name="cliente"
            class="bg-white border border-gray-300 text-um-dark py-2.5 px-4 pr-8 rounded-lg focus:outline-none focus:ring-2 focus:ring-um-primary focus:border-um-primary text-sm min-h-[44px] flex-1 md:flex-none"
          >
            <option value="">Todos los sectores</option>
            {clientesUnicos.map(cliente => (
              <option value={cliente} selected={clienteFilter === cliente}>{cliente}</option>
            ))}
          </select>

          <button
            type="submit"
            class="px-5 sm:px-6 py-2.5 bg-um-primary text-white font-semibold rounded-lg hover:bg-um-primary-dark transition-colors text-sm min-h-[44px]"
          >
            Filtrar
          </button>
        </div>
      </form>
    </div>
  </section>

  <!-- Grid de Servicios -->
  <section class="py-10 sm:py-14 lg:py-20 bg-um-gray-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {serviciosPaginados.length === 0 ? (
        <div class="text-center py-16 sm:py-20">
          <svg class="w-16 h-16 text-um-gray mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <h3 class="text-xl font-bold text-um-dark mb-2">No se encontraron resultados</h3>
          <p class="text-um-gray">Intenta ajustar tus filtros de búsqueda.</p>
          <a href="/servicios" class="inline-block mt-6 px-6 py-3 bg-um-primary text-white font-semibold rounded-lg hover:bg-um-primary-dark transition-colors">
            Ver todos los servicios
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
          {serviciosPaginados.map((servicio) => {
            const slug = generateSlug(servicio.Titulo);
            return (
              <a href={`/servicios/${servicio.id}/${slug}`} class="group flex flex-col h-full">
                <article class="flex flex-col h-full bg-white rounded-xl overflow-hidden shadow-sm border border-gray-100 card-hover">
                  <!-- Image -->
                  <div class="relative aspect-[16/9] overflow-hidden bg-gray-100">
                    <img
                      src={getAssetUrl(servicio.Imagen)}
                      alt={servicio.Titulo}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                      loading="lazy"
                      onerror="this.src='/images/default-service.jpg'"
                    />
                    <div class="absolute top-3 sm:top-4 left-3 sm:left-4">
                      <span class="inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-semibold bg-um-dark text-white shadow-sm">
                        {servicio.Area}
                      </span>
                    </div>
                  </div>

                  <!-- Content -->
                  <div class="flex flex-col flex-grow p-4 sm:p-6">
                    <h3 class="text-lg sm:text-xl font-bold text-um-dark mb-2 sm:mb-3 group-hover:text-um-primary transition-colors line-clamp-2">
                      {servicio.Titulo}
                    </h3>

                    <p class="text-um-gray text-sm mb-4 sm:mb-6 line-clamp-3 flex-grow leading-relaxed">
                      {servicio.Descripcion.replace(/\\\\/g, ' ')}
                    </p>

                    <div class="pt-3 sm:pt-4 border-t border-gray-100 mt-auto flex items-center justify-between">
                      <span class="text-xs font-medium text-um-gray uppercase tracking-wide">
                        {servicio.Cliente}
                      </span>
                      <span class="text-um-primary text-sm font-semibold flex items-center gap-1 group-hover:gap-2 transition-all">
                        Ver detalles
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                        </svg>
                      </span>
                    </div>
                  </div>
                </article>
              </a>
            );
          })}
        </div>
      )}

      <!-- Pagination -->
      {totalPages > 1 && (
        <div class="mt-10 sm:mt-12 flex justify-center">
          <nav class="flex items-center gap-1 sm:gap-2" aria-label="Paginación">
            {currentPage > 1 && (
              <a
                href={buildPageUrl(currentPage - 1)}
                class="px-3 sm:px-4 py-2 border border-gray-300 rounded-lg text-um-dark hover:bg-um-primary hover:text-white hover:border-um-primary transition-colors min-h-[44px] flex items-center"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
              </a>
            )}

            {paginationPages.map((pageNum) => (
              <a
                href={buildPageUrl(pageNum)}
                class={`px-3 sm:px-4 py-2 border rounded-lg font-medium transition-colors min-h-[44px] flex items-center justify-center min-w-[44px] ${
                  currentPage === pageNum
                    ? 'bg-um-primary text-white border-um-primary'
                    : 'border-gray-300 text-um-dark hover:bg-um-primary hover:text-white hover:border-um-primary'
                }`}
              >
                {pageNum}
              </a>
            ))}

            {currentPage < totalPages && (
              <a
                href={buildPageUrl(currentPage + 1)}
                class="px-3 sm:px-4 py-2 border border-gray-300 rounded-lg text-um-dark hover:bg-um-primary hover:text-white hover:border-um-primary transition-colors min-h-[44px] flex items-center"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            )}
          </nav>
        </div>
      )}
    </div>
  </section>

  <!-- CTA Section -->
  <section class="bg-um-dark py-10 sm:py-14 lg:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-3 sm:mb-4">¿Necesita un Servicio Personalizado?</h2>
      <p class="text-base sm:text-lg lg:text-xl text-gray-300 mb-6 sm:mb-8">
        Contáctenos para diseñar una solución a medida para su empresa
      </p>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
        <a
          href="/contacto"
          class="px-6 sm:px-8 py-3 sm:py-4 bg-um-accent text-white font-bold rounded-xl hover:bg-um-accent-dark transition-colors shadow-lg shadow-um-accent/25 min-h-[44px] flex items-center justify-center"
        >
          Solicitar Cotización
        </a>
        <a
          href="/antecedentes"
          class="px-6 sm:px-8 py-3 sm:py-4 border-2 border-white text-white font-bold rounded-xl hover:bg-white/10 transition-colors min-h-[44px] flex items-center justify-center"
        >
          Ver Casos de Éxito
        </a>
      </div>
    </div>
  </section>
</LayoutV4>
