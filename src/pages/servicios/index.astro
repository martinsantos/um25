---
import Layout from '../../layouts/Layout.astro';
import { generateSlug } from '../../utils/slugUtils.js';
import { serviciosReales } from '../../data/servicios_reales_db.js';
import { getServiceImageUrl } from '../../utils/imageUtils.js';

// Configuración de paginación
const PAGE_SIZE = 12;
const currentPage = parseInt(Astro.url.searchParams.get('page') || '1');
const searchQuery = Astro.url.searchParams.get('search') || '';
const areaFilter = Astro.url.searchParams.get('area') || '';
const clienteFilter = Astro.url.searchParams.get('cliente') || '';

// Filtrar servicios
let serviciosFiltrados = serviciosReales;

if (searchQuery) {
  serviciosFiltrados = serviciosFiltrados.filter(servicio => 
    servicio.Titulo.toLowerCase().includes(searchQuery.toLowerCase()) ||
    servicio.Descripcion.toLowerCase().includes(searchQuery.toLowerCase())
  );
}

if (areaFilter) {
  serviciosFiltrados = serviciosFiltrados.filter(servicio => 
    servicio.Area === areaFilter
  );
}

if (clienteFilter) {
  serviciosFiltrados = serviciosFiltrados.filter(servicio => 
    servicio.Cliente === clienteFilter
  );
}

// Paginación
const totalServicios = serviciosFiltrados.length;
const totalPages = Math.ceil(totalServicios / PAGE_SIZE);
const startIndex = (currentPage - 1) * PAGE_SIZE;
const endIndex = startIndex + PAGE_SIZE;
const serviciosPaginados = serviciosFiltrados.slice(startIndex, endIndex);

// Generar opciones de filtros dinámicamente
const areasUnicas = [...new Set(serviciosReales.map(s => s.Area))].sort();
const clientesUnicos = [...new Set(serviciosReales.map(s => s.Cliente))].sort();

// Usar la función utilitaria compartida para manejar imágenes
const getAssetUrl = getServiceImageUrl;
---

<Layout title="Servicios - Ultima Milla">
  <main class="min-h-screen bg-slate-50">
    <!-- Hero Section Premium (Executive Style) -->
    <section class="relative bg-slate-900 text-white overflow-hidden">
      <div class="absolute inset-0">
        <div class="absolute inset-0 bg-slate-900 z-10"></div>
        <img 
          src="/images/hero-bg.jpg" 
          alt="Background" 
          class="w-full h-full object-cover opacity-10"
          onerror="this.style.display='none'"
        />
        <!-- Subtle gradient overlay, no blur -->
        <div class="absolute inset-0 bg-gradient-to-b from-slate-900/50 to-slate-900 z-10"></div>
      </div>

      <div class="relative z-20 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32">
        <div class="max-w-4xl">
          <span class="inline-block py-1 px-3 rounded bg-blue-900 text-blue-100 text-sm font-bold mb-6 tracking-wide uppercase">
            Soluciones Integrales
          </span>
          <h1 class="text-5xl md:text-7xl font-bold mb-8 tracking-tight leading-tight text-white">
            Excelencia en <br/>Servicios Tecnológicos
          </h1>
          <p class="text-xl md:text-2xl text-slate-300 max-w-2xl leading-relaxed mb-12 font-light">
            Impulsamos el crecimiento de su organización con infraestructura de vanguardia y soluciones a medida.
          </p>

          <!-- Stats (Solid, Executive) -->
          <div class="grid grid-cols-1 md:grid-cols-3 gap-8 border-t border-slate-800 pt-8">
            <div class="flex flex-col">
              <div class="text-4xl font-bold text-white mb-1">{serviciosReales.length}+</div>
              <div class="text-slate-400 text-sm uppercase tracking-wider">Servicios Especializados</div>
            </div>
            <div class="flex flex-col">
              <div class="text-4xl font-bold text-white mb-1">{areasUnicas.length}</div>
              <div class="text-slate-400 text-sm uppercase tracking-wider">Áreas de Expertise</div>
            </div>
            <div class="flex flex-col">
              <div class="text-4xl font-bold text-white mb-1">{clientesUnicos.length}+</div>
              <div class="text-slate-400 text-sm uppercase tracking-wider">Sectores Atendidos</div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Filtros y Búsqueda -->
    <section class="sticky top-0 z-30 bg-white/80 backdrop-blur-lg border-b border-slate-200 shadow-sm transition-all duration-300" id="filter-bar">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
        <form method="GET" class="flex flex-col md:flex-row gap-4 items-center justify-between">
          <!-- Búsqueda -->
          <div class="relative w-full md:w-96 group">
            <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
              <svg class="h-5 w-5 text-slate-400 group-focus-within:text-blue-500 transition-colors" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <input
              type="text"
              name="search"
              value={searchQuery}
              placeholder="Buscar servicios..."
              class="block w-full pl-10 pr-3 py-2.5 border border-slate-200 rounded-xl leading-5 bg-slate-50 placeholder-slate-400 focus:outline-none focus:bg-white focus:ring-2 focus:ring-blue-500/20 focus:border-blue-500 transition-all duration-200 sm:text-sm"
            />
          </div>
          
          <div class="flex flex-wrap gap-3 w-full md:w-auto">
            <!-- Filtro por Área -->
            <div class="relative flex-grow md:flex-grow-0">
              <select name="area" class="appearance-none w-full bg-slate-50 border border-slate-200 text-slate-700 py-2.5 px-4 pr-8 rounded-xl leading-tight focus:outline-none focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 cursor-pointer transition-all">
                <option value="">Todas las áreas</option>
                {areasUnicas.map(area => (
                  <option value={area} selected={areaFilter === area}>{area}</option>
                ))}
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-slate-500">
                <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/></svg>
              </div>
            </div>
            
            <!-- Filtro por Cliente -->
            <div class="relative flex-grow md:flex-grow-0">
              <select name="cliente" class="appearance-none w-full bg-slate-50 border border-slate-200 text-slate-700 py-2.5 px-4 pr-8 rounded-xl leading-tight focus:outline-none focus:bg-white focus:border-blue-500 focus:ring-2 focus:ring-blue-500/20 cursor-pointer transition-all">
                <option value="">Todos los clientes</option>
                {clientesUnicos.map(cliente => (
                  <option value={cliente} selected={clienteFilter === cliente}>{cliente}</option>
                ))}
              </select>
              <div class="pointer-events-none absolute inset-y-0 right-0 flex items-center px-2 text-slate-500">
                <svg class="fill-current h-4 w-4" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20"><path d="M9.293 12.95l.707.707L15.657 8l-1.414-1.414L10 10.828 5.757 6.586 4.343 8z"/></svg>
              </div>
            </div>
            
            <button type="submit" class="px-6 py-2.5 bg-blue-600 text-white font-medium rounded-xl hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-all shadow-lg shadow-blue-500/30">
              Aplicar Filtros
            </button>
          </div>
        </form>
      </div>
    </section>

    <!-- Grid de Servicios -->
    <section class="py-16 md:py-24 bg-slate-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {serviciosPaginados.length === 0 ? (
          <div class="text-center py-20 bg-white rounded-3xl shadow-sm border border-slate-100">
            <div class="inline-flex items-center justify-center w-20 h-20 rounded-full bg-slate-100 mb-6">
              <svg class="w-10 h-10 text-slate-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-slate-900 mb-2">No se encontraron servicios</h3>
            <p class="text-slate-500 max-w-md mx-auto">Intenta ajustar los términos de búsqueda o los filtros para encontrar lo que necesitas.</p>
            <a href="/servicios" class="inline-block mt-6 text-blue-600 font-medium hover:text-blue-700">Limpiar filtros &rarr;</a>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 md:gap-10">
            {serviciosFiltrados.map((servicio) => {
              const slug = generateSlug(servicio.Titulo);
              return (
                <a href={`/servicios/${servicio.id}/${slug}`} class="group flex flex-col h-full">
                  <article class="flex flex-col h-full bg-white rounded-2xl overflow-hidden shadow-sm hover:shadow-2xl hover:shadow-blue-900/10 transition-all duration-500 transform hover:-translate-y-2 border border-slate-100">
                    <!-- Image Container -->
                    <div class="relative aspect-[4/3] overflow-hidden">
                      <div class="absolute inset-0 bg-slate-200 animate-pulse"></div>
                      <img
                        src={getAssetUrl(servicio.Imagen)}
                        alt={servicio.Titulo}
                        class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                        loading="lazy"
                        onerror="this.src='/images/default-service.jpg'"
                      />
                      <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent opacity-60 group-hover:opacity-40 transition-opacity duration-500"></div>
                      
                      <!-- Floating Badge -->
                      <div class="absolute top-4 left-4">
                        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-bold bg-white/90 text-blue-700 backdrop-blur-md shadow-lg">
                          {servicio.Area}
                        </span>
                      </div>
                    </div>
                    
                    <!-- Content -->
                    <div class="flex flex-col flex-grow p-6 md:p-8">
                      <div class="mb-4">
                        <h3 class="text-2xl font-bold text-slate-900 mb-3 group-hover:text-blue-600 transition-colors leading-tight">
                          {servicio.Titulo}
                        </h3>
                        <div class="w-12 h-1 bg-blue-500 rounded-full group-hover:w-20 transition-all duration-300"></div>
                      </div>
                      
                      <p class="text-slate-600 mb-6 line-clamp-3 leading-relaxed flex-grow">
                        {servicio.Descripcion.replace(/\\\\/g, ' ')}
                      </p>
                      
                      <div class="pt-6 border-t border-slate-100 mt-auto">
                        <div class="flex items-center justify-between">
                          <div class="flex items-center space-x-2 text-sm text-slate-500">
                            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-4m-5 0H3m2 0h4M9 7h6m-6 4h6m-6 4h6" />
                            </svg>
                            <span class="font-medium truncate max-w-[150px]">{servicio.Cliente}</span>
                          </div>
                          <span class="inline-flex items-center text-blue-600 font-semibold text-sm group-hover:translate-x-1 transition-transform duration-300">
                            Ver detalles
                            <svg class="w-4 h-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                            </svg>
                          </span>
                        </div>
                      </div>
                    </div>
                  </article>
                </a>
              );
            })}
          </div>
        )}
      </div>
    </section>
  </main>
</Layout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>