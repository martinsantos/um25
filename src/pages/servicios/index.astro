---
import LayoutV4 from '../../layouts/LayoutV4.astro';
import TrustStrip from '../../components/um/TrustStrip.astro';
import IntentLinkGraph from '../../components/um/IntentLinkGraph.astro';
import { generateSlug } from '../../utils/slugUtils.js';
import { getAllServicios } from '../../utils/directusHelpers';
import { getServiceVisualSpec, serviceVisualOrder } from '../../data/serviceVisualSystem';
import { editorialImageDimensions, editorialImages } from '../../data/editorialImageSystem';
import { resolveReplicaH1 } from '../../utils/replicaProdCopy';
import { getAntecedentesCountExactPhrase } from '../../utils/verifiedProof';
import {
  buildServiceStrategicLinkGroups,
  buildStrategicWebPageStructuredData,
} from '../../data/strategicLinkGraph';

const serviciosIndexH1 = resolveReplicaH1('/servicios', 'Servicios IT para continuidad operativa');

const serviciosFromDirectus = await getAllServicios();
const byId = new Map(serviciosFromDirectus.map((servicio) => [Number(servicio.id), servicio]));

const servicios = serviceVisualOrder
  .map((id) => {
    const directus = byId.get(id);
    const visual = getServiceVisualSpec(id);
    if (!directus || !visual) return undefined;
    return {
      id,
      title: directus.Titulo,
      slug: directus.slug || generateSlug(directus.Titulo),
      href: `/servicios/${id}/${directus.slug || generateSlug(directus.Titulo)}`,
      description: String(directus.Descripcion || '').replace(/\\\\/g, ' ').replace(/\s+/g, ' ').trim(),
      visual
    };
  })
  .filter(Boolean);
const servicesIndexImage = servicios[0]?.visual.image || editorialImages.homeServices;
const seguridadElectronica = servicios.find((servicio) => Number(servicio.id) === 102);
const cctvAiProduct = {
  title: 'UMSA CCTV AI',
  eyebrow: 'Producto',
  description:
    'Producto UMSA para convertir cámaras existentes en alertas útiles, clips, dashboard e informes forenses verificables.',
  proof: 'Piloto de 30 días sobre 6 cámaras críticas, con dashboard e informe forense.',
  image: '/images/services/productos/cctv-ai/cctv-ai-forense-telefono.webp',
  href: '/cctvai/',
  serviceHref:
    seguridadElectronica?.href ||
    '/servicios/102/sistemas-de-seguridad-electronica-cctv-control-acceso-sistemas-de-deteccion-de-incendios-sdi',
};
const servicesStrategicLinkGroups = buildServiceStrategicLinkGroups({
  currentPath: '/servicios',
  title: serviciosIndexH1,
  summary: 'Servicios IT integrales para empresas: redes, seguridad, telecomunicaciones, software, soporte, consultoría, detección y energía IT.',
  text: [
    servicios.map((servicio) => `${servicio.title} ${servicio.description} ${servicio.visual.shortName} ${servicio.visual.proof}`).join(' '),
    `${cctvAiProduct.title} ${cctvAiProduct.description}`,
  ].join(' '),
});

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'CollectionPage',
    name: 'Servicios IT integrales ULTIMA MILLA',
    description: 'Servicios IT integrales: redes, telecomunicaciones, seguridad electrónica, software, soporte, consultoría, detección de incendios y eléctricos para IT.',
    url: 'https://www.ultimamilla.com.ar/servicios'
  },
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    itemListElement: servicios.map((servicio, index) => ({
      '@type': 'ListItem',
      position: index + 1,
      name: servicio.title,
      url: `https://www.ultimamilla.com.ar${servicio.href}`
    }))
  },
  {
    '@context': 'https://schema.org',
    '@type': 'Service',
    name: 'UMSA CCTV AI',
    alternateName: 'Inteligencia artificial para cámaras de seguridad',
    description: cctvAiProduct.description,
    url: `https://www.ultimamilla.com.ar${cctvAiProduct.href}`,
    serviceType: 'CCTV AI, videovigilancia inteligente, analítica de video, seguridad electrónica',
    provider: {
      '@type': 'Organization',
      name: 'ULTIMA MILLA',
      url: 'https://www.ultimamilla.com.ar',
    },
    areaServed: [
      { '@type': 'City', name: 'Mendoza' },
      { '@type': 'AdministrativeArea', name: 'Cuyo' },
      { '@type': 'AdministrativeArea', name: 'Patagonia' },
    ],
    offers: {
      '@type': 'Offer',
      availability: 'https://schema.org/InStock',
      category: 'Producto',
      name: 'Piloto UMSA CCTV AI',
      description: cctvAiProduct.proof,
    },
  },
  buildStrategicWebPageStructuredData({
    url: 'https://www.ultimamilla.com.ar/servicios',
    name: serviciosIndexH1,
    description: 'Servicios IT integrales para empresas: redes, seguridad, telecomunicaciones, software, soporte, consultoría, detección y energía IT.',
    groups: servicesStrategicLinkGroups,
  })
];

const serviceIconPaths: Record<string, string> = {
  network: '<path d="M6 9v6"/><path d="M18 9v6"/><path d="M10 12h4"/><rect x="3" y="4" width="6" height="5" rx="1.5"/><rect x="15" y="4" width="6" height="5" rx="1.5"/><rect x="3" y="15" width="6" height="5" rx="1.5"/><rect x="15" y="15" width="6" height="5" rx="1.5"/><path d="M9 6.5h6"/><path d="M9 17.5h6"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
  radio: '<circle cx="12" cy="12" r="2"/><path d="M16.24 7.76a6 6 0 0 1 0 8.49"/><path d="M7.76 16.24a6 6 0 0 1 0-8.49"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M4.93 19.07a10 10 0 0 1 0-14.14"/>',
  code: '<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/><path d="m14 4-4 16"/>',
  headset: '<path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z"/><path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/><path d="M12 21v-2"/>',
  briefcase: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><path d="M2 12h20"/><path d="M12 12v2"/>',
  flame: '<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>',
  bolt: '<path d="M13 2 4 14h7l-1 8 10-13h-7l0-7z"/>'
};
---

<LayoutV4
  title="Servicios IT integrales para continuidad operativa | ULTIMA MILLA"
  description="Servicios IT integrales para empresas: redes, seguridad electrónica, telecomunicaciones, software, soporte 24/7, consultoría, detección de incendios y eléctricos para IT."
  keywords="servicios IT integrales, redes empresariales, seguridad electronica, telecomunicaciones, software a medida, soporte IT 24/7, consultoria IT, deteccion de incendios, electricos para IT"
  image={servicesIndexImage}
  imageWidth={editorialImageDimensions.width}
  imageHeight={editorialImageDimensions.height}
  structuredData={structuredData}
>
  <section class="services-hero">
    <div class="um-container services-hero__grid">
      <div>
        <nav class="services-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Inicio</a>
          <span>/</span>
          <span>Servicios</span>
        </nav>
        <h1>{serviciosIndexH1}</h1>
        <p>
          Infraestructura tecnológica para empresas que necesitan redes estables,
          seguridad, software operativo y soporte real en terreno.
        </p>
        <div class="services-actions services-actions--intents">
          <a href="/contacto" class="um-btn-primary">Solicitar diagnóstico</a>
          <a href="/contacto" class="um-btn-secondary services-secondary-dark">Solicitar relevamiento</a>
          <a href="/antecedentes" class="um-btn-secondary services-secondary-dark">Ver antecedentes</a>
        </div>
        <dl class="services-hero__proofline" aria-label="Prueba institucional">
          <div>
            <dt>Servicios</dt>
            <dd>8 frentes integrados</dd>
          </div>
          <div>
            <dt>Archivo</dt>
            <dd>{getAntecedentesCountExactPhrase()}</dd>
          </div>
          <div>
            <dt>Operación</dt>
            <dd>22+ años / 24-7</dd>
          </div>
        </dl>
      </div>

      <aside class="services-hero__visual" aria-label="Prueba operativa">
        <div class="services-hero__image">
          <img src={servicesIndexImage} alt="Infraestructura IT operada por ULTIMA MILLA" loading="eager" fetchpriority="high" decoding="async" width={editorialImageDimensions.width} height={editorialImageDimensions.height} />
        </div>
        <div class="services-proof-note">
          <strong>Diagnóstico, implementación y soporte dentro de una misma cadena operativa.</strong>
          <p>Acá importa ver cómo se sostiene el servicio en terreno, no repetir indicadores.</p>
        </div>
      </aside>
    </div>
  </section>

  <section class="um-section services-index">
    <div class="um-container">
      <div class="services-dossier-head">
        <div>
          <span class="services-rule" aria-hidden="true"></span>
          <h2>Una arquitectura de servicio, no proveedores aislados.</h2>
        </div>
        <p>
          Ocho frentes técnicos conectados por diagnóstico, ingeniería, implementación,
          evidencia técnica y soporte. El diseño debe poder leerse en minutos y auditarse después.
        </p>
      </div>

      <div class="services-dossier">
        <aside class="services-dossier__folio" aria-label="Criterio operativo de servicios">
          <div class="services-dossier__image">
            <img
              src={servicios[1]?.visual.image || servicios[0]?.visual.image}
              alt={servicios[1]?.visual.imageAlt || 'Infraestructura IT operativa de ULTIMA MILLA'}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="services-dossier__note">
            <span>criterio de diseño</span>
            <h3>Continuidad operativa primero.</h3>
            <p>
              Se priorizan alcance, riesgo, integración y soporte posterior. Cada servicio debe
              poder vincularse a un antecedente, un responsable y una evidencia técnica.
            </p>
          </div>
        </aside>

        <div class="services-dossier__list" aria-label="Frentes de servicios IT">
          {servicios.map((servicio, index) => (
            <a
              href={servicio.href}
              class="um-click-surface service-dossier-item"
              style={`--service-accent:${servicio.visual.accent};`}
            >
              <span class="service-dossier-item__num">{String(index + 1).padStart(2, '0')}</span>
              <span class="service-dossier-item__icon" aria-hidden="true">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" set:html={serviceIconPaths[servicio.visual.icon] || serviceIconPaths.network} />
              </span>
              <span class="service-dossier-item__body">
                <span>{servicio.visual.eyebrow}</span>
                <strong>{servicio.visual.shortName}</strong>
                <em>{servicio.visual.proof}</em>
              </span>
              <span class="service-dossier-item__signal">{servicio.visual.signal}</span>
            </a>
          ))}
        </div>
      </div>

      <section class="services-products-band" aria-labelledby="services-products-title">
        <div class="services-product-feature">
          <div class="services-product-feature__media" aria-hidden="true">
            <img
              src={cctvAiProduct.image}
              alt=""
              loading="lazy"
              decoding="async"
              width="1200"
              height="800"
            />
          </div>

          <div class="services-product-feature__copy">
            <p class="services-product-feature__eyebrow">{cctvAiProduct.eyebrow}</p>
            <h2 id="services-products-title">{cctvAiProduct.title}</h2>
            <p>{cctvAiProduct.description}</p>

            <dl class="services-product-feature__proof" aria-label="Alcance inicial de CCTV AI">
              <div>
                <dt>Modo</dt>
                <dd>Producto UMSA</dd>
              </div>
              <div>
                <dt>Piloto</dt>
                <dd>30 días / 6 cámaras</dd>
              </div>
              <div>
                <dt>Entrega</dt>
                <dd>Dashboard + forense</dd>
              </div>
            </dl>

            <div class="services-product-feature__actions">
              <a href={cctvAiProduct.href} class="um-btn-primary">Ver producto</a>
              <a href="/contacto" class="um-btn-secondary services-product-feature__secondary">Solicitar diagnóstico</a>
            </div>
          </div>
        </div>
      </section>

      <div class="services-intent-ctas" id="decision" aria-label="Próximo paso por intención">
        <a href="/contacto" class="um-click-surface services-intent-card">
          <span>01</span>
          <strong>Solicitar diagnóstico</strong>
          <p>Relevamiento técnico, riesgos visibles y presupuesto base antes de comprometer alcance.</p>
        </a>
        <a href="/contacto" class="um-click-surface services-intent-card">
          <span>02</span>
          <strong>Cotizar abono</strong>
          <p>Soporte mensual con SLA, tickets, visitas preventivas y reporte ejecutivo.</p>
        </a>
        <a href="/contacto" class="um-click-surface services-intent-card">
          <span>03</span>
          <strong>Solicitar relevamiento</strong>
          <p>Obra puntual, sala técnica, red express o seguridad con entrega técnica verificable.</p>
        </a>
      </div>
    </div>
  </section>

  <IntentLinkGraph
    kicker="Para avanzar"
    title="Ver también"
    text="Relacioná los servicios con sectores, casos reales y contacto técnico para definir el alcance."
    groups={servicesStrategicLinkGroups}
  />

  <TrustStrip />

  <section class="services-final-cta">
    <div class="um-container">
      <h2>¿Qué parte de su operación necesita estabilizar primero?</h2>
      <p>Podemos empezar por un diagnóstico puntual y escalar hacia un sistema completo.</p>
      <div>
        <a href="/contacto" class="um-btn-primary">Hablar con ULTIMA MILLA</a>
        <a href="/sectores" class="um-btn-secondary">Ver sectores</a>
      </div>
    </div>
  </section>
</LayoutV4>

<style>
  .services-hero {
    background: #080808;
    color: #fff;
    padding: clamp(24px, 3.4vw, 42px) 0 clamp(28px, 3.8vw, 48px);
  }

  .services-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.64fr) minmax(320px, 0.36fr);
    gap: clamp(34px, 6vw, 72px);
    align-items: start;
  }

  .services-hero__grid > * {
    min-width: 0;
  }

  .services-breadcrumb {
    display: flex;
    gap: 0.55rem;
    margin-bottom: clamp(16px, 2.2vw, 26px);
    color: rgba(255,255,255,0.58);
    font-size: 1rem;
    font-weight: 700;
  }

  .services-breadcrumb a:hover {
    color: #fff;
  }

  .services-hero h1 {
    max-width: 760px;
    font-size: clamp(2rem, 2.5vw, 2.64rem);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: 0;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .services-hero p {
    max-width: 680px;
    margin-top: 1rem;
    color: rgba(255,255,255,0.72);
    font-size: clamp(1rem, 1.08vw, 1.12rem);
    line-height: 1.68;
    overflow-wrap: anywhere;
  }

  .services-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 1.35rem;
  }

  .services-hero__proofline {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    max-width: 760px;
    margin: clamp(16px, 2vw, 22px) 0 0;
    border: 0;
  }

  .services-hero__proofline div {
    min-width: 0;
    padding: 12px 16px 12px 0;
    border-right: 0;
  }

  .services-hero__proofline div + div {
    padding-left: 16px;
  }

  .services-hero__proofline div:last-child {
    border-right: 0;
  }

  .services-hero__proofline dt {
    color: var(--skin-hero-muted);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .services-hero__proofline dd {
    margin: 7px 0 0;
    color: var(--skin-hero-text);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .services-secondary-dark {
    color: #fff;
    border-color: rgba(255,255,255,0.44);
  }

  .services-secondary-dark:hover {
    background: #fff;
    color: #080808;
    border-color: #fff;
  }

  .services-hero__visual {
    min-width: 0;
    border: 1px solid rgba(255, 255, 255, 0.12);
    background: rgba(255, 255, 255, 0.06);
  }

  .services-hero__image {
    height: clamp(180px, 16vw, 230px);
    overflow: hidden;
    background: #111;
  }

  .services-hero__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.1) contrast(1.06) saturate(0.9);
  }

  .services-proof-note {
    padding: 1rem 1rem 1.08rem;
    border-top: 0;
  }

  .services-proof-note strong {
    display: block;
    color: var(--skin-text, #fff);
    font-family: var(--um-font-display);
    font-size: clamp(1.08rem, 1.38vw, 1.24rem);
    font-weight: 600;
    line-height: 1.28;
  }

  .services-proof-note p {
    margin: 0.5rem 0 0;
    color: var(--skin-muted, rgba(255,255,255,0.64));
    font-size: 1rem;
    line-height: 1.58;
  }

  :global(body[data-skin="white"] main .services-proof-note),
  :global(body[data-skin="steel"] main .services-proof-note) {
    border-top-color: transparent !important;
  }

  :global(body[data-skin="white"] main .services-hero .services-proof-note strong),
  :global(body[data-skin="steel"] main .services-hero .services-proof-note strong) {
    color: #fff !important;
  }

  :global(body[data-skin="white"] main .services-hero .services-proof-note p),
  :global(body[data-skin="steel"] main .services-hero .services-proof-note p) {
    color: rgba(255, 255, 255, 0.68) !important;
  }

  .services-index {
    background: #fff;
    padding-top: clamp(22px, 3vw, 38px);
    padding-bottom: clamp(46px, 5.8vw, 74px);
  }

  .services-dossier-head {
    display: grid;
    grid-template-columns: minmax(0, 0.54fr) minmax(300px, 0.46fr);
    gap: clamp(22px, 4vw, 48px);
    align-items: end;
    margin-bottom: clamp(18px, 2.8vw, 30px);
    border-top: 0;
    padding: clamp(20px, 2.6vw, 30px) 0 clamp(18px, 2.4vw, 26px);
  }

  .services-rule {
    display: block;
    width: 42px;
    height: 3px;
    margin-bottom: 14px;
    background: var(--um-red);
  }

  .services-dossier-head h2 {
    max-width: 660px;
    color: var(--skin-text);
    font-family: var(--um-font-display);
    font-size: clamp(1.85rem, 2.55vw, 2.82rem);
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .services-dossier-head p {
    margin: 0;
    color: var(--skin-muted);
    font-size: clamp(1rem, 1.08vw, 1.12rem);
    line-height: 1.58;
  }

  .services-dossier {
    display: grid;
    grid-template-columns: minmax(286px, 0.32fr) minmax(0, 0.68fr);
    gap: clamp(22px, 3.8vw, 44px);
    align-items: start;
  }

  .services-dossier__folio {
    position: sticky;
    top: 104px;
    border: 0;
    background: #fff;
  }

  .services-dossier__image {
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #111;
  }

  .services-dossier__image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.04);
  }

  .services-dossier__note {
    padding: clamp(18px, 2vw, 22px) 0 0;
  }

  .services-dossier__note span {
    display: block;
    color: var(--um-red);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .services-dossier__note h3 {
    margin-top: 12px;
    color: var(--skin-text);
    font-size: clamp(1.35rem, 1.85vw, 1.95rem);
    line-height: 1.12;
    font-weight: 600;
    text-wrap: balance;
  }

  .services-dossier__note p {
    margin-top: 12px;
    color: var(--skin-muted);
    font-size: 1rem;
    line-height: 1.58;
  }

  .services-dossier__list {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    border: 0;
    background: transparent;
    gap: 1px;
  }

  .service-dossier-item {
    display: grid;
    grid-template-columns: 34px 42px minmax(0, 1fr);
    grid-template-areas:
      "num icon body"
      ". . signal";
    gap: 0 14px;
    min-height: 166px;
    padding: clamp(18px, 2vw, 23px);
    border: 0;
    background: var(--skin-panel);
    color: var(--skin-text);
    transition: background-color 180ms ease;
  }

  .service-dossier-item:hover,
  .service-dossier-item:focus-visible {
    background: color-mix(in srgb, var(--skin-panel) 92%, var(--um-red) 8%);
  }

  .service-dossier-item__num {
    grid-area: num;
    color: var(--um-red);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .service-dossier-item__icon {
    grid-area: icon;
    display: grid;
    width: 34px;
    height: 34px;
    place-items: center;
    color: var(--service-accent, var(--um-red));
  }

  .service-dossier-item__icon svg {
    width: 28px;
    height: 28px;
  }

  .service-dossier-item__body {
    grid-area: body;
    min-width: 0;
  }

  .service-dossier-item__body > span {
    display: block;
    color: var(--skin-muted);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.3;
  }

  .service-dossier-item__body strong {
    display: block;
    margin-top: 7px;
    color: var(--skin-text);
    font-family: var(--um-font-display);
    font-size: clamp(1.12rem, 1.22vw, 1.28rem);
