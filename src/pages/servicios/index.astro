---
/**
 * Servicios Index - V4 Design System
 * Services listing page with filtering and V4 components
 */

import LayoutV4 from '../../layouts/LayoutV4.astro';
import HeroPageV4 from '../../components/v4/HeroPageV4.astro';
import ServiceCard from '../../components/v4/ServiceCard.astro';
import CTASection from '../../components/v4/CTASection.astro';
import { generateSlug } from '../../utils/slugUtils.js';
import { getAllServicios } from '../../utils/directusHelpers';
import { getDirectusImageUrl } from '../../lib/directus.ts';

import { serviceBadgeMap, serviceToSectorMap } from '../../data/serviceBadgeMap';
import { getSectorColors } from '../../data/colorSystem';

// Get services from Directus (with automatic fallback to JS data)
const serviciosFromDirectus = await getAllServicios();

// Icon mapping for ServiceCard
const iconMap: Record<number, { icon: string }> = {
  101: { icon: 'network' },
  102: { icon: 'shield' },
  103: { icon: 'radio' },
  104: { icon: 'code' },
  105: { icon: 'headphones' },
  106: { icon: 'settings' },
  107: { icon: 'flame' },
  108: { icon: 'zap' }
};

// Enhance services with icons, badges, and slugs
const serviciosReales = serviciosFromDirectus.map(s => {
  const sector = serviceToSectorMap[s.id] || 'tecnologia';
  const colors = getSectorColors(sector);

  return {
    ...s,
    ...iconMap[s.id],
    slug: s.slug || generateSlug(s.Titulo),
    Area: s.area || 'Tecnología',
    badge: serviceBadgeMap[s.id] || 'Tecnología',
    badgeColor: colors.icon
  };
});

// Configuración de paginación
const PAGE_SIZE = 12;
const currentPage = parseInt(Astro.url.searchParams.get('page') || '1');
const searchQuery = Astro.url.searchParams.get('search') || '';
const clienteFilter = Astro.url.searchParams.get('cliente') || '';

// Filtrar servicios
let serviciosFiltrados = serviciosReales;

if (searchQuery) {
  serviciosFiltrados = serviciosFiltrados.filter(servicio =>
    servicio.Titulo.toLowerCase().includes(searchQuery.toLowerCase()) ||
    servicio.Descripcion.toLowerCase().includes(searchQuery.toLowerCase())
  );
}

if (clienteFilter) {
  serviciosFiltrados = serviciosFiltrados.filter(servicio =>
    servicio.Cliente === clienteFilter
  );
}

// Paginación
const totalServicios = serviciosFiltrados.length;
const totalPages = Math.ceil(totalServicios / PAGE_SIZE);
const startIndex = (currentPage - 1) * PAGE_SIZE;
const endIndex = startIndex + PAGE_SIZE;
const serviciosPaginados = serviciosFiltrados.slice(startIndex, endIndex);

// Generar opciones de filtros dinámicamente
const clientesUnicos = [...new Set(serviciosReales.map(s => s.Cliente))].sort();

// Compute pagination pages
const computePaginationPages = () => {
  const total = totalPages;
  const current = currentPage;
  const maxPages = 5;

  if (total <= maxPages) {
    return Array.from({ length: total }, (_, i) => i + 1);
  }

  if (current <= 3) {
    return [1, 2, 3, 4, 5];
  }

  if (current >= total - 2) {
    return [total - 4, total - 3, total - 2, total - 1, total];
  }

  return [current - 2, current - 1, current, current + 1, current + 2];
};

const paginationPages = computePaginationPages();

// Helper to build pagination URL
const buildPageUrl = (page: number) => {
  let url = `/servicios?page=${page}`;
  if (searchQuery) url += `&search=${searchQuery}`;
  if (clienteFilter) url += `&cliente=${clienteFilter}`;
  return url;
};
---

<LayoutV4
  title="Servicios | ULTIMA MILLA - Soluciones Tecnológicas Integrales"
  description="Catálogo completo de servicios tecnológicos: telecomunicaciones, cableado estructurado, seguridad electrónica, desarrollo de software, detección de incendio y más. +469 proyectos exitosos en Mendoza, Cuyo y Patagonia."
  keywords="servicios tecnologicos mendoza, telecomunicaciones profesionales, cableado estructurado certificado, seguridad electronica cctv, desarrollo software a medida, deteccion incendio sistemas"
>
  <HeroPageV4
    title="Excelencia en"
    titleHighlight="Servicios Tecnológicos"
    subtitle="Soluciones integrales de infraestructura IT, telecomunicaciones, seguridad electrónica y desarrollo de software para empresas de Argentina."
    breadcrumb={[
      { label: 'Inicio', href: '/' },
      { label: 'Servicios', href: '/servicios' },
    ]}
    badge={{ icon: 'briefcase', text: 'Soluciones Integrales' }}
    backgroundImage={getDirectusImageUrl(serviciosReales[0]?.Imagen)}
    stats={[
      { value: `${serviciosReales.length}+`, label: 'Servicios' },
      { value: `${clientesUnicos.length}+`, label: 'Sectores' },
    ]}
  />

  <!-- Filtros y Búsqueda -->
  <section class="sticky top-20 sm:top-24 z-30 bg-white/90 backdrop-blur-xl border-b border-um-border">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-3 sm:py-4">
      <form method="GET" class="flex flex-col md:flex-row gap-3 sm:gap-4 items-center justify-between">
        <!-- Búsqueda -->
        <div class="relative w-full md:w-96">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="h-5 w-5 text-um-gray" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="text"
            name="search"
            value={searchQuery}
            placeholder="Buscar servicios..."
            class="block w-full pl-10 pr-3 py-2.5 border border-um-border rounded-full leading-5 bg-um-surface placeholder-um-text-muted focus:outline-none focus:ring-2 focus:ring-um-primary/20 focus:border-um-primary text-sm min-h-[44px]"
          />
        </div>

        <div class="flex flex-wrap gap-2 sm:gap-3 w-full md:w-auto">
          <select
            name="cliente"
            class="bg-white border border-um-border text-um-dark py-2.5 px-4 pr-8 rounded-full focus:outline-none focus:ring-2 focus:ring-um-primary/20 focus:border-um-primary text-sm min-h-[44px] flex-1 md:flex-none"
          >
            <option value="">Todos los sectores</option>
            {clientesUnicos.map(cliente => (
              <option value={cliente} selected={clienteFilter === cliente}>{cliente}</option>
            ))}
          </select>

          <button
            type="submit"
            class="px-5 sm:px-6 py-2.5 bg-um-primary text-white font-semibold rounded-lg hover:bg-um-primary-dark transition-colors text-sm min-h-[44px]"
          >
            Filtrar
          </button>
        </div>
      </form>
    </div>
  </section>

  <!-- Grid de Servicios -->
  <section class="py-10 sm:py-14 lg:py-20 bg-um-surface">
    <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
      {serviciosPaginados.length === 0 ? (
        <div class="text-center py-16 sm:py-20">
          <svg class="w-16 h-16 text-um-gray mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <h3 class="text-xl font-bold text-um-dark mb-2">No se encontraron resultados</h3>
          <p class="text-um-gray">Intenta ajustar tus filtros de búsqueda.</p>
          <a href="/servicios" class="inline-block mt-6 px-6 py-3 bg-um-primary text-white font-semibold rounded-lg hover:bg-um-primary-dark transition-colors">
            Ver todos los servicios
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
          {serviciosPaginados.map((servicio) => (
            <ServiceCard
              id={servicio.id}
              slug={servicio.slug}
              titulo={servicio.Titulo}
              descripcion={servicio.Descripcion.replace(/\\\\/g, ' ')}
              imagen={servicio.Imagen}
              badge={servicio.badge}
              badgeColor={servicio.badgeColor}
              cliente={servicio.Cliente}
            />
          ))}
        </div>
      )}

      <!-- Pagination -->
      {totalPages > 1 && (
        <div class="mt-10 sm:mt-12 flex justify-center">
          <nav class="flex items-center gap-1 sm:gap-2" aria-label="Paginación">
            {currentPage > 1 && (
              <a
                href={buildPageUrl(currentPage - 1)}
                class="px-3 sm:px-4 py-2 border border-um-border rounded-lg text-um-text-secondary hover:bg-um-dark hover:text-white hover:border-um-dark transition-colors min-h-[44px] flex items-center"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7" />
                </svg>
              </a>
            )}

            {paginationPages.map((pageNum) => (
              <a
                href={buildPageUrl(pageNum)}
                class={`px-3 sm:px-4 py-2 border rounded-lg font-medium transition-colors min-h-[44px] flex items-center justify-center min-w-[44px] ${
                  currentPage === pageNum
                    ? 'bg-um-dark text-white border-um-dark'
                    : 'border-um-border text-um-text-secondary hover:bg-um-dark hover:text-white hover:border-um-dark'
                }`}
              >
                {pageNum}
              </a>
            ))}

            {currentPage < totalPages && (
              <a
                href={buildPageUrl(currentPage + 1)}
                class="px-3 sm:px-4 py-2 border border-gray-300 rounded-lg text-um-dark hover:bg-um-primary hover:text-white hover:border-um-primary transition-colors min-h-[44px] flex items-center"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </a>
            )}
          </nav>
        </div>
      )}
    </div>
  </section>

  <!-- CTA Section -->
  <CTASection
    variant="light"
    badge="¿Necesita algo personalizado?"
    badgeIcon="rocket"
    titulo="Diseñamos Soluciones a Medida para su Empresa"
    descripcion="Contáctenos para una consultoría gratuita y descubra cómo podemos crear una solución perfecta para sus necesidades específicas."
    primaryButtonText="Solicitar Cotización"
    primaryButtonUrl="/contacto"
    secondaryButtonText="Ver Casos de Éxito"
    secondaryButtonUrl="/antecedentes"
    secondaryButtonIcon="arrow-right"
  />
</LayoutV4>
