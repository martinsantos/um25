---
import Layout from '../../layouts/Layout.astro';
import BreadcrumbSchema from '../../components/SEO/BreadcrumbSchema.astro';
import { generateSlug } from '../../utils/slugUtils.js';
import { directus } from '../../utils/directus.js';

// Datos de servicios locales (fallback y mapeo de imágenes)
const serviciosConfig = {
  // Mapeo de títulos a imágenes generadas (con fondo blanco)
  imageMap: {
    'ciberseguridad': '/images/services/seguidadfondoblanco.png',
    'seguridad': '/images/services/seguidadfondoblanco.png',
    'cctv': '/images/services/seguridadcctvfondoblanco.png',
    'detección': '/images/services/seguridadcctvfondoblanco.png',
    'deteccion': '/images/services/seguridadcctvfondoblanco.png',
    'desarrollo': '/images/services/softwarefondoblanco.png',
    'software': '/images/services/softwarefondoblanco.png',
    'infraestructura': '/images/services/redfondoblanco.png',
    'redes': '/images/services/redfondoblanco.png',
    'red': '/images/services/redfondoblanco.png',
    'telecomunicaciones': '/images/services/redfondoblanco.png',
    'consultoria': '/images/services/serviciositfondoblanco.png',
    'consultoría': '/images/services/serviciositfondoblanco.png',
    'transformación': '/images/services/serviciositfondoblanco.png',
    'transformacion': '/images/services/serviciositfondoblanco.png',
    'soporte': '/images/services/serviciositfondoblanco.png',
    'mesa': '/images/services/serviciositfondoblanco.png',
    'servicios': '/images/services/serviciositfondoblanco.png',
  },
  // Iconos por categoría
  icons: {
    'Seguridad': '🛡️',
    'Software': '💻',
    'Telecomunicaciones': '📡',
    'Consultoría': '📊',
    'Soporte TIC': '🎧',
  },
  // Colores por categoría
  colors: {
    'Seguridad': 'from-blue-600 to-cyan-500',
    'Software': 'from-amber-500 to-orange-600',
    'Telecomunicaciones': 'from-emerald-500 to-teal-600',
    'Consultoría': 'from-purple-600 to-indigo-600',
    'Soporte TIC': 'from-rose-500 to-pink-600',
  }
};

// Función para obtener imagen según título
const getServiceImage = (titulo) => {
  const tituloLower = titulo.toLowerCase();
  for (const [key, value] of Object.entries(serviciosConfig.imageMap)) {
    if (tituloLower.includes(key)) return value;
  }
  return '/images/antecedentes-hero-bg.jpg';
};

// Cargar servicios desde Directus
let servicios = [];
try {
  const response = await directus.getServicios();
  if (response?.data?.length > 0) {
    servicios = response.data.map(s => ({
      ...s,
      imageUrl: getServiceImage(s.Titulo || ''),
      icon: serviciosConfig.icons[s.Area] || '⚡',
      gradient: serviciosConfig.colors[s.Area] || 'from-slate-600 to-slate-800'
    }));
  }
} catch (e) {
  console.error('[SERVICIOS] Error:', e);
}

// Estadísticas
const totalServicios = servicios.length;
const areasUnicas = [...new Set(servicios.map(s => s.Area).filter(Boolean))];
---

<Layout 
  title="Servicios IT Mendoza | Infraestructura, Desarrollo, Seguridad | ULTIMA MILLA" 
  description="Servicios tecnológicos integrales para empresas en Mendoza, Cuyo y Patagonia. Infraestructura de redes, desarrollo de software, ciberseguridad, consultoría IT y soporte técnico 24/7."
  keywords="servicios it mendoza, infraestructura redes, desarrollo software, ciberseguridad empresas, consultoria tecnologica, soporte tecnico 24/7"
>
  <BreadcrumbSchema items={[
    { label: 'Inicio', url: '/' },
    { label: 'Servicios', url: '/servicios' }
  ]} />

  <main class="min-h-screen bg-slate-50">
    <!-- Hero Section Premium -->
    <section class="relative min-h-[60vh] flex items-center overflow-hidden bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900">
      <!-- Animated background pattern -->
      <div class="absolute inset-0 opacity-10">
        <div class="absolute inset-0" style="background-image: radial-gradient(circle at 25% 25%, rgba(59, 130, 246, 0.3) 0%, transparent 50%), radial-gradient(circle at 75% 75%, rgba(16, 185, 129, 0.3) 0%, transparent 50%);"></div>
        <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width=&quot;60&quot; height=&quot;60&quot; viewBox=&quot;0 0 60 60&quot; xmlns=&quot;http://www.w3.org/2000/svg&quot;%3E%3Cg fill=&quot;none&quot; fill-rule=&quot;evenodd&quot;%3E%3Cg fill=&quot;%239C92AC&quot; fill-opacity=&quot;0.1&quot;%3E%3Cpath d=&quot;M36 34v-4h-2v4h-4v2h4v4h2v-4h4v-2h-4zm0-30V0h-2v4h-4v2h4v4h2V6h4V4h-4zM6 34v-4H4v4H0v2h4v4h2v-4h4v-2H6zM6 4V0H4v4H0v2h4v4h2V6h4V4H6z&quot;/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
      </div>
      
      <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-20 text-center">
        <!-- Badge -->
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur-sm rounded-full border border-white/20 mb-8">
          <span class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></span>
          <span class="text-white/90 text-sm font-medium tracking-wide">Soluciones Tecnológicas Integrales</span>
        </div>
        
        <!-- Título Principal -->
        <h1 class="text-4xl md:text-6xl lg:text-7xl font-black text-white mb-6 leading-tight">
          <span class="block">Servicios IT para</span>
          <span class="block mt-2 bg-gradient-to-r from-cyan-400 via-blue-400 to-emerald-400 bg-clip-text text-transparent">
            Empresas que Evolucionan
          </span>
        </h1>
        
        <p class="text-xl md:text-2xl text-slate-300 max-w-3xl mx-auto mb-12 leading-relaxed">
          +22 años impulsando la transformación digital de empresas en Mendoza, Cuyo y Patagonia
        </p>
        
        <!-- Métricas -->
        <div class="flex flex-wrap justify-center gap-8 md:gap-16">
          <div class="text-center">
            <div class="text-4xl md:text-5xl font-black text-white">469+</div>
            <div class="text-sm text-slate-400 uppercase tracking-widest mt-1">Proyectos</div>
          </div>
          <div class="text-center">
            <div class="text-4xl md:text-5xl font-black text-white">{totalServicios}</div>
            <div class="text-sm text-slate-400 uppercase tracking-widest mt-1">Servicios</div>
          </div>
          <div class="text-center">
            <div class="text-4xl md:text-5xl font-black text-white">{areasUnicas.length}</div>
            <div class="text-sm text-slate-400 uppercase tracking-widest mt-1">Áreas de Expertise</div>
          </div>
          <div class="text-center">
            <div class="text-4xl md:text-5xl font-black text-white">24/7</div>
            <div class="text-sm text-slate-400 uppercase tracking-widest mt-1">Soporte</div>
          </div>
        </div>
      </div>
      
      <!-- Scroll indicator -->
      <div class="absolute bottom-8 left-1/2 -translate-x-1/2 animate-bounce">
        <svg class="w-6 h-6 text-white/50" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3"></path>
        </svg>
      </div>
    </section>

    <!-- Grid de Servicios Premium -->
    <section class="py-20 md:py-28 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <!-- Section Header -->
        <div class="text-center mb-16">
          <span class="inline-block px-3 py-1 text-sm font-semibold text-blue-600 bg-blue-50 rounded-full mb-4">
            Nuestras Soluciones
          </span>
          <h2 class="text-3xl md:text-4xl font-bold text-slate-900 mb-4">
            Servicios Profesionales IT
          </h2>
          <p class="text-lg text-slate-600 max-w-2xl mx-auto">
            Soluciones integrales diseñadas para potenciar la competitividad de tu empresa
          </p>
        </div>
        
        <!-- Services Grid -->
        {servicios.length === 0 ? (
          <div class="text-center py-20">
            <p class="text-slate-500 text-lg">Cargando servicios...</p>
          </div>
        ) : (
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {servicios.map((servicio, index) => {
              const slug = generateSlug(servicio.Titulo);
              return (
                <a 
                  href={`/servicios-append/${servicio.id}/${slug}`} 
                  class="group relative flex flex-col overflow-hidden rounded-2xl bg-white shadow-lg hover:shadow-2xl transition-all duration-500 transform hover:-translate-y-2"
                  style={`animation-delay: ${index * 100}ms`}
                >
                  <!-- Image Container with White BG for Transparency Effect -->
                  <div class="relative aspect-[16/10] overflow-hidden bg-white">
                    <img 
                      src={servicio.imageUrl}
                      alt={servicio.Titulo}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
                      loading="lazy"
                    />
                    <!-- Subtle Bottom Gradient for Text Readability -->
                    <div class="absolute inset-x-0 bottom-0 h-1/3 bg-gradient-to-t from-black/20 to-transparent"></div>
                    
                    <!-- Category Badge -->
                    <div class="absolute top-4 left-4 flex items-center gap-2 px-3 py-1.5 bg-white/95 backdrop-blur-sm rounded-full shadow-lg">
                      <span class="text-lg">{servicio.icon}</span>
                      <span class="text-xs font-bold text-slate-700 uppercase tracking-wide">{servicio.Area}</span>
                    </div>
                    
                    <!-- Hover CTA -->
                    <div class="absolute inset-0 flex items-center justify-center opacity-0 group-hover:opacity-100 transition-opacity duration-300">
                      <span class="px-6 py-3 bg-white text-slate-900 font-bold rounded-full shadow-xl transform -translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                        Ver Detalles →
                      </span>
                    </div>
                  </div>
                  
                  <!-- Content -->
                  <div class="flex-1 p-6">
                    <h3 class="text-xl font-bold text-slate-900 mb-3 group-hover:text-blue-600 transition-colors line-clamp-2">
                      {servicio.Titulo}
                    </h3>
                    <p class="text-slate-600 text-sm leading-relaxed line-clamp-3">
                      {servicio.Descripcion?.replace(/\\\\/g, ' ')}
                    </p>
                  </div>
                  
                  <!-- Footer -->
                  <div class="px-6 pb-6">
                    <div class="flex items-center justify-between pt-4 border-t border-slate-100">
                      <span class="text-xs font-medium text-slate-500 uppercase tracking-wide">
                        {servicio.Cliente || 'Empresas'}
                      </span>
                      <span class="text-blue-600 text-sm font-bold group-hover:underline">
                        Explorar servicio
                      </span>
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        )}
      </div>
    </section>

    <!-- CTA Section -->
    <section class="py-20 bg-gradient-to-r from-slate-900 to-slate-800">
      <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="text-3xl md:text-4xl font-bold text-white mb-6">
          ¿Listo para impulsar tu empresa?
        </h2>
        <p class="text-lg text-slate-300 mb-10">
          Agenda una consulta gratuita con nuestros especialistas
        </p>
        <div class="flex flex-col sm:flex-row gap-4 justify-center">
          <a 
            href="/contacto" 
            class="inline-flex items-center justify-center px-8 py-4 bg-white text-slate-900 font-bold rounded-xl hover:bg-slate-100 transition-colors shadow-xl"
          >
            Solicitar Consulta Gratuita
          </a>
          <a 
            href="tel:+542614001234" 
            class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-transparent text-white font-bold rounded-xl border-2 border-white/30 hover:bg-white/10 transition-colors"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"></path>
            </svg>
            Llamar Ahora
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
  
  .grid > a {
    animation: fadeInUp 0.6s ease-out forwards;
    opacity: 0;
  }
</style>

<!-- Schema.org Markup -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": "Servicios IT - ULTIMA MILLA",
  "description": "Servicios tecnológicos profesionales para empresas en Argentina",
  "numberOfItems": totalServicios,
  "itemListElement": servicios.map((s, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "item": {
      "@type": "Service",
      "name": s.Titulo,
      "description": s.Descripcion?.substring(0, 200),
      "provider": {
        "@type": "Organization",
        "name": "ULTIMA MILLA"
      },
      "areaServed": ["Mendoza", "Cuyo", "Patagonia"]
    }
  }))
})}></script>