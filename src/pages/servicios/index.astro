---
import LayoutV4 from '../../layouts/LayoutV4.astro';

type Service = {
  code: string;
  name: string;
  slug: string;
  tagline: string;
  description: string;
  capabilities: string[];
  sectors: number;
  evidence: number;
  image: string;
};

const services: Service[] = [
  {
    code: '101',
    name: 'Redes',
    slug: 'infraestructura-de-redes-cableado-fibra-optica-radioenlaces',
    tagline: 'Cableado estructurado y fibra óptica certificados.',
    description:
      'Diseño, implementación y certificación de redes de datos y fibra óptica para entornos críticos. Desde cableado estructurado en edificios corporativos hasta redes industriales en planta 24/7.',
    capabilities: ['Relevamiento y diseño de topología', 'Cableado estructurado y fibra óptica', 'Certificación y documentación', 'Mantenimiento correctivo y preventivo'],
    sectors: 9,
    evidence: 86,
    image: '/img/servicios/redes.webp',
  },
  {
    code: '102',
    name: 'Seguridad electrónica',
    slug: 'sistemas-de-seguridad-electronica-cctv-control-acceso-sistemas-de-deteccion-de-incendios-sdi',
    tagline: 'CCTV IP, control de accesos y monitoreo operativo.',
    description:
      'Integramos cámaras, grabación, accesos, alarmas y visualización para que la evidencia sea útil, disponible y auditable por responsables técnicos.',
    capabilities: ['CCTV IP y VMS', 'Control de accesos', 'Monitoreo y grabación', 'Integración con operación existente'],
    sectors: 8,
    evidence: 72,
    image: '/img/servicios/seguridad-electronica.webp',
  },
  {
    code: '103',
    name: 'Telecomunicaciones',
    slug: 'telecomunicaciones-datos-voz-video',
    tagline: 'Datos, voz y video para sitios remotos.',
    description:
      'Resolvemos conectividad de última milla, radioenlaces, enlaces corporativos y comunicaciones de respaldo para operaciones que no pueden quedar aisladas.',
    capabilities: ['Radioenlaces y enlaces dedicados', 'Voz, datos y video', 'Redundancia y contingencia', 'Operaciones remotas'],
    sectors: 8,
    evidence: 64,
    image: '/img/servicios/telecomunicaciones.webp',
  },
  {
    code: '104',
    name: 'Software a medida',
    slug: 'desarrollo-de-software-a-medida-web-mobile-erp',
    tagline: 'Sistemas, APIs y tableros para procesos propios.',
    description:
      'Desarrollamos plataformas web, móviles, integraciones y tableros para digitalizar procesos reales sin despegar el sistema de la operación diaria.',
    capabilities: ['Aplicaciones web y móviles', 'APIs e integraciones', 'Dashboards operativos', 'Automatización de procesos'],
    sectors: 7,
    evidence: 58,
    image: '/img/servicios/software-a-medida.webp',
  },
  {
    code: '105',
    name: 'Soporte 24/7',
    slug: 'soporte-tecnico-247-mesa-de-ayuda-mantenimiento-it',
    tagline: 'Mesa de ayuda, NOC y mantenimiento con SLA.',
    description:
      'Acompañamos infraestructura instalada con soporte, monitoreo y mantenimiento para reducir tiempos de respuesta y sostener continuidad operativa.',
    capabilities: ['Mesa de ayuda', 'Monitoreo NOC', 'Mantenimiento en sitio', 'Gestión de incidentes y SLA'],
    sectors: 9,
    evidence: 92,
    image: '/img/servicios/soporte-247.webp',
  },
  {
    code: '106',
    name: 'Consultoría IT',
    slug: 'consultoria-it-y-transformacion-digital-arquitectura-auditoria',
    tagline: 'Arquitectura, auditoría y roadmap operativo.',
    description:
      'Evaluamos riesgos, infraestructura, procesos y decisiones tecnológicas para ordenar inversiones y transformar necesidades en alcance ejecutable.',
    capabilities: ['Auditoría técnica', 'Roadmap de infraestructura', 'Análisis de riesgo', 'Pliegos y especificaciones'],
    sectors: 9,
    evidence: 44,
    image: '/img/servicios/consultoria-it.webp',
  },
  {
    code: '107',
    name: 'Detección de incendios',
    slug: 'sistemas-de-deteccion-y-alarma-de-incendios',
    tagline: 'SDI, sensores y paneles para entornos productivos.',
    description:
      'Implementamos detección y alarma de incendios con criterio técnico, pruebas documentadas e integración con seguridad electrónica y operación edilicia.',
    capabilities: ['Paneles y sensores', 'Pruebas y puesta en marcha', 'Documentación de zonas', 'Mantenimiento y verificación'],
    sectors: 7,
    evidence: 39,
    image: '/img/servicios/deteccion-incendios.webp',
  },
  {
    code: '108',
    name: 'Eléctricos IT',
    slug: 'servicios-electricos-para-it',
    tagline: 'Tableros, UPS y energía limpia para infraestructura.',
    description:
      'Resolvemos la capa eléctrica que sostiene redes, datacenters, CCTV y equipamiento crítico, con instalación prolija y continuidad medida.',
    capabilities: ['Tableros y protecciones', 'UPS y autonomía', 'Energía para racks', 'Medición y mantenimiento'],
    sectors: 8,
    evidence: 63,
    image: '/img/servicios/electricos-it.webp',
  },
];

const totalServices = String(services.length).padStart(2, '0');
---

<LayoutV4
  title="Servicios IT para continuidad operativa | ULTIMA MILLA"
  description="8 frentes de servicio IT: redes, seguridad electronica, telecomunicaciones, software, soporte 24/7, consultoria, deteccion de incendios y electricos IT."
  keywords="servicios IT integrales, redes empresariales, seguridad electronica, telecomunicaciones, software a medida, soporte IT 24/7, consultoria IT, deteccion de incendios, electricos para IT"
  image="/img/servicios/redes.webp"
>
  <div class="services-demo">
    <section class="services-demo-hero" aria-labelledby="services-demo-title">
      <img src="/img/servicios/redes.webp" alt="" width="1920" height="1080" loading="eager" fetchpriority="high" decoding="async" />
      <div class="services-demo-hero__shade" aria-hidden="true"></div>
      <div class="services-demo-shell services-demo-hero__content">
        <p class="services-demo-kicker"><span></span>01 / Servicios</p>
        <h1 id="services-demo-title">Ocho frentes de servicio.</h1>
        <p>Diseñamos, implementamos y sostenemos infraestructura, seguridad, software y soporte.</p>
        <a class="services-demo-hero__cta" href="/contacto">Solicitar relevamiento</a>
      </div>
    </section>

    <section class="services-demo-shell services-demo-list" aria-label="Frentes de servicio de ULTIMA MILLA">
      {services.map((service, index) => (
        <a
          class="services-demo-row"
          href={`/servicios/${service.code}/${service.slug}`}
          aria-label={`Abrir servicio ${service.name}`}
        >
          <div
            role="presentation"
            class={`services-demo-media services-demo-media--${service.code}`}
            style={`--service-image: url('${service.image}')`}
          >
            <img src={service.image} alt="" width="1200" height="900" loading={index < 2 ? 'eager' : 'lazy'} fetchpriority={index === 0 ? 'high' : 'low'} decoding="async" />
            <div aria-hidden="true"></div>
            <span>SRV.{service.code}</span>
            <em>{service.sectors} sectores</em>
          </div>
          <div class="services-demo-body">
            <p class="services-demo-front"><span></span>Frente {String(index + 1).padStart(2, '0')} / {totalServices}</p>
            <h2>{service.name}</h2>
            <strong>{service.tagline}</strong>
            <p>{service.description}</p>
            <ul>
              {service.capabilities.map((capability) => (
                <li>{capability}</li>
              ))}
            </ul>
            <footer>
              <span>{service.evidence} antecedentes</span>
              <span class="services-demo-action">Ver detalle</span>
            </footer>
          </div>
        </a>
      ))}
    </section>

    <section class="services-demo-shell services-demo-closing">
      <div>
        <p class="services-demo-kicker"><span></span>Diagnóstico sin costo inicial</p>
        <h2>¿Qué parte de su operación necesita estabilizar primero?</h2>
      </div>
      <div>
        <a href="/contacto">Solicitar relevamiento</a>
        <a href="/sectores">Explorar por sector</a>
      </div>
    </section>
  </div>

  <style>
    .services-demo {
      min-height: 100vh;
      background: #0a0a0b;
      color: #fff;
      font-family: var(--um-font-body);
    }

    .services-demo-shell {
      width: min(var(--um-container-wide), calc(100% - (var(--um-page-gutter) * 2)));
      margin-inline: auto;
    }

    .services-demo-hero {
      position: relative;
      min-height: clamp(322px, 22vw, 452px);
      display: flex;
      align-items: flex-end;
      overflow: hidden;
      isolation: isolate;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      background: #0a0a0b;
    }

    .services-demo-hero > img {
      position: absolute;
      inset: 0;
      z-index: -3;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: contrast(1.08) saturate(0.9) brightness(0.62);
    }

    .services-demo-hero__shade {
      position: absolute;
      inset: 0;
      z-index: -2;
      background:
        linear-gradient(90deg, rgba(10,10,11,0.96), rgba(10,10,11,0.56) 48%, rgba(10,10,11,0.22)),
        linear-gradient(to top, #0a0a0b, rgba(10,10,11,0.18));
    }

    .services-demo-hero__content {
      padding: 86px 0 56px;
    }

    .services-demo-hero__cta {
      display: inline-flex;
      min-height: 48px;
      align-items: center;
      justify-content: center;
      margin-top: 24px;
      padding: 0 20px;
      background: #dc2626;
      color: #fff;
      font-size: 1rem;
      font-weight: 700;
      line-height: 1.2;
      text-decoration: none;
      transition: background-color 0.18s ease;
    }

    .services-demo-hero__cta:hover,
    .services-demo-hero__cta:focus-visible {
      background: #b91c1c;
    }

    .services-demo :where(p, li, span, strong, em, a) {
      font-size: max(16px, 1em) !important;
    }

    .services-demo-kicker,
    .services-demo-front {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      margin: 0;
      color: #dc2626;
      font-family: var(--um-font-mono);
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      line-height: 1.2;
      text-transform: uppercase;
    }

    .services-demo-kicker span,
    .services-demo-front span {
      width: 36px;
      height: 2px;
      background: #dc2626;
    }

    .services-demo-hero h1 {
      width: min(100%, 1320px);
      max-width: none;
      margin: 22px 0 0;
      color: #fff;
      font-family: var(--um-font-display);
      font-size: clamp(3rem, 4vw, 3.5rem);
      font-weight: var(--um-display-weight);
      letter-spacing: var(--um-display-tracking);
      line-height: 1.12;
      text-shadow: 0 4px 24px rgba(0,0,0,0.85), 0 2px 8px rgba(0,0,0,0.9);
      text-wrap: nowrap;
    }

    .services-demo-hero p:not(.services-demo-kicker) {
      max-width: 560px;
      margin: 20px 0 0;
      color: rgba(255,255,255,0.76);
      font-size: var(--um-copy-lead);
      line-height: 1.6;
    }

    .services-demo-list {
      padding: 56px 0 32px;
    }

    .services-demo-row {
      display: grid;
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
      min-height: 360px;
      border: 0;
      border-top: 1px solid rgba(255,255,255,0.16);
      background: #0a0a0b;
      color: inherit;
      text-decoration: none;
      content-visibility: auto;
      contain-intrinsic-block-size: 360px;
      transition: background-color 0.18s ease, border-color 0.18s ease;
    }

    .services-demo-row:hover,
    .services-demo-row:focus-visible {
      background: #101014;
      border-color: rgba(255,255,255,0.22);
    }

    .services-demo-row:focus-visible {
      outline: 3px solid rgba(220,38,38,0.58);
      outline-offset: -3px;
    }

    .services-demo-row + .services-demo-row {
      margin-top: 16px;
    }

    .services-demo-row:nth-child(even) .services-demo-media {
      order: 2;
    }

    .services-demo-media {
      position: relative;
      display: block;
      min-height: 360px;
      overflow: hidden;
      isolation: isolate;
      color: #fff;
      text-decoration: none;
      background-color: #0f0f11;
      background-image: var(--service-image);
      background-position: center;
      background-size: cover;
    }

    .services-demo-media img {
      position: absolute;
      inset: 0;
      z-index: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: contrast(1.08) saturate(0.9) brightness(0.82);
      transform: none;
      transition: filter 0.18s ease;
    }

    .services-demo-media div {
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        linear-gradient(to top, rgba(10,10,11,0.92), rgba(10,10,11,0.18) 58%, rgba(10,10,11,0.04)),
        linear-gradient(120deg, rgba(220,38,38,0.16), transparent 38%);
    }

    .services-demo-media span,
    .services-demo-media em {
      position: absolute;
      z-index: 2;
      top: 28px;
      font-family: var(--um-font-mono);
      font-size: 1rem;
      font-style: normal;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .services-demo-media span {
      left: 28px;
      padding: 7px 10px;
      border-left: 2px solid #dc2626;
      background: rgba(10, 10, 11, 0.82);
      color: #fff;
      font-weight: 700;
    }

    .services-demo-media em {
      left: 126px;
      color: rgba(255,255,255,0.66);
    }

    .services-demo-media--101 { --service-image: url('/img/servicios/redes.webp'); }
    .services-demo-media--102 { --service-image: url('/img/servicios/seguridad-electronica.webp'); }
    .services-demo-media--103 { --service-image: url('/img/servicios/telecomunicaciones.webp'); }
    .services-demo-media--104 { --service-image: url('/img/servicios/software-a-medida.webp'); }
    .services-demo-media--105 { --service-image: url('/img/servicios/soporte-247.webp'); }
    .services-demo-media--106 { --service-image: url('/img/servicios/consultoria-it.webp'); }
    .services-demo-media--107 { --service-image: url('/img/servicios/deteccion-incendios.webp'); }
    .services-demo-media--108 { --service-image: url('/img/servicios/electricos-it.webp'); }

    .services-demo-body {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: clamp(26px, 3.4vw, 38px);
      background: #0a0a0b;
    }

    .services-demo-body h2 {
      max-width: 14ch;
      margin: 16px 0 0;
      color: #fff;
      font-family: var(--um-font-display);
      font-size: clamp(2rem, 2.8vw, 2.375rem);
      font-weight: var(--um-display-weight);
      letter-spacing: var(--um-display-tracking);
      line-height: 1.12;
      overflow-wrap: normal;
    }

    .services-demo-row:hover h2,
    .services-demo-row:focus-visible h2 {
      color: #dc2626;
    }

    .services-demo-body strong {
      display: block;
      margin-top: 12px;
      color: #fff;
      font-size: clamp(1.0625rem, 1.25vw, 1.18rem);
      line-height: 1.35;
    }

    .services-demo-body > p:not(.services-demo-front) {
      display: none;
    }

    .services-demo-body ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 8px 20px;
      margin: 16px 0 0;
      padding: 0;
      list-style: none;
      color: #c4c4ca;
      font-size: var(--um-copy-description);
      line-height: 1.45;
    }

    .services-demo-body li {
      position: relative;
      padding-left: 16px;
    }

    .services-demo-body li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0.62em;
      width: 6px;
      height: 6px;
      background: #dc2626;
      border-radius: 999px;
    }

    .services-demo-body footer {
      display: flex;
      flex-wrap: wrap;
      gap: 14px 22px;
      align-items: center;
      margin-top: 18px;
      padding-top: 16px;
      border-top: 1px solid rgba(255,255,255,0.08);
    }

    .services-demo-body footer span {
      margin-right: auto;
      color: #fff;
      font-family: var(--um-font-mono);
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .services-demo-action {
      color: #fff;
      font-weight: 700;
      text-decoration: none;
      border-bottom: 2px solid #dc2626;
      padding-bottom: 3px;
      transition: color 0.18s ease, border-color 0.18s ease;
    }

    .services-demo-action::after {
      content: "->";
      margin-left: 8px;
      color: #dc2626;
    }

    .services-demo-row:hover .services-demo-action,
    .services-demo-row:focus-visible .services-demo-action {
      color: #dc2626;
      border-color: #dc2626;
    }

    .services-demo-closing {
      display: flex;
      justify-content: space-between;
      gap: 24px;
      margin-top: 24px;
      margin-bottom: 72px;
      padding: 32px 40px;
      border: 1px solid rgba(255,255,255,0.1);
      background: #0f0f11;
    }

    .services-demo-closing h2 {
      max-width: 680px;
      margin: 16px 0 0;
      color: #fff;
      font-family: var(--um-font-display);
      font-size: clamp(1.55rem, 3vw, 2.1rem);
      font-weight: var(--um-display-weight);
      letter-spacing: var(--um-display-tracking);
      line-height: 1;
    }

    .services-demo-closing > div:last-child {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
    }

    .services-demo-closing a {
      display: inline-flex;
      align-items: center;
      min-height: 48px;
      padding: 0 22px;
      background: #dc2626;
      color: #fff;
      font-size: 1rem;
      font-weight: 700;
      text-decoration: none;
      transition: background-color 0.18s ease, border-color 0.18s ease;
    }

    .services-demo-closing a:hover,
    .services-demo-closing a:focus-visible {
      background: #b91c1c;
    }

    .services-demo-closing a + a {
      background: transparent;
      border: 1px solid rgba(255,255,255,0.2);
    }

    @media (max-width: 980px) {
      .services-demo-shell {
        width: min(100% - 32px, var(--um-container-wide));
      }

      .services-demo-hero {
        min-height: 340px;
      }

      .services-demo-hero__content {
        padding: 40px 0;
      }

      .services-demo-hero h1 {
        width: min(100%, 800px);
        max-width: 100%;
        font-size: clamp(2rem, 8.5vw, 2.5rem);
        line-height: 1.1;
        text-wrap: balance;
      }

      .services-demo-row,
      .services-demo-row:nth-child(even) {
        grid-template-columns: 1fr;
      }

      .services-demo-row:nth-child(even) .services-demo-media {
        order: 0;
      }

      .services-demo-media,
      .services-demo-row {
        min-height: 0;
      }

      .services-demo-media {
        min-height: 176px;
      }

      .services-demo-media div {
        background:
          linear-gradient(to top, rgba(10,10,11,0.76), rgba(10,10,11,0.12) 58%, rgba(10,10,11,0.02)),
          linear-gradient(120deg, rgba(220,38,38,0.10), transparent 38%);
      }

      .services-demo-body h2 {
        max-width: 100%;
        font-size: clamp(2rem, 9vw, 2.6rem);
        line-height: 1.1;
      }

      .services-demo-body ul {
        grid-template-columns: 1fr;
      }

      .services-demo-closing {
        display: grid;
        padding: 24px;
      }
    }

    @media (max-width: 640px) {
      .services-demo-list {
        padding: 28px 0 18px;
      }

      .services-demo-row,
      .services-demo-row:nth-child(even) {
        grid-template-columns: minmax(92px, 27vw) minmax(0, 1fr);
        min-height: 0;
        border-top-width: 1px;
        contain-intrinsic-block-size: 240px;
      }

      .services-demo-row + .services-demo-row {
        margin-top: 14px;
      }

      .services-demo-row:nth-child(even) .services-demo-media {
        order: 0;
      }

      .services-demo-media {
        min-height: 100%;
      }

      .services-demo-media img {
        transform: none;
      }

      .services-demo-row:hover .services-demo-media img,
      .services-demo-row:focus-visible .services-demo-media img {
        transform: none;
      }

      .services-demo-media div {
        background:
          linear-gradient(to top, rgba(10,10,11,0.72), rgba(10,10,11,0.18)),
          linear-gradient(120deg, rgba(220,38,38,0.12), transparent 52%);
      }

      .services-demo-media span,
      .services-demo-media em {
        display: none;
      }

      .services-demo-body {
        justify-content: start;
        padding: 16px 16px 15px;
      }

      .services-demo-front {
        gap: 8px;
        font-size: 1rem;
        letter-spacing: 0.12em;
      }

      .services-demo-front span {
        width: 24px;
      }

      .services-demo-body h2 {
        margin-top: 10px;
        font-size: clamp(1.42rem, 6vw, 1.72rem);
        line-height: 1.12;
        word-break: normal;
      }

      .services-demo-body strong {
        margin-top: 8px;
        font-size: var(--um-copy-description);
        line-height: 1.35;
      }

      .services-demo-body > p {
        display: none;
      }

      .services-demo-body ul {
        display: none;
      }

      .services-demo-body footer {
        gap: 10px 14px;
        margin-top: 11px;
        padding-top: 10px;
      }

      .services-demo-body footer span {
        font-size: 1rem;
        letter-spacing: 0.02em;
      }

      .services-demo-action {
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        padding-bottom: 0;
        border-bottom-width: 1px;
        font-size: 1rem;
      }
    }
  </style>
</LayoutV4>
