---
import Layout from '../../layouts/Layout.astro';
import { generateSlug } from '../../utils/slugUtils.js';
import { serviciosReales } from '../../data/servicios_reales_db.js';

// Configuración de paginación
const PAGE_SIZE = 12;
const currentPage = parseInt(Astro.url.searchParams.get('page') || '1');
const searchQuery = Astro.url.searchParams.get('search') || '';
const areaFilter = Astro.url.searchParams.get('area') || '';
const clienteFilter = Astro.url.searchParams.get('cliente') || '';

// Filtrar servicios
let serviciosFiltrados = serviciosReales;

if (searchQuery) {
  serviciosFiltrados = serviciosFiltrados.filter(servicio => 
    servicio.Titulo.toLowerCase().includes(searchQuery.toLowerCase()) ||
    servicio.Descripcion.toLowerCase().includes(searchQuery.toLowerCase())
  );
}

if (areaFilter) {
  serviciosFiltrados = serviciosFiltrados.filter(servicio => 
    servicio.Area === areaFilter
  );
}

if (clienteFilter) {
  serviciosFiltrados = serviciosFiltrados.filter(servicio => 
    servicio.Cliente === clienteFilter
  );
}

// Paginación
const totalServicios = serviciosFiltrados.length;
const totalPages = Math.ceil(totalServicios / PAGE_SIZE);
const startIndex = (currentPage - 1) * PAGE_SIZE;
const endIndex = startIndex + PAGE_SIZE;
const serviciosPaginados = serviciosFiltrados.slice(startIndex, endIndex);

// Generar opciones de filtros dinámicamente
const areasUnicas = [...new Set(serviciosReales.map(s => s.Area))].sort();
const clientesUnicos = [...new Set(serviciosReales.map(s => s.Cliente))].sort();

// Mapeo de IDs de imágenes de Directus a archivos estáticos locales
const imageMapping = {
  'b1a91d79-c979-4067-b78a-2cd97166fbcd': '/images/services/seguridad-informatica.jpg',
  '6e626d63-c3ca-4982-8ed3-4a5e75e1b179': '/images/services/redes-comunicaciones.jpg',
  'f2a65085-e6ad-49fc-a123-1b5dc19fc7ab': '/images/services/ciberseguridad.jpg',
  '4ffcefb0-6cb8-4cfa-a748-bd4c3da1d716': '/images/services/telefonia.jpg',
  'dc6d6069-23af-4d75-ae5a-38c830bf2b85': '/images/services/servicios-web.jpg',
  '2749f988-2e2d-4f32-9978-4dbeb4aa6ab2': '/images/services/servicios-it.jpg',
  'ccc32af0-df52-4e6e-8ca0-9660dddec095': '/images/services/servicios-it.jpg',
  '18b5f4e3-4bc8-485d-a01c-8cbd53e25f4d': '/images/services/redes-comunicaciones.jpg'
};

// Función para obtener URL de imagen
function getAssetUrl(assetId) {
  if (!assetId) return '/images/services/default-service.jpg';
  
  // Si tenemos un mapeo estático, usarlo
  if (imageMapping[assetId]) {
    return imageMapping[assetId];
  }
  
  // Fallback a imagen por defecto
  return '/images/services/default-service.jpg';
}
---

<Layout title="Servicios - Ultima Milla">
  <main class="min-h-screen bg-gradient-to-br from-slate-50 to-blue-50">
    <!-- Hero Section con Indicadores -->
    <section class="relative bg-gradient-to-r from-blue-600 via-purple-600 to-blue-800 text-white py-20">
      <div class="absolute inset-0 bg-black/20"></div>
      <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-12">
          <h1 class="text-4xl md:text-6xl font-bold mb-6 text-white">
            Nuestros Servicios
          </h1>
          <p class="text-xl md:text-2xl text-blue-100 max-w-3xl mx-auto">
            Soluciones tecnológicas integrales para empresas e instituciones
          </p>
        </div>
        
        <!-- Indicadores Visuales -->
        <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mt-16">
          <div class="text-center">
            <div class="text-4xl md:text-5xl font-bold text-yellow-300 mb-2">
              {serviciosReales.length}+
            </div>
            <div class="text-lg text-blue-100">Servicios Especializados</div>
          </div>
          <div class="text-center">
            <div class="text-4xl md:text-5xl font-bold text-yellow-300 mb-2">
              {areasUnicas.length}
            </div>
            <div class="text-lg text-blue-100">Áreas de Especialización</div>
          </div>
          <div class="text-center">
            <div class="text-4xl md:text-5xl font-bold text-yellow-300 mb-2">
              {clientesUnicos.length}+
            </div>
            <div class="text-lg text-blue-100">Tipos de Clientes</div>
          </div>
        </div>
      </div>
    </section>

    <!-- Filtros y Búsqueda -->
    <section class="py-8 bg-white shadow-sm">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <form method="GET" class="flex flex-wrap gap-4 items-center justify-between">
          <!-- Búsqueda -->
          <div class="flex-1 min-w-64">
            <input
              type="text"
              name="search"
              value={searchQuery}
              placeholder="Buscar servicios..."
              class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
          </div>
          
          <!-- Filtro por Área -->
          <select name="area" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            <option value="">Todas las áreas</option>
            {areasUnicas.map(area => (
              <option value={area} selected={areaFilter === area}>{area}</option>
            ))}
          </select>
          
          <!-- Filtro por Cliente -->
          <select name="cliente" class="px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500">
            <option value="">Todos los clientes</option>
            {clientesUnicos.map(cliente => (
              <option value={cliente} selected={clienteFilter === cliente}>{cliente}</option>
            ))}
          </select>
          
          <button type="submit" class="px-6 py-2 bg-blue-600 text-white rounded-lg hover:bg-blue-700 transition-colors">
            Filtrar
          </button>
        </form>
      </div>
    </section>

    <!-- Grid de Servicios -->
    <section class="py-16">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        {serviciosPaginados.length === 0 ? (
          <div class="text-center py-16">
            <div class="text-6xl mb-4">🔍</div>
            <h3 class="text-2xl font-bold text-gray-900 mb-2">No se encontraron servicios</h3>
            <p class="text-gray-600">Intenta ajustar los filtros de búsqueda</p>
          </div>
        ) : (
          <>
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
              {serviciosFiltrados.map((servicio) => {
                const slug = generateSlug(servicio.Titulo);
                return (
                  <a href={`/servicios/${servicio.id}/${slug}`} class="block group cursor-pointer">
                    <article class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl hover:shadow-blue-500/25 transition-all duration-300 transform hover:-translate-y-2 hover:scale-[1.02] hover:ring-4 hover:ring-blue-300/50 h-full border-2 border-transparent hover:border-blue-400">
                      <div class="aspect-video bg-gradient-to-br from-blue-500 to-purple-600 relative overflow-hidden">
                        <img
                          src={getAssetUrl(servicio.Imagen)}
                          alt={servicio.Titulo}
                          class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                          loading="lazy"
                          onerror="this.src='/images/default-service.jpg'"
                        />
                        <div class="absolute top-4 right-4">
                          <span class="bg-white/90 text-blue-600 px-3 py-1 rounded-full text-sm font-semibold">
                            {servicio.Area}
                          </span>
                        </div>
                      </div>
                      
                      <div class="p-6 flex flex-col h-full">
                        <h3 class="text-xl font-black text-gray-900 mb-3 group-hover:text-blue-600 transition-colors">
                          {servicio.Titulo}
                        </h3>
                        
                        <p class="text-gray-600 mb-4 line-clamp-3 flex-grow">
                          {servicio.Descripcion.replace(/\\\\/g, ' ').substring(0, 150)}...
                        </p>
                        
                        <div class="mt-auto">
                          <div class="flex items-center justify-between mb-4">
                            <span class="text-sm text-gray-500">
                              Cliente: {servicio.Cliente}
                            </span>
                          </div>
                          

                        </div>
                      </div>
                    </article>
                  </a>
                );
              })}
            </div>
          </>
        )}
      </div>
    </section>


  </main>
</Layout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>