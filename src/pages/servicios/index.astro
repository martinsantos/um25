---
import LayoutV4 from '../../layouts/LayoutV4.astro';

type Service = {
  code: string;
  name: string;
  slug: string;
  tagline: string;
  description: string;
  capabilities: string[];
  sectors: number;
  evidence: number;
  image: string;
};

const services: Service[] = [
  {
    code: '101',
    name: 'Redes',
    slug: 'infraestructura-de-redes-cableado-fibra-optica-radioenlaces',
    tagline: 'Cableado estructurado y fibra optica certificados.',
    description:
      'Diseno, implementacion y certificacion de redes de datos y fibra optica para entornos criticos. Desde cableado estructurado en edificios corporativos hasta redes industriales en planta 24/7.',
    capabilities: ['Relevamiento y diseno de topologia', 'Cableado estructurado y fibra optica', 'Certificacion y documentacion', 'Mantenimiento correctivo y preventivo'],
    sectors: 9,
    evidence: 86,
    image: '/img/servicios/redes.webp',
  },
  {
    code: '102',
    name: 'Seguridad electronica',
    slug: 'sistemas-de-seguridad-electronica-cctv-control-acceso-sistemas-de-deteccion-de-incendios-sdi',
    tagline: 'CCTV IP, control de accesos y monitoreo operativo.',
    description:
      'Integramos camaras, grabacion, accesos, alarmas y visualizacion para que la evidencia sea util, disponible y auditable por responsables tecnicos.',
    capabilities: ['CCTV IP y VMS', 'Control de accesos', 'Monitoreo y grabacion', 'Integracion con operacion existente'],
    sectors: 8,
    evidence: 72,
    image: '/img/servicios/seguridad-electronica.webp',
  },
  {
    code: '103',
    name: 'Telecomunicaciones',
    slug: 'telecomunicaciones-datos-voz-video',
    tagline: 'Datos, voz y video para sitios remotos.',
    description:
      'Resolvemos conectividad de ultima milla, radioenlaces, enlaces corporativos y comunicaciones de respaldo para operaciones que no pueden quedar aisladas.',
    capabilities: ['Radioenlaces y enlaces dedicados', 'Voz, datos y video', 'Redundancia y contingencia', 'Operaciones remotas'],
    sectors: 8,
    evidence: 64,
    image: '/img/servicios/telecomunicaciones.webp',
  },
  {
    code: '104',
    name: 'Software a medida',
    slug: 'desarrollo-de-software-a-medida-web-mobile-erp',
    tagline: 'Sistemas, APIs y tableros para procesos propios.',
    description:
      'Desarrollamos plataformas web, moviles, integraciones y tableros para digitalizar procesos reales sin despegar el sistema de la operacion diaria.',
    capabilities: ['Aplicaciones web y moviles', 'APIs e integraciones', 'Dashboards operativos', 'Automatizacion de procesos'],
    sectors: 7,
    evidence: 58,
    image: '/img/servicios/software-a-medida.webp',
  },
  {
    code: '105',
    name: 'Soporte 24/7',
    slug: 'soporte-tecnico-247-mesa-de-ayuda-mantenimiento-it',
    tagline: 'Mesa de ayuda, NOC y mantenimiento con SLA.',
    description:
      'Acompanamos infraestructura instalada con soporte, monitoreo y mantenimiento para reducir tiempos de respuesta y sostener continuidad operativa.',
    capabilities: ['Mesa de ayuda', 'Monitoreo NOC', 'Mantenimiento en sitio', 'Gestion de incidentes y SLA'],
    sectors: 9,
    evidence: 92,
    image: '/img/servicios/soporte-247.webp',
  },
  {
    code: '106',
    name: 'Consultoria IT',
    slug: 'consultoria-it-y-transformacion-digital-arquitectura-auditoria',
    tagline: 'Arquitectura, auditoria y roadmap operativo.',
    description:
      'Evaluamos riesgos, infraestructura, procesos y decisiones tecnologicas para ordenar inversiones y transformar necesidades en alcance ejecutable.',
    capabilities: ['Auditoria tecnica', 'Roadmap de infraestructura', 'Analisis de riesgo', 'Pliegos y especificaciones'],
    sectors: 9,
    evidence: 44,
    image: '/img/servicios/consultoria-it.webp',
  },
  {
    code: '107',
    name: 'Deteccion de incendios',
    slug: 'sistemas-de-deteccion-y-alarma-de-incendios',
    tagline: 'SDI, sensores y paneles para entornos productivos.',
    description:
      'Implementamos deteccion y alarma de incendios con criterio tecnico, pruebas documentadas e integracion con seguridad electronica y operacion edilicia.',
    capabilities: ['Paneles y sensores', 'Pruebas y puesta en marcha', 'Documentacion de zonas', 'Mantenimiento y verificacion'],
    sectors: 7,
    evidence: 39,
    image: '/img/servicios/deteccion-incendios.webp',
  },
  {
    code: '108',
    name: 'Electricos IT',
    slug: 'servicios-electricos-para-it',
    tagline: 'Tableros, UPS y energia limpia para infraestructura.',
    description:
      'Resolvemos la capa electrica que sostiene redes, datacenters, CCTV y equipamiento critico, con instalacion prolija y continuidad medida.',
    capabilities: ['Tableros y protecciones', 'UPS y autonomia', 'Energia para racks', 'Medicion y mantenimiento'],
    sectors: 8,
    evidence: 63,
    image: '/img/servicios/electricos-it.webp',
  },
];

const totalServices = String(services.length).padStart(2, '0');
---

<LayoutV4
  title="Servicios IT para continuidad operativa | ULTIMA MILLA"
  description="8 frentes de servicio IT: redes, seguridad electronica, telecomunicaciones, software, soporte 24/7, consultoria, deteccion de incendios y electricos IT."
  keywords="servicios IT integrales, redes empresariales, seguridad electronica, telecomunicaciones, software a medida, soporte IT 24/7, consultoria IT, deteccion de incendios, electricos para IT"
  image="/img/servicios/redes.webp"
>
  <div class="services-demo">
    <section class="services-demo-hero" aria-labelledby="services-demo-title">
      <img src="/img/servicios/redes.webp" alt="" loading="eager" fetchpriority="high" decoding="async" />
      <div class="services-demo-hero__shade" aria-hidden="true"></div>
      <div class="services-demo-shell services-demo-hero__content">
        <p class="services-demo-kicker"><span></span>01 / Servicios</p>
        <h1 id="services-demo-title">Ocho frentes de servicio.</h1>
        <p>Una arquitectura, no proveedores aislados.</p>
      </div>
    </section>

    <section class="services-demo-shell services-demo-list" aria-label="Frentes de servicio de ULTIMA MILLA">
      {services.map((service, index) => (
        <article class="services-demo-row">
          <a
            href={`/servicios/${service.code}/${service.slug}`}
            class={`services-demo-media services-demo-media--${service.code}`}
            style={`--service-image: url('${service.image}')`}
            aria-label={`Abrir servicio ${service.name}`}
          >
            <img src={service.image} alt="" loading="eager" decoding="async" />
            <div aria-hidden="true"></div>
            <span>SRV.{service.code}</span>
            <em>{service.sectors} sectores</em>
          </a>
          <div class="services-demo-body">
            <p class="services-demo-front"><span></span>Frente {String(index + 1).padStart(2, '0')} / {totalServices}</p>
            <h2><a href={`/servicios/${service.code}/${service.slug}`}>{service.name}</a></h2>
            <strong>{service.tagline}</strong>
            <p>{service.description}</p>
            <ul>
              {service.capabilities.map((capability) => (
                <li>{capability}</li>
              ))}
            </ul>
            <footer>
              <span>{service.evidence} antecedentes</span>
              <a href={`/servicios/${service.code}/${service.slug}`}>Ver detalle</a>
            </footer>
          </div>
        </article>
      ))}
    </section>

    <section class="services-demo-shell services-demo-closing">
      <div>
        <p class="services-demo-kicker"><span></span>Diagnostico sin costo inicial</p>
        <h2>Que parte de su operacion necesita estabilizar primero?</h2>
      </div>
      <div>
        <a href="/contacto">Solicitar relevamiento</a>
        <a href="/sectores">Explorar por sector</a>
      </div>
    </section>
  </div>

  <style>
    .services-demo {
      min-height: 100vh;
      background: #0a0a0b;
      color: #fff;
      font-family: var(--um-font-body);
    }

    .services-demo-shell {
      width: min(1920px, calc(100% - 128px));
      margin-inline: auto;
    }

    .services-demo-hero {
      position: relative;
      min-height: clamp(322px, 22vw, 452px);
      display: flex;
      align-items: flex-end;
      overflow: hidden;
      isolation: isolate;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      background: #0a0a0b;
    }

    .services-demo-hero > img {
      position: absolute;
      inset: 0;
      z-index: -3;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: contrast(1.08) saturate(0.9) brightness(0.62);
    }

    .services-demo-hero__shade {
      position: absolute;
      inset: 0;
      z-index: -2;
      background:
        linear-gradient(90deg, rgba(10,10,11,0.96), rgba(10,10,11,0.56) 48%, rgba(10,10,11,0.22)),
        linear-gradient(to top, #0a0a0b, rgba(10,10,11,0.18));
    }

    .services-demo-hero__content {
      padding: 86px 0 56px;
    }

    .services-demo-kicker,
    .services-demo-front {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      margin: 0;
      color: #dc2626;
      font-family: var(--um-font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.16em;
      line-height: 1.2;
      text-transform: uppercase;
    }

    .services-demo-kicker span,
    .services-demo-front span {
      width: 36px;
      height: 2px;
      background: #dc2626;
    }

    .services-demo-hero h1 {
      width: min(100%, 1320px);
      max-width: none;
      margin: 22px 0 0;
      color: #fff;
      font-family: var(--um-font-display);
      font-size: clamp(3rem, 4.8vw, 5.2rem);
      font-weight: var(--um-display-weight);
      letter-spacing: var(--um-display-tracking);
      line-height: var(--um-display-line-height);
      text-shadow: 0 4px 24px rgba(0,0,0,0.85), 0 2px 8px rgba(0,0,0,0.9);
      text-wrap: nowrap;
    }

    .services-demo-hero h1::after {
      content: "";
      display: inline-block;
      width: 0.12em;
      height: 0.82em;
      margin-left: 0.08em;
      transform: translateY(0.08em);
      background: #dc2626;
    }

    .services-demo-hero p:not(.services-demo-kicker) {
      max-width: 560px;
      margin: 20px 0 0;
      color: rgba(255,255,255,0.76);
      font-size: 1.02rem;
      line-height: 1.6;
    }

    .services-demo-list {
      padding: 56px 0 32px;
    }

    .services-demo-row {
      display: grid;
      grid-template-columns: minmax(0, 1.02fr) minmax(0, 1fr);
      min-height: 438px;
      border: 1px solid rgba(255,255,255,0.1);
      border-top: 3px solid #dc2626;
      background: #0a0a0b;
    }

    .services-demo-row + .services-demo-row {
      margin-top: 28px;
    }

    .services-demo-row:nth-child(even) .services-demo-media {
      order: 2;
    }

    .services-demo-media {
      position: relative;
      display: block;
      min-height: 438px;
      overflow: hidden;
      isolation: isolate;
      color: #fff;
      text-decoration: none;
      background-color: #0f0f11;
      background-image: var(--service-image);
      background-position: center;
      background-size: cover;
    }

    .services-demo-media img {
      position: absolute;
      inset: 0;
      z-index: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: contrast(1.08) saturate(0.9) brightness(0.82);
      transform: scale(1.01);
      transition: transform 0.25s ease, filter 0.25s ease;
    }

    .services-demo-media:hover img {
      transform: scale(1.04);
      filter: contrast(1.1) saturate(1) brightness(0.9);
    }

    .services-demo-media div {
      position: absolute;
      inset: 0;
      z-index: 1;
      background:
        linear-gradient(to top, rgba(10,10,11,0.92), rgba(10,10,11,0.18) 58%, rgba(10,10,11,0.04)),
        linear-gradient(120deg, rgba(220,38,38,0.16), transparent 38%);
    }

    .services-demo-media span,
    .services-demo-media em {
      position: absolute;
      z-index: 2;
      top: 28px;
      font-family: var(--um-font-mono);
      font-size: 0.68rem;
      font-style: normal;
      letter-spacing: 0.16em;
      text-transform: uppercase;
    }

    .services-demo-media span {
      left: 28px;
      padding: 7px 10px;
      background: #dc2626;
      color: #fff;
      font-weight: 700;
    }

    .services-demo-media em {
      left: 126px;
      color: rgba(255,255,255,0.66);
    }

    .services-demo-media--101 { --service-image: url('/img/servicios/redes.webp'); }
    .services-demo-media--102 { --service-image: url('/img/servicios/seguridad-electronica.webp'); }
    .services-demo-media--103 { --service-image: url('/img/servicios/telecomunicaciones.webp'); }
    .services-demo-media--104 { --service-image: url('/img/servicios/software-a-medida.webp'); }
    .services-demo-media--105 { --service-image: url('/img/servicios/soporte-247.webp'); }
    .services-demo-media--106 { --service-image: url('/img/servicios/consultoria-it.webp'); }
    .services-demo-media--107 { --service-image: url('/img/servicios/deteccion-incendios.webp'); }
    .services-demo-media--108 { --service-image: url('/img/servicios/electricos-it.webp'); }

    .services-demo-body {
      display: flex;
      flex-direction: column;
      justify-content: center;
      padding: clamp(34px, 5vw, 58px);
      background: #0a0a0b;
    }

    .services-demo-body h2 {
      max-width: 14ch;
      margin: 26px 0 0;
      color: #fff;
      font-family: var(--um-font-display);
      font-size: clamp(2.8rem, 5vw, 4.25rem);
      font-weight: var(--um-display-weight);
      letter-spacing: var(--um-display-tracking);
      line-height: var(--um-display-line-height);
      overflow-wrap: anywhere;
    }

    .services-demo-body h2 a {
      color: inherit;
      text-decoration: none;
    }

    .services-demo-row:hover h2 {
      color: #ff3b3b;
    }

    .services-demo-body strong {
      display: block;
      margin-top: 18px;
      color: #dc2626;
      font-size: clamp(1.08rem, 1.45vw, 1.28rem);
      line-height: 1.35;
    }

    .services-demo-body > p {
      max-width: 620px;
      margin: 22px 0 0;
      color: #a1a1aa;
      font-size: 1rem;
      line-height: 1.7;
    }

    .services-demo-body ul {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 10px 20px;
      margin: 26px 0 0;
      padding: 0;
      list-style: none;
      color: #a1a1aa;
      font-size: 0.92rem;
      line-height: 1.45;
    }

    .services-demo-body li {
      position: relative;
      padding-left: 16px;
    }

    .services-demo-body li::before {
      content: "";
      position: absolute;
      left: 0;
      top: 0.62em;
      width: 6px;
      height: 6px;
      background: #dc2626;
      border-radius: 999px;
    }

    .services-demo-body footer {
      display: flex;
      flex-wrap: wrap;
      gap: 14px 22px;
      align-items: center;
      margin-top: 30px;
      padding-top: 22px;
      border-top: 1px solid rgba(255,255,255,0.08);
    }

    .services-demo-body footer span {
      margin-right: auto;
      color: #fff;
      font-family: var(--um-font-mono);
      font-size: 0.72rem;
      font-weight: 700;
      letter-spacing: 0.14em;
      text-transform: uppercase;
    }

    .services-demo-body footer a {
      color: #fff;
      font-weight: 700;
      text-decoration: none;
      border-bottom: 2px solid #dc2626;
      padding-bottom: 3px;
    }

    .services-demo-body footer a::after {
      content: "->";
      margin-left: 8px;
      color: #dc2626;
    }

    .services-demo-closing {
      display: flex;
      justify-content: space-between;
      gap: 24px;
      margin-top: 24px;
      margin-bottom: 72px;
      padding: 32px 40px;
      border: 1px solid rgba(255,255,255,0.1);
      background: #0f0f11;
    }

    .services-demo-closing h2 {
      max-width: 680px;
      margin: 16px 0 0;
      color: #fff;
      font-family: var(--um-font-display);
      font-size: clamp(1.55rem, 3vw, 2.1rem);
      font-weight: var(--um-display-weight);
      letter-spacing: var(--um-display-tracking);
      line-height: 1;
    }

    .services-demo-closing > div:last-child {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 12px;
    }

    .services-demo-closing a {
      display: inline-flex;
      align-items: center;
      min-height: 48px;
      padding: 0 22px;
      background: #dc2626;
      color: #fff;
      font-size: 0.92rem;
      font-weight: 700;
      text-decoration: none;
    }

    .services-demo-closing a + a {
      background: transparent;
      border: 1px solid rgba(255,255,255,0.2);
    }

    @media (max-width: 980px) {
      .services-demo-shell {
        width: min(100% - 28px, 1302px);
      }

      .services-demo-hero {
        min-height: 42vh;
      }

      .services-demo-hero__content {
        padding: 40px 0;
      }

      .services-demo-hero h1 {
        width: min(100%, 800px);
        max-width: 100%;
        font-size: clamp(2rem, 8.5vw, 3rem);
        line-height: 0.95;
        text-wrap: balance;
      }

      .services-demo-row,
      .services-demo-row:nth-child(even) {
        grid-template-columns: 1fr;
      }

      .services-demo-row:nth-child(even) .services-demo-media {
        order: 0;
      }

      .services-demo-media,
      .services-demo-row {
        min-height: 0;
      }

      .services-demo-media {
        min-height: 176px;
      }

      .services-demo-media div {
        background:
          linear-gradient(to top, rgba(10,10,11,0.76), rgba(10,10,11,0.12) 58%, rgba(10,10,11,0.02)),
          linear-gradient(120deg, rgba(220,38,38,0.10), transparent 38%);
      }

      .services-demo-body h2 {
        max-width: 100%;
        font-size: clamp(2.35rem, 11vw, 3.35rem);
      }

      .services-demo-body ul {
        grid-template-columns: 1fr;
      }

      .services-demo-closing {
        display: grid;
        padding: 24px;
      }
    }

    @media (max-width: 640px) {
      .services-demo-list {
        padding: 28px 0 18px;
      }

      .services-demo-row,
      .services-demo-row:nth-child(even) {
        grid-template-columns: minmax(82px, 26vw) minmax(0, 1fr);
        min-height: 0;
        border-top-width: 1px;
      }

      .services-demo-row + .services-demo-row {
        margin-top: 14px;
      }

      .services-demo-row:nth-child(even) .services-demo-media {
        order: 0;
      }

      .services-demo-media {
        min-height: 100%;
      }

      .services-demo-media img {
        transform: none;
      }

      .services-demo-media:hover img,
      .services-demo-media:focus-visible img {
        transform: none;
      }

      .services-demo-media div {
        background:
          linear-gradient(to top, rgba(10,10,11,0.72), rgba(10,10,11,0.18)),
          linear-gradient(120deg, rgba(220,38,38,0.12), transparent 52%);
      }

      .services-demo-media span,
      .services-demo-media em {
        display: none;
      }

      .services-demo-body {
        justify-content: start;
        padding: 20px 18px 18px;
      }

      .services-demo-front {
        gap: 8px;
        font-size: 1rem;
        letter-spacing: 0.12em;
      }

      .services-demo-front span {
        width: 24px;
      }

      .services-demo-body h2 {
        margin-top: 14px;
        font-size: clamp(1.52rem, 6.6vw, 1.92rem);
        line-height: 1;
        word-break: normal;
      }

      .services-demo-body strong {
        margin-top: 10px;
        font-size: 1rem;
        line-height: 1.35;
      }

      .services-demo-body > p {
        display: none;
      }

      .services-demo-body ul {
        display: none;
      }

      .services-demo-body footer {
        gap: 10px 14px;
        margin-top: 14px;
        padding-top: 12px;
      }

      .services-demo-body footer span {
        font-size: 1rem;
        letter-spacing: 0.02em;
      }

      .services-demo-body footer a {
        min-height: 34px;
        display: inline-flex;
        align-items: center;
        padding-bottom: 0;
        border-bottom-width: 1px;
        font-size: 1rem;
      }
    }
  </style>
</LayoutV4>
