---
import Layout from '../../layouts/Layout.astro';
---
<Layout title="Desarrollo de Software | ULTIMA MILLA">
<style>@keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}</style>
<section style="position:relative;min-height:600px;background:linear-gradient(135deg,#8b5cf6 0%,#6d28d9 50%,#0f172a 100%);color:white;overflow:hidden"><div style="position:absolute;top:-100px;left:-100px;width:600px;height:600px;background:radial-gradient(circle,rgba(139,92,246,.2) 0%,transparent 70%);filter:blur(80px)"></div><div style="max-width:1400px;margin:0 auto;padding:140px 40px 80px;position:relative;z-index:10;text-align:center"><div style="display:inline-flex;align-items:center;gap:10px;padding:10px 24px;background:rgba(139,92,246,.15);border:1px solid rgba(139,92,246,.3);border-radius:50px;margin-bottom:32px"><div style="width:8px;height:8px;background:#8b5cf6;border-radius:50%;animation:pulse 2s ease-in-out infinite"></div><span style="font-size:13px;font-weight:700;color:#c4b5fd;text-transform:uppercase;letter-spacing:1.5px">Desarrollo Custom</span></div><h1 style="font-size:clamp(52px,7vw,80px);font-weight:900;line-height:1.05;margin-bottom:32px;letter-spacing:-.03em">Software a Medida para su Negocio</h1><p style="font-size:22px;line-height:1.7;color:#cbd5e1;margin-bottom:48px;max-width:800px;margin-left:auto;margin-right:auto">Soluciones personalizadas que se adaptan perfectamente a sus necesidades</p><a href="#servicios" style="display:inline-flex;align-items:center;gap:12px;padding:20px 40px;background:linear-gradient(135deg,#8b5cf6,#6d28d9);color:white;font-weight:700;font-size:17px;border-radius:12px;text-decoration:none;box-shadow:0 12px 45px rgba(139,92,246,.4)">Ver Servicios<svg style="width:20px;height:20px" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg></a></div></section><section id="servicios" style="background:#0f172a;padding:100px 40px"><div style="max-width:1400px;margin:0 auto"><h2 style="font-size:clamp(40px,5vw,56px);font-weight:900;color:white;margin-bottom:60px;text-align:center">Servicios de Desarrollo</h2><div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(300px,1fr));gap:32px"><div style="background:linear-gradient(135deg,rgba(139,92,246,.1) 0%,rgba(15,23,42,.5) 100%);border:1px solid rgba(139,92,246,.2);border-radius:24px;padding:40px"><div style="width:70px;height:70px;background:rgba(139,92,246,.15);border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:24px"><span style="font-size:32px">🌐</span></div><h3 style="font-size:24px;font-weight:800;color:white;margin-bottom:16px">Desarrollo Web</h3><p style="font-size:16px;color:#94a3b8;line-height:1.7">Sitios y aplicaciones web modernas y responsivas.</p></div><div style="background:linear-gradient(135deg,rgba(139,92,246,.1) 0%,rgba(15,23,42,.5) 100%);border:1px solid rgba(139,92,246,.2);border-radius:24px;padding:40px"><div style="width:70px;height:70px;background:rgba(139,92,246,.15);border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:24px"><span style="font-size:32px">📱</span></div><h3 style="font-size:24px;font-weight:800;color:white;margin-bottom:16px">Aplicaciones Móviles</h3><p style="font-size:16px;color:#94a3b8;line-height:1.7">Apps nativas y multiplataforma para iOS y Android.</p></div><div style="background:linear-gradient(135deg,rgba(139,92,246,.1) 0%,rgba(15,23,42,.5) 100%);border:1px solid rgba(139,92,246,.2);border-radius:24px;padding:40px"><div style="width:70px;height:70px;background:rgba(139,92,246,.15);border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:24px"><span style="font-size:32px">💼</span></div><h3 style="font-size:24px;font-weight:800;color:white;margin-bottom:16px">Software Empresarial</h3><p style="font-size:16px;color:#94a3b8;line-height:1.7">Sistemas de gestión y automatización de procesos.</p></div><div style="background:linear-gradient(135deg,rgba(139,92,246,.1) 0%,rgba(15,23,42,.5) 100%);border:1px solid rgba(139,92,246,.2);border-radius:24px;padding:40px"><div style="width:70px;height:70px;background:rgba(139,92,246,.15);border-radius:50%;display:flex;align-items:center;justify-content:center;margin-bottom:24px"><span style="font-size:32px">🔗</span></div><h3 style="font-size:24px;font-weight:800;color:white;margin-bottom:16px">APIs y Microservicios</h3><p style="font-size:16px;color:#94a3b8;line-height:1.7">Integración y desarrollo de servicios escalables.</p></div></div></div></section><section style="background:linear-gradient(180deg,#0f172a 0%,#1e293b 100%);padding:120px 40px"><div style="max-width:900px;margin:0 auto;text-align:center"><h2 style="font-size:clamp(36px,4vw,48px);font-weight:900;color:white;margin-bottom:24px">Desarrolle su Solución</h2><p style="font-size:18px;color:#94a3b8;margin-bottom:40px">Cotización sin compromiso</p><form action="/api/contact" method="POST" style="max-width:600px;margin:0 auto"><div style="display:grid;gap:20px"><input type="text" name="nombre" placeholder="Nombre" required style="padding:18px 24px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:12px;color:white;font-size:16px"><input type="email" name="email" placeholder="Email" required style="padding:18px 24px;background:rgba(255,255,255,.05);border:1px solid rgba(255,255,255,.1);border-radius:12px;color:white;font-size:16px"><button type="submit" style="padding:20px;background:linear-gradient(135deg,#8b5cf6,#6d28d9);color:white;font-weight:700;font-size:18px;border-radius:12px;border:none;cursor:pointer">Solicitar Cotización</button></div></form></div></section>
</Layout>
