---
// VERSIÓN ALTERNATIVA - SERVICIOS GESTIONADOS
export const prerender = false;
import Layout from '../../../layouts/Layout.astro';
---

<Layout title="Servicios Gestionados - Nueva Estética | ULTIMA MILLA">
  <style>
    @keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.5; } }
    @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-10px); } }
  </style>

  <!-- HERO -->
  <section style="position: relative; min-height: 600px; background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #0f172a 100%); color: white; overflow: hidden;">
    <div style="position: absolute; inset: 0; opacity: 0.03; background-image: radial-gradient(circle, #10b981 1px, transparent 1px); background-size: 40px 40px;"></div>
    <div style="position: absolute; top: -150px; left: 50%; transform: translateX(-50%); width: 800px; height: 800px; background: radial-gradient(circle, rgba(16, 185, 129, 0.15) 0%, transparent 70%); filter: blur(100px);"></div>

    <div style="max-width: 1400px; margin: 0 auto; padding: 120px 40px 80px; position: relative; z-index: 10;">
      <div style="max-width: 900px; margin: 0 auto; text-align: center;">
        <div style="display: inline-flex; align-items: center; gap: 10px; padding: 10px 24px; background: rgba(16, 185, 129, 0.15); border: 1px solid rgba(16, 185, 129, 0.3); border-radius: 50px; margin-bottom: 32px;">
          <div style="width: 8px; height: 8px; background: #10b981; border-radius: 50%; animation: pulse 2s ease-in-out infinite;"></div>
          <span style="font-size: 13px; font-weight: 700; color: #10b981; text-transform: uppercase; letter-spacing: 1.5px;">Gestión IT Completa</span>
        </div>

        <h1 style="font-size: clamp(48px, 6vw, 72px); font-weight: 900; line-height: 1.1; margin-bottom: 28px; letter-spacing: -0.02em;">
          Enfócate en tu Negocio,<br/>Nosotros Gestionamos tu IT
        </h1>

        <p style="font-size: 20px; line-height: 1.7; color: #cbd5e1; margin-bottom: 40px; max-width: 750px; margin-left: auto; margin-right: auto;">
          Servicios gestionados 24/7 con monitoreo proactivo, soporte técnico especializado y optimización continua de tu infraestructura.
        </p>

        <a href="#planes" style="display: inline-flex; align-items: center; gap: 12px; padding: 18px 36px; background: linear-gradient(135deg, #10b981, #059669); color: white; font-weight: 700; font-size: 16px; border-radius: 12px; text-decoration: none; box-shadow: 0 10px 40px rgba(16, 185, 129, 0.3);">
          Ver Planes
          <svg style="width: 20px; height: 20px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6"></path></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- BENEFICIOS -->
  <section style="background: #0f172a; padding: 100px 40px;">
    <div style="max-width: 1400px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 80px;">
        <h2 style="font-size: clamp(40px, 5vw, 56px); font-weight: 900; color: white; margin-bottom: 24px;">
          Ventajas de Nuestros Servicios Gestionados
        </h2>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 28px;">
        <div style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.05) 0%, rgba(15, 23, 42, 0.5) 100%); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 20px; padding: 36px; text-align: center; transition: all 0.3s;">
          <div style="width: 70px; height: 70px; background: rgba(16, 185, 129, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; animation: float 3s ease-in-out infinite;">
            <span style="font-size: 32px;">⏰</span>
          </div>
          <h3 style="font-size: 20px; font-weight: 800; color: white; margin-bottom: 12px;">Monitoreo 24/7</h3>
          <p style="font-size: 15px; color: #94a3b8; line-height: 1.6;">Vigilancia constante de tu infraestructura para detectar y resolver problemas antes de que afecten tu operación.</p>
        </div>

        <div style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.05) 0%, rgba(15, 23, 42, 0.5) 100%); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 20px; padding: 36px; text-align: center; transition: all 0.3s;">
          <div style="width: 70px; height: 70px; background: rgba(16, 185, 129, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; animation: float 3s ease-in-out infinite; animation-delay: 0.5s;">
            <span style="font-size: 32px;">💰</span>
          </div>
          <h3 style="font-size: 20px; font-weight: 800; color: white; margin-bottom: 12px;">Costos Predecibles</h3>
          <p style="font-size: 15px; color: #94a3b8; line-height: 1.6;">Tarifa mensual fija que te permite presupuestar con precisión y evitar gastos inesperados.</p>
        </div>

        <div style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.05) 0%, rgba(15, 23, 42, 0.5) 100%); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 20px; padding: 36px; text-align: center; transition: all 0.3s;">
          <div style="width: 70px; height: 70px; background: rgba(16, 185, 129, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; animation: float 3s ease-in-out infinite; animation-delay: 1s;">
            <span style="font-size: 32px;">👥</span>
          </div>
          <h3 style="font-size: 20px; font-weight: 800; color: white; margin-bottom: 12px;">Equipo Experto</h3>
          <p style="font-size: 15px; color: #94a3b8; line-height: 1.6;">Acceso a especialistas certificados sin los costos de contratar un equipo IT completo.</p>
        </div>

        <div style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.05) 0%, rgba(15, 23, 42, 0.5) 100%); border: 1px solid rgba(16, 185, 129, 0.2); border-radius: 20px; padding: 36px; text-align: center; transition: all 0.3s;">
          <div style="width: 70px; height: 70px; background: rgba(16, 185, 129, 0.1); border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 20px; animation: float 3s ease-in-out infinite; animation-delay: 1.5s;">
            <span style="font-size: 32px;">📈</span>
          </div>
          <h3 style="font-size: 20px; font-weight: 800; color: white; margin-bottom: 12px;">Optimización Continua</h3>
          <p style="font-size: 15px; color: #94a3b8; line-height: 1.6;">Mejora constante de rendimiento, seguridad y eficiencia de tu infraestructura.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- PLANES -->
  <section id="planes" style="background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%); padding: 100px 40px;">
    <div style="max-width: 1400px; margin: 0 auto;">
      <div style="text-align: center; margin-bottom: 80px;">
        <h2 style="font-size: clamp(40px, 5vw, 56px); font-weight: 900; color: white; margin-bottom: 24px;">
          Planes Adaptados a tu Negocio
        </h2>
        <p style="font-size: 20px; color: #94a3b8; max-width: 700px; margin: 0 auto;">
          Elige el nivel de soporte que mejor se ajuste a tus necesidades
        </p>
      </div>

      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(320px, 1fr)); gap: 32px; max-width: 1200px; margin: 0 auto;">
        <!-- Plan Básico -->
        <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 24px; padding: 48px; position: relative;">
          <div style="margin-bottom: 32px;">
            <h3 style="font-size: 28px; font-weight: 900; color: white; margin-bottom: 12px;">Básico</h3>
            <p style="font-size: 15px; color: #94a3b8; margin-bottom: 24px;">Para pequeñas empresas</p>
            <div style="font-size: 48px; font-weight: 900; color: #10b981; margin-bottom: 8px;">$XXX</div>
            <div style="font-size: 14px; color: #94a3b8;">por mes</div>
          </div>
          <ul style="list-style: none; padding: 0; margin: 0 0 32px 0;">
            <li style="padding: 12px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.05); color: #cbd5e1; font-size: 15px;">✓ Monitoreo 8x5</li>
            <li style="padding: 12px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.05); color: #cbd5e1; font-size: 15px;">✓ Soporte por email</li>
            <li style="padding: 12px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.05); color: #cbd5e1; font-size: 15px;">✓ Actualizaciones mensuales</li>
            <li style="padding: 12px 0; color: #cbd5e1; font-size: 15px;">✓ Reportes trimestrales</li>
          </ul>
          <a href="#contacto" style="display: block; text-align: center; padding: 16px; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); color: #10b981; font-weight: 700; border-radius: 10px; text-decoration: none;">
            Seleccionar Plan
          </a>
        </div>

        <!-- Plan Profesional -->
        <div style="background: linear-gradient(135deg, rgba(16, 185, 129, 0.15) 0%, rgba(15, 23, 42, 0.8) 100%); border: 2px solid #10b981; border-radius: 24px; padding: 48px; position: relative; transform: scale(1.05);">
          <div style="position: absolute; top: -16px; right: 24px; padding: 8px 20px; background: linear-gradient(135deg, #10b981, #059669); border-radius: 20px; font-size: 12px; font-weight: 800; color: white;">
            RECOMENDADO
          </div>
          <div style="margin-bottom: 32px;">
            <h3 style="font-size: 28px; font-weight: 900; color: white; margin-bottom: 12px;">Profesional</h3>
            <p style="font-size: 15px; color: #94a3b8; margin-bottom: 24px;">Para empresas en crecimiento</p>
            <div style="font-size: 48px; font-weight: 900; color: #10b981; margin-bottom: 8px;">$XXX</div>
            <div style="font-size: 14px; color: #94a3b8;">por mes</div>
          </div>
          <ul style="list-style: none; padding: 0; margin: 0 0 32px 0;">
            <li style="padding: 12px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.05); color: #cbd5e1; font-size: 15px;">✓ Monitoreo 24/7</li>
            <li style="padding: 12px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.05); color: #cbd5e1; font-size: 15px;">✓ Soporte prioritario</li>
            <li style="padding: 12px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.05); color: #cbd5e1; font-size: 15px;">✓ Actualizaciones semanales</li>
            <li style="padding: 12px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.05); color: #cbd5e1; font-size: 15px;">✓ Reportes mensuales</li>
            <li style="padding: 12px 0; color: #cbd5e1; font-size: 15px;">✓ Gestor dedicado</li>
          </ul>
          <a href="#contacto" style="display: block; text-align: center; padding: 16px; background: linear-gradient(135deg, #10b981, #059669); color: white; font-weight: 700; border-radius: 10px; text-decoration: none; box-shadow: 0 10px 30px rgba(16, 185, 129, 0.3);">
            Seleccionar Plan
          </a>
        </div>

        <!-- Plan Enterprise -->
        <div style="background: rgba(15, 23, 42, 0.6); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 24px; padding: 48px; position: relative;">
          <div style="margin-bottom: 32px;">
            <h3 style="font-size: 28px; font-weight: 900; color: white; margin-bottom: 12px;">Enterprise</h3>
            <p style="font-size: 15px; color: #94a3b8; margin-bottom: 24px;">Para grandes organizaciones</p>
            <div style="font-size: 48px; font-weight: 900; color: #10b981; margin-bottom: 8px;">Custom</div>
            <div style="font-size: 14px; color: #94a3b8;">contactar</div>
          </div>
          <ul style="list-style: none; padding: 0; margin: 0 0 32px 0;">
            <li style="padding: 12px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.05); color: #cbd5e1; font-size: 15px;">✓ Todo de Profesional</li>
            <li style="padding: 12px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.05); color: #cbd5e1; font-size: 15px;">✓ SLA personalizado</li>
            <li style="padding: 12px 0; border-bottom: 1px solid rgba(255, 255, 255, 0.05); color: #cbd5e1; font-size: 15px;">✓ Equipo dedicado</li>
            <li style="padding: 12px 0; color: #cbd5e1; font-size: 15px;">✓ Consultoría estratégica</li>
          </ul>
          <a href="#contacto" style="display: block; text-align: center; padding: 16px; background: rgba(16, 185, 129, 0.1); border: 1px solid rgba(16, 185, 129, 0.3); color: #10b981; font-weight: 700; border-radius: 10px; text-decoration: none;">
            Contactar
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section id="contacto" style="background: #0f172a; padding: 120px 40px; border-top: 1px solid rgba(255, 255, 255, 0.05);">
    <div style="max-width: 900px; margin: 0 auto; text-align: center;">
      <h2 style="font-size: clamp(36px, 4vw, 48px); font-weight: 900; color: white; margin-bottom: 24px;">
        Comienza Hoy Mismo
      </h2>
      <p style="font-size: 18px; color: #94a3b8; margin-bottom: 40px;">
        Agenda una llamada con nuestro equipo para discutir tus necesidades
      </p>

      <form action="/api/contact" method="POST" style="max-width: 600px; margin: 0 auto;">
        <div style="display: grid; gap: 20px;">
          <input type="text" name="nombre" placeholder="Nombre completo" required style="padding: 18px 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; color: white; font-size: 16px;" />
          <input type="email" name="email" placeholder="Email corporativo" required style="padding: 18px 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; color: white; font-size: 16px;" />
          <select name="plan" style="padding: 18px 24px; background: rgba(255, 255, 255, 0.05); border: 1px solid rgba(255, 255, 255, 0.1); border-radius: 12px; color: white; font-size: 16px;">
            <option value="">Selecciona un plan</option>
            <option value="basico">Básico</option>
            <option value="profesional">Profesional</option>
            <option value="enterprise">Enterprise</option>
          </select>
          <button type="submit" style="padding: 20px; background: linear-gradient(135deg, #10b981, #059669); color: white; font-weight: 700; font-size: 18px; border-radius: 12px; border: none; cursor: pointer;">
            Solicitar Información
          </button>
        </div>
      </form>
    </div>
  </section>
</Layout>
