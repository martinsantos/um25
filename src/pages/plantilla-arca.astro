---
/**
 * Plantilla ARCA - Generador de Facturas Electrónicas RG 5824
 *
 * Página interactiva que orquesta todos los componentes para generar
 * facturas electrónicas conforme a la Resolución General 5824 de AFIP
 *
 * Flujo de datos:
 * 1. TemplateManager - Cargar/guardar plantillas
 * 2. FormularioARCA - Ingresar datos de empresa y factura
 * 3. LogoUpload - Subir logo de empresa
 * 4. PDFPreview - Vista previa del PDF
 * 5. EmailInput - Activar envío por email
 * 6. Generación - Llamar API para generar PDF y enviar email
 * 7. ResultadoGeneracion - Mostrar resultado
 */

import LayoutV4 from '@/layouts/LayoutV4.astro';
import FormularioARCA from '@/components/arca/FormularioARCA.astro';
import TemplateManager from '@/components/arca/TemplateManager.astro';
import LogoUpload from '@/components/arca/LogoUpload.astro';
import PDFPreview from '@/components/arca/PDFPreview.astro';
import EmailInput from '@/components/arca/EmailInput.astro';
import ResultadoGeneracion from '@/components/arca/ResultadoGeneracion.astro';
import AfipAuthForm from '@/components/arca/AfipAuthForm.astro';

export const prerender = false; // SSR necesario para manejo de formularios

// Datos para SEO
const title = 'Plantilla ARCA - Generador de Facturas Electrónicas RG 5824';
const description =
  'Generador gratuito de facturas electrónicas conforme a RG 5824. Incluye CAE, QR automático y persistencia en base de datos. Ideal para profesionales, PyMEs y monotributistas.';
const keywords =
  'factura electrónica argentina, RG 5824 AFIP, generador facturas, CAE automático, comprobante fiscal, ARCA sistema, factura online';
---

<LayoutV4
  {title}
  {description}
  {keywords}
  image="/arca-hero.jpg"
  ogType="website"
>
  <main class="arca-page">
    <section class="arca-hero" aria-labelledby="arca-title">
      <div class="arca-container arca-hero-grid">
        <div class="arca-hero-copy">
          <p class="arca-eyebrow">Utilidad fiscal UMSA</p>
          <h1 id="arca-title">Facturación electrónica sin fricción operativa.</h1>
          <p class="arca-lead">
            Generador local para preparar comprobantes electrónicos conforme a RG 5824,
            validar datos y obtener una vista previa clara antes de emitir.
          </p>
          <div class="arca-actions">
            <a href="#formulario" class="arca-btn arca-btn-primary">Usar generador</a>
            <a href="#faq" class="arca-btn arca-btn-secondary">Ver criterios</a>
          </div>
        </div>

        <aside class="arca-hero-proof" aria-label="Capacidades del generador">
          <div>
            <span>01</span>
            <strong>CAE</strong>
            <p>Preparado para emisión con validez fiscal ante ARCA/AFIP.</p>
          </div>
          <div>
            <span>02</span>
            <strong>QR</strong>
            <p>Datos normalizados para comprobantes y trazabilidad documental.</p>
          </div>
          <div>
            <span>03</span>
            <strong>Plantillas</strong>
            <p>Reutilización de datos frecuentes sin exponer complejidad al usuario.</p>
          </div>
        </aside>
      </div>
    </section>

    <section id="formulario" class="arca-workspace">
      <div class="arca-container">
        <div class="arca-section-head">
          <p class="arca-eyebrow">Asistente documental</p>
          <h2>Generador de facturas ARCA RG 5824</h2>
          <p>
            Un flujo de carga, control y vista previa pensado para operar rápido,
            con campos legibles y decisiones explícitas.
          </p>
        </div>

        <div class="arca-grid">
          <div class="arca-main-stack">
            <div class="arca-card">
              <h3>
                <span>01</span> Plantillas guardadas
              </h3>
              <TemplateManager id="template-manager" />
            </div>

            <div class="arca-card">
              <h3>
                <span>02</span> Datos de la factura
              </h3>
              <FormularioARCA id="formulario-arca" />
            </div>

            <div class="arca-card">
              <h3>
                <span>03</span> Logo de empresa
              </h3>
              <LogoUpload id="logo-upload" />
            </div>

            <div class="arca-card">
              <h3>
                <span>04</span> Envío por email
              </h3>
              <EmailInput id="email-input" />
            </div>

            <button
              id="btn-generate"
              type="button"
              class="arca-generate-btn"
            >
              Generar factura
            </button>
          </div>

          <aside class="arca-side-stack">
            <div class="arca-card arca-sticky">
              <h3>
                <span>05</span> Vista previa
              </h3>
              <PDFPreview id="pdf-preview" />
            </div>

            <div class="arca-card">
              <h3>
                <span>06</span> Resultado
              </h3>
              <ResultadoGeneracion id="resultado-generacion" />
            </div>

            <div id="afip-auth-section" class="hidden">
              <AfipAuthForm id="afip-auth-form" />
            </div>
          </aside>
        </div>
      </div>
    </section>

    <section id="faq" class="arca-faq">
      <div class="arca-container arca-faq-grid">
        <div class="arca-section-head">
          <p class="arca-eyebrow">Criterios de uso</p>
          <h2>Preguntas frecuentes</h2>
          <p>Información esencial para usar el generador sin ruido administrativo.</p>
        </div>

        <div class="arca-faq-list">
          <details class="arca-detail">
            <summary>
              <span>¿Qué es la Resolución General 5824 de AFIP?</span>
              <span>+</span>
            </summary>
            <p>
              La RG 5824 obliga a todos los responsables inscritos, monotributistas y
              profesionales a emitir comprobantes electrónicos. Esta normativa asegura la
              trazabilidad de las operaciones y evita evasión fiscal.
            </p>
          </details>

          <details class="arca-detail">
            <summary>
              <span>¿Cómo obtengo el CAE (Código de Autorización Electrónica)?</span>
              <span>+</span>
            </summary>
            <p>
              El CAE se solicita a AFIP a través de sus web services. Nuestro sistema lo
              obtiene automáticamente usando tus datos CUIT y contraseña. El CAE es válido
              por 30 días desde su emisión.
            </p>
          </details>

          <details class="arca-detail">
            <summary>
              <span>¿Qué datos debo ingresar?</span>
              <span>+</span>
            </summary>
            <p>
              Necesitas datos de empresa: CUIT (11 dígitos), Razón Social, Domicilio,
              Condición IVA. Y datos de factura: Tipo, Fecha, Descripción e Importe.
            </p>
          </details>

          <details class="arca-detail">
            <summary>
              <span>¿Puedo guardar mis datos para usar nuevamente?</span>
              <span>+</span>
            </summary>
            <p>
              Sí, el sistema permite guardar plantillas con tus datos de empresa. Puedes
              crear múltiples plantillas para diferentes empresas o condiciones IVA, y
              reutilizarlas en futuras facturas.
            </p>
          </details>

          <details class="arca-detail">
            <summary>
              <span>¿Los datos están seguros?</span>
              <span>+</span>
            </summary>
            <p>
              Usamos conexiones HTTPS encriptadas. Los datos de plantillas se guardan
              localmente en tu navegador. Las contraseñas nunca se almacenan.
            </p>
          </details>

          <details class="arca-detail">
            <summary>
              <span>¿Puedo enviar la factura por email?</span>
              <span>+</span>
            </summary>
            <p>
              Sí, una vez generada la factura puedes enviarla por email. Solo activa la
              opción "Enviar por email" e ingresa el correo del cliente. El PDF se
              adjuntará automáticamente.
            </p>
          </details>

          <details class="arca-detail">
            <summary>
              <span>¿Dónde se guardan mis facturas?</span>
              <span>+</span>
            </summary>
            <p>
              Todas las facturas generadas se guardan en nuestra base de datos y están
              disponibles desde tu cuenta. También puedes descargar el PDF en tu
              computadora.
            </p>
          </details>

          <details class="arca-detail">
            <summary>
              <span>¿Es gratuito?</span>
              <span>+</span>
            </summary>
            <p>
              Sí, el generador es completamente gratuito. No cobramos por la generación de
              facturas, el CAE automático, ni el almacenamiento. Es una herramienta gratuita
              de ULTIMA MILLA para profesionales y PyMEs argentinas.
            </p>
          </details>
        </div>
      </div>
    </section>

    <section class="arca-final-cta">
      <div class="arca-container arca-final-grid">
        <div>
          <p class="arca-eyebrow">Operación documental</p>
          <h2>Generá, revisá y continuá.</h2>
          <p>
            La herramienta queda como utilidad pública UMSA: sobria, directa y separada
            de la experiencia comercial principal.
          </p>
        </div>
        <div class="arca-actions">
          <a href="#formulario" class="arca-btn arca-btn-primary">Generar factura</a>
          <a href="/contacto" class="arca-btn arca-btn-secondary">Hablar con UMSA</a>
        </div>
      </div>
    </section>
  </main>

  <!-- ====================================================================
       ORCHESTRATION SCRIPT - Manejo de flujo completo
       ==================================================================== -->
  <script is:inline>

    // Escala global para datos
    window.lastFormData = null;
    window.currentLogoUrl = null;

    // Escuchar cambios en el formulario
    document.addEventListener('formDataChange', (event) => {
      window.lastFormData = event.detail;
      console.log('Datos del formulario:', window.lastFormData);
    });

    // Escuchar cambios en el logo
    document.addEventListener('logoChanged', (event) => {
      window.currentLogoUrl = event.detail?.logoUrl || null;
      console.log('Logo actualizado:', window.currentLogoUrl);
    });

    // Función para obtener email
    window.getEmailToSend = () => {
      const emailInput = document.querySelector('#email-input input[type="email"]');
      const emailToggle = document.querySelector('#email-input input[type="checkbox"]');
      if (emailToggle?.checked && emailInput?.value) {
        return emailInput.value;
      }
      return null;
    };


    // Event listener para botón de generación
    var btnGenerate = document.getElementById('btn-generate');
    if (btnGenerate) {
      btnGenerate.addEventListener('click', async function() {
        // Validate form first
        if (window.validarFormularioARCA) {
          var errores = window.validarFormularioARCA();
          if (errores.length > 0) {
            window.mostrarErroresFormulario(errores);
            return;
          }
        }

        // Leer datos directamente del formulario (no depender de eventos change)
        var form = document.querySelector('#formulario-arca');
        if (!form) {
          window.showResult('error', 'Formulario no encontrado');
          return;
        }
        var formData = new FormData(form);
        window.lastFormData = Object.fromEntries(formData);

        btnGenerate.disabled = true;

        var hasAfipAuth = !!(window.afipAuthToken || sessionStorage.getItem('afip_token'));

        if (hasAfipAuth) {
          // Real CAE generation
          btnGenerate.textContent = 'Generando factura con validez fiscal...';
          var token = window.afipAuthToken || sessionStorage.getItem('afip_token');

          try {
            var response = await fetch('/plantilla-arca/api/facturar/cae', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              body: JSON.stringify({
                ...window.lastFormData,
                token: token,
                logo_url: window.currentLogoUrl || null,
              }),
            });

            if (!response.ok) {
              var err = await response.json().catch(function() { return { error: 'Error al generar factura' }; });
              window.showResult('error', err.error || 'Error al generar factura ante AFIP');
              btnGenerate.textContent = 'Facturar ante AFIP';
              btnGenerate.disabled = false;
              return;
            }

            var result = await response.json();
            window.showResult('success', 'Factura generada con validez fiscal', result.pdf_url, !!window.getEmailToSend?.(), {
              cae: result.cae,
              vencimiento: result.vencimiento,
            });
            if (window.setCae) window.setCae(result.cae, result.vencimiento);
            btnGenerate.textContent = 'Facturado ante AFIP';
            btnGenerate.disabled = true;
          } catch (_err) {
            window.showResult('error', 'Error de conexion al generar factura');
            btnGenerate.textContent = 'Facturar ante AFIP';
            btnGenerate.disabled = false;
          }
        } else {
          // Simulated mode — show preview
          btnGenerate.textContent = 'Preparando vista previa...';
          var previewEvent = new CustomEvent('showPDFPreview', {
            detail: { data: window.lastFormData },
            bubbles: true,
          });
          document.dispatchEvent(previewEvent);
          btnGenerate.textContent = 'Generar Factura';
          btnGenerate.disabled = false;
        }
      });
    }

    // Escuchar evento de CTA para conectar con AFIP
    document.addEventListener('afipAuthRequested', function() {
      var resultContainer = document.getElementById('resultado-generacion');
      if (resultContainer) resultContainer.classList.add('hidden');

      var authSection = document.querySelector('#afip-auth-section');
      if (authSection) {
        authSection.classList.remove('hidden');
        authSection.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });

    // Manejar autenticacion exitosa con AFIP
    document.addEventListener('afipAuthSuccess', function(e) {
      var detail = e.detail || {};
      window.afipAuthToken = detail.token;
      window.afipAuthMethod = detail.method;

      var authSection = document.querySelector('#afip-auth-section');
      if (authSection) {
        while (authSection.firstChild) authSection.removeChild(authSection.firstChild);

        var wrapper = document.createElement('div');
        wrapper.className = 'bg-green-50 border border-green-200 rounded-lg p-6 text-center';

        var checkEl = document.createElement('div');
        checkEl.className = 'arca-status-mark';
        checkEl.textContent = 'OK';
        wrapper.appendChild(checkEl);

        var title = document.createElement('h3');
        title.className = 'text-lg font-bold text-green-800 mb-2';
        title.textContent = 'Conectado a AFIP';
        wrapper.appendChild(title);

        var msg = document.createElement('p');
        msg.className = 'text-base text-green-700 mb-4';
        msg.textContent = 'Autenticacion exitosa. Ya podes generar facturas con validez fiscal.';
        wrapper.appendChild(msg);

        var expiryP = document.createElement('p');
        expiryP.className = 'text-base text-green-600';
        var expiryDate = detail.expiry ? new Date(detail.expiry).toLocaleString('es-AR') : '--';
        expiryP.textContent = 'Token valido hasta: ' + expiryDate;
        wrapper.appendChild(expiryP);

        var btnGroup = document.createElement('div');
        btnGroup.style.display = 'flex';
        btnGroup.style.gap = '8px';
        btnGroup.style.justifyContent = 'center';
        btnGroup.className = 'mt-4';

        var disconnectBtn = document.createElement('button');
        disconnectBtn.id = 'afip-disconnect';
        disconnectBtn.className = 'px-4 py-2 text-base bg-gray-200 text-gray-700 rounded-md hover:bg-gray-300';
        disconnectBtn.textContent = 'Desconectar';
        btnGroup.appendChild(disconnectBtn);

        var backBtn = document.createElement('button');
        backBtn.id = 'afip-show-form';
        backBtn.className = 'px-4 py-2 text-base bg-indigo-600 text-white rounded-md hover:bg-indigo-700';
        backBtn.textContent = 'Volver al formulario';
        btnGroup.appendChild(backBtn);

        wrapper.appendChild(btnGroup);
        authSection.appendChild(wrapper);

        disconnectBtn.addEventListener('click', function() {
          window.afipAuthToken = null;
          window.afipAuthMethod = null;
          sessionStorage.removeItem('afip_token');
          sessionStorage.removeItem('afip_token_expiry');
          location.reload();
        });

        backBtn.addEventListener('click', function() {
          authSection.classList.add('hidden');
          var formSection = document.querySelector('#formulario');
          if (formSection) formSection.scrollIntoView({ behavior: 'smooth' });
        });
      }

      // Update generate button
      var btn = document.getElementById('btn-generate');
      if (btn) {
        btn.textContent = 'Facturar ante AFIP';
        btn.className = 'arca-generate-btn arca-generate-btn-ready';
        btn.style.display = 'flex';
        btn.style.alignItems = 'center';
        btn.style.justifyContent = 'center';
      }
    });

    // Restore AFIP session from sessionStorage
    (function() {
      var token = sessionStorage.getItem('afip_token');
      if (token) {
        window.afipAuthToken = token;
        var event = new CustomEvent('afipAuthSuccess', {
          detail: {
            token: token,
            expiry: sessionStorage.getItem('afip_token_expiry') || null,
          },
          bubbles: true,
        });
        document.dispatchEvent(event);
      }
    })();
  </script>

  <style is:global>
    .arca-page {
      background: #ffffff;
      color: #111111;
      font-family: var(--um-font-body);
    }

    .arca-container {
      width: min(1180px, calc(100vw - 32px));
      margin: 0 auto;
    }

    .arca-hero {
      padding: clamp(92px, 12vw, 150px) 0 clamp(56px, 8vw, 92px);
      border-bottom: 1px solid var(--skin-line);
      background:
        linear-gradient(90deg, rgba(255,255,255,0.98), rgba(255,255,255,0.86) 54%, rgba(255,255,255,0.32)),
        url('/images/hero/portada-software.jpg') center / cover;
    }

    .arca-hero-grid,
    .arca-final-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(320px, 430px);
      gap: clamp(32px, 6vw, 80px);
      align-items: end;
    }

    .arca-eyebrow {
      display: inline-flex;
      align-items: center;
      gap: 12px;
      margin-bottom: 18px;
      color: var(--um-red);
      font-size: 1rem;
      font-weight: 700;
      line-height: 1.2;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    .arca-eyebrow::after {
      content: "";
      width: 40px;
      height: 2px;
      background: var(--um-red);
    }

    .arca-hero h1,
    .arca-section-head h2,
    .arca-final-cta h2 {
      font-family: var(--um-font-display);
      font-weight: 600;
      letter-spacing: 0;
      color: #111111;
    }

    .arca-hero h1 {
      max-width: 820px;
      font-size: clamp(2.25rem, 4.7vw, 3.75rem);
      line-height: 1.04;
    }

    .arca-lead {
      max-width: 680px;
      margin-top: 22px;
      color: #444b52;
      font-size: clamp(1.08rem, 1.25vw, 1.24rem);
      line-height: 1.65;
    }

    .arca-actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 30px;
    }

    .arca-btn,
    .arca-page button,
    .arca-page input::file-selector-button {
      min-height: 48px;
      border-radius: 4px;
      font-size: 1rem;
      font-weight: 700;
      line-height: 1.1;
      transition: background 160ms ease, color 160ms ease, border-color 160ms ease;
    }

    .arca-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 15px 22px;
      border: 1px solid #111111;
    }

    .arca-btn-primary,
    .arca-generate-btn,
    .arca-page .bg-blue-600,
    .arca-page .bg-indigo-600,
    .arca-page .bg-green-600 {
      background: var(--um-red) !important;
      color: #ffffff !important;
      border-color: var(--um-red) !important;
      background-image: none !important;
      box-shadow: none !important;
    }

    .arca-btn-primary:hover,
    .arca-generate-btn:hover,
    .arca-page .bg-blue-600:hover,
    .arca-page .bg-indigo-600:hover,
    .arca-page .bg-green-600:hover {
      background: #111111 !important;
      border-color: #111111 !important;
      color: #ffffff !important;
    }

    .arca-btn-secondary {
      background: rgba(255,255,255,0.78);
      color: #111111;
      border-color: #BFC4CA;
    }

    .arca-page #save-template-btn,
    .arca-page #delete-template-btn,
    .arca-page #cancel-save,
    .arca-page #new-invoice-btn,
    .arca-page #afip-cta-no,
    .arca-page #afip-disconnect {
      border: 1px solid #C8CDD2 !important;
      background: #ffffff !important;
      color: #111111 !important;
    }

    .arca-page #confirm-save,
    .arca-page #download-pdf-btn,
    .arca-page #afip-cta-yes,
    .arca-page #afip-show-form {
      border: 1px solid #111111 !important;
      background: #111111 !important;
      color: #ffffff !important;
      box-shadow: none !important;
    }

    .arca-hero-proof {
      display: grid;
      border: 1px solid #DADDE1;
      background: rgba(255,255,255,0.86);
      backdrop-filter: blur(10px);
    }

    .arca-hero-proof div {
      padding: 22px;
      border-bottom: 1px solid #DADDE1;
    }

    .arca-hero-proof div:last-child {
      border-bottom: 0;
    }

    .arca-hero-proof span,
    .arca-card h3 span {
      color: var(--um-red);
      font-size: 1rem;
      font-weight: 700;
      line-height: 1;
    }

    .arca-hero-proof strong {
      display: block;
      margin-top: 10px;
      color: #111111;
      font-family: var(--um-font-display);
      font-size: 1.3rem;
      font-weight: 600;
      line-height: 1.2;
    }

    .arca-hero-proof p {
      margin-top: 8px;
      color: #555d66;
      font-size: 1rem;
      line-height: 1.55;
    }

    .arca-workspace,
    .arca-faq,
    .arca-final-cta {
      padding: clamp(64px, 9vw, 112px) 0;
    }

    .arca-workspace {
      background: #F5F6F7;
    }

    .arca-section-head {
      display: grid;
      grid-template-columns: minmax(0, 0.85fr) minmax(300px, 0.55fr);
      column-gap: clamp(28px, 5vw, 72px);
      row-gap: 16px;
      align-items: end;
      margin-bottom: 34px;
      padding-top: 22px;
      border-top: 1px solid #111111;
    }

    .arca-section-head .arca-eyebrow {
      grid-column: 1 / -1;
      margin-bottom: 0;
    }

    .arca-section-head h2,
    .arca-final-cta h2 {
      font-size: clamp(1.85rem, 3vw, 2.65rem);
      line-height: 1.08;
    }

    .arca-section-head p,
    .arca-final-cta p {
      color: #555d66;
      font-size: 1.05rem;
      line-height: 1.65;
    }

    .arca-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(320px, 390px);
      gap: 24px;
      align-items: start;
    }

    .arca-main-stack,
    .arca-side-stack,
    .arca-faq-list {
      display: grid;
      gap: 16px;
    }

    .arca-card,
    .arca-detail,
    .arca-page dialog {
      border: 1px solid #DADDE1 !important;
      border-radius: 4px !important;
      background: #ffffff !important;
      box-shadow: none !important;
    }

    .arca-card {
      padding: clamp(20px, 2.4vw, 30px);
    }

    .arca-card h3 {
      display: flex;
      align-items: center;
      gap: 12px;
