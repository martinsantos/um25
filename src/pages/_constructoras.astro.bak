---
/**
 * Constructoras Sector Page - V4 Design System
 * Construction sector landing page with V4 components
 */

import LayoutV4 from '../layouts/LayoutV4.astro';
import HeroPageV4 from '../components/v4/HeroPageV4.astro';
import { generateSlug } from '../utils/slugUtils.js';
import { antecedentesReales } from '../data/antecedentes_completos.js';

// Sector configuration
const sectorConfig = {
  name: 'Constructoras',
  emoji: '🏗️',
  heroImage: 'https://images.unsplash.com/photo-1541888946425-d81bb19240f5?w=1920&q=80',
  description: 'Soluciones tecnológicas integrales para proyectos de construcción: conectividad temporal, cableado estructurado, seguridad CCTV y telecomunicaciones para canteros.',
  keywords: [
    'construccion', 'constructora', 'obras', 'ingenier', 'urbaniz',
    'edificio', 'torre', 'complejo', 'shopping', 'centro comercial',
    'procon', 'impsa', 'tecnigas', 'cartellone', 'benito roggio',
    'infraestructura', 'vial', 'puente', 'tuneles', 'pavimento',
    'housing', 'barrio', 'loteo', 'country', 'desarrollo',
    'hotel', 'apart', 'spa', 'casino', 'resort',
    'laugero', 'kristich', 'monteverdi', 'ceosa', 'green'
  ],
};

// SEO configuration
const seoConfig = {
  title: `Servicios IT para ${sectorConfig.name} | Mendoza, Cuyo y Patagonia | ULTIMA MILLA`,
  description: sectorConfig.description,
  keywords: 'servicios tecnologicos constructoras, infraestructura it obras mendoza, conectividad temporal canteros cuyo, cableado estructurado construccion patagonia',
};

// Filter antecedentes for this sector
const filterAntecedentes = (data: any[]) => {
  return data
    .filter(item => {
      const texto = `${item.Cliente} ${item.Titulo} ${item.Area} ${item.Descripcion}`.toLowerCase();
      return sectorConfig.keywords.some(k => texto.includes(k));
    })
    .map(item => ({ ...item, slug: generateSlug(item.Titulo) }))
    .slice(0, 12);
};

// Try Directus first, fallback to local data
let antecedentes: any[] = [];
const DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL || 'https://admin.ultimamilla.com.ar';

try {
  const response = await fetch(`${DIRECTUS_URL}/items/antecedentes?limit=500`, {
    headers: { 'Authorization': `Bearer ${import.meta.env.DIRECTUS_TOKEN || ''}` }
  });
  if (response.ok) {
    const data = await response.json();
    if (data?.data?.length > 0) {
      antecedentes = filterAntecedentes(data.data);
    }
  }
} catch (e) {
  console.log('Using local data for Constructoras');
}

if (antecedentes.length === 0) {
  antecedentes = filterAntecedentes(antecedentesReales);
}

// Helper function for image URLs
const getImageUrl = (ant: any): string => {
  if (ant.Imagen && typeof ant.Imagen === 'string' && ant.Imagen.includes('-')) {
    return `${DIRECTUS_URL}/assets/${ant.Imagen}`;
  }
  if (ant.ImagenPrincipal && typeof ant.ImagenPrincipal === 'string' && ant.ImagenPrincipal.includes('-')) {
    return `${DIRECTUS_URL}/assets/${ant.ImagenPrincipal}`;
  }
  return '/images/default-antecedente.jpg';
};

// Value propositions for this sector
const valueProps = [
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-4m-5 0H9m0 0H5m4 0V9a1 1 0 011-1h4a1 1 0 011 1v12M9 7h6"></path></svg>`,
    title: 'Proyectos a Gran Escala',
    description: 'Gestionamos proyectos complejos con precisión y eficiencia.',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>`,
    title: 'Innovación Tecnológica',
    description: 'Implementamos las últimas tecnologías para optimizar cada fase.',
  },
  {
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path></svg>`,
    title: 'Seguridad y Certificación',
    description: 'Cumplimiento riguroso de normativas y estándares de seguridad.',
  },
];

// Related services
const serviciosRelacionados = [
  { id: 1, nombre: 'Cableado Estructurado', descripcion: 'Infraestructura de redes para obras', icon: 'network' },
  { id: 2, nombre: 'Seguridad y CCTV', descripcion: 'Protección integral para canteros', icon: 'shield' },
  { id: 3, nombre: 'Conectividad Temporal', descripcion: 'Enlaces para obras en construcción', icon: 'wifi' },
  { id: 4, nombre: 'Telefonía IP', descripcion: 'Comunicaciones profesionales', icon: 'phone' },
  { id: 5, nombre: 'Detección de Incendio', descripcion: 'Sistemas de alarma certificados', icon: 'alert' },
  { id: 6, nombre: 'Soporte Técnico 24/7', descripcion: 'Asistencia continua para operaciones', icon: 'support' },
];
---

<LayoutV4
  title={seoConfig.title}
  description={seoConfig.description}
  keywords={seoConfig.keywords}
>
  <HeroPageV4
    title="Construyendo el Mañana"
    titleHighlight="con Tecnología y Precisión"
    subtitle={sectorConfig.description}
    breadcrumb={[
      { label: 'Inicio', href: '/' },
      { label: 'Sectores', href: '/sectores' },
      { label: sectorConfig.name, href: '/constructoras' },
    ]}
    badge={{ icon: 'building', text: `Sector ${sectorConfig.name}` }}
    stats={[
      { value: `${antecedentes.length}+`, label: 'Proyectos' },
      { value: '15+', label: 'Años' },
      { value: '100%', label: 'Satisfacción' },
    ]}
  />

  <!-- Value Propositions -->
  <section class="py-12 sm:py-16 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6 lg:gap-8">
        {valueProps.map((prop) => (
          <div class="text-center p-6 sm:p-8 bg-um-gray-light rounded-xl">
            <div class="w-16 h-16 sm:w-20 sm:h-20 mx-auto mb-4 sm:mb-6 bg-white rounded-full flex items-center justify-center border-2 border-gray-200 text-um-dark">
              <Fragment set:html={prop.icon} />
            </div>
            <h3 class="text-lg sm:text-xl font-bold text-um-dark mb-2 sm:mb-3">{prop.title}</h3>
            <p class="text-sm sm:text-base text-um-gray leading-relaxed">{prop.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Services Grid -->
  <section class="py-12 sm:py-16 lg:py-20 bg-um-gray-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-10 sm:mb-12">
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-um-dark mb-3 sm:mb-4">Servicios para Construcción</h2>
        <p class="text-base sm:text-lg text-um-gray max-w-2xl mx-auto">
          Soluciones tecnológicas diseñadas para optimizar cada fase del proyecto de construcción.
        </p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6">
        {serviciosRelacionados.map((servicio) => (
          <a href={`/servicios/${servicio.id}/${servicio.nombre.toLowerCase().replace(/\s+/g, '-')}`} class="group block">
            <div class="bg-white p-5 sm:p-6 rounded-xl border-l-4 border-orange-500 shadow-sm hover:shadow-md transition-all duration-300 group-hover:-translate-y-1 min-h-[120px]">
              <div class="w-10 h-10 sm:w-12 sm:h-12 bg-orange-500 rounded-lg flex items-center justify-center mb-3 sm:mb-4">
                <svg class="w-5 h-5 sm:w-6 sm:h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
                </svg>
              </div>
              <h3 class="text-base sm:text-lg font-bold text-um-dark mb-2 group-hover:text-orange-600 transition-colors">{servicio.nombre}</h3>
              <p class="text-sm text-um-gray">{servicio.descripcion}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Cases Grid -->
  {antecedentes.length > 0 && (
    <section class="py-12 sm:py-16 lg:py-20 bg-white">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-10 sm:mb-12">
          <span class="inline-block px-4 py-1.5 bg-orange-100 text-orange-700 text-xs sm:text-sm font-bold rounded-full mb-3 sm:mb-4">
            Casos de Éxito
          </span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-um-dark mb-3 sm:mb-4">Proyectos en Construcción</h2>
          <p class="text-base sm:text-lg text-um-gray max-w-2xl mx-auto">
            Experiencia comprobada en proyectos de infraestructura tecnológica para el sector.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8">
          {antecedentes.slice(0, 6).map((ant) => (
            <a href={`/antecedentes/${ant.id}/${ant.slug}`} class="group block">
              <article class="bg-white rounded-xl overflow-hidden shadow-sm border border-gray-100 hover:shadow-lg transition-all duration-300 group-hover:-translate-y-1">
                <div class="relative aspect-[16/10] overflow-hidden bg-gray-100">
                  <img
                    src={getImageUrl(ant)}
                    alt={ant.Titulo}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading="lazy"
                    onerror="this.src='/images/default-antecedente.jpg'"
                  />
                  <div class="absolute top-3 left-3">
                    <span class="inline-flex items-center gap-1.5 px-2.5 py-1 bg-orange-500 text-white text-xs font-bold rounded-lg">
                      {sectorConfig.emoji} {sectorConfig.name}
                    </span>
                  </div>
                </div>
                <div class="p-4 sm:p-5">
                  <h3 class="text-base sm:text-lg font-bold text-um-dark mb-2 line-clamp-2 group-hover:text-orange-600 transition-colors">
                    {ant.Titulo}
                  </h3>
                  {ant.Cliente && (
                    <p class="text-sm text-um-gray mb-2">{ant.Cliente}</p>
                  )}
                  <p class="text-sm text-um-gray line-clamp-2">
                    {ant.Descripcion?.substring(0, 100)}...
                  </p>
                </div>
              </article>
            </a>
          ))}
        </div>

        {antecedentes.length > 6 && (
          <div class="text-center mt-8 sm:mt-10">
            <a
              href="/antecedentes?sector=constructoras"
              class="inline-flex items-center gap-2 px-6 sm:px-8 py-3 sm:py-4 bg-um-dark text-white font-bold rounded-xl hover:bg-um-dark/90 transition-colors min-h-[44px]"
            >
              Ver todos los proyectos
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
              </svg>
            </a>
          </div>
        )}
      </div>
    </section>
  )}

  <!-- CTA Section -->
  <section class="bg-um-dark py-12 sm:py-16 lg:py-20">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white mb-3 sm:mb-4">¿Tiene un Proyecto de Construcción?</h2>
      <p class="text-base sm:text-lg lg:text-xl text-gray-300 mb-6 sm:mb-8">
        Contáctenos para diseñar la solución tecnológica perfecta para su obra
      </p>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
        <a
          href="/contacto"
          class="px-6 sm:px-8 py-3 sm:py-4 bg-orange-500 text-white font-bold rounded-xl hover:bg-orange-600 transition-colors shadow-lg min-h-[44px] flex items-center justify-center"
        >
          Solicitar Cotización
        </a>
        <a
          href="/servicios"
          class="px-6 sm:px-8 py-3 sm:py-4 border-2 border-white text-white font-bold rounded-xl hover:bg-white/10 transition-colors min-h-[44px] flex items-center justify-center"
        >
          Ver Servicios
        </a>
      </div>
    </div>
  </section>
</LayoutV4>
