---
import LayoutV4 from '../../layouts/LayoutV4.astro';
import BlogCategoryTabs from '../../components/blog/BlogCategoryTabs.astro';
import BlogFeedItem from '../../components/blog/BlogFeedItem.astro';
import BlogHero from '../../components/blog/BlogHero.astro';
import BlogPagination from '../../components/blog/BlogPagination.astro';
import SectionHeader from '../../components/um/SectionHeader.astro';
import IntentLinkGraph from '../../components/um/IntentLinkGraph.astro';
import { fetchBlogListing } from '../../utils/getBlogData';
import { resolveReplicaH1 } from '../../utils/replicaProdCopy';
import { getAntecedentesCountExactPhrase } from '../../utils/verifiedProof';
import {
  buildBlogStrategicLinkGroups,
  buildStrategicWebPageStructuredData,
} from '../../data/strategicLinkGraph';

const blogIndexH1 = resolveReplicaH1('/blog', 'Ideas técnicas para decidir mejor');

const PAGE_SIZE = 10;
const page = Number(Astro.url.searchParams.get('page') || '1');
const { posts, total } = await fetchBlogListing(page, PAGE_SIZE);
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const featuredPost = page === 1 ? posts[0] : null;
const archivePosts = featuredPost ? posts.slice(1) : posts;

const siteUrl = 'https://www.ultimamilla.com.ar';
const canonicalUrl = page === 1 ? `${siteUrl}/blog` : `${siteUrl}/blog?page=${page}`;
const prevUrl = page > 1 ? (page === 2 ? `${siteUrl}/blog` : `${siteUrl}/blog?page=${page - 1}`) : null;
const nextUrl = page < totalPages ? `${siteUrl}/blog?page=${page + 1}` : null;
const blogStrategicLinkGroups = buildBlogStrategicLinkGroups({
  currentPath: '/blog',
  title: blogIndexH1,
  summary: 'Lecturas técnicas para decidir infraestructura, continuidad, seguridad, software y operación IT.',
  text: posts.map((post) => `${post.titulo} ${post.resumen} ${post.categoria} ${(post.tags || []).join(' ')}`).join(' '),
  relatedPosts: posts.slice(0, 4),
});
const blogSignificantLinks = [
  `${siteUrl}/servicios`,
  `${siteUrl}/sectores`,
  `${siteUrl}/antecedentes`,
  `${siteUrl}/contacto`,
  ...posts.slice(0, 6).map((post) => `${siteUrl}/blog/${post.slug}`),
];

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${siteUrl}/blog`,
  name: 'Blog ULTIMA MILLA',
  url: `${siteUrl}/blog`,
  description: 'Noticias, proyectos y artículos técnicos sobre infraestructura IT, seguridad electrónica y telecomunicaciones en Argentina.',
  inLanguage: 'es-AR',
  significantLink: blogSignificantLinks,
  publisher: {
    '@type': 'Organization',
    name: 'ULTIMA MILLA',
    url: siteUrl,
    logo: { '@type': 'ImageObject', url: `${siteUrl}/images/um-logo.png` },
  },
  blogPost: posts.map(p => ({
    '@type': 'BlogPosting',
    '@id': `${siteUrl}/blog/${p.slug}#article`,
    headline: p.titulo,
    datePublished: p.fecha_publicacion,
    url: `${siteUrl}/blog/${p.slug}`,
  })),
};
const blogPageStructuredData = [
  schema,
  buildStrategicWebPageStructuredData({
    url: `${siteUrl}/blog`,
    name: blogIndexH1,
    description: 'Lecturas técnicas para decidir infraestructura, continuidad, seguridad, software y operación IT.',
    groups: blogStrategicLinkGroups,
  }),
];
---

<LayoutV4
  title="Ideas técnicas para decidir mejor | ULTIMA MILLA"
  description="Artículos técnicos, casos de éxito y novedades sobre infraestructura IT, telecomunicaciones, seguridad electrónica y software para empresas en Argentina."
  canonical={canonicalUrl}
  structuredData={blogPageStructuredData}
>
  {prevUrl && <link slot="head" rel="prev" href={prevUrl} />}
  {nextUrl && <link slot="head" rel="next" href={nextUrl} />}

  <section class="blog-index">
    <div class="blog-container">

      <header class="blog-header">
        <div class="blog-header__copy">
          <nav class="blog-breadcrumb" aria-label="Navegación">
            <a href="/" class="bc-link">ULTIMA MILLA</a>
            <span class="bc-sep">/</span>
            <span class="bc-current">Blog</span>
          </nav>
          <span class="blog-rule" aria-hidden="true"></span>
          <h1 class="blog-title">{blogIndexH1}</h1>
          <p class="blog-subtitle">
            Lecturas para decidir infraestructura, continuidad, seguridad, software y operación IT con evidencia concreta.
          </p>
          <dl class="blog-proofline" aria-label="Prueba institucional">
            <div><dt>Archivo</dt><dd>{getAntecedentesCountExactPhrase()}</dd></div>
            <div><dt>Trayectoria</dt><dd>22+ años</dd></div>
            <div><dt>Operación</dt><dd>Soporte 24/7</dd></div>
          </dl>
        </div>

      </header>

      <BlogCategoryTabs />

      {featuredPost && (
        <section class="blog-featured" aria-label="Nota destacada">
          <BlogHero post={featuredPost} />
        </section>
      )}

      {archivePosts.length > 0 && (
        <section class="blog-archive" aria-label="Archivo técnico">
          <SectionHeader
            class="archive-head"
            title={featuredPost ? 'Archivo técnico' : 'Últimas notas'}
            text="Lecturas ordenadas por fecha y contexto para evaluar riesgos, alcance y decisiones técnicas sin ruido promocional."
          />
          <div class="feed">
            {archivePosts.map((post, idx) => <BlogFeedItem post={post} index={(featuredPost ? idx + 2 : idx + 1)} />)}
          </div>
        </section>
      )}

      {posts.length === 0 && (
        <div class="empty-state">
          <strong>Archivo editorial en preparación</strong>
          <div>
            <p>Mientras tanto, podés revisar antecedentes técnicos reales y servicios relacionados con continuidad operativa.</p>
            <a href="/antecedentes">Ver antecedentes</a>
          </div>
        </div>
      )}

      <BlogPagination page={page} totalPages={totalPages} baseHref="/blog" />

      <IntentLinkGraph
        class="um-intent-link-graph--contained"
        kicker="Para avanzar"
        title="Ver también"
        text="Pasá de una nota a servicios relacionados, sectores donde aplica o lecturas cercanas."
        groups={blogStrategicLinkGroups}
      />

    </div>
  </section>
</LayoutV4>

<style>
  .blog-index {
    min-height: 100vh;
    background: var(--skin-section);
    padding: 0 0 112px;
    overflow-x: clip;
  }

  .blog-container {
    width: min(100%, 1120px);
    max-width: 1120px;
    margin: 0 auto;
    padding-inline: clamp(16px, 3vw, 24px);
    overflow-x: clip;
  }

  .blog-header {
    display: grid;
    grid-template-columns: 1fr;
    align-items: start;
    margin: 0 0 clamp(22px, 3vw, 36px);
    padding: clamp(38px, 4.8vw, 60px) 0 clamp(30px, 3.4vw, 46px);
    background: var(--skin-section, #ffffff);
    color: var(--skin-text, #111111);
    border-bottom: 1px solid rgba(17, 17, 17, 0.12);
  }

  .blog-header__copy {
    max-width: 820px;
  }

  .blog-header .bc-link,
  .blog-header .bc-current,
  .blog-header .bc-sep {
    color: #5f6874;
  }

  .blog-header .bc-link:hover {
    color: #111111;
  }

  .blog-proofline {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px clamp(16px, 3vw, 28px);
    max-width: 720px;
    margin: 20px 0 0;
    padding: 0;
    border: 0;
  }

  .blog-proofline div {
    display: grid;
    gap: 4px;
    min-width: 0;
    align-content: start;
  }

  .blog-proofline dt {
    color: #5f6874;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .blog-proofline dd {
    margin: 0;
    color: #111111;
    font-size: 1rem;
    font-weight: 600;
    min-width: 0;
    overflow-wrap: anywhere;
  }

  .blog-featured {
    margin: clamp(20px, 3.2vw, 34px) 0 clamp(18px, 3vw, 30px);
  }

  .blog-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .blog-rule {
    display: block;
    width: 56px;
    height: 3px;
    margin-bottom: 14px;
    background: var(--um-red);
  }

  .bc-link {
    font-family: var(--um-font-body);
    font-size: 16px;
    font-weight: 700;
    color: #555d66;
    text-decoration: none;
    transition: color .15s;
  }
  .blog-header .bc-link:hover { color: #111111; }
  .bc-sep { color: #5f6670; font-size: 16px; opacity: 1; }
  .bc-current {
    font-family: var(--um-font-body);
    font-size: 16px;
    color: #555d66;
  }

  .blog-title {
    font-family: var(--um-font-display);
    font-size: clamp(2.22rem, 3.45vw, 3.62rem);
    font-weight: var(--um-display-weight);
    letter-spacing: var(--um-display-tracking);
    line-height: var(--um-display-line-height);
    color: #111111;
    margin: 0 0 12px;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .blog-subtitle {
    font-family: var(--um-font-body);
    max-width: 760px;
    font-size: clamp(1rem, 1.14vw, 1.12rem);
    line-height: 1.72;
    color: #414a55;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .blog-archive {
    margin-top: clamp(24px, 4vw, 44px);
  }

  .archive-head:global(.um-section-header) {
    display: grid;
    grid-template-columns: minmax(240px, 0.3fr) minmax(0, 0.7fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
    padding: 14px 0 22px;
    border-top: 1px solid #111111;
    max-width: none;
  }

  .archive-head:global(.um-section-header) h2 {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #111111;
    font-family: var(--um-font-body);
    font-size: 16px;
    font-weight: 600;
  }

  .archive-head:global(.um-section-header) h2::before {
    content: "";
    width: 30px;
    height: 2px;
    background: var(--um-red);
    flex-shrink: 0;
  }

  .archive-head:global(.um-section-header) p {
    max-width: 620px;
    margin: 0;
    color: #555d66;
    font-family: var(--um-font-body);
    font-size: 16px;
    line-height: 1.72;
  }

  .feed {
    margin-top: 0;
    max-width: 920px;
  }

  .empty-state {
    display: grid;
    grid-template-columns: minmax(220px, 0.3fr) minmax(0, 0.7fr);
    gap: clamp(20px, 4vw, 56px);
    align-items: start;
    margin: clamp(22px, 3.4vw, 36px) 0 clamp(36px, 5vw, 64px);
    padding: 24px clamp(18px, 2vw, 24px) 0;
    border-top: 1px solid rgba(17, 17, 17, 0.14);
    color: #555d66;
    font-family: var(--um-font-body);
    font-size: 16px;
    text-align: left;
  }

  .empty-state strong {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #111111;
    font-weight: 600;
    line-height: 1.3;
  }

  .empty-state strong::before {
    content: "";
    width: 30px;
    height: 2px;
    flex: 0 0 30px;
    background: var(--um-red);
  }

  .empty-state p {
    max-width: 560px;
    margin: 0;
    color: #555d66;
    line-height: 1.62;
  }

  .empty-state a {
    display: inline-flex;
    margin-top: 14px;
    color: #111111;
    font-weight: 700;
    text-decoration: none;
  }

  .empty-state a:hover {
    color: var(--um-red);
  }

  @media (max-width: 820px) {
    .blog-index {
      padding-inline: 0;
    }

    .blog-container {
      width: 100%;
      max-width: 100%;
    }

    .blog-header {
      padding: 28px 0 24px;
      align-items: start;
    }

    .blog-title {
      font-size: clamp(2rem, 6.6vw, 2.32rem);
      line-height: 1.12;
    }

    .blog-proofline {
      grid-template-columns: 1fr;
      gap: 8px;
      max-width: 100%;
      margin-top: 18px;
    }

    .blog-proofline div {
      grid-template-columns: minmax(0, 124px) minmax(0, 1fr);
      align-items: baseline;
      gap: 12px;
      padding-top: 8px;
      border-top: 0;
    }

    .blog-proofline dt {
      letter-spacing: 0;
      text-transform: none;
      white-space: normal;
      overflow-wrap: anywhere;
    }

    .archive-head {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .empty-state {
      grid-template-columns: 1fr;
      gap: 12px;
      margin-bottom: 34px;
      padding-top: 18px;
    }

  }
</style>
