---
import LayoutV4 from '../../layouts/LayoutV4.astro';
import BlogCategoryTabs from '../../components/blog/BlogCategoryTabs.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import BlogHero from '../../components/blog/BlogHero.astro';
import BlogPagination from '../../components/blog/BlogPagination.astro';
import IntentLinkGraph from '../../components/blog/BlogIntentLinks.astro';
import { fetchBlogListing } from '../../utils/getBlogData';
import { blogPostImageUrl } from '../../utils/blogHelpers';
import { toIsoDate } from '../../utils/blogUtils';
import { resolveReplicaH1 } from '../../utils/replicaProdCopy';
import {
  buildBlogStrategicLinkGroups,
  buildStrategicWebPageStructuredData,
} from '../../data/strategicLinkGraph';

const blogIndexH1 = resolveReplicaH1('/blog', 'Ideas técnicas para decidir mejor');
const blogLead = 'Lecturas sobre infraestructura, continuidad, seguridad, software y operación IT, escritas por el equipo técnico de ULTIMA MILLA.';

const PAGE_SIZE = 10;
const rawPage = Astro.url.searchParams.get('page');
const page = Number(rawPage || '1');
if (rawPage !== null && (!Number.isInteger(page) || page <= 1)) {
  return Astro.redirect('/blog', 301);
}

const { posts, total } = await fetchBlogListing(page, PAGE_SIZE);
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
if (page > totalPages && posts.length === 0) {
  return Astro.rewrite('/404');
}

const featuredPost = page === 1 ? posts[0] : null;
const archivePosts = featuredPost ? posts.slice(1) : posts;

const siteUrl = 'https://www.ultimamilla.com.ar';
const canonicalUrl = page === 1 ? `${siteUrl}/blog` : `${siteUrl}/blog?page=${page}`;
const prevUrl = page > 1 ? (page === 2 ? `${siteUrl}/blog` : `${siteUrl}/blog?page=${page - 1}`) : null;
const nextUrl = page < totalPages ? `${siteUrl}/blog?page=${page + 1}` : null;
const pageTitle = page === 1 ? blogIndexH1 : `${blogIndexH1} · Página ${page}`;
const pageDescription = page === 1
  ? 'Artículos técnicos de ULTIMA MILLA sobre infraestructura IT, redes, telecomunicaciones, seguridad electrónica y software para empresas de Argentina.'
  : `Página ${page} del archivo técnico de ULTIMA MILLA: infraestructura IT, redes, telecomunicaciones, seguridad electrónica y software para empresas.`;

const blogStrategicLinkGroups = buildBlogStrategicLinkGroups({
  currentPath: '/blog',
  title: blogIndexH1,
  summary: blogLead,
  text: posts.map((post) => `${post.titulo} ${post.resumen} ${post.categoria} ${(post.tags || []).join(' ')}`).join(' '),
  relatedPosts: posts.slice(0, 4),
});

const absolute = (url: string) => (url.startsWith('http') ? url : `${siteUrl}${url}`);
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${siteUrl}/blog#blog`,
  name: 'Blog ULTIMA MILLA',
  url: `${siteUrl}/blog`,
  description: pageDescription,
  inLanguage: 'es-AR',
  publisher: { '@id': `${siteUrl}/#organization` },
  blogPost: posts.map((p) => ({
    '@type': 'BlogPosting',
    '@id': `${siteUrl}/blog/${p.slug}#article`,
    headline: p.titulo,
    url: `${siteUrl}/blog/${p.slug}`,
    datePublished: toIsoDate(p.fecha_publicacion),
    dateModified: toIsoDate(p.fecha_modificacion || p.fecha_publicacion),
    image: absolute(blogPostImageUrl(p)),
    author: { '@id': `${siteUrl}/#organization` },
  })),
};
const blogPageStructuredData = [
  schema,
  buildStrategicWebPageStructuredData({
    url: canonicalUrl,
    name: pageTitle,
    description: pageDescription,
    groups: blogStrategicLinkGroups,
  }),
];

Astro.response.headers.set('Cache-Control', 'public, max-age=300, stale-while-revalidate=3600');
---

<LayoutV4
  skin="black"
  title={pageTitle}
  description={pageDescription}
  canonical={canonicalUrl}
  structuredData={blogPageStructuredData}
>
  {prevUrl && <link slot="head" rel="prev" href={prevUrl} />}
  {nextUrl && <link slot="head" rel="next" href={nextUrl} />}

  <div class="bx">
    <header class="bx-hero bx-shell">
      <nav class="bx-crumbs" aria-label="Migas de pan">
        <a href="/">Inicio</a><span aria-hidden="true">/</span>
        {page === 1 ? <span aria-current="page">Blog</span> : <a href="/blog">Blog</a>}
        {page > 1 && <><span aria-hidden="true">/</span><span aria-current="page">Página {page}</span></>}
      </nav>
      <p class="bx-kicker">Blog técnico</p>
      <h1 class="bx-title">{blogIndexH1}</h1>
      <p class="bx-lead">{blogLead}</p>
      <p class="bx-count">
        {total > 0 && <span>{total} artículos publicados</span>}
        <a href="/rss.xml">Suscribirse por RSS</a>
      </p>
    </header>

    <div class="bx-shell">
      <BlogCategoryTabs />

      {featuredPost && (
        <section class="bx-featured" aria-label="Artículo destacado">
          <BlogHero post={featuredPost} />
        </section>
      )}

      {archivePosts.length > 0 && (
        <section class="bx-archive" aria-labelledby="bx-archive-title">
          <div class="bx-archive__head">
            <h2 id="bx-archive-title">{page === 1 ? 'Últimos artículos' : `Archivo · página ${page}`}</h2>
          </div>
          <div class="bx-grid">
            {archivePosts.map((post, idx) => <BlogCard post={post} eager={idx < 3} />)}
          </div>
        </section>
      )}

      {posts.length === 0 && (
        <div class="bx-empty">
          <h2>Todavía no hay artículos publicados</h2>
          <p>Mientras tanto, puede revisar los antecedentes técnicos y los servicios relacionados con continuidad operativa.</p>
          <a href="/antecedentes">Ver antecedentes <span aria-hidden="true">→</span></a>
        </div>
      )}

      <BlogPagination page={page} totalPages={totalPages} baseHref="/blog" />

      <div class="bx-related">
        <IntentLinkGraph
          class="um-intent-link-graph--contained"
          kicker="Para avanzar"
          title="Ver también"
          text="De la lectura a los servicios, sectores y antecedentes donde aplica."
          groups={blogStrategicLinkGroups}
        />
      </div>
    </div>
  </div>
</LayoutV4>

<style>
  .bx { background: var(--x-ink); color: var(--x-text); padding-bottom: var(--x-section); overflow-x: clip; }
  .bx-shell { width: min(var(--um-container-wide, 1400px), calc(100% - 2 * var(--x-gutter))); margin-inline: auto; }

  .bx-hero { padding-block: clamp(32px, 4vw, 56px) 48px; }
  .bx-crumbs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 48px; font-size: var(--x-fs-meta); color: var(--x-muted); }
  .bx-crumbs a { color: var(--x-text-2); text-decoration: none; transition: color 160ms var(--x-ease); }
  .bx-crumbs a:hover { color: var(--x-text); }
  .bx-kicker {
    display: flex; align-items: center; gap: 12px; margin: 0 0 24px;
    font-size: var(--x-fs-kicker); font-weight: 600; line-height: 1.2; letter-spacing: .12em; text-transform: uppercase; color: var(--x-muted);
  }
  .bx-kicker::before { content: ''; flex: none; width: 28px; height: 2px; background: var(--x-red); }
  .bx-title {
    margin: 0; max-width: 18ch;
    font-family: var(--um-font-editorial);
    font-size: var(--x-fs-h1) !important; line-height: 1.02 !important; font-weight: 600 !important; letter-spacing: -.025em !important;
    color: var(--x-text); text-wrap: balance;
  }
  .bx-lead { margin: 24px 0 0; max-width: 62ch; font-size: var(--x-fs-lead); line-height: 1.55; color: var(--x-text-2); }
  .bx-count { display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 24px 0 0; font-size: var(--x-fs-meta); line-height: 1.45; color: var(--x-muted); }
  .bx-count a { color: var(--x-text-2); text-decoration: underline; text-decoration-color: var(--x-line-strong); text-underline-offset: 4px; }
  .bx-count a:hover { color: var(--x-text); }

  .bx-featured { margin-bottom: clamp(48px, 6vw, 96px); }

  .bx-archive__head { margin-bottom: 24px; }
  .bx-archive__head h2 {
    margin: 0; font-family: var(--um-font-editorial);
    font-size: var(--x-fs-h2); line-height: 1.08; font-weight: 600; letter-spacing: -.02em; color: var(--x-text);
  }
  .bx-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }

  .bx-empty { padding: 48px 0; border-top: 1px solid var(--x-line); }
  .bx-empty h2 { margin: 0 0 12px; font-size: var(--x-fs-h3); font-weight: 600; color: var(--x-text); }
  .bx-empty p { margin: 0 0 16px; max-width: 62ch; color: var(--x-text-2); }
  .bx-empty a { color: var(--x-text); font-weight: 600; }

  .bx-related { margin-top: var(--x-section); }

  @media (max-width: 1100px) { .bx-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 680px) {
    .bx-grid { grid-template-columns: minmax(0, 1fr); gap: 16px; }
    .bx-crumbs { margin-bottom: 32px; }
  }
</style>
