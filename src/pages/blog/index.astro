---
import LayoutV4 from '../../layouts/LayoutV4.astro';
import BlogHero from '../../components/blog/BlogHero.astro';
import BlogFeedItem from '../../components/blog/BlogFeedItem.astro';
import BlogPagination from '../../components/blog/BlogPagination.astro';
import { fetchBlogListing } from '../../utils/getBlogData';

const PAGE_SIZE = 10;
const page = Number(Astro.url.searchParams.get('page') || '1');
const { posts, total } = await fetchBlogListing(page, PAGE_SIZE);
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));

const [hero, ...feedPosts] = posts;
const archivePosts = feedPosts;

const siteUrl = 'https://ultimamilla.com.ar';
const canonicalUrl = page === 1 ? `${siteUrl}/blog` : `${siteUrl}/blog?page=${page}`;
const prevUrl = page > 1 ? (page === 2 ? `${siteUrl}/blog` : `${siteUrl}/blog?page=${page - 1}`) : null;
const nextUrl = page < totalPages ? `${siteUrl}/blog?page=${page + 1}` : null;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  '@id': `${siteUrl}/blog`,
  name: 'Blog ULTIMA MILLA',
  url: `${siteUrl}/blog`,
  description: 'Noticias, proyectos y artículos técnicos sobre infraestructura IT, seguridad electrónica y telecomunicaciones en Argentina.',
  inLanguage: 'es-AR',
  publisher: {
    '@type': 'Organization',
    name: 'ULTIMA MILLA',
    url: siteUrl,
    logo: { '@type': 'ImageObject', url: `${siteUrl}/images/um-logo.png` },
  },
  blogPost: posts.map(p => ({
    '@type': 'BlogPosting',
    '@id': `${siteUrl}/blog/${p.slug}#article`,
    headline: p.titulo,
    datePublished: p.fecha_publicacion,
    url: `${siteUrl}/blog/${p.slug}`,
  })),
};
---

<LayoutV4
  title="Blog | ULTIMA MILLA - Infraestructura IT y Tecnología"
  description="Artículos técnicos, casos de éxito y novedades sobre infraestructura IT, telecomunicaciones, seguridad electrónica y software para empresas en Argentina."
  canonical={canonicalUrl}
  structuredData={schema}
>
  {prevUrl && <link slot="head" rel="prev" href={prevUrl} />}
  {nextUrl && <link slot="head" rel="next" href={nextUrl} />}
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap"
    rel="stylesheet"
  />

  <main class="blog-index">
    <div class="blog-container">

      <header class="blog-header">
        <div class="blog-header__copy">
          <nav class="blog-breadcrumb" aria-label="Navegación">
            <a href="/" class="bc-link">ULTIMA MILLA</a>
            <span class="bc-sep">/</span>
            <span class="bc-current">Blog</span>
          </nav>
          <span class="blog-rule" aria-hidden="true"></span>
          <h1 class="blog-title">Ideas técnicas para decidir mejor</h1>
          <p class="blog-subtitle">
            Lecturas para decidir infraestructura, continuidad, seguridad, software y operación IT con evidencia concreta.
          </p>
        </div>
      </header>

      {hero && (
        <section class="blog-feature" aria-label="Artículo destacado">
          <BlogHero post={hero} />
        </section>
      )}

      {archivePosts.length > 0 && (
        <section class="blog-archive" aria-label="Archivo documental">
          <div class="archive-head">
            <span>Archivo documental</span>
            <p>Lecturas ordenadas por fecha, imagen y contexto para evaluar riesgos, alcance y decisiones técnicas sin pasos intermedios.</p>
          </div>
          <div class="feed">
            {archivePosts.map((post, idx) => <BlogFeedItem post={post} index={idx + 4} />)}
          </div>
        </section>
      )}

      {posts.length === 0 && (
        <div class="empty-state">
          <p>No hay artículos publicados aún.</p>
        </div>
      )}

      <BlogPagination page={page} totalPages={totalPages} baseHref="/blog" />

    </div>
  </main>
</LayoutV4>

<style>
  .blog-index {
    min-height: 100vh;
    background: var(--skin-section);
    padding: 0 24px 112px;
    overflow-x: clip;
  }

  .blog-container {
    width: min(100%, 1120px);
    max-width: 1120px;
    margin: 0 auto;
    overflow-x: clip;
  }

  .blog-header {
    display: block;
    margin-bottom: clamp(20px, 3vw, 34px);
    padding: clamp(42px, 5vw, 70px) 0 clamp(32px, 4vw, 52px);
    background: #ffffff;
    color: #111111;
    border-bottom: 0;
  }

  .blog-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .blog-rule {
    display: block;
    width: 56px;
    height: 3px;
    margin-bottom: 14px;
    background: var(--um-red);
  }

  .bc-link {
    font-family: var(--um-font-body);
    font-size: 16px;
    font-weight: 700;
    color: #555d66;
    text-decoration: none;
    transition: color .15s;
  }
  .bc-link:hover { color: #111111; }
  .bc-sep { color: #8b949e; font-size: 16px; opacity: 0.78; }
  .bc-current {
    font-family: var(--um-font-body);
    font-size: 16px;
    color: #555d66;
  }

  .blog-title {
    font-family: var(--um-font-display);
    font-size: clamp(2.15rem, 3.25vw, 3.42rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.08;
    color: #111111;
    margin: 0 0 12px;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .blog-subtitle {
    font-family: var(--um-font-body);
    max-width: 690px;
    font-size: clamp(1rem, 1.14vw, 1.12rem);
    line-height: 1.65;
    color: #47515d;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .blog-feature {
    display: block;
  }

  .blog-archive {
    margin-top: clamp(26px, 4vw, 48px);
  }

  .archive-head {
    display: grid;
    grid-template-columns: minmax(240px, 0.3fr) minmax(0, 0.7fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
    padding: 14px 0 22px;
    border-top: 1px solid #111111;
    border-bottom: 0;
  }

  .archive-head span {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #111111;
    font-family: var(--um-font-body);
    font-size: 16px;
    font-weight: 600;
  }

  .archive-head span::before {
    content: "";
    width: 30px;
    height: 2px;
    background: var(--um-red);
  }

  .archive-head p {
    max-width: 620px;
    margin: 0;
    color: #555d66;
    font-family: var(--um-font-body);
    font-size: 16px;
    line-height: 1.72;
  }

  .feed { margin-top: 0; }

  .empty-state {
    text-align: center;
    padding: 80px 0;
    color: #9ca3af;
    font-family: var(--um-font-body);
    font-size: 16px;
  }

  @media (max-width: 820px) {
    .blog-index {
      padding-inline: 16px;
    }

    .blog-container {
      width: 100%;
      max-width: 100%;
    }

    .blog-header {
      padding: 28px 0 24px;
    }

    .blog-title {
      font-size: clamp(2rem, 6.6vw, 2.32rem);
      line-height: 1.12;
    }

    .archive-head {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
