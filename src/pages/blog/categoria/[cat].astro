---
import LayoutV4 from '../../../layouts/LayoutV4.astro';
import BlogCategoryTabs from '../../../components/blog/BlogCategoryTabs.astro';
import BlogCard from '../../../components/blog/BlogCard.astro';
import BlogPagination from '../../../components/blog/BlogPagination.astro';
import IntentLinkGraph from '../../../components/blog/BlogIntentLinks.astro';
import { fetchBlogListing } from '../../../utils/getBlogData';
import { getCategoryLabel } from '../../../utils/blogUtils';
import {
  buildBlogStrategicLinkGroups,
  buildStrategicWebPageStructuredData,
} from '../../../data/strategicLinkGraph';

const VALID_CATS = ['noticias', 'proyectos', 'tecnico', 'tecnologia', 'empresa'];
const cat = Astro.params.cat || '';

if (!VALID_CATS.includes(cat)) {
  return Astro.rewrite('/404');
}

const PAGE_SIZE = 9;
const rawPage = Astro.url.searchParams.get('page');
const page = Number(rawPage || '1');
if (rawPage !== null && (!Number.isInteger(page) || page <= 1)) {
  return Astro.redirect(`/blog/categoria/${cat}`, 301);
}
const { posts, total } = await fetchBlogListing(page, PAGE_SIZE, cat);
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
if (page > totalPages && posts.length === 0) {
  return Astro.rewrite('/404');
}
const archivePosts = posts;
const catLabel = getCategoryLabel(cat);
const categoryLead = total > 0 ? `${total} artículo${total !== 1 ? 's' : ''} de ${catLabel.toLowerCase()}, del más reciente al más antiguo.` : '';
const categoryTitle = `${catLabel}: artículos técnicos del blog`;

const siteUrl = 'https://www.ultimamilla.com.ar';
const catUrl = `${siteUrl}/blog/categoria/${cat}`;
const canonicalUrl = page === 1 ? catUrl : `${catUrl}?page=${page}`;
const prevUrl = page > 1 ? (page === 2 ? catUrl : `${catUrl}?page=${page - 1}`) : null;
const nextUrl = page < totalPages ? `${catUrl}?page=${page + 1}` : null;

const categoryMeta: Record<string, { desc: string; intro: string; keywords: string }> = {
  noticias: {
    desc: 'Novedades de infraestructura IT, telecomunicaciones y seguridad electrónica en Argentina: normativas, resoluciones y cambios que afectan la operación de empresas.',
    intro: 'Las últimas novedades en infraestructura IT, telecomunicaciones y seguridad electrónica para empresas argentinas. Análisis de normativas, casos de actualidad y tendencias del sector.',
    keywords: 'noticias IT argentina, telecomunicaciones, seguridad electronica, infraestructura, tendencias tecnologia',
  },
  proyectos: {
    desc: 'Casos de éxito reales: proyectos IT, telecomunicaciones y seguridad en aeropuertos, hospitales, mineras y empresas de toda Argentina.',
    intro: 'Estudios de caso con datos reales: cómo ULTIMA MILLA resuelve desafíos de infraestructura IT, telecomunicaciones y seguridad en los sectores más exigentes de Argentina — desde aeropuertos hasta minas y hospitales.',
    keywords: 'proyectos IT argentina, casos de exito, telecomunicaciones empresas, infraestructura redes, implementacion IT',
  },
  tecnico: {
    desc: 'Guías técnicas sobre redes, seguridad electrónica, telecomunicaciones y software: instalación, configuración, pruebas y criterios de operación para equipos IT.',
    intro: 'Guías técnicas y análisis para profesionales IT: estándares de redes, comparativas tecnológicas, mejores prácticas y tutoriales aplicados a infraestructura empresarial en Argentina.',
    keywords: 'guia tecnica redes, IT profesional argentina, telecomunicaciones tecnico, fibra optica, CCTV, cableado estructurado',
  },
  tecnologia: {
    desc: 'Herramientas, software operativo, automatización y criterios técnicos para empresas argentinas que necesitan sistemas confiables y documentados.',
    intro: 'Análisis sobre software, automatización, infraestructura y decisiones técnicas aplicadas a operaciones reales.',
    keywords: 'tecnologia empresas argentina, software operativo, automatizacion, infraestructura IT, sistemas empresariales',
  },
  empresa: {
    desc: 'Novedades de ULTIMA MILLA: servicios, proyectos y evolución de la empresa de servicios IT con sede en Guaymallén, Mendoza, y 22+ años de trayectoria.',
    intro: 'Novedades de ULTIMA MILLA: nuevos servicios, proyectos destacados y evolución en el mercado tecnológico argentino — trayectoria desde 2003 y catálogo de antecedentes publicado en el sitio.',
    keywords: 'ULTIMA MILLA empresa, servicios IT Mendoza, empresa telecomunicaciones argentina, infraestructura cuyo patagonia',
  },
};

const meta = categoryMeta[cat] || { desc: '', intro: '', keywords: '' };
const categoryStrategicLinkGroups = buildBlogStrategicLinkGroups({
  currentPath: `/blog/categoria/${cat}`,
  title: categoryTitle,
  summary: meta.desc || categoryLead,
  category: catLabel,
  text: posts.map((post) => `${post.titulo} ${post.resumen} ${post.categoria} ${(post.tags || []).join(' ')}`).join(' '),
  relatedPosts: posts.slice(0, 4),
});

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': catUrl,
  name: `${catLabel} — Blog ULTIMA MILLA`,
  description: meta.desc,
  url: canonicalUrl,
  inLanguage: 'es-AR',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog` },
      { '@type': 'ListItem', position: 3, name: catLabel, item: catUrl },
    ],
  },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: total,
    itemListElement: posts.map((p, idx) => ({
      '@type': 'ListItem',
      position: (page - 1) * PAGE_SIZE + idx + 1,
      url: `${siteUrl}/blog/${p.slug}`,
      name: p.titulo,
    })),
  },
};
const categoryStructuredData = [
  schema,
  buildStrategicWebPageStructuredData({
    url: catUrl,
    name: categoryTitle,
    description: meta.desc,
    groups: categoryStrategicLinkGroups,
  }),
];
Astro.response.headers.set('Cache-Control', 'public, max-age=300, stale-while-revalidate=3600');
---

<LayoutV4
  skin="black"
  title={page === 1 ? `${catLabel} · Blog técnico` : `${catLabel} · Blog técnico · Página ${page}`}
  description={meta.desc}
  keywords={meta.keywords}
  canonical={canonicalUrl}
  structuredData={categoryStructuredData}
>
  {prevUrl && <link slot="head" rel="prev" href={prevUrl} />}
  {nextUrl && <link slot="head" rel="next" href={nextUrl} />}

  <div class="bx">
    <header class="bx-hero bx-shell">
      <nav class="bx-crumbs" aria-label="Migas de pan">
        <a href="/">Inicio</a><span aria-hidden="true">/</span>
        <a href="/blog">Blog</a><span aria-hidden="true">/</span>
        <span aria-current="page">{catLabel}</span>
      </nav>
      <p class="bx-kicker">Blog técnico · {catLabel}</p>
      <h1 class="bx-title">{categoryTitle}</h1>
      {meta.intro && <p class="bx-lead">{meta.intro}</p>}
      {categoryLead && <p class="bx-count"><span>{categoryLead}</span><a href="/rss.xml">Suscribirse por RSS</a></p>}
    </header>

    <div class="bx-shell">
      <BlogCategoryTabs current={cat} />

      {archivePosts.length > 0 && (
        <section aria-label={`Artículos de ${catLabel.toLowerCase()}`}>
          <div class="bx-grid">
            {archivePosts.map((post, idx) => <BlogCard post={post} headingLevel="h2" eager={idx < 3} />)}
          </div>
        </section>
      )}

      {posts.length === 0 && (
        <div class="bx-empty">
          <h2>Sin artículos publicados en {catLabel.toLowerCase()}</h2>
          <p>Puede volver al archivo completo o revisar los antecedentes técnicos relacionados.</p>
          <a href="/blog">Ver todo el blog <span aria-hidden="true">→</span></a>
        </div>
      )}

      <BlogPagination page={page} totalPages={totalPages} baseHref={`/blog/categoria/${cat}`} />

      <div class="bx-related">
        <IntentLinkGraph
          class="um-intent-link-graph--contained"
          kicker="Para avanzar"
          title={`Ver más sobre ${catLabel.toLowerCase()}`}
          text="Lecturas cercanas, servicios relacionados y sectores donde aplica."
          groups={categoryStrategicLinkGroups}
        />
      </div>
    </div>
  </div>
</LayoutV4>

<style>
  .bx { background: var(--x-ink); color: var(--x-text); padding-bottom: var(--x-section); overflow-x: clip; }
  .bx-shell { width: min(var(--um-container-wide, 1400px), calc(100% - 2 * var(--x-gutter))); margin-inline: auto; }
  .bx-hero { padding-block: clamp(32px, 4vw, 56px) 48px; }
  .bx-crumbs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 48px; font-size: var(--x-fs-meta); color: var(--x-muted); }
  .bx-crumbs a { color: var(--x-text-2); text-decoration: none; transition: color 160ms var(--x-ease); }
  .bx-crumbs a:hover { color: var(--x-text); }
  .bx-kicker {
    display: flex; align-items: center; gap: 12px; margin: 0 0 24px;
    font-size: var(--x-fs-kicker); font-weight: 600; line-height: 1.2; letter-spacing: .12em; text-transform: uppercase; color: var(--x-muted);
  }
  .bx-kicker::before { content: ''; flex: none; width: 28px; height: 2px; background: var(--x-red); }
  .bx-title {
    margin: 0; max-width: 20ch; font-family: var(--um-font-editorial);
    font-size: var(--x-fs-h1) !important; line-height: 1.02 !important; font-weight: 600 !important; letter-spacing: -.025em !important;
    color: var(--x-text); text-wrap: balance;
  }
  .bx-lead { margin: 24px 0 0; max-width: 62ch; font-size: var(--x-fs-lead); line-height: 1.55; color: var(--x-text-2); }
  .bx-count { display: flex; flex-wrap: wrap; gap: 8px 24px; margin: 24px 0 0; font-size: var(--x-fs-meta); line-height: 1.45; color: var(--x-muted); }
  .bx-count a { color: var(--x-text-2); text-decoration: underline; text-decoration-color: var(--x-line-strong); text-underline-offset: 4px; }
  .bx-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; }
  .bx-empty { padding: 48px 0; border-top: 1px solid var(--x-line); }
  .bx-empty h2 { margin: 0 0 12px; font-size: var(--x-fs-h3); font-weight: 600; color: var(--x-text); }
  .bx-empty p { margin: 0 0 16px; max-width: 62ch; color: var(--x-text-2); }
  .bx-empty a { color: var(--x-text); font-weight: 600; }
  .bx-related { margin-top: var(--x-section); }
  @media (max-width: 1100px) { .bx-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 680px) { .bx-grid { grid-template-columns: minmax(0, 1fr); gap: 16px; } .bx-crumbs { margin-bottom: 32px; } }
</style>
