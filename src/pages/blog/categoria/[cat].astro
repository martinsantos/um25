---
import LayoutV4 from '../../../layouts/LayoutV4.astro';
import BlogHero from '../../../components/blog/BlogHero.astro';
import BlogFeedItem from '../../../components/blog/BlogFeedItem.astro';
import BlogPagination from '../../../components/blog/BlogPagination.astro';
import { fetchBlogListing } from '../../../utils/getBlogData';
import { getCategoryLabel } from '../../../utils/blogUtils';

const VALID_CATS = ['noticias', 'proyectos', 'tecnico', 'tecnologia', 'empresa'];
const cat = Astro.params.cat || '';

if (!VALID_CATS.includes(cat)) {
  return Astro.redirect('/blog');
}

const PAGE_SIZE = 10;
const page = Number(Astro.url.searchParams.get('page') || '1');
const { posts, total } = await fetchBlogListing(page, PAGE_SIZE, cat);
const totalPages = Math.max(1, Math.ceil(total / PAGE_SIZE));
const [hero, ...feedPosts] = posts;
const archivePosts = feedPosts;
const catLabel = getCategoryLabel(cat);
const categoryLead = `${total} lectura${total !== 1 ? 's' : ''} de ${catLabel.toLowerCase()} ordenada${total !== 1 ? 's' : ''} por fecha, imagen y contexto técnico.`;

const siteUrl = 'https://ultimamilla.com.ar';
const catUrl = `${siteUrl}/blog/categoria/${cat}`;
const canonicalUrl = page === 1 ? catUrl : `${catUrl}?page=${page}`;
const prevUrl = page > 1 ? (page === 2 ? catUrl : `${catUrl}?page=${page - 1}`) : null;
const nextUrl = page < totalPages ? `${catUrl}?page=${page + 1}` : null;

const categoryMeta: Record<string, { desc: string; intro: string; keywords: string }> = {
  noticias: {
    desc: 'Novedades IT, telecomunicaciones y seguridad en Argentina. Normativas, tendencias y actualidad del sector tecnológico.',
    intro: 'Las últimas novedades en infraestructura IT, telecomunicaciones y seguridad electrónica para empresas argentinas. Análisis de normativas, casos de actualidad y tendencias del sector.',
    keywords: 'noticias IT argentina, telecomunicaciones, seguridad electronica, infraestructura, tendencias tecnologia',
  },
  proyectos: {
    desc: 'Casos de éxito reales: proyectos IT, telecomunicaciones y seguridad en aeropuertos, hospitales, mineras y empresas de toda Argentina.',
    intro: 'Estudios de caso con datos reales: cómo ULTIMA MILLA resuelve desafíos de infraestructura IT, telecomunicaciones y seguridad en los sectores más exigentes de Argentina — desde aeropuertos hasta minas y hospitales.',
    keywords: 'proyectos IT argentina, casos de exito, telecomunicaciones empresas, infraestructura redes, implementacion IT',
  },
  tecnico: {
    desc: 'Guías técnicas sobre redes, seguridad, telecomunicaciones y software para profesionales IT en Argentina.',
    intro: 'Guías técnicas y análisis para profesionales IT: estándares de redes, comparativas tecnológicas, mejores prácticas y tutoriales aplicados a infraestructura empresarial en Argentina.',
    keywords: 'guia tecnica redes, IT profesional argentina, telecomunicaciones tecnico, fibra optica, CCTV, cableado estructurado',
  },
  tecnologia: {
    desc: 'Herramientas, software operativo, automatización y criterios técnicos para empresas que necesitan sistemas confiables.',
    intro: 'Análisis sobre software, automatización, infraestructura y decisiones técnicas aplicadas a operaciones reales.',
    keywords: 'tecnologia empresas argentina, software operativo, automatizacion, infraestructura IT, sistemas empresariales',
  },
  empresa: {
    desc: 'Noticias de ULTIMA MILLA: servicios, proyectos y evolución de la empresa IT en Mendoza, Argentina.',
    intro: 'Novedades de ULTIMA MILLA: nuevos servicios, proyectos destacados y evolución en el mercado tecnológico argentino — trayectoria desde 2003 y catálogo de antecedentes publicado en el sitio.',
    keywords: 'ULTIMA MILLA empresa, servicios IT Mendoza, empresa telecomunicaciones argentina, infraestructura cuyo patagonia',
  },
};

const meta = categoryMeta[cat] || { desc: '', intro: '', keywords: '' };

const schema = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  '@id': catUrl,
  name: `${catLabel} — Blog ULTIMA MILLA`,
  description: meta.desc,
  url: canonicalUrl,
  inLanguage: 'es-AR',
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Inicio', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Blog', item: `${siteUrl}/blog` },
      { '@type': 'ListItem', position: 3, name: catLabel, item: catUrl },
    ],
  },
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: total,
    itemListElement: posts.map((p, idx) => ({
      '@type': 'ListItem',
      position: (page - 1) * PAGE_SIZE + idx + 1,
      url: `${siteUrl}/blog/${p.slug}`,
      name: p.titulo,
    })),
  },
};
---

<LayoutV4
  title={`${catLabel} — Blog ULTIMA MILLA`}
  description={meta.desc}
  keywords={meta.keywords}
  canonical={canonicalUrl}
  structuredData={schema}
>
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Open+Sans:wght@400;600;700&display=swap"
    rel="stylesheet"
  />
  {prevUrl && <link slot="head" rel="prev" href={prevUrl} />}
  {nextUrl && <link slot="head" rel="next" href={nextUrl} />}

  <main class="blog-cat">
    <div class="blog-container">

      <header class="blog-header">
        <div class="blog-header__copy">
          <nav class="blog-breadcrumb" aria-label="Navegación">
            <a href="/" class="bc-link">ULTIMA MILLA</a>
            <span class="bc-sep">/</span>
            <a href="/blog" class="bc-link">Blog</a>
            <span class="bc-sep">/</span>
            <span class="bc-current">{catLabel}</span>
          </nav>
          <span class="blog-rule" aria-hidden="true"></span>
          <h1 class="blog-title">Ideas técnicas para decidir mejor</h1>
          <p class="blog-subtitle">{categoryLead}</p>
        </div>
      </header>

      {hero && (
        <section class="blog-feature" aria-label="Artículo destacado">
          <BlogHero post={hero} />
        </section>
      )}

      {archivePosts.length > 0 && (
        <section class="blog-archive" aria-label="Archivo de categoría">
          <div class="archive-head">
            <span>Archivo filtrado</span>
            <p>Artículos ordenados para revisar decisiones, riesgos y alcance dentro de este eje técnico.</p>
          </div>
          <div class="feed">
            {archivePosts.map((post, idx) => <BlogFeedItem post={post} index={idx + 4} />)}
          </div>
        </section>
      )}

      {posts.length === 0 && (
        <div class="empty-state">
          <p>No hay artículos en esta categoría aún.</p>
        </div>
      )}

      <BlogPagination page={page} totalPages={totalPages} baseHref={`/blog/categoria/${cat}`} />

    </div>
  </main>
</LayoutV4>

<style>
  .blog-cat {
    min-height: 100vh;
    background: var(--skin-section);
    padding: 0 24px 96px;
    overflow-x: clip;
  }

  .blog-container {
    width: min(100%, 1120px);
    max-width: 1120px;
    margin: 0 auto;
    overflow-x: clip;
  }

  .blog-header {
    display: block;
    margin-bottom: clamp(20px, 3vw, 34px);
    padding: clamp(42px, 5vw, 70px) 0 clamp(32px, 4vw, 52px);
    background: #ffffff;
    color: #111111;
    border-bottom: 0;
  }

  .blog-breadcrumb {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .blog-rule {
    display: block;
    width: 56px;
    height: 3px;
    margin-bottom: 14px;
    background: var(--um-red);
  }

  .bc-link {
    font-family: var(--um-font-body);
    font-size: 16px;
    font-weight: 700;
    color: #555d66;
    text-decoration: none;
    transition: color .15s;
  }
  .bc-link:hover { color: #111111; }
  .bc-sep { color: #8b949e; font-size: 16px; opacity: 0.78; }
  .bc-current {
    font-family: var(--um-font-body);
    font-size: 16px;
    color: #555d66;
    font-weight: 600;
  }

  .blog-title {
    font-family: var(--um-font-display);
    font-size: clamp(2rem, 2.8vw, 2.9rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.08;
    color: #111111;
    margin: 0 0 12px;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }

  .blog-subtitle {
    font-family: var(--um-font-body);
    max-width: 760px;
    font-size: clamp(1rem, 1.14vw, 1.12rem);
    line-height: 1.65;
    color: #47515d;
    margin: 0;
    overflow-wrap: anywhere;
  }

  .blog-feature {
    display: block;
  }

  .blog-archive {
    margin-top: clamp(26px, 4vw, 48px);
  }

  .archive-head {
    display: grid;
    grid-template-columns: minmax(220px, 0.28fr) minmax(0, 0.72fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: start;
    padding: 18px 0 22px;
    border-top: 1px solid #111111;
    border-bottom: 0;
  }

  .archive-head span {
    display: flex;
    align-items: center;
    gap: 12px;
    color: #111111;
    font-family: var(--um-font-body);
    font-size: 16px;
    font-weight: 600;
    text-transform: none;
  }

  .archive-head span::before {
    content: "";
    width: 30px;
    height: 2px;
    background: var(--um-red);
  }

  .archive-head p {
    max-width: 620px;
    margin: 0;
    color: #555d66;
    font-family: var(--um-font-body);
    font-size: 16px;
    line-height: 1.62;
  }

  .feed { margin-top: 0; }

  .empty-state {
    text-align: center;
    padding: 80px 0;
    color: #9ca3af;
    font-family: var(--um-font-body);
    font-size: 16px;
    border: 1px solid #f3f4f6;
    border-radius: 0;
  }

  @media (max-width: 820px) {
    .blog-cat {
      padding-inline: 16px;
    }

    .blog-container {
      width: 100%;
      max-width: 100%;
    }

    .blog-header {
      padding: 28px 0 24px;
    }

    .blog-title {
      font-size: clamp(2rem, 6.6vw, 2.32rem);
      line-height: 1.12;
    }

    .archive-head {
      grid-template-columns: 1fr;
      gap: 12px;
    }
  }
</style>
