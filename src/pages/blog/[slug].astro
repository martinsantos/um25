---
import LayoutV4 from '../../layouts/LayoutV4.astro';
import BlogTOC from '../../components/blog/BlogTOC.astro';
import { fetchBlogPost, fetchBlogListing } from '../../utils/getBlogData';
import { blogImageUrl } from '../../utils/blogHelpers';
import { addHeadingIds, getCategoryColor, getCategoryLabel, formatBlogDate } from '../../utils/blogUtils';

const slug = Astro.params.slug || '';
const post = await fetchBlogPost(slug);

if (!post) {
  return Astro.redirect('/blog');
}

const { html: contentHtml, headings } = addHeadingIds(post.contenido || '');
const imgUrl = blogImageUrl(post.imagen_portada);
const color = getCategoryColor(post.categoria);
const label = getCategoryLabel(post.categoria);
const date = formatBlogDate(post.fecha_publicacion);

const { posts: allRecent } = await fetchBlogListing(1, 20);
const idx = allRecent.findIndex(p => p.slug === slug);
const prevPost = idx > 0 ? allRecent[idx - 1] : null;
const nextPost = idx < allRecent.length - 1 ? allRecent[idx + 1] : null;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.titulo,
  description: post.resumen,
  datePublished: post.fecha_publicacion,
  image: imgUrl || undefined,
  publisher: {
    '@type': 'Organization',
    name: 'ULTIMA MILLA',
    url: 'https://ultimamilla.com.ar',
  },
};
---

<LayoutV4
  title={`${post.titulo} — ULTIMA MILLA Blog`}
  description={post.resumen?.substring(0, 160)}
  image={imgUrl || undefined}
  structuredData={schema}
>
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />
  <main class="min-h-screen bg-[#0a0f1e] py-16">
    <div class="max-w-5xl mx-auto px-6 sm:px-8">

      <p class="text-[10px] font-mono text-white/30 uppercase tracking-widest mb-10">
        <a href={'/blog'} class="hover:text-white/50 transition-colors">Blog</a>
        {' '}/ {label}
      </p>

      <div class="flex gap-12 items-start">

        <BlogTOC headings={headings} />

        <article class="flex-1 min-w-0 max-w-[720px]">

          <header class="mb-8">
            <div class="flex items-center gap-2 mb-4">
              <span
                class="text-[9px] font-mono font-bold uppercase tracking-widest px-2 py-0.5 rounded"
                style={`color: ${color}; background: ${color}20; border: 1px solid ${color}40`}
              >{label}</span>
              <span class="text-white/30 text-xs">{post.tiempo_lectura} min lectura</span>
              <span class="text-white/30 text-xs">·</span>
              <span class="text-white/30 text-xs">{date}</span>
            </div>

            <h1 class="um-h text-3xl sm:text-4xl text-white font-bold leading-tight mb-6">
              {post.titulo}
            </h1>

            {imgUrl && (
              <img
                src={imgUrl}
                alt={post.titulo}
                class="w-full rounded-xl object-cover max-h-96 mb-8"
              />
            )}
          </header>

          <div class="blog-prose" set:html={contentHtml} />

          {post.tags && post.tags.length > 0 && (
            <div class="flex flex-wrap gap-2 mt-10 pt-6 border-t border-[#1e3a5f]">
              {post.tags.map((tag: string) => (
                <span class="text-[11px] text-white/35 border border-[#1e3a5f] rounded px-2 py-0.5">
                  #{tag}
                </span>
              ))}
            </div>
          )}

          <nav class="grid grid-cols-2 gap-4 mt-10 pt-8 border-t border-[#1e3a5f]">
            {prevPost ? (
              <a
                href={`/blog/${prevPost.slug}`}
                class="group p-4 border border-[#1e3a5f] rounded-lg hover:border-white/20 transition-colors"
              >
                <p class="text-[10px] font-mono text-white/25 uppercase tracking-widest mb-1">← anterior</p>
                <p class="text-white/60 text-sm group-hover:text-white transition-colors line-clamp-2">{prevPost.titulo}</p>
              </a>
            ) : <div></div>}

            {nextPost && (
              <a
                href={`/blog/${nextPost.slug}`}
                class="group p-4 border border-[#1e3a5f] rounded-lg hover:border-white/20 transition-colors text-right"
              >
                <p class="text-[10px] font-mono text-white/25 uppercase tracking-widest mb-1">siguiente →</p>
                <p class="text-white/60 text-sm group-hover:text-white transition-colors line-clamp-2">{nextPost.titulo}</p>
              </a>
            )}
          </nav>

        </article>
      </div>
    </div>
  </main>
</LayoutV4>

<style>
  /*
   * Tipografía UMSA — adaptada a dark theme
   * --font-head: 'Poppins' (igual al sistema de estilo)
   * --font-body: 'Arial','Inter' (igual al sistema de estilo)
   * --font-code: 'Fira Code','Consolas' (igual al sistema de estilo)
   * Tamaños, line-height y spacing directamente del /estilo
   */

  .um-h { font-family: 'Futura PT', 'Futura', 'Trebuchet MS', sans-serif; font-weight: 700; }

  /* ── Base del artículo — igual que body en /estilo ────────────────── */
  .blog-prose {
    font-family: 'Arial', 'Inter', system-ui, sans-serif;
    font-size: 15px;
    line-height: 1.7;
    color: #c8d3e0;            /* gris claro — equivalente a --gris-o en dark */
    font-weight: 400;
    -webkit-font-smoothing: antialiased;
  }

  /* ── Párrafos — exacto del /estilo: 14px margin, 1.7 line-height ─── */
  .blog-prose p {
    margin-bottom: 14px;
    line-height: 1.7;
    color: #c8d3e0;
  }

  /* Primer párrafo levemente destacado — patrón del /estilo */
  .blog-prose > p:first-of-type {
    font-size: 16px;
    color: #d6e0ec;
    line-height: 1.7;
  }

  /* ── Headings — Poppins igual que --font-head del /estilo ─────────── */
  .blog-prose h2 {
    font-family: 'Poppins', 'Century Gothic', sans-serif;
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.02em;   /* exacto del /estilo */
    line-height: 1.3;
    color: #f1f5f9;
    margin-top: 40px;
    margin-bottom: 12px;
    scroll-margin-top: 6rem;
  }

  .blog-prose h3 {
    font-family: 'Poppins', 'Century Gothic', sans-serif;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.35;
    text-transform: uppercase;
    letter-spacing: 0.04em;    /* /estilo usa uppercase + 0.04em para subtítulos */
    color: #94a3b8;
    margin-top: 28px;
    margin-bottom: 8px;
    scroll-margin-top: 6rem;
  }

  /* ── Links — azul del sistema UMSA ────────────────────────────────── */
  .blog-prose a {
    color: #4b89d4;            /* --azul: #1A56C0 aclarado para dark */
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(75, 137, 212, 0.4);
    text-decoration-thickness: 1px;
    transition: color 0.15s;
  }
  .blog-prose a:hover {
    color: #7aabee;
  }

  /* ── Listas — igual a body, 14px margin ───────────────────────────── */
  .blog-prose ul,
  .blog-prose ol {
    margin: 6px 0 14px 20px;
    padding: 0;
  }
  .blog-prose li {
    margin-bottom: 5px;
    line-height: 1.65;
    color: #c8d3e0;
  }
  .blog-prose ul { list-style-type: disc; }
  .blog-prose ol { list-style-type: decimal; }
  .blog-prose li::marker { color: #4b89d4; }

  /* ── Blockquote — patrón callout del /estilo ──────────────────────── */
  .blog-prose blockquote {
    border-left: 3px solid #1A56C0;
    padding: 10px 0 10px 16px;
    margin: 20px 0;
    color: #8fa3bb;
    font-style: italic;
    font-size: 14px;
    line-height: 1.65;
  }

  /* ── Strong / Em ───────────────────────────────────────────────────── */
  .blog-prose strong {
    font-family: 'Poppins', 'Century Gothic', sans-serif;
    font-weight: 700;
    color: #dce6f0;
    font-size: 13px;            /* /estilo usa Poppins 700 13px para strong */
  }
  .blog-prose em { font-style: italic; color: #a0b4c8; }

  /* ── Código inline — exacto del /estilo ───────────────────────────── */
  .blog-prose code {
    font-family: 'Fira Code', 'Consolas', 'Courier New', monospace;
    font-size: 11px;            /* exacto: /estilo usa 11px */
    background: rgba(17, 24, 39, 0.8);
    border: 1px solid #1e3a5f;
    border-radius: 3px;
    padding: 1px 5px;          /* exacto del /estilo */
    color: #79c0ff;
    letter-spacing: 0;
  }

  /* ── Pre / bloques de código — igual al .code-block del /estilo ───── */
  .blog-prose pre {
    font-family: 'Fira Code', 'Consolas', 'Courier New', monospace;
    font-size: 12.5px;         /* exacto del /estilo */
    line-height: 1.7;          /* exacto del /estilo */
    background: #0d1117;
    border: 1px solid #1e3a5f;
    border-radius: 8px;
    padding: 16px 20px;
    overflow-x: auto;
    margin: 20px 0;
    letter-spacing: 0;
  }
  .blog-prose pre code {
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
    color: #e2e8f0;
  }

  /* ── Imágenes ──────────────────────────────────────────────────────── */
  .blog-prose img {
    width: 100%;
    border-radius: 8px;
    margin: 24px 0;
    opacity: 0.9;
  }

  /* ── HR — separador del /estilo ────────────────────────────────────── */
  .blog-prose hr {
    border: none;
    border-top: 1px solid #1e3a5f;
    margin: 32px 0;
  }

  /* ── Tablas — igual que .um-table del /estilo ─────────────────────── */
  .blog-prose table {
    width: 100%;
    border-collapse: collapse;
    font-family: 'Arial', 'Inter', system-ui, sans-serif;
    font-size: 13px;           /* exacto del /estilo */
    margin: 16px 0 24px;       /* exacto del /estilo */
    line-height: 1.6;
  }
  .blog-prose th {
    font-family: 'Poppins', 'Century Gothic', sans-serif;
    font-size: 11px;           /* exacto del /estilo */
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;    /* exacto del /estilo */
    color: #6b7f99;
    background: #0d1526;
    padding: 8px 12px;
    border: 1px solid #1e3a5f;
    text-align: left;
  }
  .blog-prose td {
    padding: 8px 12px;
    border: 1px solid #1e3a5f;
    color: #c8d3e0;
    vertical-align: top;
  }
  .blog-prose tr:nth-child(even) td { background: rgba(30, 58, 95, 0.15); }
</style>
