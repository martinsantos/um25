---
import LayoutV4 from '../../layouts/LayoutV4.astro';
import BlogTOC from '../../components/blog/BlogTOC.astro';
import { fetchBlogPost, fetchBlogListing } from '../../utils/getBlogData';
import { blogImageUrl } from '../../utils/blogHelpers';
import { addHeadingIds, getCategoryColor, getCategoryLabel, formatBlogDate } from '../../utils/blogUtils';

const slug = Astro.params.slug || '';
const post = await fetchBlogPost(slug);

if (!post) {
  return Astro.redirect('/blog');
}

const { html: contentHtml, headings } = await addHeadingIds(post.contenido || '');
const imgUrl = blogImageUrl(post.imagen_portada);
const color = getCategoryColor(post.categoria);
const label = getCategoryLabel(post.categoria);
const date = formatBlogDate(post.fecha_publicacion);

const { posts: allRecent } = await fetchBlogListing(1, 20);
const idx = allRecent.findIndex(p => p.slug === slug);
const prevPost = idx > 0 ? allRecent[idx - 1] : null;
const nextPost = idx < allRecent.length - 1 ? allRecent[idx + 1] : null;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.titulo,
  description: post.resumen,
  datePublished: post.fecha_publicacion,
  image: imgUrl || undefined,
  publisher: {
    '@type': 'Organization',
    name: 'ULTIMA MILLA',
    url: 'https://ultimamilla.com.ar',
  },
};
---

<LayoutV4
  title={`${post.titulo} — ULTIMA MILLA Blog`}
  description={post.resumen?.substring(0, 160)}
  image={imgUrl || undefined}
  structuredData={schema}
>
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;1,300;1,400&family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <!-- Reading progress bar -->
  <div id="read-progress" style="position:fixed;top:0;left:0;height:2px;background:#111;width:0%;z-index:100;transition:width 0.1s linear;"></div>

  <!-- Sticky article bar -->
  <div
    id="sticky-bar"
    style="position:fixed;top:0;left:0;right:0;z-index:90;background:rgba(255,255,255,0.95);backdrop-filter:blur(8px);border-bottom:1px solid #e5e7eb;transform:translateY(-100%);transition:transform 0.25s ease;"
  >
    <div style="max-width:900px;margin:0 auto;padding:10px 24px;display:flex;align-items:center;gap:16px;">
      <a href="/blog" style="font-size:13px;color:#6b7280;text-decoration:none;white-space:nowrap;flex-shrink:0;" onmouseover="this.style.color='#111'" onmouseout="this.style.color='#6b7280'">← Blog</a>
      <span style="color:#e5e7eb;flex-shrink:0;">|</span>
      <span style="font-size:13px;color:#374151;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;flex:1;">{post.titulo}</span>
      <span style="font-size:12px;color:#9ca3af;white-space:nowrap;flex-shrink:0;">{post.tiempo_lectura} min</span>
    </div>
  </div>

  <main class="um-article" style="min-height:100vh;background:#fff;">
    <div style="max-width:1160px;margin:0 auto;padding:40px 24px 96px;">
      <div style="display:flex;gap:80px;align-items:flex-start;">

        <!-- TOC sidebar -->
        <BlogTOC headings={headings} />

        <!-- Article -->
        <article style="flex:1;min-width:0;max-width:680px;margin:0 auto;">

          <!-- Category + back -->
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:28px;">
            <a href="/blog" style="font-size:13px;color:#9ca3af;text-decoration:none;" onmouseover="this.style.color='#374151'" onmouseout="this.style.color='#9ca3af'">← Blog</a>
            <span style="color:#e5e7eb;">·</span>
            <span style="font-size:12px;font-weight:600;text-transform:uppercase;letter-spacing:.08em;" class:list={[]} set:html={`<span style="color:${color}">${label}</span>`} />
          </div>

          <!-- Title -->
          <h1 class="article-title">{post.titulo}</h1>

          <!-- Lead / resumen -->
          {post.resumen && (
            <p class="article-lead">{post.resumen}</p>
          )}

          <!-- Author meta row -->
          <div style="display:flex;align-items:center;gap:12px;margin-bottom:32px;padding-bottom:24px;border-bottom:1px solid #f3f4f6;">
            <div style="width:40px;height:40px;border-radius:50%;background:linear-gradient(135deg,#1e40af,#3b82f6);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
              <span style="color:#fff;font-size:12px;font-weight:700;font-family:Inter,system-ui,sans-serif;">UM</span>
            </div>
            <div>
              <p style="font-size:14px;font-weight:600;color:#111827;margin:0;font-family:Inter,system-ui,sans-serif;">ULTIMA MILLA</p>
              <p style="font-size:13px;color:#9ca3af;margin:0;font-family:Inter,system-ui,sans-serif;">{date} · {post.tiempo_lectura} min de lectura</p>
            </div>
          </div>

          <!-- Hero image -->
          {imgUrl && (
            <figure style="margin:0 0 48px;">
              <img
                src={imgUrl}
                alt={post.titulo}
                style="width:100%;border-radius:12px;object-fit:cover;max-height:480px;box-shadow:0 1px 4px rgba(0,0,0,.08);"
              />
            </figure>
          )}

          <!-- Content -->
          <div class="blog-prose" set:html={contentHtml} />

          <!-- Tags -->
          {post.tags && post.tags.length > 0 && (
            <div style="display:flex;flex-wrap:wrap;gap:8px;margin-top:64px;padding-top:32px;border-top:1px solid #f3f4f6;">
              {post.tags.map((tag: string) => (
                <span style="font-size:12px;color:#6b7280;border:1px solid #e5e7eb;border-radius:999px;padding:4px 14px;font-family:Inter,system-ui,sans-serif;">#{tag}</span>
              ))}
            </div>
          )}

          <!-- Prev / Next -->
          <nav style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-top:48px;padding-top:32px;border-top:1px solid #f3f4f6;">
            {prevPost ? (
              <a
                href={`/blog/${prevPost.slug}`}
                style="display:block;padding:20px;border:1px solid #e5e7eb;border-radius:12px;text-decoration:none;transition:all .15s;"
                onmouseover="this.style.borderColor='#d1d5db';this.style.background='#f9fafb'"
                onmouseout="this.style.borderColor='#e5e7eb';this.style.background='#fff'"
              >
                <p style="font-size:10px;font-family:Inter,monospace;color:#9ca3af;text-transform:uppercase;letter-spacing:.08em;margin:0 0 6px;">← Anterior</p>
                <p style="font-size:14px;color:#374151;margin:0;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{prevPost.titulo}</p>
              </a>
            ) : <div></div>}

            {nextPost && (
              <a
                href={`/blog/${nextPost.slug}`}
                style="display:block;padding:20px;border:1px solid #e5e7eb;border-radius:12px;text-decoration:none;transition:all .15s;text-align:right;"
                onmouseover="this.style.borderColor='#d1d5db';this.style.background='#f9fafb'"
                onmouseout="this.style.borderColor='#e5e7eb';this.style.background='#fff'"
              >
                <p style="font-size:10px;font-family:Inter,monospace;color:#9ca3af;text-transform:uppercase;letter-spacing:.08em;margin:0 0 6px;">Siguiente →</p>
                <p style="font-size:14px;color:#374151;margin:0;line-height:1.4;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden;">{nextPost.titulo}</p>
              </a>
            )}
          </nav>

        </article>
      </div>
    </div>
  </main>

  <script>
    // Reading progress bar
    const bar = document.getElementById('read-progress');
    const stickyBar = document.getElementById('sticky-bar');
    const article = document.querySelector('article');

    function onScroll() {
      if (!bar || !article) return;
      const rect = article.getBoundingClientRect();
      const total = article.scrollHeight - window.innerHeight;
      const scrolled = -rect.top;
      const pct = Math.max(0, Math.min(100, (scrolled / total) * 100));
      bar.style.width = pct + '%';

      if (stickyBar) {
        if (scrolled > 300) {
          stickyBar.style.transform = 'translateY(0)';
        } else {
          stickyBar.style.transform = 'translateY(-100%)';
        }
      }
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    onScroll();
  </script>
</LayoutV4>

<style is:global>
  /* All styles scoped to .um-article — prevents bleeding to other pages */

  .um-article .article-title {
    font-family: 'Merriweather', Georgia, 'Times New Roman', serif;
    font-size: clamp(28px, 5vw, 42px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #111827;
    margin: 0 0 24px;
  }

  .um-article .article-lead {
    font-family: 'Merriweather', Georgia, serif;
    font-size: 20px;
    font-weight: 300;
    line-height: 1.7;
    color: #4b5563;
    margin: 0 0 28px;
    font-style: italic;
  }

  .um-article .blog-prose {
    font-family: 'Merriweather', Georgia, 'Times New Roman', serif;
    font-size: 19px;
    line-height: 1.85;
    color: #1f2937;
    font-weight: 400;
    -webkit-font-smoothing: antialiased;
    word-spacing: 0.01em;
  }

  .um-article .blog-prose p {
    margin: 0 0 28px;
    line-height: 1.85;
    color: #1f2937;
  }

  .um-article .blog-prose > p:first-child {
    font-size: 20px;
    color: #111827;
  }

  .um-article .blog-prose h2 {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 26px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: #111827;
    margin: 72px 0 16px;
    scroll-margin-top: 5rem;
  }

  .um-article .blog-prose h3 {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
    color: #1f2937;
    margin: 48px 0 12px;
    scroll-margin-top: 5rem;
  }

  .um-article .blog-prose h4 {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 17px;
    font-weight: 600;
    color: #374151;
    margin: 36px 0 10px;
    scroll-margin-top: 5rem;
  }

  .um-article .blog-prose a {
    color: #1d4ed8;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(29, 78, 216, 0.35);
    text-decoration-thickness: 1px;
    transition: color 0.15s, text-decoration-color 0.15s;
  }
  .um-article .blog-prose a:hover {
    color: #1e40af;
    text-decoration-color: rgba(30, 64, 175, 0.7);
  }

  .um-article .blog-prose ul,
  .um-article .blog-prose ol {
    margin: 0 0 28px 28px;
    padding: 0;
  }
  .um-article .blog-prose li {
    margin-bottom: 10px;
    line-height: 1.75;
    color: #1f2937;
  }
  .um-article .blog-prose ul { list-style-type: disc; }
  .um-article .blog-prose ol { list-style-type: decimal; }
  .um-article .blog-prose li::marker { color: #9ca3af; }

  .um-article .blog-prose blockquote {
    border-left: 3px solid #d1d5db;
    padding: 2px 0 2px 28px;
    margin: 44px 0;
    color: #6b7280;
    font-style: italic;
    font-size: 21px;
    line-height: 1.7;
    font-weight: 300;
  }
  .um-article .blog-prose blockquote p { margin-bottom: 0; color: inherit; }

  .um-article .blog-prose strong { font-weight: 700; color: #111827; }
  .um-article .blog-prose em { font-style: italic; }

  .um-article .blog-prose code {
    font-family: ui-monospace, 'Fira Code', 'Consolas', monospace;
    font-size: 15px;
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 2px 7px;
    color: #dc2626;
    font-style: normal;
  }

  .um-article .blog-prose pre {
    font-family: ui-monospace, 'Fira Code', 'Consolas', monospace;
    font-size: 14px;
    line-height: 1.65;
    background: #1e293b;
    border-radius: 10px;
    padding: 24px 28px;
    overflow-x: auto;
    margin: 36px 0;
    color: #e2e8f0;
  }
  .um-article .blog-prose pre code {
    background: none; border: none; padding: 0;
    font-size: inherit; color: inherit;
  }

  .um-article .blog-prose img {
    width: 100%;
    border-radius: 8px;
    margin: 44px 0;
    display: block;
    box-shadow: 0 1px 4px rgba(0,0,0,.07);
  }

  .um-article .blog-prose figure { margin: 44px 0; }
  .um-article .blog-prose figure img { margin: 0 0 10px; }
  .um-article .blog-prose figcaption {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 13px;
    color: #9ca3af;
    text-align: center;
    font-style: italic;
  }

  .um-article .blog-prose hr {
    border: none;
    margin: 64px auto;
    width: 40px;
    height: 2px;
    background: #d1d5db;
  }

  .um-article .blog-prose table {
    width: 100%;
    border-collapse: collapse;
    font-size: 16px;
    margin: 32px 0 40px;
    line-height: 1.6;
    font-family: 'Inter', system-ui, sans-serif;
    overflow: hidden;
    border-radius: 8px;
    box-shadow: 0 0 0 1px #e5e7eb;
  }
  .um-article .blog-prose th {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: #6b7280;
    background: #f9fafb;
    padding: 12px 16px;
    border-bottom: 1px solid #e5e7eb;
    text-align: left;
  }
  .um-article .blog-prose td {
    padding: 12px 16px;
    border-bottom: 1px solid #f3f4f6;
    color: #374151;
    vertical-align: top;
  }
  .um-article .blog-prose tr:last-child td { border-bottom: none; }
  .um-article .blog-prose tr:nth-child(even) td { background: #fafafa; }
</style>
