---
import LayoutV4 from '../../layouts/LayoutV4.astro';
import BlogTOC from '../../components/blog/BlogTOC.astro';
import IntentLinkGraph from '../../components/um/IntentLinkGraph.astro';
import { fetchBlogPost, fetchBlogListing } from '../../utils/getBlogData';
import { blogImageUrl, blogPostImageUrl } from '../../utils/blogHelpers';
import { addHeadingIds, getCategoryLabel, formatBlogDate, extractFaqSchema } from '../../utils/blogUtils';
import { isReplicaIdenticalCopy, resolveReplicaH1 } from '../../utils/replicaProdCopy';
import { resolveCanonicalBlogSlug } from '../../data/seoRedirects';
import { blogSeoTitleOverrides } from '../../data/seoTitleOverrides';
import { buildBlogSeoMeta } from '../../utils/seoMetaPolicy';
import {
  buildBlogStrategicLinkGroups,
  buildStrategicWebPageStructuredData,
} from '../../data/strategicLinkGraph';

const slug = Astro.params.slug || '';
const canonicalSlug = resolveCanonicalBlogSlug(slug);

if (canonicalSlug !== slug) {
  return Astro.redirect(`/blog/${canonicalSlug}`, 301);
}

const post = await fetchBlogPost(slug);
const siteUrl = 'https://www.ultimamilla.com.ar';

if (!post) {
  return Astro.redirect('/blog');
}

const normalizeArticleContent = (html: string): string => {
  const replacements: Record<string, string> = {
    'El Gancho: Martín y los $500 Mensuales': 'El costo real de resolverlo a mano',
    'El Problema: RG 5824 — La Regulación que Cambió Todo': 'La exigencia operativa de RG 5824',
    'La Solución: Plantilla ARCA': 'La herramienta propuesta',
    'Cómo Funciona (Técnico, pero entendible)': 'Cómo funciona',
    'Casos de Uso: Cuatro Personas, Cuatro Soluciones': 'Casos de uso',
    'Preguntas Frecuentes (Las que realmente te importan)': 'Preguntas frecuentes',
    'Roadmap: Lo que viene (y por qué)': 'Roadmap técnico',
    'Cómo Empezar: Tres Caminos': 'Cómo empezar',
  };

  const canonicalizedHtml = (html || '').replace(/https?:\/\/(?:www\.)?ultimamilla\.com\.ar/gi, siteUrl);

  return Object.entries(replacements).reduce((acc, [from, to]) => {
    const escaped = from.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    return acc.replace(new RegExp(`(<h[2-3][^>]*>)\\s*${escaped}\\s*(<\\/h[2-3]>)`, 'gi'), `$1${to}$2`);
  }, canonicalizedHtml);
};

const normalizedContent = normalizeArticleContent(post.contenido || '');
const { html: contentHtml, headings } = await addHeadingIds(normalizedContent);
const faqSchema = extractFaqSchema(contentHtml);
const imgUrl = blogPostImageUrl(post);
const socialImg = post.social_image ? blogImageUrl(post.social_image) : imgUrl;
const label = getCategoryLabel(post.categoria);
const date = formatBlogDate(post.fecha_publicacion);
const blogSeo = buildBlogSeoMeta({
  title: blogSeoTitleOverrides[slug] || post.meta_title || post.titulo,
  summary: post.meta_description || post.resumen,
  category: label,
});
const seoTitle = blogSeo.title;
const seoDesc = blogSeo.description;

const buildArticleLead = (value: unknown): string => {
  const clean = String(value || '').replace(/\s+/g, ' ').trim();
  if (clean.length <= 190) return clean;
  const sentence = clean.match(/^(.{96,185}?[.!?])\s/);
  if (sentence?.[1]) return sentence[1];
  return `${clean.slice(0, 176).trimEnd()}…`;
};
const articleLead = buildArticleLead(post.resumen);

const { posts: allRecent } = await fetchBlogListing(1, 20);
const idx = allRecent.findIndex(p => p.slug === slug);
const prevPost = idx > 0 ? allRecent[idx - 1] : null;
const nextPost = idx < allRecent.length - 1 ? allRecent[idx + 1] : null;

const articleUrl = `${siteUrl}/blog/${slug}`;
const wordCount = contentHtml.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${articleUrl}#article`,
  headline: post.titulo,
  description: seoDesc,
  url: articleUrl,
  datePublished: post.fecha_publicacion,
  dateModified: post.fecha_modificacion || post.fecha_publicacion,
  wordCount,
  inLanguage: 'es-AR',
  articleSection: label,
  keywords: (post.tags || []).join(', '),
  image: imgUrl ? {
    '@type': 'ImageObject',
    url: imgUrl.startsWith('http') ? imgUrl : `${siteUrl}${imgUrl}`,
    name: post.imagen_portada_alt || post.titulo,
  } : undefined,
  author: {
    '@type': 'Organization',
    name: 'ULTIMA MILLA',
    url: siteUrl,
    logo: { '@type': 'ImageObject', url: `${siteUrl}/images/um-logo.png` },
    sameAs: ['https://www.linkedin.com/company/ultimamilla'],
  },
  publisher: {
    '@type': 'Organization',
    name: 'ULTIMA MILLA',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/images/um-logo.png`,
      width: 600,
      height: 60,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
  isPartOf: {
    '@type': 'Blog',
    '@id': `${siteUrl}/blog`,
    name: 'Blog ULTIMA MILLA',
  },
};

const articleTitleOverrides: Record<string, string> = {
  'plantilla-arca-facturacion-electronica-gratis': 'Plantilla ARCA para facturación electrónica'
};

const buildArticleTitle = (title: string): string => {
  const clean = String(title || '')
    .replace(/\s*\([^)]*\)/g, '')
    .replace(/\bgratis\b/gi, '')
    .replace(/\s+/g, ' ')
    .trim();
  return clean;
};

const editorialArticleTitle = articleTitleOverrides[slug] || buildArticleTitle(post.titulo);
const articleTitle = isReplicaIdenticalCopy()
  ? resolveReplicaH1(`/blog/${slug}`, buildArticleTitle(post.titulo))
  : editorialArticleTitle;
const articleStrategicLinkGroups = buildBlogStrategicLinkGroups({
  currentPath: `/blog/${slug}`,
  title: articleTitle,
  summary: seoDesc,
  category: label,
  tags: post.tags || [],
  text: normalizedContent.replace(/<[^>]+>/g, ' '),
  relatedPosts: [prevPost, nextPost].filter(Boolean) as any[],
});
const articlePageStructuredData = [
  schema,
  ...(faqSchema ? [faqSchema] : []),
  buildStrategicWebPageStructuredData({
    url: articleUrl,
    name: articleTitle,
    description: seoDesc,
    groups: articleStrategicLinkGroups,
  }),
];

---

<LayoutV4
  title={seoTitle}
  description={seoDesc}
  keywords={post.meta_keywords || (post.tags || []).slice(0, 6).join(', ')}
  image={socialImg || imgUrl || undefined}
  ogType="article"
  canonical={articleUrl}
  structuredData={articlePageStructuredData}
>
  <!-- Article meta -->
  <meta slot="head" property="article:published_time" content={post.fecha_publicacion} />
  <meta slot="head" property="article:author" content="ULTIMA MILLA" />
  <meta slot="head" property="article:section" content={label} />
  {post.tags && post.tags.map((tag: string) => (
    <meta slot="head" property="article:tag" content={tag} />
  ))}
  <div id="read-bar" class="read-bar"></div>

  <section class="article-page">

    <div class="article-layout">
      <BlogTOC headings={headings} title={articleTitle} />

      <article class="article-body">

        <nav class="breadcrumbs" aria-label="Navegación">
          <a href="/" class="bc-link">ULTIMA MILLA</a>
          <span class="bc-sep">/</span>
          <a href="/blog" class="bc-link">Blog</a>
          <span class="bc-sep">/</span>
          <span class="bc-cat">{label}</span>
        </nav>

        <span class="article-rule" aria-hidden="true"></span>
        <h1 class="article-title">{articleTitle}</h1>

        {articleLead && <p class="article-lead">{articleLead}</p>}

        <div class="author-row">
          <p class="author-meta">ULTIMA MILLA · {label} · {date} · {post.tiempo_lectura} min de lectura</p>
        </div>

        <hr class="article-divider" />

        <div class="prose" set:html={contentHtml} />

        <IntentLinkGraph
          class="um-intent-link-graph--contained"
          kicker="Para avanzar"
          title="Ver también"
          text="Continuá hacia capacidades técnicas, sectores o notas relacionadas."
          groups={articleStrategicLinkGroups}
        />

        <nav class="post-nav">
          {prevPost ? (
            <a href={`/blog/${prevPost.slug}`} class="um-click-surface post-nav-item">
              <span class="post-nav-label">← Anterior</span>
              <span class="post-nav-title">{prevPost.titulo}</span>
            </a>
          ) : <div></div>}
          {nextPost && (
            <a href={`/blog/${nextPost.slug}`} class="um-click-surface post-nav-item post-nav-item--right">
              <span class="post-nav-label">Siguiente →</span>
              <span class="post-nav-title">{nextPost.titulo}</span>
            </a>
          )}
        </nav>

      </article>
    </div>
  </section>
  <script>
    const bar = document.getElementById('read-bar');
    const art = document.querySelector('.article-body');
    function tick() {
      if (!bar || !art) return;
      const r = art.getBoundingClientRect();
      const pct = Math.max(0, Math.min(100, (-r.top / (art.scrollHeight - window.innerHeight)) * 100));
      bar.style.width = pct + '%';
    }
    window.addEventListener('scroll', tick, { passive: true });
    tick();
  </script>
</LayoutV4>

<style>
  /* Reading progress */
  .read-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0%;
    background: #DC2626;
    z-index: 9999;
    transition: width 0.1s linear;
  }

  /* Page shell */
  .article-page {
    min-height: 100vh;
    background: #fff;
    padding: clamp(40px, 5vw, 68px) 24px clamp(76px, 8vw, 108px);
  }

  .article-layout {
    display: grid;
    grid-template-columns: minmax(188px, 236px) minmax(0, 792px);
    gap: clamp(30px, 4.6vw, 60px);
    align-items: start;
    max-width: 1128px;
    margin: 0 auto;
  }

  /* Article body */
  .article-body {
    min-width: 0;
    max-width: 792px;
    margin: 0;
  }

  /* Breadcrumbs */
  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 18px;
  }
  .bc-link {
    font-family: var(--um-font-body);
    font-size: 16px;
    color: #9ca3af;
    text-decoration: none;
    transition: color .15s;
  }
  .bc-link:hover { color: #374151; text-decoration: underline; text-underline-offset: 3px; }
  .bc-sep { color: #d1d5db; font-size: 16px; }
  .bc-cat {
    font-family: var(--um-font-body);
    font-size: 16px;
    font-weight: 700;
    color: #DC2626;
  }

  .article-rule {
    display: block;
    width: 42px;
    height: 2px;
    margin-bottom: 22px;
    background: var(--um-red);
  }

  /* Title & lead */
  .article-title {
    font-family: var(--um-font-display);
    font-size: clamp(2.625rem, 2.72vw, 2.72rem);
    font-weight: 600;
    line-height: 1.14;
    letter-spacing: 0;
    color: #000;
    max-width: 760px;
    margin: 0 0 16px;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .article-lead {
    font-family: var(--um-font-body);
    max-width: 62ch;
    font-size: clamp(1.02rem, 1.08vw, 1.12rem);
    font-weight: 400;
    font-style: normal;
    line-height: 1.76;
    color: #3f4853;
    margin: 0 0 24px;
  }

  /* Author */
  .author-row {
    display: block;
    margin-bottom: 18px;
  }
  .author-meta {
    font-family: var(--um-font-body);
    font-size: 16px;
    color: #6b7280;
    margin: 0;
    line-height: 1.45;
  }

  .article-divider {
    border: none;
    border-top: 1px solid var(--um-line);
    margin: 0 0 24px;
  }

  /* Prev/next nav */
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 34px;
    padding-top: 24px;
    border-top: 1px solid rgba(216, 221, 228, 0.72);
  }
  .post-nav-item {
    display: block;
    padding: 16px 0 0;
    text-decoration: none;
    background: transparent;
    border-top: 1px solid rgba(216, 221, 228, 0.72);
    transition: color .15s, border-color .15s;
  }
  .post-nav-item:hover,
  .post-nav-item:focus-visible { border-top-color: rgba(220, 38, 38, 0.92); }
  .post-nav-item--right { text-align: right; }
  .post-nav-label {
    display: block;
    font-family: var(--um-font-body);
    font-size: 16px;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: #9ca3af;
    margin-bottom: 6px;
  }
  .post-nav-title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-family: var(--um-font-body);
    font-size: 16px;
    color: #374151;
    line-height: 1.4;
  }

  /* ── PROSE ──────────────────────────────────────────────────────
     :global() keeps styles in this page's bundle (not shared).
     ────────────────────────────────────────────────────────────── */

  :global(.prose) {
    font-family: var(--um-font-body);
    font-size: 1.0625rem;
    line-height: 1.84;
    color: #1f2937;
    font-weight: 400;
    overflow-wrap: anywhere;
    word-break: normal;
    -webkit-font-smoothing: antialiased;
    text-rendering: optimizeLegibility;
  }

  :global(.prose p) {
    margin: 0 0 21px;
    line-height: 1.84;
    color: #1f2937;
    overflow-wrap: anywhere;
  }

  /* Suppress empty paragraphs and lone BRs from rich-text editors */
  :global(.prose p:empty),
  :global(.prose p > br:only-child) {
    display: none;
  }

  :global(.prose > p:first-child) {
    font-size: 1.08rem;
    color: #111827;
  }

  :global(.prose h2) {
    font-family: var(--um-font-display);
    font-size: clamp(1.42rem, 1.55vw, 1.68rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.26;
    color: #000;
    margin: 46px 0 14px;
    scroll-margin-top: 5rem;
  }

  /* Eliminate double-spacing when heading follows a paragraph */
  :global(.prose p + h2) { margin-top: 52px; }
  :global(.prose p + h3) { margin-top: 34px; }

  :global(.prose h3) {
    font-family: var(--um-font-display);
    font-size: clamp(1.1rem, 1.12vw, 1.18rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.36;
    color: #1f2937;
    margin: 30px 0 9px;
    scroll-margin-top: 5rem;
  }

  :global(.prose h4) {
    font-family: var(--um-font-body);
    font-size: 16px;
    font-weight: 700;
    color: #374151;
    margin: 28px 0 6px;
    scroll-margin-top: 5rem;
  }

  :global(.prose a) {
    color: #DC2626;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(220,38,38,.32);
    text-decoration-thickness: 1px;
    overflow-wrap: anywhere;
    transition: color .15s;
  }
  :global(.prose a:hover) { color: #DC2626; }

  :global(.prose ul),
  :global(.prose ol) {
    margin: 0 0 24px 26px;
    padding: 0;
  }
  :global(.prose li) {
    margin-bottom: 8px;
    line-height: 1.74;
    color: #1f2937;
    overflow-wrap: anywhere;
  }
  :global(.prose ul) { list-style-type: disc; }
  :global(.prose ol) { list-style-type: decimal; }
  :global(.prose li::marker) { color: #9ca3af; }

  :global(.prose blockquote) {
    border-left: 3px solid #DC2626;
    padding: 2px 0 2px 24px;
    margin: 36px 0;
    color: #374151;
    font-style: normal;
    font-size: 1.12rem;
    line-height: 1.65;
    font-weight: 600;
  }
  :global(.prose blockquote p) { margin-bottom: 0; color: inherit; }

  :global(.prose strong) { font-weight: 700; color: #111827; }
  :global(.prose em) { font-style: italic; }

  :global(.prose code) {
    font-family: ui-monospace, 'Fira Code', Consolas, monospace;
    font-size: 16px;
    background: #f3f4f6;
    border-radius: 4px;
    padding: 2px 6px;
    color: #DC2626;
    font-style: normal;
  }

  :global(.prose pre) {
    font-family: ui-monospace, 'Fira Code', Consolas, monospace;
    font-size: 16px;
    line-height: 1.65;
    background: #1e293b;
    border-radius: 4px;
    padding: 22px 26px;
    overflow-x: auto;
    margin: 28px 0;
    color: #e2e8f0;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  :global(.prose pre code) {
    background: none; border: none; padding: 0;
    font-size: inherit; color: inherit;
  }

  :global(.prose img) {
    width: 100%;
    max-height: 420px;
    border-radius: 0;
    margin: 36px 0;
    display: block;
    padding: 0;
    border: 0;
    background: transparent;
    object-fit: contain;
    object-position: center;
  }
  :global(.prose figure) { margin: 36px 0; }
  :global(.prose figure img) { margin: 0 0 8px; }
  :global(.prose figcaption) {
    font-family: var(--um-font-body);
    font-size: 16px;
    color: #9ca3af;
    text-align: center;
    font-style: italic;
  }

  :global(.prose hr) {
    border: none;
    margin: 52px auto;
    width: 40px;
    height: 2px;
    background: #DC2626;
  }

  :global(.prose table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 16px;
    margin: 24px 0 32px;
    line-height: 1.6;
    font-family: var(--um-font-body);
    box-shadow: 0 1px 0 0 #e5e7eb inset, 0 -1px 0 0 #e5e7eb inset;
    border-radius: 4px;
    overflow: hidden;
  }
  :global(.prose th) {
    font-size: 16px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: #6b7280;
    background: #f9fafb;
    padding: 10px 14px;
    border-bottom: 1px solid #e5e7eb;
    text-align: left;
  }
  :global(.prose td) {
    padding: 10px 14px;
    border-bottom: 1px solid #f3f4f6;
    color: #374151;
    vertical-align: top;
  }
  :global(.prose tr:last-child td) { border-bottom: none; }
  :global(.prose tr:nth-child(even) td) { background: #fafafa; }

  @media (max-width: 899px) {
    .article-layout {
      display: block;
      max-width: 820px;
    }

    .article-body {
      max-width: 100%;
      margin: 0 auto;
    }
  }

  @media (max-width: 760px) {
    .article-page {
      padding: 30px 18px 78px;
    }

    .breadcrumbs {
      flex-wrap: wrap;
      gap: 6px;
      margin-bottom: 18px;
    }

    .article-title {
      max-width: 100%;
      font-size: clamp(2.125rem, 8.2vw, 2.32rem);
      line-height: 1.13;
      margin-bottom: 16px;
      overflow-wrap: anywhere;
    }

    .article-lead {
      font-size: 1rem;
      line-height: 1.66;
      margin-bottom: 18px;
    }

    .author-row {
      align-items: flex-start;
      margin-bottom: 22px;
    }

    .post-nav {
      grid-template-columns: 1fr;
    }

    .post-nav-item--right {
      text-align: left;
    }

    :global(.prose) {
      font-size: 1rem;
      line-height: 1.82;
    }

    :global(.prose h2) {
      font-size: clamp(1.3rem, 5.3vw, 1.58rem);
      line-height: 1.24;
      margin-top: 42px;
    }

    :global(.prose h3) {
      font-size: clamp(1.12rem, 4.8vw, 1.24rem);
      margin-top: 30px;
    }

    :global(.prose table) {
      display: block;
      overflow: visible;
      box-shadow: none;
      border-radius: 0;
    }

    :global(.prose thead),
    :global(.prose tbody),
    :global(.prose tr),
    :global(.prose th),
    :global(.prose td) {
      display: block;
      width: 100%;
    }

    :global(.prose thead) {
      display: none;
    }

    :global(.prose tr) {
      margin: 0 0 14px;
      padding: 14px 0;
      border-top: 1px solid #e5e7eb;
      border-bottom: 1px solid #e5e7eb;
    }

    :global(.prose td) {
      padding: 5px 0;
      border-bottom: 0;
      background: transparent !important;
      overflow-wrap: anywhere;
    }
  }
</style>
