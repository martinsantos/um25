---
import LayoutV4 from '../../layouts/LayoutV4.astro';
import BlogTOC from '../../components/blog/BlogTOC.astro';
import BlogCard from '../../components/blog/BlogCard.astro';
import IntentLinkGraph from '../../components/blog/BlogIntentLinks.astro';
import BlogTopicLinks from '../../components/blog/BlogTopicLinks.astro';
import { fetchBlogPost, fetchBlogListing, fetchBlogPostsBySlugs } from '../../utils/getBlogData';
import {
  addContextualTopicLinks,
  postsForCluster,
  relatedBlogSlugsByTopic,
  resolveBlogTopics,
  sectorsForTopics,
  servicesForTopics,
  topicHubHref,
} from '../../utils/blogTopicMap';
import { casesForTopics } from '../../utils/blogTopicCases';
import { SERVICE_SUMMARIES } from '../../data/serviceSummaries';
import { blogPostImageAlt, blogPostImageUrl } from '../../utils/blogHelpers';
import { addHeadingIds, getCategoryLabel, formatBlogDateLong, toIsoDate, extractFaqSchema } from '../../utils/blogUtils';
import { isReplicaIdenticalCopy, resolveReplicaH1 } from '../../utils/replicaProdCopy';
import { canonicalizeBlogSlug, canonicalizeInternalBlogLinks } from '../../utils/blogCanonicalLinks';
import { blogSeoTitleOverrides } from '../../data/seoTitleOverrides';
import { buildBlogSeoMeta } from '../../utils/seoMetaPolicy';
import { getLocalImageDimensions } from '../../utils/seoImageMeta';
import { OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH } from '../../utils/seoOgImage';
import { getAntecedentesCatalogCount } from '../../utils/verifiedProof';
import {
  buildBlogStrategicLinkGroups,
  buildStrategicWebPageStructuredData,
} from '../../data/strategicLinkGraph';

const slug = Astro.params.slug || '';
const canonicalSlug = canonicalizeBlogSlug(slug);

if (canonicalSlug !== slug) {
  return Astro.redirect(`/blog/${canonicalSlug}`, 301);
}

const post = await fetchBlogPost(slug);
const siteUrl = 'https://www.ultimamilla.com.ar';

if (!post) {
  return Astro.rewrite('/404');
}

const normalizeArticleContent = (html: string): string => {
  const replacements: Record<string, string> = {
    'El Gancho: Martín y los $500 Mensuales': 'El costo real de resolverlo a mano',
    'El Problema: RG 5824 — La Regulación que Cambió Todo': 'La exigencia operativa de RG 5824',
    'La Solución: Plantilla ARCA': 'La herramienta propuesta',
    'Cómo Funciona (Técnico, pero entendible)': 'Cómo funciona',
    'Casos de Uso: Cuatro Personas, Cuatro Soluciones': 'Casos de uso',
    'Preguntas Frecuentes (Las que realmente te importan)': 'Preguntas frecuentes',
    'Roadmap: Lo que viene (y por qué)': 'Roadmap técnico',
    'Cómo Empezar: Tres Caminos': 'Cómo empezar',
  };

  const canonicalizedHtml = canonicalizeInternalBlogLinks(html || '')
    .replace(/https?:\/\/(?:www\.)?ultimamilla\.com\.ar/gi, siteUrl);

  return Object.entries(replacements).reduce((acc, [from, to]) => {
    const escaped = from.replace(/[.*+?^${}()|[\]\\]/g, '\\$&');
    return acc.replace(new RegExp(`(<h[2-3][^>]*>)\\s*${escaped}\\s*(<\\/h[2-3]>)`, 'gi'), `$1${to}$2`);
  }, canonicalizedHtml);
};

/** Imágenes del cuerpo: carga diferida y alt presente (vacío si el CMS no lo trae). */
const hardenBodyImages = (html: string): string => html.replace(/<img\b([^>]*)>/gi, (_match, attrs: string) => {
  let next = attrs;
  if (!/\balt=/i.test(next)) next += ' alt=""';
  if (!/\bloading=/i.test(next)) next += ' loading="lazy"';
  if (!/\bdecoding=/i.test(next)) next += ' decoding="async"';
  return `<img${next}>`;
});

const normalizedContent = normalizeArticleContent(post.contenido || '');
const { html: headingHtml, headings } = await addHeadingIds(normalizedContent);
// Mapa temático: clusters de servicio y sector de esta nota, según su propio texto.
const topics = resolveBlogTopics(post);
// Enlaces contextuales: hasta 2, primera aparición de una frase clara del cluster.
const { html: linkedHtml } = addContextualTopicLinks(hardenBodyImages(headingHtml), topics, 2);
const contentHtml = linkedHtml;
const faqSchema = extractFaqSchema(contentHtml);
const imgUrl = blogPostImageUrl(post);
const imgAlt = blogPostImageAlt(post);
const coverSize = (await getLocalImageDimensions(imgUrl)) || { width: 1600, height: 900 };
const label = getCategoryLabel(post.categoria);
const publishedIso = toIsoDate(post.fecha_publicacion);
const modifiedIso = toIsoDate(post.fecha_modificacion) || publishedIso;
const publishedLabel = formatBlogDateLong(post.fecha_publicacion);
const wasUpdated = Boolean(
  publishedIso && modifiedIso
  && new Date(modifiedIso).getTime() - new Date(publishedIso).getTime() > 24 * 60 * 60 * 1000,
);
const modifiedLabel = wasUpdated ? formatBlogDateLong(modifiedIso) : '';

const blogSeo = buildBlogSeoMeta({
  title: blogSeoTitleOverrides[slug] || post.meta_title || post.titulo,
  summary: post.meta_description || post.resumen,
  category: label,
});
const seoTitle = blogSeo.title;
const seoDesc = blogSeo.description;

const buildArticleLead = (value: unknown): string => {
  const clean = String(value || '').replace(/\s+/g, ' ').trim();
  if (clean.length <= 220) return clean;
  const sentence = clean.match(/^(.{96,215}?[.!?])\s/);
  if (sentence?.[1]) return sentence[1];
  return `${clean.slice(0, 206).trimEnd()}…`;
};
const articleLead = buildArticleLead(post.resumen);

const { posts: allRecent } = await fetchBlogListing(1, 20);
const idx = allRecent.findIndex((p) => p.slug === slug);
const prevPost = idx > 0 ? allRecent[idx - 1] : null;
const nextPost = idx >= 0 && idx < allRecent.length - 1 ? allRecent[idx + 1] : null;
const otherPosts = allRecent.filter((p) => p.slug !== slug);
// Relacionados por cluster temático; si faltan, se completa con recientes de la misma categoría.
const topicRelated = await fetchBlogPostsBySlugs(relatedBlogSlugsByTopic(topics, 3));
const relatedPosts = [
  ...topicRelated,
  ...otherPosts.filter((p) => p.categoria === post.categoria),
  ...otherPosts.filter((p) => p.categoria !== post.categoria),
]
  .filter((p, index, list) => p.slug !== slug && list.findIndex((other) => other.slug === p.slug) === index)
  .slice(0, 3);
const relatedByTopic = topicRelated.length > 0;

const topicServices = servicesForTopics(topics, 2);
const topicSectors = sectorsForTopics(topics, 2);
const topicCases = casesForTopics(topics, 3);
const primaryTopic = topicServices[0]?.cluster;
const primaryHubHref = primaryTopic ? topicHubHref(primaryTopic) : null;
const topicHub = primaryTopic && primaryHubHref
  ? { href: primaryHubHref, label: primaryTopic.label, count: postsForCluster('service', primaryTopic.key).length }
  : null;
const topicServiceLinks = topicServices.map(({ cluster }) => ({
  href: cluster.href,
  label: cluster.label,
  summary: SERVICE_SUMMARIES[cluster.key]?.summary || cluster.schemaName,
}));
const topicCaseLinks = topicCases.map((item) => ({
  href: item.href,
  title: item.title,
  client: item.client,
  year: item.year,
}));

const articleUrl = `${siteUrl}/blog/${slug}`;
const ogImagePath = `/blog/og/${slug}.jpg`;
const wordCount = contentHtml.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;
const absolute = (url: string) => (url.startsWith('http') ? url : `${siteUrl}${url}`);

const articleTitleOverrides: Record<string, string> = {
  'plantilla-arca-facturacion-electronica-gratis': 'Plantilla ARCA para facturación electrónica',
};

const buildArticleTitle = (title: string): string => String(title || '')
  .replace(/\s*\([^)]*\)/g, '')
  .replace(/\bgratis\b/gi, '')
  .replace(/\s+/g, ' ')
  .trim();

const editorialArticleTitle = articleTitleOverrides[slug] || buildArticleTitle(post.titulo);
const articleTitle = isReplicaIdenticalCopy()
  ? resolveReplicaH1(`/blog/${slug}`, buildArticleTitle(post.titulo))
  : editorialArticleTitle;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${articleUrl}#article`,
  headline: articleTitle,
  description: seoDesc,
  url: articleUrl,
  datePublished: publishedIso,
  dateModified: modifiedIso,
  wordCount,
  inLanguage: 'es-AR',
  articleSection: label,
  keywords: (post.tags || []).join(', ') || undefined,
  image: [
    {
      '@type': 'ImageObject',
      url: absolute(ogImagePath),
      width: OG_IMAGE_WIDTH,
      height: OG_IMAGE_HEIGHT,
    },
    {
      '@type': 'ImageObject',
      url: absolute(imgUrl),
      width: coverSize.width,
      height: coverSize.height,
      caption: imgAlt,
    },
  ],
  author: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: 'ULTIMA MILLA',
    url: siteUrl,
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${siteUrl}/#organization`,
    name: 'ULTIMA MILLA',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/images/um-logo.png`,
      width: 2816,
      height: 1536,
    },
  },
  mainEntityOfPage: { '@type': 'WebPage', '@id': articleUrl },
  isPartOf: { '@type': 'Blog', '@id': `${siteUrl}/blog#blog`, name: 'Blog ULTIMA MILLA' },
  // Tema principal: el servicio del cluster (misma @id que la ficha de servicio).
  ...(topicServices.length > 0 && {
    about: topicServices.slice(0, 1).map(({ cluster }) => ({
      '@type': 'Service',
      '@id': `${siteUrl}${cluster.href}#service`,
      name: cluster.schemaName,
      url: `${siteUrl}${cluster.href}`,
      provider: { '@id': `${siteUrl}/#organization` },
    })),
  }),
  ...((topicServices.length > 1 || topicSectors.length > 0) && {
    mentions: [
      ...topicServices.slice(1).map(({ cluster }) => ({
        '@type': 'Service',
        '@id': `${siteUrl}${cluster.href}#service`,
        name: cluster.schemaName,
        url: `${siteUrl}${cluster.href}`,
      })),
      ...topicSectors.map(({ cluster }) => ({
        '@type': 'Thing',
        name: cluster.schemaName,
        url: `${siteUrl}${cluster.href}`,
      })),
    ],
  }),
};

// Jerarquía: Inicio → Blog → Tema (listado del cluster) o Categoría → Nota.
const crumbParent = topicHub
  ? { name: topicHub.label, url: `${siteUrl}${topicHub.href}` }
  : { name: label, url: `${siteUrl}/blog/categoria/${post.categoria}` };
Astro.locals.seoBreadcrumbs = [
  { name: 'Inicio', url: siteUrl },
  { name: 'Blog', url: `${siteUrl}/blog` },
  crumbParent,
  { name: articleTitle, url: articleUrl },
];

const articleStrategicLinkGroups = buildBlogStrategicLinkGroups({
  currentPath: `/blog/${slug}`,
  title: articleTitle,
  summary: seoDesc,
  category: label,
  tags: post.tags || [],
  text: normalizedContent.replace(/<[^>]+>/g, ' '),
  relatedPosts: [prevPost, nextPost].filter(Boolean) as any[],
  topicSectorItems: topicSectors.map(({ cluster }) => ({
    href: cluster.href,
    label: cluster.label,
    summary: cluster.schemaName,
    reason: 'La nota trata este sector.',
    eyebrow: 'Sector',
    kind: 'sector' as const,
  })),
  excludeHrefs: [...topicServiceLinks.map((item) => item.href), ...topicCaseLinks.map((item) => item.href)],
});
const articlePageStructuredData = [
  schema,
  ...(faqSchema ? [faqSchema] : []),
  buildStrategicWebPageStructuredData({
    url: articleUrl,
    name: articleTitle,
    description: seoDesc,
    groups: articleStrategicLinkGroups,
  }),
];

const catalogCount = getAntecedentesCatalogCount();
Astro.response.headers.set('Cache-Control', 'public, max-age=300, stale-while-revalidate=3600');
---

<LayoutV4
  skin="black"
  title={seoTitle}
  description={seoDesc}
  keywords={post.meta_keywords || (post.tags || []).slice(0, 6).join(', ')}
  image={ogImagePath}
  imageWidth={OG_IMAGE_WIDTH}
  imageHeight={OG_IMAGE_HEIGHT}
  ogType="article"
  canonical={articleUrl}
  structuredData={articlePageStructuredData}
>
  {publishedIso && <meta slot="head" property="article:published_time" content={publishedIso} />}
  {modifiedIso && <meta slot="head" property="article:modified_time" content={modifiedIso} />}
  <meta slot="head" property="article:author" content="ULTIMA MILLA" />
  <meta slot="head" property="article:section" content={label} />
  {post.tags && post.tags.map((tag: string) => (
    <meta slot="head" property="article:tag" content={tag} />
  ))}

  <div id="read-bar" class="bp-progress" aria-hidden="true"></div>

  <article class="bp" aria-labelledby="bp-title">
    <header class="bp-head bp-shell">
      <nav class="bp-crumbs" aria-label="Migas de pan">
        <a href="/">Inicio</a><span aria-hidden="true">/</span>
        <a href="/blog">Blog</a><span aria-hidden="true">/</span>
        <a href={crumbParent.url.replace(siteUrl, '')}>{crumbParent.name}</a>
      </nav>
      <p class="bp-kicker">{topicHub ? <a href={`/blog/categoria/${post.categoria}`}>{label}</a> : label}</p>
      <h1 id="bp-title" class="article-title bp-title">{articleTitle}</h1>
      {articleLead && <p class="article-lead bp-lead">{articleLead}</p>}
      <dl class="bp-meta">
        <div><dt>Autor</dt><dd><a href="/nosotros">ULTIMA MILLA · Equipo técnico</a></dd></div>
        {publishedLabel && <div><dt>Publicado</dt><dd><time datetime={publishedIso}>{publishedLabel}</time></dd></div>}
        {modifiedLabel && <div><dt>Actualizado</dt><dd><time datetime={modifiedIso}>{modifiedLabel}</time></dd></div>}
        {post.tiempo_lectura ? <div><dt>Lectura</dt><dd>{post.tiempo_lectura} min</dd></div> : null}
      </dl>
    </header>

    {imgUrl && (
      <figure class="bp-cover bp-shell">
        <img
          src={imgUrl}
          alt={imgAlt}
          width={coverSize.width}
          height={coverSize.height}
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
        <figcaption>Imagen ilustrativa · {imgAlt}</figcaption>
      </figure>
    )}

    <div class:list={['bp-layout', 'bp-shell', headings.length < 2 && 'bp-layout--single']}>
      <aside class="bp-aside">
        <BlogTOC headings={headings} />
      </aside>

      <div class="bp-main">
        <div class="prose" set:html={contentHtml} />

        {post.tags && post.tags.length > 0 && (
          <ul class="bp-tags" aria-label="Temas">
            {post.tags.slice(0, 8).map((tag: string) => <li>{tag}</li>)}
          </ul>
        )}

        <section class="bp-author" aria-label="Sobre el autor">
          <p class="bp-author__name">ULTIMA MILLA · Equipo técnico</p>
          <p class="bp-author__bio">
            Servicios IT integrales con sede en Guaymallén, Mendoza: redes, seguridad electrónica, telecomunicaciones,
            software, soporte y energía IT. 22+ años de trayectoria y {catalogCount} antecedentes técnicos documentados.
          </p>
          <a class="bp-author__link" href="/nosotros">Conocer la empresa <span aria-hidden="true">→</span></a>
        </section>

        {(prevPost || nextPost) && (
          <nav class="bp-pn" aria-label="Artículos contiguos">
            {prevPost ? (
              <a class="bp-pn__item" href={`/blog/${prevPost.slug}`} >
                <span class="bp-pn__label"><span aria-hidden="true">←</span> Más reciente</span>
                <span class="bp-pn__title">{prevPost.titulo}</span>
              </a>
            ) : <span></span>}
            {nextPost && (
              <a class="bp-pn__item bp-pn__item--next" href={`/blog/${nextPost.slug}`} >
                <span class="bp-pn__label">Más antiguo <span aria-hidden="true">→</span></span>
                <span class="bp-pn__title">{nextPost.titulo}</span>
              </a>
            )}
          </nav>
        )}
      </div>
    </div>
  </article>

  {relatedPosts.length > 0 && (
    <section class="bp-related bp-shell" aria-labelledby="bp-related-title">
      <p class="bp-kicker">{relatedByTopic && primaryTopic ? primaryTopic.label : 'Seguir leyendo'}</p>
      <h2 id="bp-related-title">Artículos relacionados</h2>
      <div class="bp-related__grid">
        {relatedPosts.map((related) => <BlogCard post={related} />)}
      </div>
    </section>
  )}

  {(topicServiceLinks.length > 0 || topicCaseLinks.length > 0) && (
    <div class="bp-shell bp-topic">
      <BlogTopicLinks services={topicServiceLinks} cases={topicCaseLinks} topicHub={topicHub} />
    </div>
  )}

  <div class="bp-shell bp-intent">
    <IntentLinkGraph
      class="um-intent-link-graph--contained"
      kicker="Para avanzar"
      title="Ver también"
      text="Continuá hacia capacidades técnicas, sectores o notas relacionadas."
      groups={articleStrategicLinkGroups}
    />
  </div>

  <script>
    const bar = document.getElementById('read-bar');
    const body = document.querySelector<HTMLElement>('.bp-main');
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function tick() {
      if (!bar || !body) return;
      const rect = body.getBoundingClientRect();
      const total = Math.max(1, body.offsetHeight - window.innerHeight * 0.6);
      const pct = Math.max(0, Math.min(1, -rect.top / total));
      bar.style.transform = `scaleX(${pct})`;
    }
    if (!reduce) {
      window.addEventListener('scroll', tick, { passive: true });
      tick();
    }
  </script>
</LayoutV4>

<style>
  .bp-progress {
    position: fixed; top: 0; left: 0; right: 0; height: 2px;
    background: var(--x-red); transform: scaleX(0); transform-origin: 0 50%;
    z-index: var(--um-z-progress, 60); pointer-events: none;
  }

  .bp, .bp-related, .bp-topic, .bp-intent { background: var(--x-ink); color: var(--x-text); }
  .bp-shell { width: min(var(--um-container-wide, 1400px), calc(100% - 2 * var(--x-gutter))); margin-inline: auto; }

  /* Cabecera */
  .bp-head { padding-block: clamp(32px, 4vw, 56px) 48px; }
  .bp-crumbs { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 48px; font-size: var(--x-fs-meta); color: var(--x-muted); }
  .bp-crumbs a { color: var(--x-text-2); text-decoration: none; transition: color 160ms var(--x-ease); }
  .bp-crumbs a:hover { color: var(--x-text); }
  .bp-kicker {
    display: flex; align-items: center; gap: 12px; margin: 0 0 24px;
    font-size: var(--x-fs-kicker); font-weight: 600; line-height: 1.2; letter-spacing: .12em; text-transform: uppercase; color: var(--x-muted);
  }
  .bp-kicker::before { content: ''; flex: none; width: 28px; height: 2px; background: var(--x-red); }
  .bp-title {
    margin: 0; max-width: 22ch;
    font-family: var(--um-font-editorial);
    font-size: var(--x-fs-h1) !important; line-height: 1.02 !important; font-weight: 600 !important; letter-spacing: -.025em !important;
    color: var(--x-text); text-wrap: balance;
  }
  .bp-lead { margin: 24px 0 0; max-width: 62ch; font-size: var(--x-fs-lead); line-height: 1.55; color: var(--x-text-2); }
  .bp-meta { display: flex; flex-wrap: wrap; margin: 48px 0 0; padding: 0; border-top: 1px solid var(--x-line); }
  .bp-meta div { display: flex; flex-direction: column; gap: 4px; padding: 16px 24px 0 0; margin-right: 24px; border-right: 1px solid var(--x-line); }
  .bp-meta div:last-child { border-right: 0; margin-right: 0; }
  .bp-meta dt { font-size: var(--x-fs-kicker); font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--x-muted); }
  .bp-meta dd { margin: 0; font-size: var(--x-fs-meta); line-height: 1.45; color: var(--x-text); }
  .bp-meta dd a { color: inherit; text-decoration: none; }
  .bp-meta dd a:hover { text-decoration: underline; text-underline-offset: 4px; }

  /* Portada */
  .bp-cover { margin-block: 0 clamp(48px, 6vw, 96px); }
  .bp-cover img { display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover; background: var(--x-panel); }
  .bp-cover figcaption { margin-top: 12px; font-size: var(--x-fs-meta); line-height: 1.45; color: var(--x-muted); }

  /* Cuerpo */
  .bp-layout {
    display: grid;
    grid-template-columns: minmax(200px, 260px) minmax(0, 68ch);
    justify-content: center;
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .bp-layout--single { grid-template-columns: minmax(0, 68ch); }
  .bp-layout--single .bp-aside { display: none; }
  .bp-main { min-width: 0; }

  .prose {
    font-family: var(--um-font-editorial);
    font-size: 1.125rem;
    line-height: 1.7;
    color: var(--x-text-2);
    overflow-wrap: break-word;
  }
  .prose :global(> :first-child) { margin-top: 0; }
  .prose :global(p) { margin: 0 0 1.25em; }
  .prose :global(h2) {
    margin: 2.2em 0 .7em; scroll-margin-top: 112px;
    font-size: clamp(1.625rem, 2.2vw, 2rem); line-height: 1.15; font-weight: 600; letter-spacing: -.02em; color: var(--x-text);
  }
  .prose :global(h3) {
    margin: 1.8em 0 .6em; scroll-margin-top: 112px;
    font-size: 1.3125rem; line-height: 1.3; font-weight: 600; letter-spacing: -.01em; color: var(--x-text);
  }
  .prose :global(h4) { margin: 1.6em 0 .5em; font-size: 1.0625rem; line-height: 1.35; font-weight: 600; color: var(--x-text); }
  .prose :global(strong) { font-weight: 600; color: var(--x-text); }
  .prose :global(em) { font-style: italic; }
  .prose :global(a) {
    color: var(--x-text); text-decoration: underline; text-decoration-color: var(--x-line-strong);
    text-underline-offset: 4px; text-decoration-thickness: 1px; transition: text-decoration-color 160ms var(--x-ease);
  }
  .prose :global(a:hover) { text-decoration-color: var(--x-red); }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.25em; padding-left: 1.4em; }
  .prose :global(li) { margin: .4em 0; padding-left: .2em; }
  .prose :global(li::marker) { color: var(--x-muted); }
  .prose :global(blockquote) {
    margin: 1.8em 0; padding: 4px 0 4px 24px;
    border-left: 2px solid var(--x-red);
    font-size: 1.25rem; line-height: 1.55; color: var(--x-text);
  }
  .prose :global(blockquote p:last-child) { margin-bottom: 0; }
  .prose :global(code) {
    padding: .12em .36em; border: 1px solid var(--x-line); border-radius: 4px; background: var(--x-panel-2);
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace; font-size: .86em; color: var(--x-text);
  }
  .prose :global(pre) {
    margin: 1.6em 0; padding: 20px 24px; overflow-x: auto;
    background: var(--x-panel); border: 1px solid var(--x-line);
    font-size: .9375rem; line-height: 1.6;
  }
  .prose :global(pre code) { padding: 0; border: 0; background: none; font-size: inherit; }
