---
import LayoutV4 from '../../layouts/LayoutV4.astro';
import BlogTOC from '../../components/blog/BlogTOC.astro';
import { fetchBlogPost, fetchBlogListing } from '../../utils/getBlogData';
import { blogImageUrl } from '../../utils/blogHelpers';
import { addHeadingIds, getCategoryColor, getCategoryLabel, formatBlogDate, extractFaqSchema } from '../../utils/blogUtils';

const slug = Astro.params.slug || '';
const post = await fetchBlogPost(slug);

if (!post) {
  return Astro.redirect('/blog');
}

const { html: contentHtml, headings } = await addHeadingIds(post.contenido || '');
const faqSchema = extractFaqSchema(contentHtml);
const imgUrl = blogImageUrl(post.imagen_portada);
const socialImg = post.social_image ? blogImageUrl(post.social_image) : imgUrl;
const color = getCategoryColor(post.categoria);
const label = getCategoryLabel(post.categoria);
const date = formatBlogDate(post.fecha_publicacion);

const { posts: allRecent } = await fetchBlogListing(1, 20);
const idx = allRecent.findIndex(p => p.slug === slug);
const prevPost = idx > 0 ? allRecent[idx - 1] : null;
const nextPost = idx < allRecent.length - 1 ? allRecent[idx + 1] : null;

const siteUrl = 'https://ultimamilla.com.ar';
const articleUrl = `${siteUrl}/blog/${slug}`;
const wordCount = contentHtml.replace(/<[^>]+>/g, ' ').split(/\s+/).filter(Boolean).length;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': `${articleUrl}#article`,
  headline: post.titulo,
  description: post.resumen,
  url: articleUrl,
  datePublished: post.fecha_publicacion,
  dateModified: post.fecha_modificacion || post.fecha_publicacion,
  wordCount,
  inLanguage: 'es-AR',
  articleSection: label,
  keywords: (post.tags || []).join(', '),
  image: imgUrl ? {
    '@type': 'ImageObject',
    url: imgUrl.startsWith('http') ? imgUrl : `${siteUrl}${imgUrl}`,
    name: post.imagen_portada_alt || post.titulo,
  } : undefined,
  author: {
    '@type': 'Organization',
    name: 'ULTIMA MILLA',
    url: siteUrl,
    logo: { '@type': 'ImageObject', url: `${siteUrl}/images/um-logo.png` },
    sameAs: ['https://www.linkedin.com/company/ultimamilla'],
  },
  publisher: {
    '@type': 'Organization',
    name: 'ULTIMA MILLA',
    url: siteUrl,
    logo: {
      '@type': 'ImageObject',
      url: `${siteUrl}/images/um-logo.png`,
      width: 600,
      height: 60,
    },
  },
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': articleUrl,
  },
  isPartOf: {
    '@type': 'Blog',
    '@id': `${siteUrl}/blog`,
    name: 'Blog ULTIMA MILLA',
  },
};

// SEO title/description with length limits
const rawBlogTitle = post.meta_title || `${post.titulo} | ULTIMA MILLA`;
const seoTitle = rawBlogTitle.length > 60 ? `${post.titulo.slice(0, 45).trimEnd()}... | ULTIMA MILLA` : rawBlogTitle;
const rawBlogDesc = post.meta_description || post.resumen?.substring(0, 158) || '';
const seoDesc = rawBlogDesc.length > 160 ? rawBlogDesc.slice(0, 157) + '...' : rawBlogDesc;
---

<LayoutV4
  title={seoTitle}
  description={seoDesc}
  keywords={post.meta_keywords || (post.tags || []).slice(0, 6).join(', ')}
  image={socialImg || imgUrl || undefined}
  ogType="article"
  canonical={articleUrl}
  structuredData={faqSchema ? [schema, faqSchema] : schema}
>
  <!-- Article meta -->
  <meta slot="head" property="article:published_time" content={post.fecha_publicacion} />
  <meta slot="head" property="article:author" content="ULTIMA MILLA" />
  <meta slot="head" property="article:section" content={label} />
  {post.tags && post.tags.map((tag: string) => (
    <meta slot="head" property="article:tag" content={tag} />
  ))}
  <link
    slot="head"
    href="https://fonts.googleapis.com/css2?family=Merriweather:ital,wght@0,300;0,400;0,700;1,300;1,400&family=Inter:wght@400;500;600;700;800&display=swap"
    rel="stylesheet"
  />

  <div id="read-bar" class="read-bar"></div>

  <main class="article-page">

    <div class="article-layout">
      <BlogTOC headings={headings} title={post.titulo} />

      <article class="article-body">

        <nav class="breadcrumbs" aria-label="Navegación">
          <a href="/" class="bc-link">ULTIMA MILLA</a>
          <span class="bc-sep">/</span>
          <a href="/blog" class="bc-link">Blog</a>
          <span class="bc-sep">/</span>
          <span class="bc-cat" style={`color:${color}`}>{label}</span>
        </nav>

        <h1 class="article-title">{post.titulo}</h1>

        {post.resumen && <p class="article-lead">{post.resumen}</p>}

        <div class="author-row">
          <div class="author-avatar">UM</div>
          <div>
            <p class="author-name">ULTIMA MILLA</p>
            <p class="author-meta">{date} · {post.tiempo_lectura} min de lectura</p>
          </div>
        </div>

        <hr class="article-divider" />

        {imgUrl && (
          <figure class="hero-figure">
            <img src={imgUrl} alt={post.titulo} class="hero-img" />
          </figure>
        )}

        <div class="prose" set:html={contentHtml} />

        {post.tags && post.tags.length > 0 && (
          <div class="tags-row">
            {post.tags.map((tag: string) => (
              <span class="tag">#{tag}</span>
            ))}
          </div>
        )}

        <nav class="post-nav">
          {prevPost ? (
            <a href={`/blog/${prevPost.slug}`} class="post-nav-item">
              <span class="post-nav-label">← Anterior</span>
              <span class="post-nav-title">{prevPost.titulo}</span>
            </a>
          ) : <div></div>}
          {nextPost && (
            <a href={`/blog/${nextPost.slug}`} class="post-nav-item post-nav-item--right">
              <span class="post-nav-label">Siguiente →</span>
              <span class="post-nav-title">{nextPost.titulo}</span>
            </a>
          )}
        </nav>

      </article>
    </div>
  </main>

  <script>
    const bar = document.getElementById('read-bar');
    const art = document.querySelector('.article-body');
    function tick() {
      if (!bar || !art) return;
      const r = art.getBoundingClientRect();
      const pct = Math.max(0, Math.min(100, (-r.top / (art.scrollHeight - window.innerHeight)) * 100));
      bar.style.width = pct + '%';
    }
    window.addEventListener('scroll', tick, { passive: true });
    tick();
  </script>
</LayoutV4>

<style>
  /* Reading progress */
  .read-bar {
    position: fixed;
    top: 0;
    left: 0;
    height: 2px;
    width: 0%;
    background: #111827;
    z-index: 9999;
    transition: width 0.1s linear;
  }

  /* Page shell */
  .article-page {
    min-height: 100vh;
    background: #fff;
    padding: 48px 24px 96px;
  }

  .article-layout {
    max-width: 1160px;
    margin: 0 auto;
    display: flex;
    gap: 72px;
    align-items: flex-start;
  }

  /* Article body */
  .article-body {
    flex: 1;
    min-width: 0;
    max-width: 680px;
    margin: 0 auto;
  }

  /* Breadcrumbs */
  .breadcrumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 28px;
  }
  .bc-link {
    font-family: Inter, system-ui, sans-serif;
    font-size: 13px;
    color: #9ca3af;
    text-decoration: none;
    transition: color .15s;
  }
  .bc-link:hover { color: #374151; text-decoration: underline; text-underline-offset: 3px; }
  .bc-sep { color: #d1d5db; font-size: 13px; }
  .bc-cat {
    font-family: Inter, system-ui, sans-serif;
    font-size: 13px;
    font-weight: 600;
  }

  /* Title & lead */
  .article-title {
    font-family: 'Merriweather', Georgia, serif;
    font-size: clamp(26px, 4.5vw, 42px);
    font-weight: 700;
    line-height: 1.2;
    letter-spacing: -0.02em;
    color: #111827;
    margin: 0 0 20px;
  }
  .article-lead {
    font-family: 'Merriweather', Georgia, serif;
    font-size: 20px;
    font-weight: 300;
    font-style: italic;
    line-height: 1.7;
    color: #4b5563;
    margin: 0 0 24px;
  }

  /* Author */
  .author-row {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 24px;
  }
  .author-avatar {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background: linear-gradient(135deg,#1e40af,#3b82f6);
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    font-family: Inter, system-ui, sans-serif;
    font-size: 12px;
    font-weight: 700;
    color: #fff;
  }
  .author-name {
    font-family: Inter, system-ui, sans-serif;
    font-size: 14px;
    font-weight: 600;
    color: #111827;
    margin: 0;
  }
  .author-meta {
    font-family: Inter, system-ui, sans-serif;
    font-size: 13px;
    color: #9ca3af;
    margin: 0;
  }

  .article-divider {
    border: none;
    border-top: 1px solid #f3f4f6;
    margin: 0 0 32px;
  }

  /* Hero image */
  .hero-figure { margin: 0 0 40px; }
  .hero-img {
    width: 100%;
    max-height: 460px;
    object-fit: cover;
    border-radius: 10px;
    box-shadow: 0 1px 4px rgba(0,0,0,.07);
  }

  /* Tags */
  .tags-row {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 56px;
    padding-top: 28px;
    border-top: 1px solid #f3f4f6;
  }
  .tag {
    font-family: Inter, system-ui, sans-serif;
    font-size: 12px;
    color: #6b7280;
    border: 1px solid #e5e7eb;
    border-radius: 999px;
    padding: 4px 14px;
  }

  /* Prev/next nav */
  .post-nav {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-top: 40px;
    padding-top: 28px;
    border-top: 1px solid #f3f4f6;
  }
  .post-nav-item {
    display: block;
    padding: 18px;
    border: 1px solid #e5e7eb;
    border-radius: 10px;
    text-decoration: none;
    transition: border-color .15s, background .15s;
  }
  .post-nav-item:hover { border-color: #d1d5db; background: #f9fafb; }
  .post-nav-item--right { text-align: right; }
  .post-nav-label {
    display: block;
    font-family: Inter, system-ui, sans-serif;
    font-size: 10px;
    text-transform: uppercase;
    letter-spacing: .08em;
    color: #9ca3af;
    margin-bottom: 6px;
  }
  .post-nav-title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    font-family: Inter, system-ui, sans-serif;
    font-size: 14px;
    color: #374151;
    line-height: 1.4;
  }

  /* ── PROSE ──────────────────────────────────────────────────────
     :global() keeps styles in this page's bundle (not shared).
     ────────────────────────────────────────────────────────────── */

  :global(.prose) {
    font-family: 'Merriweather', Georgia, 'Times New Roman', serif;
    font-size: 18px;
    line-height: 1.8;
    color: #1f2937;
    font-weight: 400;
    -webkit-font-smoothing: antialiased;
  }

  :global(.prose p) {
    margin: 0 0 22px;
    line-height: 1.8;
    color: #1f2937;
  }

  /* Suppress empty paragraphs and lone BRs from rich-text editors */
  :global(.prose p:empty),
  :global(.prose p > br:only-child) {
    display: none;
  }

  :global(.prose > p:first-child) {
    font-size: 19px;
    color: #111827;
  }

  :global(.prose h2) {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 24px;
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.3;
    color: #111827;
    margin: 52px 0 12px;
    scroll-margin-top: 5rem;
  }

  /* Eliminate double-spacing when heading follows a paragraph */
  :global(.prose p + h2) { margin-top: 48px; }
  :global(.prose p + h3) { margin-top: 32px; }

  :global(.prose h3) {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 19px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.35;
    color: #1f2937;
    margin: 36px 0 8px;
    scroll-margin-top: 5rem;
  }

  :global(.prose h4) {
    font-family: 'Inter', system-ui, sans-serif;
    font-size: 16px;
    font-weight: 600;
    color: #374151;
    margin: 28px 0 6px;
    scroll-margin-top: 5rem;
  }

  :global(.prose a) {
    color: #1d4ed8;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: rgba(29,78,216,.3);
    text-decoration-thickness: 1px;
    transition: color .15s;
  }
  :global(.prose a:hover) { color: #1e40af; }

  :global(.prose ul),
  :global(.prose ol) {
    margin: 0 0 22px 24px;
    padding: 0;
  }
  :global(.prose li) {
    margin-bottom: 6px;
    line-height: 1.7;
    color: #1f2937;
  }
  :global(.prose ul) { list-style-type: disc; }
  :global(.prose ol) { list-style-type: decimal; }
  :global(.prose li::marker) { color: #9ca3af; }

  :global(.prose blockquote) {
    border-left: 3px solid #d1d5db;
    padding: 2px 0 2px 24px;
    margin: 36px 0;
    color: #6b7280;
    font-style: italic;
    font-size: 20px;
    line-height: 1.65;
    font-weight: 300;
  }
  :global(.prose blockquote p) { margin-bottom: 0; color: inherit; }

  :global(.prose strong) { font-weight: 700; color: #111827; }
  :global(.prose em) { font-style: italic; }

  :global(.prose code) {
    font-family: ui-monospace, 'Fira Code', Consolas, monospace;
    font-size: 14px;
    background: #f3f4f6;
    border: 1px solid #e5e7eb;
    border-radius: 4px;
    padding: 2px 6px;
    color: #dc2626;
    font-style: normal;
  }

  :global(.prose pre) {
    font-family: ui-monospace, 'Fira Code', Consolas, monospace;
    font-size: 14px;
    line-height: 1.65;
    background: #1e293b;
    border-radius: 10px;
    padding: 22px 26px;
    overflow-x: auto;
    margin: 28px 0;
    color: #e2e8f0;
  }
  :global(.prose pre code) {
    background: none; border: none; padding: 0;
    font-size: inherit; color: inherit;
  }

  :global(.prose img) {
    width: 100%;
    border-radius: 8px;
    margin: 36px 0;
    display: block;
    box-shadow: 0 1px 4px rgba(0,0,0,.07);
  }
  :global(.prose figure) { margin: 36px 0; }
  :global(.prose figure img) { margin: 0 0 8px; }
  :global(.prose figcaption) {
    font-family: Inter, system-ui, sans-serif;
    font-size: 13px;
    color: #9ca3af;
    text-align: center;
    font-style: italic;
  }

  :global(.prose hr) {
    border: none;
    margin: 52px auto;
    width: 40px;
    height: 2px;
    background: #d1d5db;
  }

  :global(.prose table) {
    width: 100%;
    border-collapse: collapse;
    font-size: 15px;
    margin: 24px 0 32px;
    line-height: 1.6;
    font-family: Inter, system-ui, sans-serif;
    box-shadow: 0 0 0 1px #e5e7eb;
    border-radius: 8px;
    overflow: hidden;
  }
  :global(.prose th) {
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: .06em;
    color: #6b7280;
    background: #f9fafb;
    padding: 10px 14px;
    border-bottom: 1px solid #e5e7eb;
    text-align: left;
  }
  :global(.prose td) {
    padding: 10px 14px;
    border-bottom: 1px solid #f3f4f6;
    color: #374151;
    vertical-align: top;
  }
  :global(.prose tr:last-child td) { border-bottom: none; }
  :global(.prose tr:nth-child(even) td) { background: #fafafa; }
</style>
