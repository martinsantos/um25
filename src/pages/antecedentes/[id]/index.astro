---
// Página de redirección para antecedentes individuales
// Redirige a la página principal de antecedentes hasta que se solucionen las páginas dinámicas

export const prerender = true;

export async function getStaticPaths() {
    // Generar rutas para todos los IDs de antecedentes disponibles
    const allIds = [];
    
    // Rango principal de IDs (basado en los datos disponibles)
    for (let i = 10768; i <= 10850; i++) {
        allIds.push(i.toString());
    }
    
    // IDs adicionales comunes que podrían existir
    const additionalIds = [
        '1', '2', '3', '4', '5', '10', '15', '20', '25', '30',
        '100', '200', '300', '400', '500', '1000', '2000', '3000'
    ];
    
    allIds.push(...additionalIds);
    
    return allIds.map(id => ({
        params: { id }
    }));
}

const { id } = Astro.params;

// Redirigir a la página principal de antecedentes
return Astro.redirect('/antecedentes');
--- 