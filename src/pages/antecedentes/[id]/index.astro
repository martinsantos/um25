import { fetchDirectus } from '../../../utils/directus';
import { generateSlug } from '../../../utils/slugUtils';

const { id } = Astro.params;

if (!id) {
    return Astro.redirect('/antecedentes');
}

try {
    // Intentar obtener el título del antecedente para generar el slug
    const response = await fetchDirectus(`/items/antecedentes/${id}?fields=id,Titulo`);
    const item = response?.data;

    if (item && item.Titulo) {
        const slug = generateSlug(item.Titulo);
        return Astro.redirect(`/antecedentes/${id}/${slug}`, 301);
    }
} catch (error) {
    console.error(`Error al buscar antecedente ${id} para redirección:`, error);
}

// Si no se encuentra o hay error, redirigir a la lista general
// O devolver 404 si preferimos evitar el Soft 404
return Astro.redirect('/antecedentes', 302);
