            </svg>
          </a>
        </div>

        <div class="case-related__grid">
          {relatedAntecedentes.map((ant) => (
            <ProjectCard
              id={String(ant.id)}
              titulo={compactCaseTitle(ant.Titulo || 'Proyecto', ant.Cliente)}
              cliente={ant.Cliente || ''}
              descripcion={ant.Descripcion || ''}
              fecha={ant.Fecha || new Date().toISOString()}
              area={ant.Area || ''}
              servicio={ant.Unidad_de_negocio || ''}
              imagen={ant.imageUrl}
              slug={ant.slug}
            />
          ))}
        </div>

        <div class="case-related__footer">
          <a href="/antecedentes">
            Explorar archivo completo
            <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </div>
    </section>
  )}

  <!-- CTA SECTION -->
  <CTASection
    badge="Evidencia operativa"
    badgeIcon="arrow-right"
    titulo="Convirtamos esta experiencia en un alcance para su operación"
    descripcion="Revisamos sitio, riesgo, dependencias y prioridad técnica antes de proponer una intervención."
    primaryButtonText="Solicitar relevamiento"
    primaryButtonUrl="/contacto"
    secondaryButtonText="Ver antecedentes"
    secondaryButtonUrl="/antecedentes"
    secondaryButtonIcon="arrow-right"
    backgroundImage={mainImageUrl}
    darkOverlay={85}
  />
</LayoutV4>

