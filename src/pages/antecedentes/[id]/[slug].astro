---
/**
 * Antecedente Detail Page - V4 Design System
 * Case study/project detail with enhanced design matching V4 template
 */

import LayoutV4 from '../../../layouts/LayoutV4.astro';
import ServiceCard from '../../../components/v4/ServiceCard.astro';
import CTASection from '../../../components/v4/CTASection.astro';
import { generateSlug } from '../../../utils/slugUtils.js';
import { getServicioById } from '../../../utils/directusHelpers';
import { getServiceIdFromArea } from '../../../data/areaToServiceMap.js';
import ProjectCard from '../../../components/ProjectCard.astro';
import { getDirectusImageUrl, getAllAntecedentes } from '../../../lib/directus.ts';
import { canonicalUrl as toCanonicalUrl, publicImageUrl } from '../../../utils/seoUrl';

// --- Configuration ---
const DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL || 'https://ultimamilla.com.ar/admin';
const PROD_URL = 'https://ultimamilla.com.ar';
const DEFAULT_IMAGE_URL = `/images/default-background.jpg`;
const DIRECTUS_STATIC_TOKEN = import.meta.env.DIRECTUS_STATIC_TOKEN || import.meta.env.PUBLIC_DIRECTUS_TOKEN || '';

export const prerender = false;

// URL params
const { id, slug: slugFromUrl } = Astro.params;

if (!id || !slugFromUrl) {
    return Astro.redirect('/404');
}

// --- State ---
let antecedente: any = null;
let usingFallback = false;

// --- Helper Functions ---
const getAssetUrl = (assetId: any): string => {
    if (!assetId) return DEFAULT_IMAGE_URL;

    // Handle object with nested ID properties
    if (typeof assetId === 'object') {
        if (assetId.id) return getDirectusImageUrl(assetId.id);
        if (assetId.directus_files_id) return getDirectusImageUrl(assetId.directus_files_id);
    }

    // Handle string UUIDs
    if (typeof assetId === 'string') {
        if (assetId.startsWith('http')) return assetId;
        const url = getDirectusImageUrl(assetId);
        if (url) return url;
    }

    return DEFAULT_IMAGE_URL;
};

// --- Fetch Data ---
async function fetchAntecedenteById(itemId: string) {
    try {
        const response = await fetch(`${DIRECTUS_URL}/items/Antecedentes/${itemId}?fields=*,Imagen.*,ImagenPrincipal.*,Imagenes.*,Imagenes.directus_files_id`, {
            headers: {
                'Authorization': `Bearer ${DIRECTUS_STATIC_TOKEN}`,
                'Accept': 'application/json'
            }
        });
        if (!response.ok) throw new Error(`API Error: ${response.status}`);
        const data = await response.json();
        return data?.data || null;
    } catch (error) {
        console.error(`Error fetching item ${itemId}:`, error);
        throw error;
    }
}

// --- Get data and validate ---
try {
    if (DIRECTUS_STATIC_TOKEN) {
        antecedente = await fetchAntecedenteById(id);
        if (antecedente) {
            const expectedSlug = generateSlug(antecedente.Titulo);
            if (expectedSlug !== slugFromUrl) {
                return Astro.redirect(`/antecedentes/${id}/${expectedSlug}`, 301);
            }
        }
    } else {
        throw new Error('No token');
    }
} catch (error) {
    usingFallback = true;
    try {
        // Fallback: buscar en snapshot completo (518 antecedentes)
        const snapshot = await import('../../../data/snapshots/antecedentes.json');
        const allAntecedentes = (snapshot.data || snapshot.default?.data || []) as any[];
        antecedente = allAntecedentes.find((item: any) => item.id?.toString() === id);
        if (antecedente) {
            const expectedSlug = generateSlug(antecedente.Titulo);
            if (expectedSlug !== slugFromUrl) {
                return Astro.redirect(`/antecedentes/${id}/${expectedSlug}`, 301);
            }
        } else {
            return Astro.redirect('/404');
        }
    } catch (fallbackError) {
        return Astro.redirect('/404');
    }
}

if (!antecedente) return Astro.redirect('/404');

// --- Prepare data for UI (Directus-first) ---
const mainImageUrl = getAssetUrl(antecedente.Imagen || antecedente.ImagenPrincipal);

const formatDate = (dateString: string): string => {
    if (!dateString) return 'No especificada';
    try {
        return new Date(dateString).toLocaleDateString('es-ES', { year: 'numeric', month: 'long' });
    } catch { return dateString; }
};

// Extract scope items from description (bullet points)
const extractScopeItems = (descripcion: string): string[] => {
    if (!descripcion) return [];
    const items: string[] = [];
    // Try to extract bullet points or sentences
    const sentences = descripcion.split(/[.;]/).filter(s => s.trim().length > 10 && s.trim().length < 150);
    return sentences.slice(0, 5).map(s => s.trim());
};

const scopeItems = extractScopeItems(antecedente.Descripcion || '');

// Mapeo de colores por categoría/sector (mismo que ProjectCard)
const getCategoryColors = (category: string): { bg: string; text: string; darkBg: string } => {
  const normalizedCategory = category?.toLowerCase().trim() || '';

  const colorMap: Record<string, { bg: string; text: string; darkBg: string }> = {
    'gobierno': { bg: 'bg-blue-500', text: 'text-white', darkBg: 'bg-blue-600' },
    'sector público': { bg: 'bg-blue-500', text: 'text-white', darkBg: 'bg-blue-600' },
    'municipal': { bg: 'bg-blue-500', text: 'text-white', darkBg: 'bg-blue-600' },
    'municipalidad': { bg: 'bg-blue-500', text: 'text-white', darkBg: 'bg-blue-600' },
    'aeropuertos': { bg: 'bg-sky-500', text: 'text-white', darkBg: 'bg-sky-600' },
    'aeropuerto': { bg: 'bg-sky-500', text: 'text-white', darkBg: 'bg-sky-600' },
    'transporte': { bg: 'bg-sky-500', text: 'text-white', darkBg: 'bg-sky-600' },
    'bodegas': { bg: 'bg-purple-500', text: 'text-white', darkBg: 'bg-purple-600' },
    'bodega': { bg: 'bg-purple-500', text: 'text-white', darkBg: 'bg-purple-600' },
    'vitivinícola': { bg: 'bg-purple-500', text: 'text-white', darkBg: 'bg-purple-600' },
    'agroindustria': { bg: 'bg-purple-500', text: 'text-white', darkBg: 'bg-purple-600' },
    'salud': { bg: 'bg-green-500', text: 'text-white', darkBg: 'bg-green-600' },
    'hospital': { bg: 'bg-green-500', text: 'text-white', darkBg: 'bg-green-600' },
    'clínica': { bg: 'bg-green-500', text: 'text-white', darkBg: 'bg-green-600' },
    'médico': { bg: 'bg-green-500', text: 'text-white', darkBg: 'bg-green-600' },
    'data center': { bg: 'bg-orange-500', text: 'text-white', darkBg: 'bg-orange-600' },
    'datacenter': { bg: 'bg-orange-500', text: 'text-white', darkBg: 'bg-orange-600' },
    'infraestructura': { bg: 'bg-orange-500', text: 'text-white', darkBg: 'bg-orange-600' },
    'ti': { bg: 'bg-orange-500', text: 'text-white', darkBg: 'bg-orange-600' },
    'construcción': { bg: 'bg-amber-500', text: 'text-white', darkBg: 'bg-amber-600' },
    'constructora': { bg: 'bg-amber-500', text: 'text-white', darkBg: 'bg-amber-600' },
    'obra': { bg: 'bg-amber-500', text: 'text-white', darkBg: 'bg-amber-600' },
    'industria': { bg: 'bg-indigo-500', text: 'text-white', darkBg: 'bg-indigo-600' },
    'industrial': { bg: 'bg-indigo-500', text: 'text-white', darkBg: 'bg-indigo-600' },
    'manufactura': { bg: 'bg-indigo-500', text: 'text-white', darkBg: 'bg-indigo-600' },
    'fábrica': { bg: 'bg-indigo-500', text: 'text-white', darkBg: 'bg-indigo-600' },
    'software': { bg: 'bg-cyan-500', text: 'text-white', darkBg: 'bg-cyan-600' },
    'desarrollo': { bg: 'bg-cyan-500', text: 'text-white', darkBg: 'bg-cyan-600' },
    'aplicación': { bg: 'bg-cyan-500', text: 'text-white', darkBg: 'bg-cyan-600' },
    'minería': { bg: 'bg-slate-500', text: 'text-white', darkBg: 'bg-slate-600' },
    'minera': { bg: 'bg-slate-500', text: 'text-white', darkBg: 'bg-slate-600' },
    'mining': { bg: 'bg-slate-500', text: 'text-white', darkBg: 'bg-slate-600' },
    'seguridad': { bg: 'bg-red-500', text: 'text-white', darkBg: 'bg-red-600' },
    'seguridad electrónica': { bg: 'bg-red-500', text: 'text-white', darkBg: 'bg-red-600' },
    'cctv': { bg: 'bg-red-500', text: 'text-white', darkBg: 'bg-red-600' },
    'telecomunicaciones': { bg: 'bg-teal-500', text: 'text-white', darkBg: 'bg-teal-600' },
    'redes': { bg: 'bg-teal-500', text: 'text-white', darkBg: 'bg-teal-600' },
    'redes y comunicaciones': { bg: 'bg-teal-500', text: 'text-white', darkBg: 'bg-teal-600' },
    'comunicaciones': { bg: 'bg-teal-500', text: 'text-white', darkBg: 'bg-teal-600' },
  };

  for (const [key, colors] of Object.entries(colorMap)) {
    if (normalizedCategory.includes(key) || key.includes(normalizedCategory)) {
      return colors;
    }
  }

  return { bg: 'bg-um-primary', text: 'text-white', darkBg: 'bg-um-primary-dark' };
};

const areaCategoryColors = getCategoryColors(antecedente.Area || '');

// Get related services via M2M relationship from Directus (with fallback to area mapping)
const getRelatedServices = async (antecedenteId: string, area: string) => {
    // TODO: Re-enable M2M relationship when function is available in directusHelpers.ts
    // try {
    //     // Try to get M2M related services from Directus
    //     const serviciosFromDirectus = await getServiciosPorAntecedente(parseInt(antecedenteId));
    //
    //     if (serviciosFromDirectus && serviciosFromDirectus.length > 0) {
    //         return serviciosFromDirectus.slice(0, 4); // Max 4 services
    //     }
    // } catch (error) {
    //     console.error('Error fetching related services from Directus:', error);
    // }

    // Fallback: Use area-based mapping to find one service from Directus
    try {
        const serviceId = getServiceIdFromArea(area);
        const servicio = await getServicioById(serviceId);

        if (servicio) {
            return [{
                id: serviceId,
                Titulo: servicio.Titulo,
                Descripcion: servicio.Descripcion,
                Imagen: servicio.Imagen,
                subtitulo: servicio.Descripcion?.substring(0, 100),
                slug: generateSlug(servicio.Titulo)
            }];
        }
    } catch (error) {
        console.error('Error fetching service by area mapping:', error);
    }

    return [];
};

const relatedServices = await getRelatedServices(id, antecedente.Area || '');

const getRelatedAntecedentes = async (area: string, excludeId: string, limit: number = 3) => {
  try {
    const all = await getAllAntecedentes();
    return all
      .filter(item => {
        if (String(item.id) === excludeId) return false;
        const itemArea = (item.Area || '').toLowerCase();
        const searchArea = (area || '').toLowerCase();
        return itemArea.includes(searchArea) || searchArea.includes(itemArea);
      })
      .slice(0, limit)
      .map(item => ({
        ...item,
        slug: generateSlug(item.Titulo || 'proyecto'),
        imageUrl: getDirectusImageUrl(item.Imagen)
      }));
  } catch {
    return [];
  }
};

const relatedAntecedentes = await getRelatedAntecedentes(antecedente.Area || '', id);

const cleanDisplayText = (value: unknown) => String(value || '')
  .replace(/<[^>]+>/g, '')
  .replace(/\s+/g, ' ')
  .trim();

const buildCaseHeadline = (item: any): string => {
  const title = cleanDisplayText(item.Titulo || item.Nombre || 'Proyecto técnico documentado');
  const client = cleanDisplayText(item.Cliente);
  const area = cleanDisplayText(item.Area);
  const normalized = title.toLowerCase();

  if (normalized.includes('digitalización') || normalized.includes('digitalizacion') || normalized.includes('software')) {
    if (client) return `Software operativo para ${client}`;
    return 'Software operativo documentado';
  }
  if (normalized.includes('soporte')) {
    if (client) return `Soporte IT documentado para ${client}`;
    return 'Soporte IT documentado';
  }
  if (normalized.includes('cctv') || normalized.includes('cámara') || normalized.includes('camara')) {
    if (client) return `CCTV operativo para ${client}`;
    return 'CCTV operativo documentado';
  }
  if (normalized.includes('detección') || normalized.includes('deteccion') || normalized.includes('incendio')) {
    if (client) return `Detección y seguridad para ${client}`;
    return 'Detección y seguridad documentada';
  }
  if (normalized.includes('redes') || normalized.includes('fibra')) {
    if (client) return `Redes y fibra para ${client}`;
    return 'Redes y fibra documentadas';
  }
  if (normalized.includes('eléctrica') || normalized.includes('electrica') || normalized.includes('data center')) {
    if (client) return `Energía IT para ${client}`;
    return 'Energía IT documentada';
  }

  const beforeDash = title.split(/\s[-–]\s/)[0]?.trim() || title;
  if (beforeDash.length <= 74) return beforeDash;
  if (client && area) return `${area} para ${client}`.slice(0, 82);
  if (client) return `Proyecto técnico para ${client}`.slice(0, 82);
  return `${beforeDash.slice(0, 72).trimEnd()}…`;
};

const caseHeadline = buildCaseHeadline(antecedente);
const compactServiceTitle = (value: unknown): string => {
  const title = cleanDisplayText(value)
    .replace(/\s*\|.*$/g, '')
    .trim();
  const replacements: Record<string, string> = {
    'Infraestructura de Redes': 'Redes e infraestructura',
    'Sistemas de Seguridad Electrónica': 'Seguridad electrónica',
    'Telecomunicaciones.': 'Telecomunicaciones',
    'Desarrollo de Software a Medida': 'Software operativo',
    'Soporte Técnico 24/7': 'Soporte técnico 24/7',
    'Consultoría IT y Transformación Digital': 'Consultoría IT',
    'Sistemas de Detección y Alarma de Incendios': 'Detección de incendios',
    'Servicios Eléctricos para IT': 'Energía para IT'
  };
  return replacements[title] || title || 'Servicio IT';
};
const compactCaseTitle = (value: unknown, client?: unknown): string => {
  const title = cleanDisplayText(value)
    .replace(/Sistena/gi, 'Sistema')
    .replace(/\s+\(\d+\)$/g, '')
    .trim();
  const organization = cleanDisplayText(client);
  if (!title) return organization || 'Proyecto técnico';

  const parts = title.split(/\s[-–]\s/).map((part) => part.trim()).filter(Boolean);
  let base = parts[0] || title;
  base = base
    .replace(/Soporte de Infraestructura IT de Alta Disponibilidad/gi, 'Soporte IT de alta disponibilidad')
    .replace(/Implementación de Redes de Datos y Fibra Óptica/gi, 'Redes y fibra óptica')
    .replace(/Instalación eléctrica para Data Center/gi, 'Energía para data center')
    .replace(/Sistema Detección de Incendios/gi, 'Detección de incendios');

  const target = parts[1] && !/^\d{4}|abril|mayo|junio|julio|agosto|septiembre|octubre|noviembre|diciembre/i.test(parts[1])
    ? parts[1]
    : organization;
  const composed = target ? `${base}: ${target}` : base;
  return composed.length > 78 ? `${composed.slice(0, 75).trimEnd()}...` : composed;
};

// SEO
const siteUrl = 'https://ultimamilla.com.ar';
const canonicalUrl = toCanonicalUrl(`/antecedentes/${id}/${slugFromUrl}`);
const metaDescription = (antecedente.Descripcion || '').replace(/<[^>]+>/g, '').substring(0, 160) + '...';
const antecedenteStructuredData = {
  "@type": "CreativeWork",
  "name": antecedente.Titulo,
  "headline": antecedente.Titulo,
  "description": metaDescription,
  "url": canonicalUrl,
  "image": publicImageUrl(mainImageUrl) || toCanonicalUrl(DEFAULT_IMAGE_URL),
  "datePublished": antecedente.Fecha || undefined,
  "inLanguage": "es-AR",
  "about": antecedente.Area || undefined,
  "provider": {
    "@type": "Organization",
    "name": "ULTIMA MILLA",
    "url": siteUrl
  }
};
---

<LayoutV4
  title={`${antecedente.Titulo} | Caso de Éxito - ULTIMA MILLA`}
  description={metaDescription}
  image={mainImageUrl}
  canonical={canonicalUrl}
  structuredData={antecedenteStructuredData}
>
  <section class="case-detail-hero">
    <img
      src={mainImageUrl}
      alt={antecedente.Titulo}
      class="case-detail-hero__image"
      onerror="this.src='/images/default-background.jpg'"
    />
    <div class="case-detail-hero__wash"></div>

    <div class="um-container case-detail-hero__content">
      <nav class="case-detail-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Inicio</a>
        <span>/</span>
        <a href="/antecedentes">Antecedentes</a>
        <span>/</span>
        <span>{antecedente.Area || 'Proyecto'}</span>
      </nav>

      <div class="case-detail-hero__grid">
        <div class="case-detail-hero__copy">
          <div class={`case-detail-label ${areaCategoryColors.bg}`}>
            <span>{antecedente.Area || 'Proyecto'}</span>
          </div>

          <h1>{caseHeadline}</h1>

          <p>
            {antecedente.Descripcion?.replace(/<[^>]+>/g, '').substring(0, 170)}...
          </p>

          <div class="case-detail-actions">
            <a href="/contacto">Solicitar relevamiento</a>
            <a href="/antecedentes">Volver al archivo</a>
          </div>
        </div>

        <aside class="case-detail-dossier" aria-label="Dossier documental del antecedente">
          <div class="case-detail-dossier__body">
            <span>Dossier del proyecto</span>
            <strong>{antecedente.Cliente || 'ULTIMA MILLA'}</strong>
            <div class="case-detail-meta">
              <div>
                <span>Vertical</span>
                <strong>{antecedente.Area || 'Tecnología'}</strong>
              </div>
              {antecedente.Fecha && (
                <div>
                  <span>Fecha</span>
                  <strong>{formatDate(antecedente.Fecha)}</strong>
                </div>
              )}
              <div>
                <span>Ubicación</span>
                <strong>Mendoza</strong>
              </div>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- CONTENT SECTION -->
  <section class="case-detail-main">
    <div class="um-container case-detail-main__grid">
      <!-- Left Column (Main Content) -->
      <div class="case-detail-body">

        <!-- Description Section -->
        <div class="flex flex-col gap-4 sm:gap-5">
          <div class="case-section-title">
            <span aria-hidden="true"></span>
            <h2>Contexto y ejecución</h2>
          </div>
          <div class="text-gray-600 leading-relaxed text-base sm:text-base prose prose-lg max-w-none">
            <div set:html={antecedente.Descripcion || antecedente.descripcion || '<p>Información detallada del proyecto no disponible.</p>'} />
          </div>

          <!-- Callout Box -->
          <div class="case-callout">
            <span aria-hidden="true">/</span>
            <span>Proyecto aplicado en {antecedente.Area || 'tecnología'} para {antecedente.Cliente}</span>
          </div>
        </div>

        <!-- Alcance del Proyecto Section -->
        {scopeItems.length > 0 && (
          <div class="flex flex-col gap-4 sm:gap-5">
            <div class="case-section-title">
              <span aria-hidden="true"></span>
              <h2>Alcance ejecutado</h2>
            </div>
            <div class="case-scope-list">
              {scopeItems.map((item) => (
                <div>
                  <span aria-hidden="true">/</span>
                  <span>{item}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Servicios Relacionados -->
        {relatedServices.length > 0 && (
          <div class="flex flex-col gap-4 sm:gap-5">
            <div class="case-section-title">
              <span aria-hidden="true"></span>
              <h2>Servicios aplicados</h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-6">
              {relatedServices.map((servicio) => (
                <ServiceCard
                  id={servicio.id}
                  slug={servicio.slug}
                  titulo={compactServiceTitle(servicio.Titulo)}
                  subtitulo={servicio.subtitulo || servicio.Descripcion?.substring(0, 100)}
                  imagen={servicio.Imagen}
                  icon="box"
                  iconColor="bg-um-primary/90"
                />
              ))}
            </div>

            <a
              href="/servicios"
              class="inline-flex items-center gap-2 text-um-primary font-semibold text-base hover:underline"
            >
              Ver todos nuestros servicios
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
              </svg>
            </a>
          </div>
        )}

        <!-- Gallery (if has additional images from Directus) -->
        {antecedente.Imagenes && antecedente.Imagenes.length > 0 && (
          <div class="flex flex-col gap-4 sm:gap-5">
            <div class="case-section-title">
              <span aria-hidden="true"></span>
              <h2>Galería del proyecto</h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {antecedente.Imagenes.map((img: any) => (
                <div class="aspect-video overflow-hidden bg-gray-100 group">
                  <img
                    src={getAssetUrl(img)}
                    alt="Galería"
                    class="w-full h-full object-cover"
                    loading="lazy"
                    onerror="this.src='/images/default-background.jpg'"
                  />
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Sidebar -->
      <div class="case-detail-side">

        <!-- Ficha Técnica Card -->
        <div class="case-info-card">
          <div class="case-info-card__head">
            <svg class="w-4 sm:w-[18px] h-4 sm:h-[18px] text-um-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <span>Ficha técnica</span>
          </div>
          <div class="p-0 flex flex-col gap-3 sm:gap-4">
            <div class="flex flex-col gap-1">
              <span class="text-base font-semibold text-gray-500 tracking-wider uppercase">Organización</span>
              <span class="text-base sm:text-base font-semibold text-gray-900">{antecedente.Cliente}</span>
            </div>
            <div class="h-px bg-gray-100"></div>
            <div class="flex flex-col gap-1">
              <span class="text-base font-semibold text-gray-500 tracking-wider uppercase">Vertical</span>
              <span class="text-base sm:text-base font-semibold text-gray-900">{antecedente.Area || 'Tecnología'}</span>
            </div>
            <div class="h-px bg-gray-100"></div>
            <div class="flex flex-col gap-1">
              <span class="text-base font-semibold text-gray-500 tracking-wider uppercase">Unidad de Negocio</span>
              <span class="text-base sm:text-base font-semibold text-gray-900">{antecedente.Unidad_de_negocio || 'Consultoría'}</span>
            </div>
            <div class="h-px bg-gray-100"></div>
            <div class="flex flex-col gap-1">
              <span class="text-base font-semibold text-gray-500 tracking-wider uppercase">Ubicación</span>
              <span class="text-base sm:text-base font-semibold text-gray-900">Mendoza, Argentina</span>
            </div>
            {antecedente.Fecha && (
              <>
                <div class="h-px bg-gray-100"></div>
                <div class="flex flex-col gap-1">
