            )}
            <div class="h-px bg-gray-100"></div>
            <div class="flex flex-col gap-1">
              <span class="text-base font-semibold text-gray-500 tracking-wider uppercase">Código Proyecto</span>
              <span class="text-base sm:text-base font-semibold text-um-primary font-mono">ANT-{id}</span>
            </div>
          </div>
        </div>

        <!-- CTA Widget -->
