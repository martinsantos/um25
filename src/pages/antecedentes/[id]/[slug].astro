---
import Layout from '../../../layouts/Layout.astro';
import EnhancedImage from '../../../components/EnhancedImage.astro';

// --- Configuración ---
// Direct Directus integration using environment variables
const DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL || 'http://um25_directus:8055';
const DEFAULT_IMAGE_URL = `/images/default-background.jpg`;
const DIRECTUS_STATIC_TOKEN = import.meta.env.DIRECTUS_STATIC_TOKEN || 'k6P8LAY8_x_y1miB_KTlWnysCnx2Abky';

console.log('DIRECTUS_URL configurado como:', DIRECTUS_URL);

// SSR habilitado - páginas dinámicas
export const prerender = false;

// Parámetros de URL
const { id, slug: slugFromUrl } = Astro.params;
console.log(`[SLUG PAGE] Received Params -> ID: ${id}, SlugFromURL: ${slugFromUrl}`);

if (!id || !slugFromUrl) {
    console.error('[SLUG PAGE] Error: Falta ID o Slug en la URL. Redirigiendo a 404.');
    return Astro.redirect('/404');
}

// --- Estado ---
let antecedente = null;
let fetchError = null;
let usingFallback = false;

// --- Funciones Auxiliares ---
const getAssetUrl = (assetId) => {
    console.log('getAssetUrl recibió:', JSON.stringify(assetId));
    
    if (!assetId) {
        console.log('assetId vacío, retornando DEFAULT_IMAGE_URL');
        return DEFAULT_IMAGE_URL;
    }
    
    // Si es un objeto con id (formato de Directus)
    if (typeof assetId === 'object') {
        console.log('assetId es un objeto:', JSON.stringify(assetId));
        
        if (assetId.id) {
            console.log('Usando assetId.id:', assetId.id);
            return `${DIRECTUS_URL}/assets/${assetId.id}?width=1200&quality=80`;
        }
        if (assetId.directus_files_id) {
            console.log('Usando assetId.directus_files_id:', assetId.directus_files_id);
            return `${DIRECTUS_URL}/assets/${assetId.directus_files_id}?width=1200&quality=80`;
        }
        if (assetId.filename_disk) {
            console.log('Usando assetId.filename_disk:', assetId.filename_disk);
            return `${DIRECTUS_URL}/assets/${assetId.filename_disk}?width=1200&quality=80`;
        }
    }
    
    // Si es una URL completa
    if (typeof assetId === 'string') {
        console.log('assetId es string:', assetId);
        if (assetId.startsWith('http://') || assetId.startsWith('https://')) {
            return assetId;
        }
        // Es un ID directo
        return `${DIRECTUS_URL}/assets/${assetId}?width=1200&quality=80`;
    }
    
    console.log('Caso no identificado, retornando DEFAULT_IMAGE_URL');
    return DEFAULT_IMAGE_URL;
};

// Import shared slug utility for consistency
import { generateSlug } from '../../../utils/slugUtils.js';

function parseCommaSeparatedString(input) {
    if (typeof input !== 'string' || !input.trim()) {
        return [];
    }
    try {
        return input.split(',')
            .map(item => item.trim())
            .filter(Boolean);
    } catch (e) {
        console.error('[parseCommaSeparatedString] Error parsing string:', input, e);
        return [];
    }
}

// --- Fetch de Datos ---
async function fetchAntecedenteById(itemId) {
    try {
        const response = await fetch(`${DIRECTUS_URL}/items/Antecedentes/${itemId}?fields=*,Imagen.*,ImagenPrincipal.*,Imagenes.*,Imagenes.directus_files_id`, {
            headers: {
                'Authorization': `Bearer ${DIRECTUS_STATIC_TOKEN}`,
                'Accept': 'application/json'
            }
        });
        
        if (!response.ok) {
            throw new Error(`API Error: ${response.status} ${response.statusText}`);
        }
        
        const data = await response.json();
        console.log(`[SLUG PAGE] Datos obtenidos para ID ${itemId}:`, data);
        return data?.data || null;
    } catch (error) {
        console.error(`[SLUG PAGE] Error fetching item ${itemId}:`, error);
        throw error;
    }
}

// --- Obtención de datos y validación ---
try {
    if (DIRECTUS_STATIC_TOKEN) {
        console.log('[SLUG PAGE] Intentando obtener datos de Directus...');
        antecedente = await fetchAntecedenteById(id);
        
        if (antecedente) {
            const expectedSlug = generateSlug(antecedente.Titulo);
            if (expectedSlug !== slugFromUrl) {
                console.log(`[SLUG PAGE] Slug incorrecto. Esperado: ${expectedSlug}, Recibido: ${slugFromUrl}`);
                return Astro.redirect(`/antecedentes/${id}/${expectedSlug}`);
            }
            console.log('[SLUG PAGE] Datos obtenidos exitosamente de Directus');
        }
    } else {
        console.log('[SLUG PAGE] No hay token de Directus, usando datos estáticos');
        throw new Error('No DIRECTUS_STATIC_TOKEN available');
    }
} catch (error) {
    console.log('[SLUG PAGE] Error con Directus, usando datos estáticos como fallback:', error.message);
    fetchError = error;
    usingFallback = true;
    
    try {
        const { antecedentesReales } = await import('../../../data/antecedentes_completos.js');
        antecedente = antecedentesReales.find(item => item.id.toString() === id);
        
        if (antecedente) {
            const expectedSlug = generateSlug(antecedente.Titulo);
            if (expectedSlug !== slugFromUrl) {
                console.log(`[SLUG PAGE] Redirigiendo a slug correcto: ${expectedSlug}`);
                return Astro.redirect(`/antecedentes/${id}/${expectedSlug}`);
            }
            console.log('[SLUG PAGE] Usando datos estáticos exitosamente');
        } else {
            console.error(`[SLUG PAGE] No se encontró antecedente con ID ${id} en datos estáticos`);
            return Astro.redirect('/404');
        }
    } catch (fallbackError) {
        console.error('[SLUG PAGE] Error en fallback:', fallbackError);
        return Astro.redirect('/404');
    }
}

if (!antecedente) {
    console.error(`[SLUG PAGE] No se encontró antecedente con ID ${id}`);
    return Astro.redirect('/404');
}

// --- Preparación de datos para la UI ---
const pageTitle = antecedente?.Titulo 
    ? `${antecedente.Titulo} | Antecedentes` 
    : 'Detalle de Antecedente';

// Función mejorada para obtener imagen específica del antecedente
const getMainImageUrl = async () => {
    console.log('[IMAGEN] Obteniendo imagen principal para antecedente ID:', id);
    console.log('[IMAGEN] Datos del antecedente:', { 
        cliente: antecedente.Cliente, 
        area: antecedente.Area, 
        titulo: antecedente.Titulo 
    });
    
    // PASO 1: Usar la función de búsqueda mejorada del mapeo
    try {
        const { buscarImagenPorDatos } = await import('../../../data/mapeo_imagenes_completo.js');
        const nombreArchivo = buscarImagenPorDatos(
            antecedente.Cliente,
            antecedente.Area, 
            antecedente.Titulo,
            id
        );
        
        if (nombreArchivo) {
            const imagenUrl = `/imagenes_antecedentes_versionproduccion/${nombreArchivo}`;
            console.log('[IMAGEN] ✅ Usando imagen específica del mapeo:', imagenUrl);
            return imagenUrl;
        }
    } catch (error) {
        console.log('[IMAGEN] ⚠️ Error en búsqueda del mapeo:', error);
    }
    
    // PASO 2: Buscar imagen específica por ID conocidos (fallback confiable)
    const imagenesConocidas = {
        '11125': 'ultimamilla_procon_srl_-_sdi_20250416_083646_s3451025673.png',
        '10770': 'ultimamilla_telecombtw_sa_-_redes_y_comunicaciones_20250415_201308_s4071923973.png',
        '1': 'ultimamilla_municipalidad_de_maipú_-_software_servicios_20250415_182056_s1379068004.png',
        '2': 'ultimamilla_municipalidad_de_guaymallén_-_redes_y_comunicaciones_redes_y_20250415_182333_s1075915836.png',
        '3': 'ultimamilla_patrulleros_inteligentes_-_redes_y_comunicaciones_20250415_182524_s1196678540.png'
    };
    
    if (imagenesConocidas[id]) {
        const imagenUrl = `/imagenes_antecedentes_versionproduccion/${imagenesConocidas[id]}`;
        console.log('[IMAGEN] ✅ Usando imagen conocida por ID:', imagenUrl);
        return imagenUrl;
    }
    
    // PASO 3: Usar imagen desde Directus si está disponible y no estamos en fallback
    if (!usingFallback && (antecedente.Imagen || antecedente.ImagenPrincipal)) {
        const directusImage = getAssetUrl(antecedente.Imagen || antecedente.ImagenPrincipal);
        console.log('[IMAGEN] ✅ Usando imagen de Directus:', directusImage);
        return directusImage;
    }
    
    // PASO 4: Fallback final - usar imagen por defecto
    console.log('[IMAGEN] ⚠️ No se encontró imagen específica, usando imagen por defecto');
    return DEFAULT_IMAGE_URL;
};

const mainImageUrl = await getMainImageUrl();
console.log('[IMAGEN] URL final seleccionada:', mainImageUrl);

// Generar iniciales del cliente para placeholder
const clientInitials = (antecedente.Cliente || 'UM')
    .split(' ')
    .map(word => word.charAt(0))
    .join('')
    .slice(0, 2)
    .toUpperCase();

// Generar color único basado en ID
const colors = [
    'from-blue-600 to-blue-800',
    'from-green-600 to-green-800', 
    'from-purple-600 to-purple-800',
    'from-red-600 to-red-800',
    'from-yellow-600 to-yellow-800',
    'from-indigo-600 to-indigo-800',
    'from-pink-600 to-pink-800',
    'from-teal-600 to-teal-800'
];
const uniqueColor = colors[parseInt(id) % colors.length];

// Formatear fecha
const formatDate = (dateString) => {
    if (!dateString) return 'No especificada';
    try {
        return new Date(dateString).toLocaleDateString('es-ES', {
            year: 'numeric',
            month: 'long',
            day: 'numeric'
        });
    } catch {
        return dateString;
    }
};

// Formatear moneda
const formatCurrency = (amount) => {
    if (!amount) return 'No especificado';
    return new Intl.NumberFormat('es-AR', {
        style: 'currency',
        currency: 'ARS'
    }).format(amount);
};

// Estado del proyecto
const getStatusColor = () => {
    if (usingFallback) return 'bg-yellow-500';
    return 'bg-green-500';
};

const getStatusText = () => {
    if (usingFallback) return 'Modo Offline';
    return 'Datos en vivo';
};
