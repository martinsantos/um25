---
/**
 * Antecedente Detail Page - V4 Design System
 * Case study/project detail with enhanced design matching V4 template
 */

import LayoutV4 from '../../../layouts/LayoutV4.astro';
import EvidenceCaseRow from '../../../components/um/EvidenceCaseRow.astro';
import { getAntecedentes as getCatalogAntecedentes, getServicios as getCatalogServicios } from '../../../lib/um26-directus';
import EmailLink from '../../../components/common/EmailLink.astro';
import { generateSlug } from '../../../utils/slugUtils.js';
import { getServicioById } from '../../../utils/directusHelpers';
import { getServiceIdFromArea } from '../../../data/areaToServiceMap.js';
import { getAntecedenteConServicios, getAntecedenteImageUrl, getDirectusImageUrl, getGeneratedAntecedenteImageUrl, getAllAntecedentes } from '../../../lib/directus.ts';
import { BASE_POSTER } from '../../../data/cine/posters';
import {
  getAntecedenteById as getUm26AntecedenteById,
  getSectores as getUm26Sectores,
} from '../../../lib/um26-directus';
import { canonicalUrl as toCanonicalUrl, publicImageUrl } from '../../../utils/seoUrl';
import {
  curateAntecedente,
  formatAntecedenteDate,
  formatAntecedenteYear,
} from '../../../utils/antecedentesCuration';
import {
  applyDisplayNameReplacements,
  formatDisplayName,
  plainTextFromHtml,
  renderEditorialBody,
  sanitizeEditorialText,
  sanitizeMarketingCopy,
  truncateEditorialText,
} from '../../../utils/editorialContent';
import { excerptEditorialSentences } from '../../../utils/editorialExcerpt';
import { isReplicaIdenticalCopy, resolveReplicaH1 } from '../../../utils/replicaProdCopy';
import {
  buildCaseStrategicLinkGroups,
  buildStrategicWebPageStructuredData,
} from '../../../data/strategicLinkGraph';
import { buildCaseSeoMeta } from '../../../utils/seoMetaPolicy';
import { editorialImages, editorialImageDimensions, generatedAntecedenteImageDimensions } from '../../../data/editorialImageSystem';

// --- Configuration ---
const DEFAULT_IMAGE_URL = `/images/default-background.jpg`;

export const prerender = false;

// URL params
const { id, slug: slugFromUrl } = Astro.params;

if (!id || !slugFromUrl) {
    return Astro.rewrite('/404');
}

// --- State ---
let antecedente: any = null;
let sourceSlug: string | null = null;

// --- Helper Functions ---
const getAssetUrl = (assetId: any): string => {
    if (!assetId) return DEFAULT_IMAGE_URL;

    // Handle object with nested ID properties
    if (typeof assetId === 'object') {
        if (assetId.id) return getDirectusImageUrl(assetId.id);
        if (assetId.directus_files_id) return getDirectusImageUrl(assetId.directus_files_id);
    }

    // Handle string UUIDs
    if (typeof assetId === 'string') {
        if (assetId.startsWith('http')) return assetId;
        if (assetId.startsWith('/')) return assetId;
        const url = getDirectusImageUrl(assetId);
        if (url) return url;
    }

    return DEFAULT_IMAGE_URL;
};

const toUm26Date = (year?: number, month?: number): string => {
  const safeYear = Number.isFinite(Number(year)) ? Number(year) : new Date().getFullYear();
  const safeMonth = Number.isFinite(Number(month)) ? Math.min(12, Math.max(1, Number(month))) : 1;
  return `${safeYear}-${String(safeMonth).padStart(2, '0')}-01`;
};

const getUm26AntecedenteFallback = async (rawId: string): Promise<any | null> => {
  const source = await getUm26AntecedenteById(Number(rawId));
  if (!source) return null;

  const sectors = await getUm26Sectores();
  const sectorLabel = sectors.find((sector) => sector.slug === source.sector_slug)?.name || source.sector_slug;
  const parts = [source.summary, ...source.scope]
    .map((part) => String(part || '').replace(/[.\s]+$/, ''))
    .filter(Boolean);
  const description = parts.length ? `${parts.join('. ')}.` : '';

  sourceSlug = source.slug;
  return {
    id: source.id,
    original_id: source.id,
    Titulo: source.title,
    Nombre: source.title,
    displayTitle: source.title,
    Descripcion: description,
    displayDescription: description,
    Cliente: source.client,
    Area: sectorLabel,
    Unidad_de_negocio: sectorLabel,
    Fecha: toUm26Date(source.year, source.month),
    Imagen: source.image,
    ImagenPrincipal: source.image,
    Imagenes: [],
    curation: {
      recordLabel: 'Caso operativo',
      recordTone: 'technical-record',
      recordSummary: source.summary,
      quality: 'technical-record',
    },
  };
};

// --- Get data and validate. Public Directus/snapshot records always win over the local archive. ---
try {
    antecedente = await getAntecedenteConServicios(id);

    if (antecedente) {
        const expectedSlug = generateSlug(antecedente.Titulo);
        if (expectedSlug !== slugFromUrl) {
            return Astro.redirect(`/antecedentes/${id}/${expectedSlug}`, 301);
        }
    } else {
        antecedente = await getUm26AntecedenteFallback(id);
        if (!antecedente) return Astro.rewrite('/404');
        const directSlug = generateSlug(antecedente.Titulo);
        const validSlugs = new Set([directSlug, sourceSlug].filter(Boolean));
        if (!validSlugs.has(slugFromUrl)) {
            return Astro.redirect(`/antecedentes/${id}/${sourceSlug || directSlug}`, 301);
        }
    }
} catch (error) {
    console.error(`Error loading antecedente ${id} from Directus:`, error);
    antecedente = await getUm26AntecedenteFallback(id);
    if (!antecedente) {
      return new Response('Contenido temporalmente no disponible', {
        status: 503,
        headers: { 'Content-Type': 'text/plain; charset=utf-8' },
      });
    }
}

if (!antecedente) return Astro.rewrite('/404');

antecedente = curateAntecedente(antecedente);
const toPublicCaseLabel = (value: unknown): string => {
  const label = String(value || '')
    .replace(/\bRegistro\s+[\p{L}]+\b/giu, 'Proyecto técnico')
    .replace(/\bRegistro\b/gi, 'Proyecto')
    .replace(/\bDoc[\p{L}]*\b/giu, 'Técnico')
    .trim();
  return label || 'Proyecto técnico';
};
// Las notas de curación ("Antecedente real con…", "requiere revisión editorial") son
// internas: la ficha pública no las muestra.
const INTERNAL_CURATION_NOTE = /Directus|registro\s+p[uú]blico|imagen\s+[uú]nica|datos\s+del\s+antecedente|^Antecedente\s+(real|con)\b|sobredimensionar|revisi[oó]n\s+editorial|lectura\s+comercial|profundidad\s+completa/i;
const toPublicCaseSummary = (value: unknown): string => {
  const summary = String(value || '').trim();
  if (!summary || INTERNAL_CURATION_NOTE.test(summary)) {
    return '';
  }
  return summary
    .replace(/cargad[oa]s?\s+desde\s+Directus/gi, 'publicados por ULTIMA MILLA')
    .replace(/\bregistro\s+p[uú]blico\b/gi, 'proyecto')
    .replace(/\bimagen\s+[uú]nica\s+asociada\b/gi, 'imagen asociada')
    .trim();
};
const caseRecordLabel = toPublicCaseLabel(antecedente.curation?.recordLabel);
const caseRecordTone = antecedente.curation?.recordTone || 'technical-record';
const caseRecordSummary = toPublicCaseSummary(antecedente.curation?.recordSummary);

// --- Prepare data for UI (generated-case image first, Directus as fallback) ---
const generatedMainImageUrl = getGeneratedAntecedenteImageUrl(antecedente.id) || getGeneratedAntecedenteImageUrl(antecedente.original_id);
// Póster Blender del sector × servicio; los archivos de Directus eran imágenes generadas.
const mainImageUrl = generatedMainImageUrl || BASE_POSTER;
const hasGeneratedMainImage = mainImageUrl.startsWith('/cine/media/');
const caseImageDimensions = hasGeneratedMainImage ? generatedAntecedenteImageDimensions : { width: 720, height: 720 };
const caseSeoImageUrl = mainImageUrl.startsWith('/uploads/antecedentes/') ? editorialImages.defaultOg : mainImageUrl;
const caseSeoImageDimensions = hasGeneratedMainImage
  ? generatedAntecedenteImageDimensions
  : mainImageUrl.startsWith('/uploads/antecedentes/')
    ? editorialImageDimensions
    : caseImageDimensions;

const formatDate = (dateString: string): string => {
    const formatted = formatAntecedenteDate(dateString);
    return formatted || '';
};
const caseDateLabel = formatAntecedenteDate(antecedente.Fecha);
const caseDatePublished = caseDateLabel ? antecedente.Fecha : undefined;

const cleanDisplayText = (value: unknown) => String(value || '')
  .replace(/<[^>]+>/g, '')
  .replace(/\s+/g, ' ')
  .trim();
const displayClientName = formatDisplayName(antecedente.Cliente);
const displayCaseText = (value: unknown) => applyDisplayNameReplacements(value, [antecedente.Cliente]);

const caseBodySource = antecedente.displayDescription || antecedente.Descripcion || antecedente.descripcion || '';
const caseBodyPlain = plainTextFromHtml(caseBodySource, 4000);
const caseDescriptionHtml = await renderEditorialBody(caseBodySource);
const rawCaseHeroExcerpt = excerptEditorialSentences(caseBodySource, 176, 3)
  || cleanDisplayText(antecedente.displayTitle || antecedente.Titulo || antecedente.Nombre);
const caseHeroExcerpt = displayCaseText(rawCaseHeroExcerpt);

// La unidad de negocio se muestra sólo si agrega información (y nunca rótulos de importación).
const isPublicBusinessUnit = (unit: unknown, area: unknown): boolean => {
  const value = String(unit || '').trim();
  return Boolean(value) && value !== String(area || '').trim() && !/import|sgi\b/i.test(value);
};

const buildStructuredScopeItems = (item: any): string[] => {
  const rows = [
    item.displayTitle || item.Titulo ? `Alcance: ${cleanDisplayText(item.displayTitle || item.Titulo)}` : '',
    item.Cliente ? `Cliente: ${formatDisplayName(item.Cliente)}` : '',
    item.Area ? `Sector: ${cleanDisplayText(item.Area)}` : '',
    isPublicBusinessUnit(item.Unidad_de_negocio, item.Area) ? `Unidad: ${cleanDisplayText(item.Unidad_de_negocio)}` : '',
    formatAntecedenteDate(item.Fecha) ? `Cierre: ${formatDate(item.Fecha)}` : '',
  ].filter((row) => row.length > 8);
  return rows.slice(0, 5);
};

const extractScopeItems = (descripcion: string): string[] => {
  const plain = plainTextFromHtml(descripcion, 2000);
  if (!plain) return [];
  const sentences = plain
    .split(/[.;]/)
    .map((s) => sanitizeEditorialText(s))
    .filter((s) => s.length > 12 && s.length < 160);
  return sentences.slice(0, 5);
};

const scopeFromDescription = extractScopeItems(caseBodySource);
const scopeItems = (() => {
  const bodyNorm = caseBodyPlain.toLowerCase().replace(/\s+/g, ' ').trim();
  const uniqueFromDesc = scopeFromDescription.filter((item) => {
    const snippet = item.toLowerCase().replace(/\s+/g, ' ').trim();
    return snippet.length > 20 && !bodyNorm.includes(snippet);
  });
  if (uniqueFromDesc.length >= 2) return uniqueFromDesc;
  return buildStructuredScopeItems(antecedente);
})();

const caseCalloutText = [
  'Proyecto aplicado',
  antecedente.Area ? `en ${cleanDisplayText(antecedente.Area)}` : '',
  displayClientName ? `para ${displayClientName}` : '',
].filter(Boolean).join(' ');

const resolveServiceImageUrl = (servicio: any): string => {
  const serviceImage = getDirectusImageUrl(servicio?.Imagen);
  if (serviceImage) return serviceImage;
  const firstProduct = servicio?.productos?.[0];
  if (firstProduct?.imagen) return firstProduct.imagen;
  if (firstProduct?.Imagen) return getDirectusImageUrl(firstProduct.Imagen) || '';
  return '/images/default-background.jpg';
};

const compactServiceTitle = (value: unknown): string => {
  const title = cleanDisplayText(value)
    .replace(/\s*\|.*$/g, '')
    .trim();
  const replacements: Record<string, string> = {
    'Infraestructura de Redes': 'Redes e infraestructura',
    'Sistemas de Seguridad Electrónica': 'Seguridad electrónica',
    'Telecomunicaciones.': 'Telecomunicaciones',
    'Desarrollo de Software a Medida': 'Software operativo',
    'Soporte Técnico 24/7': 'Soporte técnico 24/7',
    'Consultoría IT y Transformación Digital': 'Consultoría IT',
    'Sistemas de Detección y Alarma de Incendios': 'Detección de incendios',
    'Servicios Eléctricos para IT': 'Energía para IT',
  };
  return replacements[title] || title || 'Servicio IT';
};

// Get related services via M2M relationship from Directus (with fallback to area mapping)
const getRelatedServices = async (antecedenteId: string, area: string) => {
    // TODO: Re-enable M2M relationship when function is available in directusHelpers.ts
    // try {
    //     // Try to get M2M related services from Directus
    //     const serviciosFromDirectus = await getServiciosPorAntecedente(parseInt(antecedenteId));
    //
    //     if (serviciosFromDirectus && serviciosFromDirectus.length > 0) {
    //         return serviciosFromDirectus.slice(0, 4); // Max 4 services
    //     }
    // } catch (error) {
    //     console.error('Error fetching related services from Directus:', error);
    // }

    // Fallback: Use area-based mapping to find one service from Directus
    try {
        const serviceId = getServiceIdFromArea(area);
        const servicio = await getServicioById(serviceId);

        if (servicio) {
            const lead = sanitizeMarketingCopy(
              servicio.Subtitulo || servicio.Descripcion,
              280,
            );
            return [{
                id: serviceId,
                Titulo: servicio.Titulo,
                Descripcion: servicio.Descripcion,
                lead,
                imageUrl: resolveServiceImageUrl(servicio),
                imageAlt: compactServiceTitle(servicio.Titulo),
                slug: generateSlug(servicio.Titulo),
            }];
        }
    } catch (error) {
        console.error('Error fetching service by area mapping:', error);
    }

    return [];
};

const relatedServices = await getRelatedServices(id, antecedente.Area || '');

const getRelatedAntecedentes = async (area: string, excludeId: string, limit: number = 3) => {
  try {
    const all = await getAllAntecedentes();
    return all
      .filter(item => {
        if (String(item.id) === excludeId) return false;
        const itemArea = (item.Area || '').toLowerCase();
        const searchArea = (area || '').toLowerCase();
        return itemArea.includes(searchArea) || searchArea.includes(itemArea);
      })
      .slice(0, limit)
      .map(item => ({
        ...curateAntecedente(item),
        slug: generateSlug(item.Titulo || 'proyecto'),
        imageUrl: getAntecedenteImageUrl(item)
      }));
  } catch {
    return [];
  }
};

// Casos comparables (fase 4): se puntúan por servicios compartidos (código SGI),
// mismo sector y cercanía en el tiempo sobre el catálogo verificado. Si el caso
// no está en el catálogo, se cae al criterio anterior (mismo sector por Area).
const SECTOR_LABELS: Record<string, string> = {
  aeropuertos: 'Aeropuertos', bodegas: 'Bodegas', constructoras: 'Constructoras', gobierno: 'Gobierno y sector público',
  gobiernosectorpublico: 'Gobierno y sector público', industria: 'Industria', mineria: 'Minería', salud: 'Salud',
  'seguridad-electronica': 'Seguridad electrónica', software: 'Software',
};
const [catalogCases, catalogServices] = await Promise.all([
  getCatalogAntecedentes({ limit: 1000 }).catch(() => []),
  getCatalogServicios().catch(() => []),
]);
const serviceNameByCode = new Map(catalogServices.map((s) => [Number(s.code), s.name]));
const currentCatalogCase = catalogCases.find((item) => String(item.id) === String(id));
const appliedServiceNames = (currentCatalogCase?.service_codes || [])
  .map((code) => serviceNameByCode.get(Number(code)))
  .filter((name): name is string => Boolean(name));
const comparableCases = currentCatalogCase
  ? catalogCases
      .filter((item) => String(item.id) !== String(id) && item.image && item.image !== mainImageUrl)
      .map((item) => {
        const shared = item.service_codes.filter((c) => currentCatalogCase.service_codes.includes(c)).length;
        const sameSector = item.sector_slug === currentCatalogCase.sector_slug ? 1 : 0;
        const years = Math.abs((item.year || 0) - (currentCatalogCase.year || 0));
        return { item, shared, sameSector, score: shared * 3 + sameSector * 2 - Math.min(years, 10) / 10 };
      })
      .filter((c) => c.shared > 0 || c.sameSector > 0)
      .sort((a, b) => b.score - a.score || b.item.year - a.item.year)
      // Un solo caso por título+cliente: las obras repetidas en lotes no se duplican.
      .filter((c, i, arr) => arr.findIndex((o) => `${o.item.title}|${o.item.client}`.toLowerCase() === `${c.item.title}|${c.item.client}`.toLowerCase()) === i)
      .slice(0, 3)
      .map(({ item, shared, sameSector }) => ({
        id: item.id,
        slug: item.slug,
        Titulo: item.title,
        displayTitle: item.title,
        Cliente: item.client,
        displayDescription: item.summary,
        Descripcion: item.summary,
        imageUrl: item.image,
        Area: SECTOR_LABELS[item.sector_slug] || item.sector_slug,
        Fecha: String(item.year || ''),
        comparableWhy: [shared > 0 ? (shared === 1 ? 'mismo servicio' : `${shared} servicios en común`) : '', sameSector ? 'mismo sector' : ''].filter(Boolean).join(' · '),
      }))
  : [];
const relatedAntecedentes = comparableCases.length > 0
  ? comparableCases
  : (await getRelatedAntecedentes(antecedente.Area || '', id, 4))
      .filter((item) => item.imageUrl !== mainImageUrl)
      .slice(0, 3);
const comparablesAreScored = comparableCases.length > 0;

const buildCaseHeadline = (item: any): string => {
  const title = cleanDisplayText(item.Titulo || item.Nombre || 'Proyecto técnico');
  const client = formatDisplayName(item.Cliente);
  const area = cleanDisplayText(item.Area);
  const normalized = title.toLowerCase();

  if (normalized.includes('digitalización') || normalized.includes('digitalizacion') || normalized.includes('software')) {
    if (client) return `Software operativo para ${client}`;
    return 'Software operativo implementado';
  }
  if (normalized.includes('soporte')) {
    if (client) return `Soporte IT operativo para ${client}`;
    return 'Soporte IT operativo';
  }
  if (normalized.includes('cctv') || normalized.includes('cámara') || normalized.includes('camara')) {
    if (client) return `CCTV operativo para ${client}`;
    return 'CCTV operativo';
  }
  if (normalized.includes('detección') || normalized.includes('deteccion') || normalized.includes('incendio')) {
    if (client) return `Detección y seguridad para ${client}`;
    return 'Detección y seguridad implementada';
  }
  if (normalized.includes('redes') || normalized.includes('fibra')) {
    if (client) return `Redes y fibra para ${client}`;
    return 'Redes y fibra implementadas';
  }
  if (normalized.includes('eléctrica') || normalized.includes('electrica') || normalized.includes('data center')) {
    if (client) return `Energía IT para ${client}`;
    return 'Energía IT implementada';
  }

  const beforeDash = title.split(/\s[-–]\s/)[0]?.trim() || title;
  if (beforeDash.length <= 74) return beforeDash;
  if (client && area) return `${area} para ${client}`.slice(0, 82);
  if (client) return `Proyecto técnico para ${client}`.slice(0, 82);
  return `${beforeDash.slice(0, 72).trimEnd()}…`;
};

const caseHeadlineSource = isReplicaIdenticalCopy()
  ? resolveReplicaH1(Astro.url.pathname, cleanDisplayText(antecedente.displayTitle || antecedente.Titulo || antecedente.Nombre))
  : cleanDisplayText(antecedente.displayTitle || antecedente.Titulo || antecedente.Nombre);
const baseCaseHeadline = buildCaseHeadline({ ...antecedente, Titulo: caseHeadlineSource });
const caseHeadline = baseCaseHeadline;
const caseReference = `UM-${id}`;
const compactCaseTitle = (value: unknown, client?: unknown): string => {
  const title = cleanDisplayText(value)
    .replace(/Sistena/gi, 'Sistema')
    .replace(/\s+\(\d+\)$/g, '')
    .trim();
  const organization = formatDisplayName(client);
  if (!title) return organization || 'Proyecto técnico';

  const parts = title.split(/\s[-–]\s/).map((part) => part.trim()).filter(Boolean);
  let base = parts[0] || title;
  base = base
    .replace(/Soporte de Infraestructura IT de Alta Disponibilidad/gi, 'Soporte IT de alta disponibilidad')
    .replace(/Implementación de Redes de Datos y Fibra Óptica/gi, 'Redes y fibra óptica')
    .replace(/Instalación eléctrica para Data Center/gi, 'Energía para data center')
    .replace(/Sistema Detección de Incendios/gi, 'Detección de incendios');

  const target = parts[1] && !/^\d{4}|abril|mayo|junio|julio|agosto|septiembre|octubre|noviembre|diciembre/i.test(parts[1])
    ? parts[1]
    : organization;
  const composed = target ? `${base}: ${target}` : base;
  return composed.length > 78 ? `${composed.slice(0, 75).trimEnd()}...` : composed;
};

// SEO
const siteUrl = 'https://www.ultimamilla.com.ar';
const canonicalUrl = toCanonicalUrl(`/antecedentes/${id}/${slugFromUrl}`);
const caseSeoDescriptionSource = [
  antecedente.displayDescription || caseBodySource,
  caseRecordSummary,
  caseCalloutText,
  scopeItems[0],
].filter(Boolean).join('. ');
const caseSeo = buildCaseSeoMeta({
  title: antecedente.displayTitle || antecedente.Titulo || antecedente.Nombre,
  description: caseSeoDescriptionSource,
  client: displayClientName || antecedente.Cliente,
  area: antecedente.Area || antecedente.Unidad_de_negocio,
  date: antecedente.Fecha,
  identifier: id,
});
const metaDescription = caseSeo.description;
const structuredImageUrl = publicImageUrl(caseSeoImageUrl) || toCanonicalUrl(DEFAULT_IMAGE_URL);
const caseExecutiveItems = [
  {
    label: 'Contexto',
    value: truncateEditorialText(
      [displayClientName, antecedente.Area].filter(Boolean).join(' · ') || caseRecordLabel,
      120,
    ),
  },
  {
    label: 'Alcance',
    value: truncateEditorialText(String(scopeItems[0] || caseCalloutText || '').replace(/^Alcance:\s*/i, ''), 135),
  },
  {
    label: 'Resultado',
    value: caseRecordSummary ? truncateEditorialText(caseRecordSummary, 135) : '',
  },
  {
    label: 'Servicios aplicados',
    value: appliedServiceNames.join(' · '),
  },
].filter((item) => item.value);
const caseStrategicLinkGroups = buildCaseStrategicLinkGroups({
  currentPath: `/antecedentes/${id}/${slugFromUrl}`,
  title: caseHeadline,
  summary: metaDescription,
  sectorName: antecedente.Area || antecedente.Unidad_de_negocio,
  text: `${caseBodyPlain} ${antecedente.Cliente || ''}`,
  relatedServices,
  relatedCases: relatedAntecedentes,
});
const antecedenteStructuredData = {
  "@type": "CreativeWork",
  "name": antecedente.displayTitle || antecedente.Titulo,
  "headline": antecedente.displayTitle || antecedente.Titulo,
  "description": metaDescription,
  "url": canonicalUrl,
  "image": {
    "@type": "ImageObject",
    "url": structuredImageUrl,
    "caption": [
      antecedente.displayTitle || antecedente.Titulo,
      antecedente.Cliente ? `Cliente: ${cleanDisplayText(antecedente.Cliente)}` : '',
      antecedente.Area ? `Sector: ${cleanDisplayText(antecedente.Area)}` : '',
    ].filter(Boolean).join(' | '),
  },
  "datePublished": caseDatePublished,
  "inLanguage": "es-AR",
  "genre": caseRecordLabel,
  "about": antecedente.Area ? { "@type": "Thing", "name": cleanDisplayText(antecedente.Area) } : undefined,
  "mentions": antecedente.Cliente ? [{ "@type": "Organization", "name": cleanDisplayText(antecedente.Cliente) }] : undefined,
  "isPartOf": {
    "@type": "CollectionPage",
    "name": "Evidencia operativa real",
    "url": toCanonicalUrl('/antecedentes')
  },
  "provider": {
    "@type": "Organization",
    "name": "ULTIMA MILLA",
    "url": siteUrl
  }
};
const antecedentePageStructuredData = [
  antecedenteStructuredData,
  buildStrategicWebPageStructuredData({
    url: canonicalUrl,
    name: `${antecedente.Titulo} | ULTIMA MILLA`,
    description: metaDescription,
    groups: caseStrategicLinkGroups,
  }),
];
---

<LayoutV4
  skin="black"
  title={caseSeo.title}
  description={metaDescription}
  image={caseSeoImageUrl}
  imageWidth={caseSeoImageDimensions.width}
  imageHeight={caseSeoImageDimensions.height}
  canonical={canonicalUrl}
  structuredData={antecedentePageStructuredData}
>
  <article class="case">
    <section class="case-detail-hero">
      <div class="case-shell case-detail-hero__grid">
        <div class="case-detail-hero__copy">
          <a class="case-back" href="/antecedentes">← Todos los antecedentes</a>
          <div class:list={['case-detail-label', `is-${caseRecordTone}`]}>
            <span class="case-detail-label__area">{antecedente.Area || 'Proyecto'}</span>
            <span class="case-detail-label__reference">{caseReference}</span>
          </div>
          <h1>{caseHeadline}</h1>
          <p class="case-lead">{caseHeroExcerpt}</p>
          <a class="case-btn" href="/contacto">Pedir un relevamiento</a>
        </div>

        <aside class="case-detail-dossier" aria-label="Ficha técnica del antecedente">
          <figure class="case-detail-dossier__media">
            <img
              src={mainImageUrl}
              alt=""
              loading="eager"
              fetchpriority="high"
              decoding="async"
              width={caseImageDimensions.width}
              height={caseImageDimensions.height}
            />
          </figure>
          <dl class="case-ficha">
            {displayClientName && <div><dt>Cliente</dt><dd>{displayClientName}</dd></div>}
            {antecedente.Area && <div><dt>Sector</dt><dd>{antecedente.Area}</dd></div>}
            {caseDateLabel && <div><dt>Finalización</dt><dd>{caseDateLabel}</dd></div>}
            <div><dt>Tipo de trabajo</dt><dd>{caseRecordLabel}</dd></div>
            {appliedServiceNames.length > 0 && <div><dt>Servicios</dt><dd>{appliedServiceNames.join(' · ')}</dd></div>}
          </dl>
        </aside>
      </div>
    </section>

    <section class="case-detail-main">
      <div class="case-shell case-body">
        <h2>Qué se hizo.</h2>
        {caseDescriptionHtml ? (
          <div class="case-prose" set:html={caseDescriptionHtml} />
        ) : (
          <p class="case-prose">{caseHeroExcerpt}</p>
        )}

        {scopeItems.length > 0 && (
          <>
            <h2>Alcance técnico.</h2>
            <ul class="case-scope-list">
              {scopeItems.map((item) => <li>{item}</li>)}
            </ul>
          </>
        )}

        {relatedServices.length > 0 && (
          <>
            <h2>Servicios aplicados.</h2>
            <ul class="case-services">
              {relatedServices.map((servicio) => (
                <li>
                  <a href={`/servicios/${servicio.id}/${servicio.slug}`}>{compactServiceTitle(servicio.Titulo)}</a>
                  <span>{servicio.lead}</span>
                </li>
              ))}
            </ul>
          </>
        )}
      </div>
    </section>

    {relatedAntecedentes.length > 0 && (
      <section class="case-related">
        <div class="case-shell">
          <h2>{comparablesAreScored ? 'Mismo servicio, mismo sector.' : 'Proyectos relacionados.'}</h2>
          <div class="case-related__ledger">
            {relatedAntecedentes.map((ant, index) => (
              <EvidenceCaseRow
                href={`/antecedentes/${ant.id}/${ant.slug}`}
                number={String(index + 1).padStart(2, '0')}
                title={compactCaseTitle(ant.displayTitle || ant.Titulo || 'Proyecto', ant.Cliente)}
                description={applyDisplayNameReplacements(
                  truncateEditorialText(ant.displayDescription || ant.Descripcion || ant.Titulo, 150),
                  [ant.Cliente]
                )}
                sector={ant.Area || 'Servicios IT'}
                year={formatAntecedenteYear(ant.Fecha)}
              />
            ))}
          </div>
          <a class="case-textlink" href="/antecedentes">Ver todos los antecedentes</a>
        </div>
      </section>
    )}

    <section class="case-close">
      <div class="case-shell case-close__grid">
        <div>
          <h2>Contanos qué tiene que seguir funcionando.</h2>
          <p>Relevamos en el lugar y te decimos qué hace falta.</p>
        </div>
        <div class="case-close__actions">
          <a class="case-btn" href="/contacto">Pedir un relevamiento</a>
          <EmailLink class="case-textlink"><span aria-hidden="true">✉</span> Enviar email</EmailLink>
        </div>
      </div>
    </section>
  </article>
</LayoutV4>

<style>
  /* Barrido 24/10: ficha de antecedente en tema oscuro, sin resumen ejecutivo, compartir, tarjetas ni grafo de enlaces. */
  .case { color: #fff; }
  .case-shell { width: min(1400px, 100% - 48px); margin: 0 auto; }
  .case h1, .case h2 { color: #fff; font-family: var(--um-font-display); letter-spacing: -0.01em; }
  .case h2 { margin: 40px 0 16px; font-size: clamp(1.5rem, 2.2vw, 1.875rem); font-weight: 600; }
  .case-detail-hero { padding: clamp(40px, 6vw, 72px) 0 32px; }
  .case-detail-hero__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 48px; align-items: start; }
  .case-back { display: inline-block; margin-bottom: 20px; color: #c4c7cc; text-decoration: none; font-size: 1rem; }
  .case-back:hover, .case-back:focus-visible { color: #fff; text-decoration: underline; text-decoration-color: #dc2626; }
  .case-detail-label { display: flex; gap: 12px; margin: 0 0 12px; color: #9a9a9a; font-size: 1rem; }
  .case-detail-label__reference { color: #c4c7cc; }
  .case-detail-hero h1 { margin: 0 0 16px; font-size: clamp(2rem, 3.6vw, 3rem); font-weight: 700; line-height: 1.08; max-width: 22ch; overflow-wrap: normal; }
  .case-lead { margin: 0 0 24px; max-width: 62ch; color: #c4c7cc; font-size: 1.125rem; line-height: 1.55; }
  .case-btn { display: inline-flex; align-items: center; min-height: 48px; padding: 0 22px; background: #dc2626; color: #fff; font-weight: 600; text-decoration: none; border-radius: 4px; }
  .case-btn:hover, .case-btn:focus-visible { background: #b91c1c; }
  .case-textlink { color: #fff; text-decoration: underline; text-decoration-color: #dc2626; text-underline-offset: 5px; font-size: 1.0625rem; }
  .case-detail-dossier { border: 1px solid rgba(255,255,255,0.12); padding: 16px; }
  .case-detail-dossier__media {
    width: 100%;
    max-width: 100%;
    margin: 0 0 16px;
    aspect-ratio: 4 / 3;
    min-height: 220px;
    background: #090909;
  }
  .case-detail-dossier__media img { display: block; width: 100%; height: 100%; object-fit: contain; padding: 4%; box-sizing: border-box; }
  .case-ficha { margin: 0; display: grid; gap: 0; }
  .case-ficha div { display: grid; grid-template-columns: minmax(120px, 0.4fr) minmax(0, 0.6fr); gap: 16px; padding: 10px 0; border-top: 1px solid rgba(255,255,255,0.12); }
  .case-ficha dt { margin: 0; color: #9a9a9a; font-size: 1rem; }
  .case-ficha dd { margin: 0; color: #fff; font-size: 1rem; overflow-wrap: anywhere; }
  .case-detail-main { padding: 8px 0 24px; }
  .case-body { max-width: 860px; }
  .case-body h2:first-child { margin-top: 8px; }
  .case-prose, .case-prose :global(p) { color: #c4c7cc; font-size: 1.0625rem; line-height: 1.6; }
  .case-prose :global(p) { margin: 0 0 14px; }
  .case-scope-list { list-style: none; margin: 0; padding: 0; }
  .case-scope-list li { padding: 10px 0; border-top: 1px solid rgba(255,255,255,0.12); color: #c4c7cc; font-size: 1.0625rem; line-height: 1.5; }
  .case-scope-list li:last-child { border-bottom: 1px solid rgba(255,255,255,0.12); }
  .case-services { list-style: none; margin: 0; padding: 0; }
  .case-services li { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 8fr); gap: 24px; padding: 12px 0; border-top: 1px solid rgba(255,255,255,0.12); }
  .case-services li:last-child { border-bottom: 1px solid rgba(255,255,255,0.12); }
  .case-services a { color: #fff; font-weight: 600; text-decoration: none; }
  .case-services a:hover, .case-services a:focus-visible { text-decoration: underline; text-decoration-color: #dc2626; }
  .case-services span { color: #c4c7cc; font-size: 1.0625rem; line-height: 1.5; }
  .case-related { padding: 16px 0 24px; }
  .case-related__ledger { margin: 0 0 20px; border-top: 1px solid rgba(255,255,255,0.12); }
  .case-related :global(.evidence-case-row) { background: transparent !important; border: 0 !important; border-bottom: 1px solid rgba(255,255,255,0.12) !important; border-radius: 0 !important; color: #fff !important; box-shadow: none !important; }
  .case-related :global(.evidence-case-row h3) { color: #fff !important; }
  .case-related :global(.evidence-case-row p), .case-related :global(.evidence-case-row__meta span) { color: #9a9a9a !important; }
  .case-related :global(.evidence-case-row__meta strong) { color: #c4c7cc !important; }
  .case-related :global(.evidence-case-row__number), .case-related :global(.evidence-case-row__thumb), .case-related :global(.evidence-case-row__action) { display: none !important; }
  .case-close { padding: 32px 0 64px; }
  .case-close__grid { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: 32px; align-items: center; padding: 32px; border: 1px solid rgba(255,255,255,0.12); background: linear-gradient(105deg, rgba(220,38,38,0.14), transparent 46%), #0f0f10; }
  .case-close h2 { margin: 0 0 8px; }
  .case-close p { margin: 0; color: #c4c7cc; font-size: 1.0625rem; }
  .case-close__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 20px; justify-content: flex-end; }
  @media (max-width: 960px) {
    .case-detail-hero__grid, .case-close__grid { grid-template-columns: 1fr; }
    .case-close__actions { justify-content: flex-start; }
  }
  @media (max-width: 720px) {
    .case-detail-dossier__media {
      min-height: 0;
    }
    .case-services li { grid-template-columns: 1fr; gap: 4px; }
    .case-shell { width: min(1400px, 100% - 32px); }
  }
</style>
