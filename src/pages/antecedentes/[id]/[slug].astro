          <div class="case-cta-card__icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
          </div>
          <h3>Relevar una operación similar</h3>
          <p>
            Podemos relevar contexto, riesgos, alcance y próximos pasos verificables.
          </p>
          <div class="case-cta-card__actions">
            <a href="/contacto">
              <svg class="w-4 sm:w-[18px] h-4 sm:h-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
              </svg>
              Solicitar relevamiento
            </a>
            <a href="mailto:contacto@ultimamilla.com.ar">
              <svg class="w-4 sm:w-[18px] h-4 sm:h-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
              </svg>
              Enviar email
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- RELATED SECTION -->
  {relatedAntecedentes.length > 0 && (
    <section class="case-related">
      <div class="um-container">
        <div class="case-related__head">
          <div>
            <span class="um-kicker">Archivo relacionado</span>
            <h2>Evidencia relacionada</h2>
          </div>
