---
import Layout from '../../../layouts/Layout.astro';
import AntecedenteHero from '../../../components/antecedentes/AntecedenteHero.astro';
import AntecedenteKPIs from '../../../components/antecedentes/AntecedenteKPIs.astro';
import AntecedenteGraficos from '../../../components/antecedentes/AntecedenteGraficos.astro';
import AntecedenteDetalle from '../../../components/antecedentes/AntecedenteDetalle.astro';
import AntecedenteCTA from '../../../components/antecedentes/AntecedenteCTA.astro';
import AntecedenteGaleria from '../../../components/antecedentes/AntecedenteGaleria.astro';
import AntecedenteServicios from '../../../components/antecedentes/AntecedenteServicios.astro';
import AntecedenteMeta from '../../../components/antecedentes/AntecedenteMeta.astro';
import AntecedenteDescripcion from '../../../components/antecedentes/AntecedenteDescripcion.astro';
import LightboxGaleria from '../../../components/common/LightboxGaleria.astro';
import { fetchAntecedente, generateSlug } from '../../../utils/auth.js';

// Nota: Los estilos de Material Icons se importan en el layout

// Obtener parámetros de la URL
const { id, slug } = Astro.params;

// Obtener datos del antecedente
let antecedente;
try {
  // Obtener datos del antecedente usando la función centralizada
  antecedente = await fetchAntecedente(id);
  
  // Generar slug esperado a partir del título
  const expectedSlug = generateSlug(antecedente.Titulo);

  // Redirigir si el slug no coincide con el esperado
  if (slug !== expectedSlug) {
    return Astro.redirect(`/antecedentes/${id}/${expectedSlug}`);
  }
} catch (error) {
  console.error('Error:', error);
  return Astro.redirect('/404');
}
---

<Layout title={antecedente.Titulo} class="bg-gray-100">
  <!-- Hero Section con imagen de fondo y título -->
  <AntecedenteHero 
    titulo={antecedente.Titulo}
    subtitulo={antecedente.Subtitulo}
    imagenFondo={antecedente.ImagenFondo}
    cliente={antecedente.Cliente || 'Cliente'}
    fecha={antecedente.Fecha || new Date().toISOString().split('T')[0]}
    estado={antecedente.Estado || 'Completado'}
  />

  <!-- Contenido Principal -->
  <div class="bg-gray-100 pb-16">
    <!-- Sección de KPIs -->
    <AntecedenteKPIs />
    
    <!-- Sección de Gráficos -->
    <AntecedenteGraficos />
    
    <!-- Información Detallada -->
    <AntecedenteDetalle 
      casoId={antecedente.ID || `#${Math.floor(Math.random() * 10000)}`}
      cliente={antecedente.Cliente || 'Cliente'}
      fechaCreacion={antecedente.Fecha || new Date().toISOString().split('T')[0]}
      prioridad={antecedente.Prioridad || 'Alta'}
      analista={antecedente.Analista || 'Equipo Ultima Milla'}
      presupuesto={antecedente.Presupuesto || 'Consultar'}
      resumen={antecedente.Descripcion || 'Información detallada del caso no disponible.'}
      areasFoco={antecedente.AreasFoco || ['Verificación Técnica', 'Revisión de Cumplimiento', 'Evaluación de Riesgos']}
    />
    
    <!-- CTA Section -->
    <AntecedenteCTA />
    
    <!-- Contenido Adicional -->
    <div class="container mx-auto px-4">
      <!-- Sección de Galería -->
      {antecedente.Galeria && antecedente.Galeria.length > 0 && (
        <AntecedenteGaleria galeria={antecedente.Galeria} />
      )}

      <!-- Información Adicional -->
      <AntecedenteMeta antecedente={antecedente} />

      <!-- Sección de Servicios Relacionados -->
      {antecedente.Servicios && antecedente.Servicios.length > 0 && (
        <AntecedenteServicios servicios={antecedente.Servicios} />
      )}
      
      <!-- Botón para volver a Antecedentes -->
      <div class="flex justify-center py-12">
        <a 
          href="/antecedentes" 
          class="inline-flex items-center px-6 py-3 border border-transparent text-base font-medium rounded-md shadow-sm text-white bg-red-600 hover:bg-red-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-red-500 transition-colors duration-300"
        >
          <svg class="mr-2 w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18" />
          </svg>
          Volver a Antecedentes
        </a>
      </div>
    </div>
  
  <!-- Componente Lightbox para la Galería -->
  <LightboxGaleria />
</Layout>

<!-- Importar estilos CSS externos -->
<link rel="stylesheet" href="/src/styles/antecedentes.css" />

<script>
  // Importar Alpine.js para interactividad
  import Alpine from 'alpinejs';
  window.Alpine = Alpine;
  Alpine.start();
</script>
