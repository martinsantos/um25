---
import LayoutV4 from '../../layouts/LayoutV4.astro';
import { getAntecedentes, getServicios } from '../../lib/um26-directus';

const heroImage = '/img/antecedentes/3068.webp';

const sectors = [
  ['aeropuertos', 'Aeropuertos', '14', '#1A56C0'],
  ['bodegas', 'Bodegas', '16', '#2D8A2D'],
  ['constructoras', 'Constructoras', '13', '#A1A1AA'],
  ['gobierno', 'Gobierno', '17', '#1A56C0'],
  ['industria', 'Industria', '15', '#DC2626'],
  ['mineria', 'Minería', '10', '#71717A'],
  ['salud', 'Salud', '16', '#DC2626'],
  ['seguridad', 'Seguridad', '11', '#FAFAFA'],
  ['software', 'Software', '8', '#1A56C0'],
];

const services = [
  ['redes', 'Redes', '41'],
  ['seguridad-electronica', 'Seguridad electrónica', '28'],
  ['telecomunicaciones', 'Telecomunicaciones', '13'],
  ['software', 'Software a medida', '21'],
  ['soporte', 'Soporte 24/7', '64'],
  ['consultoria', 'Consultoría IT', '32'],
  ['incendios', 'Detección de incendios', '23'],
  ['electricos', 'Eléctricos IT', '18'],
];

const years = [
  ['2025', '16'],
  ['2024', '47'],
  ['2023', '40'],
  ['2022', '16'],
  ['2021', '1'],
];

const statuses = [
  ['verificado', 'Verificado', '69', '#2D8A2D'],
  ['operativo', 'Operativo', '43', '#DC2626'],
  ['mantenimiento', 'Mantenimiento', '8', '#71717A'],
];

const antecedentes = await getAntecedentes({ limit: 1000 });
const initialResultCount = antecedentes.length;
const serviciosCatalog = await getServicios();
const antecedentesById = new Map(antecedentes.map((item) => [item.id, item]));
const serviciosByCode = new Map(serviciosCatalog.map((item) => [item.code, item]));
const sectorLabelMap = new Map(sectors.map(([key, label]) => [key, label]));
const statusLabelMap = {
  verificado: 'Verificado',
  operativo: 'Operativo',
  mantenimiento: 'Mantenimiento',
};

const demoLeadOrder = [3043, 3029, 3111, 3013, 3022, 3037, 3066, 3031, 3028, 3067, 3068, 3071];
const orderedLeadCases = demoLeadOrder
  .map((id) => antecedentesById.get(id))
  .filter(Boolean);
const fallbackCases = antecedentes
  .filter((item) => !demoLeadOrder.includes(item.id));

const cases = [...orderedLeadCases, ...fallbackCases].map((item, index) => {
  const caseServices = item.service_codes
    .map((code) => serviciosByCode.get(code))
    .filter(Boolean);
  return {
    id: String(item.id),
    client: item.client,
    title: item.title,
    summary: item.summary,
    year: String(item.year),
    location: item.location,
    sector: sectorLabelMap.get(item.sector_slug) || item.sector_slug,
    sectorKey: item.sector_slug,
    status: item.status,
    statusLabel: statusLabelMap[item.status],
    image: item.image,
    href: `/antecedentes/${item.id}/${item.slug}`,
    tags: item.tags,
    scope: item.scope,
    serviceCodes: item.service_codes.map(String),
    serviceNames: caseServices.map((service) => service.name),
    serviceSlugs: caseServices.map((service) => service.slug),
    variant: index === 0 ? 'featured' : index === 5 ? 'wide' : undefined,
  };
});
---

<LayoutV4
  title="Evidencia operativa real | ULTIMA MILLA"
  description="Antecedentes operativos UMSA con cliente, sector, servicio aplicado y alcance técnico verificable."
  image={heroImage}
>
  <div class="um26-evidence">
    <section class="um26-evidence-hero" aria-labelledby="evidence-title">
      <img src={heroImage} alt="" loading="eager" decoding="async" fetchpriority="high" />
      <div class="um26-evidence-hero__shade" aria-hidden="true"></div>
      <div class="um26-shell">
        <p class="um26-kicker"><span></span>04 / Evidencia</p>
        <h1 id="evidence-title">
          <span>Evidencia operativa</span>
          <span>real.<i aria-hidden="true"></i></span>
        </h1>
        <p>518 antecedentes con cliente, sector y alcance técnico.</p>
      </div>
    </section>

    <main class="um26-shell um26-evidence-main">
      <section class="um26-filters" aria-label="Filtros de antecedentes">
        <label class="um26-search">
          <input type="search" data-um26-search aria-label="Buscar por cliente, sector, servicio o alcance" placeholder="Buscar antecedentes…" />
        </label>

        <div class="um26-filter-row">
          <strong>Sector</strong>
          <div>
            {sectors.map(([key, label, count, color]) => (
              <button type="button" data-filter="sector" data-value={key} style={`--dot:${color};`}>
                <i></i>{label}<span>{count}</span>
              </button>
            ))}
          </div>
        </div>

        <div class="um26-filter-row">
          <strong>Servicio</strong>
          <div>
            {services.map(([key, label, count]) => (
              <button type="button" data-filter="service" data-value={key}>{label}<span>{count}</span></button>
            ))}
          </div>
        </div>

        <div class="um26-filter-split">
          <div class="um26-filter-row">
            <strong>Año</strong>
            <div>
              {years.map(([year, count]) => <button type="button" data-filter="year" data-value={year}>{year}<span>{count}</span></button>)}
            </div>
          </div>
          <div class="um26-filter-row">
            <strong>Estado</strong>
            <div>
              {statuses.map(([key, label, count, color]) => (
                <button type="button" data-filter="status" data-value={key} style={`--dot:${color};`}>
                  <i></i>{label}<span>{count}</span>
                </button>
              ))}
            </div>
          </div>
        </div>
      </section>

      <section class="um26-results-bar" aria-label="Resultados">
        <p>Resultados <strong data-result-count>{initialResultCount}</strong> <span>/ 518</span></p>
        <div>
          <button type="button" class="is-active" aria-label="Vista grilla" aria-pressed="true" data-view-toggle="grid">
            <span class="um26-view-icon um26-view-icon--grid" aria-hidden="true"></span>
          </button>
          <button type="button" aria-label="Vista lista" aria-pressed="false" data-view-toggle="list">
            <span class="um26-view-icon um26-view-icon--list" aria-hidden="true"></span>
          </button>
          <select aria-label="Ordenar antecedentes" data-sort-select>
            <option value="recent">Más recientes</option>
            <option value="oldest">Más antiguos</option>
            <option value="client">Por cliente A-Z</option>
          </select>
        </div>
      </section>

      <section class="um26-case-grid" aria-label="Antecedentes" data-case-grid>
        {cases.map((item, index) => (
          <button
            type="button"
            class:list={['um26-case-card', item.variant === 'featured' && 'um26-case-card--featured', item.variant === 'wide' && 'um26-case-card--wide']}
            data-case-card
            data-modal-target={item.id}
            data-order={index}
            data-client={item.client.toLowerCase()}
            data-title={item.title.toLowerCase()}
            data-search={`${item.client} ${item.title} ${item.summary} ${item.sector} ${item.tags.join(' ')} ${item.serviceNames.join(' ')}`.toLowerCase()}
            data-sector={item.sectorKey}
            data-status={item.status}
            data-year={item.year}
            data-tags={`${item.tags.join(' ')} ${item.serviceSlugs.join(' ')} ${item.serviceCodes.join(' ')}`.toLowerCase()}
          >
            {item.variant === 'wide' ? (
              <>
                <img src={item.image} alt="" loading="lazy" decoding="async" />
                <div class="um26-case-card__body">
                  <p>{item.client} · {item.year}</p>
                  <h2>{item.title}</h2>
                  <span>{item.summary}</span>
                  <small>{item.sector} · #{item.id}</small>
                </div>
              </>
            ) : item.variant === 'featured' ? (
              <>
                <img src={item.image} alt="" loading="eager" decoding="async" />
                <b>#{item.id}</b>
                <em>{item.status}</em>
                <div class="um26-case-card__overlay">
                  <p>{item.client} · {item.year}</p>
                  <h2>{item.title}</h2>
                  <span>{item.summary}</span>
                </div>
              </>
            ) : (
              <>
                <div class="um26-case-card__thumb">
                  <img src={item.image} alt="" loading={index < 12 ? 'eager' : 'lazy'} decoding="async" />
                </div>
                <div class="um26-case-card__body">
                  <p>{item.client}</p>
                  <h2>{item.title}</h2>
                  <span>{item.summary}</span>
                  <small>{item.sector} · {item.year} · #{item.id}</small>
                </div>
              </>
            )}
            <i aria-hidden="true"></i>
          </button>
        ))}
      </section>

      <div class="um26-case-modal-backdrop" data-case-modal-backdrop hidden>
        <div class="um26-case-modal" role="dialog" aria-modal="true" aria-label="Ficha rápida de antecedente">
          {cases.map((item) => (
            <article class="um26-case-modal__panel" data-case-modal={item.id} hidden>
              <button type="button" class="um26-case-modal__close" data-modal-close aria-label="Cerrar">×</button>
              <p class="um26-case-modal__eyebrow"><span>#{item.id}</span> / {item.client}</p>
              <h2>{item.title}</h2>
              <div class="um26-case-modal__meta">
                <span>{item.sector}</span>
                <span>{item.year}</span>
                <span>{item.location}</span>
                <span>{item.statusLabel}</span>
              </div>
              <p class="um26-case-modal__summary">{item.summary}</p>

              <div class="um26-case-modal__block">
                <h3>Servicios aplicados</h3>
                <div class="um26-case-modal__chips">
                  {item.serviceNames.slice(0, 2).map((name) => <span>{name}</span>)}
                </div>
              </div>

              <div class="um26-case-modal__block">
                <h3>Alcance</h3>
                <ul>
                  {item.scope.map((scopeItem) => <li>{scopeItem}</li>)}
                </ul>
              </div>

              <div class="um26-case-modal__block">
                <h3>Tags</h3>
                <div class="um26-case-modal__chips um26-case-modal__chips--muted">
                  {item.tags.map((tag) => <span>#{tag}</span>)}
                </div>
              </div>

              <footer>
                <span>Ficha rápida · {item.id}</span>
                <a href={item.href}>Ver detalle completo</a>
              </footer>
            </article>
          ))}
        </div>
      </div>

      <section class="um26-empty" data-empty hidden>
        <h2>Sin evidencia que coincida</h2>
        <p>No encontramos antecedentes con los filtros actuales. Probá con menos restricciones o limpiá filtros.</p>
      </section>
    </main>

    <section class="um26-contact">
      <div class="um26-shell">
        <div class="um26-contact__panel">
          <div>
            <p class="um26-kicker"><span></span>Contacto rápido</p>
            <h2>Ordenemos su infraestructura y su continuidad operativa.</h2>
            <p>Respondemos en el día con un relevamiento técnico y una propuesta verificable.</p>
          </div>
          <div>
            <a class="um26-btn um26-btn--red" href="mailto:contacto@ultimamilla.com.ar">contacto@ultimamilla.com.ar</a>
            <span>Lun-Vie 08:00-18:00</span>
          </div>
        </div>
      </div>
    </section>
  </div>

  <script is:inline data-astro-rerun define:vars={{ initialResultCount }}>
    function initEvidencePage() {
      const root = document.querySelector('.um26-evidence');
      if (!root || root.getAttribute('data-ready') === 'true') return;
      root.setAttribute('data-ready', 'true');

      const search = root.querySelector('[data-um26-search]');
      const cards = Array.from(root.querySelectorAll('[data-case-card]'));
      const chips = Array.from(root.querySelectorAll('[data-filter]'));
      const count = root.querySelector('[data-result-count]');
      const empty = root.querySelector('[data-empty]');
      const grid = root.querySelector('[data-case-grid]');
      const viewButtons = Array.from(root.querySelectorAll('[data-view-toggle]'));
      const sortSelect = root.querySelector('[data-sort-select]');
      const filters = { sector: '', service: '', year: '', status: '' };
      const modalBackdrop = root.querySelector('[data-case-modal-backdrop]');
      const modalPanels = Array.from(root.querySelectorAll('[data-case-modal]'));
      const closeModalButtons = Array.from(root.querySelectorAll('[data-modal-close]'));
      let activeView = 'grid';

      function numberValue(card, attribute) {
        return Number(card.getAttribute(attribute) || 0);
      }

      function setView(view) {
        activeView = view === 'list' ? 'list' : 'grid';
        grid?.classList.toggle('um26-case-grid--list', activeView === 'list');
        viewButtons.forEach((button) => {
          const isActive = button.getAttribute('data-view-toggle') === activeView;
          button.classList.toggle('is-active', isActive);
          button.setAttribute('aria-pressed', String(isActive));
        });
      }

      function sortCards() {
        if (!grid) return;
        const mode = String(sortSelect?.value || 'recent');
        const ordered = cards.slice().sort((a, b) => {
          if (mode === 'oldest') {
            return numberValue(a, 'data-year') - numberValue(b, 'data-year') || numberValue(a, 'data-order') - numberValue(b, 'data-order');
          }
          if (mode === 'client') {
            const client = String(a.getAttribute('data-client') || '').localeCompare(String(b.getAttribute('data-client') || ''), 'es');
            return client || String(a.getAttribute('data-title') || '').localeCompare(String(b.getAttribute('data-title') || ''), 'es');
          }
          return numberValue(a, 'data-order') - numberValue(b, 'data-order');
        });
        ordered.forEach((card) => grid.appendChild(card));
        applyFilters();
      }

      function applyFilters() {
        const q = String(search?.value || '').trim().toLowerCase();
        const hasActiveFilter = Boolean(q || filters.sector || filters.service || filters.year || filters.status);
        let visible = 0;
        for (const card of cards) {
          const text = String(card.getAttribute('data-search') || '');
          const tags = String(card.getAttribute('data-tags') || '');
          const match =
            (!q || text.includes(q)) &&
            (!filters.sector || card.getAttribute('data-sector') === filters.sector) &&
            (!filters.year || card.getAttribute('data-year') === filters.year) &&
            (!filters.status || card.getAttribute('data-status') === filters.status) &&
            (!filters.service || tags.includes(filters.service));
          card.hidden = !match;
          if (match) visible += 1;
        }
        if (count) count.textContent = String(hasActiveFilter ? visible : initialResultCount);
        if (empty) empty.hidden = visible !== 0;
      }

      function closeCaseModal() {
        if (!modalBackdrop) return;
        modalBackdrop.hidden = true;
        modalPanels.forEach((panel) => {
          panel.hidden = true;
        });
        document.documentElement.classList.remove('um26-modal-open');
      }

      function openCaseModal(id) {
        if (!modalBackdrop) return;
        const activePanel = modalPanels.find((panel) => panel.getAttribute('data-case-modal') === id);
        if (!activePanel) return;
        modalPanels.forEach((panel) => {
          panel.hidden = panel !== activePanel;
        });
        modalBackdrop.hidden = false;
        document.documentElement.classList.add('um26-modal-open');
      }

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const type = chip.getAttribute('data-filter');
          const value = chip.getAttribute('data-value') || '';
          if (!type) return;
          filters[type] = filters[type] === value ? '' : value;
          chips
            .filter((item) => item.getAttribute('data-filter') === type)
            .forEach((item) => item.classList.toggle('is-active', item === chip && filters[type] === value));
          applyFilters();
        });
      });

      cards.forEach((card) => {
        card.addEventListener('click', () => {
          openCaseModal(card.getAttribute('data-modal-target') || '');
        });
      });

      viewButtons.forEach((button) => {
        button.addEventListener('click', () => {
          setView(button.getAttribute('data-view-toggle') || 'grid');
        });
      });

      closeModalButtons.forEach((button) => {
        button.addEventListener('click', closeCaseModal);
      });

      search?.addEventListener('input', applyFilters);
      sortSelect?.addEventListener('change', sortCards);

      modalBackdrop?.addEventListener('click', (event) => {
        if (event.target === modalBackdrop) closeCaseModal();
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') closeCaseModal();
      });

      setView(activeView);
      sortCards();
    }

    initEvidencePage();
    document.addEventListener('astro:page-load', initEvidencePage);
  </script>

  <style>
    :global(body[data-skin]) main {
      background: #0a0a0b;
    }

    .um26-evidence {
      background: #0a0a0b;
      color: #fafafa;
      font-family: var(--um-font-body);
    }

    .um26-shell {
      width: min(1336px, calc(100% - 78px));
      margin-inline: auto;
    }

    .um26-evidence-hero {
      position: relative;
      min-height: clamp(208px, 18vw, 230px);
      display: flex;
      align-items: flex-end;
      overflow: hidden;
      border-bottom: 1px solid rgba(255,255,255,0.08);
      isolation: isolate;
    }

    .um26-evidence-hero > img,
    .um26-evidence-hero__shade {
      position: absolute;
      inset: 0;
    }

    .um26-evidence-hero > img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      z-index: -3;
    }

    .um26-evidence-hero__shade {
      z-index: -2;
      background:
        linear-gradient(105deg, rgba(10,10,11,0.94), rgba(10,10,11,0.62) 46%, rgba(10,10,11,0.22)),
        linear-gradient(to top, #0a0a0b, rgba(10,10,11,0.55) 48%, transparent);
    }

    .um26-evidence-hero .um26-shell {
      padding-block: 0 30px;
    }

    .um26-kicker {
      display: inline-flex;
      align-items: center;
      gap: 14px;
      margin: 0 0 14px;
      color: #dc2626;
      font-family: var(--um-font-mono);
      font-size: 11px;
      font-weight: 600;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .um26-kicker span {
      width: 36px;
      height: 3px;
      background: #dc2626;
    }

    .um26-evidence-hero h1,
    .um26-case-card h2,
    .um26-contact h2 {
      margin: 0;
      color: #fff;
      font-family: var(--um-font-display);
      font-weight: 800;
      letter-spacing: -0.045em;
      line-height: 0.94;
    }

    .um26-evidence-hero h1 {
      max-width: 900px;
      font-size: clamp(2.25rem, 3.55vw, 3.15rem);
      text-shadow: 0 10px 38px rgba(0,0,0,0.65);
    }

    .um26-evidence-hero h1 span {
      display: inline;
    }

    .um26-evidence-hero h1 i {
      display: inline-block;
      width: 8px;
      height: 0.82em;
      margin-left: 0.08em;
      background: #dc2626;
      transform: translateY(0.08em);
      animation: um26-blink 1s steps(2, start) infinite;
    }

    @keyframes um26-blink {
      0%, 50% { opacity: 1; }
      51%, 100% { opacity: 0; }
    }

    .um26-evidence-hero p:not(.um26-kicker) {
      max-width: 680px;
      margin: 10px 0 0;
      color: #d4d4d8;
      font-size: 0.95rem;
      line-height: 1.5;
    }

    .um26-evidence-main {
      position: relative;
      padding-block: 26px 96px;
      background: #0a0a0b;
    }

    :global(body[data-skin]) main.um26-evidence-main {
      background: #0a0a0b !important;
    }

    .um26-evidence-main::before {
      content: "";
      position: absolute;
      inset: 0;
      z-index: 0;
      background-image: linear-gradient(rgba(255,255,255,0.03) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.03) 1px, transparent 1px);
      background-size: 48px 48px;
      pointer-events: none;
    }

    .um26-evidence-main > * {
      position: relative;
      z-index: 1;
    }

    .um26-filters {
      display: grid;
      gap: 12px;
      margin-top: 0;
      padding: 18px;
      border: 1px solid rgba(255,255,255,0.12);
      background: #0b0b0d;
      box-shadow: 0 18px 45px rgba(0,0,0,0.28);
    }

    .um26-search {
      display: block;
      position: relative;
    }

    .um26-search span {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }

    .um26-search::before {
      content: "";
      position: absolute;
      left: 15px;
      top: 50%;
      width: 12px;
      height: 12px;
      transform: translateY(-50%);
      border: 2px solid #dc2626;
      border-radius: 50%;
    }

    .um26-search::after {
      content: "";
      position: absolute;
      left: 26px;
      top: calc(50% + 7px);
      width: 7px;
      height: 2px;
      transform: rotate(45deg);
      background: #dc2626;
    }

    .um26-search input {
      width: 100%;
      height: 52px;
      padding: 0 18px 0 48px;
      border: 1px solid rgba(255,255,255,0.12);
      background: #121214;
      color: #fff;
      font: inherit;
      font-size: 15px;
      outline: none;
      border-radius: 0;
    }

    .um26-search input:focus {
      border-color: #dc2626;
      box-shadow: 0 0 0 3px rgba(220,38,38,0.15);
    }

    .um26-filter-row,
    .um26-filter-split {
      display: grid;
      gap: 10px;
    }

    .um26-filter-row {
      grid-template-columns: 116px minmax(0, 1fr);
      align-items: start;
    }

    .um26-filter-split {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    .um26-filter-row strong {
      color: #71717a;
      font-family: var(--um-font-logo);
      font-size: 11px;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      padding-top: 6px;
      white-space: nowrap;
    }

    .um26-filter-row div {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;
      min-width: 0;
    }

    .um26-filter-row button {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      min-height: 30px;
      padding: 0 10px;
      border: 1px solid rgba(255,255,255,0.1);
      background: #121214;
      color: #a1a1aa;
      font: inherit;
      font-size: 12px;
      line-height: 1.45;
      cursor: pointer;
      transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease;
      border-radius: 0;
      white-space: nowrap;
    }

    .um26-filter-row button:hover,
    .um26-filter-row button.is-active {
      border-color: #dc2626;
      background: rgba(220,38,38,0.1);
      color: #fff;
    }

    .um26-filter-row button i {
      width: 7px;
      height: 7px;
      background: var(--dot, #dc2626);
      border-radius: 50%;
    }

    .um26-filter-row button span {
      color: #52525b;
      font-family: var(--um-font-logo);
      font-size: 10px;
