---
/**
 * Antecedentes Index - V4 Design System
 * Case studies listing page with FILTER BUTTONS (not links)
 * Matches approved v4-ready-to-deploy/antecedentes-index-v4.html
 */

import LayoutV4 from '../../layouts/LayoutV4.astro';
import HeroPageV4 from '../../components/v4/HeroPageV4.astro';
import CTASection from '../../components/v4/CTASection.astro';
import { getAllAntecedentes, getDirectusImageUrl, getDirectusImageFallback, withBase } from "../../lib/directus.ts";
const PAGE_SIZE = 20;
const DEFAULT_IMAGE = '/images/default.jpg';

// Obtener parámetros de la URL
const getUrlParams = (url) => {
  const searchParams = new URL(url).searchParams;
  const resetFilters = searchParams.get('reset') === '1';

  const activeFilters = resetFilters
    ? { area: '', cliente: '', unidad_negocio: '', sector: '' }
    : {
        area: searchParams.get('area') || '',
        cliente: searchParams.get('cliente') || '',
        unidad_negocio: searchParams.get('unidad_negocio') || '',
        sector: searchParams.get('sector') || ''
      };

  return {
    searchQuery: searchParams.get('q') || '',
    currentPage: Math.max(1, parseInt(searchParams.get('page') || '1')),
    activeFilters,
    pageSize: PAGE_SIZE
  };
};

// Cargar datos iniciales
let pageData = {
  antecedentes: [],
  error: null,
  totalItems: 0,
  totalPages: 1,
  isLoading: true,
  ...getUrlParams(Astro.request?.url || Astro.url)
};

// Sector keywords for filtering
const sectorKeywords: Record<string, string[]> = {
  'aeropuertos': ['aeropuerto', 'aeroportuario', 'aviación', 'aviacion', 'terminal aérea', 'aerolinea'],
  'bodegas': ['bodega', 'vino', 'vitivinícola', 'vitivinicola', 'viñedo', 'vinedo', 'enología'],
  'gobierno': ['gobierno', 'municipal', 'provincial', 'público', 'publico', 'ministerio', 'secretaría', 'legislatura'],
  'salud': ['hospital', 'clínica', 'clinica', 'sanatorio', 'salud', 'médico', 'medico', 'sanitario'],
  'construccion': ['constructora', 'construcción', 'construccion', 'edificio', 'torre', 'inmobiliaria', 'obra'],
  'industria': ['industria', 'industrial', 'fábrica', 'fabrica', 'planta', 'manufactura', 'producción'],
  'datacenter': ['data center', 'datacenter', 'centro de datos', 'servidor', 'rack', 'hosting'],
  'mineria': ['minería', 'mineria', 'mina', 'minero', 'extracción', 'yacimiento'],
  'seguridad': ['seguridad', 'cctv', 'videovigilancia', 'control acceso', 'alarma', 'monitoreo'],
  'software': ['software', 'desarrollo', 'aplicación', 'aplicacion', 'sistema', 'web', 'app'],
};

// Función para filtrar antecedentes
const filterAntecedentes = (antecedentes, filters, searchQuery) => {
  let filtered = [...antecedentes];

  if (searchQuery) {
    const query = searchQuery.toLowerCase();
    filtered = filtered.filter(item =>
      item.Titulo.toLowerCase().includes(query) ||
      item.Descripcion.toLowerCase().includes(query) ||
      item.Cliente.toLowerCase().includes(query) ||
      item.Area.toLowerCase().includes(query)
    );
  }

  // Filter by sector (using keywords)
  if (filters.sector && sectorKeywords[filters.sector]) {
    const keywords = sectorKeywords[filters.sector];
    filtered = filtered.filter(item => {
      const searchText = `${item.Titulo} ${item.Descripcion} ${item.Cliente} ${item.Area}`.toLowerCase();
      return keywords.some(kw => searchText.includes(kw.toLowerCase()));
    });
  }

  if (filters.unidad_negocio) {
    filtered = filtered.filter(item => item.Unidad_de_negocio === filters.unidad_negocio);
  }

  if (filters.area) {
    filtered = filtered.filter(item => item.Area === filters.area);
  }

  if (filters.cliente) {
    filtered = filtered.filter(item => item.Cliente.toLowerCase().includes(filters.cliente.toLowerCase()));
  }

  return filtered;
};


// Inline slug generation to avoid import issues
const localGenerateSlug = (text = '') => {
  if (!text || text === null || typeof text === 'undefined') {
    return 'item';
  }

  const slug = String(text)
    .toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/[^\w\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 100);

  return slug || 'item';
};

// Lógica de carga de datos
try {
  console.log('[ANTECEDENTES-DEBUG] Starting to load antecedentes...');
  const response = await getAllAntecedentes();
  console.log('[ANTECEDENTES-DEBUG] Response received:', response ? response.length : 'null', 'items');

  let allAntecedentes = response.map(item => ({
    ...item,
    slug: `${item.id}/${localGenerateSlug(item.Titulo)}`,
    imageUrl: getDirectusImageUrl(item.Imagen),
    imageFallback: getDirectusImageFallback(item.Imagen)
  }));

  console.log('[ANTECEDENTES-DEBUG] Mapped', allAntecedentes.length, 'items successfully');

  const filteredAntecedentes = filterAntecedentes(allAntecedentes, pageData.activeFilters, pageData.searchQuery);

  const startIndex = (pageData.currentPage - 1) * PAGE_SIZE;
  const endIndex = startIndex + PAGE_SIZE;
  const paginatedAntecedentes = filteredAntecedentes.slice(startIndex, endIndex);

  pageData = {
    ...pageData,
    antecedentes: paginatedAntecedentes,
    totalItems: filteredAntecedentes.length,
    totalPages: Math.ceil(filteredAntecedentes.length / PAGE_SIZE),
    error: null,
    isLoading: false
  };

} catch (error) {
  console.error('[ANTECEDENTES-DEBUG] Error loading antecedentes from Directus:', error);
  console.error('[ANTECEDENTES-DEBUG] Error stack:', error.stack);
  pageData = {
    ...pageData,
    antecedentes: [],
    error: 'Error loading projects',
    isLoading: false
  };
}

// Opciones de filtro
// Use all antecedentes for filters (loaded from Directus above)
const allDataForFilters = pageData.antecedentes;
const filterOptions = {
  unidades: [...new Set(allDataForFilters.map(i => i.Unidad_de_negocio).filter(Boolean))].sort(),
  areas: [...new Set(allDataForFilters.map(i => i.Area).filter(Boolean))].sort(),
  clientes: [...new Set(allDataForFilters.map(i => i.Cliente).filter(Boolean))].sort()
};

// Helpers de URL
const buildPageUrl = (page) => {
  const url = new URL(Astro.request.url);
  url.searchParams.set('page', page.toString());
  return url.pathname + url.search;
};

const buildSectorUrl = (sector: string) => {
  const url = new URL(Astro.request.url);
  if (sector) {
    url.searchParams.set('sector', sector);
  } else {
    url.searchParams.delete('sector');
  }
  url.searchParams.set('page', '1');
  return url.pathname + url.search;
};

// Extract filter values
const searchQuery = pageData.searchQuery;
const areaFilter = pageData.activeFilters.area;
const unidadFilter = pageData.activeFilters.unidad_negocio;
const sectorFilter = pageData.activeFilters.sector;
const areas = filterOptions.areas;
const unidades = filterOptions.unidades;

// Compute pagination pages
const computePaginationPages = () => {
  const total = pageData.totalPages;
  const current = pageData.currentPage;
  const maxPages = 5;

  if (total <= maxPages) {
    return Array.from({ length: total }, (_, i) => i + 1);
  }

  if (current <= 3) {
    return [1, 2, 3, 4, 5];
  }

  if (current >= total - 2) {
    return [total - 4, total - 3, total - 2, total - 1, total];
  }

  return [current - 2, current - 1, current, current + 1, current + 2];
};

const paginationPages = computePaginationPages();

// Mapeo de colores por categoría/sector para badges
const getCategoryBadgeColor = (category: string): string => {
  const normalizedCategory = category?.toLowerCase().trim() || '';

  const colorMap: Record<string, string> = {
    'gobierno': 'bg-blue-500',
    'sector público': 'bg-blue-500',
    'municipal': 'bg-blue-500',
    'municipalidad': 'bg-blue-500',
    'aeropuertos': 'bg-sky-500',
    'aeropuerto': 'bg-sky-500',
    'transporte': 'bg-sky-500',
    'bodegas': 'bg-purple-500',
    'bodega': 'bg-purple-500',
    'vitivinícola': 'bg-purple-500',
    'agroindustria': 'bg-purple-500',
    'salud': 'bg-green-500',
    'hospital': 'bg-green-500',
    'clínica': 'bg-green-500',
    'médico': 'bg-green-500',
    'data center': 'bg-orange-500',
    'datacenter': 'bg-orange-500',
    'infraestructura': 'bg-orange-500',
    'ti': 'bg-orange-500',
    'construcción': 'bg-amber-500',
    'constructora': 'bg-amber-500',
    'obra': 'bg-amber-500',
    'industria': 'bg-indigo-500',
    'industrial': 'bg-indigo-500',
    'manufactura': 'bg-indigo-500',
    'fábrica': 'bg-indigo-500',
    'software': 'bg-cyan-500',
    'desarrollo': 'bg-cyan-500',
    'aplicación': 'bg-cyan-500',
    'minería': 'bg-slate-500',
    'minera': 'bg-slate-500',
    'mining': 'bg-slate-500',
    'seguridad': 'bg-red-500',
    'seguridad electrónica': 'bg-red-500',
    'cctv': 'bg-red-500',
    'telecomunicaciones': 'bg-teal-500',
    'redes': 'bg-teal-500',
    'redes y comunicaciones': 'bg-teal-500',
    'comunicaciones': 'bg-teal-500',
  };

  for (const [key, color] of Object.entries(colorMap)) {
    if (normalizedCategory.includes(key) || key.includes(normalizedCategory)) {
      return color;
    }
  }

  return 'bg-um-primary';
};

// Filter chips V4 design - BUTTONS not links
const filterChips = [
  { id: '', name: 'Todas', icon: 'grid' },
  { id: 'aeropuertos', name: 'Aeropuertos', icon: 'plane' },
  { id: 'bodegas', name: 'Bodegas', icon: 'wine' },
  { id: 'gobierno', name: 'Gobierno', icon: 'landmark' },
  { id: 'salud', name: 'Salud', icon: 'heart' },
  { id: 'construccion', name: 'Construcción', icon: 'building' },
  { id: 'industria', name: 'Industria', icon: 'factory' },
  { id: 'datacenter', name: 'Data Center', icon: 'server' },
  { id: 'mineria', name: 'Minería', icon: 'mountain' },
  { id: 'seguridad', name: 'Seguridad', icon: 'shield' },
  { id: 'software', name: 'Software', icon: 'code' },
];

// Icon paths for filter chips
const filterIconPaths: Record<string, string> = {
  grid: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2V6zM14 6a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2V6zM4 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2H6a2 2 0 01-2-2v-2zM14 16a2 2 0 012-2h2a2 2 0 012 2v2a2 2 0 01-2 2h-2a2 2 0 01-2-2v-2z"/>',
  plane: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>',
  wine: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 22h8M12 11v11M5.5 3h13l-1.6 7.2a4 4 0 01-3.9 3.2h-2a4 4 0 01-3.9-3.2L5.5 3z"/>',
  landmark: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z"/>',
  heart: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"/>',
  building: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>',
  factory: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>',
  server: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h14M5 12a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v4a2 2 0 01-2 2M5 12a2 2 0 00-2 2v4a2 2 0 002 2h14a2 2 0 002-2v-4a2 2 0 00-2-2m-2-4h.01M17 16h.01"/>',
  mountain: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>',
  shield: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>',
  code: '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>',
};
---

<LayoutV4
  title="Antecedentes - Casos de Éxito | ULTIMA MILLA"
  description="Explore nuestros +469 casos de éxito y proyectos realizados en telecomunicaciones, cableado estructurado, seguridad electrónica, desarrollo de software y soluciones tecnológicas en Mendoza, Cuyo y Patagonia."
  keywords="casos exito tecnologia mendoza, proyectos telecomunicaciones, antecedentes cableado estructurado, portfolio seguridad electronica, software a medida casos"
>
  <HeroPageV4
    title="Nuestra"
    titleHighlight="Experiencia"
    subtitle="Más de 22 años transformando empresas en Mendoza, Cuyo y Patagonia con soluciones IT de clase mundial."
    breadcrumb={[
      { label: 'Inicio', href: '/' },
      { label: 'Antecedentes', href: '/antecedentes' },
    ]}
    badge={{ icon: 'briefcase', text: 'Portafolio de Proyectos' }}
    backgroundImage="https://images.unsplash.com/photo-1497366216548-37526070297c?auto=format&fit=crop&w=1920&q=80"
    stats={[
      { value: `${pageData.totalItems}+`, label: 'Proyectos' },
      { value: '22+', label: 'Años' },
      { value: '8', label: 'Verticales' },
    ]}
  />

  <!-- FILTER CHIPS SECTION - V4 Design with RESPONSIVE filters -->
  <section class="bg-white border-b border-gray-100 sticky top-16 sm:top-20 z-40">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4 sm:py-6">
      <div class="flex flex-col lg:flex-row lg:items-center justify-between gap-4">

        <!-- Mobile: Select Dropdown (<1024px) -->
        <div class="lg:hidden">
          <label for="sector-filter-mobile" class="sr-only">Filtrar por sector</label>
          <select
            id="sector-filter-mobile"
            class="w-full px-4 py-3 rounded-lg border border-gray-200 bg-white text-base focus:outline-none focus:ring-2 focus:ring-um-primary/20 focus:border-um-primary min-h-[44px]"
          >
            {filterChips.map((chip) => (
              <option
                value={chip.id}
                selected={sectorFilter === chip.id || (chip.id === '' && !sectorFilter)}
              >
                {chip.name}
              </option>
            ))}
          </select>
        </div>

        <!-- Desktop: Filter Chips (≥1024px) -->
        <div class="hidden lg:flex flex-wrap gap-2" id="filter-chips">
          {filterChips.map((chip) => (
            <a
              href={buildSectorUrl(chip.id)}
              class={`filter-chip px-4 py-2 rounded-full text-sm font-medium border border-gray-200 flex items-center gap-2 transition-all min-h-[44px] ${
                sectorFilter === chip.id || (chip.id === '' && !sectorFilter)
                  ? 'bg-um-primary text-white border-um-primary'
                  : 'text-um-gray hover:bg-um-primary hover:text-white hover:border-um-primary'
              }`}
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={filterIconPaths[chip.icon]} />
              {chip.name}
            </a>
          ))}
        </div>

        <!-- Search -->
        <div class="flex items-center gap-4">
          <form id="search-form" class="relative">
            <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/>
            </svg>
            <input
              type="text"
              name="q"
              value={searchQuery}
              placeholder="Buscar proyecto..."
              class="pl-10 pr-4 py-2.5 border border-gray-200 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-um-primary/20 focus:border-um-primary w-full sm:w-64 min-h-[44px]"
            />
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- RESULTS INFO -->
  <section class="bg-um-primary-bg/50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-4">
      <div class="flex items-center justify-between">
        <p class="text-sm text-um-gray">
          Mostrando <span class="font-semibold text-um-dark">{((pageData.currentPage - 1) * PAGE_SIZE) + 1}-{Math.min(pageData.currentPage * PAGE_SIZE, pageData.totalItems)}</span> de <span class="font-semibold text-um-dark">{pageData.totalItems}</span> proyectos
          {sectorFilter && (
            <span class="ml-2">
              en <span class="font-semibold text-um-primary">{filterChips.find(c => c.id === sectorFilter)?.name}</span>
            </span>
          )}
        </p>
        {(sectorFilter || searchQuery || areaFilter || unidadFilter) && (
          <a
            href={withBase("/antecedentes?reset=1")}
            class="text-sm text-um-primary hover:text-um-primary-dark font-medium flex items-center gap-1"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
            </svg>
            Limpiar filtros
          </a>
        )}
      </div>
    </div>
  </section>

  <!-- Grid de Proyectos -->
  <section class="py-10 sm:py-14 lg:py-20 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      {pageData.antecedentes.length === 0 ? (
        <div class="text-center py-16 sm:py-20">
          <svg class="w-16 h-16 text-um-gray mx-auto mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <h3 class="text-xl font-bold text-um-dark mb-2">No se encontraron proyectos</h3>
          <p class="text-um-gray">Intenta ajustar tus filtros de búsqueda.</p>
          <a href={withBase("/antecedentes?reset=1")} class="inline-block mt-6 px-6 py-3 bg-um-primary text-white font-semibold rounded-lg hover:bg-um-primary-dark transition-colors">
            Ver todos los proyectos
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-4 sm:gap-6 cards-grid">
          {pageData.antecedentes.map((proyecto, index) => (
            <a
              href={withBase(`/antecedentes/${proyecto.slug}`)}
              class="group spotlight-card bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100/80 scroll-reveal transition-all duration-300 hover:-translate-y-1 hover:shadow-xl hover:shadow-black/5"
              style={`animation-delay: ${index * 0.03}s`}
            >
              <div class="relative h-48 overflow-hidden bg-gradient-to-br from-sky-600 via-blue-700 to-indigo-800">
                <img
                  src={proyecto.imageUrl}
                  alt={proyecto.Titulo}
                  class="w-full h-full object-cover mix-blend-luminosity opacity-40 group-hover:opacity-60 group-hover:mix-blend-overlay transition-all duration-500 group-hover:scale-105"
                  loading="lazy"
                  data-fallback={proyecto.imageFallback}
                  onerror="this.style.display='none'"
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
                <span class={`absolute bottom-3 left-3 px-2.5 py-1 bg-black/30 backdrop-blur-sm border border-white/10 text-white text-[11px] font-bold tracking-wide rounded-lg uppercase`}>
                  {proyecto.Area || 'Proyecto'}
                </span>
              </div>
              <div class="p-5">
                <h3 class="font-bold text-gray-900 mb-2 line-clamp-2 group-hover:text-um-primary transition-colors text-pretty">
                  {proyecto.Titulo}
                </h3>
                <p class="text-sm text-gray-500 line-clamp-2 mb-4">
                  {proyecto.Descripcion ? proyecto.Descripcion.replace(/<[^>]*>/g, '').substring(0, 100) + '...' : ''}
                </p>
                <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                  <span class="text-[11px] text-gray-400 font-medium uppercase tracking-wider">{proyecto.Cliente}</span>
                  <span class="text-um-primary text-sm font-semibold flex items-center gap-1 group-hover:gap-2 transition-all">
                    Ver detalle
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      )}

      <!-- Pagination -->
      {pageData.totalPages > 1 && (
        <nav class="mt-12 flex flex-col sm:flex-row items-center justify-between gap-4">
          <p class="text-sm text-um-gray">
            Página <span class="font-semibold text-um-dark">{pageData.currentPage}</span> de <span class="font-semibold text-um-dark">{pageData.totalPages}</span>
          </p>

          <div class="flex items-center gap-2">
            {pageData.currentPage > 1 && (
              <a
                href={buildPageUrl(pageData.currentPage - 1)}
                class="p-2 rounded-lg border border-gray-200 text-um-gray hover:bg-gray-50 min-h-[44px] min-w-[44px] flex items-center justify-center"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
                </svg>
              </a>
            )}

            {paginationPages.map((pageNum) => (
              <a
                href={buildPageUrl(pageNum)}
                class={`w-10 h-10 rounded-lg font-medium flex items-center justify-center min-h-[44px] ${
                  pageData.currentPage === pageNum
                    ? 'bg-um-primary text-white'
                    : 'border border-gray-200 text-um-gray hover:bg-gray-50'
                }`}
              >
                {pageNum}
              </a>
            ))}

            {pageData.currentPage < pageData.totalPages && (
              <a
                href={buildPageUrl(pageData.currentPage + 1)}
                class="p-2 rounded-lg border border-gray-200 text-um-gray hover:bg-gray-50 min-h-[44px] min-w-[44px] flex items-center justify-center"
              >
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
                </svg>
              </a>
            )}
          </div>
        </nav>
      )}
    </div>
  </section>

  <!-- CTA Section -->
  <CTASection
    badge="Comience su proyecto"
    badgeIcon="rocket"
    titulo="¿Tiene un proyecto en mente?"
    descripcion={`Contáctenos para discutir cómo podemos ayudarle a alcanzar sus objetivos tecnológicos. Más de ${pageData.totalItems} proyectos nos respaldan.`}
    primaryButtonText="Solicitar Cotización"
    primaryButtonUrl="/contacto"
    secondaryButtonText="contacto@ultimamilla.com.ar"
    secondaryButtonUrl="mailto:contacto@ultimamilla.com.ar"
    secondaryButtonIcon="mail"
    backgroundImage="https://images.unsplash.com/photo-1497366216548-37526070297c?w=1920&q=80"
    darkOverlay={90}
  />
</LayoutV4>

<style>
  /* V4 Filter chip styles */
  .filter-chip {
    transition: all 0.2s ease;
  }

  /* Card animation */
  .animate-fade-in {
    animation: fadeIn 0.6s ease forwards;
    opacity: 0;
    transform: translateY(20px);
  }

  @keyframes fadeIn {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  /* Card hover */
  .card-hover {
    transition: all 0.3s ease;
  }
  .card-hover:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0,0,0,0.12);
  }
</style>

<script>
  // Search form submit on enter
  const searchForm = document.getElementById('search-form');
  if (searchForm) {
    searchForm.addEventListener('submit', (e) => {
      e.preventDefault();
      const formData = new FormData(searchForm as HTMLFormElement);
      const q = formData.get('q') as string;
      const url = new URL(window.location.href);
      if (q) {
        url.searchParams.set('q', q);
      } else {
        url.searchParams.delete('q');
      }
      url.searchParams.set('page', '1');
      window.location.href = url.toString();
    });
  }

  // Mobile filter dropdown handler
  const mobileFilterSelect = document.getElementById('sector-filter-mobile');
  if (mobileFilterSelect) {
    mobileFilterSelect.addEventListener('change', (e) => {
      const selectedSector = (e.target as HTMLSelectElement).value;
      const url = new URL(window.location.href);

      // Update sector parameter
      if (selectedSector) {
        url.searchParams.set('sector', selectedSector);
      } else {
        url.searchParams.delete('sector');
      }

      // Reset to page 1
      url.searchParams.set('page', '1');

      // Navigate to new URL
      window.location.href = url.toString();
    });
  }
</script>
