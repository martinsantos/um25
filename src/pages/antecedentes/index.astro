---
import Layout from '../../layouts/Layout.astro';
import BreadcrumbSchema from '../../components/SEO/BreadcrumbSchema.astro';
import { directus, PAGE_SIZE, DEFAULT_IMAGE, getAntecedenteImageUrl } from '../../utils/directus';
import { generateSlug } from '../../utils/slugUtils.js';
import { antecedentesReales } from '../../data/antecedentes_completos.js';
import { sortByImpact } from '../../utils/antecedentesScoring.js';
import AntecedentesGridMobileOptimized from '../../components/AntecedentesGridMobileOptimized.astro';

// Configuración SEO optimizada para Antecedentes/Portfolio
const seoConfig = {
  title: "Proyectos IT y Telecomunicaciones | 518+ Casos de Éxito | ULTIMA MILLA",
  description: "Más de 518 proyectos de infraestructura IT, telecomunicaciones, corrientes débiles y software en Mendoza, Cuyo y Patagonia. Trabajos para minería, bodegas, hospitales, aeropuertos, constructoras y gobierno.",
  keywords: "proyectos it argentina, casos exito telecomunicaciones mendoza, antecedentes infraestructura redes, portfolio servicios tecnologicos, proyectos corrientes debiles, instalaciones cctv cableado estructurado, deteccion incendio proyectos"
};

// Obtener parámetros de la URL
const getUrlParams = (url) => {
  const searchParams = new URL(url).searchParams;
  const resetFilters = searchParams.get('reset') === '1';
  
  const activeFilters = resetFilters
    ? { area: '', cliente: '', unidad_negocio: '' }
    : {
        area: searchParams.get('area') || '',
        cliente: searchParams.get('cliente') || '',
        unidad_negocio: searchParams.get('unidad_negocio') || ''
      };

  return {
    searchQuery: searchParams.get('q') || '',
    currentPage: Math.max(1, parseInt(searchParams.get('page') || '1')),
    activeFilters,
    pageSize: PAGE_SIZE
  };
};

// Cargar datos iniciales
let pageData = {
  antecedentes: [],
  error: null,
  totalItems: 0,
  totalPages: 1,
  isLoading: true,
  ...getUrlParams(Astro.request?.url || Astro.url)
};

// Función para filtrar antecedentes
const filterAntecedentes = (antecedentes, filters, searchQuery) => {
  let filtered = [...antecedentes];

  if (searchQuery) {
    const query = searchQuery.toLowerCase();
    filtered = filtered.filter(item => 
      item.Titulo.toLowerCase().includes(query) ||
      item.Descripcion.toLowerCase().includes(query) ||
      item.Cliente.toLowerCase().includes(query) ||
      item.Area.toLowerCase().includes(query)
    );
  }

  if (filters.unidad_negocio) {
    filtered = filtered.filter(item => item.Unidad_de_negocio === filters.unidad_negocio);
  }

  if (filters.area) {
    filtered = filtered.filter(item => item.Area === filters.area);
  }

  if (filters.cliente) {
    filtered = filtered.filter(item => item.Cliente.toLowerCase().includes(filters.cliente.toLowerCase()));
  }

  return filtered;
};

// ✅ Usar función centralizada de directus.js para resolver imágenes
const getImageUrl = getAntecedenteImageUrl;

// Lógica de carga de datos
try {
  const response = await directus.getAntecedentes({ limit: 600, page: 1 });
  let allAntecedentes = [];

  if (response && response.data && response.data.length > 0) {
    allAntecedentes = response.data.map(item => ({
      ...item,
      id: String(item.id).split('/')[0].trim(),
      slug: generateSlug(item.Titulo)
    }));
  } else {
    throw new Error('No se obtuvieron datos válidos');
  }

  let filteredAntecedentes = filterAntecedentes(allAntecedentes, pageData.activeFilters, pageData.searchQuery);

  // ✅ NUEVA: Ordenar por impacto (más importante primero)
  // Sin explicitarlo al usuario - muestra los mejores casos primero
  filteredAntecedentes = sortByImpact(filteredAntecedentes);

  const startIndex = (pageData.currentPage - 1) * PAGE_SIZE;
  const endIndex = startIndex + PAGE_SIZE;
  const paginatedAntecedentes = filteredAntecedentes.slice(startIndex, endIndex);
  
  const antecedentesConImagenes = await Promise.all(
    paginatedAntecedentes.map(async (proyecto) => ({
      ...proyecto,
      imageUrl: await getImageUrl(proyecto)
    }))
  );

  pageData = {
    ...pageData,
    antecedentes: antecedentesConImagenes,
    totalItems: filteredAntecedentes.length,
    totalPages: Math.ceil(filteredAntecedentes.length / PAGE_SIZE),
    isLoading: false
  };

} catch (error) {
  console.error('Error al cargar datos, usando fallback:', error);
  const allAntecedentes = antecedentesReales.map(item => ({
    ...item,
    id: String(item.id).split('/')[0].trim(),
    slug: generateSlug(item.Titulo)
  }));

  let filteredAntecedentes = filterAntecedentes(allAntecedentes, pageData.activeFilters, pageData.searchQuery);

  // ✅ Ordenar por impacto (más importante primero) - fallback también
  filteredAntecedentes = sortByImpact(filteredAntecedentes);

  const startIndex = (pageData.currentPage - 1) * PAGE_SIZE;
  const endIndex = startIndex + PAGE_SIZE;
  const paginatedAntecedentes = filteredAntecedentes.slice(startIndex, endIndex);

  const antecedentesConImagenes = await Promise.all(
    paginatedAntecedentes.map(async (proyecto) => ({
      ...proyecto,
      imageUrl: await getImageUrl(proyecto)
    }))
  );

  pageData = {
    ...pageData,
    antecedentes: antecedentesConImagenes,
    totalItems: filteredAntecedentes.length,
    totalPages: Math.ceil(filteredAntecedentes.length / PAGE_SIZE),
    error: null,
    isLoading: false
  };
}

// Opciones de filtro
const allDataForFilters = antecedentesReales;
const filterOptions = {
  unidades: [...new Set(allDataForFilters.map(i => i.Unidad_de_negocio).filter(Boolean))].sort(),
  areas: [...new Set(allDataForFilters.map(i => i.Area).filter(Boolean))].sort(),
  clientes: [...new Set(allDataForFilters.map(i => i.Cliente).filter(Boolean))].sort()
};

// Helpers de URL
const buildPageUrl = (page) => {
  const url = new URL(Astro.request.url);
  url.searchParams.set('page', page);
  // IMPORTANTE: Preservar búsqueda y filtros al paginar
  if (!url.searchParams.has('q') && pageData.searchQuery) {
    url.searchParams.set('q', pageData.searchQuery);
  }
  if (!url.searchParams.has('area') && pageData.activeFilters.area) {
    url.searchParams.set('area', pageData.activeFilters.area);
  }
  if (!url.searchParams.has('unidad_negocio') && pageData.activeFilters.unidad_negocio) {
    url.searchParams.set('unidad_negocio', pageData.activeFilters.unidad_negocio);
  }
  return url.pathname + url.search;
};

// Extract filter values for the new filter bar structure
const searchQuery = pageData.searchQuery;
const areaFilter = pageData.activeFilters.area;
const unidadFilter = pageData.activeFilters.unidad_negocio;
const areas = filterOptions.areas;
const unidades = filterOptions.unidades;
---

<Layout
  title={seoConfig.title}
  description={seoConfig.description}
  keywords={seoConfig.keywords}
  image="/images/services/servicios-it.jpg"
>
  <BreadcrumbSchema items={[
    { label: 'Inicio', url: '/' },
    { label: 'Antecedentes', url: '/antecedentes' }
  ]} />

  <!-- Hero Section (Immersive, Dark, with Background) -->
  <section class="relative h-[40vh] md:h-[50vh] flex items-center overflow-hidden bg-slate-900">
    <!-- Background Image -->
    <div class="absolute inset-0 z-0">
      <img 
        src="/images/services/servicios-it.jpg" 
        alt="Antecedentes Background" 
        class="w-full h-full object-cover opacity-40"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-slate-900/80 via-slate-900/60 to-slate-900/90"></div>
    </div>

    <div class="relative z-20 w-full max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center pt-8">
      <span class="inline-block py-1 px-3 rounded-full bg-cyan-500/20 text-cyan-300 text-sm font-medium mb-6 backdrop-blur-sm border border-cyan-500/30">
        Nuestra Experiencia
      </span>
      <h1 class="text-4xl md:text-6xl font-black text-white tracking-tight mb-6">
        Proyectos de <span class="text-transparent bg-clip-text bg-gradient-to-r from-cyan-400 to-emerald-400">Infraestructura IT</span>
      </h1>
      <p class="text-lg md:text-xl text-slate-300 max-w-2xl mx-auto leading-relaxed">
        {seoConfig.description.substring(0, 150)}...
      </p>
    </div>
  </section>

  <!-- Filtros y Búsqueda (Dynamic Cyan) -->
  <section class="sticky top-0 z-30 bg-white/95 backdrop-blur-md border-b border-slate-200 shadow-sm" id="filter-bar">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-3">
      <form id="filter-form" class="flex flex-col md:flex-row gap-3 items-center justify-between">
        <!-- Search -->
        <div class="relative w-full md:w-auto flex-1 max-w-md">
          <div class="absolute inset-y-0 left-0 pl-3 flex items-center pointer-events-none">
            <svg class="h-4 w-4 text-slate-400" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
            </svg>
          </div>
          <input
            type="text"
            name="q"
            value={searchQuery}
            placeholder="Buscar por cliente, tecnología..."
            class="block w-full pl-10 pr-3 py-2 border border-slate-200 rounded-lg bg-slate-50 text-slate-900 focus:ring-2 focus:ring-cyan-500 focus:border-cyan-500 sm:text-sm transition-all shadow-sm"
          />
        </div>

        <!-- Filters Group -->
        <div class="flex flex-wrap gap-2 w-full md:w-auto">
          <select
            name="area"
            class="pl-3 pr-8 py-2 border border-slate-200 rounded-lg bg-white text-slate-700 text-sm focus:ring-2 focus:ring-cyan-500 cursor-pointer shadow-sm"
            onchange="this.form.submit()"
          >
            <option value="">Todas las Áreas</option>
            {areas.map((a) => (
              <option value={a} selected={a === areaFilter}>{a}</option>
            ))}
          </select>

          <select
            name="unidad_negocio"
            class="pl-3 pr-8 py-2 border border-slate-200 rounded-lg bg-white text-slate-700 text-sm focus:ring-2 focus:ring-cyan-500 cursor-pointer shadow-sm"
            onchange="this.form.submit()"
          >
            <option value="">Unidades de Negocio</option>
            {unidades.map((u) => (
              <option value={u} selected={u === unidadFilter}>{u}</option>
            ))}
          </select>
          
          <button type="submit" class="px-5 py-2 bg-cyan-600 text-white font-bold rounded-lg hover:bg-cyan-700 transition-colors shadow-lg shadow-cyan-600/20">
            Filtrar
          </button>
        </div>
      </form>
    </div>
  </section>

  <!-- Content Grid -->
  <main class="bg-slate-50 min-h-screen pb-20">
    <AntecedentesGridMobileOptimized 
      items={pageData.antecedentes}
      title=""
      description=""
    />
    
    <!-- Static Pagination (Fallback if JS fails) -->
    {pageData.totalPages > 1 && (
      <div class="flex justify-center gap-4 py-8 border-t border-slate-200 bg-white">
        {pageData.currentPage > 1 && (
          <a href={buildPageUrl(pageData.currentPage - 1)} class="px-4 py-2 bg-white border border-slate-300 rounded-lg text-sm font-medium hover:bg-slate-50">Anterior</a>
        )}
        <span class="px-4 py-2 text-sm font-bold text-slate-700">{pageData.currentPage} de {pageData.totalPages}</span>
        {pageData.currentPage < pageData.totalPages && (
          <a href={buildPageUrl(pageData.currentPage + 1)} class="px-4 py-2 bg-white border border-slate-300 rounded-lg text-sm font-medium hover:bg-slate-50">Siguiente</a>
        )}
      </div>
    )}
  </main>
</Layout>

<style>
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .animate-fade-in-up {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
    transform: translateY(20px);
  }
  
  .delay-100 { animation-delay: 0.1s; }
  .delay-200 { animation-delay: 0.2s; }
  
  @keyframes fadeInUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
