import Layout from '../../layouts/Layout.astro';
import { directus, PAGE_SIZE, DEFAULT_IMAGE } from '../../utils/directus';

// Import shared slug utility for consistency
import { generateSlug } from '../../utils/slugUtils';

// Obtener parámetros de la URL
const getUrlParams = (url) => {
  const searchParams = new URL(url).searchParams;
  const resetFilters = searchParams.get('reset') === '1';
  
  const activeFilters = resetFilters
    ? { area: '', cliente: '', unidad_negocio: '' }
    : {
        area: searchParams.get('area') || '',
        cliente: searchParams.get('cliente') || '',
        unidad_negocio: searchParams.get('unidad_negocio') || ''
      };

  return {
    searchQuery: searchParams.get('q') || '',
    currentPage: Math.max(1, parseInt(searchParams.get('page') || '1')),
    activeFilters,
    pageSize: PAGE_SIZE
  };
};

// Importar todos los antecedentes reales desde el archivo de datos
import { antecedentesReales } from '../../data/antecedentes_completos.js';
// Importar la función de mapeo de imágenes
import { buscarImagenPorDatos } from '../../data/mapeo_imagenes_completo.js';

// Cargar datos iniciales
let pageData = {
  antecedentes: [],
  error: null,
  totalItems: 0,
  totalPages: 1,
  randomImages: [DEFAULT_IMAGE],
  isLoading: true,
  ...getUrlParams(Astro.request?.url || Astro.url)
};

// Función para filtrar antecedentes
const filterAntecedentes = (antecedentes, filters, searchQuery) => {
  let filtered = [...antecedentes];

  // Filtrar por búsqueda
  if (searchQuery) {
    const query = searchQuery.toLowerCase();
    filtered = filtered.filter(item => 
      item.Titulo.toLowerCase().includes(query) ||
      item.Descripcion.toLowerCase().includes(query) ||
      item.Cliente.toLowerCase().includes(query) ||
      item.Area.toLowerCase().includes(query)
    );
  }

  // Filtrar por unidad de negocio
  if (filters.unidad_negocio) {
    filtered = filtered.filter(item => 
      item.Unidad_de_negocio === filters.unidad_negocio
    );
  }

  // Filtrar por área
  if (filters.area) {
    filtered = filtered.filter(item => 
      item.Area === filters.area
    );
  }

  // Filtrar por cliente
  if (filters.cliente) {
    filtered = filtered.filter(item => 
      item.Cliente.toLowerCase().includes(filters.cliente.toLowerCase())
    );
  }

  return filtered;
};

try {
  // Intentar usar el cliente de Directus existente
  const response = await directus.getAntecedentes({
    limit: 500, // Obtener TODOS los antecedentes (469 disponibles)
    page: 1 // Siempre obtener desde la primera página para filtrar localmente
  });

  let allAntecedentes = [];

  if (response && response.data && response.data.length > 0) {
    allAntecedentes = response.data.map(item => ({
      ...item,
      slug: `${item.id}/${generateSlug(item.Titulo)}`
    }));
  } else {
    throw new Error('No se obtuvieron datos válidos');
  }

  // Aplicar filtros
  const filteredAntecedentes = filterAntecedentes(allAntecedentes, pageData.activeFilters, pageData.searchQuery);
  
  // Paginación
  const startIndex = (pageData.currentPage - 1) * PAGE_SIZE;
  const endIndex = startIndex + PAGE_SIZE;
  const paginatedAntecedentes = filteredAntecedentes.slice(startIndex, endIndex);
  
  // Procesar URLs de imágenes para todos los antecedentes paginados
  const antecedentesConImagenes = await Promise.all(
    paginatedAntecedentes.map(async (proyecto) => ({
      ...proyecto,
      imageUrl: await getImageUrl(proyecto)
    }))
  );

  pageData = {
    ...pageData,
    antecedentes: antecedentesConImagenes,
    totalItems: filteredAntecedentes.length,
    totalPages: Math.ceil(filteredAntecedentes.length / PAGE_SIZE),
    randomImages: [DEFAULT_IMAGE],
    isLoading: false
  };

} catch (error) {
  console.error('Error al cargar datos desde Directus, usando datos de fallback:', error);
  
  // Usar datos de fallback con TODOS los antecedentes reales
  const allAntecedentes = antecedentesReales.map(item => ({
    ...item,
    slug: `${item.id}/${generateSlug(item.Titulo)}`
  }));

  // Aplicar filtros a los datos de fallback
  const filteredAntecedentes = filterAntecedentes(allAntecedentes, pageData.activeFilters, pageData.searchQuery);
  
  // Paginación
  const startIndex = (pageData.currentPage - 1) * PAGE_SIZE;
  const endIndex = startIndex + PAGE_SIZE;
  const paginatedAntecedentes = filteredAntecedentes.slice(startIndex, endIndex);

  // Procesar URLs de imágenes para los datos de fallback
  const antecedentesConImagenes = paginatedAntecedentes.map((proyecto) => ({
    ...proyecto,
    imageUrl: getImageUrl(proyecto)
  }));

  pageData = {
    ...pageData,
    antecedentes: antecedentesConImagenes,
    totalItems: filteredAntecedentes.length,
    totalPages: Math.ceil(filteredAntecedentes.length / PAGE_SIZE),
    randomImages: [DEFAULT_IMAGE],
    error: null, // No mostrar error, usar datos de fallback silenciosamente
    isLoading: false
  };
}

// Función para construir la URL con parámetros de filtro
const buildFilterUrl = (params) => {
  const url = new URL(Astro.request?.url || Astro.url);
  Object.entries(params).forEach(([key, value]) => {
    if (value) {
      url.searchParams.set(key, value);
    } else {
      url.searchParams.delete(key);
    }
  });
  url.searchParams.delete('page'); // Reset to first page when filters change
  return url.pathname + url.search;
};

// Función para limpiar filtros
const clearFilters = () => {
  const url = new URL(Astro.request?.url || Astro.url);
  url.search = '';
  return url.pathname;
};

// Obtener el primer párrafo de una descripción HTML
const getFirstParagraph = (html) => {
  if (!html) return '';
  const match = html.match(/<p[^>]*>(.*?)<\/p>/);
  return match ? match[1] : html.substring(0, 150) + '...';
};

// Funciones de utilidad para paginación
const generatePaginationNumbers = (currentPage, totalPages, maxVisible = 5) => {
  if (totalPages <= 1) return [];
  if (totalPages <= maxVisible) return Array.from({ length: totalPages }, (_, i) => i + 1);
  
  const pages = [1];
  const sideItems = Math.floor((maxVisible - 3) / 2);
  
  if (currentPage > 2 + sideItems) pages.push('...');
  
  let start = Math.max(2, currentPage - sideItems);
  let end = Math.min(totalPages - 1, currentPage + sideItems);
  
  if (currentPage <= 2 + sideItems) {
    end = maxVisible - 1;
  } else if (currentPage >= totalPages - sideItems - 1) {
    start = totalPages - maxVisible + 2;
  }
  
  for (let i = start; i <= end; i++) {
    if (i > 1 && i < totalPages) pages.push(i);
  }
  
  if (currentPage < totalPages - sideItems - 1) pages.push('...');
  if (totalPages > 1) pages.push(totalPages);
  
  return pages;
};

const buildPageUrl = (page = 1) => {
  const params = new URLSearchParams();
  
  // Añadir filtros activos
  Object.entries(pageData.activeFilters).forEach(([key, value]) => {
    if (value) params.set(key, value);
  });
  
  // Añadir búsqueda
  if (pageData.searchQuery) params.set('q', pageData.searchQuery);
  
  // Añadir página si no es la primera
  if (page > 1) params.set('page', page);
  
  const queryString = params.toString();
  return `/antecedentes${queryString ? `?${queryString}` : ''}`;
};

// Generar URLs para la paginación
const paginationUrls = {
  first: buildPageUrl(1),
  prev: pageData.currentPage > 1 ? buildPageUrl(pageData.currentPage - 1) : null,
  next: pageData.currentPage < pageData.totalPages ? buildPageUrl(pageData.currentPage + 1) : null,
  last: buildPageUrl(pageData.totalPages)
};

// Generar números de página para la paginación
const paginationNumbers = generatePaginationNumbers(
  pageData.currentPage,
  pageData.totalPages
);

// Obtener opciones únicas para los filtros
const getUniqueValues = (data, field) => {
  const values = data.map(item => item[field]).filter(Boolean);
  return [...new Set(values)].sort();
};

// Usar todos los datos (no solo los paginados) para generar opciones de filtro
const allDataForFilters = pageData.error ? antecedentesReales : antecedentesReales; // Siempre usar todos los antecedentes reales para filtros consistentes

const filterOptions = {
  unidades: getUniqueValues(allDataForFilters, 'Unidad_de_negocio'),
  areas: getUniqueValues(allDataForFilters, 'Area'),
  clientes: getUniqueValues(allDataForFilters, 'Cliente')
};

// ✅ FUNCIÓN MEJORADA: Obtener imagen usando el sistema de mapeo que funciona
function getImageUrl(proyecto) {
  try {
    // Buscar la imagen específica usando los datos del antecedente
    const nombreArchivo = buscarImagenPorDatos(
      proyecto.Cliente,
      proyecto.Area || proyecto.Unidad_de_negocio, 
      proyecto.Titulo,
      proyecto.id
    );
    
    if (nombreArchivo) {
      // Usar la ruta estática que funciona correctamente
      const imagenUrl = `/imagenes_antecedentes_versionproduccion/${nombreArchivo}`;
      console.log('[ANTECEDENTES LIST] ✅ Usando imagen específica:', imagenUrl);
      return imagenUrl;
    }
  } catch (error) {
    console.log('[ANTECEDENTES LIST] ⚠️ Error en mapeo, usando placeholder:', error.message);
  }
  
  // Fallback: placeholder por defecto
  return DEFAULT_IMAGE;
};
