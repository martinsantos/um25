---
import LayoutV4 from '../../layouts/LayoutV4.astro';
import { getAntecedentes, getServicios } from '../../lib/um26-directus';
import { getAntecedentesCatalogCount } from '../../utils/verifiedProof';
import EmailLink from '../../components/common/EmailLink.astro';

// Hero editorial: no coincide con ninguna miniatura del listado.
const heroImage = '/images/editorial/umsa-about-engineering.webp';
const PAGE_SIZE = 24;
const catalogCount = getAntecedentesCatalogCount();

const sectorLabels: Record<string, string> = {
  aeropuertos: 'Aeropuertos',
  bodegas: 'Bodegas',
  constructoras: 'Constructoras',
  gobierno: 'Gobierno',
  industria: 'Industria',
  mineria: 'Minería',
  salud: 'Salud',
  'seguridad-electronica': 'Seguridad electrónica',
  software: 'Software',
};

const statusLabels: Record<string, string> = {
  verificado: 'Verificado',
  operativo: 'Operativo',
  mantenimiento: 'Mantenimiento',
};

const antecedentes = await getAntecedentes({ limit: 1000 });
const serviciosCatalog = await getServicios();
const antecedentesById = new Map(antecedentes.map((item) => [item.id, item]));
const serviciosByCode = new Map(serviciosCatalog.map((item) => [item.code, item]));

/** Texto de card: sin separadores crudos del CMS, sin etiquetas de campo ni cortes con "...". */
function cleanText(value: unknown): string {
  return String(value ?? '')
    .replace(/\b(Rubro|Cliente|Sector|Área|Area)\s*:\s*/gi, '')
    .replace(/\s*(\.{3}|…)\s*$/u, '')
    .replace(/\s+/g, ' ')
    .trim();
}

function cleanTitle(raw: unknown, client: string): string {
  let title = cleanText(raw);
  if (title.includes('|')) title = title.split('|')[0].trim() || title.replace(/\s*\|\s*/g, ' · ');
  // El cliente ya figura arriba del título: se quita el sufijo " - Cliente".
  const suffix = ` - ${client}`.toLowerCase();
  if (client && title.toLowerCase().endsWith(suffix)) title = title.slice(0, -suffix.length).trim();
  return title.replace(/\s+-\s+/g, ' · ');
}

// Destacados: los 4 proyectos reales con imagen curada; el resto sigue por fecha.
const leadOrder = [3065, 3075, 3064, 3334];
const orderedLead = leadOrder.map((id) => antecedentesById.get(id)).filter(Boolean);
const rest = antecedentes.filter((item) => !leadOrder.includes(item.id));

const cases = [...orderedLead, ...rest].map((item) => {
  const caseServices = item.service_codes.map((code) => serviciosByCode.get(code)).filter(Boolean);
  const client = cleanText(item.client);
  return {
    id: String(item.id),
    client,
    title: cleanTitle(item.title, client),
    summary: cleanText(item.summary),
    year: String(item.year),
    sector: sectorLabels[item.sector_slug] || item.sector_slug,
    sectorKey: item.sector_slug,
    status: item.status,
    image: item.image,
    href: `/antecedentes/${item.id}/${item.slug}`,
    tags: item.tags,
    serviceNames: caseServices.map((service) => service.name),
    serviceSlugs: caseServices.map((service) => service.slug),
  };
});

const publishedCount = cases.length;

function countBy(values: string[]) {
  const map = new Map<string, number>();
  values.forEach((value) => map.set(value, (map.get(value) || 0) + 1));
  return map;
}

const sectorCounts = countBy(cases.map((item) => item.sectorKey));
const sectors = Object.entries(sectorLabels)
  .map(([key, label]) => ({ key, label, count: sectorCounts.get(key) || 0 }))
  .filter((item) => item.count > 0);

const serviceCounts = countBy(cases.flatMap((item) => item.serviceSlugs));
const services = serviciosCatalog
  .map((service) => ({ key: service.slug, label: service.name, count: serviceCounts.get(service.slug) || 0 }))
  .filter((item) => item.count > 0);

const yearCounts = countBy(cases.map((item) => item.year));
const years = [...yearCounts.entries()]
  .sort((a, b) => Number(b[0]) - Number(a[0]))
  .map(([key, count]) => ({ key, label: key, count }));

const statusCounts = countBy(cases.map((item) => item.status));
const statuses = Object.entries(statusLabels)
  .map(([key, label]) => ({ key, label, count: statusCounts.get(key) || 0 }))
  .filter((item) => item.count > 0);

const filterGroups = [
  { type: 'sector', label: 'Sector', options: sectors },
  { type: 'service', label: 'Servicio', options: services },
  { type: 'year', label: 'Año', options: years },
  { type: 'status', label: 'Estado', options: statuses },
];
---

<LayoutV4
  skin="black"
  title="Antecedentes | ULTIMA MILLA"
  description={`${catalogCount} antecedentes técnicos de ULTIMA MILLA con cliente, sector, servicio aplicado y alcance.`}
  image={heroImage}
>
  <div class="ev" data-evidence>
    <header class="ev-hero" aria-labelledby="evidence-title">
      <img src={heroImage} alt="" width="1672" height="941" loading="eager" decoding="async" fetchpriority="high" />
      <div class="ev-hero__shade" aria-hidden="true"></div>
      <div class="ev-shell ev-hero__inner">
        <p class="ev-kicker"><span aria-hidden="true"></span>Antecedentes</p>
        <h1 id="evidence-title">Evidencia operativa real</h1>
        <p class="ev-lead">
          <strong>{catalogCount}</strong> antecedentes técnicos con cliente, sector y alcance, en más de 22 años de obras y servicios.
        </p>
      </div>
    </header>

    <main class="ev-shell ev-main">
      <section class="ev-filters" aria-label="Buscar y filtrar antecedentes">
        <div class="ev-toolbar">
          <label class="ev-search">
            <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="8.5" cy="8.5" r="5.75" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M13 13l4.5 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="square"/></svg>
            <input type="search" data-search aria-label="Buscar por cliente, sector, servicio o alcance" placeholder="Buscar por cliente, sector o servicio" />
          </label>
          <button class="ev-toggle" type="button" data-filter-toggle aria-expanded="false" aria-controls="evidence-filter-panel" hidden>
            Filtros <span data-active-filter-count></span>
          </button>
          <label class="ev-sort">
            <span>Ordenar</span>
            <select aria-label="Ordenar antecedentes" data-sort>
              <option value="recent">Destacados</option>
              <option value="year-desc">Año, más reciente</option>
              <option value="year-asc">Año, más antiguo</option>
              <option value="client">Cliente A–Z</option>
            </select>
          </label>
        </div>

        <div class="ev-panel" id="evidence-filter-panel" data-filter-panel>
          {filterGroups.map((group) => (
            <div class="ev-panel__row">
              <p class="ev-panel__label">{group.label}</p>
              <div class="ev-panel__chips">
                {group.options.map((option) => (
                  <button type="button" class="ev-chip" data-filter={group.type} data-value={option.key} aria-pressed="false">
                    {option.label}<span>{option.count}</span>
                  </button>
                ))}
              </div>
            </div>
          ))}
        </div>
      </section>

      <div class="ev-status">
        <p aria-live="polite" aria-atomic="true">
          Mostrando <strong data-shown-count>{publishedCount}</strong> de <strong data-match-count>{publishedCount}</strong> publicados
          <span class="ev-status__sep" aria-hidden="true">·</span>
          <span>{catalogCount} en el catálogo completo</span>
        </p>
        <button type="button" class="ev-clear" data-clear hidden>Limpiar filtros</button>
      </div>

      <h2 class="ev-sr">Listado de antecedentes</h2>
      <ul class="ev-grid" data-grid role="list">
        {cases.map((item, index) => (
          <li
            class="ev-grid__item"
            data-card
            data-order={index}
            data-client={item.client.toLowerCase()}
            data-year={item.year}
            data-sector={item.sectorKey}
            data-status={item.status}
            data-services={item.serviceSlugs.join(' ')}
            data-search={`${item.client} ${item.title} ${item.summary} ${item.sector} ${item.tags.join(' ')} ${item.serviceNames.join(' ')}`.toLowerCase()}
          >
            <a class="ev-card" href={item.href}>
              <div class="ev-card__media">
                <img src={item.image} alt="" width="800" height="500" loading={index < 4 ? 'eager' : 'lazy'} decoding="async" />
                <span class="ev-card__seal">Imagen ilustrativa</span>
              </div>
              <div class="ev-card__body">
                <p class="ev-card__client">{item.client}</p>
                <h3 class="ev-card__title">{item.title}</h3>
                <p class="ev-card__meta">
                  <span>{item.sector}</span><span aria-hidden="true">·</span><span>{item.year}</span><span aria-hidden="true">·</span><span>#{item.id}</span>
                </p>
              </div>
            </a>
          </li>
        ))}
      </ul>

      <div class="ev-more" data-more-wrap hidden>
        <button type="button" class="ev-more__btn" data-more>
          Ver más proyectos <span data-more-count></span>
        </button>
      </div>

      <section class="ev-empty" data-empty hidden>
        <h2>Sin antecedentes para esta combinación</h2>
        <p>Pruebe con menos filtros o con otro término de búsqueda.</p>
      </section>
    </main>

    <section class="ev-contact" aria-labelledby="evidence-contact-title">
      <div class="ev-shell ev-contact__panel">
        <div>
          <p class="ev-kicker"><span aria-hidden="true"></span>Contacto</p>
          <h2 id="evidence-contact-title">Ordenemos su infraestructura y su continuidad operativa.</h2>
          <p class="ev-contact__text">Respondemos en el día con un relevamiento técnico y una propuesta verificable.</p>
        </div>
        <div class="ev-contact__cta">
          <EmailLink class="ev-btn" subject="Consulta desde Antecedentes ULTIMA MILLA"><span class="ev-btn__mail"><span>contacto</span><span aria-hidden="true">&#64;</span><wbr /><span>ultimamilla.com.ar</span></span> <span aria-hidden="true">→</span></EmailLink>
          <p>Lunes a viernes, 08:00 a 18:00</p>
        </div>
      </div>
    </section>
  </div>

  <script is:inline data-astro-rerun define:vars={{ PAGE_SIZE }}>
    function initEvidence() {
      const root = document.querySelector('[data-evidence]');
      if (!root || root.getAttribute('data-ready') === 'true') return;
      root.setAttribute('data-ready', 'true');
      root.classList.add('is-enhanced');

      const grid = root.querySelector('[data-grid]');
      const cards = Array.from(root.querySelectorAll('[data-card]'));
      const search = root.querySelector('[data-search]');
      const sort = root.querySelector('[data-sort]');
      const chips = Array.from(root.querySelectorAll('[data-filter]'));
      const toggle = root.querySelector('[data-filter-toggle]');
      const panel = root.querySelector('[data-filter-panel]');
      const activeCount = root.querySelector('[data-active-filter-count]');
      const shownCount = root.querySelector('[data-shown-count]');
      const matchCount = root.querySelector('[data-match-count]');
      const clear = root.querySelector('[data-clear]');
      const empty = root.querySelector('[data-empty]');
      const moreWrap = root.querySelector('[data-more-wrap]');
      const more = root.querySelector('[data-more]');
      const moreCount = root.querySelector('[data-more-count]');
      const filters = { sector: '', service: '', year: '', status: '' };
      let limit = PAGE_SIZE;

      if (toggle) toggle.hidden = false;

      function num(card, attr) {
        return Number(card.getAttribute(attr) || 0);
      }

      function sortCards() {
        const mode = String(sort?.value || 'recent');
        const ordered = cards.slice().sort((a, b) => {
          if (mode === 'year-desc') return num(b, 'data-year') - num(a, 'data-year') || num(a, 'data-order') - num(b, 'data-order');
          if (mode === 'year-asc') return num(a, 'data-year') - num(b, 'data-year') || num(a, 'data-order') - num(b, 'data-order');
          if (mode === 'client') return String(a.getAttribute('data-client')).localeCompare(String(b.getAttribute('data-client')), 'es') || num(a, 'data-order') - num(b, 'data-order');
          return num(a, 'data-order') - num(b, 'data-order');
        });
        ordered.forEach((card) => grid?.appendChild(card));
      }

      function matches(card, q) {
        return (
          (!q || String(card.getAttribute('data-search')).includes(q)) &&
          (!filters.sector || card.getAttribute('data-sector') === filters.sector) &&
          (!filters.year || card.getAttribute('data-year') === filters.year) &&
          (!filters.status || card.getAttribute('data-status') === filters.status) &&
          (!filters.service || String(card.getAttribute('data-services')).split(' ').includes(filters.service))
        );
      }

      function render() {
        const q = String(search?.value || '').trim().toLowerCase();
        const ordered = Array.from(grid?.children || []);
        let total = 0;
        let shown = 0;
        ordered.forEach((card) => {
          const ok = matches(card, q);
          if (ok) total += 1;
          const visible = ok && total <= limit;
          if (visible) shown += 1;
          card.hidden = !visible;
        });
        if (shownCount) shownCount.textContent = String(shown);
        if (matchCount) matchCount.textContent = String(total);
        if (empty) empty.hidden = total !== 0;
        const remaining = total - shown;
        if (moreWrap) moreWrap.hidden = remaining <= 0;
        if (moreCount) moreCount.textContent = remaining > 0 ? `(${remaining})` : '';
        const active = Object.values(filters).filter(Boolean).length;
        if (activeCount) activeCount.textContent = active ? String(active) : '';
        if (clear) clear.hidden = !(active || q);
      }

      function reset() {
        limit = PAGE_SIZE;
        render();
      }

      chips.forEach((chip) => {
        chip.addEventListener('click', () => {
          const type = chip.getAttribute('data-filter');
          const value = chip.getAttribute('data-value') || '';
          if (!type) return;
          filters[type] = filters[type] === value ? '' : value;
          chips
            .filter((item) => item.getAttribute('data-filter') === type)
            .forEach((item) => item.setAttribute('aria-pressed', String(item === chip && filters[type] === value)));
          reset();
        });
      });

      more?.addEventListener('click', () => {
        const firstNew = limit;
        limit += PAGE_SIZE;
        render();
        const visible = Array.from(grid?.children || []).filter((card) => !card.hidden);
        const target = visible[firstNew]?.querySelector('a');
        target?.focus({ preventScroll: true });
      });

      clear?.addEventListener('click', () => {
        Object.keys(filters).forEach((key) => { filters[key] = ''; });
        chips.forEach((chip) => chip.setAttribute('aria-pressed', 'false'));
        if (search) search.value = '';
        reset();
      });

      toggle?.addEventListener('click', () => {
        const open = toggle.getAttribute('aria-expanded') !== 'true';
        toggle.setAttribute('aria-expanded', String(open));
        panel?.classList.toggle('is-open', open);
      });

      search?.addEventListener('input', reset);
      sort?.addEventListener('change', () => { sortCards(); reset(); });

      render();
    }

    initEvidence();
    document.addEventListener('astro:page-load', initEvidence);
  </script>

  <style>
    .ev {
      /* El fondo lo da skin="black" en body/main: evita dos negros distintos. */
      background: transparent;
      color: var(--x-text);
      font-family: var(--um-font-editorial);
    }

    .ev-shell {
      width: min(var(--um-container-wide), calc(100% - (var(--x-gutter) * 2)));
      margin-inline: auto;
    }

    .ev-sr {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
      white-space: nowrap;
    }

    /* Cabecera */
    .ev-hero {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      border-bottom: 1px solid var(--x-line);
    }

    .ev-hero > img,
    .ev-hero__shade {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    .ev-hero > img {
      object-fit: cover;
      z-index: -2;
    }

    .ev-hero__shade {
      z-index: -1;
      background:
        linear-gradient(100deg, rgba(10, 10, 11, 0.96) 0%, rgba(10, 10, 11, 0.8) 45%, rgba(10, 10, 11, 0.45) 100%),
        linear-gradient(to top, #050505, transparent 60%);
    }

    .ev-hero__inner {
      padding-block: clamp(64px, 7vw, 112px) clamp(48px, 5vw, 64px);
    }

    .ev-kicker {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 0 0 24px;
      color: var(--x-muted);
      font-size: var(--x-fs-kicker);
      font-weight: 600;
      line-height: 1.2;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .ev-kicker span {
      flex: none;
      width: 28px;
      height: 2px;
      background: var(--x-red);
    }

    .ev-hero h1 {
      max-width: 18ch;
      margin: 0;
      color: var(--x-text);
      font-size: var(--x-fs-h1);
      font-weight: 600;
      line-height: 1.02;
      letter-spacing: -0.025em;
    }

    .ev-lead {
      max-width: 62ch;
      margin: 24px 0 0;
      color: var(--x-text-2);
      font-size: var(--x-fs-lead);
      line-height: 1.55;
    }

    .ev-lead strong {
      color: var(--x-text);
      font-weight: 600;
    }

    /* Filtros */
    .ev .ev-main {
      padding-block: 48px var(--x-section);
      background: transparent;
    }

    .ev-toolbar {
      display: flex;
      flex-wrap: wrap;
      gap: 12px;
      align-items: stretch;
    }

    .ev-search {
      position: relative;
      flex: 1 1 320px;
      display: flex;
      align-items: center;
      color: var(--x-muted);
    }

    .ev-search svg {
      position: absolute;
      left: 16px;
      pointer-events: none;
    }

    .ev-search input,
    .ev-sort select,
    .ev-toggle {
      height: 48px;
      border: 1px solid var(--x-line);
      border-radius: 4px;
      background: var(--x-panel);
      color: var(--x-text);
      font: inherit;
      font-size: 16px;
      font-weight: 400;
      transition: border-color 160ms var(--x-ease), background-color 160ms var(--x-ease);
    }

    .ev-search input {
      width: 100%;
      padding: 0 16px 0 44px;
    }

    .ev-search input::placeholder {
      color: var(--x-muted);
    }

    .ev-search input:hover,
    .ev-sort select:hover,
    .ev-toggle:hover {
      border-color: var(--x-line-strong);
    }

    .ev-search input:focus-visible,
    .ev-sort select:focus-visible,
    .ev-toggle:focus-visible,
    .ev-chip:focus-visible,
    .ev-clear:focus-visible,
    .ev-more__btn:focus-visible,
    .ev-contact__cta :global(.ev-btn:focus-visible) {
      outline: 2px solid var(--x-text);
      outline-offset: 2px;
    }

    .ev-toggle {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 0 16px;
      cursor: pointer;
    }

    .ev-toggle[hidden] {
      display: none;
    }

    .ev-toggle span:not(:empty) {
      display: inline-grid;
      place-items: center;
      min-width: 24px;
      min-height: 24px;
      padding: 0 8px;
      border-radius: 4px;
      background: var(--x-text);
      color: var(--x-ink);
      font-size: 13px;
      font-weight: 600;
      line-height: 1.2;
      text-align: center;
    }

    .ev-toggle[aria-expanded='true'] {
      border-color: var(--x-line-strong);
      background: var(--x-panel-2);
    }

    .ev-sort {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--x-muted);
      font-size: var(--x-fs-meta);
    }

    .ev-sort select {
      padding: 0 40px 0 14px;
      appearance: none;
      background-image: linear-gradient(45deg, transparent 50%, var(--x-muted) 50%), linear-gradient(135deg, var(--x-muted) 50%, transparent 50%);
      background-position: calc(100% - 20px) 50%, calc(100% - 15px) 50%;
      background-size: 5px 5px;
      background-repeat: no-repeat;
      cursor: pointer;
    }

    .ev-panel {
      display: grid;
      gap: 16px;
      margin-top: 16px;
      padding: 24px;
      border: 1px solid var(--x-line);
      background: var(--x-panel);
    }

    .ev.is-enhanced .ev-panel:not(.is-open) {
      display: none;
    }

    .ev-panel__row {
      display: grid;
      grid-template-columns: 96px 1fr;
      gap: 16px;
      align-items: start;
    }

    .ev-panel__label {
      margin: 0;
      padding-top: 8px;
      color: var(--x-muted);
      font-size: 13px;
      font-weight: 600;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    .ev-panel__chips {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
    }

    .ev-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 36px;
      padding: 0 12px;
      border: 1px solid var(--x-line);
      border-radius: 4px;
      background: transparent;
      color: var(--x-text-2);
      font: inherit;
      font-size: var(--x-fs-meta);
      cursor: pointer;
      transition: border-color 160ms var(--x-ease), background-color 160ms var(--x-ease), color 160ms var(--x-ease);
    }

    .ev-chip span {
      color: var(--x-muted);
      font-size: 13px;
      font-variant-numeric: tabular-nums;
    }

    .ev-chip:hover {
      border-color: var(--x-line-strong);
      color: var(--x-text);
    }

    .ev-chip[aria-pressed='true'] {
      border-color: var(--x-text);
      background: var(--x-text);
      color: var(--x-ink);
    }

    .ev-chip[aria-pressed='true'] span {
      color: var(--x-ink);
    }

    .ev-status {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      justify-content: space-between;
      gap: 12px;
      margin: 32px 0 24px;
      padding-bottom: 16px;
      border-bottom: 1px solid var(--x-line);
    }

    .ev-status p {
      margin: 0;
      color: var(--x-muted);
      font-size: var(--x-fs-meta);
      line-height: 1.45;
    }

    .ev-status strong {
      color: var(--x-text);
      font-weight: 600;
      font-variant-numeric: tabular-nums;
    }

    .ev-status__sep {
      margin-inline: 6px;
    }

    .ev-clear {
      padding: 4px 0;
      border: 0;
      background: none;
      color: var(--x-text);
      font: inherit;
      font-size: var(--x-fs-meta);
      text-decoration: underline;
      text-underline-offset: 3px;
      cursor: pointer;
    }

    .ev-clear[hidden] {
      display: none;
    }

    /* Grilla de cards */
    .ev-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
      margin: 0;
      padding: 0;
      list-style: none;
    }

    .ev-grid__item {
      display: flex;
      min-width: 0;
    }

    .ev-grid__item[hidden] {
      display: none;
    }

    .ev-card {
      display: flex;
      flex-direction: column;
      width: 100%;
      border: 1px solid var(--x-line);
      background: var(--x-panel);
      color: inherit;
      text-decoration: none;
      transition: border-color 160ms var(--x-ease), background-color 160ms var(--x-ease);
    }

    .ev-card:hover {
      border-color: var(--x-line-strong);
      background: var(--x-panel-2);
    }

    .ev-card:focus-visible {
      outline: 2px solid var(--x-text);
      outline-offset: 2px;
    }

    .ev-card__media {
      position: relative;
      aspect-ratio: 16 / 10;
      overflow: hidden;
      background: var(--x-panel-2);
    }

    .ev-card__media img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 160ms var(--x-ease);
    }

    .ev-card:hover .ev-card__media img {
      transform: scale(1.03);
    }

    .ev-card__seal {
      position: absolute;
      left: 12px;
      bottom: 12px;
      display: inline-flex;
      align-items: center;
      min-height: 28px;
      padding: 0 10px;
      border-radius: 4px;
      background: rgba(10, 10, 11, 0.78);
      color: var(--x-text-2);
      font-size: 13px;
      line-height: 1;
    }

    .ev-card__body {
      display: flex;
      flex: 1;
      flex-direction: column;
      gap: 8px;
      padding: 20px;
    }

    .ev-card__client {
      margin: 0;
      overflow: hidden;
      color: var(--x-muted);
      font-size: 14px;
      line-height: 1.4;
      white-space: nowrap;
      text-overflow: ellipsis;
    }

    .ev-card__title {
      display: -webkit-box;
      min-height: calc(1.3em * 3);
      margin: 0;
      overflow: hidden;
      color: var(--x-text);
      font-size: 18px;
      font-weight: 600;
      line-height: 1.3;
      letter-spacing: -0.005em;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      text-wrap: pretty;
    }

    .ev-card__meta {
      display: flex;
      flex-wrap: nowrap;
      overflow: hidden;
      white-space: nowrap;
      gap: 6px;
      margin: auto 0 0;
      padding-top: 12px;
      border-top: 1px solid var(--x-line);
      color: var(--x-muted);
      font-size: 13px;
      line-height: 1.45;
      font-variant-numeric: tabular-nums;
    }

    /* La regla global de v4 fuerza max(16px, 1em) en span/strong dentro de main: se fija el tamaño local. */
    .ev-card__meta span,
    .ev-status p span,
    .ev-status p strong,
    .ev-more__btn span,
    .ev-lead strong {
      font-size: inherit;
    }

    .ev-card__meta span {
      flex: none;
      white-space: nowrap;
      text-wrap: nowrap;
    }

    .ev-card__meta span:first-child {
      flex: 0 1 auto;
      min-width: 0;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .ev-more {
      display: flex;
      justify-content: center;
      margin-top: 48px;
    }

    .ev-more[hidden],
    .ev-empty[hidden] {
      display: none;
    }

    .ev-more__btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      min-height: 48px;
      padding: 0 28px;
      border: 1px solid var(--x-line-strong);
      border-radius: 0;
      background: transparent;
      color: var(--x-text);
      font: inherit;
      font-size: 15px;
      font-weight: 600;
      cursor: pointer;
      transition: background-color 160ms var(--x-ease), border-color 160ms var(--x-ease);
    }

    .ev-more__btn span {
      color: var(--x-muted);
      font-weight: 400;
      font-variant-numeric: tabular-nums;
    }

    .ev-more__btn:hover {
      border-color: var(--x-text);
      background: var(--x-panel-2);
    }

    .ev-empty {
      padding: 64px 24px;
      border: 1px solid var(--x-line);
      background: var(--x-panel);
      text-align: center;
    }

    .ev-empty h2 {
      margin: 0 0 8px;
      font-size: var(--x-fs-h3);
      font-weight: 600;
      line-height: 1.3;
    }

    .ev-empty p {
      margin: 0;
      color: var(--x-muted);
      font-size: 16px;
    }

    /* Contacto */
    .ev-contact {
      padding-block: 0 var(--x-section);
    }

    .ev-contact__panel {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 48px;
      align-items: end;
      padding: clamp(32px, 4vw, 64px);
      border: 1px solid var(--x-line);
      background: var(--x-panel);
    }

    .ev-contact h2 {
      max-width: 20ch;
      margin: 0;
      font-size: var(--x-fs-h2);
      font-weight: 600;
      line-height: 1.08;
      letter-spacing: -0.02em;
    }

    .ev-contact__text {
      max-width: 62ch;
      margin: 16px 0 0;
      color: var(--x-text-2);
      font-size: 16px;
      line-height: 1.6;
    }

    .ev-contact__cta {
      display: grid;
      gap: 12px;
      justify-items: start;
    }

    .ev-contact__cta p {
      margin: 0;
      color: var(--x-muted);
      font-size: var(--x-fs-meta);
    }

    .ev-contact__cta :global(.ev-btn) {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      min-height: 48px;
      padding: 0 24px;
      border-radius: 0;
      background: var(--x-red);
      color: #fff;
      font-size: 15px;
      font-weight: 600;
      text-decoration: none;
      transition: background-color 160ms var(--x-ease);
    }

    .ev-contact__cta :global(.ev-btn:hover) {
      background: var(--x-red-hover);
    }

    @media (max-width: 1279px) {
      .ev-grid {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }
    }

    @media (max-width: 1023px) {
      .ev-grid {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .ev-contact__panel {
        grid-template-columns: minmax(0, 1fr);
        gap: 32px;
      }
    }

    @media (max-width: 639px) {
      .ev-grid {
        grid-template-columns: 1fr;
        gap: 12px;
      }

      /* Teléfono: fila compacta (miniatura + texto). 24 casos ocupan ~4.100 px
         en lugar de ~8.400 px; el sello "Imagen ilustrativa" sigue sobre la foto. */
      .ev-card {
        display: grid;
        grid-template-columns: 132px minmax(0, 1fr);
      }

      .ev-card__media {
        aspect-ratio: auto;
        min-height: 132px;
      }

      .ev-card__media img {
        position: absolute;
        inset: 0;
      }

      .ev-card__seal {
        left: 0;
        right: 0;
        bottom: 0;
        justify-content: center;
        min-height: 28px;
        padding: 0 10px;
        border-radius: 0;
        text-align: center;
        white-space: nowrap;
      }

      .ev-card__body {
        gap: 4px;
        padding: 12px 14px;
      }

      .ev-card__title {
        min-height: 0;
        font-size: 17px !important;
        line-height: 1.3;
      }

      .ev-card__meta {
        padding-top: 8px;
      }

      .ev-search input,
      .ev-sort select,
      .ev-toggle {
        font-size: 16px;
      }

      .ev-chip {
        min-height: 44px;
      }

      .ev .ev-main {
        padding-top: 32px;
      }

      .ev-sort {
        flex: 1 1 100%;
      }

      .ev-sort select {
        flex: 1;
      }

      .ev-toggle {
        flex: 1 1 auto;
        justify-content: center;
      }

      .ev-panel {
        padding: 16px;
      }

      .ev-panel__row {
        grid-template-columns: 1fr;
        gap: 8px;
      }

      .ev-panel__label {
        padding-top: 0;
      }

      .ev-more__btn {
        width: 100%;
        justify-content: center;
      }

      .ev-contact__cta :global(.ev-btn) {
        width: 100%;
        justify-content: center;
        padding: 12px 16px;
        font-size: 14px;
      }

      /* El email puede cortar en teléfonos angostos (320 px) sin desbordar el panel. */
      .ev-contact__cta :global(.ev-btn__mail) {
        min-width: 0;
        overflow-wrap: anywhere;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .ev-card__media img,
      .ev-card,
      .ev-chip,
      .ev-more__btn,
      .ev-contact__cta :global(.ev-btn) {
        transition: none;
      }

      .ev-card:hover .ev-card__media img {
        transform: none;
      }
    }
  </style>
</LayoutV4>
