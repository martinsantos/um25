---
/**
 * Antecedentes Index - dossier editorial UMSA.
 * Public route is preserved; local template variants stay available in development.
 */

import LayoutV4 from '../../layouts/LayoutV4.astro';
import AntecedentesTemplateEditorial from '../../components/templates/AntecedentesTemplateEditorial.astro';
import AntecedentesTemplateAtlas from '../../components/templates/AntecedentesTemplateAtlas.astro';
import AntecedentesTemplateUM26 from '../../components/templates/AntecedentesTemplateUM26.astro';
import IntentLinkGraph from '../../components/um/IntentLinkGraph.astro';
import { getAllAntecedentes, getAntecedenteImageUrl } from '../../lib/directus.ts';
import { getDevTemplateVariant } from '../../utils/templateVariant';
import {
  buildAntecedenteListItemStructuredData,
  curateAntecedente,
  isPromotableAntecedente,
  sortAntecedentesForPublicList,
} from '../../utils/antecedentesCuration';
import { canonicalUrl } from '../../utils/seoUrl';
import {
  buildCaseStrategicLinkGroups,
  buildStrategicWebPageStructuredData,
} from '../../data/strategicLinkGraph';
import { editorialImages, editorialImageDimensions, generatedAntecedenteImageDimensions } from '../../data/editorialImageSystem';

const PAGE_SIZE = 12;

const getUrlParams = (url) => {
  const searchParams = new URL(url).searchParams;
  const resetFilters = searchParams.get('reset') === '1';
  const requestedView = searchParams.get('view') || 'list';
  const requestedSort = searchParams.get('sort') || 'newest';

  const activeFilters = resetFilters
    ? { area: '', cliente: '', unidad_negocio: '', sector: '' }
    : {
        area: searchParams.get('area') || '',
        cliente: searchParams.get('cliente') || '',
        unidad_negocio: searchParams.get('unidad_negocio') || '',
        sector: searchParams.get('sector') || ''
      };

  return {
    searchQuery: searchParams.get('q') || '',
    currentPage: Math.max(1, parseInt(searchParams.get('page') || '1')),
    activeFilters,
    archiveView: ['list', 'grid'].includes(requestedView) ? requestedView : 'list',
    archiveSort: ['newest', 'oldest', 'client'].includes(requestedSort) ? requestedSort : 'newest',
    pageSize: PAGE_SIZE
  };
};

let pageData = {
  antecedentes: [],
  error: null,
  totalItems: 0,
  totalPages: 1,
  isLoading: true,
  ...getUrlParams(Astro.request?.url || Astro.url)
};

const sectorKeywords: Record<string, string[]> = {
  aeropuertos: ['aeropuerto', 'aeroportuario', 'aviación', 'aviacion', 'terminal aérea', 'aerolinea'],
  bodegas: ['bodega', 'vino', 'vitivinícola', 'vitivinicola', 'viñedo', 'vinedo', 'enología'],
  gobierno: ['gobierno', 'municipal', 'provincial', 'público', 'publico', 'ministerio', 'secretaría', 'legislatura'],
  salud: ['hospital', 'clínica', 'clinica', 'sanatorio', 'salud', 'médico', 'medico', 'sanitario'],
  construccion: ['constructora', 'construcción', 'construccion', 'edificio', 'torre', 'inmobiliaria', 'obra'],
  industria: ['industria', 'industrial', 'fábrica', 'fabrica', 'planta', 'manufactura', 'producción'],
  datacenter: ['data center', 'datacenter', 'centro de datos', 'servidor', 'rack', 'hosting'],
  mineria: ['minería', 'mineria', 'mina', 'minero', 'extracción', 'yacimiento'],
  seguridad: ['seguridad', 'cctv', 'videovigilancia', 'control acceso', 'alarma', 'monitoreo'],
  software: ['software', 'desarrollo', 'aplicación', 'aplicacion', 'sistema', 'web', 'app'],
};

const safeText = (value = '') => String(value || '').toLowerCase();

const filterAntecedentes = (antecedentes, filters, searchQuery) => {
  let filtered = [...antecedentes];

  if (searchQuery) {
    const query = safeText(searchQuery);
    filtered = filtered.filter((item) => {
      const searchText = `${item.displayTitle || item.Titulo || ''} ${item.displayDescription || item.Descripcion || ''} ${item.Cliente || ''} ${item.Area || ''}`.toLowerCase();
      return searchText.includes(query);
    });
  }

  if (filters.sector && sectorKeywords[filters.sector]) {
    const keywords = sectorKeywords[filters.sector];
    filtered = filtered.filter((item) => {
      const searchText = `${item.displayTitle || item.Titulo || ''} ${item.displayDescription || item.Descripcion || ''} ${item.Cliente || ''} ${item.Area || ''}`.toLowerCase();
      return keywords.some((keyword) => searchText.includes(keyword.toLowerCase()));
    });
  }

  if (filters.unidad_negocio) {
    filtered = filtered.filter((item) => item.Unidad_de_negocio === filters.unidad_negocio);
  }

  if (filters.area) {
    filtered = filtered.filter((item) => item.Area === filters.area);
  }

  if (filters.cliente) {
    filtered = filtered.filter((item) => safeText(item.Cliente).includes(safeText(filters.cliente)));
  }

  return filtered;
};

const antecedenteTimestamp = (item) => {
  const raw = item?.Fecha || item?.fecha || item?.displayYear || item?.year || item?.anio || '';
  const parsed = new Date(raw);
  if (!Number.isNaN(parsed.getTime())) return parsed.getTime();
  const year = String(raw).match(/\b(19\d{2}|20\d{2})\b/)?.[1];
  return year ? Date.UTC(Number(year), 0, 1) : 0;
};

const sortAntecedentesArchive = (antecedentes, sortMode) => {
  const byTitle = (a, b) => String(a?.displayTitle || a?.Titulo || '').localeCompare(String(b?.displayTitle || b?.Titulo || ''), 'es');
  const byClient = (a, b) => String(a?.Cliente || '').localeCompare(String(b?.Cliente || ''), 'es') || byTitle(a, b);
  const byNewest = (a, b) => (antecedenteTimestamp(b) - antecedenteTimestamp(a)) || byTitle(a, b);
  const byOldest = (a, b) => (antecedenteTimestamp(a) - antecedenteTimestamp(b)) || byTitle(a, b);

  const comparators = {
    newest: byNewest,
    oldest: byOldest,
    client: byClient,
  };

  return [...antecedentes].sort(comparators[sortMode] || byNewest);
};

const localGenerateSlug = (text = '') => {
  if (!text || text === null || typeof text === 'undefined') {
    return 'item';
  }

  const slug = String(text)
    .toLowerCase()
    .normalize('NFD').replace(/[\u0300-\u036f]/g, '')
    .replace(/[^\w\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 100);

  return slug || 'item';
};

const protagonistTargets = [
  { terms: ['gobierno de mendoza', 'ministerio', 'municipalidad'] },
  { terms: ['aeropuerto', 'aeropuertos argentina'] },
  { terms: ['torre thays', 'thays', 'consorcio'] }
];

function pickProtagonistAntecedente(items: any[]) {
  for (const target of protagonistTargets) {
    const match = items.find((item) => {
      const text = `${item.Cliente || ''} ${item.Titulo || ''} ${item.Area || ''} ${item.Descripcion || ''}`.toLowerCase();
      return target.terms.some((term) => text.includes(term));
    });
    if (match) return match;
  }
  return items[0] || null;
}

let featuredAntecedente: any = null;
let allAntecedentesForIndex: any[] = [];

try {
  const response = await getAllAntecedentes();

  const allAntecedentes = sortAntecedentesForPublicList(response.map((item) => {
    const curated = curateAntecedente({
      ...item,
      imageUrl: getAntecedenteImageUrl(item),
    });

    return {
      ...curated,
      slug: `${item.id}/${localGenerateSlug(item.Titulo)}`,
    };
  }));
  allAntecedentesForIndex = allAntecedentes;

  const filteredAntecedentes = sortAntecedentesArchive(sortAntecedentesForPublicList(
    filterAntecedentes(allAntecedentes, pageData.activeFilters, pageData.searchQuery)
  ), pageData.archiveSort);
  const hasActiveFilters = Boolean(
    pageData.searchQuery
    || pageData.activeFilters.sector
    || pageData.activeFilters.area
    || pageData.activeFilters.cliente
    || pageData.activeFilters.unidad_negocio
  );

  let spotlightAntecedentes;
  let archivePool;

  const isLandingPage = pageData.currentPage === 1 && !hasActiveFilters;

  if (isLandingPage) {
    const promotableAntecedentes = filteredAntecedentes.filter(isPromotableAntecedente);
    const spotlightSource = promotableAntecedentes.length > 0 ? promotableAntecedentes : filteredAntecedentes;
    featuredAntecedente = pickProtagonistAntecedente(spotlightSource);
    const remaining = featuredAntecedente
      ? filteredAntecedentes.filter((item) => item.id !== featuredAntecedente.id)
      : filteredAntecedentes;
    const secondarySource = remaining.filter(isPromotableAntecedente);
    const secondarySpotlight = secondarySource.length >= 2 ? secondarySource.slice(0, 2) : remaining.slice(0, 2);
    spotlightAntecedentes = featuredAntecedente ? [featuredAntecedente, ...secondarySpotlight] : filteredAntecedentes.slice(0, 3);
    const spotlightIds = new Set(spotlightAntecedentes.map((item) => item.id));
    archivePool = filteredAntecedentes.filter((item) => !spotlightIds.has(item.id));
  } else {
    spotlightAntecedentes = [];
    archivePool = filteredAntecedentes;
  }

  const archiveStartIndex = (pageData.currentPage - 1) * PAGE_SIZE;
  const archiveEndIndex = archiveStartIndex + PAGE_SIZE;

  pageData = {
    ...pageData,
    antecedentes: archivePool.slice(archiveStartIndex, archiveEndIndex),
    spotlightAntecedentes,
    totalItems: filteredAntecedentes.length,
    catalogTotalItems: allAntecedentes.length,
    archiveTotalItems: archivePool.length,
    totalPages: Math.max(1, Math.ceil(archivePool.length / PAGE_SIZE)),
    hasActiveFilters,
    isLandingPage,
    error: null,
    isLoading: false
  };
} catch (error) {
  console.error('Error loading antecedentes from Directus:', error);
  pageData = {
    ...pageData,
    antecedentes: [],
    spotlightAntecedentes: [],
    archiveTotalItems: 0,
    hasActiveFilters: false,
    isLandingPage: false,
    error: 'Error loading projects',
    isLoading: false
  };
}

const searchQuery = pageData.searchQuery;
const areaFilter = pageData.activeFilters.area;
const unidadFilter = pageData.activeFilters.unidad_negocio;
const sectorFilter = pageData.activeFilters.sector;

const filterChips = [
  { id: '', name: 'Todas', icon: 'grid' },
  { id: 'aeropuertos', name: 'Aeropuertos', icon: 'plane' },
  { id: 'bodegas', name: 'Bodegas', icon: 'wine' },
  { id: 'gobierno', name: 'Gobierno', icon: 'landmark' },
  { id: 'salud', name: 'Salud', icon: 'heart' },
  { id: 'construccion', name: 'Construcción', icon: 'building' },
  { id: 'industria', name: 'Industria', icon: 'factory' },
  { id: 'datacenter', name: 'Data Center', icon: 'server' },
  { id: 'mineria', name: 'Minería', icon: 'mountain' },
  { id: 'seguridad', name: 'Seguridad', icon: 'shield' },
  { id: 'software', name: 'Software', icon: 'code' },
];

const hasActiveArchiveFilters = Boolean(searchQuery || areaFilter || unidadFilter || sectorFilter);
const activeSectorName = sectorFilter
  ? filterChips.find((chip) => chip.id === sectorFilter)?.name || ''
  : '';
const isSearchResultPage = Boolean(searchQuery);

const buildCanonicalPageUrl = (page: number) => {
  const params = new URLSearchParams();
  if (!isSearchResultPage) {
    if (sectorFilter) params.set('sector', sectorFilter);
    if (areaFilter) params.set('area', areaFilter);
    if (unidadFilter) params.set('unidad_negocio', unidadFilter);
  }
  if (page > 1) params.set('page', String(page));
  const query = params.toString();
  return canonicalUrl(`/antecedentes${query ? `?${query}` : ''}`);
};

const currentCanonicalUrl = isSearchResultPage
  ? canonicalUrl('/antecedentes')
  : buildCanonicalPageUrl(pageData.currentPage);
const previousPageUrl = !isSearchResultPage && pageData.currentPage > 1
  ? buildCanonicalPageUrl(pageData.currentPage - 1)
  : '';
const nextPageUrl = !isSearchResultPage && pageData.currentPage < pageData.totalPages
  ? buildCanonicalPageUrl(pageData.currentPage + 1)
  : '';

const pageTitle = pageData.currentPage > 1
  ? `Archivo de antecedentes - página ${pageData.currentPage} | ULTIMA MILLA`
  : activeSectorName
    ? `Antecedentes en ${activeSectorName} | ULTIMA MILLA`
  : hasActiveArchiveFilters
      ? 'Archivo filtrado de antecedentes | ULTIMA MILLA'
      : 'Evidencia operativa real | ULTIMA MILLA';

const pageDescription = pageData.currentPage > 1
  ? `Antecedentes técnicos de ULTIMA MILLA, página ${pageData.currentPage}: proyectos reales con cliente, sector, fecha e imagen asociada.`
  : activeSectorName
    ? `Antecedentes técnicos de ULTIMA MILLA relacionados con ${activeSectorName}: casos y proyectos reales con cliente, sector, fecha e imagen.`
    : hasActiveArchiveFilters
      ? 'Archivo filtrado de antecedentes técnicos de ULTIMA MILLA con proyectos reales, cliente, sector, fecha e imagen asociada.'
      : 'Antecedentes técnicos de ULTIMA MILLA: proyectos reales de redes, seguridad electrónica, telecomunicaciones, software, soporte e infraestructura IT.';

const requestedTemplateVariant = getDevTemplateVariant(Astro.url, import.meta.env.DEV);
const templateVariant = import.meta.env.DEV && (requestedTemplateVariant === 'editorial' || requestedTemplateVariant === 'atlas')
  ? requestedTemplateVariant
  : 'um26';
const visibleAntecedentes = [
  ...(pageData.spotlightAntecedentes || []),
  ...(pageData.antecedentes || []),
].slice(0, 6);
const pageOgImage = visibleAntecedentes.find((item: any) => item.imageUrl)?.imageUrl || editorialImages.defaultOg;
const pageOgDimensions = pageOgImage.startsWith('/images/antecedentes/generated/')
  ? generatedAntecedenteImageDimensions
  : editorialImageDimensions;
const crawlableAntecedenteIndex = allAntecedentesForIndex
  .map((item) => ({
    id: item.id,
    title: item.displayTitle || item.Titulo || 'Antecedente técnico',
    area: item.Area || item.Unidad_de_negocio || '',
    href: `/antecedentes/${item.slug}`,
    quality: item.curation?.quality || '',
  }))
  .sort((a, b) => String(a.title).localeCompare(String(b.title), 'es'));
const antecedentesStrategicLinkGroups = buildCaseStrategicLinkGroups({
  currentPath: '/antecedentes',
  title: 'Evidencia operativa real',
  summary: 'Antecedentes técnicos de redes, seguridad electrónica, telecomunicaciones, software, soporte e infraestructura IT.',
  text: visibleAntecedentes.map((item: any) => `${item.displayTitle || item.Titulo || ''} ${item.displayDescription || item.Descripcion || ''} ${item.Cliente || ''} ${item.Area || ''}`).join(' '),
  relatedCases: visibleAntecedentes.map((item: any) => ({
    ...item,
    href: item.slug ? `/antecedentes/${item.slug}` : '',
  })),
});
const antecedentesStructuredData = buildStrategicWebPageStructuredData({
  url: currentCanonicalUrl,
  name: pageTitle.replace(/\s+\|\s+ULTIMA MILLA$/, ''),
  description: pageDescription,
  groups: antecedentesStrategicLinkGroups,
});
const structuredPageItems = [
  ...(pageData.spotlightAntecedentes || []),
  ...(pageData.antecedentes || []),
];
const structuredPositionOffset = pageData.currentPage > 1 ? (pageData.currentPage - 1) * PAGE_SIZE : 0;
const antecedentesCollectionStructuredData = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: pageTitle.replace(/\s+\|\s+ULTIMA MILLA$/, ''),
  description: pageDescription,
  url: currentCanonicalUrl,
  inLanguage: 'es-AR',
  significantLink: [
    'https://www.ultimamilla.com.ar/servicios',
    'https://www.ultimamilla.com.ar/sectores',
    'https://www.ultimamilla.com.ar/contacto',
    ...structuredPageItems.slice(0, 8).map((item) => `https://www.ultimamilla.com.ar/antecedentes/${item.slug}`),
  ],
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: allAntecedentesForIndex.length,
    itemListOrder: 'https://schema.org/ItemListOrderDescending',
    itemListElement: structuredPageItems
      .slice(0, 24)
      .map((item, index) => buildAntecedenteListItemStructuredData(item, structuredPositionOffset + index + 1)),
  },
};
---

<LayoutV4
  title={pageTitle}
  description={pageDescription}
  keywords="casos exito tecnologia mendoza, proyectos telecomunicaciones, antecedentes cableado estructurado, portfolio seguridad electronica, software a medida casos"
  image={pageOgImage}
  imageWidth={pageOgDimensions.width}
  imageHeight={pageOgDimensions.height}
  canonical={currentCanonicalUrl}
  noindex={isSearchResultPage}
  structuredData={[antecedentesStructuredData, antecedentesCollectionStructuredData]}
>
  <Fragment slot="head">
    {previousPageUrl && <link rel="prev" href={previousPageUrl} />}
    {nextPageUrl && <link rel="next" href={nextPageUrl} />}
  </Fragment>
  {templateVariant === 'atlas' && (
    <AntecedentesTemplateAtlas
      pageData={pageData}
      filterChips={filterChips}
      sectorFilter={sectorFilter}
      searchQuery={searchQuery}
      areaFilter={areaFilter}
      unidadFilter={unidadFilter}
      pageSize={PAGE_SIZE}
    />
  )}
  {templateVariant === 'editorial' && (
    <AntecedentesTemplateEditorial
      pageData={pageData}
      featuredAntecedente={featuredAntecedente}
      filterChips={filterChips}
      sectorFilter={sectorFilter}
      searchQuery={searchQuery}
      areaFilter={areaFilter}
      unidadFilter={unidadFilter}
      pageSize={PAGE_SIZE}
    />
  )}
  {templateVariant === 'um26' && (
    <AntecedentesTemplateUM26
      pageData={pageData}
      featuredAntecedente={featuredAntecedente}
      filterChips={filterChips}
      sectorFilter={sectorFilter}
      searchQuery={searchQuery}
      areaFilter={areaFilter}
      unidadFilter={unidadFilter}
      pageSize={PAGE_SIZE}
    />
  )}
  {templateVariant !== 'um26' && (
    <IntentLinkGraph
      kicker="Para avanzar"
      title="Usar la evidencia"
      text="Pasá de casos reales a servicios aplicados, sectores similares o contacto técnico."
      groups={antecedentesStrategicLinkGroups}
    />
  )}
  {crawlableAntecedenteIndex.length > 0 && (
    <section class="antecedentes-crawl-index" aria-labelledby="antecedentes-crawl-index-title">
      <div class="antecedentes-crawl-index__inner">
        <details>
          <summary id="antecedentes-crawl-index-title">
            Índice completo de antecedentes
            <span>{crawlableAntecedenteIndex.length} casos técnicos</span>
          </summary>
          <nav aria-label="Todos los antecedentes técnicos">
            {crawlableAntecedenteIndex.map((item) => (
              <a href={item.href}>
                <strong>{item.title}</strong>
                {item.area && <span>{item.area}</span>}
              </a>
            ))}
          </nav>
        </details>
      </div>
    </section>
  )}
</LayoutV4>

<style>
  .antecedentes-crawl-index {
    background: #0a0a0b;
    border-top: 1px solid rgba(255,255,255,0.08);
    padding: 28px 0 56px;
  }

  .antecedentes-crawl-index__inner {
    max-width: 1120px;
    margin: 0 auto;
    padding: 0 24px;
  }

  .antecedentes-crawl-index details {
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 6px;
    background: #111113;
  }

  .antecedentes-crawl-index summary {
    cursor: pointer;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 18px 20px;
    color: #fff;
    font-size: 18px;
    font-weight: 700;
  }

  .antecedentes-crawl-index summary span {
    color: rgba(255,255,255,0.58);
    font-size: 16px;
    font-weight: 600;
  }

  .antecedentes-crawl-index nav {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1px;
    border-top: 1px solid rgba(255,255,255,0.12);
    background: rgba(255,255,255,0.12);
  }

  .antecedentes-crawl-index a {
    display: grid;
    gap: 4px;
    min-width: 0;
    padding: 12px 14px;
    background: #0a0a0b;
    color: #fff;
    text-decoration: none;
  }

  .antecedentes-crawl-index a:hover,
  .antecedentes-crawl-index a:focus-visible {
    background: color-mix(in srgb, #0a0a0b 86%, var(--um-red, #DC2626) 14%);
    outline: none;
  }

  .antecedentes-crawl-index strong,
  .antecedentes-crawl-index span {
    overflow-wrap: anywhere;
  }

  .antecedentes-crawl-index strong {
    font-size: 16px;
    line-height: 1.35;
    font-weight: 700;
  }

  .antecedentes-crawl-index a span {
    color: rgba(255,255,255,0.58);
    font-size: 16px;
    line-height: 1.35;
  }
</style>
