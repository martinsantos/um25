---
import Layout from '../../layouts/Layout.astro';
import { directus, PAGE_SIZE, DEFAULT_IMAGE } from '../../utils/directus';

// Configuración de filtros
const FILTER_CONFIG = {
  area: { field: 'Area', display: 'Área', options: [] },
  cliente: { field: 'Cliente', display: 'Cliente', options: [] },
  unidad_negocio: { field: 'Unidad_de_negocio', display: 'Unidad de Negocio', options: [] }
};

// Función para generar slugs (debe coincidir con la del single view)
const generateSlug = (text = '') => {
  if (!text) return 'item';
  return String(text)
    .toLowerCase()
    .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
    .replace(/[^\w\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 50) || 'item';
};

// Obtener parámetros de la URL
const getUrlParams = (url) => {
  const searchParams = new URL(url).searchParams;
  const resetFilters = searchParams.get('reset') === '1';
  
  const activeFilters = resetFilters
    ? { area: '', cliente: '', unidad_negocio: '' }
    : {
        area: searchParams.get('area') || '',
        cliente: searchParams.get('cliente') || '',
        unidad_negocio: searchParams.get('unidad_negocio') || ''
      };

  return {
    searchQuery: searchParams.get('q') || '',
    currentPage: Math.max(1, parseInt(searchParams.get('page') || '1')),
    activeFilters,
    pageSize: PAGE_SIZE
  };
};

// Cargar datos iniciales
let pageData = {
  antecedentes: [],
  error: null,
  totalItems: 0,
  totalPages: 1,
  randomImages: [DEFAULT_IMAGE],
  isLoading: true,
  ...getUrlParams(Astro.request?.url || Astro.url)
};

try {
  // Cargar datos en paralelo
  const [filterOptions, antecedentesData, randomImages] = await Promise.all([
    directus.getFilterOptions(),
    directus.getAntecedentes({
      page: pageData.currentPage,
      search: pageData.searchQuery,
      ...pageData.activeFilters
    }),
    directus.getRandomImages(9)
  ]);

  // Actualizar opciones de filtro
  Object.keys(FILTER_CONFIG).forEach(key => {
    FILTER_CONFIG[key].options = filterOptions[key] || [];
  });

  // Mapear los datos para incluir el slug generado
  const antecedentesWithSlug = (antecedentesData.data || []).map(item => ({
    ...item,
    slug: `${item.id}/${generateSlug(item.Titulo)}`
  }));

  // Actualizar datos de la página
  pageData = {
    ...pageData,
    antecedentes: antecedentesWithSlug,
    totalItems: antecedentesData.meta?.filter_count || 0,
    totalPages: Math.ceil((antecedentesData.meta?.filter_count || 0) / PAGE_SIZE),
    randomImages: randomImages.length ? randomImages : [DEFAULT_IMAGE],
    isLoading: false,
    filterOptions
  };
} catch (error) {
  console.error('Error al cargar datos:', error);
  pageData = {
    ...pageData,
    error: 'Error al cargar los datos. Por favor, intente nuevamente más tarde.',
    isLoading: false
  };
}

// Función para construir la URL con parámetros de filtro
const buildFilterUrl = (params) => {
  const url = new URL(Astro.request?.url || Astro.url);
  Object.entries(params).forEach(([key, value]) => {
    if (value) {
      url.searchParams.set(key, value);
    } else {
      url.searchParams.delete(key);
    }
  });
  url.searchParams.delete('page'); // Reset to first page when filters change
  return url.pathname + url.search;
};

// Función para limpiar filtros
const clearFilters = () => {
  const url = new URL(Astro.request?.url || Astro.url);
  url.search = '';
  return url.pathname;
};

// Obtener el primer párrafo de una descripción HTML
const getFirstParagraph = (html) => {
  if (!html) return '';
  const match = html.match(/<p[^>]*>(.*?)<\/p>/);
  return match ? match[1] : html.substring(0, 150) + '...';
};

// Funciones de utilidad para paginación
const generatePaginationNumbers = (currentPage, totalPages, maxVisible = 5) => {
  if (totalPages <= 1) return [];
  if (totalPages <= maxVisible) return Array.from({ length: totalPages }, (_, i) => i + 1);
  
  const pages = [1];
  const sideItems = Math.floor((maxVisible - 3) / 2);
  
  if (currentPage > 2 + sideItems) pages.push('...');
  
  let start = Math.max(2, currentPage - sideItems);
  let end = Math.min(totalPages - 1, currentPage + sideItems);
  
  if (currentPage <= 2 + sideItems) {
    end = maxVisible - 1;
  } else if (currentPage >= totalPages - sideItems - 1) {
    start = totalPages - maxVisible + 2;
  }
  
  for (let i = start; i <= end; i++) {
    if (i > 1 && i < totalPages) pages.push(i);
  }
  
  if (currentPage < totalPages - sideItems - 1) pages.push('...');
  if (totalPages > 1) pages.push(totalPages);
  
  return pages;
};

const buildPageUrl = (page = 1) => {
  const params = new URLSearchParams();
  
  // Añadir filtros activos
  Object.entries(pageData.activeFilters).forEach(([key, value]) => {
    if (value) params.set(key, value);
  });
  
  // Añadir búsqueda
  if (pageData.searchQuery) params.set('q', pageData.searchQuery);
  
  // Añadir página si no es la primera
  if (page > 1) params.set('page', page);
  
  const queryString = params.toString();
  return `/antecedentes${queryString ? `?${queryString}` : ''}`;
};

// Generar URLs para la paginación
const paginationUrls = {
  first: buildPageUrl(1),
  prev: pageData.currentPage > 1 ? buildPageUrl(pageData.currentPage - 1) : null,
  next: pageData.currentPage < pageData.totalPages ? buildPageUrl(pageData.currentPage + 1) : null,
  last: buildPageUrl(pageData.totalPages)
};

// Generar números de página para la paginación
const paginationNumbers = generatePaginationNumbers(
  pageData.currentPage,
  pageData.totalPages
);
---

<Layout 
  title="Nuestros Proyectos | Última Milla"
  description="Explora nuestro portafolio de proyectos realizados para diferentes clientes y sectores. Filtra por área, cliente o unidad de negocio para encontrar exactamente lo que buscas."
  ogImage="/images/og-proyectos.jpg"
>
  <main class="min-h-screen bg-gray-50">
    {/* Hero Section */}
    <div class="bg-ultima-navy text-white py-16 md:py-24">
      <div class="container mx-auto px-4 text-center">
        <h1 class="text-4xl md:text-5xl font-bold mb-4">Nuestros Proyectos</h1>
        <p class="text-xl text-gray-300 max-w-3xl mx-auto">
          Descubre nuestra experiencia y casos de éxito en diferentes sectores e industrias.
        </p>
      </div>
    </div>

    {/* Filtros y Búsqueda */}
    <div class="container mx-auto px-4 py-8 -mt-8">
      <div class="bg-white rounded-lg shadow-md p-6">
        <form method="GET" action="/antecedentes" class="space-y-4">
          <div class="relative">
            <input
              type="text"
              name="q"
              value={pageData.searchQuery}
              placeholder="Buscar proyectos..."
              class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-transparent"
            />
            <button 
              type="submit" 
              class="absolute right-2 top-1/2 transform -translate-y-1/2 text-gray-500 hover:text-blue-600"
            >
              <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
              </svg>
            </button>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
            {Object.entries(FILTER_CONFIG).map(([key, config]) => (
              <div key={key}>
                <label class="block text-sm font-medium text-gray-700 mb-1">{config.display}</label>
                <select 
                  name={key} 
                  class="w-full px-3 py-2 border border-gray-300 rounded-md shadow-sm focus:outline-none focus:ring-blue-500 focus:border-blue-500"
                  onchange="this.form.submit()"
                >
                  <option value="">Todos</option>
                  {config.options.map(option => (
                    <option 
                      value={option} 
                      selected={pageData.activeFilters[key] === option}
                    >
                      {option}
                    </option>
                  ))}
                </select>
              </div>
            ))}
          </div>

          <div class="flex justify-end">
            <a 
              href={clearFilters()} 
              class="text-sm text-blue-600 hover:text-blue-800 font-medium"
            >
              Limpiar filtros
            </a>
          </div>
        </form>
      </div>
    </div>

    {/* Contenido */}
    <div class="container mx-auto px-4 py-8">
      {/* Loading State */}
      {pageData.isLoading && (
        <div class="text-center py-12">
          <div class="inline-block animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-blue-500 mb-4"></div>
          <p class="text-gray-600">Cargando proyectos...</p>
        </div>
      )}

      {/* Error State */}
      {pageData.error && (
        <div class="bg-red-50 border-l-4 border-red-400 p-4 rounded mb-8">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-red-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm text-red-700">{pageData.error}</p>
            </div>
          </div>
        </div>
      )}

      {/* Empty State */}
      {!pageData.isLoading && !pageData.error && pageData.antecedentes.length === 0 && (
        <div class="text-center py-16 bg-white rounded-lg shadow-sm border border-gray-200">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <h3 class="mt-2 text-lg font-medium text-gray-900">No se encontraron proyectos</h3>
          <p class="mt-1 text-sm text-gray-500">Intenta ajustar tus filtros de búsqueda.</p>
          <div class="mt-6">
            <a href="/antecedentes" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
              Limpiar filtros
            </a>
          </div>
        </div>
      )}

      {/* Grid de Proyectos */}
      {!pageData.isLoading && !pageData.error && pageData.antecedentes.length > 0 && (
        <>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {pageData.antecedentes.map((proyecto) => (
              <a 
                href={`/antecedentes/${proyecto.slug}`}
                class="group block bg-white rounded-xl shadow-md hover:shadow-xl transition-all duration-300 overflow-hidden hover:-translate-y-1 h-full flex flex-col"
              >
                <div class="relative overflow-hidden aspect-video">
                  {proyecto.Imagen ? (
                    <img 
                      src={`/api/asset/${proyecto.Imagen}?width=800`}
                      alt={proyecto.Titulo}
                      class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
                      loading="lazy"
                    />
                  ) : (
                    <div class="w-full h-full bg-gray-100 flex items-center justify-center">
                      <svg class="h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                      </svg>
                    </div>
                  )}
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
                    <span class="text-white font-medium">Ver proyecto →</span>
                  </div>
                </div>
                <div class="p-6 flex-1 flex flex-col">
                  <div class="flex-1">
                    <h3 class="text-xl font-bold text-gray-900 mb-2 line-clamp-2">
                      {proyecto.Titulo}
                    </h3>
                    {proyecto.Cliente && (
                      <p class="text-sm text-gray-600 mb-3">
                        {proyecto.Cliente}
                      </p>
                    )}
                    <p class="text-gray-600 line-clamp-3 text-sm">
                      {getFirstParagraph(proyecto.Descripcion) || 'Sin descripción disponible.'}
                    </p>
                  </div>
                  <div class="mt-4 pt-4 border-t border-gray-100">
                    {proyecto.Area && (
                      <span class="inline-block bg-ultima-blue text-white text-xs font-medium px-3 py-1 rounded-full mb-2">
                        {proyecto.Area}
                      </span>
                    )}
                    {proyecto.Unidad_de_negocio && (
                      <p class="text-xs text-gray-500 mt-2">
                        {proyecto.Unidad_de_negocio}
                      </p>
                    )}
                  </div>
                </div>
              </a>
            ))}
          </div>

          {/* Paginación */}
          {pageData.totalPages > 1 && (
            <nav class="mt-12 flex items-center justify-between" aria-label="Pagination">
              <div class="flex-1 flex justify-between sm:justify-start">
                {paginationUrls.prev && (
                  <a 
                    href={paginationUrls.prev}
                    class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50"
                  >
                    Anterior
                  </a>
                )}
              </div>
              
              <div class="hidden md:flex">
                <div class="flex rounded-md shadow-sm">
                  {paginationNumbers.map((page, index) => (
                    page === '...' ? (
                      <span key={`ellipsis-${index}`} class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700">
                        ...
                      </span>
                    ) : (
                      <a
                        key={page}
                        href={buildPageUrl(page)}
                        class={`relative inline-flex items-center px-4 py-2 border text-sm font-medium ${
                          page === pageData.currentPage
                            ? 'z-10 bg-blue-50 border-blue-500 text-blue-600'
                            : 'bg-white border-gray-300 text-gray-700 hover:bg-gray-50'
                        }`}
                      >
                        {page}
                      </a>
                    )
                  ))}
                </div>
              </div>

              <div class="flex-1 flex justify-end">
                {paginationUrls.next && (
                  <a 
                    href={paginationUrls.next}
                    class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50"
                  >
                    Siguiente
                  </a>
                )}
              </div>
            </nav>
          )}
        </>
      )}
    </div>
  </main>
</Layout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .bg-ultima-navy {
    background-color: #1e3a8a;
  }
  
  .hover\:bg-ultima-navy-light:hover {
    background-color: #1e40af;
  }
</style>
