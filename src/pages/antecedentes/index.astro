<Layout 
  title="Nuestros Proyectos | Última Milla"
  description="Explora nuestro portafolio de proyectos realizados para diferentes clientes y sectores. Filtra por área, cliente o unidad de negocio para encontrar exactamente lo que buscas."
  ogImage="/images/og-proyectos.jpg"
>
  <main class="min-h-screen bg-gray-50">
    {/* Hero Section Mejorado */}
    <div class="relative bg-gradient-to-br from-gray-900 via-blue-900 to-purple-900 text-white py-20 md:py-32 overflow-hidden">
      {/* Background Pattern */}
      <div class="absolute inset-0 opacity-10">
        <div class="absolute inset-0" style="background-image: url('data:image/svg+xml,%3Csvg width="60" height="60" viewBox="0 0 60 60" xmlns="http://www.w3.org/2000/svg"%3E%3Cg fill="none" fill-rule="evenodd"%3E%3Cg fill="%23ffffff" fill-opacity="0.1"%3E%3Ccircle cx="30" cy="30" r="2"/%3E%3C/g%3E%3C/g%3E%3C/svg%3E');"></div>
      </div>
      
      <div class="container mx-auto px-4 relative z-10">
        {/* Badge */}
        <div class="text-center mb-8">
          <span class="inline-flex items-center px-4 py-2 rounded-full text-sm font-medium bg-green-500/20 text-green-300 border border-green-500/30">
            <span class="w-2 h-2 bg-green-400 rounded-full mr-2 animate-pulse"></span>
            Disponible para nuevos proyectos
          </span>
        </div>

        {/* Main Title */}
        <div class="text-center mb-16">
          <h1 class="text-5xl md:text-7xl font-bold mb-6 bg-gradient-to-r from-white via-blue-100 to-purple-100 bg-clip-text text-transparent">
            Portfolio de<br/>
            <span class="text-blue-400">Proyectos Destacados</span>
          </h1>
          <p class="text-xl md:text-2xl text-gray-300 max-w-4xl mx-auto leading-relaxed">
            Explora nuestra colección de proyectos exitosos que han transformado negocios
            y creado experiencias digitales excepcionales.
          </p>
        </div>

        {/* Indicador de Proyectos */}
        <div class="text-center mb-16">
          <div class="text-6xl md:text-7xl font-bold text-blue-400 mb-2">{pageData.totalItems}</div>
          <div class="text-lg font-semibold text-white mb-1">Proyectos Disponibles</div>
          <div class="text-gray-400">Casos de éxito documentados</div>
        </div>

        {/* Search Bar */}
        <div class="max-w-2xl mx-auto">
          <div class="relative">
            <form method="GET" action="/antecedentes" class="flex">
              <input
                type="text"
                name="q"
                value={pageData.searchQuery}
                placeholder="Buscar proyectos, clientes, tecnologías..."
                class="flex-1 px-6 py-4 bg-white/10 backdrop-blur-sm border border-white/20 rounded-l-xl text-white placeholder-gray-300 focus:outline-none focus:ring-2 focus:ring-blue-400 focus:border-transparent"
              />
              <button 
                type="submit" 
                class="px-8 py-4 bg-blue-600 hover:bg-blue-700 text-white font-semibold rounded-r-xl transition-colors duration-200 flex items-center"
              >
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 mr-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                </svg>
                Buscar
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>

    {/* Filtros y Ordenamiento */}
    <div class="container mx-auto px-4 py-12 -mt-16 relative z-20">
      <div class="bg-white/95 backdrop-blur-sm rounded-2xl shadow-xl border border-gray-200/50 p-8">
        <div class="flex flex-col lg:flex-row lg:items-center lg:justify-between gap-6">
          {/* Título de sección */}
          <div>
            <h2 class="text-2xl font-bold text-gray-900 mb-2">Filtros y Ordenamiento</h2>
            <p class="text-gray-600">Encuentra exactamente lo que buscas</p>
          </div>

          {/* Filtros */}
          <form method="GET" action="/antecedentes" class="flex-1 max-w-4xl">
            <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-4">
              {/* Unidad de Negocio */}
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Unidad de Negocio</label>
                <select 
                  name="unidad_negocio" 
                  class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                  onchange="this.form.submit()"
                >
                  <option value="">Todas las unidades</option>
                  {filterOptions.unidades.map(unidad => (
                    <option 
                      value={unidad} 
                      selected={pageData.activeFilters.unidad_negocio === unidad}
                    >
                      {unidad}
                    </option>
                  ))}
                </select>
              </div>

              {/* Área */}
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Área</label>
                <select 
                  name="area" 
                  class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                  onchange="this.form.submit()"
                >
                  <option value="">Todas las áreas</option>
                  {filterOptions.areas.map(area => (
                    <option 
                      value={area} 
                      selected={pageData.activeFilters.area === area}
                    >
                      {area}
                    </option>
                  ))}
                </select>
              </div>

              {/* Cliente */}
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Cliente</label>
                <select 
                  name="cliente" 
                  class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                  onchange="this.form.submit()"
                >
                  <option value="">Todos los clientes</option>
                  {filterOptions.clientes.map(cliente => (
                    <option 
                      value={cliente} 
                      selected={pageData.activeFilters.cliente === cliente}
                    >
                      {cliente}
                    </option>
                  ))}
                </select>
              </div>

              {/* Búsqueda adicional */}
              <div>
                <label class="block text-sm font-semibold text-gray-700 mb-2">Búsqueda adicional</label>
                <input
                  type="text"
                  name="q"
                  value={pageData.searchQuery}
                  placeholder="Buscar en proyectos..."
                  class="w-full px-4 py-3 bg-gray-50 border border-gray-200 rounded-xl focus:outline-none focus:ring-2 focus:ring-blue-500 focus:border-transparent transition-all"
                />
              </div>
            </div>

            {/* Acciones */}
            <div class="flex items-center justify-end gap-3">
              <a 
                href={clearFilters()} 
                class="px-4 py-2 text-sm font-medium text-gray-600 hover:text-gray-800 border border-gray-300 rounded-lg hover:bg-gray-50 transition-colors"
              >
                Limpiar filtros
              </a>
              <button 
                type="submit" 
                class="px-6 py-2 bg-blue-600 hover:bg-blue-700 text-white font-medium rounded-lg transition-colors"
              >
                Aplicar filtros
              </button>
            </div>
          </form>
        </div>
      </div>
    </div>

    {/* Resumen de Resultados */}
    <div class="container mx-auto px-4 py-8">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between mb-8">
        <div>
          <h3 class="text-2xl font-bold text-gray-900 mb-2">
            Explorando {pageData.totalItems} proyectos
          </h3>
          <p class="text-gray-600">
            {pageData.searchQuery ? `Resultados para "${pageData.searchQuery}"` : 'Mostrando todos los proyectos disponibles'}
          </p>
        </div>
        <div class="mt-4 sm:mt-0">
          <span class="text-sm text-gray-500">
            Página {pageData.currentPage} de {pageData.totalPages}
          </span>
        </div>
      </div>
    </div>

    {/* Contenido */}
    <div class="container mx-auto px-4 pb-8">
      {/* Loading State */}
      {pageData.isLoading && (
        <div class="text-center py-12">
          <div class="inline-block animate-spin rounded-full h-12 w-12 border-t-2 border-b-2 border-blue-500 mb-4"></div>
          <p class="text-gray-600">Cargando proyectos...</p>
        </div>
      )}

      {/* Error State */}
      {pageData.error && (
        <div class="bg-red-50 border-l-4 border-red-400 p-4 rounded mb-8">
          <div class="flex">
            <div class="flex-shrink-0">
              <svg class="h-5 w-5 text-red-400" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 20 20" fill="currentColor">
                <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zM8.707 7.293a1 1 0 00-1.414 1.414L8.586 10l-1.293 1.293a1 1 0 101.414 1.414L10 11.414l1.293 1.293a1 1 0 001.414-1.414L11.414 10l1.293-1.293a1 1 0 00-1.414-1.414L10 8.586 8.707 7.293z" clip-rule="evenodd" />
              </svg>
            </div>
            <div class="ml-3">
              <p class="text-sm text-red-700">{pageData.error}</p>
            </div>
          </div>
        </div>
      )}

      {/* Empty State */}
      {!pageData.isLoading && !pageData.error && pageData.antecedentes.length === 0 && (
        <div class="text-center py-16 bg-white rounded-lg shadow-sm border border-gray-200">
          <svg class="mx-auto h-12 w-12 text-gray-400" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
          </svg>
          <h3 class="mt-2 text-lg font-medium text-gray-900">No se encontraron proyectos</h3>
          <p class="mt-1 text-sm text-gray-500">Intenta ajustar tus filtros de búsqueda.</p>
          <div class="mt-6">
            <a href="/antecedentes" class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500">
              Limpiar filtros
            </a>
          </div>
        </div>
      )}

      {/* Grid de Proyectos */}
      {!pageData.isLoading && !pageData.error && pageData.antecedentes.length > 0 && (
        <>
          <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
            {pageData.antecedentes.map((proyecto) => (
              <a href={`/antecedentes/${proyecto.slug}`} class="block group cursor-pointer">
                <article class="bg-white rounded-2xl shadow-lg hover:shadow-2xl hover:shadow-blue-500/25 transition-all duration-300 transform hover:-translate-y-2 hover:scale-[1.02] hover:ring-4 hover:ring-blue-300/50 overflow-hidden border-2 border-transparent hover:border-blue-400 h-full">
                  {/* Imagen del proyecto */}
                  <div class="relative overflow-hidden aspect-[4/3]">
                    <img 
                      src={proyecto.imageUrl}
                      alt={proyecto.Titulo}
                      class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                      loading="lazy"
                      onerror="this.src='/images/default.jpg'"
                    />
                    


                    {/* Badge de categoría */}
                    <div class="absolute top-4 left-4">
                      <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800 border border-blue-200">
                        {proyecto.Area || 'Proyecto'}
                      </span>
                    </div>
                  </div>

                  {/* Contenido de la tarjeta */}
                  <div class="p-6">
                    {/* Título y cliente */}
                    <div class="mb-4">
                      <h3 class="text-xl font-black text-gray-900 mb-2 line-clamp-2 group-hover:text-blue-600 transition-colors">
                        {proyecto.Titulo}
                      </h3>
                      {proyecto.Cliente && (
                        <div class="flex items-center text-sm text-gray-600 mb-2">
                          <svg class="w-4 h-4 mr-2 text-gray-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-4m-5 0H9m0 0H5m4 0V9a1 1 0 011-1h4a1 1 0 011 1v12M9 7h6"></path>
                          </svg>
                          {proyecto.Cliente}
                        </div>
                      )}
                    </div>

                    {/* Descripción */}
                    <p class="text-gray-600 line-clamp-3 text-sm leading-relaxed mb-4">
                      {getFirstParagraph(proyecto.Descripcion) || 'Proyecto de desarrollo tecnológico con implementación de soluciones innovadoras.'}
                    </p>

                    {/* Metadatos del proyecto */}
                    <div class="flex items-center justify-between pt-4 border-t border-gray-100">
                      <div class="flex items-center text-xs text-gray-500">
                        <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                        </svg>
                        {proyecto.Fecha ? new Date(proyecto.Fecha).toLocaleDateString('es-ES', { year: 'numeric', month: 'short' }) : '2024'}
                      </div>
                      {proyecto.Unidad_de_negocio && (
                        <span class="inline-flex items-center px-2 py-1 rounded-md text-xs font-medium bg-gray-100 text-gray-700">
                          {proyecto.Unidad_de_negocio}
                        </span>
                      )}
                    </div>
                  </div>
                </article>
              </a>
            ))}
          </div>

          {/* Paginación */}
          {pageData.totalPages > 1 && (
            <nav class="mt-12 flex items-center justify-between" aria-label="Pagination">
              <div class="flex-1 flex justify-between sm:justify-start">
                {paginationUrls.prev && (
                  <a 
                    href={paginationUrls.prev}
                    class="relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50"
                  >
                    Anterior
                  </a>
                )}
              </div>
              
              <div class="hidden md:flex">
                <div class="flex rounded-md shadow-sm">
                  {paginationNumbers.map((page, index) => (
                    page === '...' ? (
                      <span key={`ellipsis-${index}`} class="relative inline-flex items-center px-4 py-2 border border-gray-300 bg-white text-sm font-medium text-gray-700">
                        ...
                      </span>
                    ) : (
                      <a
                        key={page}
                        href={buildPageUrl(page)}
                        class={`relative inline-flex items-center px-4 py-2 border text-sm font-medium ${
                          page === pageData.currentPage
                            ? 'z-10 bg-blue-50 border-blue-500 text-blue-600'
                            : 'bg-white border-gray-300 text-gray-700 hover:bg-gray-50'
                        }`}
                      >
                        {page}
                      </a>
                    )
                  ))}
                </div>
              </div>

              <div class="flex-1 flex justify-end">
                {paginationUrls.next && (
                  <a 
                    href={paginationUrls.next}
                    class="ml-3 relative inline-flex items-center px-4 py-2 border border-gray-300 text-sm font-medium rounded-md text-gray-700 bg-white hover:bg-gray-50"
                  >
                    Siguiente
                  </a>
                )}
              </div>
            </nav>
          )}
        </>
      )}
    </div>
  </main>
</Layout>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .bg-ultima-navy {
    background-color: #1e3a8a;
  }
  
  .hover\:bg-ultima-navy-light:hover {
    background-color: #1e40af;
  }
</style>
