---
/**
 * Antecedente Clean URL Page - V4 Design System (Perfect SEO)
 * Handles /antecedentes/[slug] urls directly without redirects
 */

import LayoutV4 from '../../layouts/LayoutV4.astro';
import { generateSlug } from '../../utils/slugUtils.js';
import { getFixedImage } from '../../utils/imageFixer.js';
import { serviciosCompletos } from '../../data/servicios_completos_v4.js';
import { getServiceIdFromArea } from '../../data/areaToServiceMap.js';

// --- Configuration ---
const DIRECTUS_URL = import.meta.env.PUBLIC_DIRECTUS_URL || 'https://ultimamilla.com.ar/admin';
const PROD_URL = 'https://ultimamilla.com.ar';
const DEFAULT_IMAGE_URL = `/images/default-background.jpg`;
const DIRECTUS_STATIC_TOKEN = import.meta.env.DIRECTUS_STATIC_TOKEN || 'k6P8LAY8_x_y1miB_KTlWnysCnx2Abky';

export const prerender = false;

// URL params
const { slug: slugFromUrl } = Astro.params;

if (!slugFromUrl) {
    return Astro.redirect('/404');
}

// --- State ---
let antecedente: any = null;
let usingFallback = false;
let id: string = '';

// --- Helper Functions ---
const getAssetUrl = (assetId: any): string => {
    if (!assetId) return DEFAULT_IMAGE_URL;
    if (typeof assetId === 'object') {
        if (assetId.id) return `${PROD_URL}/directus-assets/${assetId.id}`;
        if (assetId.directus_files_id) return `${PROD_URL}/directus-assets/${assetId.directus_files_id}`;
        if (assetId.filename_disk) return `${PROD_URL}/directus-assets/${assetId.filename_disk}`;
    }
    if (typeof assetId === 'string') {
        if (assetId.startsWith('http')) return assetId;
        if (assetId.match(/^[a-f0-9-]{36}$/)) return `${PROD_URL}/directus-assets/${assetId}`;
        let filename = assetId.startsWith('/') ? assetId.substring(1) : assetId;
        filename = getFixedImage(filename);
        return `/imagenes_antecedentes_versionproduccion/${filename}`;
    }
    return DEFAULT_IMAGE_URL;
};

// --- Fetch Data Logic ---
async function findAntecedenteBySlug(targetSlug: string) {
    try {
        // Fetch ALL items to match slug (since Directus doesn't search by generated slug)
        // Optimization: In a huge DB this is bad, but for < 1000 items it's fine for SSG/Hybrid
        // We select minimal fields first
        const response = await fetch(`${DIRECTUS_URL}/items/Antecedentes?limit=-1&fields=id,Titulo`, {
            headers: {
                'Authorization': `Bearer ${DIRECTUS_STATIC_TOKEN}`,
                'Accept': 'application/json'
            }
        });
        
        if (!response.ok) throw new Error(`API Error: ${response.status}`);
        const data = await response.json();
        const items = data?.data || [];
        
        // Find match
        const match = items.find((item: any) => generateSlug(item.Titulo) === targetSlug);
        
        if (match) {
            // Found ID, now fetch full details
            return await fetchAntecedenteFull(match.id);
        }
        return null;
    } catch (error) {
        console.error(`Error finding slug ${targetSlug}:`, error);
        throw error;
    }
}

async function fetchAntecedenteFull(itemId: string) {
     const response = await fetch(`${DIRECTUS_URL}/items/Antecedentes/${itemId}?fields=*,Imagen.*,ImagenPrincipal.*,Imagenes.*,Imagenes.directus_files_id`, {
        headers: {
            'Authorization': `Bearer ${DIRECTUS_STATIC_TOKEN}`,
            'Accept': 'application/json'
        }
    });
    if (!response.ok) return null;
    const data = await response.json();
    return data?.data || null;
}

// --- Execution ---
try {
    if (DIRECTUS_STATIC_TOKEN) {
        antecedente = await findAntecedenteBySlug(slugFromUrl);
    } else {
        throw new Error('No token');
    }
} catch (error) {
    usingFallback = true;
    try {
        const { antecedentesReales } = await import('../../data/antecedentes_completos.js');
        antecedente = antecedentesReales.find((item: any) => generateSlug(item.Titulo) === slugFromUrl);
    } catch (fallbackError) {
        // Silent fail
    }
}

if (!antecedente) return Astro.redirect('/404');
id = antecedente.id.toString();

// --- Prepare Data for UI (Reused from [id]/[slug].astro) ---
const getMainImageUrl = async (): Promise<string> => {
    try {
        const { buscarImagenPorDatos } = await import('../../data/mapeo_imagenes_completo.js');
        const nombreArchivo = buscarImagenPorDatos(antecedente.Cliente, antecedente.Area, antecedente.Titulo, id);
        if (nombreArchivo) return `/imagenes_antecedentes_versionproduccion/${nombreArchivo}`;
    } catch (e) {}

    const imagenesConocidas: Record<string, string> = {
        '11125': 'ultimamilla_procon_srl_-_sdi_20250416_083646_s3451025673.png',
        '10770': 'ultimamilla_telecombtw_sa_-_redes_y_comunicaciones_20250415_201308_s4071923973.png',
        '1': 'ultimamilla_municipalidad_de_maipú_-_software_servicios_20250415_182056_s1379068004.png',
        '2': 'ultimamilla_municipalidad_de_guaymallén_-_redes_y_comunicaciones_redes_y_20250415_182333_s1075915836.png',
        '3': 'ultimamilla_patrulleros_inteligentes_-_redes_y_comunicaciones_20250415_182524_s1196678540.png'
    };
    if (imagenesConocidas[id]) return `/imagenes_antecedentes_versionproduccion/${imagenesConocidas[id]}`;

    if (!usingFallback && (antecedente.Imagen || antecedente.ImagenPrincipal)) {
        return getAssetUrl(antecedente.Imagen || antecedente.ImagenPrincipal);
    }
    return DEFAULT_IMAGE_URL;
};

const mainImageUrl = await getMainImageUrl();

const formatDate = (dateString: string): string => {
    if (!dateString) return 'No especificada';
    try {
        return new Date(dateString).toLocaleDateString('es-ES', { year: 'numeric', month: 'long' });
    } catch { return dateString; }
};

const extractScopeItems = (descripcion: string): string[] => {
    if (!descripcion) return [];
    const sentences = descripcion.split(/[.;]/).filter(s => s.trim().length > 10 && s.trim().length < 150);
    return sentences.slice(0, 5).map(s => s.trim());
};

const scopeItems = extractScopeItems(antecedente.Descripcion || '');

const getRelatedServiceProducts = (area: string) => {
    const serviceId = getServiceIdFromArea(area);
    const servicio = serviciosCompletos[serviceId];

    if (!servicio || !servicio.Productos) {
        return { products: [], servicio: null, serviceId: 101 };
    }

    const products = servicio.Productos.slice(0, 3).map((p: any) => ({
        imagen: p.imagen,
        titulo: p.titulo,
        features: p.features?.slice(0, 2) || []
    }));

    return { products, servicio, serviceId };
};

const { products: relatedProducts, servicio: relatedServicio, serviceId: relatedServiceId } = getRelatedServiceProducts(antecedente.Area || '');

// SEO
const siteUrl = 'https://www.ultimamilla.com.ar';
// Canonical points to THIS clean URL (or prefer ID based? Let's point to ID based to be consistent with sitemap)
const canonicalUrl = `${siteUrl}/antecedentes/${id}/${slugFromUrl}`;
const metaDescription = (antecedente.Descripcion || '').replace(/<[^>]+>/g, '').substring(0, 160) + '...';
---

<LayoutV4
  title={`${antecedente.Titulo} | Caso de Éxito - ULTIMA MILLA`}
  description={metaDescription}
  image={mainImageUrl}
  canonical={canonicalUrl}
>
  <!-- Reuse exact same UI structure -->
  <!-- HERO SECTION -->
  <section class="relative overflow-hidden bg-um-dark">
    <!-- Background Image -->
    <img
      src={mainImageUrl}
      alt={antecedente.Titulo}
      class="absolute inset-0 w-full h-full object-cover opacity-50"
      onerror="this.src='/images/default-background.jpg'"
    />
    <!-- Overlay -->
    <div class="absolute inset-0 bg-gradient-to-t from-um-dark via-um-dark/70 to-um-dark/40"></div>

    <!-- Content -->
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 sm:pt-24 pb-6 sm:pb-10 lg:pb-12">
      <!-- Breadcrumb -->
      <nav class="flex items-center gap-2 text-xs mb-3 sm:mb-4">
        <a href="/" class="text-white/60 hover:text-white/80 font-medium">Inicio</a>
        <span class="text-white/30">/</span>
        <a href="/antecedentes" class="text-white/60 hover:text-white/80 font-medium">Antecedentes</a>
        <span class="text-white/30">/</span>
        <span class="text-white font-medium">{antecedente.Area || 'Proyecto'}</span>
      </nav>

      <!-- Category Badge -->
      <div class="inline-flex items-center gap-1.5 bg-um-primary px-3 py-1.5 rounded-full mb-4 sm:mb-5">
        <svg class="w-3.5 h-3.5 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z"/>
        </svg>
        <span class="text-white text-[10px] font-bold tracking-wider uppercase">{antecedente.Area || 'Proyecto'}</span>
      </div>

      <!-- Title -->
      <h1 class="text-2xl sm:text-3xl lg:text-4xl xl:text-5xl font-extrabold text-white leading-tight max-w-4xl mb-4 sm:mb-5">
        {antecedente.Titulo}
      </h1>

      <!-- Subtitle (from description) -->
      <p class="text-sm sm:text-base lg:text-lg text-white/80 max-w-2xl leading-relaxed mb-5 sm:mb-6">
        {antecedente.Descripcion?.replace(/<[^>]+>/g, '').substring(0, 150)}...
      </p>

      <!-- Meta Info -->
      <div class="flex flex-wrap items-center gap-x-4 gap-y-2 text-xs sm:text-sm">
        <div class="flex items-center gap-2 text-white/80">
          <svg class="w-4 h-4 text-um-primary-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>
          </svg>
          <span>{antecedente.Cliente}</span>
        </div>
        {antecedente.Fecha && (
          <>
            <span class="text-white/30">•</span>
            <div class="flex items-center gap-2 text-white/80">
              <svg class="w-4 h-4 text-um-primary-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"/>
              </svg>
              <span>{formatDate(antecedente.Fecha)}</span>
            </div>
          </>
        )}
        <span class="text-white/30">•</span>
        <div class="flex items-center gap-2 text-white/80">
          <svg class="w-4 h-4 text-um-primary-light" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
          </svg>
          <span>Mendoza, Argentina</span>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTENT SECTION -->
  <section class="px-4 sm:px-6 lg:px-8 py-8 sm:py-12 lg:py-16">
    <div class="max-w-7xl mx-auto flex flex-col lg:flex-row gap-8 lg:gap-12 xl:gap-16">
      <!-- Left Column (Main Content) -->
      <div class="flex-1 flex flex-col gap-8 sm:gap-10 lg:gap-12 order-2 lg:order-1">

        <!-- Description Section -->
        <div class="flex flex-col gap-4 sm:gap-5">
          <div class="flex items-center gap-3">
            <div class="w-1 h-5 sm:h-6 bg-um-primary rounded-sm"></div>
            <h2 class="text-lg sm:text-xl lg:text-[22px] font-bold text-gray-900">Descripción del Proyecto</h2>
          </div>
          <div class="text-gray-600 leading-relaxed text-sm sm:text-base prose prose-lg max-w-none">
            <div set:html={antecedente.Descripcion || antecedente.descripcion || '<p>Información detallada del proyecto no disponible.</p>'} />
          </div>

          <!-- Callout Box -->
          <div class="flex items-start sm:items-center gap-3 bg-um-primary-bg px-4 sm:px-5 py-3 sm:py-4 rounded-r-lg border-l-4 border-um-primary">
            <span class="text-base sm:text-lg flex-shrink-0">💡</span>
            <span class="text-um-primary text-[10px] sm:text-xs font-semibold tracking-wide leading-tight uppercase">
              Proyecto de {antecedente.Area || 'tecnología'} para {antecedente.Cliente}
            </span>
          </div>
        </div>

        <!-- Alcance del Proyecto Section -->
        {scopeItems.length > 0 && (
          <div class="flex flex-col gap-4 sm:gap-5">
            <div class="flex items-center gap-3">
              <div class="w-1 h-5 sm:h-6 bg-um-primary rounded-sm"></div>
              <h2 class="text-lg sm:text-xl lg:text-[22px] font-bold text-gray-900">Alcance del Proyecto</h2>
            </div>
            <div class="flex flex-col gap-3 sm:gap-3.5">
              {scopeItems.map((item) => (
                <div class="flex items-start gap-3">
                  <div class="w-5 sm:w-[22px] h-5 sm:h-[22px] rounded-full bg-green-100 flex items-center justify-center flex-shrink-0 mt-0.5">
                    <svg class="w-3 sm:w-3.5 h-3 sm:h-3.5 text-green-600" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                    </svg>
                  </div>
                  <span class="text-gray-700 text-sm sm:text-[15px] font-medium">{item}</span>
                </div>
              ))}
            </div>
          </div>
        )}

        <!-- Tecnología Implementada - Productos Reales del Servicio -->
        {relatedProducts.length > 0 && (
          <div class="flex flex-col gap-4 sm:gap-5">
            <div class="flex items-center gap-3">
              <div class="w-1 h-5 sm:h-6 bg-um-primary rounded-sm"></div>
              <h2 class="text-lg sm:text-xl lg:text-[22px] font-bold text-gray-900">Tecnología Implementada</h2>
            </div>

            <div class="flex flex-col sm:grid sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4">
              {relatedProducts.map((product: any) => (
                <div class="bg-white rounded-xl overflow-hidden shadow-sm border border-gray-100 group hover:shadow-md transition-shadow flex flex-row sm:flex-col">
                  {/* Imagen - izquierda en móvil, arriba en desktop */}
                  <div class="w-24 h-24 sm:w-full sm:h-auto sm:aspect-[4/3] overflow-hidden bg-gray-100 flex-shrink-0">
                    <img
                      src={product.imagen}
                      alt={product.titulo}
                      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                      loading="lazy"
                      onerror="this.src='/images/default-background.jpg'"
                    />
                  </div>
                  {/* Texto - derecha en móvil, abajo en desktop */}
                  <div class="p-3 sm:p-4 flex flex-col justify-center">
                    <h4 class="font-semibold text-gray-900 text-sm mb-1 sm:mb-2 line-clamp-2">{product.titulo}</h4>
                    {product.features.length > 0 && (
                      <ul class="space-y-1">
                        {product.features.slice(0, 1).map((feature: string) => (
                          <li class="flex items-start gap-1.5 text-xs text-gray-600">
                            <svg class="w-3 h-3 text-green-500 flex-shrink-0 mt-0.5" fill="currentColor" viewBox="0 0 20 20">
                              <path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
                            </svg>
                            <span class="line-clamp-1">{feature}</span>
                          </li>
                        ))}
                      </ul>
                    )}
                  </div>
                </div>
              ))}
            </div>
            {relatedServicio && (
              <a
                href={`/servicios/${relatedServiceId}/${generateSlug(relatedServicio.Titulo)}`}
                class="inline-flex items-center gap-2 text-um-primary font-semibold text-sm hover:underline"
              >
                Ver servicio completo: {relatedServicio.Titulo}
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3"/>
                </svg>
              </a>
            )}
          </div>
        )}

        <!-- Gallery -->
        {antecedente.Imagenes && antecedente.Imagenes.length > 0 && (
          <div class="flex flex-col gap-4 sm:gap-5">
            <div class="flex items-center gap-3">
              <div class="w-1 h-5 sm:h-6 bg-purple-600 rounded-sm"></div>
              <h2 class="text-lg sm:text-xl lg:text-[22px] font-bold text-gray-900">Galería del Proyecto</h2>
            </div>
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              {antecedente.Imagenes.map((img: any) => (
                <div class="aspect-video rounded-xl overflow-hidden bg-gray-100 group">
                  <img
                    src={getAssetUrl(img)}
                    alt="Galería"
                    class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                    loading="lazy"
                    onerror="this.src='/images/default-background.jpg'"
                  />
                </div>
              ))}
            </div>
          </div>
        )}
      </div>

      <!-- Sidebar -->
      <div class="w-full lg:w-[320px] xl:w-[360px] flex flex-col gap-4 sm:gap-6 order-1 lg:order-2">

        <!-- Ficha Técnica Card -->
        <div class="bg-white rounded-2xl border border-gray-200 shadow-lg overflow-hidden">
          <div class="flex items-center gap-2.5 px-4 sm:px-5 py-3 sm:py-4 bg-gray-50 border-b border-gray-200">
            <svg class="w-4 sm:w-[18px] h-4 sm:h-[18px] text-um-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
            </svg>
            <span class="text-sm font-bold text-gray-900">Ficha Técnica</span>
          </div>
          <div class="p-4 sm:p-5 flex flex-col gap-3 sm:gap-4">
            <div class="flex flex-col gap-1">
              <span class="text-[10px] font-semibold text-gray-500 tracking-wider uppercase">Organización</span>
              <span class="text-sm sm:text-[15px] font-semibold text-gray-900">{antecedente.Cliente}</span>
            </div>
            <div class="h-px bg-gray-100"></div>
            <div class="flex flex-col gap-1">
              <span class="text-[10px] font-semibold text-gray-500 tracking-wider uppercase">Vertical</span>
              <span class="text-sm sm:text-[15px] font-semibold text-gray-900">{antecedente.Area || 'Tecnología'}</span>
            </div>
            <div class="h-px bg-gray-100"></div>
            <div class="flex flex-col gap-1">
              <span class="text-[10px] font-semibold text-gray-500 tracking-wider uppercase">Unidad de Negocio</span>
              <span class="text-sm sm:text-[15px] font-semibold text-gray-900">{antecedente.Unidad_de_negocio || 'Consultoría'}</span>
            </div>
            <div class="h-px bg-gray-100"></div>
            <div class="flex flex-col gap-1">
              <span class="text-[10px] font-semibold text-gray-500 tracking-wider uppercase">Ubicación</span>
              <span class="text-sm sm:text-[15px] font-semibold text-gray-900">Mendoza, Argentina</span>
            </div>
            {antecedente.Fecha && (
              <>
                <div class="h-px bg-gray-100"></div>
                <div class="flex flex-col gap-1">
                  <span class="text-[10px] font-semibold text-gray-500 tracking-wider uppercase">Finalización</span>
                  <span class="text-sm sm:text-[15px] font-semibold text-gray-900">{formatDate(antecedente.Fecha)}</span>
                </div>
              </>
            )}
            <div class="h-px bg-gray-100"></div>
            <div class="flex flex-col gap-1">
              <span class="text-[10px] font-semibold text-gray-500 tracking-wider uppercase">Código Proyecto</span>
              <span class="text-sm sm:text-[15px] font-semibold text-um-primary font-mono">ANT-{id}</span>
            </div>
          </div>
        </div>

        <!-- CTA Widget -->
        <div class="bg-gradient-to-br from-um-primary to-um-primary-dark rounded-2xl p-5 sm:p-6 flex flex-col items-center gap-3 sm:gap-4">
          <div class="w-12 sm:w-14 h-12 sm:h-14 rounded-full bg-white/20 flex items-center justify-center">
            <svg class="w-6 sm:w-7 h-6 sm:h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
            </svg>
          </div>
          <h3 class="text-base sm:text-lg font-bold text-white text-center">¿Necesita una solución similar?</h3>
          <p class="text-xs sm:text-sm text-white/80 text-center leading-relaxed">
            Contáctenos para una evaluación gratuita de su proyecto
          </p>
          <div class="w-full flex flex-col gap-2 sm:gap-2.5">
            <a href="/contacto" class="flex items-center justify-center gap-2 bg-white text-um-primary font-semibold py-3 sm:py-3.5 px-4 sm:px-5 rounded-lg hover:bg-gray-50 transition-colors min-h-[44px] text-sm sm:text-base">
              <svg class="w-4 sm:w-[18px] h-4 sm:h-[18px]" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>
              </svg>
              Solicitar Cotización
