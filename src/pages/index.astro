      color: #DC2626;
      font-size: 1rem;
      font-weight: 700;
    }

    .um-operating-steps h3 {
      margin: 0;
      font-size: clamp(1.25rem, 1.8vw, 1.8rem);
      line-height: 1.08;
      color: #fff;
      overflow-wrap: normal;
    }

    .um-operating-steps p {
      margin: 0;
      color: rgba(255,255,255,0.68);
      font-size: 1rem;
      line-height: 1.62;
    }

    .um-evidence-section {
      background: #f3f4f2;
      color: #111;
      padding: clamp(70px, 9vw, 120px) 0;
      border-top: 1px solid #d7d7d7;
      border-bottom: 1px solid #d7d7d7;
    }

    .um-evidence-head {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 32px;
      align-items: end;
      margin-bottom: 34px;
      border-top: 2px solid #111;
      padding-top: 28px;
