  <script>
    const bootUm26Hero = () => {
      document.querySelectorAll('[data-um26-hero]').forEach((hero) => {
        const variants = JSON.parse(hero.getAttribute('data-hero-variants') || '[]');
        if (!Array.isArray(variants) || variants.length < 1) return;

        let current = Number(hero.getAttribute('data-hero-index') || 0);
        const image = hero.querySelector('[data-hero-image]');
        const title = hero.querySelector('[data-hero-title]');
        const lead = hero.querySelector('[data-hero-lead]');
        const caption = hero.querySelector('[data-hero-caption]');
        const code = hero.querySelector('[data-hero-code]');
        const fx = hero.querySelector('[data-hero-fx]');
        const button = hero.querySelector('.um26-hero__shuffle');
        const heading = hero.querySelector('#home-title');

        const setText = (node, value) => {
          if (node) node.textContent = value || '';
        };

        const applyVariant = (nextIndex) => {
          current = ((nextIndex % variants.length) + variants.length) % variants.length;
          const variant = variants[current];
          if (!variant) return;

          if (image instanceof HTMLImageElement && !image.src.endsWith(variant.image)) {
            image.style.opacity = '0';
            window.setTimeout(() => {
              image.src = variant.image;
              image.style.opacity = '1';
            }, 120);
          }

          setText(lead, variant.lead);
          setText(caption, variant.caption);
          setText(code, variant.code);
          setText(fx, variant.fx || 'TYPE');
          setText(title, variant.title);
          heading?.classList.remove('is-typing');
        };

        button?.addEventListener('click', () => {
          let next = current;
          while (next === current && variants.length > 1) {
            next = Math.floor(Math.random() * variants.length);
          }
          applyVariant(next);
        });

        window.setTimeout(() => applyVariant(current), 180);
      });
    };

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', bootUm26Hero, { once: true });
    } else {
      bootUm26Hero();
    }
  </script>

