        <!-- CTA a página de sectores -->
        <div class="text-center mt-16">
          <a href="/sector" class="inline-block border-2 border-white text-white hover:bg-white hover:text-gray-900 px-8 py-3 rounded-lg font-semibold transition duration-300">
            Ver todos los sectores →
