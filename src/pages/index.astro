          <!-- Gobierno/Sector Público - ULTRA REFINADO -->
          <a href="/gobiernosectorpublico" class="group relative block overflow-hidden rounded-2xl bg-gradient-to-br from-gray-900 to-gray-800 border border-gray-700/50 transition-all duration-500 hover:border-red-500/50 hover:shadow-2xl hover:shadow-red-500/10">
            <div class="p-8">
              <!-- Indicator -->
              <div class="mb-6 flex items-center gap-3">
                <div class="h-1 w-12 rounded-full bg-gradient-to-r from-red-500 to-rose-500"></div>
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">Sector</span>
              </div>
              
              <!-- Title -->
              <h3 class="text-3xl font-bold text-white mb-3 transition-colors duration-300 group-hover:text-red-400">
                Gobierno
              </h3>
              
              <!-- Description -->
              <p class="text-sm text-gray-400 mb-6 leading-relaxed">
                Soluciones tecnológicas para el sector público
              </p>
              
              <!-- Stats Mini -->
              <div class="flex items-center gap-6 mb-6 pb-6 border-b border-gray-700/50">
                <div>
                  <div class="text-2xl font-bold text-white">30+</div>
