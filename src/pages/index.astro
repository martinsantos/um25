<script is:inline>
  // Animación de entrada para los elementos
  const observerOptions = {
    threshold: 0.1,
    rootMargin: '0px 0px -50px 0px'
  };

  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        entry.target.style.animation = 'fadeInUp 0.6s ease-out forwards';
      }
    });
  }, observerOptions);

  // Observar elementos cuando se carga la página
  document.addEventListener('DOMContentLoaded', () => {
    const elements = document.querySelectorAll('.cli-suggestions, #um-cli-container');
    elements.forEach(el => observer.observe(el));
  });
  
  // Script del terminal del hero
  const heroTerminalSequence = [
    { text: 'ULTIMA MILLA@cli:~$ ', delay: 0, class: 'terminal-prompt' },
    { text: 'sudo ultimamilla.py --explore', delay: 100, class: 'terminal-command' },
    { text: '', delay: 800, class: 'terminal-output' },
    { text: '🔒 Inicializando exploración empresarial...', delay: 600, class: 'terminal-output' },
    { text: '✓ 22 años de historia cargados', delay: 800, class: 'terminal-success' },
    { text: '', delay: 400, class: 'terminal-output' },
    { text: '📊 Cargando 469+ proyectos...', delay: 600, class: 'terminal-output' },
    { text: '✓ Base de datos empresarial sincronizada', delay: 800, class: 'terminal-success' },
    { text: '', delay: 400, class: 'terminal-output' },
    { text: '🚀 TERMINAL UM CLI LISTO - Explora interactivamente!', delay: 1000, class: 'terminal-result' },
  ];
  
  let heroCurrentLine = 0;
  let heroCurrentChar = 0;
  const heroTerminalOutput = document.getElementById('terminalOutput');
  
  function typeHeroTerminalSequence() {
    if (heroCurrentLine >= heroTerminalSequence.length) {
      // Reiniciar después de 8 segundos
      setTimeout(() => {
        heroTerminalOutput.innerHTML = '';
        heroCurrentLine = 0;
        heroCurrentChar = 0;
        typeHeroTerminalSequence();
      }, 8000);
      return;
    }
    
    const currentSequence = heroTerminalSequence[heroCurrentLine];
    const currentText = currentSequence.text;
    
    if (heroCurrentChar <= currentText.length) {
      const displayText = currentText.substring(0, heroCurrentChar);
      
      let currentLineElement = document.getElementById(`hero-terminal-line-${heroCurrentLine}`);
      if (!currentLineElement) {
        currentLineElement = document.createElement('div');
        currentLineElement.id = `hero-terminal-line-${heroCurrentLine}`;
        currentLineElement.className = `terminal-line ${currentSequence.class}`;
        heroTerminalOutput.appendChild(currentLineElement);
      }
      
      if (heroCurrentChar < currentText.length) {
        currentLineElement.innerHTML = displayText + '<span class="terminal-cursor">█</span>';
      } else {
        currentLineElement.innerHTML = displayText;
      }
      
      heroCurrentChar++;
      setTimeout(typeHeroTerminalSequence, currentSequence.delay || 80);
    } else {
      heroCurrentLine++;
      heroCurrentChar = 0;
      setTimeout(typeHeroTerminalSequence, heroTerminalSequence[heroCurrentLine-1]?.delay || 300);
    }
  }
  
  // Iniciar la secuencia del hero
  document.addEventListener('DOMContentLoaded', () => {
    setTimeout(typeHeroTerminalSequence, 1000);
    
    // Configurar imagen de fondo aleatoria para el hero
    const techImages = [
      'https://images.unsplash.com/photo-1518709268805-4e9042af2176?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80',
      'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80',
      'https://images.unsplash.com/photo-1451187580459-43490279c0fa?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80',
      'https://images.unsplash.com/photo-1550751827-4bd374c3f58b?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80'
    ];
    
    const banner = document.getElementById('banner');
    const heroBackground = banner?.querySelector('.hero-background');
    
    function changeHeroBackground() {
      if (heroBackground) {
        const randomImage = techImages[Math.floor(Math.random() * techImages.length)];
        heroBackground.style.backgroundImage = `url(${randomImage})`;
      }
    }
    
    changeHeroBackground();
    setInterval(changeHeroBackground, 15000); // Cambiar cada 15 segundos
  });
  
</script>

