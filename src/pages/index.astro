---
/**
 * ULTIMA MILLA — Homepage
 * Reset from scratch. Clean, verified, no legacy.
 */
import LayoutV4 from '../layouts/LayoutV4.astro';
import { generateSlug } from '../utils/slugUtils.js';
import { getAllServicios } from '../utils/directusHelpers';
import { getDirectusImageUrl, getAllAntecedentes, withBase } from '../lib/directus.ts';
import { serviceBadgeMap, serviceToSectorMap } from '../data/serviceBadgeMap';
import { getSectorColors } from '../data/colorSystem';

// --- DATA ---
let antecedentes: any[] = [];
try { antecedentes = (await getAllAntecedentes()).slice(0, 6); } catch {}
const cases = antecedentes.map(a => ({
  ...a,
  slug: generateSlug(a.Titulo || 'proyecto'),
  img: getDirectusImageUrl(a.Imagen) || withBase('/images/default-background.jpg')
}));

const allServices = await getAllServicios();
const services = allServices.slice(0, 8).map((s, i) => ({
  id: s.id,
  title: s.Titulo?.split('|')[0]?.trim() || s.Titulo,
  slug: s.slug || generateSlug(s.Titulo),
  desc: (s.Descripcion || '').replace(/<[^>]+>/g, '').substring(0, 100),
  num: String(i + 1).padStart(2, '0'),
}));

const sectors = [
  { slug: 'aeropuertos', name: 'Aeropuertos' },
  { slug: 'bodegas', name: 'Bodegas' },
  { slug: 'constructoras', name: 'Construcción' },
  { slug: 'salud', name: 'Salud' },
  { slug: 'gobiernosectorpublico', name: 'Gobierno' },
  { slug: 'software', name: 'Software' },
  { slug: 'mineria', name: 'Minería' },
  { slug: 'industria', name: 'Industria' },
  { slug: 'seguridad-electronica', name: 'Seguridad' },
];

// Unsplash professional photos — reliable CDN, landscape, high quality
const photos = {
  hero: 'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?w=1920&h=1080&fit=crop&q=80',
  services: 'https://images.unsplash.com/photo-1544197150-b99a580bb7a8?w=1600&h=700&fit=crop&q=80',
  cases: 'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?w=1600&h=700&fit=crop&q=80',
  cta: 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?w=1600&h=900&fit=crop&q=80',
};

const schema = { "@type": "WebSite", "name": "ULTIMA MILLA", "url": "https://ultimamilla.com.ar" };
---

<LayoutV4
  title="ULTIMA MILLA — Infraestructura IT | Mendoza, Cuyo y Patagonia"
  description="469+ proyectos de infraestructura IT, seguridad electrónica y desarrollo de software."
  image="/nosotros-tech.jpg"
  structuredData={schema}
>

<!-- ╔══════════════════════════════════════════════════════════════╗
     ║  HERO                                                       ║
     ╚══════════════════════════════════════════════════════════════╝ -->
<section class="relative min-h-[92vh] flex items-center">
  <img src={photos.hero} alt="" class="absolute inset-0 w-full h-full object-cover" />
  <div class="absolute inset-0 bg-gradient-to-b from-black/60 via-black/40 to-black/70"></div>

  <div class="relative w-full max-w-5xl mx-auto px-6 sm:px-8 py-24 sm:py-32 lg:py-36">
    <p class="text-[11px] font-mono text-white/40 tracking-widest uppercase mb-8">
      <span class="inline-block w-2 h-2 rounded-full bg-emerald-400 mr-2 align-middle" style="animation:um-dot 2s ease-in-out infinite;"></span>
      Mendoza, Argentina — Est. 2002
    </p>

    <h1 class="um-h text-[2rem] sm:text-[2.75rem] md:text-[3.5rem] lg:text-[4.25rem] text-white leading-[1.05] tracking-tight mb-6">
      La infraestructura que mueve a las empresas argentinas<span class="text-red-500">.</span><span class="um-cursor"></span>
    </h1>

    <p class="text-white/50 text-[15px] sm:text-base max-w-md leading-relaxed mb-10">
      Telecomunicaciones, seguridad electrónica, desarrollo de software y soporte 24/7.
    </p>

    <div class="flex flex-wrap gap-3 mb-16">
      <a href={withBase("/contacto")} class="px-6 py-3 bg-white text-gray-900 font-semibold rounded-xl hover:bg-red-600 hover:text-white transition-all text-sm inline-flex items-center gap-2">
        Solicitar consultoría
        <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
      </a>
      <a href={withBase("/antecedentes")} class="px-6 py-3 border border-white/20 text-white/60 rounded-xl hover:border-white/40 hover:text-white transition-all text-sm">
        Ver proyectos
      </a>
    </div>

    <div class="flex gap-10 pt-6 border-t border-white/10">
      <div><span class="text-2xl font-bold text-white font-mono">469+</span><span class="text-[9px] font-mono text-white/30 uppercase tracking-wider ml-2">proyectos</span></div>
      <div><span class="text-2xl font-bold text-white font-mono">22</span><span class="text-[9px] font-mono text-white/30 uppercase tracking-wider ml-2">años</span></div>
      <div><span class="text-2xl font-bold text-white font-mono">9</span><span class="text-[9px] font-mono text-white/30 uppercase tracking-wider ml-2">industrias</span></div>
      <div><span class="text-2xl font-bold text-red-500 font-mono">24/7</span><span class="text-[9px] font-mono text-white/30 uppercase tracking-wider ml-2">soporte</span></div>
    </div>
  </div>
</section>

<!-- ╔══════════════════════════════════════════════════════════════╗
     ║  SERVICES                                                   ║
     ╚══════════════════════════════════════════════════════════════╝ -->
<section>
  <!-- Banner -->
  <div class="relative h-60 sm:h-72">
    <img src={photos.services} alt="" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="relative h-full max-w-5xl mx-auto px-6 sm:px-8 flex items-end pb-8">
      <div>
        <p class="text-[10px] font-mono uppercase tracking-[0.25em] text-red-400 mb-1">Servicios</p>
        <h2 class="um-h text-2xl sm:text-3xl lg:text-4xl text-white tracking-tight">
          Ocho disciplinas, una misión<span class="text-red-500">.</span>
        </h2>
      </div>
    </div>
  </div>

  <!-- Grid -->
  <div class="bg-white py-12 sm:py-16">
    <div class="max-w-5xl mx-auto px-6 sm:px-8">
      <div class="flex justify-end mb-8">
        <a href={withBase("/servicios")} class="text-[11px] font-semibold text-gray-400 hover:text-red-600 transition-colors uppercase tracking-widest">Catálogo completo →</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-gray-100 rounded-2xl overflow-hidden">
        {services.map((s) => (
          <a href={withBase(`/servicios/${s.id}/${s.slug}`)} class="group bg-white p-6 hover:bg-gray-50 transition-colors">
            <span class="text-3xl font-bold text-gray-100 block mb-3 group-hover:text-red-100 transition-colors" style="font-family:'Futura PT',sans-serif;">{s.num}</span>
            <h3 class="um-h text-sm font-bold text-gray-900 group-hover:text-red-600 transition-colors leading-snug mb-2">{s.title}</h3>
            <p class="text-xs text-gray-400 leading-relaxed">{s.desc}…</p>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ╔══════════════════════════════════════════════════════════════╗
     ║  CASES                                                      ║
     ╚══════════════════════════════════════════════════════════════╝ -->
<section>
  <div class="relative h-60 sm:h-72">
    <img src={photos.cases} alt="" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/50"></div>
    <div class="relative h-full max-w-5xl mx-auto px-6 sm:px-8 flex items-end pb-8">
      <div>
        <p class="text-[10px] font-mono uppercase tracking-[0.25em] text-red-400 mb-1">Antecedentes</p>
        <h2 class="um-h text-2xl sm:text-3xl lg:text-4xl text-white tracking-tight">
          469 proyectos entregados<span class="text-red-500">.</span>
        </h2>
      </div>
    </div>
  </div>

  <div class="bg-gray-50 py-12 sm:py-16">
    <div class="max-w-5xl mx-auto px-6 sm:px-8">
      <div class="flex justify-end mb-8">
        <a href={withBase("/antecedentes")} class="text-[11px] font-semibold text-gray-400 hover:text-red-600 transition-colors uppercase tracking-widest">Explorar todos →</a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 gap-3 sm:gap-4">
        {cases.slice(0, 6).map((c) => (
          <a href={withBase(`/antecedentes/${c.id}/${c.slug}`)} class="group relative rounded-xl overflow-hidden aspect-square bg-gray-200">
            <img src={c.img} alt={c.Titulo} class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-500" loading="lazy" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-transparent to-transparent"></div>
            <div class="absolute bottom-0 left-0 right-0 p-3 sm:p-4">
              <p class="text-[8px] font-mono uppercase tracking-widest text-red-400">{c.Area}</p>
              <h3 class="text-xs sm:text-sm font-bold text-white leading-snug mt-0.5 line-clamp-2">{c.Titulo}</h3>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>

<!-- ╔══════════════════════════════════════════════════════════════╗
     ║  INDUSTRIES                                                 ║
     ╚══════════════════════════════════════════════════════════════╝ -->
<section class="py-16 sm:py-20 bg-white">
  <div class="max-w-5xl mx-auto px-6 sm:px-8">
    <p class="text-[10px] font-mono uppercase tracking-[0.25em] text-red-600 mb-2">Industrias</p>
    <h2 class="um-h text-2xl sm:text-3xl lg:text-4xl text-gray-900 tracking-tight mb-10">
      9 verticales, un solo equipo<span class="text-red-600">.</span>
    </h2>

    <div class="flex flex-wrap gap-2">
      {sectors.map((s) => (
        <a href={withBase(`/${s.slug}`)} class="group px-5 py-3 border border-gray-200 rounded-xl text-sm font-semibold text-gray-700 hover:bg-gray-900 hover:text-white hover:border-gray-900 transition-all duration-200">
          {s.name}
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ╔══════════════════════════════════════════════════════════════╗
     ║  CTA                                                        ║
     ╚══════════════════════════════════════════════════════════════╝ -->
<section class="relative py-20 sm:py-28">
  <img src={photos.cta} alt="" class="absolute inset-0 w-full h-full object-cover" />
  <div class="absolute inset-0 bg-black/65"></div>
  <div class="relative max-w-3xl mx-auto px-6 sm:px-8 text-center">
    <h2 class="um-h text-2xl sm:text-3xl lg:text-4xl text-white tracking-tight mb-5">
      El próximo proyecto exitoso puede ser el suyo<span class="text-red-500">.</span>
    </h2>
    <p class="text-white/40 text-sm mb-8">Más de 200 organizaciones ya confían en nosotros.</p>
    <div class="flex flex-wrap gap-3 justify-center mb-12">
      <a href={withBase("/contacto")} class="px-7 py-3 bg-red-600 text-white font-semibold rounded-xl hover:bg-red-500 transition-colors text-sm">Agendar consultoría</a>
      <a href="mailto:contacto@ultimamilla.com.ar" class="px-7 py-3 border border-white/20 text-white/50 rounded-xl hover:text-white hover:border-white/40 transition-all text-sm">contacto@ultimamilla.com.ar</a>
    </div>
    <p class="text-[10px] font-mono text-white/20 uppercase tracking-widest">
      Aeropuertos Argentina 2000 · Gobierno de Mendoza · Hospital Central · Bodega La Esmeralda
    </p>
  </div>
</section>

<style>
  .um-h { font-family: 'Futura PT', 'Futura', 'Trebuchet MS', sans-serif; font-weight: 700; }
  .um-cursor::after { content: '▎'; color: #ef4444; animation: um-blink 0.8s steps(1) infinite; }
  @keyframes um-blink { 0%,49%{opacity:1} 50%,100%{opacity:0} }
  @keyframes um-dot { 0%,100%{opacity:1} 50%{opacity:0.3} }
  .line-clamp-2 { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; }
</style>
</LayoutV4>
