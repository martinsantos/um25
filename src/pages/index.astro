---
/**
 * Homepage V4 Design System
 * Main landing page with hero, services, cases, industries, and CTA
 */

import LayoutV4 from '../layouts/LayoutV4.astro';
import ServiceCard from '../components/v4/ServiceCard.astro';
import CTASection from '../components/v4/CTASection.astro';
import { generateSlug } from '../utils/slugUtils.js';
import { getAllServicios } from '../utils/directusHelpers';
import { getDirectusImageUrl, getAllAntecedentes, getHeroHomeImages, withBase } from '../lib/directus.ts';
import { serviceBadgeMap, serviceToSectorMap } from '../data/serviceBadgeMap';
import { getSectorColors } from '../data/colorSystem';

// Hero images — use local service images (works on both production and GitHub Pages)
const heroImages = [
  { url: withBase('/images/services/servicio-101-infraestructura.jpg'), alt: 'Infraestructura de Redes' },
  { url: withBase('/images/services/servicio-102-seguridad.jpg'), alt: 'Seguridad Electrónica' },
  { url: withBase('/images/services/servicio-103-telecomunicaciones.jpg'), alt: 'Telecomunicaciones' },
  { url: withBase('/images/services/servicio-104-software.jpg'), alt: 'Desarrollo de Software' },
  { url: withBase('/images/services/servicio-106-consultoria.jpg'), alt: 'Consultoría IT' },
];

// Get 3 featured antecedentes from Directus (con fallback a snapshot JSON)
let antecedentesData: any[] = [];
try {
  antecedentesData = await getAllAntecedentes();
} catch {
  antecedentesData = [];
}

const antecedentesEnhanced = antecedentesData.slice(0, 3).map((ant: any) => ({
  ...ant,
  slug: generateSlug(ant.Titulo || ant.Nombre || 'proyecto'),
  imageUrl: getDirectusImageUrl(ant.Imagen) || '/images/default-background.jpg'
}));

// Get services from Directus (with automatic fallback to JS data)
const serviciosFromDirectus = await getAllServicios();

// Map icon names for ServiceCard component
const iconMap: Record<number, { icon: string; iconColor: string }> = {
  101: { icon: 'network', iconColor: 'bg-sky-600/90' },
  102: { icon: 'shield', iconColor: 'bg-rose-600/90' },
  103: { icon: 'radio', iconColor: 'bg-cyan-600/90' },
  104: { icon: 'code', iconColor: 'bg-purple-600/90' },
  105: { icon: 'headphones', iconColor: 'bg-amber-600/90' },
  106: { icon: 'lightbulb', iconColor: 'bg-emerald-600/90' },
  107: { icon: 'flame', iconColor: 'bg-orange-600/90' },
  108: { icon: 'zap', iconColor: 'bg-yellow-600/90' }
};

// Enhance services with badges, colors, icons - ALL from Directus
const servicios = serviciosFromDirectus.slice(0, 8).map(s => {
  const sector = serviceToSectorMap[s.id] || 'tecnologia';
  const colors = getSectorColors(sector);

  return {
    ...s,
    ...iconMap[s.id],
    slug: s.slug || generateSlug(s.Titulo),
    badge: serviceBadgeMap[s.id] || 'Tecnología',
    badgeColor: colors.icon
  };
});

// Industries/Sectors data with pseudomorphic emojis
// WebSite schema with SearchAction for sitelinks search box
const websiteSchema = {
  "@type": "WebSite",
  "name": "ULTIMA MILLA",
  "url": "https://ultimamilla.com.ar",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://ultimamilla.com.ar/antecedentes?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

const sectores = [
  { slug: 'aeropuertos', name: 'Aeropuertos', emoji: '✈️', color: '#0ea5e9' },
  { slug: 'bodegas', name: 'Bodegas', emoji: '🍷', color: '#a855f7' },
  { slug: 'constructoras', name: 'Construcción', emoji: '🏗️', color: '#f59e0b' },
  { slug: 'salud', name: 'Salud', emoji: '🏥', color: '#22c55e' },
  { slug: 'gobiernosectorpublico', name: 'Gobierno', emoji: '🏛️', color: '#10b981' },
  { slug: 'software', name: 'Software', emoji: '💻', color: '#6366f1' },
  { slug: 'mineria', name: 'Minería', emoji: '⛏️', color: '#f97316' },
  { slug: 'industria', name: 'Industria', emoji: '🏭', color: '#64748b' },
  { slug: 'seguridad-electronica', name: 'Seguridad', icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z', color: '#06b6d4' }
];

// SVG icon paths for sectors
const sectorIcons: Record<string, string> = {
  'aeropuertos': 'M12 19l9 2-9-18-9 18 9-2zm0 0v-8',
  'bodegas': 'M9 12h6m-3-3v6m-7 4h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
  'constructoras': 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  'salud': 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
  'gobiernosectorpublico': 'M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z',
  'software': 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  'mineria': 'M20.618 5.984A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  'industria': 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
  'seguridad-electronica': 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
};
---

<LayoutV4
  title="ULTIMA MILLA — Infraestructura IT, Seguridad y Software | Mendoza"
  description="469+ proyectos de infraestructura IT, seguridad electrónica y desarrollo de software para empresas en Mendoza, Cuyo y Patagonia. 22 años de experiencia."
  keywords="infraestructura IT mendoza, seguridad electronica, software a medida, telecomunicaciones"
  image="/nosotros-tech.jpg"
  structuredData={websiteSchema}
>

  <!-- ════════════════════════════════════════════ -->
  <!-- HERO — Brutalist Editorial: White bg, giant type, mega photo -->
  <!-- ════════════════════════════════════════════ -->
  <section class="bg-white pt-6 sm:pt-10 lg:pt-14">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Eyebrow -->
      <div class="flex items-center gap-3 mb-6 sm:mb-8">
        <span class="w-12 h-[2px] bg-red-600"></span>
        <span class="text-xs font-mono uppercase tracking-[0.25em] text-gray-400">Desde 2002 — Mendoza, Cuyo, Patagonia</span>
      </div>

      <!-- Giant headline -->
      <h1 class="text-[2.5rem] sm:text-6xl md:text-7xl lg:text-8xl xl:text-[7rem] font-black text-gray-900 leading-[0.95] tracking-tight mb-8 sm:mb-10 text-balance" style="letter-spacing: -0.03em;">
        Infraestructura IT<br>para empresas que<br>no se conforman<span class="text-red-600">.</span>
      </h1>

      <!-- Sub + CTA inline -->
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-6 mb-8 sm:mb-12">
        <p class="text-base sm:text-lg text-gray-500 max-w-md leading-relaxed">
          Telecomunicaciones, seguridad electrónica, desarrollo de software y soporte 24/7.
        </p>
        <a href={withBase("/contacto")} class="inline-flex items-center gap-3 px-8 py-4 bg-gray-900 text-white font-bold rounded-2xl hover:bg-red-600 transition-colors min-h-[52px] shrink-0">
          Consultoría Gratuita
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
        </a>
      </div>

      <!-- Stats bar: monumental numbers, horizontal, separated by lines -->
      <div class="flex border-t-[3px] border-gray-900 scroll-reveal">
        <div class="flex-1 py-5 sm:py-6 border-r border-gray-200 pr-4">
          <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-gray-900 scroll-counter">469</div>
          <div class="text-[10px] sm:text-xs font-mono uppercase tracking-[0.2em] text-gray-400 mt-1">Proyectos</div>
        </div>
        <div class="flex-1 py-5 sm:py-6 border-r border-gray-200 px-4">
          <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-gray-900 scroll-counter" style="animation-delay:0.1s">22</div>
          <div class="text-[10px] sm:text-xs font-mono uppercase tracking-[0.2em] text-gray-400 mt-1">Años</div>
        </div>
        <div class="flex-1 py-5 sm:py-6 border-r border-gray-200 px-4">
          <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-gray-900 scroll-counter" style="animation-delay:0.2s">9</div>
          <div class="text-[10px] sm:text-xs font-mono uppercase tracking-[0.2em] text-gray-400 mt-1">Industrias</div>
        </div>
        <div class="flex-1 py-5 sm:py-6 pl-4">
          <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-red-600 scroll-counter" style="animation-delay:0.3s">24/7</div>
          <div class="text-[10px] sm:text-xs font-mono uppercase tracking-[0.2em] text-gray-400 mt-1">Soporte</div>
        </div>
      </div>
    </div>

    <!-- MEGA PHOTO: Full-width, rounded, project image -->
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 mt-8 sm:mt-12">
      <div class="relative rounded-3xl overflow-hidden aspect-[21/9] bg-gray-100" id="heroImageContainer">
        {heroImages.map((img, index) => (
          <img src={img.url} alt={img.alt}
            class={`hero-image absolute inset-0 w-full h-full object-cover transition-opacity duration-[2000ms] ${index === 0 ? 'opacity-100' : 'opacity-0'}`}
            data-index={index} />
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════ -->
  <!-- SERVICES — Numbered, with large photos -->
  <!-- ════════════════════════════════════════════ -->
  <section class="py-16 sm:py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-4 scroll-reveal">
        <span class="w-12 h-[2px] bg-red-600"></span>
        <span class="text-xs font-mono uppercase tracking-[0.25em] text-gray-400">Servicios</span>
      </div>
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 mb-12 lg:mb-16">
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-gray-900 tracking-tight text-balance" style="letter-spacing: -0.02em;">
          8 áreas de expertise<span class="text-red-600">.</span>
        </h2>
        <a href={withBase("/servicios")} class="text-sm font-bold text-gray-900 hover:text-red-600 transition-colors flex items-center gap-2 uppercase tracking-wider">
          Ver todos
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-6 gap-y-10">
        {servicios.map((servicio, i) => (
          <div class="scroll-reveal" style={`animation-delay: ${i * 0.06}s`}>
            <ServiceCard
              id={servicio.id}
              slug={servicio.slug}
              titulo={servicio.Titulo}
              descripcion={servicio.Descripcion}
              imagen={servicio.Imagen}
              badge={servicio.badge}
              cliente={servicio.Cliente}
              icon={servicio.icon}
              index={i}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════ -->
  <!-- CASES — 1 mega photo + 2 large photos -->
  <!-- ════════════════════════════════════════════ -->
  <section class="py-16 sm:py-20 lg:py-28 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-4 scroll-reveal">
        <span class="w-12 h-[2px] bg-red-600"></span>
        <span class="text-xs font-mono uppercase tracking-[0.25em] text-gray-400">Casos de éxito</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-gray-900 tracking-tight mb-12 lg:mb-16 text-balance scroll-reveal" style="letter-spacing: -0.02em;">
        Proyectos que hablan<br>por sí solos<span class="text-red-600">.</span>
      </h2>

      {antecedentesEnhanced.length > 0 && (
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 lg:gap-6">
          <!-- Hero case: mega photo -->
          <a href={withBase(`/antecedentes/${antecedentesEnhanced[0].id}/${antecedentesEnhanced[0].slug}`)}
            class="group relative rounded-3xl overflow-hidden min-h-[350px] lg:min-h-[480px] flex items-end scroll-reveal bg-gray-200">
            <img src={antecedentesEnhanced[0].imageUrl} alt={antecedentesEnhanced[0].Titulo}
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-transparent"></div>
            <div class="relative p-6 sm:p-8 lg:p-10">
              <span class="inline-block px-3 py-1 bg-red-600 text-white text-[10px] font-black rounded-lg mb-3 uppercase tracking-wider">
                {antecedentesEnhanced[0].Area || 'Proyecto'}
              </span>
              <h3 class="text-xl sm:text-2xl lg:text-3xl font-black text-white leading-tight text-balance">{antecedentesEnhanced[0].Titulo}</h3>
              <p class="text-sm text-white/70 mt-2">{antecedentesEnhanced[0].Cliente}</p>
            </div>
          </a>

          <!-- Side cases: 2 stacked photos -->
          <div class="grid grid-cols-1 gap-5 lg:gap-6">
            {antecedentesEnhanced.slice(1, 3).map((ant, i) => (
              <a href={withBase(`/antecedentes/${ant.id}/${ant.slug}`)}
                class="group relative rounded-2xl overflow-hidden min-h-[200px] lg:min-h-[230px] flex items-end scroll-reveal bg-gray-200"
                style={`animation-delay: ${(i+1)*0.15}s`}>
                <img src={ant.imageUrl} alt={ant.Titulo}
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/5 to-transparent"></div>
                <div class="relative p-5 sm:p-6">
                  <span class="text-[10px] font-black text-red-400 uppercase tracking-wider">{ant.Area || ant.Cliente}</span>
                  <h3 class="text-lg sm:text-xl font-black text-white mt-1 text-balance">{ant.Titulo}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="mt-10 sm:mt-14 flex justify-center scroll-reveal">
        <a href={withBase("/antecedentes")} class="inline-flex items-center gap-3 px-8 py-4 bg-gray-900 text-white font-bold rounded-2xl hover:bg-red-600 transition-colors text-sm uppercase tracking-wider">
          Ver los 469+ proyectos
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════ -->
  <!-- INDUSTRIES — Tags/chips, editorial style -->
  <!-- ════════════════════════════════════════════ -->
  <section class="py-16 sm:py-20 lg:py-28 bg-white border-t border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-4 scroll-reveal">
        <span class="w-12 h-[2px] bg-red-600"></span>
        <span class="text-xs font-mono uppercase tracking-[0.25em] text-gray-400">Industrias</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-gray-900 tracking-tight mb-12 lg:mb-16 text-balance scroll-reveal" style="letter-spacing: -0.02em;">
        9 verticales<span class="text-red-600">,</span><br>un solo equipo<span class="text-red-600">.</span>
      </h2>

      <div class="flex flex-wrap gap-3 sm:gap-4 scroll-reveal">
        {sectores.map((sector, i) => (
          <a href={withBase(`/${sector.slug}`)}
            class="group flex items-center gap-3 px-5 sm:px-6 py-3 sm:py-4 border-2 border-gray-200 rounded-2xl hover:border-gray-900 hover:bg-gray-900 hover:text-white transition-all duration-300 scroll-reveal-scale"
            style={`animation-delay: ${i * 0.04}s`}>
            <svg class="w-5 h-5 text-gray-400 group-hover:text-white transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" d={sectorIcons[sector.slug] || 'M13 10V3L4 14h7v7l9-11h-7z'}/>
            </svg>
            <span class="font-bold text-sm sm:text-base text-gray-900 group-hover:text-white transition-colors">{sector.name}</span>
          </a>
        ))}
      </div>

      <div class="mt-8 scroll-reveal">
        <a href={withBase("/sectores")} class="text-sm font-bold text-gray-400 hover:text-red-600 transition-colors flex items-center gap-2 uppercase tracking-wider">
          Ver todas las industrias
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════ -->
  <!-- CTA — Dark, minimal, with social proof -->
  <!-- ════════════════════════════════════════════ -->
  <section class="bg-gray-900 py-20 sm:py-24 lg:py-32 scroll-reveal">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-black text-white tracking-tight mb-6 text-balance" style="letter-spacing: -0.02em;">
        El próximo proyecto<br>exitoso puede ser<br>el suyo<span class="text-red-600">.</span>
      </h2>
      <p class="text-gray-400 text-base sm:text-lg mb-10 max-w-xl mx-auto">
        Más de 200 organizaciones ya confían en nosotros.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center mb-14">
        <a href={withBase("/contacto")} class="px-10 py-4 bg-white text-gray-900 font-bold rounded-2xl hover:bg-red-600 hover:text-white transition-all min-h-[52px] flex items-center justify-center text-base">
          Agendar Consultoría
        </a>
        <a href="mailto:contacto@ultimamilla.com.ar" class="px-10 py-4 border-2 border-gray-700 text-gray-300 font-bold rounded-2xl hover:border-white hover:text-white transition-all min-h-[52px] flex items-center justify-center text-base">
          contacto@ultimamilla.com.ar
        </a>
      </div>

      <div class="border-t border-gray-800 pt-8">
        <p class="text-xs font-mono uppercase tracking-[0.3em] text-gray-600 mb-5">Confían en nosotros</p>
        <div class="flex flex-wrap justify-center gap-x-6 gap-y-2 text-sm text-gray-500 font-medium">
          <span>Aeropuertos Argentina 2000</span>
          <span>Gobierno de Mendoza</span>
          <span>Hospital Central</span>
          <span>Bodega La Esmeralda</span>
          <span>Premix SA</span>
          <span>Municipalidad de Guaymallén</span>
        </div>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const images = document.querySelectorAll('.hero-image');
      if (images.length > 1) {
        let c = 0;
        setInterval(() => {
          images[c].classList.remove('opacity-100');
          images[c].classList.add('opacity-0');
          c = (c + 1) % images.length;
          images[c].classList.remove('opacity-0');
          images[c].classList.add('opacity-100');
        }, 5000);
      }
    });
  </script>
</LayoutV4>
