    .um-final-cta .um-home-container {
      justify-content: space-between;
      gap: 32px;
    }

    .um-final-cta p {
      margin: 0 0 10px;
      color: #DC2626;
      font-size: 1rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .um-final-cta h2 {
      max-width: 820px;
      margin: 0;
      font-family: var(--um-font-display);
      font-size: clamp(2rem, 3.4vw, 3.4rem);
      line-height: 1;
      color: #050505;
    }

    @media (max-width: 1024px) {
      .um-evidence-head,
      .um-evidence-stage,
      .um-operating-grid,
      .um-evidence-grid {
        grid-template-columns: 1fr;
      }

      .um-evidence-head {
        align-items: start;
      }

      .um-evidence-head a {
        justify-self: start;
      }

      .um-hero-proof {
        grid-template-columns: repeat(3, minmax(0, 1fr));
      }

      .um-service-matrix {
        grid-template-columns: 1fr;
      }

      .um-section-heading {
        grid-template-columns: 1fr;
        align-items: start;
      }

      .um-hero-content {
        grid-template-columns: 1fr;
        align-items: start;
      }

      .um-operating-grid > div:first-child {
        position: static;
      }
    }

    @media (max-width: 760px) {
      .um-home-container {
        width: min(100% - 32px, 1180px);
      }

      .um-home-hero {
        min-height: auto;
      }

      .um-home-hero::before {
        background: linear-gradient(180deg, rgba(0,0,0,0.86) 0%, rgba(0,0,0,0.9) 100%);
      }

      .um-hero-content {
        min-height: auto;
        padding: 64px 0 44px;
      }

      .um-hero-content,
      .um-hero-copy,
      .um-hero-board {
        min-width: 0;
      }

      .um-hero-copy h1 {
        max-width: 100%;
        font-size: clamp(2.15rem, 10.6vw, 3rem);
        line-height: 1.06;
        overflow-wrap: anywhere;
      }

      .um-hero-copy p {
        max-width: 100%;
        font-size: 1rem;
        line-height: 1.55;
        overflow-wrap: anywhere;
      }

      .um-hero-actions {
        align-items: stretch;
      }

      .um-btn {
        width: 100%;
      }

      .um-hero-board {
        margin-top: 8px;
      }

      .um-hero-proof,
      .um-operating-steps article,
      .um-evidence-stage__copy dl {
        grid-template-columns: 1fr;
      }

      .um-hero-proof div {
        min-height: auto;
        padding: 18px 20px;
        border-right: 0;
        border-bottom: 1px solid rgba(255,255,255,0.12);
      }

      .um-hero-proof div:last-child {
        border-bottom: 0;
      }

      .um-operating-steps article {
        gap: 10px;
      }

      .um-connected-grid,
      .um-service-matrix,
      .um-sector-list {
        grid-template-columns: 1fr;
      }

      .um-service-module {
        grid-template-columns: 1fr;
        min-height: auto;
      }

      .um-service-image {
        height: 210px;
        min-height: 210px;
      }

      .um-section-heading a {
        white-space: normal;
        justify-self: start;
      }

      .um-evidence-section,
      .um-service-system,
      .um-connected-section {
        padding: 56px 0;
      }

      .um-evidence-head h2 {
        font-size: clamp(2rem, 10vw, 3rem);
      }

      .um-evidence-stage,
      .um-evidence-stage__media {
        min-height: auto;
      }

      .um-evidence-stage__media {
        min-height: 260px;
      }

      .um-evidence-stage__copy {
        padding: 24px;
      }

      .um-evidence-case {
        grid-template-columns: 112px minmax(0, 1fr);
        gap: 14px;
        min-height: auto;
        padding: 12px;
      }

      .um-evidence-case-link {
        grid-column: 2;
        align-self: start;
      }

      .um-sector-list a {
        min-height: auto;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .um-btn,
      .um-service-image img,
      .um-evidence-case {
        transition: none !important;
      }
    }

