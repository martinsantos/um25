---
/**
 * Homepage V8 — Clean, modern, visually striking
 * Split hero with animated visual element
 * Professional typography (Inter, not oversized)
 */

import LayoutV4 from '../layouts/LayoutV4.astro';
import ServiceCard from '../components/v4/ServiceCard.astro';
import CTASection from '../components/v4/CTASection.astro';
import { generateSlug } from '../utils/slugUtils.js';
import { getAllServicios } from '../utils/directusHelpers';
import { getDirectusImageUrl, getAllAntecedentes, getHeroHomeImages } from '../lib/directus.ts';
import { serviceBadgeMap, serviceToSectorMap } from '../data/serviceBadgeMap';

// Get 3 featured antecedentes from Directus
let antecedentesData: any[] = [];
try {
  antecedentesData = await getAllAntecedentes();
} catch {
  antecedentesData = [];
}

const antecedentesEnhanced = antecedentesData.slice(0, 3).map((ant: any) => ({
  ...ant,
  slug: generateSlug(ant.Titulo || ant.Nombre || 'proyecto'),
  imageUrl: getDirectusImageUrl(ant.Imagen) || '/images/default-background.jpg'
}));

// Get services from Directus
const serviciosFromDirectus = await getAllServicios();

const iconMap: Record<number, { icon: string }> = {
  101: { icon: 'network' },
  102: { icon: 'shield' },
  103: { icon: 'radio' },
  104: { icon: 'code' },
  105: { icon: 'headphones' },
  106: { icon: 'settings' },
  107: { icon: 'flame' },
  108: { icon: 'zap' }
};

const servicios = serviciosFromDirectus.slice(0, 8).map(s => ({
  ...s,
  ...iconMap[s.id],
  slug: s.slug || generateSlug(s.Titulo),
  badge: serviceBadgeMap[s.id] || 'Tecnología',
}));

// WebSite schema
const websiteSchema = {
  "@type": "WebSite",
  "name": "ULTIMA MILLA",
  "url": "https://ultimamilla.com.ar",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://ultimamilla.com.ar/antecedentes?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

// Sectors with SVG icon paths
const sectores = [
  { slug: 'aeropuertos', name: 'Aeropuertos', desc: 'Infraestructura IT aeroportuaria', icon: 'M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z' },
  { slug: 'bodegas', name: 'Bodegas', desc: 'Tecnología vitivinícola', icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
  { slug: 'constructoras', name: 'Construcción', desc: 'Sistemas para obras', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
  { slug: 'salud', name: 'Salud', desc: 'IT para hospitales y clínicas', icon: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z' },
  { slug: 'gobiernosectorpublico', name: 'Gobierno', desc: 'Sector público y municipal', icon: 'M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21' },
  { slug: 'software', name: 'Software', desc: 'Desarrollo a medida', icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4' },
  { slug: 'mineria', name: 'Minería', desc: 'Soluciones mineras', icon: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z' },
  { slug: 'industria', name: 'Industria', desc: 'Industria 4.0', icon: 'M4.5 12a7.5 7.5 0 0015 0m-15 0a7.5 7.5 0 1115 0m-15 0H3m16.5 0H21m-1.5 0H12m-8.457 3.077l1.41-.513m14.095-5.13l1.41-.513M5.106 17.785l1.15-.964m11.49-9.642l1.149-.964M7.501 19.795l.75-1.3m7.5-12.99l.75-1.3m-6.063 16.658l.26-1.477m2.605-14.772l.26-1.477m0 17.726l-.26-1.477M10.698 4.614l-.26-1.477M16.5 19.794l-.75-1.299M7.5 4.205L12 12' },
  { slug: 'seguridad-electronica', name: 'Seguridad', desc: 'CCTV y control de acceso', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' }
];
---

<LayoutV4
  title="ULTIMA MILLA | Servicios Tecnológicos para Empresas en Mendoza, Cuyo y Patagonia"
  description="Servicios tecnológicos para empresas y organizaciones argentinas. Zona de incumbencia: Mendoza, Cuyo, Patagonia. Especialistas en Telecomunicaciones, Cableado Estructurado, Corrientes Débiles, Detección de Incendio, Software a Medida. +469 proyectos, +22 años de experiencia."
  keywords="servicios tecnologicos empresas argentina, zona incumbencia mendoza cuyo patagonia, telecomunicaciones empresas, cableado estructurado, corrientes debiles, deteccion incendio, software a medida organizaciones"
  image="/nosotros-tech.jpg"
  structuredData={websiteSchema}
>
  <!-- ═══════════════════════════════════════════
       HERO — Split layout with animated mesh
       ═══════════════════════════════════════════ -->
  <section class="relative overflow-hidden bg-gray-950 min-h-[92vh] flex items-center">
    <!-- Background grid -->
    <div class="interactive-grid"></div>
    <!-- Gradient mesh -->
    <div class="absolute inset-0 gradient-mesh opacity-80"></div>
    <!-- Noise texture -->
    <div class="noise-overlay"></div>

    <!-- Animated glow orbs -->
    <div class="absolute top-1/4 right-1/4 w-[500px] h-[500px] rounded-full opacity-[0.08] blur-[120px] animate-pulse-slow" style="background: radial-gradient(circle, #EF4444, transparent 70%);"></div>
    <div class="absolute bottom-1/4 left-1/3 w-[400px] h-[400px] rounded-full opacity-[0.05] blur-[100px] animate-pulse-slow" style="background: radial-gradient(circle, #6366F1, transparent 70%); animation-delay: -4s;"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20 lg:py-24 w-full">
      <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
        <!-- Left: Content -->
        <div>
          <!-- Status badge -->
          <div class="reveal mb-8">
            <span class="inline-flex items-center gap-2.5 px-4 py-2 rounded-full bg-white/[0.06] border border-white/[0.08] backdrop-blur-sm">
              <span class="pulse-dot"></span>
              <span class="text-xs font-medium text-gray-300 tracking-wide">+469 proyectos entregados</span>
            </span>
          </div>

          <!-- Headline -->
          <h1 class="text-fluid-display text-white mb-6 reveal" style="animation-delay: 0.1s;">
            Conectamos la tecnología con el
            <span class="relative inline-block">
              <span class="relative z-10 bg-gradient-to-r from-red-400 via-red-500 to-orange-400 bg-clip-text text-transparent">éxito de su empresa</span>
            </span>
          </h1>

          <!-- Subtitle -->
          <p class="text-base sm:text-lg text-gray-400 mb-10 max-w-lg leading-relaxed reveal" style="animation-delay: 0.2s;">
            Infraestructura IT, seguridad electrónica y desarrollo de software para empresas de Mendoza, Cuyo y Patagonia. Más de 22 años transformando industrias.
          </p>

          <!-- CTAs -->
          <div class="flex flex-col sm:flex-row gap-3 mb-12 reveal" style="animation-delay: 0.3s;">
            <a href="/contacto" class="group inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-white text-gray-900 text-sm font-semibold rounded-xl hover:bg-gray-100 transition-all duration-200 min-h-[48px] shadow-lg shadow-white/10">
              Solicitar Consultoría
              <svg class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-0.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
            <a href="/antecedentes" class="inline-flex items-center justify-center gap-2 px-7 py-3.5 border border-white/15 text-gray-300 text-sm font-medium rounded-xl hover:bg-white/[0.05] hover:border-white/25 hover:text-white transition-all min-h-[48px]">
              Ver Proyectos
            </a>
          </div>

          <!-- Stats row -->
          <div class="flex items-center gap-8 sm:gap-10 reveal" style="animation-delay: 0.4s;">
            <div>
              <div class="text-2xl sm:text-3xl font-bold text-white tabular-nums" data-counter="469">469+</div>
              <div class="text-xs text-gray-500 mt-0.5">Proyectos</div>
            </div>
            <div class="w-px h-10 bg-white/10"></div>
            <div>
              <div class="text-2xl sm:text-3xl font-bold text-white tabular-nums">22+</div>
              <div class="text-xs text-gray-500 mt-0.5">Años</div>
            </div>
            <div class="w-px h-10 bg-white/10"></div>
            <div>
              <div class="text-2xl sm:text-3xl font-bold text-red-400 tabular-nums">24/7</div>
              <div class="text-xs text-gray-500 mt-0.5">Soporte</div>
            </div>
          </div>
        </div>

        <!-- Right: Visual element — Animated mesh/orbital -->
        <div class="hidden lg:flex items-center justify-center reveal-scale" style="animation-delay: 0.3s;">
          <div class="relative w-full max-w-md aspect-square">
            <!-- Orbital rings -->
            <div class="absolute inset-0 animate-orbit" style="animation-duration: 25s;">
              <div class="absolute top-0 left-1/2 -translate-x-1/2 -translate-y-1/2 w-3 h-3 rounded-full bg-red-500 shadow-lg shadow-red-500/50"></div>
            </div>
            <div class="absolute inset-4 animate-orbit" style="animation-duration: 35s; animation-direction: reverse;">
              <div class="absolute bottom-0 right-0 w-2 h-2 rounded-full bg-indigo-400 shadow-lg shadow-indigo-400/50"></div>
            </div>
            <div class="absolute inset-12 animate-orbit" style="animation-duration: 20s;">
              <div class="absolute top-1/2 right-0 w-2.5 h-2.5 rounded-full bg-orange-400 shadow-lg shadow-orange-400/50"></div>
            </div>

            <!-- Ring outlines -->
            <div class="absolute inset-0 rounded-full border border-white/[0.06]"></div>
            <div class="absolute inset-4 rounded-full border border-white/[0.05]"></div>
            <div class="absolute inset-12 rounded-full border border-white/[0.04]"></div>
            <div class="absolute inset-20 rounded-full border border-white/[0.03]"></div>

            <!-- Center element -->
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="relative w-32 h-32 rounded-2xl bg-gradient-to-br from-red-500/20 via-red-600/10 to-transparent border border-red-500/20 backdrop-blur-sm flex items-center justify-center rotate-12 animate-breathe">
                <svg class="w-12 h-12 text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M9 17.25v1.007a3 3 0 01-.879 2.122L7.5 21h9l-.621-.621A3 3 0 0115 18.257V17.25m6-12V15a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 15V5.25m18 0A2.25 2.25 0 0018.75 3H5.25A2.25 2.25 0 003 5.25m18 0V12a9 9 0 11-18 0V5.25"/>
                </svg>
              </div>
            </div>

            <!-- Floating badges around orbital -->
            <div class="absolute -top-2 right-8 px-3 py-1.5 rounded-lg bg-white/[0.06] border border-white/[0.08] backdrop-blur-sm">
              <span class="text-[10px] font-medium text-gray-400">Redes</span>
            </div>
            <div class="absolute top-1/4 -right-4 px-3 py-1.5 rounded-lg bg-white/[0.06] border border-white/[0.08] backdrop-blur-sm">
              <span class="text-[10px] font-medium text-gray-400">Seguridad</span>
            </div>
            <div class="absolute bottom-1/4 -right-2 px-3 py-1.5 rounded-lg bg-white/[0.06] border border-white/[0.08] backdrop-blur-sm">
              <span class="text-[10px] font-medium text-gray-400">Software</span>
            </div>
            <div class="absolute bottom-8 left-0 px-3 py-1.5 rounded-lg bg-white/[0.06] border border-white/[0.08] backdrop-blur-sm">
              <span class="text-[10px] font-medium text-gray-400">Telecom</span>
            </div>
            <div class="absolute top-1/3 -left-6 px-3 py-1.5 rounded-lg bg-white/[0.06] border border-white/[0.08] backdrop-blur-sm">
              <span class="text-[10px] font-medium text-gray-400">IoT</span>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom gradient fade to white -->
    <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-white to-transparent"></div>
  </section>

  <!-- ═══════════════════════════════════════════
       TRUSTED BY — Logo/sector marquee
       ═══════════════════════════════════════════ -->
  <section class="py-10 sm:py-12 bg-white border-b border-gray-100">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <p class="text-xs font-medium text-gray-400 uppercase tracking-widest text-center mb-6">Experiencia en sectores clave</p>
      <div class="marquee-container">
        <div class="marquee-track">
          {[...sectores, ...sectores].map((sector) => (
            <a href={`/${sector.slug}`} class="flex items-center gap-2.5 text-gray-400 hover:text-gray-600 transition-colors shrink-0 group">
              <div class="w-8 h-8 rounded-lg bg-gray-50 group-hover:bg-red-50 flex items-center justify-center transition-colors">
                <svg class="w-4 h-4 text-gray-300 group-hover:text-red-400 transition-colors" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={sector.icon}/>
                </svg>
              </div>
              <span class="text-sm font-medium whitespace-nowrap">{sector.name}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SERVICES — Clean card grid
       ═══════════════════════════════════════════ -->
  <section class="section-padding bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12 sm:mb-14">
        <div class="reveal max-w-xl">
          <span class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.2em] text-red-500 mb-3">
            <span class="w-6 h-px bg-red-400"></span>
            Servicios
          </span>
          <h2 class="text-fluid-title text-gray-900">
            Soluciones que transforman industrias
          </h2>
          <p class="text-gray-500 mt-3 text-sm leading-relaxed">Tecnología de punta adaptada a las necesidades de su empresa.</p>
        </div>
        <a href="/servicios" class="group inline-flex items-center gap-2 text-gray-900 font-medium text-sm hover:text-red-600 transition-colors reveal">
          Ver todos los servicios
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-5 reveal-stagger">
        {servicios.map((servicio) => (
          <div class="reveal">
            <ServiceCard
              id={servicio.id}
              slug={servicio.slug}
              titulo={servicio.Titulo}
              descripcion={servicio.Descripcion}
              imagen={servicio.Imagen}
              badge={servicio.badge}
              cliente={servicio.Cliente}
              icon={servicio.icon}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       SUCCESS CASES — Dark section with cards
       ═══════════════════════════════════════════ -->
  <section class="relative section-padding bg-gray-950 overflow-hidden">
    <div class="interactive-grid"></div>
    <div class="noise-overlay"></div>
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[600px] h-[400px] bg-red-600/[0.03] rounded-full blur-[120px] pointer-events-none"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12 sm:mb-14 reveal">
        <div>
          <span class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.2em] text-red-400/70 mb-3">
            <span class="w-6 h-px bg-red-500/50"></span>
            Casos de Éxito
          </span>
          <h2 class="text-fluid-title text-white">
            Proyectos que hablan por nosotros
          </h2>
        </div>
        <a href="/antecedentes" class="group inline-flex items-center gap-2 text-gray-400 hover:text-white font-medium text-sm transition-colors">
          Ver todos los proyectos
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 reveal-stagger">
        {antecedentesEnhanced.map((antecedente) => (
          <a href={`/antecedentes/${antecedente.id}/${antecedente.slug}`} class="reveal group rounded-2xl overflow-hidden bg-white/[0.03] border border-white/[0.06] hover:border-white/[0.12] hover:bg-white/[0.05] transition-all duration-300 hover:-translate-y-1">
            <div class="relative aspect-[16/10] overflow-hidden">
              <img
                src={antecedente.imageUrl}
                alt={antecedente.Titulo || antecedente.Nombre}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03] opacity-70 group-hover:opacity-90"
                loading="lazy"
                onerror="this.onerror=null;this.src='/images/default-background.jpg'"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-gray-950/90 via-gray-950/20 to-transparent"></div>
              <!-- Category badge on image -->
              <div class="absolute bottom-4 left-4">
                <span class="px-2.5 py-1 rounded-md bg-white/10 backdrop-blur-sm text-[10px] font-semibold text-white/80 uppercase tracking-wider">
                  {antecedente.Cliente || antecedente.Sector || 'Proyecto'}
                </span>
              </div>
            </div>
            <div class="p-5">
              <h3 class="text-[15px] font-semibold text-white mb-2 line-clamp-2 group-hover:text-red-400 transition-colors">{antecedente.Titulo || antecedente.Nombre}</h3>
              <p class="text-sm text-gray-500 line-clamp-2 leading-relaxed">{antecedente.Descripcion?.replace(/\\\\/g, ' ').substring(0, 100)}...</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       INDUSTRIES — Card grid with visual interest
       ═══════════════════════════════════════════ -->
  <section class="section-padding bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-xl mb-12 sm:mb-14 reveal">
        <span class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.2em] text-red-500 mb-3">
          <span class="w-6 h-px bg-red-400"></span>
          Industrias
        </span>
        <h2 class="text-fluid-title text-gray-900">
          Experiencia en los sectores más exigentes
        </h2>
        <p class="text-gray-500 mt-3 text-sm leading-relaxed">Soluciones especializadas para cada vertical de negocio.</p>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3 reveal-stagger">
        {sectores.map((sector) => (
          <a href={`/${sector.slug}`} class="reveal group flex items-center gap-4 px-5 py-4 rounded-xl bg-gray-50 hover:bg-white border border-transparent hover:border-gray-200 hover:shadow-lg hover:shadow-gray-100/80 transition-all duration-300">
            <div class="w-10 h-10 rounded-xl bg-white group-hover:bg-red-50 flex items-center justify-center transition-colors duration-300 shrink-0 shadow-sm">
              <svg class="w-5 h-5 text-gray-400 group-hover:text-red-500 transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={sector.icon}/>
              </svg>
            </div>
            <div class="min-w-0 flex-1">
              <div class="text-sm font-semibold text-gray-800 group-hover:text-gray-900 transition-colors">{sector.name}</div>
              <div class="text-xs text-gray-400 mt-0.5">{sector.desc}</div>
            </div>
            <svg class="w-4 h-4 text-gray-300 group-hover:text-red-400 shrink-0 opacity-0 group-hover:opacity-100 transition-all duration-300 -translate-x-1 group-hover:translate-x-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════
       CTA — Final conversion section
       ═══════════════════════════════════════════ -->
  <CTASection
    variant="dark"
    badge="Comience su transformación"
    badgeIcon="rocket"
    titulo="¿Listo para modernizar su infraestructura IT?"
    descripcion="Contáctenos hoy para una consultoría gratuita y descubra cómo podemos impulsar su negocio."
    primaryButtonText="Agendar Consultoría Gratis"
    primaryButtonUrl="/contacto"
    secondaryButtonText="contacto@ultimamilla.com.ar"
    secondaryButtonUrl="mailto:contacto@ultimamilla.com.ar"
    secondaryButtonIcon="mail"
  />
</LayoutV4>
