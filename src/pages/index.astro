---
/**
 * Homepage — "Monograph" Design
 * Dense, layered, authoritative. Like an architecture firm's portfolio.
 */
import LayoutV4 from '../layouts/LayoutV4.astro';
import ServiceCard from '../components/v4/ServiceCard.astro';
import { generateSlug } from '../utils/slugUtils.js';
import { getAllServicios } from '../utils/directusHelpers';
import { getDirectusImageUrl, getAllAntecedentes, withBase } from '../lib/directus.ts';
import { serviceBadgeMap, serviceToSectorMap } from '../data/serviceBadgeMap';
import { getSectorColors } from '../data/colorSystem';

const heroImages = [
  { url: withBase('/images/hero/foto-redes.jpg'), alt: 'Infraestructura de Redes' },
  { url: withBase('/images/hero/foto-seguridad.jpg'), alt: 'Seguridad Electrónica' },
  { url: withBase('/images/hero/foto-software.jpg'), alt: 'Desarrollo de Software' },
  { url: withBase('/images/hero/foto-soporte.jpg'), alt: 'Soporte Técnico' },
  { url: withBase('/images/hero/foto-incendios.jpg'), alt: 'Detección de Incendios' },
  { url: withBase('/images/hero/foto-general.jpg'), alt: 'Ultima Milla' },
];

let antecedentesData: any[] = [];
try { antecedentesData = await getAllAntecedentes(); } catch { antecedentesData = []; }
const antecedentesEnhanced = antecedentesData.slice(0, 3).map((ant: any) => ({
  ...ant,
  slug: generateSlug(ant.Titulo || ant.Nombre || 'proyecto'),
  imageUrl: getDirectusImageUrl(ant.Imagen) || withBase('/images/default-background.jpg')
}));

const serviciosFromDirectus = await getAllServicios();
const iconMap: Record<number, { icon: string; iconColor: string }> = {
  101: { icon: 'network', iconColor: 'bg-sky-600/90' }, 102: { icon: 'shield', iconColor: 'bg-rose-600/90' },
  103: { icon: 'radio', iconColor: 'bg-cyan-600/90' }, 104: { icon: 'code', iconColor: 'bg-purple-600/90' },
  105: { icon: 'headphones', iconColor: 'bg-amber-600/90' }, 106: { icon: 'lightbulb', iconColor: 'bg-emerald-600/90' },
  107: { icon: 'flame', iconColor: 'bg-orange-600/90' }, 108: { icon: 'zap', iconColor: 'bg-yellow-600/90' }
};
const servicios = serviciosFromDirectus.slice(0, 8).map(s => {
  const sector = serviceToSectorMap[s.id] || 'tecnologia';
  const colors = getSectorColors(sector);
  return { ...s, ...iconMap[s.id], slug: s.slug || generateSlug(s.Titulo), badge: serviceBadgeMap[s.id] || 'Tecnología', badgeColor: colors.icon };
});

const websiteSchema = { "@type": "WebSite", "name": "ULTIMA MILLA", "url": "https://ultimamilla.com.ar", "potentialAction": { "@type": "SearchAction", "target": { "@type": "EntryPoint", "urlTemplate": "https://ultimamilla.com.ar/antecedentes?q={search_term_string}" }, "query-input": "required name=search_term_string" } };

const sectores = [
  { slug: 'aeropuertos', name: 'Aeropuertos', color: '#0ea5e9' }, { slug: 'bodegas', name: 'Bodegas', color: '#a855f7' },
  { slug: 'constructoras', name: 'Construcción', color: '#f59e0b' }, { slug: 'salud', name: 'Salud', color: '#22c55e' },
  { slug: 'gobiernosectorpublico', name: 'Gobierno', color: '#10b981' }, { slug: 'software', name: 'Software', color: '#6366f1' },
  { slug: 'mineria', name: 'Minería', color: '#f97316' }, { slug: 'industria', name: 'Industria', color: '#64748b' },
  { slug: 'seguridad-electronica', name: 'Seguridad', color: '#06b6d4' }
];
const sectorIcons: Record<string, string> = {
  'aeropuertos': 'M12 19l9 2-9-18-9 18 9-2zm0 0v-8', 'bodegas': 'M9 12h6m-3-3v6m-7 4h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
  'constructoras': 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  'salud': 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
  'gobiernosectorpublico': 'M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z',
  'software': 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4', 'mineria': 'M20.618 5.984A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  'industria': 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
  'seguridad-electronica': 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
};
---

<LayoutV4
  title="ULTIMA MILLA — Infraestructura IT, Seguridad y Software | Mendoza"
  description="469+ proyectos de infraestructura IT, seguridad electrónica y desarrollo de software en Mendoza, Cuyo y Patagonia."
  keywords="infraestructura IT mendoza, seguridad electronica, software a medida"
  image="/nosotros-tech.jpg"
  structuredData={websiteSchema}
>

  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       HERO — "Monograph cover": Ghost number + headline + photo mosaic
       ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <section class="relative bg-gray-950 overflow-hidden" style="min-height:100svh;">
    <!-- Giant ghost number as texture -->
    <div class="absolute top-1/2 -translate-y-1/2 -right-[5%] select-none pointer-events-none um-ghost-num" aria-hidden="true"
      style="font-family:'Futura PT','Futura',sans-serif; font-size:clamp(20rem,40vw,50rem); font-weight:800; line-height:0.8; color:rgba(255,255,255,0.03); letter-spacing:-0.04em;">
      469
    </div>

    <div class="relative max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <!-- Top bar: mono label + year -->
      <div class="flex items-center justify-between pt-8 pb-16 sm:pb-24 border-b border-white/5">
        <span class="text-[10px] font-mono uppercase tracking-[0.3em] text-white/30">Infraestructura IT · Seguridad · Software</span>
        <span class="text-[10px] font-mono uppercase tracking-[0.3em] text-white/30">Est. 2002</span>
      </div>

      <!-- Main grid: type left, photo mosaic right -->
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-8 lg:gap-16 items-center py-12 sm:py-16 lg:py-20">

        <!-- Left column: headline + CTA -->
        <div>
          <h1 style="font-family:'Futura PT','Futura','Trebuchet MS',sans-serif; text-wrap:balance;"
            class="text-[2rem] sm:text-[2.75rem] md:text-[3.25rem] lg:text-[3.75rem] font-bold text-white leading-[1.0] tracking-tight mb-6 sm:mb-8">
            La infraestructura que<br>
            mueve a las empresas<br>
            argentinas<span class="text-red-500">.</span>
          </h1>

          <p class="text-white/45 text-sm sm:text-base leading-relaxed max-w-md mb-8" style="text-wrap:pretty;">
            Diseñamos, construimos y mantenemos la columna vertebral tecnológica de aeropuertos, hospitales, bodegas, gobiernos y empresas industriales desde Mendoza hasta la Patagonia.
          </p>

          <div class="flex flex-wrap gap-3 mb-12">
            <a href={withBase("/contacto")} class="inline-flex items-center gap-2 px-6 py-3 bg-red-600 text-white font-semibold rounded-lg hover:bg-red-500 transition-colors text-sm">
              Solicitar consultoría
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
            </a>
            <a href={withBase("/antecedentes")} class="inline-flex items-center px-6 py-3 border border-white/15 text-white/70 font-medium rounded-lg hover:border-white/30 hover:text-white transition-all text-sm">
              Ver proyectos
            </a>
          </div>

          <!-- Stats: 4 numbers in tight grid -->
          <div class="grid grid-cols-4 gap-px bg-white/5 rounded-lg overflow-hidden">
            <div class="bg-gray-950 p-4 text-center">
              <div class="text-xl sm:text-2xl font-bold text-white tabular-nums">469+</div>
              <div class="text-[8px] font-mono uppercase tracking-[0.2em] text-white/30 mt-1">Proyectos</div>
            </div>
            <div class="bg-gray-950 p-4 text-center">
              <div class="text-xl sm:text-2xl font-bold text-white tabular-nums">22</div>
              <div class="text-[8px] font-mono uppercase tracking-[0.2em] text-white/30 mt-1">Años</div>
            </div>
            <div class="bg-gray-950 p-4 text-center">
              <div class="text-xl sm:text-2xl font-bold text-white tabular-nums">9</div>
              <div class="text-[8px] font-mono uppercase tracking-[0.2em] text-white/30 mt-1">Industrias</div>
            </div>
            <div class="bg-gray-950 p-4 text-center">
              <div class="text-xl sm:text-2xl font-bold text-red-500 tabular-nums">24/7</div>
              <div class="text-[8px] font-mono uppercase tracking-[0.2em] text-white/30 mt-1">Soporte</div>
            </div>
          </div>
        </div>

        <!-- Right column: photo mosaic (3 photos in L-shape) -->
        <div class="grid grid-cols-2 gap-3" id="heroImageContainer">
          <div class="col-span-2 relative rounded-2xl overflow-hidden aspect-[2/1] bg-gray-800">
            {heroImages.slice(0, 3).map((img, i) => (
              <img src={img.url} alt={img.alt}
                class={`hero-image absolute inset-0 w-full h-full object-cover transition-opacity duration-[2000ms] ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
                data-index={i} />
            ))}
          </div>
          <div class="rounded-2xl overflow-hidden aspect-square bg-gray-800">
            <img src={heroImages[3]?.url} alt="Proyecto" class="w-full h-full object-cover" loading="lazy" />
          </div>
          <div class="rounded-2xl overflow-hidden aspect-square bg-gray-800">
            <img src={heroImages[4]?.url} alt="Proyecto" class="w-full h-full object-cover" loading="lazy" />
          </div>
        </div>
      </div>

      <!-- Client ticker -->
      <div class="border-t border-white/5 py-5 flex items-center gap-6 overflow-hidden">
        <span class="text-[9px] font-mono uppercase tracking-[0.25em] text-white/20 shrink-0">Confían en nosotros</span>
        <div class="flex gap-6 text-[11px] text-white/25 font-medium whitespace-nowrap um-ticker">
          <span>Aeropuertos Argentina 2000</span><span class="text-white/10">—</span>
          <span>Gobierno de Mendoza</span><span class="text-white/10">—</span>
          <span>Hospital Central</span><span class="text-white/10">—</span>
          <span>Bodega La Esmeralda</span><span class="text-white/10">—</span>
          <span>Premix SA</span><span class="text-white/10">—</span>
          <span>Municipalidad de Guaymallén</span><span class="text-white/10">—</span>
          <span>Jose Nucete e Hijos</span><span class="text-white/10">—</span>
          <span>Consorcio Torre Thays</span>
        </div>
      </div>
    </div>
  </section>

  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       SERVICES — Dense card grid with photo overlays
       ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <section class="py-16 sm:py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <!-- Section header with rule -->
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-12 sm:mb-16 items-end">
        <div class="lg:col-span-2">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-10 h-[2px] bg-red-600"></span>
            <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-gray-400">Servicios</span>
          </div>
          <h2 style="font-family:'Futura PT','Futura',sans-serif;"
            class="text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-900 tracking-tight leading-tight">
            Ocho disciplinas<span class="text-red-600">,</span><br>
            una sola misión<span class="text-red-600">.</span>
          </h2>
        </div>
        <div class="lg:text-right">
          <a href={withBase("/servicios")} class="text-[11px] font-semibold text-gray-400 hover:text-red-600 transition-colors uppercase tracking-[0.15em] inline-flex items-center gap-1.5">
            Catálogo completo
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
          </a>
        </div>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-4 gap-3 sm:gap-4">
        {servicios.map((s, i) => (
          <div class="scroll-reveal" style={`animation-delay:${i * 0.05}s`}>
            <ServiceCard id={s.id} slug={s.slug} titulo={s.Titulo} descripcion={s.Descripcion} imagen={s.Imagen} badge={s.badge} cliente={s.Cliente} icon={s.icon} index={i} />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       CASES — Dark section, asymmetric bento grid
       ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <section class="py-16 sm:py-20 lg:py-28 bg-gray-950 relative overflow-hidden">
    <!-- Subtle grain texture -->
    <div class="absolute inset-0 opacity-[0.015]" style="background-image:url('data:image/svg+xml,%3Csvg viewBox=%270 0 256 256%27 xmlns=%27http://www.w3.org/2000/svg%27%3E%3Cfilter id=%27noise%27%3E%3CfeTurbulence type=%27fractalNoise%27 baseFrequency=%270.9%27 numOctaves=%274%27 stitchTiles=%27stitch%27/%3E%3C/filter%3E%3Crect width=%27100%25%27 height=%27100%25%27 filter=%27url(%23noise)%27/%3E%3C/svg%3E');"></div>

    <div class="relative max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 mb-12 sm:mb-16 items-end">
        <div class="lg:col-span-2">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-10 h-[2px] bg-red-500"></span>
            <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-white/30">Antecedentes</span>
          </div>
          <h2 style="font-family:'Futura PT','Futura',sans-serif;"
            class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white tracking-tight leading-tight">
            469 proyectos<span class="text-red-500">.</span><br>
            <span class="text-white/30">Cada uno cuenta una historia.</span>
          </h2>
        </div>
        <div class="lg:text-right">
          <a href={withBase("/antecedentes")} class="text-[11px] font-semibold text-white/30 hover:text-red-500 transition-colors uppercase tracking-[0.15em] inline-flex items-center gap-1.5">
            Explorar todos
            <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
          </a>
        </div>
      </div>

      {antecedentesEnhanced.length > 0 && (
        <div class="grid grid-cols-6 sm:grid-cols-12 gap-3 sm:gap-4">
          <!-- Main case: 7 of 12 -->
          <a href={withBase(`/antecedentes/${antecedentesEnhanced[0].id}/${antecedentesEnhanced[0].slug}`)}
            class="group col-span-6 sm:col-span-7 relative rounded-2xl overflow-hidden aspect-[4/3] flex items-end bg-gray-800 scroll-reveal">
            <img src={antecedentesEnhanced[0].imageUrl} alt={antecedentesEnhanced[0].Titulo}
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-700" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            <div class="relative p-5 sm:p-7">
              <span class="text-red-400 text-[9px] font-bold uppercase tracking-[0.2em]">{antecedentesEnhanced[0].Area}</span>
              <h3 class="text-lg sm:text-xl lg:text-2xl font-bold text-white leading-snug mt-1.5" style="text-wrap:balance; font-family:'Futura PT',sans-serif;">{antecedentesEnhanced[0].Titulo}</h3>
              <span class="text-white/30 text-[10px] font-mono uppercase tracking-wider mt-2 block">{antecedentesEnhanced[0].Cliente}</span>
            </div>
          </a>

          <!-- Side cases: 5 of 12 each stacked -->
          <div class="col-span-6 sm:col-span-5 grid grid-rows-2 gap-3 sm:gap-4">
            {antecedentesEnhanced.slice(1, 3).map((ant, i) => (
              <a href={withBase(`/antecedentes/${ant.id}/${ant.slug}`)}
                class="group relative rounded-2xl overflow-hidden flex items-end bg-gray-800 scroll-reveal"
                style={`animation-delay:${(i+1)*0.12}s`}>
                <img src={ant.imageUrl} alt={ant.Titulo}
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-700" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/15 to-transparent"></div>
                <div class="relative p-4 sm:p-5">
                  <span class="text-red-400 text-[9px] font-bold uppercase tracking-[0.2em]">{ant.Area}</span>
                  <h3 class="text-sm sm:text-base font-bold text-white leading-snug mt-1" style="font-family:'Futura PT',sans-serif;">{ant.Titulo}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}
    </div>
  </section>

  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       INDUSTRIES — Tight grid of industry badges
       ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <section class="py-16 sm:py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-6 sm:px-8 lg:px-12">
      <div class="grid grid-cols-1 lg:grid-cols-5 gap-8 lg:gap-16 items-start">
        <div class="lg:col-span-2">
          <div class="flex items-center gap-3 mb-3">
            <span class="w-10 h-[2px] bg-red-600"></span>
            <span class="text-[10px] font-mono uppercase tracking-[0.25em] text-gray-400">Industrias</span>
          </div>
          <h2 style="font-family:'Futura PT','Futura',sans-serif;"
            class="text-2xl sm:text-3xl lg:text-4xl font-bold text-gray-900 tracking-tight leading-tight mb-4">
            Expertise sectorial<span class="text-red-600">.</span>
          </h2>
          <p class="text-gray-400 text-sm leading-relaxed">
            22 años nos dieron conocimiento profundo de los desafíos específicos de cada industria.
          </p>
        </div>

        <div class="lg:col-span-3">
          <div class="grid grid-cols-3 gap-2 sm:gap-3">
            {sectores.map((sector) => (
              <a href={withBase(`/${sector.slug}`)}
                class="group relative p-4 sm:p-5 rounded-xl border border-gray-100 hover:border-gray-900 hover:bg-gray-900 transition-all duration-300 text-center">
                <svg class="w-5 h-5 text-gray-300 group-hover:text-red-500 transition-colors mx-auto mb-2" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d={sectorIcons[sector.slug] || 'M13 10V3L4 14h7v7l9-11h-7z'}/>
                </svg>
                <span class="text-xs sm:text-sm font-semibold text-gray-700 group-hover:text-white transition-colors block">{sector.name}</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
       CTA — Split: type left, photo right, dark bg
       ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━ -->
  <section class="bg-gray-950 relative overflow-hidden">
    <div class="absolute inset-0 um-glow"></div>

    <div class="relative max-w-7xl mx-auto px-6 sm:px-8 lg:px-12 py-16 sm:py-20 lg:py-28">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <div>
          <h2 style="font-family:'Futura PT','Futura',sans-serif; text-wrap:balance;"
            class="text-2xl sm:text-3xl lg:text-4xl font-bold text-white tracking-tight leading-tight mb-5">
            El próximo proyecto exitoso puede ser el suyo<span class="text-red-500">.</span>
          </h2>
          <p class="text-white/40 text-sm leading-relaxed mb-8 max-w-md">
            Hablemos sobre cómo podemos transformar la infraestructura tecnológica de su organización.
          </p>
          <div class="flex flex-wrap gap-3">
            <a href={withBase("/contacto")} class="px-6 py-3 bg-red-600 text-white font-semibold rounded-lg hover:bg-red-500 transition-colors text-sm">
              Agendar consultoría
            </a>
            <a href="mailto:contacto@ultimamilla.com.ar" class="px-6 py-3 border border-white/15 text-white/60 rounded-lg hover:border-white/30 hover:text-white transition-all text-sm">
              contacto@ultimamilla.com.ar
            </a>
          </div>
        </div>

        <div class="rounded-2xl overflow-hidden aspect-[4/3] bg-gray-800">
          <img src={heroImages[5]?.url || heroImages[0].url} alt="Ultima Milla" class="w-full h-full object-cover" loading="lazy" />
        </div>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const imgs = document.querySelectorAll('.hero-image');
      if (imgs.length > 1) {
        let c = 0;
        setInterval(() => {
          imgs[c].classList.remove('opacity-100');
          imgs[c].classList.add('opacity-0');
          c = (c + 1) % imgs.length;
          imgs[c].classList.remove('opacity-0');
          imgs[c].classList.add('opacity-100');
        }, 4000);
      }
    });
  </script>

  <style>
    @property --glow-x { syntax: '<percentage>'; initial-value: 30%; inherits: false; }
    @keyframes glow-move { 0%,100%{--glow-x:20%} 50%{--glow-x:80%} }
    .um-glow {
      background: radial-gradient(600px ellipse at var(--glow-x) 50%, rgba(220,38,38,0.05), transparent 70%);
      animation: glow-move 12s ease-in-out infinite;
    }

    /* Ghost number parallax on scroll */
    .um-ghost-num {
      animation: ghost-drift linear;
      animation-timeline: scroll(root);
      animation-range: 0vh 100vh;
    }
    @keyframes ghost-drift { to { transform: translateY(-30%) translateX(-5%); } }

    /* Ticker subtle animation */
    .um-ticker {
      animation: ticker-slide 30s linear infinite;
    }
    @keyframes ticker-slide {
      from { transform: translateX(0); }
      to { transform: translateX(-50%); }
    }

    @media (prefers-reduced-motion: reduce) {
      .um-glow, .um-ghost-num, .um-ticker { animation: none !important; }
    }
  </style>
</LayoutV4>
