---
import { ANTECEDENTES_REALES } from '../lib/um26-data/antecedentesReales';
import { sectorCaseLabel } from '../data/sectorCaseCounts';
import { getAntecedentesCatalogCount } from '../utils/verifiedProof';
import LayoutV4 from '../layouts/LayoutV4.astro';
import EmailLink from '../components/common/EmailLink.astro';
import CineBanner from '../components/cine/CineBanner.astro';
import ServicesStory from '../components/cine/ServicesStory.astro';
import SectorAtlas from '../components/cine/SectorAtlas.astro';
import CoverageMap from '../components/cine/CoverageMap.astro';
import ProductBand from '../components/cine/ProductBand.astro';
import CompanyBand from '../components/cine/CompanyBand.astro';
import JournalBand from '../components/cine/JournalBand.astro';
import SnapRail from '../components/cine/SnapRail.astro';

const heroLead = 'Redes, seguridad electrónica, telecomunicaciones, software a medida, soporte 24/7 y energía IT. Evidencia operativa visible antes de contratar.';

const services = [
  {
    code: '101',
    name: 'Redes',
    text: 'Cableado estructurado y fibra óptica certificada.',
    href: '/servicios/101/infraestructura-de-redes-cableado-fibra-optica-radioenlaces',
    image: '/img/servicios/redes.webp',
  },
  {
    code: '102',
    name: 'Seguridad electrónica',
    text: 'CCTV IP, accesos y monitoreo documentado.',
    href: '/servicios/102/sistemas-de-seguridad-electronica-cctv-control-acceso-sistemas-de-deteccion-de-incendios-sdi',
    image: '/img/servicios/seguridad-electronica.webp',
  },
  {
    code: '103',
    name: 'Telecomunicaciones',
    text: 'Enlaces de datos, voz y video para sitios remotos.',
    href: '/servicios/103/telecomunicaciones-datos-voz-video',
    image: '/img/servicios/telecomunicaciones.webp',
  },
  {
    code: '104',
    name: 'Software a medida',
    text: 'Sistemas, APIs y tableros para procesos críticos.',
    href: '/servicios/104/desarrollo-de-software-a-medida-web-mobile-erp',
    image: '/img/servicios/software-a-medida.webp',
  },
  {
    code: '105',
    name: 'Soporte 24/7',
    text: 'Mesa de ayuda, NOC y mantenimiento con SLA.',
    href: '/servicios/105/soporte-tecnico-247-mesa-de-ayuda-mantenimiento-it',
    image: '/img/servicios/soporte-247.webp',
  },
  {
    code: '106',
    name: 'Consultoría IT',
    text: 'Arquitectura, auditoría y roadmap operativo.',
    href: '/servicios/106/consultoria-it-y-transformacion-digital-arquitectura-auditoria',
    image: '/img/servicios/consultoria-it.webp',
  },
  {
    code: '107',
    name: 'Detección de incendios',
    text: 'SDI, sensores y paneles para entornos productivos.',
    href: '/servicios/107/sistemas-de-deteccion-y-alarma-de-incendios',
    image: '/img/servicios/deteccion-incendios.webp',
  },
  {
    code: '108',
    name: 'Eléctricos IT',
    text: 'Tableros, UPS y energía limpia para infraestructura.',
    href: '/servicios/108/servicios-electricos-para-it',
    image: '/img/servicios/electricos-it.webp',
  },
];

const sectors = [
  { name: 'Aeropuertos', count: sectorCaseLabel('aeropuertos'), text: 'CCTV de perímetro 24/7', href: '/aeropuertos', image: '/img/sectores/aeropuertos.webp', accent: '#DC2626', big: true },
  { name: 'Bodegas', count: sectorCaseLabel('bodegas'), text: 'Trazabilidad vitivinícola end-to-end', href: '/bodegas', image: '/img/sectores/bodegas.webp', accent: '#DC2626' },
  { name: 'Constructoras', count: sectorCaseLabel('constructoras'), text: 'Cableado estructurado certificado', href: '/constructoras', image: '/img/sectores/constructoras.webp', accent: '#DC2626' },
  { name: 'Gobierno y Sector Público', count: sectorCaseLabel('gobiernosectorpublico'), text: 'Digitalización de trámites', href: '/gobiernosectorpublico', image: '/img/sectores/gobierno.webp', accent: '#DC2626' },
  { name: 'Industria', count: sectorCaseLabel('industria'), text: 'Redes industriales en planta 24/7', href: '/industria', image: '/img/sectores/industria.webp', accent: '#DC2626' },
  { name: 'Minería', count: sectorCaseLabel('mineria'), text: 'Telecomunicaciones en campamento remoto', href: '/mineria', image: '/img/sectores/mineria.webp', accent: '#DC2626', big: true },
  { name: 'Salud', count: sectorCaseLabel('salud'), text: 'Redes para imágenes médicas', href: '/salud', image: '/img/sectores/salud.webp', accent: '#DC2626' },
  { name: 'Seguridad Electrónica', count: sectorCaseLabel('seguridad-electronica'), text: 'Centro de monitoreo 24/7', href: '/seguridad-electronica', image: '/img/sectores/seguridad-electronica.webp', accent: '#DC2626' },
  { name: 'Software', count: sectorCaseLabel('software'), text: 'ERPs y plataformas a medida', href: '/software', image: '/img/sectores/software.webp', accent: '#DC2626' },
];

// Proyectos destacados: registros reales del catálogo, con su ficha y su imagen curada.
const SECTOR_LABEL: Record<string, string> = {
  aeropuertos: 'Aeropuertos', bodegas: 'Bodegas', constructoras: 'Constructoras', gobierno: 'Gobierno',
  industria: 'Industria', mineria: 'Minería', salud: 'Salud', 'seguridad-electronica': 'Seguridad electrónica', software: 'Software',
};
const DESTACADOS: { id: number; image: string }[] = [
  { id: 3065, image: '/img/antecedentes/curadas/3065-aeropuerto-cctv.webp' },
  { id: 3075, image: '/img/antecedentes/curadas/3075-fuesmen-redes.webp' },
  { id: 3064, image: '/img/antecedentes/curadas/3064-gobierno-software.webp' },
  { id: 3334, image: '/img/antecedentes/curadas/3334-bodega-servidores.webp' },
];
const cases = DESTACADOS.flatMap(({ id, image }) => {
  const item = ANTECEDENTES_REALES.find((antecedente) => antecedente.id === id);
  if (!item) return [];
  const title = item.title.replace(new RegExp(`\\s*-\\s*${item.client.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}.*$`, 'i'), '').trim() || item.title;
  return [{
    id: String(id),
    title,
    meta: `${item.client}${item.year ? ` / ${item.year}` : ''}`,
    sector: SECTOR_LABEL[item.sectorSlug] || '',
    href: `/antecedentes/${id}/${item.slug}`,
    image,
  }];
});

const stats = [
  { value: '22+', label: 'Años de operación', href: '/nosotros', aria: 'Ver trayectoria de ULTIMA MILLA' },
  { value: String(getAntecedentesCatalogCount()), label: 'Proyectos documentados', href: '/antecedentes', aria: 'Ver proyectos documentados' },
  { value: '9', label: 'Sectores atendidos', href: '/sectores', aria: 'Ver sectores atendidos' },
  { value: '4', label: 'Sedes en Cuyo y Patagonia', href: '#cobertura', aria: 'Ver sedes y cobertura' },
  { value: '24/7', label: 'Soporte operativo', href: '/servicios/105/soporte-tecnico-247-mesa-de-ayuda-mantenimiento-it', aria: 'Ver soporte operativo 24/7' },
];

const hubs = [
  { name: 'Mendoza', region: 'Cuyo / sede central', coords: '-32.8908, -68.8272', href: '/servicios-it-empresas-mendoza', aria: 'Ver servicios IT para empresas en Mendoza' },
  { name: 'San Juan', region: 'Cuyo', coords: '-31.5375, -68.5364', href: '/servicios-it-empresas-argentina', aria: 'Ver cobertura de servicios IT para empresas en San Juan' },
  { name: 'San Luis', region: 'Cuyo', coords: '-33.2950, -66.3356', href: '/servicios-it-empresas-argentina', aria: 'Ver cobertura de servicios IT para empresas en San Luis' },
  { name: 'Neuquen', region: 'Patagonia', coords: '-38.9516, -68.0591', href: '/servicios-it-empresas-argentina', aria: 'Ver cobertura de servicios IT para empresas en Patagonia' },
];
---

<LayoutV4 skin="black"
  title="ULTIMA MILLA | Operaciones que no pueden detenerse"
  description="Servicios IT integrales para empresas en Mendoza, Cuyo y Patagonia: redes, seguridad electrónica, telecomunicaciones, software, soporte y energía IT."
  keywords="servicios IT, redes, seguridad electrónica, CCTV, telecomunicaciones, software a medida, soporte técnico 24/7, Mendoza, Cuyo, Patagonia"
  image="/cine/media/cine-bodega-poster.jpg"
>
  <div class="um26-home">
    <CineBanner
      variant="home"
      kicker="Más de 22 años de servicios IT · Mendoza, Argentina"
      title="Servicios IT para operaciones que no pueden detenerse."
      lead={heroLead}
      primary={{ href: '/antecedentes', label: 'Ver evidencia operativa' }}
      secondary={{ href: '/sectores', label: 'Entrar por sector' }}
    />

    <section class="um26-stats" aria-label="Indicadores ULTIMA MILLA">
      <div class="um26-shell um26-stats__inner">
        <div class="um26-stats__grid">
          {stats.map(({ value, label, href, aria }) => (
            <a href={href} aria-label={aria}>
              <strong>
                {value.endsWith('+') ? (
                  <>{value.slice(0, -1)}<b>+</b></>
                ) : value.endsWith('%') ? (
                  <>{value.slice(0, -1)}<b>%</b></>
                ) : (
                  value
                )}
              </strong>
              <span>{label}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="um26-section" id="servicios-it">
      <div class="um26-shell">
        <div class="um26-section__head">
          <div>
            <p class="um26-kicker"><span></span>Servicios</p>
            <h2>Ocho frentes de servicio IT.</h2>
          </div>
          <p>Un mismo equipo releva, instala y sostiene cada sistema, de la obra a la operación diaria.</p>
        </div>

        <ServicesStory services={services} />

        <a class="um26-text-link" href="/servicios">Ver los ocho servicios</a>
      </div>
    </section>

    <section class="um26-section um26-section--band" id="sectores">
      <div class="um26-shell">
        <div class="um26-section__head">
          <div>
            <p class="um26-kicker"><span></span>Sectores</p>
            <h2>Infraestructura IT por sector.</h2>
          </div>
          <p>Entrá por su sector y revisá casos comparables antes de contratar.</p>
        </div>

        <SectorAtlas sectors={sectors} />
      </div>
    </section>

    <section class="um26-section" id="antecedentes-home">
      <div class="um26-shell">
        <div class="um26-section__head">
          <div>
            <p class="um26-kicker"><span></span>Proyectos</p>
            <h2>Proyectos que respaldan cada propuesta.</h2>
          </div>
          <p>{getAntecedentesCatalogCount()} proyectos documentados con cliente, sector, servicios aplicados y alcance técnico.</p>
        </div>

        <div class="um26-case-grid" data-rail="Proyectos destacados">
          {cases.map((item) => (
            <a class="um26-media-card um26-case-card" href={item.href}>
              <img src={item.image} alt="" width="1200" height="900" loading="lazy" decoding="async" />
              <span class="um26-media-card__code">#{item.id}</span>
              <span class="um26-media-card__ai">Imagen ilustrativa</span>
              <div>
                <p>{item.meta}</p>
                <h3>{item.title}</h3>
                <small>{item.sector}</small>
              </div>
              <span class="um26-card-bar" aria-hidden="true"></span>
            </a>
          ))}
        </div>

        <a class="um26-btn um26-btn--red um26-section__cta" href="/antecedentes">Explorar los {getAntecedentesCatalogCount()} proyectos</a>
      </div>
    </section>

    <section class="um26-section um26-section--band" id="empresa">
      <div class="um26-shell">
        <CompanyBand />
      </div>
    </section>

    <section class="um26-section" id="producto">
      <div class="um26-shell">
        <ProductBand />
      </div>
    </section>

    <section class="um26-section um26-section--band" id="cobertura">
      <div class="um26-shell">
        <div class="um26-section__head">
          <div>
            <p class="um26-kicker"><span></span>Cobertura</p>
            <h2>Cobertura en Cuyo y Patagonia.</h2>
          </div>
          <p>Sede central en Mendoza, al pie de los Andes, y sedes en San Juan, San Luis y Neuquén.</p>
        </div>
        <CoverageMap hubs={hubs} />
      </div>
    </section>

    <section class="um26-section" id="blog-home">
      <div class="um26-shell">
        <JournalBand />
      </div>
    </section>

    <section class="um26-contact">
      <div class="um26-shell">
        <div class="um26-contact__panel">
          <div>
            <p class="um26-kicker"><span></span>Contacto rápido</p>
            <h2>Ordenemos su infraestructura y su continuidad operativa.</h2>
            <p>Respondemos en el día con un relevamiento técnico y una propuesta verificable. Sin compromiso inicial.</p>
          </div>
          <div>
            <a class="um26-btn um26-btn--red" href="/contacto" data-contact-open>Escribinos</a>
            <EmailLink class="um26-contact__mail" subject="Consulta desde la web ULTIMA MILLA" />
            <span>Lunes a viernes, 8 a 18 h</span>
          </div>
        </div>
      </div>
    </section>
  </div>
  <SnapRail />

  <style>
    :global(body[data-skin]) main {
      background: #0a0a0b;
    }

    .um26-home {
      background: #0a0a0b;
      color: #fafafa;
      font-family: var(--um-font-body);
    }

    .um26-shell {
      width: min(var(--um-container-wide), calc(100% - (var(--um-page-gutter) * 2)));
      margin-inline: auto;
    }

    .um26-hero {
      position: relative;
      min-height: min(780px, calc(100svh - 64px));
      overflow: hidden;
      display: flex;
      align-items: flex-end;
      background: #0a0a0b;
      isolation: isolate;
    }

    .um26-hero__image,
    .um26-hero__veil {
      position: absolute;
      inset: 0;
    }

    .um26-hero__image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      z-index: -3;
    }

    .um26-hero__veil {
      z-index: -2;
      background:
        linear-gradient(105deg, rgba(10, 10, 11, 0.94) 0%, rgba(10, 10, 11, 0.6) 42%, rgba(10, 10, 11, 0.3) 100%),
        linear-gradient(to top, #0a0a0b 0%, rgba(10, 10, 11, 0.55) 50%, transparent 100%);
    }

    .um26-hero__top {
      position: absolute;
      top: 20px;
      left: 50%;
      transform: translateX(-50%);
      width: min(1400px, calc(100% - 64px));
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      color: rgba(255, 255, 255, 0.52);
      font-family: var(--um-font-mono);
      font-size: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      z-index: 2;
    }

    .um26-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      color: rgba(255, 255, 255, 0.74);
      background: rgba(10, 10, 11, 0.42);
    }

    .um26-chip span,
    .um26-hub-grid p span {
      width: 7px;
      height: 7px;
      background: #dc2626;
      display: inline-block;
    }

    .um26-hero__metric {
      position: absolute;
      right: 32px;
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: #fff;
      z-index: 2;
    }

    .um26-hero__metric span {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-size: 1rem;
      text-transform: uppercase;
      letter-spacing: 0.25em;
      color: rgba(255, 255, 255, 0.55);
      font-family: var(--um-font-mono);
    }

    .um26-hero__metric strong {
      font-family: var(--um-font-display);
      font-size: 7rem;
      line-height: 0.8;
      letter-spacing: var(--um-display-tracking);
      text-shadow: 0 20px 55px rgba(0, 0, 0, 0.65);
    }

    .um26-hero__metric b {
      color: #dc2626;
      font-weight: inherit;
    }

    .um26-hero__metric i {
      width: 1px;
      height: 56px;
      background: linear-gradient(to bottom, #dc2626, transparent);
    }

    .um26-hero__shuffle {
      position: absolute;
      top: 64px;
      right: 32px;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-family: var(--um-font-mono);
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: rgba(10, 10, 11, 0.72);
      backdrop-filter: blur(8px);
      padding: 10px 13px;
      color: rgba(255, 255, 255, 0.78);
      text-transform: uppercase;
      letter-spacing: 0.16em;
      font-size: 1rem;
      z-index: 2;
      cursor: pointer;
      opacity: 0;
      transform: translateY(14px);
      animation: um26FadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.42s forwards;
    }

    .um26-home .um26-hero__shuffle,
    .um26-home .um26-hero__shuffle * {
      font-size: 1rem !important;
      line-height: 1 !important;
      white-space: nowrap;
      text-wrap: nowrap;
    }

    .um26-hero__shuffle:hover {
      border-color: rgba(220, 38, 38, 0.78);
      color: #fff;
    }

    .um26-hero__shuffle-icon {
      color: #dc2626;
      font-size: 1rem !important;
      line-height: 1;
    }

    .um26-hero__shuffle b {
      color: #dc2626;
      font-weight: 600;
      border-left: 1px solid rgba(255, 255, 255, 0.16);
      padding-left: 10px;
    }

    .um26-hero__variant {
      position: absolute;
      top: 0;
      right: 16px;
      z-index: 3;
      display: inline-flex;
      align-items: center;
      border: 1px solid rgba(255, 255, 255, 0.14);
      background: rgba(10, 10, 11, 0.72);
      backdrop-filter: blur(8px);
      color: rgba(255, 255, 255, 0.45);
      font-family: var(--um-font-mono);
      font-size: 1rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .um26-hero__variant span,
    .um26-hero__variant b {
      display: inline-flex;
      align-items: center;
      min-height: 24px;
      padding: 0 10px;
      border-left: 1px solid rgba(255, 255, 255, 0.1);
      font-weight: 500;
    }

    .um26-hero__variant span:first-child {
      border-left: 0;
    }

    .um26-hero__variant b {
      background: #dc2626;
      color: #fff;
      font-weight: 700;
    }

    .um26-hero__body {
      position: relative;
      z-index: 1;
      padding-block: 0 64px;
    }

    @media (min-width: 640px) {
      .um26-hero__body {
        padding-bottom: 70px;
      }
    }

    .um26-kicker {
      display: inline-flex;
      align-items: center;
      gap: 14px;
      margin: 0 0 24px;
      color: #dc2626;
      font-family: var(--um-font-mono);
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .um26-home .um26-kicker {
      font-size: 1rem !important;
    }

    .um26-kicker span {
      display: inline-block;
      width: 44px;
      height: 3px;
      background: #dc2626;
    }

    .um26-hero h1,
    .um26-section h2,
    .um26-contact h2 {
      margin: 0;
      font-family: var(--um-font-display);
      font-weight: 700;
      letter-spacing: var(--um-display-tracking);
      line-height: 0.94;
      color: #fff;
    }

    .um26-hero h1 {
      max-width: 18ch;
      min-height: 0;
      font-size: clamp(3.25rem, 4.6vw, 3.625rem) !important;
      line-height: 1.04;
      --um-hero-title-weight: 700;
      font-family: var(--um-font-display) !important;
      font-weight: var(--um-hero-title-weight) !important;
      letter-spacing: -0.018em !important;
      text-shadow: none;
      text-wrap: normal !important;
      overflow-wrap: normal !important;
      word-break: normal !important;
      hyphens: none;
    }

    .um26-hero h1 > span {
      display: block;
      opacity: 0;
      transform: translateY(18px);
      animation: um26FadeUp 0.72s cubic-bezier(0.22, 1, 0.36, 1) 0.26s forwards;
    }

    .um26-hero__line {
      display: inline;
    }

    [data-hero-reveal] {
      opacity: 0;
      transform: translateY(18px);
      animation: um26FadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) var(--d, 0ms) forwards;
    }

    @keyframes um26FadeUp {
      to {
        opacity: 1;
        transform: translateY(0);
      }
    }

    .um26-hero__lead {
      max-width: 42rem;
      margin: 28px 0 0;
      color: rgba(255, 255, 255, 0.82);
      font-size: var(--um-copy-lead);
      line-height: 1.625;
    }

    .um26-hero__actions {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      margin-top: 36px;
    }

    .um26-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 52px;
      padding: 0 24px;
      color: #fff;
      text-decoration: none;
      font-weight: 700;
      font-size: 1rem;
      line-height: 1.2;
      letter-spacing: 0;
      transition: background 0.18s ease, border-color 0.18s ease;
    }

    .um26-text-link::after {
      content: "→";
      margin-left: 10px;
      color: currentColor;
    }

    .um26-btn svg {
      flex: 0 0 auto;
      color: currentColor;
    }

    .um26-btn--red {
      background: #dc2626;
      border: 1px solid #dc2626;
    }

    .um26-btn--red:hover {
      background: #b91c1c;
      border-color: #b91c1c;
    }

    .um26-btn--ghost {
      background: rgba(10, 10, 11, 0.32);
      border: 1px solid rgba(255, 255, 255, 0.28);
    }

    .um26-btn--ghost:hover {
      border-color: rgba(255, 255, 255, 0.58);
      background: rgba(255, 255, 255, 0.08);
    }

    .um26-sector-card:hover,
    .um26-sector-card:focus-visible {
      border-color: rgba(220, 38, 38, 0.72) !important;
