---
/**
 * Homepage V4 Design System
 * Main landing page with hero, services, cases, industries, and CTA
 */

import LayoutV4 from '../layouts/LayoutV4.astro';
import ServiceCard from '../components/v4/ServiceCard.astro';
import CTASection from '../components/v4/CTASection.astro';
import { generateSlug } from '../utils/slugUtils.js';
import { getAllServicios } from '../utils/directusHelpers';
import { getDirectusImageUrl, getAllAntecedentes, getHeroHomeImages, withBase } from '../lib/directus.ts';
import { serviceBadgeMap, serviceToSectorMap } from '../data/serviceBadgeMap';
import { getSectorColors } from '../data/colorSystem';

// Hero images — use local service images (works on both production and GitHub Pages)
const heroImages = [
  { url: withBase('/images/services/servicio-101-infraestructura.jpg'), alt: 'Infraestructura de Redes' },
  { url: withBase('/images/services/servicio-102-seguridad.jpg'), alt: 'Seguridad Electrónica' },
  { url: withBase('/images/services/servicio-103-telecomunicaciones.jpg'), alt: 'Telecomunicaciones' },
  { url: withBase('/images/services/servicio-104-software.jpg'), alt: 'Desarrollo de Software' },
  { url: withBase('/images/services/servicio-106-consultoria.jpg'), alt: 'Consultoría IT' },
];

// Get 3 featured antecedentes from Directus (con fallback a snapshot JSON)
let antecedentesData: any[] = [];
try {
  antecedentesData = await getAllAntecedentes();
} catch {
  antecedentesData = [];
}

const antecedentesEnhanced = antecedentesData.slice(0, 3).map((ant: any) => ({
  ...ant,
  slug: generateSlug(ant.Titulo || ant.Nombre || 'proyecto'),
  imageUrl: getDirectusImageUrl(ant.Imagen) || '/images/default-background.jpg'
}));

// Get services from Directus (with automatic fallback to JS data)
const serviciosFromDirectus = await getAllServicios();

// Map icon names for ServiceCard component
const iconMap: Record<number, { icon: string; iconColor: string }> = {
  101: { icon: 'network', iconColor: 'bg-sky-600/90' },
  102: { icon: 'shield', iconColor: 'bg-rose-600/90' },
  103: { icon: 'radio', iconColor: 'bg-cyan-600/90' },
  104: { icon: 'code', iconColor: 'bg-purple-600/90' },
  105: { icon: 'headphones', iconColor: 'bg-amber-600/90' },
  106: { icon: 'lightbulb', iconColor: 'bg-emerald-600/90' },
  107: { icon: 'flame', iconColor: 'bg-orange-600/90' },
  108: { icon: 'zap', iconColor: 'bg-yellow-600/90' }
};

// Enhance services with badges, colors, icons - ALL from Directus
const servicios = serviciosFromDirectus.slice(0, 8).map(s => {
  const sector = serviceToSectorMap[s.id] || 'tecnologia';
  const colors = getSectorColors(sector);

  return {
    ...s,
    ...iconMap[s.id],
    slug: s.slug || generateSlug(s.Titulo),
    badge: serviceBadgeMap[s.id] || 'Tecnología',
    badgeColor: colors.icon
  };
});

// Industries/Sectors data with pseudomorphic emojis
// WebSite schema with SearchAction for sitelinks search box
const websiteSchema = {
  "@type": "WebSite",
  "name": "ULTIMA MILLA",
  "url": "https://ultimamilla.com.ar",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://ultimamilla.com.ar/antecedentes?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

const sectores = [
  { slug: 'aeropuertos', name: 'Aeropuertos', emoji: '✈️', color: '#0ea5e9' },
  { slug: 'bodegas', name: 'Bodegas', emoji: '🍷', color: '#a855f7' },
  { slug: 'constructoras', name: 'Construcción', emoji: '🏗️', color: '#f59e0b' },
  { slug: 'salud', name: 'Salud', emoji: '🏥', color: '#22c55e' },
  { slug: 'gobiernosectorpublico', name: 'Gobierno', emoji: '🏛️', color: '#10b981' },
  { slug: 'software', name: 'Software', emoji: '💻', color: '#6366f1' },
  { slug: 'mineria', name: 'Minería', emoji: '⛏️', color: '#f97316' },
  { slug: 'industria', name: 'Industria', emoji: '🏭', color: '#64748b' },
  { slug: 'seguridad-electronica', name: 'Seguridad', emoji: '🔒', color: '#06b6d4' }
];
---

<LayoutV4
  title="ULTIMA MILLA | Servicios Tecnológicos para Empresas en Mendoza, Cuyo y Patagonia"
  description="Servicios tecnológicos para empresas y organizaciones argentinas. Zona de incumbencia: Mendoza, Cuyo, Patagonia. Especialistas en Telecomunicaciones, Cableado Estructurado, Corrientes Débiles, Detección de Incendio, Software a Medida. +469 proyectos, +22 años de experiencia."
  keywords="servicios tecnologicos empresas argentina, zona incumbencia mendoza cuyo patagonia, telecomunicaciones empresas, cableado estructurado, corrientes debiles, deteccion incendio, software a medida organizaciones"
  image="/nosotros-tech.jpg"
  structuredData={websiteSchema}
>
  <!-- HERO SECTION — Modern CSS: parallax, animated gradient, scroll-driven stats -->
  <section class="relative bg-um-dark overflow-hidden min-h-[85vh] flex items-center">
    <!-- Background Images Container (rotating + parallax) -->
    <div class="absolute inset-0 hero-parallax" id="heroImageContainer">
      {heroImages.map((img, index) => (
        <img
          src={img.url}
          alt={img.alt}
          class={`hero-image absolute inset-0 w-full h-full object-cover transition-opacity duration-1000 ${index === 0 ? 'opacity-80' : 'opacity-0'}`}
          data-index={index}
          onerror="this.onerror=null;this.src='/images/default-background.jpg'"
        />
      ))}
      <!-- Animated gradient overlay (powered by @property) -->
      <div class="absolute inset-0 hero-gradient-animated"></div>
      <div class="absolute inset-0 bg-gradient-to-r from-um-dark/90 via-um-dark/60 to-um-dark/30"></div>
    </div>

    <!-- Content -->
    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-20 sm:pt-24 pb-10 sm:pb-14 lg:pb-16 w-full">
      <!-- Badge (glow pulse) -->
      <span class="inline-flex items-center gap-2 px-3 sm:px-4 py-1.5 sm:py-2 bg-um-primary/20 text-um-primary-light rounded-full text-xs sm:text-sm font-semibold mb-4 sm:mb-5 glow-pulse scroll-reveal">
        <svg class="w-3.5 h-3.5 sm:w-4 sm:h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        22+ Años Transformando Empresas
      </span>

      <!-- Title (text-wrap: balance) -->
      <h1 class="text-[1.85rem] sm:text-4xl md:text-5xl lg:text-6xl font-extrabold text-white leading-[1.1] mb-4 sm:mb-5 max-w-3xl text-balance">
        Conectamos la <span class="text-um-primary-light">tecnología</span> con el éxito de su empresa
      </h1>

      <!-- Subtitle (text-wrap: pretty) -->
      <p class="text-sm sm:text-base lg:text-lg text-gray-300 mb-6 sm:mb-8 max-w-xl leading-relaxed text-pretty">
        Infraestructura IT, seguridad electrónica y desarrollo de software para empresas de Mendoza, Cuyo y Patagonia.
      </p>

      <!-- CTAs -->
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 mb-8 sm:mb-10">
        <a href={withBase("/contacto")} class="group inline-flex items-center justify-center gap-2 px-6 py-3.5 sm:px-8 sm:py-4 bg-um-accent hover:bg-red-600 text-white text-sm sm:text-base font-bold rounded-xl transition-all shadow-xl shadow-um-accent/30 hover:scale-[1.02] min-h-[48px]" transition:name="cta-primary">
          Solicitar Consultoría Gratis
          <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href={withBase("/antecedentes")} class="inline-flex items-center justify-center gap-2 px-6 py-3.5 sm:px-8 sm:py-4 bg-white/10 hover:bg-white/20 backdrop-blur-sm border border-white/20 text-white text-sm sm:text-base font-semibold rounded-xl transition-all min-h-[48px]">
          <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M8 5v14l11-7z"/></svg>
          Ver Proyectos
        </a>
      </div>

      <!-- Stats Cards (scroll-driven counter pop animation) -->
      <div class="grid grid-cols-3 gap-3 sm:gap-4 max-w-lg">
        <div class="bg-white/5 backdrop-blur-sm rounded-xl p-3 sm:p-4 text-center border border-white/10 scroll-counter glow-pulse" style="animation-delay: 0s;">
          <div class="text-xl sm:text-2xl lg:text-3xl font-black text-white">469+</div>
          <div class="text-[10px] sm:text-xs text-gray-400 uppercase tracking-wide">Proyectos</div>
        </div>
        <div class="bg-white/5 backdrop-blur-sm rounded-xl p-3 sm:p-4 text-center border border-white/10 scroll-counter" style="animation-delay: 0.1s;">
          <div class="text-xl sm:text-2xl lg:text-3xl font-black text-white">22</div>
          <div class="text-[10px] sm:text-xs text-gray-400 uppercase tracking-wide">Años</div>
        </div>
        <div class="bg-white/5 backdrop-blur-sm rounded-xl p-3 sm:p-4 text-center border border-white/10 scroll-counter" style="animation-delay: 0.2s;">
          <div class="text-xl sm:text-2xl lg:text-3xl font-black text-um-primary-light">24/7</div>
          <div class="text-[10px] sm:text-xs text-gray-400 uppercase tracking-wide">Soporte</div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES SECTION — Modern CSS: scroll-reveal, spotlight cards, :has() dimming -->
  <section class="py-12 sm:py-16 lg:py-24 xl:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Section Header (scroll reveal) -->
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 sm:gap-6 mb-8 sm:mb-12 lg:mb-16 scroll-reveal">
        <div>
          <span class="text-um-primary font-semibold text-xs sm:text-sm uppercase tracking-wider">Nuestros Servicios</span>
          <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-um-dark mt-2 sm:mt-3 text-balance">
            Soluciones Integrales IT
          </h2>
        </div>
        <a href={withBase("/servicios")} class="inline-flex items-center gap-2 text-um-primary font-semibold hover:gap-4 transition-all text-sm sm:text-base">
          Ver todos los servicios
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>

      <!-- Services Grid (:has() dims non-hovered cards) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 sm:gap-6 cards-grid">
        {servicios.map((servicio, i) => (
          <div class="scroll-reveal spotlight-card" style={`animation-delay: ${i * 0.05}s; --vt-name: service-${servicio.id};`}>
            <ServiceCard
              id={servicio.id}
              slug={servicio.slug}
              titulo={servicio.Titulo}
              descripcion={servicio.Descripcion}
              imagen={servicio.Imagen}
              badge={servicio.badge}
              badgeColor={servicio.badgeColor}
              cliente={servicio.Cliente}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SUCCESS CASES SECTION -->
  <section class="py-12 sm:py-16 lg:py-24 xl:py-28 bg-um-gray-light">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-8 sm:mb-12 lg:mb-16 scroll-reveal">
        <span class="text-um-primary font-semibold text-xs sm:text-sm uppercase tracking-wider">Casos de Éxito</span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-um-dark mt-2 sm:mt-3 mb-3 sm:mb-4 text-balance">
          Proyectos que nos Enorgullecen
        </h2>
        <p class="text-base sm:text-lg text-um-gray">
          Empresas líderes de la región confían en nosotros para su transformación digital.
        </p>
      </div>

      <!-- Cases Grid (scroll reveal staggered) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8 cards-grid">
        {antecedentesEnhanced.map((antecedente, i) => (
          <a href={withBase(`/antecedentes/${antecedente.id}/${antecedente.slug}`)} class="card-hover spotlight-card bg-white rounded-2xl overflow-hidden shadow-sm border border-gray-100 scroll-reveal" style={`animation-delay: ${i * 0.1}s`}>
            <div class="relative h-56 overflow-hidden">
              <img
                src={antecedente.imageUrl}
                alt={antecedente.Titulo || antecedente.Nombre}
                class="w-full h-full object-cover transition-transform duration-700"
                loading="lazy"
                onerror="this.onerror=null;this.src='/images/default-background.jpg'"
              />
              <span class="absolute top-4 left-4 px-3 py-1 bg-um-primary text-white text-xs font-bold rounded-md">
                {antecedente.Cliente || antecedente.Sector || 'Proyecto'}
              </span>
            </div>
            <div class="p-6">
              <h3 class="text-lg font-bold text-um-dark mb-2 line-clamp-2">{antecedente.Titulo || antecedente.Nombre}</h3>
              <p class="text-sm text-um-gray mb-4 line-clamp-2">{antecedente.Descripcion?.replace(/\\\\/g, ' ').substring(0, 100)}...</p>
              <span class="text-um-primary text-sm font-medium flex items-center gap-2">
                Ver caso completo
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                </svg>
              </span>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-8 sm:mt-12 text-center">
        <a href={withBase("/antecedentes")} class="inline-flex items-center gap-2 px-6 py-3 sm:px-8 sm:py-4 bg-um-dark text-white font-bold rounded-xl hover:bg-um-primary transition-colors min-h-[48px]">
          Ver todos los casos
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- INDUSTRIES SECTION -->
  <section class="py-12 sm:py-16 lg:py-24 xl:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-3xl mx-auto mb-8 sm:mb-12 lg:mb-16 scroll-reveal">
        <span class="text-um-primary font-semibold text-xs sm:text-sm uppercase tracking-wider">Verticales</span>
        <h2 class="text-2xl sm:text-3xl lg:text-4xl font-bold text-um-dark mt-2 sm:mt-3 mb-3 sm:mb-4 text-balance">
          Soluciones por Industria
        </h2>
        <p class="text-base sm:text-lg text-um-gray">
          Experiencia especializada en los sectores más exigentes de la economía regional.
        </p>
      </div>

      <div class="grid grid-cols-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-9 gap-3 sm:gap-4">
        {sectores.map((sector, i) => (
          <a href={withBase(`/${sector.slug}`)} class="sector-icon group flex flex-col items-center p-4 bg-gray-50 rounded-xl hover:shadow-lg transition-all min-h-[90px] scroll-reveal-scale" style={`--sector-color: ${sector.color}; animation-delay: ${i * 0.04}s`}>
            <span class="text-2xl sm:text-3xl mb-1">{sector.emoji}</span>
            <span class="text-xs font-medium text-um-dark group-hover:text-white text-center transition-colors">{sector.name}</span>
          </a>
        ))}
      </div>

      <div class="mt-6 sm:mt-10 text-center">
        <a href={withBase("/sectores")} class="inline-flex items-center gap-2 text-um-primary font-semibold hover:gap-4 transition-all text-sm sm:text-base">
          Ver todas las industrias
          <svg class="w-4 h-4 sm:w-5 sm:h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- CTA SECTION — animated gradient border + scroll reveal -->
  <section class="relative py-12 sm:py-16 lg:py-24 xl:py-28 overflow-hidden scroll-reveal">
    <div class="absolute inset-0">
      <img
        src="https://ultimamilla.com.ar/directus-assets/caffbcaa-2457-4fc9-9960-2e0601f27736"
        alt="Background"
        class="w-full h-full object-cover"
      />
      <div class="absolute inset-0 bg-um-dark/90"></div>
    </div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <span class="inline-flex items-center gap-2 px-3 sm:px-4 py-1.5 sm:py-2 bg-white/10 backdrop-blur text-white rounded-full text-xs sm:text-sm font-medium mb-4 sm:mb-6">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>
        </svg>
        Comience su transformación
      </span>
      <h2 class="text-2xl sm:text-3xl lg:text-4xl xl:text-5xl font-bold text-white mb-4 sm:mb-6 text-balance">
        ¿Listo para modernizar su infraestructura IT?
      </h2>
      <p class="text-base sm:text-lg lg:text-xl text-gray-300 mb-6 sm:mb-10 max-w-2xl mx-auto">
        Contáctenos hoy para una consultoría gratuita y descubra cómo podemos impulsar su negocio.
      </p>
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 justify-center">
        <a href={withBase("/contacto")} class="px-6 py-3 sm:px-8 sm:py-4 bg-um-accent text-white font-bold rounded-xl hover:bg-um-accent-dark transition-colors shadow-xl shadow-um-accent/25 min-h-[48px] flex items-center justify-center">
          Agendar Consultoría Gratis
        </a>
        <a href="mailto:contacto@ultimamilla.com.ar" class="px-6 py-3 sm:px-8 sm:py-4 border-2 border-white text-white font-bold rounded-xl hover:bg-white/10 transition-colors flex items-center justify-center gap-2 min-h-[48px]">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
          </svg>
          contacto@ultimamilla.com.ar
        </a>
      </div>
    </div>
  </section>

  <!-- Hero Image Rotation + Spotlight Card Mouse Tracking -->
  <script>
    document.addEventListener('DOMContentLoaded', () => {
      // Hero image rotation
      const images = document.querySelectorAll('.hero-image');
      if (images.length > 1) {
        let currentIndex = 0;
        setInterval(() => {
          images[currentIndex].classList.remove('opacity-80');
          images[currentIndex].classList.add('opacity-0');
          currentIndex = (currentIndex + 1) % images.length;
          images[currentIndex].classList.remove('opacity-0');
          images[currentIndex].classList.add('opacity-80');
        }, 5000);
      }

      // Spotlight card mouse tracking (updates CSS custom properties)
      document.querySelectorAll('.spotlight-card').forEach(card => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const x = ((e.clientX - rect.left) / rect.width * 100).toFixed(1);
          const y = ((e.clientY - rect.top) / rect.height * 100).toFixed(1);
          card.style.setProperty('--spotlight-x', x + '%');
          card.style.setProperty('--spotlight-y', y + '%');
        });
      });
    });
  </script>

  <style>
    .sector-icon:hover {
      background-color: var(--sector-color);
    }
  </style>
</LayoutV4>
