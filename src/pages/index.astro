---
/**
 * Homepage V6 Dark Premium + White Content Design System
 * Dark hero, white content sections, zero sky-blue
 */

import LayoutV4 from '../layouts/LayoutV4.astro';
import ServiceCard from '../components/v4/ServiceCard.astro';
import CTASection from '../components/v4/CTASection.astro';
import { generateSlug } from '../utils/slugUtils.js';
import { getAllServicios } from '../utils/directusHelpers';
import { getDirectusImageUrl, getAllAntecedentes, getHeroHomeImages } from '../lib/directus.ts';
import { serviceBadgeMap, serviceToSectorMap } from '../data/serviceBadgeMap';

// Get 3 featured antecedentes from Directus
let antecedentesData: any[] = [];
try {
  antecedentesData = await getAllAntecedentes();
} catch {
  antecedentesData = [];
}

const antecedentesEnhanced = antecedentesData.slice(0, 3).map((ant: any) => ({
  ...ant,
  slug: generateSlug(ant.Titulo || ant.Nombre || 'proyecto'),
  imageUrl: getDirectusImageUrl(ant.Imagen) || '/images/default-background.jpg'
}));

// Get services from Directus
const serviciosFromDirectus = await getAllServicios();

const iconMap: Record<number, { icon: string }> = {
  101: { icon: 'network' },
  102: { icon: 'shield' },
  103: { icon: 'radio' },
  104: { icon: 'code' },
  105: { icon: 'headphones' },
  106: { icon: 'settings' },
  107: { icon: 'flame' },
  108: { icon: 'zap' }
};

const servicios = serviciosFromDirectus.slice(0, 8).map(s => ({
  ...s,
  ...iconMap[s.id],
  slug: s.slug || generateSlug(s.Titulo),
  badge: serviceBadgeMap[s.id] || 'Tecnología',
}));

// WebSite schema
const websiteSchema = {
  "@type": "WebSite",
  "name": "ULTIMA MILLA",
  "url": "https://ultimamilla.com.ar",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://ultimamilla.com.ar/antecedentes?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

// Sectors with SVG icon paths
const sectores = [
  { slug: 'aeropuertos', name: 'Aeropuertos', icon: 'M9.813 15.904L9 18.75l-.813-2.846a4.5 4.5 0 00-3.09-3.09L2.25 12l2.846-.813a4.5 4.5 0 003.09-3.09L9 5.25l.813 2.846a4.5 4.5 0 003.09 3.09L15.75 12l-2.846.813a4.5 4.5 0 00-3.09 3.09z' },
  { slug: 'bodegas', name: 'Bodegas', icon: 'M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z' },
  { slug: 'constructoras', name: 'Construcción', icon: 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4' },
  { slug: 'salud', name: 'Salud', icon: 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z' },
  { slug: 'gobiernosectorpublico', name: 'Gobierno', icon: 'M12 21v-8.25M15.75 21v-8.25M8.25 21v-8.25M3 9l9-6 9 6m-1.5 12V10.332A48.36 48.36 0 0012 9.75c-2.551 0-5.056.2-7.5.582V21' },
  { slug: 'software', name: 'Software', icon: 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4' },
  { slug: 'mineria', name: 'Minería', icon: 'M3.75 13.5l10.5-11.25L12 10.5h8.25L9.75 21.75 12 13.5H3.75z' },
  { slug: 'industria', name: 'Industria', icon: 'M4.5 12a7.5 7.5 0 0015 0m-15 0a7.5 7.5 0 1115 0m-15 0H3m16.5 0H21m-1.5 0H12m-8.457 3.077l1.41-.513m14.095-5.13l1.41-.513M5.106 17.785l1.15-.964m11.49-9.642l1.149-.964M7.501 19.795l.75-1.3m7.5-12.99l.75-1.3m-6.063 16.658l.26-1.477m2.605-14.772l.26-1.477m0 17.726l-.26-1.477M10.698 4.614l-.26-1.477M16.5 19.794l-.75-1.299M7.5 4.205L12 12' },
  { slug: 'seguridad-electronica', name: 'Seguridad', icon: 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z' }
];
---

<LayoutV4
  title="ULTIMA MILLA | Servicios Tecnológicos para Empresas en Mendoza, Cuyo y Patagonia"
  description="Servicios tecnológicos para empresas y organizaciones argentinas. Zona de incumbencia: Mendoza, Cuyo, Patagonia. Especialistas en Telecomunicaciones, Cableado Estructurado, Corrientes Débiles, Detección de Incendio, Software a Medida. +469 proyectos, +22 años de experiencia."
  keywords="servicios tecnologicos empresas argentina, zona incumbencia mendoza cuyo patagonia, telecomunicaciones empresas, cableado estructurado, corrientes debiles, deteccion incendio, software a medida organizaciones"
  image="/nosotros-tech.jpg"
  structuredData={websiteSchema}
>
  <!-- HERO — Cinematic Full-Impact -->
  <section class="relative overflow-hidden bg-gray-900 min-h-[85vh] flex items-center">
    <!-- Atmospheric effects -->
    <div class="hero-glow"></div>
    <div class="hero-grid"></div>
    <!-- Animated gradient orb -->
    <div class="absolute -top-40 -right-40 w-[600px] h-[600px] rounded-full opacity-[0.07] blur-[100px] animate-pulse-slow" style="background: radial-gradient(circle, #DC2626, transparent 70%);"></div>
    <div class="absolute -bottom-20 -left-20 w-[400px] h-[400px] rounded-full opacity-[0.04] blur-[80px]" style="background: radial-gradient(circle, #3B82F6, transparent 70%);"></div>

    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-8 sm:pt-16 lg:pt-20 pb-16 sm:pb-24 lg:pb-28 w-full">
      <!-- Overline -->
      <div class="reveal mb-6 sm:mb-8">
        <span class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.2em] text-gray-500">
          <span class="w-8 h-px bg-um-primary"></span>
          Servicios Tecnológicos
        </span>
      </div>

      <!-- Title — Massive Syne typography -->
      <h1 class="text-fluid-display text-white max-w-5xl mb-8 reveal" style="text-wrap: balance;">
        Conectamos la<br class="hidden sm:block" />
        <span class="text-gradient-red">tecnología</span> con<br class="hidden lg:block" />
        el éxito de su empresa
      </h1>

      <!-- Subtitle -->
      <p class="text-base sm:text-lg lg:text-xl text-gray-400 mb-10 sm:mb-14 max-w-xl leading-relaxed reveal">
        Infraestructura IT, seguridad electrónica y desarrollo de software para empresas de Mendoza, Cuyo y Patagonia.
      </p>

      <!-- CTAs — more dramatic -->
      <div class="flex flex-col sm:flex-row gap-3 sm:gap-4 mb-16 sm:mb-20 reveal">
        <a href="/contacto" class="group relative inline-flex items-center justify-center gap-2 px-8 py-4 bg-um-primary hover:bg-red-700 text-white text-sm font-semibold rounded-xl transition-all duration-300 shadow-red hover:shadow-red-lg min-h-[52px] overflow-hidden">
          <span class="relative z-10">Solicitar Consultoría Gratis</span>
          <svg class="relative z-10 w-4 h-4 transition-transform duration-300 ease-spring group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
        <a href="/antecedentes" class="inline-flex items-center justify-center gap-2 px-8 py-4 border border-gray-600 text-gray-300 text-sm font-semibold rounded-xl hover:text-white hover:border-gray-400 transition-all min-h-[52px]">
          Ver 469+ Proyectos
        </a>
      </div>

      <!-- Stats — with accent borders -->
      <div class="flex flex-wrap items-start gap-10 sm:gap-16 reveal">
        <div class="relative pl-4 border-l-2 border-um-primary/40">
          <div class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white font-mono" style="font-family:'JetBrains Mono',monospace;">469+</div>
          <div class="text-[11px] text-gray-500 uppercase tracking-[0.15em] mt-1.5">Proyectos entregados</div>
        </div>
        <div class="relative pl-4 border-l-2 border-gray-700">
          <div class="text-3xl sm:text-4xl lg:text-5xl font-bold text-white font-mono" style="font-family:'JetBrains Mono',monospace;">22+</div>
          <div class="text-[11px] text-gray-500 uppercase tracking-[0.15em] mt-1.5">Años de experiencia</div>
        </div>
        <div class="relative pl-4 border-l-2 border-gray-700">
          <div class="text-3xl sm:text-4xl lg:text-5xl font-bold text-um-primary font-mono" style="font-family:'JetBrains Mono',monospace;">24/7</div>
          <div class="text-[11px] text-gray-500 uppercase tracking-[0.15em] mt-1.5">Soporte continuo</div>
        </div>
      </div>
    </div>
  </section>

  <!-- SERVICES SECTION — Editorial layout -->
  <section class="section-padding bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12 sm:mb-16">
        <div class="reveal max-w-2xl">
          <span class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.2em] text-gray-400 mb-4">
            <span class="w-8 h-px bg-um-primary"></span>
            Servicios
          </span>
          <h2 class="text-fluid-title text-gray-900">
            Soluciones que<br class="hidden sm:block" /> transforman industrias
          </h2>
        </div>
        <a href="/servicios" class="group inline-flex items-center gap-2 text-gray-900 font-medium text-sm hover:text-um-primary transition-colors reveal">
          Ver todos
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 reveal-stagger">
        {servicios.map((servicio) => (
          <div class="reveal">
            <ServiceCard
              id={servicio.id}
              slug={servicio.slug}
              titulo={servicio.Titulo}
              descripcion={servicio.Descripcion}
              imagen={servicio.Imagen}
              badge={servicio.badge}
              cliente={servicio.Cliente}
              icon={servicio.icon}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- SUCCESS CASES — Dark editorial band -->
  <section class="relative section-padding bg-gray-900 overflow-hidden">
    <div class="hero-glow"></div>
    <div class="hero-grid"></div>
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12 sm:mb-16 reveal">
        <div>
          <span class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.2em] text-gray-500 mb-4">
            <span class="w-8 h-px bg-um-primary"></span>
            Casos de Éxito
          </span>
          <h2 class="text-fluid-title text-white">
            Proyectos que<br class="hidden sm:block" /> hablan por nosotros
          </h2>
        </div>
        <a href="/antecedentes" class="group inline-flex items-center gap-2 text-gray-400 hover:text-white font-medium text-sm transition-colors">
          Ver los 469+ casos
          <svg class="w-4 h-4 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6 reveal-stagger">
        {antecedentesEnhanced.map((antecedente) => (
          <a href={`/antecedentes/${antecedente.id}/${antecedente.slug}`} class="reveal group bg-gray-800/50 rounded-2xl overflow-hidden border border-gray-700/50 hover:border-gray-600 transition-all duration-400 ease-spring hover:-translate-y-1 backdrop-blur-sm">
            <div class="relative aspect-[16/10] overflow-hidden">
              <img
                src={antecedente.imageUrl}
                alt={antecedente.Titulo || antecedente.Nombre}
                class="w-full h-full object-cover transition-transform duration-700 ease-spring group-hover:scale-[1.05] opacity-80 group-hover:opacity-100"
                loading="lazy"
                onerror="this.onerror=null;this.src='/images/default-background.jpg'"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-gray-900/80 via-transparent to-transparent"></div>
            </div>
            <div class="p-5 sm:p-6">
              <span class="text-[10px] font-semibold text-um-primary uppercase tracking-[0.15em]">
                {antecedente.Cliente || antecedente.Sector || 'Proyecto'}
              </span>
              <h3 class="text-base font-display font-bold text-white mt-2 mb-2 line-clamp-2 group-hover:text-um-primary transition-colors" style="font-family:'Syne','Inter',sans-serif;">{antecedente.Titulo || antecedente.Nombre}</h3>
              <p class="text-sm text-gray-400 line-clamp-2 leading-relaxed">{antecedente.Descripcion?.replace(/\\\\/g, ' ').substring(0, 100)}...</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- INDUSTRIES SECTION — Bold grid with hover effects -->
  <section class="section-padding bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12 sm:mb-16 reveal">
        <span class="inline-flex items-center gap-2 text-[11px] font-semibold uppercase tracking-[0.2em] text-gray-400 mb-4">
          <span class="w-8 h-px bg-um-primary"></span>
          Industrias
        </span>
        <h2 class="text-fluid-title text-gray-900">
          Experiencia en los sectores<br class="hidden sm:block" /> más exigentes
        </h2>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-3 gap-3 sm:gap-4 max-w-4xl reveal-stagger">
        {sectores.map((sector) => (
          <a href={`/${sector.slug}`} class="reveal group relative flex items-center gap-4 px-5 py-5 rounded-xl border border-transparent hover:border-gray-200 hover:shadow-medium transition-all duration-300 ease-spring">
            <div class="w-10 h-10 rounded-lg bg-gray-100 group-hover:bg-um-primary/10 flex items-center justify-center transition-colors duration-300 shrink-0">
              <svg class="w-5 h-5 text-gray-400 group-hover:text-um-primary transition-colors duration-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d={sector.icon}/>
              </svg>
            </div>
            <span class="text-sm font-semibold text-gray-700 group-hover:text-gray-900 transition-colors">{sector.name}</span>
            <svg class="w-4 h-4 text-gray-300 group-hover:text-um-primary ml-auto opacity-0 group-hover:opacity-100 transition-all duration-300 translate-x-[-4px] group-hover:translate-x-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA SECTION — Dark variant for contrast -->
  <CTASection
    variant="dark"
    badge="Comience su transformación"
    badgeIcon="rocket"
    titulo="¿Listo para modernizar su infraestructura IT?"
    descripcion="Contáctenos hoy para una consultoría gratuita y descubra cómo podemos impulsar su negocio."
    primaryButtonText="Agendar Consultoría Gratis"
    primaryButtonUrl="/contacto"
    secondaryButtonText="contacto@ultimamilla.com.ar"
    secondaryButtonUrl="mailto:contacto@ultimamilla.com.ar"
    secondaryButtonIcon="mail"
  />
</LayoutV4>
