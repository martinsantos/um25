      color: rgba(255,255,255,0.66);
      font-size: 1rem;
      line-height: 1.55;
    }

    :global(body[data-skin="white"]) main .um-home-hero {
      --skin-hero-bg: #050505;
      --skin-hero-text: #FFFFFF;
      --skin-hero-muted: rgba(255,255,255,0.74);
      --skin-hero-line: rgba(255,255,255,0.18);
      --skin-hero-panel: rgba(255,255,255,0.08);
      --skin-hero-panel-solid: rgba(5,5,5,0.62);
      --skin-hero-wash:
        linear-gradient(90deg, rgba(5,5,5,0.94) 0%, rgba(5,5,5,0.84) 40%, rgba(5,5,5,0.36) 74%, rgba(5,5,5,0.76) 100%),
        linear-gradient(180deg, rgba(5,5,5,0.1) 0%, rgba(5,5,5,0.72) 100%);
    }

    :global(body[data-skin="white"]) main .um-home-hero .um-hero-media {
      opacity: 0.84 !important;
    }

    :global(body[data-skin="white"]) main .um-home-hero .um-hero-media img {
      filter: grayscale(0.16) contrast(1.1) saturate(0.82) !important;
    }

    .um-package-section {
      background: #fff;
      color: #111;
      padding: var(--um-section-y-tight) 0 var(--um-section-y);
      border-bottom: 1px solid var(--um-line);
    }

    .um-package-grid {
      display: grid;
      grid-template-columns: minmax(260px, 0.34fr) minmax(0, 0.66fr);
      gap: clamp(28px, 5vw, 72px);
      align-items: start;
    }

    .um-package-intro {
      position: static;
      max-width: 420px;
    }

    .um-package-intro h2 {
      max-width: 480px;
      margin-top: 24px;
      font-size: clamp(1.95rem, 2.8vw, 3rem);
      line-height: 1.08;
      font-weight: 600;
      color: #000;
      text-wrap: balance;
    }

    .um-package-intro p {
      max-width: 400px;
      margin-top: 18px;
      color: var(--um-gray-700);
      font-size: 1.02rem;
      line-height: 1.62;
    }

    .um-package-list {
      display: grid;
      border-top: 1px solid var(--um-line);
    }

    .um-package-row {
      display: grid;
      grid-template-columns: 44px minmax(170px, 0.3fr) minmax(0, 1fr) auto;
      gap: clamp(16px, 2.4vw, 28px);
      align-items: start;
      min-height: 0;
      padding: 12px 0 14px;
      border-bottom: 1px solid var(--um-line);
      color: #111;
    }

    .um-package-row > span {
      color: var(--um-red);
      font-size: 1rem;
      font-weight: 700;
    }

    .um-package-row strong {
      font-size: clamp(1.08rem, 1.22vw, 1.24rem);
      line-height: 1.16;
      font-weight: 600;
    }

    .um-package-row p {
      color: var(--um-gray-700);
      font-size: 1rem;
      line-height: 1.46;
    }

    .um-package-row em {
      color: var(--um-red);
      font-style: normal;
      font-size: 1rem;
      font-weight: 700;
      white-space: nowrap;
      padding-top: 2px;
    }

    .um-operating-layer {
      padding: var(--um-section-y-tight) 0;
      scroll-margin-top: 96px;
      background: #f7f7f6;
      color: #111;
      border-top: 0;
      border-bottom: 0;
    }

    .um-operating-grid h2 {
      font-size: clamp(2.05rem, 3.15vw, 3.35rem);
      line-height: 1.08;
      font-weight: 600;
      text-wrap: balance;
      color: #111;
    }

    .um-operating-grid > div:first-child p {
      color: var(--um-red);
    }

    .um-operating-steps article {
      grid-template-columns: 46px minmax(148px, 0.44fr) minmax(260px, 1fr);
      gap: clamp(18px, 2.6vw, 30px);
      align-items: start;
      min-height: 112px;
      padding: 26px clamp(22px, 2.4vw, 32px);
      border-bottom: 1px solid rgba(17,17,17,0.12);
    }

    .um-operating-steps article:last-child {
      border-bottom: 0;
    }

    .um-operating-steps span {
      padding-top: 2px;
      line-height: 1.2;
      justify-self: start;
    }

    .um-operating-steps h3 {
      margin: 0;
      min-width: 0;
      font-size: clamp(1.28rem, 1.45vw, 1.55rem);
      line-height: 1.14;
      color: #111;
      overflow-wrap: break-word;
    }

    .um-operating-steps {
      background: #fff;
      border-top: 1px solid rgba(17,17,17,0.08);
      border-inline: 0;
    }

    .um-operating-steps p {
      margin: 0;
      min-width: 0;
      color: var(--um-gray-700);
      overflow-wrap: break-word;
    }

    .um-evidence-section {
      background: #fff;
      color: #111;
      padding: var(--um-section-y) 0;
      border: 0;
    }

    .um-evidence-layout {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(280px, 320px);
      gap: clamp(38px, 6vw, 82px);
      align-items: start;
    }

    .um-evidence-main {
      min-width: 0;
    }

    .um-evidence-head {
      display: grid;
      grid-template-columns: minmax(0, 0.56fr) minmax(280px, 0.44fr);
      gap: clamp(28px, 5vw, 72px);
      max-width: none;
      margin-bottom: 34px;
      border: 0;
      padding: 0;
      align-items: start;
    }

    .um-evidence-head .um-red-rule {
      margin-bottom: 20px;
    }

    .um-evidence-head > p:first-of-type,
    .um-evidence-sector-rail > div p {
      color: var(--um-red);
      font-size: 1rem;
      font-weight: 600;
    }

    .um-evidence-head h2 {
      max-width: 720px;
      margin: 18px 0 0;
      color: #000;
      font-size: clamp(2.2rem, 3.25vw, 3.65rem);
      line-height: 1.07;
      font-weight: 600;
      text-wrap: balance;
    }

    .um-evidence-head > p:last-child {
      max-width: 610px;
      margin-top: 24px;
      color: var(--um-gray-700);
      font-size: 1.08rem;
      line-height: 1.62;
      text-transform: none;
      font-weight: 400;
    }

    .um-evidence-head__side {
      display: grid;
      gap: 16px;
      justify-items: start;
      align-content: start;
      padding-top: 52px;
    }

    .um-evidence-head__side p {
      margin: 0;
      color: var(--um-gray-700);
      font-size: 1.02rem;
      line-height: 1.62;
    }

    .um-evidence-head__side a {
      color: #111;
      font-size: 1rem;
      font-weight: 700;
      border-bottom: 2px solid var(--um-red);
      padding-bottom: 4px;
    }

    .um-evidence-feature,
    .um-evidence-feature-slot {
      position: relative;
      display: block;
      min-height: clamp(420px, 39vw, 520px);
      overflow: hidden;
      background: #111;
      color: #fff;
      border: 0;
    }

    .um-evidence-feature img,
    .um-evidence-card__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(0.1) contrast(1.08) saturate(0.88);
      transition: none;
    }

    .um-evidence-feature:hover img,
    .um-evidence-card:hover img {
      filter: grayscale(0.1) contrast(1.08) saturate(0.88);
    }

    .um-evidence-feature__overlay {
      position: absolute;
      inset: auto 0 0 0;
      padding: clamp(28px, 4vw, 46px);
      background: linear-gradient(180deg, transparent 0%, rgba(0,0,0,0.9) 34%, #000 100%);
    }

    .um-evidence-feature__overlay span,
    .um-evidence-card__body > span {
      display: block;
      color: var(--um-red);
      font-size: 1rem;
      font-weight: 600;
    }

    .um-evidence-feature__overlay h3 {
      max-width: 520px;
      margin-top: 16px;
      color: #fff;
      font-size: clamp(1.9rem, 2.45vw, 2.75rem);
      line-height: 1.06;
      font-weight: 700;
      text-wrap: balance;
    }

    .um-evidence-feature__overlay p {
      margin-top: 10px;
      color: rgba(255,255,255,0.86);
      font-size: 1.08rem;
      line-height: 1.45;
    }

    .um-evidence-feature__overlay dl {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 14px;
      margin: 26px 0 0;
      border-top: 0;
    }

    .um-evidence-feature__overlay dl div {
      min-height: 72px;
      padding: 14px 0 0;
      border-right: 0;
      background: transparent;
    }

    .um-evidence-feature__overlay dl div:last-child {
      border-right: 0;
    }

    .um-evidence-feature__overlay dt {
      color: rgba(255,255,255,0.62);
      font-size: 1rem;
      font-weight: 600;
    }

    .um-evidence-feature__overlay dd {
      margin: 7px 0 0;
      color: #fff;
      font-size: 1rem;
      font-weight: 700;
      line-height: 1.28;
    }

    .um-evidence-ledger {
      margin-top: 18px;
      border-bottom: 0;
    }

    @media (min-width: 901px) {
      .um-evidence-ledger :global(.evidence-case-row) {
        grid-template-columns: 2.75rem 128px minmax(260px, 1fr) 72px auto;
      }

      .um-evidence-ledger :global(.evidence-case-row__meta-group) {
        grid-template-columns: 1fr;
      }

      .um-evidence-ledger :global(.evidence-case-row__meta:first-child) {
        display: none;
      }
    }

    .um-evidence-cards {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 18px;
      margin-top: 18px;
    }

    .um-evidence-card {
      display: grid;
      min-height: 304px;
      border: 0;
      background: #fff;
      color: #111;
      overflow: hidden;
    }

    .um-evidence-card__media {
      position: relative;
      min-height: 172px;
      overflow: hidden;
      background: #111;
    }

    .um-evidence-card__media span {
      position: absolute;
      top: 18px;
      right: 20px;
      color: #fff;
      font-size: 1.15rem;
      font-weight: 700;
    }

    .um-evidence-card__body {
      padding: 22px 24px 26px;
    }

    .um-evidence-card__body h3 {
      margin-top: 12px;
      color: #000;
      font-size: clamp(1.32rem, 1.55vw, 1.68rem);
      line-height: 1.12;
      font-weight: 600;
      text-wrap: balance;
    }

    .um-evidence-card__body p {
      margin-top: 8px;
      color: var(--um-gray-700);
      font-size: 1rem;
      line-height: 1.4;
    }

    .um-evidence-action {
      display: grid;
      grid-template-columns: 1fr;
      gap: 10px;
      align-items: center;
      margin-top: 22px;
    }

    .um-evidence-action p {
      color: var(--um-gray-700);
      font-size: 1rem;
      line-height: 1.55;
    }

    .um-evidence-sector-rail {
      position: sticky;
      top: 112px;
      border-left: 0;
      padding-left: clamp(26px, 4vw, 44px);
    }

    .um-evidence-sector-rail > div {
      display: flex;
      align-items: center;
      gap: 16px;
      margin-bottom: 22px;
    }

    .um-evidence-sector-rail .um-red-rule {
      width: 38px;
      height: 2px;
      margin: 0;
    }

    .um-evidence-sector-rail nav {
      display: grid;
      gap: 10px;
      border-top: 0;
    }

    .um-evidence-sector-rail nav a {
      display: grid;
      grid-template-columns: 44px minmax(0, 1fr) 14px;
      gap: 14px;
      align-items: center;
      min-height: 76px;
      border-bottom: 0;
      color: #111;
    }

    .um-evidence-sector-rail nav span {
      color: #9ca3af;
      font-size: 1rem;
      font-weight: 600;
    }

    .um-evidence-sector-rail nav strong {
      color: #111;
      font-size: clamp(1.1rem, 1.28vw, 1.28rem);
      line-height: 1.14;
      font-weight: 600;
      text-wrap: balance;
    }

    .um-evidence-sector-rail nav em {
      display: none;
    }

    .um-evidence-sector-rail nav a::after {
      content: "";
      grid-column: 3;
      justify-self: end;
      width: 10px;
      height: 10px;
      border-top: 2px solid var(--um-red);
      border-right: 2px solid var(--um-red);
      transform: rotate(45deg);
    }

    .um-evidence-sector-rail > p {
      margin-top: 34px;
      color: var(--um-gray-700);
      font-size: 1rem;
      line-height: 1.58;
    }

    .um-connected-section {
      background: #fff;
      color: #111;
      padding: clamp(60px, 8vw, 104px) 0;
      border-top: 0;
    }

    .um-connected-section .um-section-heading {
      border-top-color: var(--um-line);
      margin-bottom: clamp(28px, 4vw, 40px);
    }

    .um-connected-section .um-section-heading h2 {
      max-width: 860px;
      color: #111;
      font-weight: 600;
    }

    .um-connected-section .um-section-heading span {
      display: block;
      max-width: 520px;
      color: var(--um-gray-700);
      font-size: 1rem;
      line-height: 1.58;
    }

    .um-connected-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
      border: 0;
      background: transparent;
    }

    .um-connected-item {
      border-top: 0;
      border-bottom: 0;
      background: #fbfbfa;
      color: #111;
      box-shadow: none;
      min-height: 176px;
      padding: 24px;
    }

    .um-connected-item strong {
      color: #111;
      font-weight: 600;
    }

    .um-connected-item p {
      color: var(--um-gray-700);
      line-height: 1.5;
    }

    .um-final-cta {
      background: #050505;
      border-top: 0;
      border-bottom: 0;
      color: #fff;
    }

    .um-final-cta .um-home-container {
      align-items: center;
      min-height: 0;
      padding: clamp(44px, 6vw, 68px) 0;
    }

    .um-final-cta p {
      display: inline-flex;
      align-items: center;
      gap: 0.9rem;
      color: rgba(255, 255, 255, 0.78);
    }

    .um-final-cta p::before {
      content: "";
      display: inline-block;
      width: 36px;
      height: 2px;
      background: var(--um-red);
    }

    .um-final-cta h2 {
      max-width: 760px;
      color: #fff;
    }

    @media (max-width: 1060px) {
      .um-services-command,
      .um-package-grid,
      .um-evidence-layout {
        grid-template-columns: 1fr;
      }

      .um-package-intro,
      .um-evidence-sector-rail {
        position: static;
      }

      .um-evidence-sector-rail {
        border-left: 0;
        padding-left: 0;
      }

      .um-service-rail {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .um-evidence-head {
        grid-template-columns: 1fr;
      }

      .um-evidence-head__side {
        padding-top: 0;
      }
    }

    @media (max-width: 820px) {
      .um-home-hero {
        min-height: auto;
        overflow-x: hidden;
      }

      .um-hero-content {
        width: calc(100% - 32px);
        padding-top: 88px;
      }

      .um-hero-copy,
      .um-hero-copy h1,
      .um-hero-copy p {
        max-width: 100%;
        min-width: 0;
      }

      .um-hero-copy h1 {
        max-width: 100%;
        font-size: clamp(2.25rem, 9vw, 3rem);
        line-height: 1.08;
        overflow-wrap: normal;
        word-break: normal;
        text-wrap: balance;
      }

      .um-hero-proofbar {
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      .um-hero-proofbar div:nth-child(2n) {
        border-right: 0;
      }

      .um-hero-proofbar div {
        border-bottom: 0;
      }

      .um-package-row {
        grid-template-columns: 46px minmax(0, 1fr);
      }

      .um-package-row p,
      .um-package-row em {
        grid-column: 2;
      }

      .um-evidence-cards,
      .um-connected-grid {
        grid-template-columns: 1fr;
      }

      .um-evidence-feature__overlay dl {
        grid-template-columns: 1fr;
      }

      .um-evidence-feature__overlay dl div {
        border-right: 0;
        border-bottom: 0;
        padding-bottom: 14px;
      }

      .um-evidence-feature__overlay dl div:last-child {
        border-bottom: 0;
      }
    }

    @media (max-width: 560px) {
      .um-hero-copy h1 {
        max-width: 100%;
        font-size: clamp(2.15rem, 8.8vw, 2.65rem);
      }

      .um-hero-copy p {
        max-width: 34ch;
        font-size: 1rem;
        line-height: 1.58;
      }

      .um-hero-actions {
        width: 100%;
      }

      .um-hero-actions .um-btn {
        width: 100%;
      }

      .um-hero-mobile-photo {
        position: relative;
        display: block;
        width: 100%;
        margin: 20px 0 0;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border: 1px solid rgba(17,17,17,0.12);
        background: #111;
      }

      .um-hero-mobile-photo::after {
        content: "";
        position: absolute;
        inset: 45% 0 0;
        background: linear-gradient(180deg, transparent, rgba(0,0,0,0.76));
      }

      .um-hero-mobile-photo img {
        display: block;
        width: 100%;
        height: 100%;
        object-fit: cover;
        filter: saturate(0.9) contrast(1.05);
      }

      .um-hero-mobile-photo figcaption {
        position: absolute;
        z-index: 1;
        left: 18px;
        right: 18px;
        bottom: 16px;
        color: #fff;
      }

      .um-hero-mobile-photo span,
      .um-hero-mobile-photo strong {
        display: block;
        font-size: 1rem;
        line-height: 1.28;
      }

      .um-hero-mobile-photo span {
        color: rgba(255,255,255,0.72);
        font-weight: 700;
      }

      .um-hero-mobile-photo strong {
        margin-top: 4px;
        color: #fff;
        font-family: var(--um-font-display);
        font-weight: 600;
      }

      .um-hero-proofbar,
      .um-service-rail {
        grid-template-columns: 1fr;
      }

      .um-hero-proofbar div {
        border-right: 0;
      }

      .um-hero-proofbar strong {
        font-size: clamp(2rem, 12vw, 2.85rem);
      }

      .um-services-command__visual {
        min-height: 260px;
      }

      .um-service-unit {
        min-height: auto;
      }

      .um-evidence-feature {
        min-height: 520px;
      }
    }

    /* World-level composition pass: proportion, rhythm, editorial hierarchy */
    .um-home-hero {
      min-height: min(720px, calc(100svh - 4.5rem));
    }

    .um-hero-content {
      padding-top: clamp(70px, 8vw, 104px);
      padding-bottom: clamp(34px, 4vw, 52px);
    }

    .um-hero-copy h1 {
      max-width: 820px;
      font-size: clamp(2.75rem, 4.35vw, 4.45rem);
      line-height: 1.055;
      font-weight: 700;
    }

    .um-hero-proofbar {
      background: linear-gradient(90deg, rgba(0,0,0,0.78), rgba(18,20,22,0.82));
    }

    .um-hero-proofbar div {
      min-height: 92px;
    }

    .um-hero-proofbar strong {
      font-size: clamp(1.65rem, 2.35vw, 2.55rem);
      font-weight: 700;
    }

    .um-service-system {
      background: #fff;
      color: #111;
      padding: clamp(58px, 7vw, 92px) 0;
      border-bottom: 0;
    }

    .um-service-system::before {
      opacity: 0;
    }

    .um-services-command {
      grid-template-columns: minmax(0, 0.58fr) minmax(340px, 0.42fr);
      column-gap: clamp(34px, 6vw, 84px);
      row-gap: clamp(28px, 4vw, 44px);
      align-items: start;
    }

    .um-services-command__copy {
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      align-content: start;
      min-height: 100%;
    }

    .um-services-command__copy h2 {
      max-width: 620px;
      margin-top: 22px;
      color: #000;
      font-size: clamp(1.9rem, 2.65vw, 2.95rem);
      line-height: 1.08;
      font-weight: 700;
    }

    .um-services-command__copy p {
      max-width: 560px;
      color: var(--um-gray-700);
      font-size: clamp(1rem, 1.08vw, 1.12rem);
    }

    .um-services-command__copy .um-arrow-link {
      color: #111;
      width: fit-content;
      margin-top: 26px;
      border-bottom: 2px solid var(--um-red);
      padding-bottom: 4px;
    }

    .um-services-command__visual {
      height: clamp(220px, 22vw, 300px);
      min-height: 220px;
      border-color: var(--um-line);
    }

    .um-services-command__visual img {
      display: block;
      min-height: 0;
      height: 100%;
      filter: grayscale(0.08) contrast(1.05) saturate(0.88);
      opacity: 1;
    }

    .um-services-signal {
      background: rgba(0,0,0,0.72);
      padding: 14px 18px;
      right: 18px;
      bottom: 18px;
      border-left: 2px solid var(--um-red);
    }

    .um-service-rail {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: clamp(10px, 1.35vw, 16px);
      margin-top: 0;
      border-color: var(--um-line);
      background: transparent;
    }

    .um-service-unit {
      min-height: 212px;
      padding: clamp(20px, 2vw, 26px);
      background: #f7f8f9;
      color: #111;
      border-right: 0;
    }

    .um-service-unit:last-child {
      border-right: 0;
    }

    .um-service-unit:nth-child(4n) {
      border-right: 0;
    }

    .um-service-unit:nth-child(n + 5) {
      border-top: 0;
    }

    .um-service-unit:hover {
      background: #f1f2f4;
    }

    .um-service-unit__head {
      justify-content: flex-start;
      color: #777;
      font-weight: 700;
    }

