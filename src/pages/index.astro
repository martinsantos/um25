---
/**
 * Homepage V4 Design System
 * Main landing page with hero, services, cases, industries, and CTA
 */

import LayoutV4 from '../layouts/LayoutV4.astro';
import ServiceCard from '../components/v4/ServiceCard.astro';
import CTASection from '../components/v4/CTASection.astro';
import { generateSlug } from '../utils/slugUtils.js';
import { getAllServicios } from '../utils/directusHelpers';
import { getDirectusImageUrl, getAllAntecedentes, getHeroHomeImages, withBase } from '../lib/directus.ts';
import { serviceBadgeMap, serviceToSectorMap } from '../data/serviceBadgeMap';
import { getSectorColors } from '../data/colorSystem';

// Hero images — use local service images (works on both production and GitHub Pages)
const heroImages = [
  { url: withBase('/images/services/servicio-101-infraestructura.jpg'), alt: 'Infraestructura de Redes' },
  { url: withBase('/images/services/servicio-102-seguridad.jpg'), alt: 'Seguridad Electrónica' },
  { url: withBase('/images/services/servicio-103-telecomunicaciones.jpg'), alt: 'Telecomunicaciones' },
  { url: withBase('/images/services/servicio-104-software.jpg'), alt: 'Desarrollo de Software' },
  { url: withBase('/images/services/servicio-106-consultoria.jpg'), alt: 'Consultoría IT' },
];

// Get 3 featured antecedentes from Directus (con fallback a snapshot JSON)
let antecedentesData: any[] = [];
try {
  antecedentesData = await getAllAntecedentes();
} catch {
  antecedentesData = [];
}

const antecedentesEnhanced = antecedentesData.slice(0, 3).map((ant: any) => ({
  ...ant,
  slug: generateSlug(ant.Titulo || ant.Nombre || 'proyecto'),
  imageUrl: getDirectusImageUrl(ant.Imagen) || '/images/default-background.jpg'
}));

// Get services from Directus (with automatic fallback to JS data)
const serviciosFromDirectus = await getAllServicios();

// Map icon names for ServiceCard component
const iconMap: Record<number, { icon: string; iconColor: string }> = {
  101: { icon: 'network', iconColor: 'bg-sky-600/90' },
  102: { icon: 'shield', iconColor: 'bg-rose-600/90' },
  103: { icon: 'radio', iconColor: 'bg-cyan-600/90' },
  104: { icon: 'code', iconColor: 'bg-purple-600/90' },
  105: { icon: 'headphones', iconColor: 'bg-amber-600/90' },
  106: { icon: 'lightbulb', iconColor: 'bg-emerald-600/90' },
  107: { icon: 'flame', iconColor: 'bg-orange-600/90' },
  108: { icon: 'zap', iconColor: 'bg-yellow-600/90' }
};

// Enhance services with badges, colors, icons - ALL from Directus
const servicios = serviciosFromDirectus.slice(0, 8).map(s => {
  const sector = serviceToSectorMap[s.id] || 'tecnologia';
  const colors = getSectorColors(sector);

  return {
    ...s,
    ...iconMap[s.id],
    slug: s.slug || generateSlug(s.Titulo),
    badge: serviceBadgeMap[s.id] || 'Tecnología',
    badgeColor: colors.icon
  };
});

// Industries/Sectors data with pseudomorphic emojis
// WebSite schema with SearchAction for sitelinks search box
const websiteSchema = {
  "@type": "WebSite",
  "name": "ULTIMA MILLA",
  "url": "https://ultimamilla.com.ar",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://ultimamilla.com.ar/antecedentes?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

const sectores = [
  { slug: 'aeropuertos', name: 'Aeropuertos', emoji: '✈️', color: '#0ea5e9' },
  { slug: 'bodegas', name: 'Bodegas', emoji: '🍷', color: '#a855f7' },
  { slug: 'constructoras', name: 'Construcción', emoji: '🏗️', color: '#f59e0b' },
  { slug: 'salud', name: 'Salud', emoji: '🏥', color: '#22c55e' },
  { slug: 'gobiernosectorpublico', name: 'Gobierno', emoji: '🏛️', color: '#10b981' },
  { slug: 'software', name: 'Software', emoji: '💻', color: '#6366f1' },
  { slug: 'mineria', name: 'Minería', emoji: '⛏️', color: '#f97316' },
  { slug: 'industria', name: 'Industria', emoji: '🏭', color: '#64748b' },
  { slug: 'seguridad-electronica', name: 'Seguridad', icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z', color: '#06b6d4' }
];

// SVG icon paths for sectors
const sectorIcons: Record<string, string> = {
  'aeropuertos': 'M12 19l9 2-9-18-9 18 9-2zm0 0v-8',
  'bodegas': 'M9 12h6m-3-3v6m-7 4h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
  'constructoras': 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  'salud': 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
  'gobiernosectorpublico': 'M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z',
  'software': 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  'mineria': 'M20.618 5.984A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  'industria': 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
  'seguridad-electronica': 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
};
---

<LayoutV4
  title="ULTIMA MILLA — Infraestructura IT, Seguridad y Software | Mendoza"
  description="469+ proyectos de infraestructura IT, seguridad electrónica y desarrollo de software en Mendoza, Cuyo y Patagonia."
  keywords="infraestructura IT mendoza, seguridad electronica, software a medida"
  image="/nosotros-tech.jpg"
  structuredData={websiteSchema}
>

  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- HERO: Split — LEFT giant type (60%) + RIGHT mega photo (40%) -->
  <!-- ════════════════════════════════════════════════════════════ -->
  <section class="bg-white min-h-[100vh] flex flex-col">
    <div class="flex-1 grid grid-cols-1 lg:grid-cols-5 min-h-[85vh]">
      <!-- LEFT: Type-dominant -->
      <div class="lg:col-span-3 flex flex-col justify-center px-6 sm:px-10 lg:px-16 xl:px-24 py-16 sm:py-20 lg:py-0">
        <div class="flex items-center gap-3 mb-8">
          <span class="w-10 h-[3px] bg-red-600"></span>
          <span class="text-[10px] font-mono uppercase tracking-[0.3em] text-gray-400">Desde 2002</span>
        </div>

        <h1 class="text-[2.8rem] sm:text-[4rem] md:text-[5rem] lg:text-[5.5rem] xl:text-[6.5rem] font-black text-gray-900 leading-[0.88] tracking-tighter text-balance" style="letter-spacing:-0.045em;">
          Infraestructura<br>
          IT para<br>
          empresas que<br>
          no se conforman<span class="text-red-600">.</span>
        </h1>

        <p class="text-gray-500 text-base sm:text-lg mt-6 sm:mt-8 max-w-md leading-relaxed">
          Telecomunicaciones, seguridad electrónica, desarrollo de software y soporte 24/7 para las empresas más exigentes de Argentina.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 mt-8 sm:mt-10">
          <a href={withBase("/contacto")} class="inline-flex items-center gap-3 px-8 py-4 bg-gray-900 text-white font-black rounded-2xl hover:bg-red-600 transition-colors text-sm uppercase tracking-wider">
            Consultoría Gratuita
            <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="3" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 12h15m0 0l-6.75-6.75M19.5 12l-6.75 6.75"/></svg>
          </a>
          <a href={withBase("/antecedentes")} class="inline-flex items-center gap-2 px-8 py-4 border-2 border-gray-200 text-gray-900 font-bold rounded-2xl hover:border-gray-900 transition-colors text-sm">
            469+ Proyectos
          </a>
        </div>
      </div>

      <!-- RIGHT: Photo-dominant (rotates) -->
      <div class="lg:col-span-2 relative overflow-hidden bg-gray-100 min-h-[50vh] lg:min-h-0" id="heroImageContainer">
        {heroImages.map((img, i) => (
          <img src={img.url} alt={img.alt}
            class={`hero-image absolute inset-0 w-full h-full object-cover transition-opacity duration-[2500ms] ${i === 0 ? 'opacity-100' : 'opacity-0'}`}
            data-index={i} />
        ))}
        <!-- Subtle number overlay on photo -->
        <div class="absolute bottom-6 right-6 text-white/20 text-[8rem] sm:text-[10rem] font-black leading-none" style="letter-spacing:-0.05em;">469</div>
      </div>
    </div>

    <!-- Stats bar — full width, black -->
    <div class="bg-gray-900">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex">
        <div class="flex-1 py-5 border-r border-gray-800 pr-4">
          <div class="text-2xl sm:text-3xl font-black text-white">469<span class="text-red-500">+</span></div>
          <div class="text-[9px] font-mono uppercase tracking-[0.2em] text-gray-500 mt-0.5">Proyectos</div>
        </div>
        <div class="flex-1 py-5 border-r border-gray-800 px-4">
          <div class="text-2xl sm:text-3xl font-black text-white">22</div>
          <div class="text-[9px] font-mono uppercase tracking-[0.2em] text-gray-500 mt-0.5">Años</div>
        </div>
        <div class="flex-1 py-5 border-r border-gray-800 px-4">
          <div class="text-2xl sm:text-3xl font-black text-white">9</div>
          <div class="text-[9px] font-mono uppercase tracking-[0.2em] text-gray-500 mt-0.5">Industrias</div>
        </div>
        <div class="flex-1 py-5 pl-4">
          <div class="text-2xl sm:text-3xl font-black text-red-500">24/7</div>
          <div class="text-[9px] font-mono uppercase tracking-[0.2em] text-gray-500 mt-0.5">Soporte</div>
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- SERVICES: INVERTED — photo-dominant with small type inside -->
  <!-- ════════════════════════════════════════════════════════════ -->
  <section class="py-16 sm:py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-4 mb-10 lg:mb-14">
        <div>
          <div class="flex items-center gap-3 mb-3">
            <span class="w-10 h-[3px] bg-red-600"></span>
            <span class="text-[10px] font-mono uppercase tracking-[0.3em] text-gray-400">Servicios</span>
          </div>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-gray-900 tracking-tighter" style="letter-spacing:-0.03em;">
            8 áreas de expertise<span class="text-red-600">.</span>
          </h2>
        </div>
        <a href={withBase("/servicios")} class="text-xs font-black text-gray-900 hover:text-red-600 transition-colors uppercase tracking-[0.2em]">
          Todos los servicios →
        </a>
      </div>

      <div class="grid grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
        {servicios.map((servicio, i) => (
          <div class="scroll-reveal" style={`animation-delay:${i*0.06}s`}>
            <ServiceCard
              id={servicio.id} slug={servicio.slug} titulo={servicio.Titulo}
              descripcion={servicio.Descripcion} imagen={servicio.Imagen}
              badge={servicio.badge} cliente={servicio.Cliente}
              icon={servicio.icon} index={i}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- CASES: REVERSED — Photo fills, type is GIANT overlaid -->
  <!-- This alternates the rhythm: here the PHOTO dominates -->
  <!-- ════════════════════════════════════════════════════════════ -->
  <section class="bg-gray-900 py-16 sm:py-20 lg:py-28">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex items-center gap-3 mb-3 scroll-reveal">
        <span class="w-10 h-[3px] bg-red-500"></span>
        <span class="text-[10px] font-mono uppercase tracking-[0.3em] text-gray-500">Casos de éxito</span>
      </div>
      <h2 class="text-3xl sm:text-4xl lg:text-5xl font-black text-white tracking-tighter mb-10 lg:mb-14 scroll-reveal" style="letter-spacing:-0.03em;">
        Proyectos que hablan<br>por sí solos<span class="text-red-500">.</span>
      </h2>

      {antecedentesEnhanced.length > 0 && (
        <div class="space-y-4 sm:space-y-5">
          <!-- Main case: MEGA landscape photo -->
          <a href={withBase(`/antecedentes/${antecedentesEnhanced[0].id}/${antecedentesEnhanced[0].slug}`)}
            class="group block relative rounded-3xl overflow-hidden aspect-[21/9] min-h-[300px] scroll-reveal bg-gray-800">
            <img src={antecedentesEnhanced[0].imageUrl} alt={antecedentesEnhanced[0].Titulo}
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.02] transition-transform duration-1000" />
            <div class="absolute inset-0 bg-gradient-to-r from-black/80 via-black/30 to-transparent"></div>
            <div class="absolute inset-0 flex items-center px-8 sm:px-12 lg:px-16">
              <div class="max-w-xl">
                <span class="text-red-400 text-[10px] font-black uppercase tracking-[0.2em]">{antecedentesEnhanced[0].Area}</span>
                <h3 class="text-2xl sm:text-3xl lg:text-4xl xl:text-5xl font-black text-white leading-[0.9] mt-3 tracking-tight" style="letter-spacing:-0.03em;">
                  {antecedentesEnhanced[0].Titulo}
                </h3>
                <p class="text-white/40 text-xs font-mono uppercase tracking-[0.2em] mt-4">{antecedentesEnhanced[0].Cliente} →</p>
              </div>
            </div>
          </a>

          <!-- Two side-by-side cards -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
            {antecedentesEnhanced.slice(1, 3).map((ant, i) => (
              <a href={withBase(`/antecedentes/${ant.id}/${ant.slug}`)}
                class="group block relative rounded-2xl overflow-hidden aspect-[16/10] min-h-[220px] scroll-reveal bg-gray-800"
                style={`animation-delay:${(i+1)*0.15}s`}>
                <img src={ant.imageUrl} alt={ant.Titulo}
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-[1.03] transition-transform duration-700" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                <div class="absolute bottom-0 left-0 right-0 p-5 sm:p-6">
                  <span class="text-red-400 text-[10px] font-black uppercase tracking-[0.15em]">{ant.Area}</span>
                  <h3 class="text-lg sm:text-xl lg:text-2xl font-black text-white leading-tight mt-1 tracking-tight">{ant.Titulo}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="mt-10 sm:mt-14 flex justify-center scroll-reveal">
        <a href={withBase("/antecedentes")} class="inline-flex items-center gap-3 px-8 py-4 bg-white text-gray-900 font-black rounded-2xl hover:bg-red-600 hover:text-white transition-all text-sm uppercase tracking-wider">
          Ver los 469+ proyectos →
        </a>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- INDUSTRIES: Back to TYPE-dominant on white bg -->
  <!-- ════════════════════════════════════════════════════════════ -->
  <section class="py-16 sm:py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-10 lg:gap-16 items-center">
        <!-- LEFT: Giant type -->
        <div>
          <div class="flex items-center gap-3 mb-3 scroll-reveal">
            <span class="w-10 h-[3px] bg-red-600"></span>
            <span class="text-[10px] font-mono uppercase tracking-[0.3em] text-gray-400">Industrias</span>
          </div>
          <h2 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-black text-gray-900 tracking-tighter scroll-reveal" style="letter-spacing:-0.04em;">
            9 verticales<span class="text-red-600">,</span><br>
            un solo<br>
            equipo<span class="text-red-600">.</span>
          </h2>
        </div>

        <!-- RIGHT: Tags -->
        <div class="flex flex-wrap gap-3 scroll-reveal">
          {sectores.map((sector, i) => (
            <a href={withBase(`/${sector.slug}`)}
              class="group flex items-center gap-2.5 px-5 py-3 border-2 border-gray-200 rounded-xl hover:border-gray-900 hover:bg-gray-900 transition-all duration-300"
              style={`animation-delay:${i*0.04}s`}>
              <svg class="w-4 h-4 text-gray-400 group-hover:text-white transition-colors" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d={sectorIcons[sector.slug] || 'M13 10V3L4 14h7v7l9-11h-7z'}/>
              </svg>
              <span class="font-black text-sm text-gray-900 group-hover:text-white transition-colors uppercase tracking-wide">{sector.name}</span>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- ════════════════════════════════════════════════════════════ -->
  <!-- CTA: PHOTO-dominant (inverted from industries) -->
  <!-- ════════════════════════════════════════════════════════════ -->
  <section class="relative py-24 sm:py-32 lg:py-40 overflow-hidden">
    <img src={withBase("/images/hero/hero-software.jpg")} alt="" class="absolute inset-0 w-full h-full object-cover" />
    <div class="absolute inset-0 bg-black/75"></div>
    <div class="relative max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl">
        <h2 class="text-4xl sm:text-5xl lg:text-6xl xl:text-7xl font-black text-white tracking-tighter leading-[0.9]" style="letter-spacing:-0.04em;">
          El próximo<br>
          proyecto exitoso<br>
          puede ser<br>
          el suyo<span class="text-red-500">.</span>
        </h2>
        <div class="flex flex-col sm:flex-row gap-4 mt-10">
          <a href={withBase("/contacto")} class="px-10 py-4 bg-white text-gray-900 font-black rounded-2xl hover:bg-red-600 hover:text-white transition-all text-sm uppercase tracking-wider">
            Agendar Consultoría
          </a>
          <a href="mailto:contacto@ultimamilla.com.ar" class="px-10 py-4 border-2 border-white/30 text-white font-bold rounded-2xl hover:border-white transition-all text-sm">
            contacto@ultimamilla.com.ar
          </a>
        </div>
        <div class="mt-12 pt-6 border-t border-white/10">
          <div class="flex flex-wrap gap-x-5 gap-y-1 text-xs text-white/30 font-mono uppercase tracking-wider">
            <span>Aeropuertos Argentina 2000</span>
            <span>Gobierno de Mendoza</span>
            <span>Hospital Central</span>
            <span>Bodega La Esmeralda</span>
            <span>Premix SA</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const imgs = document.querySelectorAll('.hero-image');
      if (imgs.length > 1) {
        let c = 0;
        setInterval(() => {
          imgs[c].classList.remove('opacity-100');
          imgs[c].classList.add('opacity-0');
          c = (c + 1) % imgs.length;
          imgs[c].classList.remove('opacity-0');
          imgs[c].classList.add('opacity-100');
        }, 5000);
      }
    });
  </script>
</LayoutV4>
