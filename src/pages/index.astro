---
/**
 * Homepage V4 Design System
 * Main landing page with hero, services, cases, industries, and CTA
 */

import LayoutV4 from '../layouts/LayoutV4.astro';
import ServiceCard from '../components/v4/ServiceCard.astro';
import CTASection from '../components/v4/CTASection.astro';
import { generateSlug } from '../utils/slugUtils.js';
import { getAllServicios } from '../utils/directusHelpers';
import { getDirectusImageUrl, getAllAntecedentes, getHeroHomeImages, withBase } from '../lib/directus.ts';
import { serviceBadgeMap, serviceToSectorMap } from '../data/serviceBadgeMap';
import { getSectorColors } from '../data/colorSystem';

// Hero images — use local service images (works on both production and GitHub Pages)
const heroImages = [
  { url: withBase('/images/services/servicio-101-infraestructura.jpg'), alt: 'Infraestructura de Redes' },
  { url: withBase('/images/services/servicio-102-seguridad.jpg'), alt: 'Seguridad Electrónica' },
  { url: withBase('/images/services/servicio-103-telecomunicaciones.jpg'), alt: 'Telecomunicaciones' },
  { url: withBase('/images/services/servicio-104-software.jpg'), alt: 'Desarrollo de Software' },
  { url: withBase('/images/services/servicio-106-consultoria.jpg'), alt: 'Consultoría IT' },
];

// Get 3 featured antecedentes from Directus (con fallback a snapshot JSON)
let antecedentesData: any[] = [];
try {
  antecedentesData = await getAllAntecedentes();
} catch {
  antecedentesData = [];
}

const antecedentesEnhanced = antecedentesData.slice(0, 3).map((ant: any) => ({
  ...ant,
  slug: generateSlug(ant.Titulo || ant.Nombre || 'proyecto'),
  imageUrl: getDirectusImageUrl(ant.Imagen) || '/images/default-background.jpg'
}));

// Get services from Directus (with automatic fallback to JS data)
const serviciosFromDirectus = await getAllServicios();

// Map icon names for ServiceCard component
const iconMap: Record<number, { icon: string; iconColor: string }> = {
  101: { icon: 'network', iconColor: 'bg-sky-600/90' },
  102: { icon: 'shield', iconColor: 'bg-rose-600/90' },
  103: { icon: 'radio', iconColor: 'bg-cyan-600/90' },
  104: { icon: 'code', iconColor: 'bg-purple-600/90' },
  105: { icon: 'headphones', iconColor: 'bg-amber-600/90' },
  106: { icon: 'lightbulb', iconColor: 'bg-emerald-600/90' },
  107: { icon: 'flame', iconColor: 'bg-orange-600/90' },
  108: { icon: 'zap', iconColor: 'bg-yellow-600/90' }
};

// Enhance services with badges, colors, icons - ALL from Directus
const servicios = serviciosFromDirectus.slice(0, 8).map(s => {
  const sector = serviceToSectorMap[s.id] || 'tecnologia';
  const colors = getSectorColors(sector);

  return {
    ...s,
    ...iconMap[s.id],
    slug: s.slug || generateSlug(s.Titulo),
    badge: serviceBadgeMap[s.id] || 'Tecnología',
    badgeColor: colors.icon
  };
});

// Industries/Sectors data with pseudomorphic emojis
// WebSite schema with SearchAction for sitelinks search box
const websiteSchema = {
  "@type": "WebSite",
  "name": "ULTIMA MILLA",
  "url": "https://ultimamilla.com.ar",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://ultimamilla.com.ar/antecedentes?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

const sectores = [
  { slug: 'aeropuertos', name: 'Aeropuertos', emoji: '✈️', color: '#0ea5e9' },
  { slug: 'bodegas', name: 'Bodegas', emoji: '🍷', color: '#a855f7' },
  { slug: 'constructoras', name: 'Construcción', emoji: '🏗️', color: '#f59e0b' },
  { slug: 'salud', name: 'Salud', emoji: '🏥', color: '#22c55e' },
  { slug: 'gobiernosectorpublico', name: 'Gobierno', emoji: '🏛️', color: '#10b981' },
  { slug: 'software', name: 'Software', emoji: '💻', color: '#6366f1' },
  { slug: 'mineria', name: 'Minería', emoji: '⛏️', color: '#f97316' },
  { slug: 'industria', name: 'Industria', emoji: '🏭', color: '#64748b' },
  { slug: 'seguridad-electronica', name: 'Seguridad', icon: 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z', color: '#06b6d4' }
];

// SVG icon paths for sectors
const sectorIcons: Record<string, string> = {
  'aeropuertos': 'M12 19l9 2-9-18-9 18 9-2zm0 0v-8',
  'bodegas': 'M9 12h6m-3-3v6m-7 4h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
  'constructoras': 'M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4',
  'salud': 'M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z',
  'gobiernosectorpublico': 'M8 14v3m4-3v3m4-3v3M3 21h18M3 10h18M3 7l9-4 9 4M4 10h16v11H4V10z',
  'software': 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  'mineria': 'M20.618 5.984A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  'industria': 'M19.428 15.428a2 2 0 00-1.022-.547l-2.387-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z',
  'seguridad-electronica': 'M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z',
};
---

<LayoutV4
  title="ULTIMA MILLA | Servicios Tecnológicos para Empresas en Mendoza, Cuyo y Patagonia"
  description="Servicios tecnológicos para empresas y organizaciones argentinas. Zona de incumbencia: Mendoza, Cuyo, Patagonia. Especialistas en Telecomunicaciones, Cableado Estructurado, Corrientes Débiles, Detección de Incendio, Software a Medida. +469 proyectos, +22 años de experiencia."
  keywords="servicios tecnologicos empresas argentina, zona incumbencia mendoza cuyo patagonia, telecomunicaciones empresas, cableado estructurado, corrientes debiles, deteccion incendio, software a medida organizaciones"
  image="/nosotros-tech.jpg"
  structuredData={websiteSchema}
>
  <!-- ═══════════════════════════════════════════════ -->
  <!-- HERO — Full-screen photo, visible, impactful -->
  <!-- ═══════════════════════════════════════════════ -->
  <section class="relative bg-um-dark overflow-hidden min-h-[90vh] flex items-end pb-12 sm:pb-16 lg:pb-20">
    <div class="absolute inset-0 hero-parallax" id="heroImageContainer">
      {heroImages.map((img, index) => (
        <img src={img.url} alt={img.alt}
          class={`hero-image absolute inset-0 w-full h-full object-cover transition-opacity duration-[2000ms] ${index === 0 ? 'opacity-60' : 'opacity-0'}`}
          data-index={index} />
      ))}
      <div class="absolute inset-0 bg-gradient-to-t from-um-dark via-um-dark/40 to-um-dark/20"></div>
      <div class="absolute inset-0 hero-gradient-animated opacity-60"></div>
    </div>

    <div class="relative max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
      <div class="max-w-3xl">
        <div class="inline-flex items-center gap-2 px-4 py-2 bg-white/10 backdrop-blur-md text-white rounded-full text-sm font-medium mb-6 border border-white/10">
          <span class="w-2 h-2 rounded-full bg-emerald-400 animate-pulse"></span>
          Operando desde 2002 — Mendoza, Cuyo y Patagonia
        </div>

        <h1 class="text-3xl sm:text-5xl md:text-6xl lg:text-7xl font-extrabold text-white leading-[1.05] mb-6 text-balance">
          Infraestructura IT<br>
          <span class="bg-gradient-to-r from-sky-400 to-cyan-300 bg-clip-text text-transparent">de clase mundial</span>
        </h1>

        <p class="text-base sm:text-lg lg:text-xl text-gray-300 mb-8 max-w-2xl leading-relaxed text-pretty">
          Telecomunicaciones, seguridad electrónica, desarrollo de software y soporte 24/7 para las empresas más exigentes de Argentina.
        </p>

        <div class="flex flex-col sm:flex-row gap-4 mb-12">
          <a href={withBase("/contacto")} class="group inline-flex items-center justify-center gap-3 px-8 py-4 bg-white text-gray-900 text-base font-bold rounded-2xl transition-all hover:shadow-2xl hover:shadow-white/20 hover:-translate-y-0.5 min-h-[52px]">
            Consultoría Gratuita
            <svg class="w-5 h-5 transition-transform group-hover:translate-x-1" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
          </a>
          <a href={withBase("/antecedentes")} class="inline-flex items-center justify-center gap-2 px-8 py-4 bg-white/5 hover:bg-white/10 backdrop-blur border border-white/15 text-white text-base font-semibold rounded-2xl transition-all min-h-[52px]">
            469+ Proyectos Realizados
          </a>
        </div>

        <!-- Stats: large, horizontal, with icons -->
        <div class="flex flex-wrap gap-8 sm:gap-12">
          <div class="scroll-counter">
            <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-white">469<span class="text-sky-400">+</span></div>
            <div class="text-xs sm:text-sm text-gray-400 mt-1">Proyectos entregados</div>
          </div>
          <div class="scroll-counter" style="animation-delay:0.1s">
            <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-white">22<span class="text-sky-400">+</span></div>
            <div class="text-xs sm:text-sm text-gray-400 mt-1">Años de experiencia</div>
          </div>
          <div class="scroll-counter" style="animation-delay:0.2s">
            <div class="text-3xl sm:text-4xl lg:text-5xl font-black text-white">9</div>
            <div class="text-xs sm:text-sm text-gray-400 mt-1">Industrias atendidas</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ -->
  <!-- SERVICES — Icon-first cards, clean and premium -->
  <!-- ═══════════════════════════════════════════════ -->
  <section class="py-16 sm:py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6 mb-12 lg:mb-16 scroll-reveal">
        <div class="max-w-2xl">
          <span class="text-um-primary font-bold text-xs uppercase tracking-[0.2em]">Servicios</span>
          <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900 mt-3 text-balance leading-tight">
            Todo lo que su empresa necesita en <span class="text-um-primary">un solo lugar</span>
          </h2>
        </div>
        <a href={withBase("/servicios")} class="inline-flex items-center gap-2 text-um-primary font-bold hover:gap-4 transition-all">
          Ver catálogo completo
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-5 sm:gap-6 cards-grid">
        {servicios.map((servicio, i) => (
          <div class="scroll-reveal" style={`animation-delay: ${i * 0.06}s`}>
            <ServiceCard
              id={servicio.id}
              slug={servicio.slug}
              titulo={servicio.Titulo}
              descripcion={servicio.Descripcion}
              imagen={servicio.Imagen}
              badge={servicio.badge}
              cliente={servicio.Cliente}
              icon={servicio.icon}
            />
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ -->
  <!-- CASES — 1 hero + 2 side cards layout -->
  <!-- ═══════════════════════════════════════════════ -->
  <section class="py-16 sm:py-20 lg:py-28 bg-gray-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="max-w-2xl mb-12 lg:mb-16 scroll-reveal">
        <span class="text-um-primary font-bold text-xs uppercase tracking-[0.2em]">Casos de Éxito</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900 mt-3 text-balance">
          Proyectos que hablan por sí solos
        </h2>
      </div>

      {antecedentesEnhanced.length > 0 && (
        <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 lg:gap-8">
          <!-- Hero card (first project, large) -->
          <a href={withBase(`/antecedentes/${antecedentesEnhanced[0].id}/${antecedentesEnhanced[0].slug}`)}
            class="group relative rounded-3xl overflow-hidden min-h-[400px] lg:min-h-[500px] flex items-end scroll-reveal">
            <img src={antecedentesEnhanced[0].imageUrl} alt={antecedentesEnhanced[0].Titulo}
              class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
              onerror="this.style.display='none'" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/30 to-transparent"></div>
            <div class="relative p-6 sm:p-8 lg:p-10">
              <span class="inline-block px-3 py-1 bg-white/20 backdrop-blur-sm text-white text-xs font-bold rounded-full mb-3 border border-white/10">
                {antecedentesEnhanced[0].Area || 'Proyecto Destacado'}
              </span>
              <h3 class="text-xl sm:text-2xl lg:text-3xl font-bold text-white mb-2 text-balance">{antecedentesEnhanced[0].Titulo}</h3>
              <p class="text-sm text-gray-300 mb-4 max-w-lg">{antecedentesEnhanced[0].Descripcion?.replace(/<[^>]+>/g, '').substring(0, 150)}...</p>
              <span class="text-white font-bold text-sm flex items-center gap-2 group-hover:gap-4 transition-all">
                Ver proyecto completo
                <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
              </span>
            </div>
          </a>

          <!-- Side cards (2nd and 3rd projects) -->
          <div class="grid grid-cols-1 gap-6">
            {antecedentesEnhanced.slice(1, 3).map((ant, i) => (
              <a href={withBase(`/antecedentes/${ant.id}/${ant.slug}`)}
                class="group relative rounded-2xl overflow-hidden min-h-[200px] lg:min-h-[240px] flex items-end scroll-reveal" style={`animation-delay: ${(i+1)*0.15}s`}>
                <img src={ant.imageUrl} alt={ant.Titulo}
                  class="absolute inset-0 w-full h-full object-cover group-hover:scale-105 transition-transform duration-700"
                  onerror="this.style.display='none'" />
                <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
                <div class="relative p-5 sm:p-6">
                  <span class="inline-block px-2.5 py-0.5 bg-white/20 backdrop-blur-sm text-white text-[10px] font-bold rounded-full mb-2 border border-white/10 uppercase tracking-wide">
                    {ant.Area || ant.Cliente}
                  </span>
                  <h3 class="text-lg sm:text-xl font-bold text-white text-balance">{ant.Titulo}</h3>
                </div>
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="mt-10 sm:mt-14 text-center scroll-reveal">
        <a href={withBase("/antecedentes")} class="inline-flex items-center gap-3 px-8 py-4 bg-gray-900 text-white font-bold rounded-2xl hover:bg-um-primary transition-colors min-h-[52px]">
          Explorar los 469+ proyectos
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ -->
  <!-- INDUSTRIES — SVG icons, no emojis, 3x3 premium -->
  <!-- ═══════════════════════════════════════════════ -->
  <section class="py-16 sm:py-20 lg:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center max-w-2xl mx-auto mb-12 lg:mb-16 scroll-reveal">
        <span class="text-um-primary font-bold text-xs uppercase tracking-[0.2em]">Industrias</span>
        <h2 class="text-3xl sm:text-4xl lg:text-5xl font-extrabold text-gray-900 mt-3 text-balance">
          Expertise en cada vertical
        </h2>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-3 gap-4 sm:gap-5 lg:gap-6 max-w-4xl mx-auto">
        {sectores.map((sector, i) => (
          <a href={withBase(`/${sector.slug}`)}
            class="group relative p-6 sm:p-8 rounded-2xl border-2 border-gray-100 hover:border-transparent transition-all duration-500 hover:shadow-2xl hover:shadow-black/5 hover:-translate-y-1 scroll-reveal-scale overflow-hidden"
            style={`animation-delay: ${i * 0.05}s; --sector-color: ${sector.color}`}>
            <!-- Hover gradient background -->
            <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-2xl" style={`background: linear-gradient(135deg, ${sector.color}10, ${sector.color}05)`}></div>
            <div class="relative">
              <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-xl flex items-center justify-center mb-4 transition-colors duration-300" style={`background: ${sector.color}15`}>
                <svg class="w-6 h-6 sm:w-7 sm:h-7 transition-colors duration-300" style={`color: ${sector.color}`} fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" d={sectorIcons[sector.slug] || 'M13 10V3L4 14h7v7l9-11h-7z'}/>
                </svg>
              </div>
              <h3 class="font-bold text-gray-900 group-hover:text-gray-900 mb-1">{sector.name}</h3>
              <span class="text-xs text-gray-400 font-medium">{sector.name === 'Gobierno' ? '80+ proyectos' : sector.name === 'Seguridad' ? '120+ proyectos' : '45+ proyectos'}</span>
            </div>
          </a>
        ))}
      </div>

      <div class="mt-10 text-center scroll-reveal">
        <a href={withBase("/sectores")} class="inline-flex items-center gap-2 text-um-primary font-bold hover:gap-4 transition-all">
          Ver todas las industrias
          <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ═══════════════════════════════════════════════ -->
  <!-- CTA — Gradient mesh, social proof -->
  <!-- ═══════════════════════════════════════════════ -->
  <section class="relative py-20 sm:py-24 lg:py-32 overflow-hidden scroll-reveal">
    <div class="absolute inset-0 bg-gray-900"></div>
    <div class="absolute inset-0 hero-gradient-animated opacity-40"></div>
    <div class="absolute inset-0" style="background-image: radial-gradient(circle at 30% 50%, rgba(14,165,233,0.15), transparent 50%), radial-gradient(circle at 70% 30%, rgba(220,38,38,0.1), transparent 40%);"></div>

    <div class="relative max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
      <h2 class="text-3xl sm:text-4xl lg:text-5xl xl:text-6xl font-extrabold text-white mb-6 text-balance">
        El próximo proyecto exitoso puede ser el suyo
      </h2>
      <p class="text-lg sm:text-xl text-gray-400 mb-10 max-w-2xl mx-auto text-pretty">
        Gobiernos, aeropuertos, hospitales, bodegas y más de 200 organizaciones ya confían en Ultima Milla.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href={withBase("/contacto")} class="px-10 py-4 bg-white text-gray-900 font-bold rounded-2xl hover:shadow-2xl hover:shadow-white/20 hover:-translate-y-0.5 transition-all min-h-[52px] flex items-center justify-center text-base">
          Agendar Consultoría Gratis
        </a>
        <a href={withBase("/antecedentes")} class="px-10 py-4 border-2 border-white/20 text-white font-bold rounded-2xl hover:bg-white/5 transition-all min-h-[52px] flex items-center justify-center gap-2 text-base">
          Ver Portfolio Completo
        </a>
      </div>

      <!-- Social proof -->
      <div class="mt-12 pt-8 border-t border-white/10">
        <p class="text-sm text-gray-500 mb-4">Empresas que confían en nosotros</p>
        <div class="flex flex-wrap justify-center gap-x-8 gap-y-3 text-gray-400 text-sm font-medium">
          <span>Aeropuertos Argentina 2000</span>
          <span class="text-gray-600">|</span>
          <span>Gobierno de Mendoza</span>
          <span class="text-gray-600">|</span>
          <span>Hospital Central</span>
          <span class="text-gray-600">|</span>
          <span>Bodega La Esmeralda</span>
          <span class="text-gray-600">|</span>
          <span>Premix SA</span>
        </div>
      </div>
    </div>
  </section>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const images = document.querySelectorAll('.hero-image');
      if (images.length > 1) {
        let current = 0;
        setInterval(() => {
          images[current].classList.remove('opacity-60');
          images[current].classList.add('opacity-0');
          current = (current + 1) % images.length;
          images[current].classList.remove('opacity-0');
          images[current].classList.add('opacity-60');
        }, 6000);
      }
    });
  </script>
</LayoutV4>
