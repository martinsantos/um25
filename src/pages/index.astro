                  <div class="text-xs text-gray-500">Proyectos</div>
                </div>
                <div>
                  <div class="text-2xl font-bold text-white">10+</div>
                  <div class="text-xs text-gray-500">Años</div>
                </div>
              </div>
              
              <!-- CTA -->
              <div class="flex items-center gap-2 text-sm font-medium text-gray-400 transition-all duration-300 group-hover:text-cyan-400 group-hover:gap-3">
                <span>Ver más</span>
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
