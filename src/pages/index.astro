    .um-evidence-head p,
    .um-evidence-subhead span {
      margin: 0;
      color: #DC2626;
      font-size: 1rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0;
    }

    .um-evidence-head h2 {
      max-width: 880px;
      margin: 12px 0 0;
      font-family: var(--um-font-display);
      font-size: clamp(2.1rem, 3.6vw, 3.7rem);
      line-height: 1.02;
      letter-spacing: 0;
      color: #050505;
    }

    .um-evidence-head a {
      color: #111;
      font-size: 1rem;
      font-weight: 700;
      border-bottom: 2px solid #DC2626;
      padding-bottom: 4px;
      white-space: nowrap;
    }

    .um-evidence-stage {
      display: grid;
      grid-template-columns: minmax(0, 1.15fr) minmax(320px, 0.85fr);
      min-height: 430px;
      margin-bottom: 38px;
      background: #fff;
      color: #111;
      overflow: hidden;
    }

    .um-evidence-stage__media {
      position: relative;
      min-height: 360px;
      background: #111;
      overflow: hidden;
    }

    .um-evidence-stage__media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(0.12) contrast(1.06) saturate(0.88);
      transition: none;
    }

    .um-evidence-stage:hover .um-evidence-stage__media img {
      filter: grayscale(0.12) contrast(1.06) saturate(0.88);
    }

    .um-evidence-stage__copy {
      display: flex;
      flex-direction: column;
      justify-content: flex-end;
      padding: clamp(28px, 4vw, 52px);
    }

    .um-evidence-stage__copy span,
    .um-evidence-case div > span {
      display: block;
      margin: 0;
      color: #DC2626;
      font-size: 1rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0;
    }

    .um-evidence-stage__copy h3 {
      max-width: 520px;
      margin: 18px 0 18px;
      font-family: var(--um-font-display);
      font-size: clamp(2rem, 3.4vw, 3.7rem);
      line-height: 1;
      color: #050505;
      letter-spacing: 0;
    }

    .um-evidence-stage__copy p {
      max-width: 520px;
      margin: 0;
      color: #475569;
      font-size: 1.02rem;
      line-height: 1.62;
    }

    .um-evidence-stage__copy dl {
      display: flex;
      flex-wrap: wrap;
      gap: 18px 26px;
      margin: 24px 0 0;
      padding-top: 18px;
      border-top: 1px solid #d7d7d7;
    }

    .um-evidence-stage__copy dl div {
      min-width: 0;
    }

    .um-evidence-stage__copy dt {
      margin: 0;
      color: #475569;
      font-size: 1rem;
      font-weight: 700;
      text-transform: uppercase;
    }

    .um-evidence-stage__copy dd {
      margin: 9px 0 0;
      color: #111;
      font-size: 1rem;
      font-weight: 700;
      line-height: 1.25;
    }

    .um-evidence-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.08fr) minmax(340px, 0.92fr);
      gap: 28px;
      align-items: start;
    }

    .um-evidence-subhead {
      margin-bottom: 18px;
    }

    .um-evidence-subhead p {
      max-width: 560px;
      margin: 8px 0 0;
      color: #475569;
      font-size: 1.02rem;
      line-height: 1.5;
    }

    .um-evidence-cases {
      display: grid;
      gap: 14px;
    }

    .um-evidence-case {
      display: grid;
      grid-template-columns: 168px minmax(0, 1fr) auto;
      gap: 22px;
      align-items: center;
      min-height: 156px;
      padding: 16px 22px 16px 16px;
      border-top: 1px solid #d7d7d7;
      background: #fff;
      color: #111;
      transition: background-color 180ms ease;
    }

    .um-evidence-case:hover {
      background: #f7f8f9;
      transform: none;
    }

    .um-evidence-thumb {
      width: 100%;
      aspect-ratio: 4 / 3;
      overflow: hidden;
      background: #e5e7eb;
    }

    .um-evidence-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(0.14) contrast(1.04) saturate(0.86);
    }

    .um-evidence-case div:not(.um-evidence-thumb) {
      min-width: 0;
    }

    .um-evidence-case strong {
      display: block;
      margin: 8px 0 8px;
      color: #050505;
      font-family: var(--um-font-display);
      font-size: clamp(1.32rem, 2vw, 1.95rem);
      line-height: 1.08;
      overflow-wrap: anywhere;
    }

    .um-evidence-case em {
      display: block;
      color: #475569;
      font-style: normal;
      font-size: 1rem;
      line-height: 1.35;
    }

    .um-evidence-case-link {
      align-self: end;
      color: #111;
      font-size: 1rem;
      font-weight: 700;
      white-space: nowrap;
    }

    .um-sector-list {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 12px;
    }

    .um-sector-list a {
      display: grid;
      align-content: start;
      min-height: 108px;
      padding: 18px;
      border-top: 1px solid #d7d7d7;
      background: #fff;
      color: #111;
      transition: background 180ms ease;
    }

    .um-sector-list a:hover {
      background: #fbfbfb;
    }

    .um-sector-list strong {
      color: #050505;
      font-size: 1.08rem;
      line-height: 1.15;
    }

    .um-sector-list span {
      margin-top: 8px;
      color: #64748b;
      font-size: 1rem;
      line-height: 1.35;
    }

    .um-connected-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      border-top: 1px solid #d7d7d7;
      border-left: 1px solid #d7d7d7;
    }

    .um-connected-item {
      min-height: 230px;
      padding: 24px;
      color: #111;
      border-right: 1px solid #d7d7d7;
      border-bottom: 1px solid #d7d7d7;
      background: #fff;
    }

    .um-connected-item span {
      display: inline-block;
      margin-bottom: 18px;
      color: #DC2626;
      font-size: 1rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .um-connected-item strong {
      display: block;
      font-size: 1.35rem;
      line-height: 1.08;
      color: #050505;
    }

    .um-connected-item p {
      max-width: 320px;
      margin: 12px 0 0;
      color: #475569;
      line-height: 1.54;
    }

    .um-final-cta {
      background: #FFFFFF;
      color: #050505;
      padding: clamp(54px, 8vw, 88px) 0;
      border-top: 1px solid #d7d7d7;
