---
import LayoutV4 from '../layouts/LayoutV4.astro';
import { ArrowRight, ArrowUpRight, MapPin } from 'lucide-astro';

const heroLead = 'Redes, seguridad electrónica, telecomunicaciones, software a medida, soporte 24/7 y energía IT. Evidencia operativa visible antes de contratar.';
const heroVariants = [
  { image: '/hero/noc.png', fx: 'TYPE', title: 'Monitoreo 24/7 sin puntos ciegos.', lead: heroLead, caption: 'CENTRO DE OPERACIONES NOC · MENDOZA', code: '01/16' },
  { image: '/hero/fiber.png', fx: 'FLAP', title: 'Fibra certificada, operación continua.', lead: heroLead, caption: 'BACKBONE DE FIBRA ÓPTICA · AEROPUERTOS ARGENTINA 2000', code: '02/16' },
  { image: '/hero/cctv.png', fx: 'FLAP', title: 'Evidencia visual accionable.', lead: heroLead, caption: 'CENTRO DE MONITOREO CCTV · AEROPUERTO EL PLUMERILLO', code: '03/16' },
  { image: '/hero/bodega.png', fx: 'TYPE', title: 'Trazabilidad de cosecha a botella.', lead: heroLead, caption: 'REDES INDUSTRIALES EN CAVA · BODEGA TAPIZ', code: '04/16' },
  { image: '/hero/hospital.png', fx: 'TYPE', title: 'Continuidad para misión crítica.', lead: heroLead, caption: 'INFRAESTRUCTURA IT HOSPITALARIA · HOSPITAL PERRUPATO', code: '05/16' },
  { image: '/img/servicios/redes.webp', fx: 'TYPE', title: 'Redes que sostienen la operación.', lead: heroLead, caption: 'CABLEADO ESTRUCTURADO CERTIFICADO · MENDOZA', code: '06/16' },
  { image: '/img/servicios/seguridad-electronica.webp', fx: 'FLAP', title: 'CCTV, accesos y detección integrados.', lead: heroLead, caption: 'SEGURIDAD ELECTRÓNICA IP · CUYO', code: '07/16' },
  { image: '/img/servicios/telecomunicaciones.webp', fx: 'FLAP', title: 'Enlaces donde no llega nadie más.', lead: heroLead, caption: 'TELECOMUNICACIONES DATOS/VOZ/VIDEO · PATAGONIA', code: '08/16' },
  { image: '/img/servicios/deteccion-incendios.webp', fx: 'TYPE', title: 'Detección temprana, respuesta inmediata.', lead: heroLead, caption: 'SISTEMA SDI CERTIFICADO · TORRE THAYS', code: '09/16' },
  { image: '/img/servicios/electricos-it.webp', fx: 'TYPE', title: 'Energía limpia para data centers.', lead: heroLead, caption: 'ENERGÍA IT PARA DATACENTER · MENDOZA', code: '10/16' },
  { image: '/img/servicios/soporte-247.webp', fx: 'TYPE', title: 'Soporte con SLA garantizado.', lead: heroLead, caption: 'MESA DE AYUDA Y NOC 24/7 · 4 HUBS', code: '11/16' },
  { image: '/img/servicios/consultoria-it.webp', fx: 'TYPE', title: 'Arquitectura antes que marketing.', lead: heroLead, caption: 'CONSULTORÍA Y AUDITORÍA IT · ARGENTINA', code: '12/16' },
  { image: '/img/sectores/aeropuertos.webp', fx: 'FLAP', title: 'Perímetro, pistas y terminal 24/7.', lead: heroLead, caption: 'OPERACIÓN AEROPORTUARIA CONTINUA · AA2000', code: '13/16' },
  { image: '/img/sectores/salud.webp', fx: 'TYPE', title: 'Redes para imágenes médicas y historia clínica.', lead: heroLead, caption: 'INFRAESTRUCTURA HOSPITALARIA · FUESMEN', code: '14/16' },
  { image: '/img/sectores/mineria.webp', fx: 'FLAP', title: 'Conectividad en campamento y mina.', lead: heroLead, caption: 'TELECOMUNICACIONES EN FAENA REMOTA · MINERA FRONTERA', code: '15/16' },
  { image: '/img/sectores/industria.webp', fx: 'TYPE', title: 'Planta que no para, red que no falla.', lead: heroLead, caption: 'REDES INDUSTRIALES EN PLANTA 24/7 · CELA SA', code: '16/16' },
];

const initialHeroIndex = 8;
const initialHero = {
  ...heroVariants[initialHeroIndex],
  lead: heroLead,
};
const heroImage = initialHero.image;

const services = [
  {
    code: '101',
    name: 'Redes',
    text: 'Cableado estructurado y fibra óptica certificada.',
    href: '/servicios/101/infraestructura-de-redes-cableado-fibra-optica-radioenlaces',
    image: '/img/servicios/redes.webp',
  },
  {
    code: '102',
    name: 'Seguridad electrónica',
    text: 'CCTV IP, accesos y monitoreo documentado.',
    href: '/servicios/102/sistemas-de-seguridad-electronica-cctv-control-acceso-sistemas-de-deteccion-de-incendios-sdi',
    image: '/img/servicios/seguridad-electronica.webp',
  },
  {
    code: '103',
    name: 'Telecomunicaciones',
    text: 'Enlaces de datos, voz y video para sitios remotos.',
    href: '/servicios/103/telecomunicaciones-datos-voz-video',
    image: '/img/servicios/telecomunicaciones.webp',
  },
  {
    code: '104',
    name: 'Software a medida',
    text: 'Sistemas, APIs y tableros para procesos críticos.',
    href: '/servicios/104/desarrollo-de-software-a-medida-web-mobile-erp',
    image: '/img/servicios/software-a-medida.webp',
  },
  {
    code: '105',
    name: 'Soporte 24/7',
    text: 'Mesa de ayuda, NOC y mantenimiento con SLA.',
    href: '/servicios/105/soporte-tecnico-247-mesa-de-ayuda-mantenimiento-it',
    image: '/img/servicios/soporte-247.webp',
  },
  {
    code: '106',
    name: 'Consultoría IT',
    text: 'Arquitectura, auditoría y roadmap operativo.',
    href: '/servicios/106/consultoria-it-y-transformacion-digital-arquitectura-auditoria',
    image: '/img/servicios/consultoria-it.webp',
  },
  {
    code: '107',
    name: 'Detección de incendios',
    text: 'SDI, sensores y paneles para entornos productivos.',
    href: '/servicios/107/sistemas-de-deteccion-y-alarma-de-incendios',
    image: '/img/servicios/deteccion-incendios.webp',
  },
  {
    code: '108',
    name: 'Eléctricos IT',
    text: 'Tableros, UPS y energía limpia para infraestructura.',
    href: '/servicios/108/servicios-electricos-para-it',
    image: '/img/servicios/electricos-it.webp',
  },
];

const sectors = [
  { name: 'Aeropuertos', count: '58', text: 'CCTV de perímetro 24/7', href: '/aeropuertos', image: '/img/sectores/aeropuertos.webp', accent: '#1A56C0', big: true },
  { name: 'Bodegas', count: '67', text: 'Trazabilidad vitivinícola end-to-end', href: '/bodegas', image: '/img/sectores/bodegas.webp', accent: '#2D8A2D' },
  { name: 'Constructoras', count: '54', text: 'Cableado estructurado certificado', href: '/constructoras', image: '/img/sectores/constructoras.webp', accent: '#DC2626' },
  { name: 'Gobierno y Sector Público', count: '72', text: 'Digitalización de trámites', href: '/gobiernosectorpublico', image: '/img/sectores/gobierno.webp', accent: '#1A56C0' },
  { name: 'Industria', count: '63', text: 'Redes industriales en planta 24/7', href: '/industria', image: '/img/sectores/industria.webp', accent: '#DC2626' },
  { name: 'Minería', count: '41', text: 'Telecomunicaciones en campamento remoto', href: '/mineria', image: '/img/sectores/mineria.webp', accent: '#A1A1AA', big: true },
  { name: 'Salud', count: '69', text: 'Redes para imágenes médicas', href: '/salud', image: '/img/sectores/salud.webp', accent: '#DC2626' },
  { name: 'Seguridad Electrónica', count: '48', text: 'Centro de monitoreo 24/7', href: '/seguridad-electronica', image: '/img/sectores/seguridad-electronica.webp', accent: '#DC2626' },
  { name: 'Software', count: '38', text: 'ERPs y plataformas a medida', href: '/software', image: '/img/sectores/software.webp', accent: '#1A56C0' },
];

const cases = [
  {
    id: '3065',
    title: 'Camara de CCTV - Aeropuerto de Mendoza',
    meta: 'Aeropuertos Argentina 2000 / 2024',
    sector: 'Aeropuertos',
    href: '/antecedentes/3065/camara-de-cctv-aeropuerto-de-mendoza',
    image: '/img/antecedentes/3065.webp',
  },
  {
    id: '3087',
    title: 'Implementación de Redes de Datos y Fibra Óptica - FUESMEN',
    meta: 'FUESMEN / 2023',
    sector: 'Salud',
    href: '/antecedentes/3087/3087-implementacion-de-redes-de-datos-y-fibra-optica-fuesmen',
    image: '/img/antecedentes/3087.webp',
  },
  {
    id: '3064',
    title: 'Desarrollo de Software y Digitalización de Procesos para el Gobierno de Mendoza',
    meta: 'Gobierno de Mendoza / 2025',
    sector: 'Gobierno',
    href: '/antecedentes/3064/desarrollo-de-software-y-digitalizacion-de-procesos-para-el-gobierno-de-la-provincia-de-mendoza',
    image: '/img/antecedentes/3064.webp',
  },
  {
    id: '3081',
    title: 'Instalacion electrica para data center de bodega',
    meta: 'Bodega Tapiz / 2024',
    sector: 'Bodegas',
    href: '/antecedentes',
    image: '/img/antecedentes/3081.webp',
  },
];

const stats = [
  { value: '25', label: 'Años de operación', href: '/nosotros', aria: 'Ver trayectoria de ULTIMA MILLA' },
  { value: '518', label: 'Antecedentes operativos', href: '/antecedentes', aria: 'Ver archivo de antecedentes operativos' },
  { value: '9', label: 'Sectores atendidos', href: '/sectores', aria: 'Ver sectores atendidos' },
  { value: '320+', label: 'Clientes activos', href: '/antecedentes', aria: 'Ver evidencia por clientes y proyectos' },
  { value: '4', label: 'Hubs GEO', href: '/servicios-it-empresas-argentina', aria: 'Ver cobertura nacional y hubs GEO' },
  { value: '99.9%', label: 'Disponibilidad SLA', href: '/servicios/105/soporte-tecnico-247-mesa-de-ayuda-mantenimiento-it', aria: 'Ver soporte 24/7 y disponibilidad SLA' },
];

const hubs = [
  { name: 'Mendoza', region: 'Cuyo / sede central', coords: '-32.8908, -68.8272', href: '/servicios-it-empresas-mendoza', aria: 'Ver servicios IT para empresas en Mendoza' },
  { name: 'San Juan', region: 'Cuyo', coords: '-31.5375, -68.5364', href: '/servicios-it-empresas-argentina', aria: 'Ver cobertura de servicios IT para empresas en San Juan' },
  { name: 'San Luis', region: 'Cuyo', coords: '-33.2950, -66.3356', href: '/servicios-it-empresas-argentina', aria: 'Ver cobertura de servicios IT para empresas en San Luis' },
  { name: 'Neuquen', region: 'Patagonia', coords: '-38.9516, -68.0591', href: '/servicios-it-empresas-argentina', aria: 'Ver cobertura de servicios IT para empresas en Patagonia' },
];
---

<LayoutV4
  title="ULTIMA MILLA | Operaciones que no pueden detenerse"
  description="Servicios IT integrales para empresas en Mendoza, Cuyo y Patagonia: redes, seguridad electrónica, telecomunicaciones, software, soporte y energía IT."
  keywords="servicios IT, redes, seguridad electrónica, CCTV, telecomunicaciones, software a medida, soporte técnico 24/7, Mendoza, Cuyo, Patagonia"
  image={heroImage}
>
  <div class="um26-home">
    <section class="um26-hero" aria-labelledby="home-title" data-um26-hero data-hero-index={initialHeroIndex} data-hero-variants={JSON.stringify(heroVariants)}>
      <img class="um26-hero__image" data-hero-image src={heroImage} alt="" loading="eager" fetchpriority="high" decoding="async" />
      <div class="um26-hero__veil" aria-hidden="true"></div>

      <div class="um26-hero__top">
        <span class="um26-chip"><span></span>NOC · OPERATIVO</span>
        <span>Mendoza · Cuyo · Patagonia</span>
      </div>

      <a class="um26-hero__metric" href="/antecedentes" aria-label="Ver 518 antecedentes operativos">
        <span>Antecedentes operativos</span>
        <strong>5<b>1</b>8</strong>
        <i></i>
        <span>Casos verificables</span>
      </a>

      <button class="um26-hero__shuffle" type="button" aria-label="Cambiar fondo visual">
        <span class="um26-hero__shuffle-icon" aria-hidden="true">⌘</span>
        <span>Fondo</span>
        <b data-hero-fx>{initialHero.fx}</b>
      </button>

      <div class="um26-shell um26-hero__body">
        <p class="um26-kicker" data-hero-reveal style="--d: 120ms;"><span></span>Servicios IT · Desde 2000</p>
        <h1 id="home-title">
          <span data-hero-title>{initialHero.title}</span>
        </h1>
        <p class="um26-hero__lead" data-hero-reveal style="--d: 520ms;" data-hero-lead>{initialHero.lead}</p>
        <div class="um26-hero__actions">
          <a class="um26-btn um26-btn--red" data-hero-reveal style="--d: 680ms;" href="/antecedentes">Ver evidencia operativa <ArrowRight size={16} strokeWidth={2} /></a>
          <a class="um26-btn um26-btn--ghost" data-hero-reveal style="--d: 780ms;" href="/sectores">Entrar por sector <ArrowUpRight size={15} strokeWidth={2} /></a>
        </div>
        <p class="um26-hero__caption" data-hero-reveal style="--d: 900ms;"><MapPin size={12} strokeWidth={2} /><span data-hero-caption>{initialHero.caption}</span> <span data-hero-code>{initialHero.code}</span></p>
      </div>
    </section>

    <section class="um26-stats" aria-label="Indicadores ULTIMA MILLA">
      <div class="um26-shell um26-stats__inner">
        <div class="um26-stats__grid">
          {stats.map(({ value, label, href, aria }) => (
            <a href={href} aria-label={aria}>
              <strong>
                {value.endsWith('+') ? (
                  <>{value.slice(0, -1)}<b>+</b></>
                ) : value.endsWith('%') ? (
                  <>{value.slice(0, -1)}<b>%</b></>
                ) : (
                  value
                )}
              </strong>
              <span>{label}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="um26-section" id="servicios-it">
      <div class="um26-shell">
        <div class="um26-section__head">
          <div>
            <p class="um26-kicker"><span></span>01 / Servicios</p>
            <h2>Ocho frentes de servicio IT.</h2>
          </div>
          <p>Una arquitectura de servicio, no proveedores aislados. Cada frente con evidencia operativa documentada.</p>
        </div>

        <div class="um26-service-grid">
          {services.map((service, index) => (
            <a class="um26-media-card" href={service.href}>
              <img
                src={service.image}
                alt=""
                loading={index < 4 ? 'eager' : 'lazy'}
                fetchpriority={index === 0 ? 'high' : 'low'}
                decoding="async"
              />
              <span class="um26-media-card__code">{service.code}</span>
              <div>
                <h3>{service.name}</h3>
                <p>{service.text}</p>
              </div>
              <span class="um26-card-bar" aria-hidden="true"></span>
            </a>
          ))}
        </div>

        <a class="um26-text-link" href="/servicios">Ver arquitectura de servicio completa</a>
      </div>
    </section>

    <section class="um26-section um26-section--band" id="sectores">
      <div class="um26-shell">
        <div class="um26-section__head">
          <div>
            <p class="um26-kicker"><span></span>02 / Sectores</p>
            <h2>Infraestructura IT por sector.</h2>
          </div>
          <p>Nueve sectores con evidencia operativa real. Entrá por el suyo y revisá casos comparables antes de contratar.</p>
        </div>

        <div class="um26-sector-grid">
          {sectors.map((sector) => (
            <a class:list={['um26-media-card', 'um26-sector-card', { 'um26-sector-card--big': sector.big }]} href={sector.href} style={`--accent:${sector.accent};`}>
              <img src={sector.image} alt="" loading="lazy" decoding="async" />
              <strong>{sector.count}</strong>
              <div>
                <h3>{sector.name}</h3>
                <p>{sector.text}</p>
              </div>
              <span class="um26-card-bar" aria-hidden="true"></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="um26-section" id="antecedentes-home">
      <div class="um26-shell">
        <div class="um26-section__head">
          <div>
            <p class="um26-kicker"><span></span>03 / Evidencia</p>
            <h2>Antecedentes que prueban capacidad.</h2>
          </div>
          <p>518 casos operativos reales con cliente, sector, servicios aplicados y alcance técnico.</p>
        </div>

        <div class="um26-case-grid">
          {cases.map((item) => (
            <a class="um26-media-card um26-case-card" href={item.href}>
              <img src={item.image} alt="" loading="lazy" decoding="async" />
              <span class="um26-media-card__code">#{item.id}</span>
              <div>
                <p>{item.meta}</p>
                <h3>{item.title}</h3>
                <small>{item.sector}</small>
              </div>
              <span class="um26-card-bar" aria-hidden="true"></span>
            </a>
          ))}
        </div>

        <a class="um26-btn um26-btn--red um26-section__cta" href="/antecedentes">Explorar los 518 antecedentes</a>
      </div>
    </section>

    <section class="um26-section um26-section--band">
      <div class="um26-shell">
        <div class="um26-section__head">
          <div>
            <p class="um26-kicker"><span></span>04 / Cobertura</p>
            <h2>Hubs GEO · Cuyo + Patagonia.</h2>
          </div>
        </div>
        <div class="um26-hub-grid">
          {hubs.map(({ name, region, coords, href, aria }, index) => (
            <a href={href} aria-label={aria}>
              <p><span></span>HUB_{String(index + 1).padStart(2, '0')}</p>
              <strong>{name}</strong>
              <em>{region}</em>
              <small>{coords}</small>
              <span class="um26-hub-grid__action">Ver cobertura <ArrowUpRight size={15} strokeWidth={2} /></span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="um26-contact">
      <div class="um26-shell">
        <div class="um26-contact__panel">
          <div>
            <p class="um26-kicker"><span></span>Contacto rápido</p>
            <h2>Ordenemos su infraestructura y su continuidad operativa.</h2>
            <p>Respondemos en el día con un relevamiento técnico y una propuesta verificable. Sin compromiso inicial.</p>
          </div>
          <div>
            <a class="um26-btn um26-btn--red" href="mailto:contacto@ultimamilla.com.ar">contacto@ultimamilla.com.ar</a>
            <span>Lun-Vie 08:00-18:00</span>
          </div>
        </div>
      </div>
    </section>
  </div>

  <style>
    :global(body[data-skin]) main {
      background: #0a0a0b;
    }

    .um26-home {
      background: #0a0a0b;
      color: #fafafa;
      font-family: var(--um-font-body);
    }

    .um26-shell {
      width: min(1400px, calc(100% - 64px));
      margin-inline: auto;
    }

    .um26-hero {
      position: relative;
      min-height: 92vh;
      overflow: hidden;
      display: flex;
      align-items: flex-end;
      background: #0a0a0b;
      isolation: isolate;
    }

    .um26-hero__image,
    .um26-hero__veil {
      position: absolute;
      inset: 0;
    }

    .um26-hero__image {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      z-index: -3;
    }

    .um26-hero__veil {
      z-index: -2;
      background:
        linear-gradient(105deg, rgba(10, 10, 11, 0.94) 0%, rgba(10, 10, 11, 0.6) 42%, rgba(10, 10, 11, 0.3) 100%),
        linear-gradient(to top, #0a0a0b 0%, rgba(10, 10, 11, 0.55) 50%, transparent 100%);
    }

    .um26-hero__top {
      position: absolute;
      top: 20px;
      left: 50%;
      transform: translateX(-50%);
      width: min(1400px, calc(100% - 64px));
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 24px;
      color: rgba(255, 255, 255, 0.52);
      font-family: var(--font-geist-mono), ui-monospace, monospace;
      font-size: 0.5625rem;
      text-transform: uppercase;
      letter-spacing: 0.2em;
      z-index: 2;
    }

    .um26-chip {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 8px 12px;
      border: 1px solid rgba(255, 255, 255, 0.16);
      color: rgba(255, 255, 255, 0.74);
      background: rgba(10, 10, 11, 0.42);
    }

    .um26-chip span,
    .um26-hub-grid p span {
      width: 7px;
      height: 7px;
      background: #dc2626;
      display: inline-block;
    }

    .um26-hero__metric {
      position: absolute;
      right: 32px;
      top: 50%;
      transform: translateY(-50%);
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 8px;
      text-decoration: none;
      color: #fff;
      z-index: 2;
    }

    .um26-hero__metric span {
      writing-mode: vertical-rl;
      transform: rotate(180deg);
      font-size: 0.5625rem;
      text-transform: uppercase;
      letter-spacing: 0.25em;
      color: rgba(255, 255, 255, 0.55);
      font-family: var(--font-geist-mono), ui-monospace, monospace;
    }

    .um26-hero__metric strong {
      font-family: var(--um-font-display);
      font-size: 7rem;
      line-height: 0.8;
      letter-spacing: var(--um-display-tracking);
      text-shadow: 0 20px 55px rgba(0, 0, 0, 0.65);
    }

    .um26-hero__metric b {
      color: #dc2626;
      font-weight: inherit;
    }

    .um26-hero__metric i {
      width: 1px;
      height: 56px;
      background: linear-gradient(to bottom, #dc2626, transparent);
    }

    .um26-hero__shuffle {
      position: absolute;
      top: 64px;
      right: 32px;
      display: inline-flex;
      align-items: center;
      gap: 10px;
      font-family: var(--font-geist-mono), ui-monospace, monospace;
      border: 1px solid rgba(255, 255, 255, 0.16);
      background: rgba(10, 10, 11, 0.72);
      backdrop-filter: blur(8px);
      padding: 10px 13px;
      color: rgba(255, 255, 255, 0.78);
      text-transform: uppercase;
      letter-spacing: 0.16em;
      font-size: 0.5625rem;
      z-index: 2;
      cursor: pointer;
      opacity: 0;
      transform: translateY(14px);
      animation: um26FadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) 0.42s forwards;
    }

    .um26-home .um26-hero__shuffle,
    .um26-home .um26-hero__shuffle * {
