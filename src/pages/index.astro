              </div>
              
              <!-- Title -->
              <h3 class="text-3xl font-bold text-white mb-3 transition-colors duration-300 group-hover:text-sky-400">
                Aeropuertos
              </h3>
              
              <!-- Description -->
              <p class="text-sm text-gray-400 mb-6 leading-relaxed">
                Comunicaciones críticas y seguridad aeroportuaria
              </p>
              
              <!-- Stats Mini -->
              <div class="flex items-center gap-6 mb-6 pb-6 border-b border-gray-700/50">
                <div>
                  <div class="text-2xl font-bold text-white">35+</div>
                  <div class="text-xs text-gray-500">Proyectos</div>
                </div>
                <div>
                  <div class="text-2xl font-bold text-white">24/7</div>
                  <div class="text-xs text-gray-500">Soporte</div>
                </div>
              </div>
              
              <!-- CTA -->
              <div class="flex items-center gap-2 text-sm font-medium text-gray-400 transition-all duration-300 group-hover:text-sky-400 group-hover:gap-3">
                <span>Ver más</span>
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </div>
          </a>

          <!-- Salud - ULTRA REFINADO -->
          <a href="/salud" class="group relative block overflow-hidden rounded-2xl bg-gradient-to-br from-gray-900 to-gray-800 border border-gray-700/50 transition-all duration-500 hover:border-teal-500/50 hover:shadow-2xl hover:shadow-teal-500/10">
            <div class="p-8">
              <!-- Indicator -->
              <div class="mb-6 flex items-center gap-3">
                <div class="h-1 w-12 rounded-full bg-gradient-to-r from-teal-500 to-emerald-500"></div>
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">Sector</span>
              </div>
              
              <!-- Title -->
              <h3 class="text-3xl font-bold text-white mb-3 transition-colors duration-300 group-hover:text-teal-400">
                Salud
              </h3>
              
              <!-- Description -->
              <p class="text-sm text-gray-400 mb-6 leading-relaxed">
                Tecnología hospitalaria y sistemas críticos de salud
              </p>
              
              <!-- Stats Mini -->
              <div class="flex items-center gap-6 mb-6 pb-6 border-b border-gray-700/50">
                <div>
                  <div class="text-2xl font-bold text-white">40+</div>
                  <div class="text-xs text-gray-500">Proyectos</div>
                </div>
                <div>
                  <div class="text-2xl font-bold text-white">15+</div>
                  <div class="text-xs text-gray-500">Años</div>
                </div>
              </div>
              
              <!-- CTA -->
              <div class="flex items-center gap-2 text-sm font-medium text-gray-400 transition-all duration-300 group-hover:text-teal-400 group-hover:gap-3">
                <span>Ver más</span>
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </div>
          </a>

          <!-- Bodegas - ULTRA REFINADO -->
          <a href="/bodegas" class="group relative block overflow-hidden rounded-2xl bg-gradient-to-br from-gray-900 to-gray-800 border border-gray-700/50 transition-all duration-500 hover:border-purple-500/50 hover:shadow-2xl hover:shadow-purple-500/10">
            <div class="p-8">
              <!-- Indicator -->
              <div class="mb-6 flex items-center gap-3">
                <div class="h-1 w-12 rounded-full bg-gradient-to-r from-purple-500 to-violet-500"></div>
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">Sector</span>
              </div>
              
              <!-- Title -->
              <h3 class="text-3xl font-bold text-white mb-3 transition-colors duration-300 group-hover:text-purple-400">
                Bodegas
              </h3>
              
              <!-- Description -->
              <p class="text-sm text-gray-400 mb-6 leading-relaxed">
                Tecnología para bodegas y vitivinicultura
              </p>
              
              <!-- Stats Mini -->
              <div class="flex items-center gap-6 mb-6 pb-6 border-b border-gray-700/50">
                <div>
                  <div class="text-2xl font-bold text-white">10+</div>
                  <div class="text-xs text-gray-500">Proyectos</div>
                </div>
                <div>
                  <div class="text-2xl font-bold text-white">5+</div>
                  <div class="text-xs text-gray-500">Años</div>
                </div>
              </div>
              
              <!-- CTA -->
              <div class="flex items-center gap-2 text-sm font-medium text-gray-400 transition-all duration-300 group-hover:text-purple-400 group-hover:gap-3">
                <span>Ver más</span>
                <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </div>
            </div>
          </a>

