          <a href="/software" class="group relative block overflow-hidden rounded-2xl bg-gradient-to-br from-gray-900 to-gray-800 border border-gray-700/50 transition-all duration-500 hover:border-cyan-500/50 hover:shadow-2xl hover:shadow-cyan-500/10">
            <div class="p-8">
              <!-- Indicator -->
              <div class="mb-6 flex items-center gap-3">
                <div class="h-1 w-12 rounded-full bg-gradient-to-r from-cyan-500 to-blue-500"></div>
                <span class="text-xs font-semibold uppercase tracking-wider text-gray-500">Sector</span>
              </div>
              
              <!-- Title -->
              <h3 class="text-3xl font-bold text-white mb-3 transition-colors duration-300 group-hover:text-cyan-400">
                Software
              </h3>
              
              <!-- Description -->
              <p class="text-sm text-gray-400 mb-6 leading-relaxed">
                Desarrollo de software a medida y personalizado
              </p>
              
              <!-- Stats Mini -->
              <div class="flex items-center gap-6 mb-6 pb-6 border-b border-gray-700/50">
                <div>
