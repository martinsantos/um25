---
/**
 * Homepage — Servicios IT integrales
 * Industrial editorial system for ULTIMA MILLA.
 */

import LayoutV4 from '../layouts/LayoutV4.astro';
import EvidenceCaseRow from '../components/um/EvidenceCaseRow.astro';
import EvidenceItem from '../components/templates/EvidenceItem.astro';
import TrustStrip from '../components/um/TrustStrip.astro';
import { generateSlug } from '../utils/slugUtils.js';
import { getAllServicios } from '../utils/directusHelpers';
import { getDirectusImageUrl, getAllAntecedentes } from '../lib/directus.ts';
import { getServiceVisualSpec, serviceVisualOrder } from '../data/serviceVisualSystem';
import { resolveReplicaH1 } from '../utils/replicaProdCopy';
import { extractCaseMetricsFromAntecedente } from '../utils/caseMetrics';
import {
  getAntecedentesCountShort,
  getAntecedentesCatalogCount,
} from '../utils/verifiedProof';

const homeH1 = resolveReplicaH1('/', 'Servicios IT para operaciones que no pueden detenerse.');

const serviciosFromDirectus = await getAllServicios();

let antecedentesData: any[] = [];
try {
  antecedentesData = await getAllAntecedentes();
} catch {
  antecedentesData = [];
}

const serviceById = new Map(serviciosFromDirectus.map((service: any) => [Number(service.id), service]));

const serviceModules = serviceVisualOrder
  .map((serviceId) => {
    const service = serviceById.get(serviceId);
    const visual = getServiceVisualSpec(serviceId);
    if (!service || !visual) return null;

    return {
      ...service,
      visual,
      slug: service.slug || generateSlug(service.Titulo),
      href: `/servicios/${service.id}/${service.slug || generateSlug(service.Titulo)}`,
      description: String(service.Descripcion || '').replace(/\\\\/g, ' ')
    };
  })
  .filter(Boolean);

const homeHeroImage = '/uploads/hero/c194b40e-925c-4de5-924b-ea61ab835c0e.jpg';
const proofCountShort = getAntecedentesCountShort();
const proofCountExact = getAntecedentesCatalogCount();

const caseTargets = [
  { label: 'Gobierno de Mendoza', terms: ['gobierno de mendoza', 'ministerio', 'municipalidad'] },
  { label: 'Aeropuertos Argentina 2000', terms: ['aeropuerto', 'aeropuertos argentina'] },
  { label: 'Consorcio Torre Thays', terms: ['torre thays', 'thays'] }
];

function caseText(item: any): string {
  return `${item.Cliente || ''} ${item.Titulo || item.Nombre || ''} ${item.Area || ''} ${item.Descripcion || ''}`.toLowerCase();
}

const featuredCases: any[] = [];
for (const target of caseTargets) {
  const match = antecedentesData.find((item) => target.terms.some((term) => caseText(item).includes(term)));
  if (match && !featuredCases.some((item) => item.id === match.id)) {
    featuredCases.push({ ...match, fallbackLabel: target.label });
  }
}

for (const item of antecedentesData) {
  if (featuredCases.length >= 3) break;
  if (!featuredCases.some((featured) => featured.id === item.id)) featuredCases.push(item);
}

const featuredCasesEnhanced = featuredCases.slice(0, 3).map((item) => ({
  ...item,
  title: item.Titulo || item.Nombre || item.fallbackLabel || 'Proyecto ULTIMA MILLA',
  slug: generateSlug(item.Titulo || item.Nombre || 'proyecto'),
  imageUrl: getDirectusImageUrl(item.Imagen) || '/images/default-background.jpg',
  sector: item.Area || item.Unidad_de_negocio || item.Sector || 'Servicios IT'
}));

const primaryEvidenceCase = featuredCasesEnhanced[0];
const secondaryEvidenceCases = featuredCasesEnhanced.slice(1);

const evidenceYear = (item: any) => {
  const raw = item?.Fecha || item?.fecha || item?.anio;
  if (!raw) return 'documentado';
  const date = new Date(raw);
  return Number.isNaN(date.getTime()) ? String(raw) : String(date.getFullYear());
};

const sectorLinks = [
  { slug: 'aeropuertos', label: 'Aeropuertos', cue: 'operación continua' },
  { slug: 'bodegas', label: 'Bodegas', cue: 'producción conectada' },
  { slug: 'constructoras', label: 'Construcción', cue: 'obra y seguridad' },
  { slug: 'salud', label: 'Salud', cue: 'sistemas críticos' },
  { slug: 'gobiernosectorpublico', label: 'Gobierno', cue: 'escala pública' },
  { slug: 'software', label: 'Software', cue: 'procesos propios' },
  { slug: 'mineria', label: 'Minería', cue: 'entornos exigentes' },
  { slug: 'industria', label: 'Industria', cue: 'planta y energía' },
  { slug: 'seguridad-electronica', label: 'Seguridad', cue: 'monitoreo y acceso' }
];

const proofMetrics = [
  ['8', 'servicios IT', 'red, seguridad, software, energía y soporte'],
  [proofCountShort, 'antecedentes', `${proofCountExact} proyectos documentados`],
  ['22+', 'años', 'de trayectoria técnica en infraestructura'],
  ['24/7', 'soporte', 'operación y monitoreo continuo']
];

const iconPaths: Record<string, string> = {
  network: '<path d="M6 9v6"/><path d="M18 9v6"/><path d="M10 12h4"/><rect x="3" y="4" width="6" height="5" rx="1.5"/><rect x="15" y="4" width="6" height="5" rx="1.5"/><rect x="3" y="15" width="6" height="5" rx="1.5"/><rect x="15" y="15" width="6" height="5" rx="1.5"/><path d="M9 6.5h6"/><path d="M9 17.5h6"/>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/><path d="m9 12 2 2 4-4"/>',
  radio: '<circle cx="12" cy="12" r="2"/><path d="M16.24 7.76a6 6 0 0 1 0 8.49"/><path d="M7.76 16.24a6 6 0 0 1 0-8.49"/><path d="M19.07 4.93a10 10 0 0 1 0 14.14"/><path d="M4.93 19.07a10 10 0 0 1 0-14.14"/>',
  code: '<path d="m16 18 6-6-6-6"/><path d="m8 6-6 6 6 6"/><path d="m14 4-4 16"/>',
  headset: '<path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3z"/><path d="M3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/><path d="M12 21v-2"/>',
  briefcase: '<rect x="2" y="7" width="20" height="14" rx="2"/><path d="M16 7V5a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><path d="M2 12h20"/><path d="M12 12v2"/>',
  flame: '<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>',
  bolt: '<path d="M13 2 4 14h7l-1 8 10-13h-7l0-7z"/>'
};

const websiteSchema = {
  "@type": "WebSite",
  "name": "ULTIMA MILLA",
  "url": "https://www.ultimamilla.com.ar",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "https://www.ultimamilla.com.ar/antecedentes?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
};

---

<LayoutV4
  title="ULTIMA MILLA | Servicios IT para operaciones que no pueden detenerse"
  description="Servicios IT integrales para empresas en Mendoza, Cuyo y Patagonia: redes, seguridad electrónica, telecomunicaciones, software, soporte, consultoría, incendios y energía."
  keywords="servicios IT integrales, redes empresariales, seguridad electrónica, telecomunicaciones, software a medida, soporte técnico 24/7, consultoría IT, detección incendio, energía para IT, Mendoza, Cuyo, Patagonia"
  image={homeHeroImage}
  structuredData={websiteSchema}
>
  <section class="um-home-hero">
    <div class="um-hero-media" aria-hidden="true">
      <img src={homeHeroImage} alt="" loading="eager" fetchpriority="high" decoding="async" width="1920" height="1080" />
    </div>
    <div class="um-hero-grid" aria-hidden="true"></div>

    <div class="um-home-container um-hero-content">
      <div class="um-hero-copy">
        <h1>{homeH1}</h1>
        <span class="um-red-rule" aria-hidden="true"></span>
        <p>
          Redes, seguridad electrónica, telecomunicaciones, software, energía y soporte técnico para empresas que necesitan continuidad, evidencia y respuesta en sitio.
        </p>
        <div class="um-hero-actions">
          <a class="um-btn um-btn-primary" href="/contacto">Solicitar diagnóstico</a>
          <a class="um-btn um-btn-secondary" href="/antecedentes">Ver antecedentes</a>
        </div>
        <figure class="um-hero-mobile-photo">
          <img src={homeHeroImage} alt="Centro de monitoreo e infraestructura IT operativa" loading="eager" fetchpriority="high" decoding="async" width="1920" height="1080" />
          <figcaption>
            <span>Operación técnica</span>
            <strong>Mendoza, Cuyo y Patagonia</strong>
          </figcaption>
        </figure>
      </div>
    </div>

    <div class="um-home-container um-hero-proofbar" aria-label="Prueba institucional">
      {proofMetrics.map(([value, label, text]) => (
        <div>
          <strong>{value}</strong>
          <span>{label}</span>
          <p>{text}</p>
        </div>
      ))}
    </div>
  </section>

  <TrustStrip />

  <section class="um-service-system" id="servicios-it">
    <div class="um-home-container">
      <div class="um-services-command">
        <div class="um-services-command__copy">
          <span class="um-red-rule" aria-hidden="true"></span>
          <h2>Ocho frentes de servicio IT.</h2>
          <p>
            Ocho frentes conectados por una misma forma de trabajo: relevar, diseñar, implementar, documentar y sostener infraestructura para operaciones exigentes.
          </p>
          <div class="um-services-command__links">
            <a href="/servicios" class="um-arrow-link">Ver todos los servicios</a>
            <a href="/servicios#decision" class="um-arrow-link um-arrow-link--muted">Próximo paso por intención</a>
          </div>
        </div>

        <div class="um-services-command__visual" aria-hidden="true">
          <img src="/uploads/antecedentes/00ef116b-3455-4de2-aa10-22ad8803318f.jpg" alt="" loading="eager" decoding="async" fetchpriority="low" />
          <div class="um-services-signal">
            <span>Respuesta</span>
            <strong>24/7</strong>
          </div>
        </div>

        <div class="um-service-rail" aria-label="Frentes de servicios IT">
          {serviceModules.map((service: any, index: number) => (
            <a
              href={service.href}
              class="um-service-unit"
              style={`--service-accent:${service.visual.accent};`}
            >
              <div class="um-service-unit__head">
                <span>{String(index + 1).padStart(2, '0')}</span>
              </div>
              <div class="um-service-unit__icon" aria-hidden="true">
                <svg fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.8" set:html={iconPaths[service.visual.icon]} />
              </div>
              <h3>{service.visual.shortName}</h3>
              <p>{service.visual.proof}</p>
            </a>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="um-evidence-section" id="antecedentes-home">
    <div class="um-home-container um-evidence-layout">
      <div class="um-evidence-main">
        <div class="um-evidence-head">
          <div>
            <span class="um-red-rule" aria-hidden="true"></span>
            <p>Antecedentes</p>
            <h2>Antecedentes que prueban capacidad operativa.</h2>
          </div>
          <div class="um-evidence-head__side">
            <p>
              {proofCountExact} proyectos documentados en el catálogo respaldan nuestra forma de trabajar: alcance técnico, evidencia y continuidad posterior.
            </p>
            <a href="/antecedentes">Ver todos los antecedentes</a>
          </div>
        </div>

        {primaryEvidenceCase && (
          <EvidenceItem
            variant="feature"
            class="um-evidence-feature-slot"
            href={`/antecedentes/${primaryEvidenceCase.id}/${primaryEvidenceCase.slug}`}
            title={primaryEvidenceCase.Cliente || primaryEvidenceCase.sector || primaryEvidenceCase.title}
            description={primaryEvidenceCase.title}
            image={primaryEvidenceCase.imageUrl}
            imageAlt={primaryEvidenceCase.title}
            eyebrow="Proyecto destacado"
            sector={primaryEvidenceCase.sector}
            meta={[{ label: 'Alcance', value: 'instalación + integración + soporte' }]}
            cta="Ver dossier del proyecto"
          />
        )}

        {secondaryEvidenceCases.length > 0 && (
          <div class="um-evidence-ledger" aria-label="Antecedentes destacados">
            {secondaryEvidenceCases.map((item, index) => (
              <EvidenceCaseRow
                href={`/antecedentes/${item.id}/${item.slug}`}
                number={String(index + 2).padStart(2, '0')}
                title={item.Cliente || item.sector || item.title}
                description={item.title}
                image={item.imageUrl}
                imageAlt={item.title}
                sector={item.sector}
                year={evidenceYear(item)}
                imageLoading="eager"
                metrics={extractCaseMetricsFromAntecedente(item)}
              />
            ))}
          </div>
        )}

        <div class="um-evidence-action">
          <p>Explore más proyectos por sector, servicio y tipo de operación.</p>
        </div>
      </div>

      <aside class="um-evidence-sector-rail">
        <div>
          <span class="um-red-rule" aria-hidden="true"></span>
          <p>Sectores</p>
        </div>
        <nav aria-label="Sectores con antecedentes">
          {sectorLinks.map((sector, index) => (
            <a href={`/${sector.slug}`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{sector.label}</strong>
              <em>{sector.cue}</em>
            </a>
          ))}
        </nav>
        <p>Mapa de riesgo operativo por industria. Cada sector enlaza a antecedentes y alcance técnico documentado.</p>
      </aside>
      </div>
  </section>

  <section class="um-final-cta">
    <div class="um-home-container">
      <div>
        <p>Diagnóstico inicial</p>
        <h2>Ordenemos su infraestructura, sus sistemas y su continuidad operativa.</h2>
      </div>
      <a class="um-btn um-btn-primary" href="/contacto">Coordinar diagnóstico</a>
    </div>
  </section>

  <style>
    :global(.um-home-container) {
      width: min(1180px, calc(100% - 32px));
      margin-inline: auto;
    }

    .um-home-hero {
      position: relative;
      min-height: min(580px, calc(100svh - 5.5rem));
      overflow: hidden;
      background: #050505;
      color: #ffffff;
      display: grid;
      align-items: end;
      isolation: isolate;
    }

    .um-hero-media {
      position: absolute;
      inset: 0;
      opacity: 0.74;
      z-index: -3;
    }

    .um-hero-media img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(0.18) contrast(1.04) saturate(0.84);
    }

    .um-hero-media img {
      object-position: center;
    }

    .um-home-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -2;
      background:
        linear-gradient(90deg, rgba(0,0,0,0.92) 0%, rgba(0,0,0,0.78) 52%, rgba(0,0,0,0.36) 100%),
        linear-gradient(180deg, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.78) 100%);
    }

    .um-hero-grid {
      position: absolute;
      inset: 0;
      z-index: -1;
      opacity: 0.14;
      background:
        linear-gradient(rgba(220,38,38,0.2) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255,255,255,0.12) 1px, transparent 1px);
      background-size: 120px 120px, 120px 120px;
      mask-image: linear-gradient(90deg, black 0%, transparent 82%);
    }

    .um-hero-content {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(330px, 440px);
      gap: clamp(38px, 7vw, 108px);
      align-items: end;
      min-height: min(640px, calc(100svh - 5.5rem));
      padding: clamp(56px, 7vw, 86px) 0 clamp(34px, 5vw, 58px);
    }

    @media (min-width: 981px) and (min-height: 700px) {
      .um-hero-content {
        align-items: start;
        min-height: min(620px, calc(100svh - 6rem));
        padding-top: clamp(28px, 3.5vw, 48px);
      }
    }

    .um-hero-copy h1 {
      max-width: 920px;
      font-family: var(--um-font-display);
      font-size: clamp(2.35rem, 3.48vw, 3.9rem);
      line-height: 1.06;
      letter-spacing: 0;
      font-weight: 600;
      margin: 0;
    }

    .um-hero-copy p {
      max-width: 720px;
      margin: 24px 0 0;
      font-size: clamp(1.08rem, 1.45vw, 1.28rem);
      line-height: 1.6;
      color: rgba(255,255,255,0.82);
    }

    .um-hero-board {
      border: 0;
      background:
        linear-gradient(135deg, rgba(220,38,38,0.12), transparent 46%),
        rgba(8,8,8,0.68);
      backdrop-filter: blur(10px);
    }

    .um-hero-board__head {
      padding: 24px 26px 22px;
      border-bottom: 0;
    }

    .um-hero-board__head span,
    .um-hero-lanes span {
      display: block;
      color: #ff5b57;
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 0.12em;
      line-height: 1;
      text-transform: uppercase;
    }

    .um-hero-board__head strong {
      display: block;
      max-width: 320px;
      margin-top: 14px;
      font-family: var(--um-font-display);
      font-size: clamp(1.42rem, 1.78vw, 1.92rem);
      line-height: 1.08;
      font-weight: 600;
      color: #fff;
    }

    .um-hero-lanes {
      display: grid;
    }

    .um-hero-lanes div {
      position: relative;
      padding: 17px 26px 17px 56px;
      border-bottom: 1px solid rgba(255,255,255,0.07);
    }

    .um-hero-lanes div::before {
      content: "";
      position: absolute;
      left: 28px;
      top: 26px;
      width: 10px;
      height: 10px;
      background: #DC2626;
      box-shadow: none;
    }

    .um-hero-lanes div::after {
      content: "";
      position: absolute;
      left: 32px;
      top: 44px;
      bottom: -8px;
      width: 1px;
      background: rgba(255,255,255,0.09);
    }

    .um-hero-lanes div:last-child::after {
      display: none;
    }

    .um-hero-lanes p {
      margin: 8px 0 0;
      color: rgba(255,255,255,0.7);
      font-size: 1rem;
      line-height: 1.52;
    }

    .um-hero-actions,
    .um-final-cta .um-home-container {
      display: flex;
      flex-wrap: wrap;
      gap: 14px;
      align-items: center;
    }

    .um-hero-actions {
      margin-top: 32px;
    }

    .um-hero-mobile-photo {
      display: none;
    }

    .um-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      box-sizing: border-box;
      min-height: 48px;
      padding: 0 22px;
      border-radius: 4px;
      font-size: 1rem;
      font-weight: 600;
      letter-spacing: 0.01em;
      transition: background 180ms ease, border-color 180ms ease;
    }

    .um-btn:hover {
      transform: none;
    }

    .um-btn-primary {
      background: #DC2626;
      border: 0;
      background-clip: border-box;
      box-shadow: none;
      color: #fff;
    }

    .um-btn-secondary {
      color: #fff;
      border: 0;
      background: rgba(255,255,255,0.1);
    }

    .um-hero-proof {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin: 0;
    }

    .um-hero-proof div {
      min-height: 84px;
      padding: 16px 16px;
      border-right: 1px solid rgba(255,255,255,0.07);
      background: rgba(255,255,255,0.04);
    }

    .um-hero-proof div:last-child {
      border-right: 0;
    }

    .um-hero-proof dt {
      max-width: 170px;
      color: rgba(255,255,255,0.68);
      font-size: 1rem;
      line-height: 1.35;
      font-weight: 700;
      text-transform: uppercase;
    }

    .um-hero-proof dd {
      margin: 10px 0 0;
      color: #fff;
      font-size: clamp(1.5rem, 2.1vw, 2.05rem);
      line-height: 1;
      font-weight: 700;
    }

    .um-service-system,
    .um-connected-section {
      background: #fff;
      color: #0f172a;
      padding: clamp(64px, 9vw, 112px) 0;
    }

    .um-section-heading {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 32px;
      align-items: start;
      margin-bottom: 42px;
      padding-top: 28px;
    }

    .um-section-heading p {
      margin: 0;
      color: #DC2626;
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0;
      text-transform: uppercase;
      grid-column: 1 / -1;
    }

    .um-section-heading h2 {
      margin: 0;
      max-width: 820px;
      font-family: var(--um-font-display);
      font-size: clamp(2rem, 3vw, 3.25rem);
      line-height: 1.04;
      letter-spacing: 0;
      color: #050505;
    }

    .um-section-heading a {
      color: #111;
      font-size: 1rem;
      font-weight: 600;
      border-bottom: 1px solid #DC2626;
      padding-bottom: 4px;
      white-space: nowrap;
    }

    .um-service-matrix {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }

    .um-service-module {
      position: relative;
      min-height: 300px;
      display: grid;
      grid-template-columns: minmax(170px, 0.75fr) minmax(0, 1.25fr);
      color: #111;
      border: 0;
      background: #fff;
      overflow: hidden;
    }

    .um-service-module::before {
      content: var(--service-index);
      position: absolute;
      top: 18px;
      right: 18px;
      z-index: 2;
      color: rgba(15,23,42,0.2);
      font-size: 1rem;
      font-weight: 700;
      letter-spacing: 0;
    }

    .um-service-image {
      position: relative;
      min-height: 100%;
      background: #ffffff;
      overflow: hidden;
    }

    .um-service-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
      filter: grayscale(0.28) contrast(1.02) saturate(0.72);
      transition: none;
    }

    .um-service-image::after {
      content: '';
      position: absolute;
      inset: 0;
      background:
        linear-gradient(rgba(255,255,255,0.12) 1px, transparent 1px),
