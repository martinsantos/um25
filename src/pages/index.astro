---
import { ANTECEDENTES_REALES } from '../lib/um26-data/antecedentesReales';
import { sectorCaseLabel } from '../data/sectorCaseCounts';
import { getAntecedentesCatalogCount } from '../utils/verifiedProof';
import LayoutV4 from '../layouts/LayoutV4.astro';
import EmailLink from '../components/common/EmailLink.astro';
import CineBanner from '../components/cine/CineBanner.astro';
import ServicesStory from '../components/cine/ServicesStory.astro';
import SectorAtlas from '../components/cine/SectorAtlas.astro';
import { NAV_SERVICES } from '../data/navigation';
import { HOME_SCENES, V4_CUTS } from '../data/cine/scenes';
import { sectorPoster } from '../data/cine/posters';

// La home cuenta una sola historia: arriba el Blender (CineBanner), debajo el despiece
// (ServicesStory: los ocho servicios junto al edificio que se segmenta por capas), después
// los sectores, los proyectos como lista sobria y el cierre de contacto.

// Hero variable: cada visita arranca en otra escena y cada escena elige al azar uno de
// sus recorridos v4 (servicio dentro de la escena). SSR: cambia en cada carga.
const heroVariants = Object.fromEntries(
  HOME_SCENES.map((s) => [s.scene, Object.keys(V4_CUTS).filter((k) => k.startsWith(`${s.scene}-`))]),
);
const heroStart = Math.floor(Math.random() * HOME_SCENES.length);

const heroLead = 'Redes, seguridad electrónica, telecomunicaciones, software a medida, soporte 24/7 y energía IT. Evidencia operativa visible antes de contratar.';

const services = NAV_SERVICES;

const sectors = [
  { name: 'Aeropuertos', count: sectorCaseLabel('aeropuertos'), text: 'CCTV de perímetro 24/7', href: '/aeropuertos', image: sectorPoster('aeropuertos'), accent: '#DC2626', big: true },
  { name: 'Bodegas', count: sectorCaseLabel('bodegas'), text: 'Trazabilidad vitivinícola end-to-end', href: '/bodegas', image: sectorPoster('bodegas'), accent: '#DC2626' },
  { name: 'Constructoras', count: sectorCaseLabel('constructoras'), text: 'Cableado estructurado certificado', href: '/constructoras', image: sectorPoster('constructoras'), accent: '#DC2626' },
  { name: 'Gobierno y Sector Público', count: sectorCaseLabel('gobiernosectorpublico'), text: 'Digitalización de trámites', href: '/gobiernosectorpublico', image: sectorPoster('gobierno'), accent: '#DC2626' },
  { name: 'Industria', count: sectorCaseLabel('industria'), text: 'Redes industriales en planta 24/7', href: '/industria', image: sectorPoster('industria'), accent: '#DC2626' },
  { name: 'Minería', count: sectorCaseLabel('mineria'), text: 'Telecomunicaciones en campamento remoto', href: '/mineria', image: sectorPoster('mineria'), accent: '#DC2626', big: true },
  { name: 'Salud', count: sectorCaseLabel('salud'), text: 'Redes para imágenes médicas', href: '/salud', image: sectorPoster('salud'), accent: '#DC2626' },
  { name: 'Seguridad Electrónica', count: sectorCaseLabel('seguridad-electronica'), text: 'Centro de monitoreo 24/7', href: '/seguridad-electronica', image: sectorPoster('seguridad-electronica'), accent: '#DC2626' },
  { name: 'Software', count: sectorCaseLabel('software'), text: 'ERPs y plataformas a medida', href: '/software', image: sectorPoster('software'), accent: '#DC2626' },
];

// Proyectos: registros reales del catálogo (ANTECEDENTES_REALES), con su ficha pública.
const SECTOR_LABEL: Record<string, string> = {
  aeropuertos: 'Aeropuertos', bodegas: 'Bodegas', constructoras: 'Constructoras', gobierno: 'Gobierno',
  industria: 'Industria', mineria: 'Minería', salud: 'Salud', 'seguridad-electronica': 'Seguridad electrónica', software: 'Software',
};
type Antecedente = (typeof ANTECEDENTES_REALES)[number];

// Los cuatro destacados de siempre.
const FEATURED = [3065, 3075, 3064, 3334];

// Título sin el sufijo «- Cliente» que repite la columna de cliente.
const cleanTitle = (item: Antecedente) =>
  item.title.replace(new RegExp(`\\s*-\\s*${item.client.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')}.*$`, 'i'), '').trim() || item.title;

const featured = FEATURED.flatMap((id) => ANTECEDENTES_REALES.find((item) => item.id === id) ?? []);

// Cuatro más: los más recientes del catálogo, uno por sector, prefiriendo sectores que
// los destacados no cubren. Sin cliente confidencial ni fecha desconocida.
const recientes = ANTECEDENTES_REALES
  .filter((item) => item.year > 0 && item.client !== 'Cliente confidencial' && !FEATURED.includes(item.id))
  .sort((a, b) => b.year - a.year || b.month - a.month || b.id - a.id);
const sectoresDestacados = new Set(featured.map((item) => item.sectorSlug));
const masProyectos: Antecedente[] = [];
for (const evitarDestacados of [true, false]) {
  for (const item of recientes) {
    if (masProyectos.length >= 4) break;
    if (masProyectos.some((elegido) => elegido.sectorSlug === item.sectorSlug)) continue;
    if (evitarDestacados && sectoresDestacados.has(item.sectorSlug)) continue;
    masProyectos.push(item);
  }
}

const projects = [...featured, ...masProyectos].map((item) => ({
  id: item.id,
  client: item.client,
  title: cleanTitle(item),
  sector: SECTOR_LABEL[item.sectorSlug] || '',
  year: item.year ? String(item.year) : '',
  href: `/antecedentes/${item.id}/${item.slug}`,
}));

const catalogCount = getAntecedentesCatalogCount();

const stats = [
  { value: '22+', label: 'Años de operación', href: '/nosotros', aria: 'Ver trayectoria de ULTIMA MILLA' },
  { value: String(catalogCount), label: 'Proyectos documentados', href: '/antecedentes', aria: 'Ver proyectos documentados' },
  { value: '9', label: 'Sectores atendidos', href: '/sectores', aria: 'Ver sectores atendidos' },
];
---

<LayoutV4 skin="black"
  title="ULTIMA MILLA | Operaciones que no pueden detenerse"
  description="Servicios IT integrales para empresas en Mendoza, Cuyo y Patagonia: redes, seguridad electrónica, telecomunicaciones, software, soporte y energía IT."
  keywords="servicios IT, redes, seguridad electrónica, CCTV, telecomunicaciones, software a medida, soporte técnico 24/7, Mendoza, Cuyo, Patagonia"
  image={sectorPoster('aeropuertos')}
>
  <div class="um26-home">
    <CineBanner
      variant="home"
      kicker="Más de 22 años de servicios IT · Mendoza, Argentina"
      title="Servicios IT para operaciones que no pueden detenerse."
      lead={heroLead}
      primary={{ href: '/antecedentes', label: 'Ver evidencia operativa' }}
      secondary={{ href: '/sectores', label: 'Entrar por sector' }}
      variants={heroVariants}
      start={heroStart}
    />

    <section class="um26-stats" aria-label="Indicadores ULTIMA MILLA">
      <div class="um26-shell um26-stats__inner">
        <div class="um26-stats__grid">
          {stats.map(({ value, label, href, aria }) => (
            <a href={href} aria-label={aria}>
              <strong>
                {value.endsWith('+') ? (
                  <>{value.slice(0, -1)}<b>+</b></>
                ) : (
                  value
                )}
              </strong>
              <span>{label}</span>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="um26-section" id="servicios-it">
      <div class="um26-shell">
        <div class="um26-section__head" data-reveal>
          <p class="um26-kicker"><span></span>Servicios</p>
          <h2>Ocho frentes de servicio IT.</h2>
        </div>

        <ServicesStory services={services} />

        <a class="um26-text-link" href="/servicios">Ver los ocho servicios</a>
      </div>
    </section>

    <section class="um26-section um26-section--band" id="sectores">
      <div class="um26-shell">
        <div class="um26-section__head" data-reveal>
          <p class="um26-kicker"><span></span>Sectores</p>
          <h2>Infraestructura IT por sector.</h2>
        </div>

        <SectorAtlas sectors={sectors} />
      </div>
    </section>

    <section class="um26-section" id="antecedentes-home">
      <div class="um26-shell">
        <div class="um26-section__head" data-reveal>
          <p class="um26-kicker"><span></span>Proyectos</p>
          <h2>Proyectos que respaldan cada propuesta.</h2>
        </div>

        <ol class="um26-projects" data-reveal>
          {projects.map((item) => (
            <li>
              <a href={item.href}>
                <span class="um26-projects__client">{item.client}</span>
                <span class="um26-projects__title">{item.title}</span>
                <span class="um26-projects__sector">{item.sector}</span>
                <span class="um26-projects__year">{item.year}</span>
              </a>
            </li>
          ))}
        </ol>

        <a class="um26-text-link" href="/antecedentes">Ver los {catalogCount} proyectos</a>
      </div>
    </section>

    <section class="um26-contact">
      <div class="um26-shell">
        <div class="um26-contact__panel" data-reveal>
          <div>
            <p class="um26-kicker"><span></span>Contacto rápido</p>
            <h2>Ordenemos su infraestructura y su continuidad operativa.</h2>
            <p>Respondemos en el día con un relevamiento técnico y una propuesta verificable. Sin compromiso inicial.</p>
          </div>
          <div>
            <a class="um26-btn um26-btn--red" href="/contacto" data-contact-open>Escribinos</a>
            <EmailLink class="um26-contact__mail" subject="Consulta desde la web ULTIMA MILLA" />
            <span>Lunes a viernes, 8 a 18 h</span>
          </div>
        </div>
      </div>
    </section>
  </div>

  <style>
    :global(body[data-skin]) main {
      background: #0a0a0b;
    }

    .um26-home {
      background: #0a0a0b;
      color: #fafafa;
      font-family: var(--um-font-body);
    }

    .um26-shell {
      width: min(var(--um-container-wide), calc(100% - (var(--um-page-gutter) * 2)));
      margin-inline: auto;
    }

    .um26-kicker {
      display: inline-flex;
      align-items: center;
      gap: 14px;
      margin: 0 0 12px;
      color: #dc2626;
      font-family: var(--um-font-mono);
      font-size: 1rem;
      line-height: 1.5;
      font-weight: 700;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }

    .um26-kicker span {
      display: inline-block;
      width: 44px;
      height: 3px;
      background: #dc2626;
    }

    .um26-section h2,
    .um26-contact h2 {
      margin: 0;
      color: #fff;
      font-family: var(--um-font-display) !important;
      font-weight: 600 !important;
      letter-spacing: var(--um-display-tracking) !important;
      line-height: 1.1;
      text-wrap: wrap;
      overflow-wrap: normal !important;
    }

    .um26-btn {
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      min-height: 52px;
      padding: 0 24px;
      color: #fff;
      text-decoration: none;
      font-weight: 700;
      font-size: 1rem;
      line-height: 1.2;
      letter-spacing: 0;
      transition: background-color 0.18s ease, border-color 0.18s ease;
    }

    .um26-btn--red {
      background: #dc2626;
      border: 1px solid #dc2626;
    }

    .um26-btn--red:hover {
      background: #b91c1c;
      border-color: #b91c1c;
    }

    .um26-text-link {
      display: inline-flex;
      margin-top: 34px;
      color: #fff;
      font-weight: 700;
      font-size: 1rem;
      text-decoration: none;
      border-bottom: 2px solid #dc2626;
      padding-bottom: 4px;
    }

    .um26-text-link::after {
      content: "→";
      margin-left: 10px;
      color: currentColor;
    }

    .um26-text-link:focus-visible {
      outline: 3px solid rgba(220, 38, 38, 0.5);
      outline-offset: 4px;
    }

    /* Indicadores: una sola línea de tres números. */
    .um26-stats {
      border-block: 1px solid rgba(255, 255, 255, 0.08);
      background: #0f0f11;
    }

    .um26-stats__grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      background: rgba(255, 255, 255, 0.05);
      gap: 1px;
    }

    .um26-stats__grid a {
      display: flex;
      min-width: 0;
      min-height: 120px;
      flex-direction: column;
      justify-content: center;
      background: #0f0f11;
      padding: 24px 20px;
      color: inherit;
      text-decoration: none;
      transition: background-color 160ms ease, box-shadow 160ms ease;
    }

    .um26-stats__grid a:hover,
    .um26-stats__grid a:focus-visible {
      background: #191113;
      box-shadow: inset 0 -3px 0 #dc2626;
    }

    .um26-stats__grid a:focus-visible {
      outline: 3px solid rgba(220, 38, 38, 0.5);
      outline-offset: -3px;
    }

    .um26-stats strong {
      display: block;
      color: #fff;
      font-family: var(--um-font-display);
      font-size: 2.25rem;
      font-weight: 700;
      letter-spacing: var(--um-display-tracking);
      line-height: 1;
    }

    .um26-stats strong b {
      color: #dc2626;
      font: inherit;
    }

    .um26-stats span {
      display: block;
      margin-top: 10px;
      color: #a1a1aa;
      font-family: var(--um-font-body);
      font-size: 1rem;
      letter-spacing: 0.04em;
      line-height: 1.25;
      text-transform: uppercase;
    }

    .um26-section {
      padding-block: 88px;
      background: #0a0a0b;
    }

    .um26-section--band {
      position: relative;
      background: #0f0f11;
      border-block: 1px solid rgba(255, 255, 255, 0.08);
    }

    .um26-section--band::before {
      content: "";
      position: absolute;
      inset: 0;
      background-image: radial-gradient(rgba(255,255,255,0.055) 1px, transparent 1px);
      background-size: 20px 20px;
      opacity: 0.4;
      pointer-events: none;
    }

    .um26-section--band > * {
      position: relative;
      z-index: 1;
    }

    .um26-section__head {
      min-width: 0;
      max-width: 100%;
      margin-bottom: 40px;
    }

    .um26-section h2 {
      width: min(650px, 100%);
      font-size: clamp(2.25rem, 3.3vw, 2.75rem);
    }

    /* Proyectos: lista sobria, sin imágenes. cliente · título · sector · año. */
    .um26-projects {
      list-style: none;
      margin: 0;
      padding: 0;
      border-top: 1px solid rgba(255, 255, 255, 0.12);
    }

    .um26-projects li {
      border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    }

    .um26-projects a {
      display: grid;
      grid-template-columns: minmax(0, 1.1fr) minmax(0, 2fr) minmax(0, 1fr) 4.5rem;
      align-items: baseline;
      gap: 24px;
      padding: 20px 12px;
      color: #fff;
      text-decoration: none;
      transition: background-color 160ms ease;
    }

    .um26-projects a:hover,
    .um26-projects a:focus-visible {
      background: #121214;
    }

    .um26-projects a:focus-visible {
      outline: 3px solid rgba(220, 38, 38, 0.5);
      outline-offset: -3px;
    }

    .um26-projects span {
      min-width: 0;
      font-size: 1rem;
      line-height: 1.4;
      overflow-wrap: anywhere;
    }

    .um26-projects__client {
      color: #fff;
      font-weight: 700;
    }

    .um26-projects__title {
      color: #d4d4d8;
      transition: color 160ms ease;
    }

    .um26-projects a:hover .um26-projects__title,
    .um26-projects a:focus-visible .um26-projects__title {
      color: #fff;
    }

    .um26-projects__sector {
      color: #a1a1aa;
    }

    .um26-projects__year {
      color: #a1a1aa;
      font-family: var(--um-font-mono);
      text-align: right;
    }

    .um26-contact {
      padding-block: clamp(90px, 10vw, 140px);
    }

    .um26-contact__panel {
      position: relative;
      overflow: hidden;
      display: grid;
      grid-template-columns: 1fr auto;
      align-items: center;
      gap: 72px;
      padding: clamp(42px, 5vw, 72px);
      border: 1px solid rgba(255, 255, 255, 0.1);
      background:
        radial-gradient(circle at 88% 2%, rgba(220, 38, 38, 0.24), transparent 30%),
        linear-gradient(135deg, #0f0f11, #121214);
    }

    .um26-contact h2 {
      max-width: 760px;
      font-size: clamp(2.4rem, 4vw, 4.4rem);
    }

    .um26-contact p:not(.um26-kicker) {
      max-width: 520px;
      margin: 22px 0 0;
      color: #a1a1aa;
      line-height: 1.6;
    }

    .um26-contact__panel > div:last-child {
      display: grid;
      gap: 14px;
      justify-items: stretch;
      min-width: min(100%, 360px);
    }

    .um26-contact__panel :global(.um26-contact__mail) {
      display: inline-flex;
      justify-content: center;
      align-items: center;
      min-height: 52px;
      padding: 0 24px;
      border: 1px solid rgba(255, 255, 255, 0.22);
      color: #fff;
      font-weight: 600;
      font-size: 1rem;
      text-decoration: none;
    }

    .um26-contact__panel :global(.um26-contact__mail:hover) {
      border-color: #fff;
    }

    .um26-contact__panel > div:last-child > span {
      text-align: center;
      color: #a1a1aa;
      font-size: 1rem;
    }

    @media (max-width: 1100px) {
      .um26-contact__panel {
        grid-template-columns: 1fr;
        align-items: start;
      }
    }

    @media (max-width: 760px) {
      .um26-shell {
        width: min(100% - 32px, var(--um-container-wide));
      }

      .um26-section {
        padding-block: 56px;
      }

      .um26-section__head {
        margin-bottom: 24px;
      }

      .um26-section h2,
      .um26-contact h2 {
        font-size: clamp(1.875rem, 8vw, 2.25rem);
        text-wrap: balance;
      }

      .um26-stats__grid {
        grid-template-columns: 1fr;
      }

      .um26-stats__grid a {
        min-height: 0;
        flex-direction: row;
        align-items: baseline;
        gap: 16px;
        padding: 16px;
      }

      .um26-stats span {
        margin-top: 0;
      }

      .um26-projects a {
        grid-template-columns: minmax(0, 1fr) auto;
        gap: 4px 16px;
        padding: 16px 4px;
      }

      .um26-projects__title {
        grid-column: 1 / -1;
        grid-row: 2;
      }

      .um26-projects__sector {
        grid-column: 1;
        grid-row: 3;
      }

      .um26-projects__year {
        grid-column: 2;
        grid-row: 3;
      }

      .um26-text-link {
        min-height: 44px;
        align-items: center;
        margin-top: 16px;
        padding-bottom: 0;
        border-bottom: 0;
        text-decoration: underline;
        text-decoration-color: #dc2626;
        text-decoration-thickness: 2px;
        text-underline-offset: 6px;
      }

      .um26-contact {
        padding-block: 56px;
      }

      .um26-contact__panel {
        padding: 28px 20px;
        gap: 24px;
      }

      .um26-contact p:not(.um26-kicker) {
        margin-top: 16px;
      }
    }
  </style>
</LayoutV4>
