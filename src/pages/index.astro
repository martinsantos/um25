---
import Layout from '../layouts/Layout.astro';
import SEOHead from '../components/SEO/SEOHead.astro';
import ServicesList from '../components/ServicesList.astro';
import FeaturedAntecedentes from '../components/FeaturedAntecedentes.astro';

// SEO metadata optimizado para página principal con enfoque local
const seoData = {
  title: "ULTIMA MILLA | Empresa IT Líder en Mendoza | Servicios Tecnológicos +20 Años",
  description: "ULTIMA MILLA: empresa líder en servicios IT en Mendoza desde 2000. +469 proyectos exitosos con Gobierno de Mendoza, AFIP, empresas vitivinícolas. Infraestructura, redes, seguridad informática y desarrollo web.",
  keywords: "ultima milla mendoza, empresa IT mendoza, servicios tecnológicos mendoza, transformación digital mendoza, comunicaciones mendoza, redes datos mendoza, seguridad informática mendoza, desarrollo web mendoza, argentina"  
};

// Array de imágenes tecnológicas para sección Nosotros
const techImages = [
  'https://images.unsplash.com/photo-1518709268805-4e9042af2176?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Servidores
  'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Código
  'https://images.unsplash.com/photo-1451187580459-43490279c0fa?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Tecnología espacial
  'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Laptop código
  'https://images.unsplash.com/photo-1537432376769-00f83c2f9c52?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Cables red
  'https://images.unsplash.com/photo-1544197150-b99a580bb7a8?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Fibra óptica
  'https://images.unsplash.com/photo-1563206767-5b18f218e8de?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Circuitos
  'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // AI/ML
  'https://images.unsplash.com/photo-1550751827-4bd374c3f58b?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Código terminal
  'https://images.unsplash.com/photo-1555949963-aa79dcee981c?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Programación
  'https://images.unsplash.com/photo-1573164713714-d95e436ab8d6?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Blockchain
  'https://images.unsplash.com/photo-1551288049-bebda4e38f71?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Gráficos datos
  'https://images.unsplash.com/photo-1460925895917-afdab827c52f?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Analytics
  'https://images.unsplash.com/photo-1504639725590-34d0984388bd?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Desarrollo
  'https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Matemáticas
];

// Seleccionar imagen aleatoria para sección Nosotros
const randomAboutImage = techImages[Math.floor(Math.random() * techImages.length)];

// Datos hardcodeados para servicios destacados
const services = {
  data: [
    {
      id: 1,
      Titulo: "Seguridad Informática",
      Descripcion: "Protección integral de sistemas y datos empresariales",
      Imagen: "b1a91d79-c979-4067-b78a-2cd97166fbcd"
    },
    {
      id: 2,
      Titulo: "Redes y comunicaciones",
      Descripcion: "Infraestructura de red avanzada para comunicaciones empresariales",
      Imagen: "6e626d63-c3ca-4982-8ed3-4a5e75e1b179"
    },
    {
      id: 3,
      Titulo: "Software y Servicios",
      Descripcion: "Soluciones de software personalizadas para empresas",
      Imagen: "ccc32af0-df52-4e6e-8ca0-9660dddec095"
    }
  ]
};

// Usar datos reales desde el archivo de antecedentes
import { antecedentesReales } from '../data/antecedentes_completos.js';

// Seleccionar los primeros 3 antecedentes reales como destacados
const antecedentes = {
  data: antecedentesReales.slice(0, 3).map(item => ({
    ...item,
    // Asegurar que tengamos las fechas correctas del archivo real
    Fecha: item.Fecha || "2024-04-15"
  }))
};
---

<Layout>
  <SEOHead 
    title={seoData.title}
    description={seoData.description}
    keywords={seoData.keywords}
    canonical="https://ultimamilla.com.ar"
    ogType="website"
  />
  
  <!-- Hero Section con terminal -->
  <header id="banner" class="relative w-full h-screen overflow-hidden">
    <div class="absolute inset-0 bg-cover bg-center hero-background">
      <div class="absolute inset-0 bg-gradient-to-r from-gray-900/95 via-black/90 to-gray-800/95"></div>
      <div class="absolute inset-0 bg-black/30"></div>
    </div>
    <div class="relative z-10 flex flex-col items-center justify-center h-full text-center text-white px-4">
      <div class="terminal-container max-w-4xl w-full mb-8">
        <div id="terminalOutput" class="terminal-output text-left space-y-1"></div>
      </div>
      <p class="text-xl md:text-2xl mb-8 max-w-3xl mx-auto drop-shadow-md hero-subtitle">
        Explora ULTIMA MILLA a través de nuestro <strong class="text-green-400">terminal interactivo</strong>.<br>
        <span class="text-white font-medium">Una experiencia única que combina nostalgia Linux con datos reales.</span>
      </p>
      <div class="flex flex-wrap justify-center gap-6 mb-8 text-sm md:text-base">
        <div class="bg-white/10 backdrop-blur-sm px-4 py-2 rounded-lg">
          <span class="font-bold text-yellow-400">+30</span> Comandos Interactivos
        </div>
        <div class="bg-white/10 backdrop-blur-sm px-4 py-2 rounded-lg">
          <span class="font-bold text-yellow-400">22</span> Años de Historia
        </div>
        <div class="bg-white/10 backdrop-blur-sm px-4 py-2 rounded-lg">
          <span class="font-bold text-yellow-400">469+</span> Proyectos Reales
        </div>
      </div>
      <a 
        href="#um-cli-section" 
        class="px-8 py-4 bg-green-600 hover:bg-green-700 text-white font-semibold rounded-lg shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-all duration-300"
      >
        Explorar Terminal
      </a>
    </div>
    <div class="absolute bottom-10 left-1/2 transform -translate-x-1/2">
      <div class="animate-bounce w-6 h-10 border-4 border-white/50 rounded-full flex justify-center">
        <div class="w-1 h-2 bg-white rounded-full mt-2"></div>
      </div>
    </div>
  </header>
  
  <!-- Sección del UM CLI -->
  <section id="um-cli-section" class="um-cli-section">
    <div class="container">
      <div class="cli-intro">
        <h2>🖥️ Explora ULTIMA MILLA</h2>
        <p>Descubre nuestros servicios, proyectos y capacidades a través de nuestro terminal interactivo. Una experiencia única que combina la nostalgia de Linux con datos reales de 22 años de historia empresarial.</p>
      </div>
      
      <!-- Container para el CLI -->
      <div id="um-cli-container"></div>
      
      <!-- Accesos directos principales -->
      <div class="cli-quick-access">
        <h3>🚀 Accesos rápidos:</h3>
        <div class="quick-access-grid">
          <a href="/servicios" class="quick-access-btn">
            <span class="icon">💼</span>
            <span class="label">Servicios</span>
          </a>
          <a href="/antecedentes" class="quick-access-btn">
            <span class="icon">🏆</span>
            <span class="label">Antecedentes</span>
          </a>
          <a href="#contacto" class="quick-access-btn">
            <span class="icon">📞</span>
            <span class="label">Contacto</span>
          </a>
        </div>
      </div>
      
      <!-- Comandos sugeridos compactos -->
      <div class="cli-suggestions">
        <h3>💡 Comandos populares:</h3>
        <div class="suggestion-compact">
          <button class="suggestion-compact-btn" data-command="help">
            <code>help</code>
          </button>
          <button class="suggestion-compact-btn" data-command="sudo ultimamilla.py --demo">
            <code>demo</code>
          </button>
          <button class="suggestion-compact-btn" data-command="ls servicios">
            <code>servicios</code>
          </button>
          <button class="suggestion-compact-btn" data-command="grep Mendoza">
            <code>proyectos</code>
          </button>
          <button class="suggestion-compact-btn" data-command="stats --clientes">
            <code>estadísticas</code>
          </button>
          <button class="suggestion-compact-btn" data-command="contacto">
            <code>contacto</code>
          </button>
        </div>
      </div>
    </div>
  </section>
  
  <main class="bg-gray-100">
    
    <!-- Sobre Nosotros -->
    <section id="about-us" class="py-16 bg-gray-50">
      <div class="container mx-auto px-4 grid md:grid-cols-2 gap-8 items-center">
        <div>
          <h2 class="text-4xl font-bold text-gray-800 mb-6">ULTIMA MILLA en Mendoza</h2>
          <p class="text-lg text-gray-700 mb-6">
            Somos la <strong>empresa líder en servicios IT de Mendoza</strong> desde el año 2000. Nuestro equipo apasionado por la tecnología se dedica a impulsar la transformación digital de empresas mendocinas.
          </p>
          <p class="text-lg text-gray-700 mb-8">
            Con presencia local y <strong>+469 proyectos exitosos</strong>, ofrecemos soluciones innovadoras que generan impacto real en el crecimiento de nuestros clientes en Mendoza y la región.
          </p>
          <a href="/nosotros" class="inline-block bg-red-500 hover:bg-red-600 text-white px-6 py-3 rounded-lg font-semibold transition">Saber Más</a>
        </div>
        <div>
          <img 
            src={randomAboutImage} 
            alt="Infraestructura tecnológica ULTIMA MILLA - Especialistas en comunicaciones, sistemas e integración desde los 2000" 
            class="w-full h-auto rounded-lg shadow-lg"
            loading="lazy"
            width="600"
            height="400"
          />
        </div>
      </div>
    </section>

    <!-- Nuestros Servicios -->
    <section id="servicios" class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <span class="text-red-500 font-semibold">Nuestras Soluciones</span>
          <h2 class="text-4xl font-bold text-gray-800 mt-2 mb-4">Servicios IT Profesionales en Mendoza</h2>
          <div class="w-20 h-1 bg-red-500 mx-auto"></div>
        </div>
        
        {services.data && services.data.length > 0 ? (
          <ServicesList services={services.data} />
        ) : (
          <div class="text-center py-12">
            <p class="text-gray-500">No hay servicios disponibles en este momento.</p>
            <ServicesList services={services.data} />
          </div>
        )}
      </div>
    </section>

    <!-- Antecedentes Destacados -->
    <section id="antecedentes" class="py-20 bg-gray-50">
      <div class="container mx-auto px-4">
        <div class="text-center mb-12">
          <span class="text-red-500 font-semibold">Nuestro Trabajo</span>
          <h2 class="text-4xl font-bold text-gray-800 mt-2 mb-4">Casos de Éxito en Mendoza</h2>
          <p class="text-gray-600 max-w-2xl mx-auto">Conoce algunos de nuestros <strong>+469 proyectos exitosos</strong> en Mendoza y cómo hemos ayudado a empresas locales a alcanzar sus objetivos tecnológicos.</p>
          <div class="w-20 h-1 bg-red-500 mx-auto mt-4"></div>
        </div>
        
        {antecedentes.data && antecedentes.data.length > 0 ? (
          <FeaturedAntecedentes antecedentes={antecedentes.data} />
        ) : (
          <div class="text-center py-12">
            <p class="text-gray-500">No hay casos de estudio disponibles en este momento.</p>
          </div>
        )}
        
        <div class="text-center mt-10">
          <a href="/antecedentes" class="inline-block border-2 border-red-500 text-red-500 hover:bg-red-500 hover:text-white px-6 py-3 rounded-lg font-semibold transition">
            Ver todos los antecedentes
          </a>
        </div>
      </div>
    </section>

    <!-- Formulario de Contacto -->
    <section id="contacto" class="py-20 bg-white">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto bg-gray-50 rounded-xl shadow-lg overflow-hidden">
          <div class="md:flex">
            <div class="md:w-1/2 bg-red-500 text-white p-8 md:p-12">
              <h2 class="text-3xl font-bold mb-4">¿Listo para comenzar tu transformación digital?</h2>
              <p class="mb-6">Contáctanos para una <strong>consulta gratuita</strong> en Mendoza y descubre cómo podemos ayudarte a alcanzar tus objetivos tecnológicos.</p>
              <div class="space-y-4">
                <div class="flex items-start">
                  <div class="flex-shrink-0 mt-1">
                    <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                    </svg>
                  </div>
                  <p class="ml-3">contacto@ultimamilla.com</p>
                </div>
                <div class="flex items-start">
                  <div class="flex-shrink-0 mt-1">
                    <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
                    </svg>
                  </div>
                  <p class="ml-3">+54 261 123 4567</p>
                </div>
                <div class="flex items-start">
                  <div class="flex-shrink-0 mt-1">
                    <svg class="h-6 w-6 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                  </div>
                  <p class="ml-3">Av. San Martín 1234, Mendoza, Argentina</p>
                </div>
              </div>
            </div>
            <div class="md:w-1/2 p-8 md:p-12">
              <h3 class="text-2xl font-bold text-gray-800 mb-6">Envíanos un mensaje</h3>
              <form id="footerContactForm" method="post" action="/api/contact" novalidate class="space-y-4" data-form-type="footer">
                <div>
                  <label for="footer_name" class="block text-sm font-medium text-gray-700 mb-1">Nombre *</label>
                  <input type="text" id="footer_name" name="name" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent" placeholder="Tu nombre completo">
                </div>
                <div>
                  <label for="footer_email" class="block text-sm font-medium text-gray-700 mb-1">Email *</label>
                  <input type="email" id="footer_email" name="email" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent" placeholder="tu@email.com">
                </div>
                <div>
                  <label for="footer_message" class="block text-sm font-medium text-gray-700 mb-1">Mensaje *</label>
                  <textarea id="footer_message" name="message" rows="4" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-red-500 focus:border-transparent" placeholder="Describe tu proyecto o consulta..."></textarea>
                </div>
                <input type="text" name="honeypot" class="hidden" tabindex="-1" autocomplete="off" />
                <button type="submit" class="w-full bg-red-500 hover:bg-red-600 text-white font-semibold py-2 px-4 rounded-lg transition duration-200 flex justify-center items-center gap-2" id="footer_submit">
                  <span>Enviar Mensaje</span>
                  <div class="hidden" id="footer_spinner">
                    <svg class="animate-spin h-5 w-5 text-white" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                      <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                      <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                    </svg>
                  </div>
                </button>
                <div id="footer_message_status" class="text-sm mt-2 text-center"></div>
              </form>
            </div>
          </div>
        </div>
      </div>
    </section>
  </main>
  
</Layout>

<style is:global>
  /* Estilos del Hero Section */
  .hero-background {
    transition: background-image 0.5s ease-in-out;
    background-attachment: fixed;
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  #banner {
    background-attachment: fixed;
  }

  .terminal-container {
    min-height: 300px; 
    max-height: 400px;
    padding: 20px;
    background: rgba(0, 0, 0, 0.8);
    border-radius: 8px;
    border: 1px solid rgba(0, 255, 65, 0.3);
    box-shadow: 0 0 20px rgba(0, 255, 65, 0.1);
    backdrop-filter: blur(10px);
  }
  
  .terminal-output {
    font-family: 'Fira Code', 'JetBrains Mono', 'Cascadia Code', 'SF Mono', Monaco, 'Roboto Mono', Consolas, 'Courier New', monospace;
    font-size: 16px;
    line-height: 1.4;
    color: #ffffff;
    overflow-y: auto;
    max-height: 350px;
  }
  
  .terminal-line {
    margin: 4px 0;
    min-height: 22px;
  }
  
  .terminal-prompt {
    color: #00ff41;
    font-weight: 600;
    text-shadow: 0 0 8px rgba(0, 255, 65, 0.6);
  }
  
  .terminal-command {
    color: #ffffff;
    font-weight: 500;
    margin-left: 20px;
  }
  
  .terminal-success {
    color: #00ff41;
    font-weight: 500;
    text-shadow: 0 0 6px rgba(0, 255, 65, 0.4);
  }
  
  .terminal-result {
    color: #00ff41;
    font-weight: 700;
    text-shadow: 0 0 10px rgba(0, 255, 65, 0.8), 0 0 20px rgba(0, 255, 65, 0.4);
    animation: terminal-glow 2s ease-in-out infinite alternate;
  }
  
  @keyframes terminal-glow {
    0% {
      text-shadow: 0 0 10px rgba(0, 255, 65, 0.8), 0 0 20px rgba(0, 255, 65, 0.4);
    }
    100% {
      text-shadow: 0 0 15px rgba(0, 255, 65, 1), 0 0 30px rgba(0, 255, 65, 0.6), 0 0 40px rgba(0, 255, 65, 0.3);
    }
  }

  .hero-subtitle {
    font-family: 'Fira Code', 'JetBrains Mono', 'Cascadia Code', 'SF Mono', Monaco, 'Roboto Mono', Consolas, 'Courier New', monospace;
    color: #cccccc;
    font-weight: 300;
    font-size: inherit;
    line-height: 1.3;
    letter-spacing: 0.02em;
    text-shadow: 0 0 4px rgba(255, 255, 255, 0.1);
  }

  /* UM CLI Section */
  .um-cli-section {
    background: linear-gradient(135deg, #0f1419 0%, #161b22 50%, #21262d 100%);
    padding: 80px 0;
    position: relative;
    overflow: hidden;
  }

  .um-cli-section::before {
    content: '';
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: 
      radial-gradient(circle at 20% 50%, rgba(0, 212, 170, 0.1) 0%, transparent 50%),
      radial-gradient(circle at 80% 50%, rgba(121, 192, 255, 0.1) 0%, transparent 50%);
    pointer-events: none;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 1;
  }

  .cli-intro {
    text-align: center;
    margin-bottom: 40px;
  }

  .cli-intro h2 {
    font-size: 2.5rem;
    color: #00d4aa;
    margin-bottom: 16px;
    font-weight: 700;
    text-shadow: 0 0 20px rgba(0, 212, 170, 0.3);
  }

  .cli-intro p {
    font-size: 1.2rem;
    color: #8b949e;
    max-width: 800px;
    margin: 0 auto;
    line-height: 1.6;
  }

  #um-cli-container {
    margin: 40px 0;
    position: relative;
    z-index: 2;
  }

  /* Accesos directos */
  .cli-quick-access {
    margin: 30px 0 20px 0;
    text-align: center;
  }
  
  .cli-quick-access h3 {
    color: #e6edf3;
    font-size: 1.1rem;
    margin-bottom: 16px;
  }
  
  .quick-access-grid {
    display: flex;
    justify-content: center;
    gap: 20px;
    margin-bottom: 30px;
  }
  
  .quick-access-btn {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 8px;
    background: rgba(0, 212, 170, 0.1);
    border: 2px solid rgba(0, 212, 170, 0.3);
    border-radius: 12px;
    padding: 16px 24px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.3s ease;
    min-width: 100px;
  }
  
  .quick-access-btn:hover {
    background: rgba(0, 212, 170, 0.2);
    border-color: #00d4aa;
    box-shadow: 0 6px 20px rgba(0, 212, 170, 0.3);
    transform: translateY(-3px);
  }
  
  .quick-access-btn .icon {
    font-size: 1.8rem;
    opacity: 0.9;
  }
  
  .quick-access-btn .label {
    color: #e6edf3;
    font-size: 0.9rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  
  .quick-access-btn:hover .label {
    color: #00d4aa;
  }

  /* Comandos sugeridos compactos */
  .cli-suggestions {
    margin-top: 20px;
  }

