---
import Layout from "@/layouts/Layout.astro";

const statusResponse = await fetch(`${Astro.url.origin}/api/status.json`);
const status = await statusResponse.json();
---

<Layout title="System Status - Ultima Milla">
  <div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white">
    <div class="border-b border-slate-700 bg-slate-900/50">
      <div class="max-w-6xl mx-auto px-4 py-8">
        <h1 class="text-3xl font-bold mb-2">System Status</h1>
        <p class="text-slate-400">Last updated: {new Date(status.timestamp).toLocaleString()}</p>
      </div>
    </div>

    <div class="max-w-6xl mx-auto px-4 py-12">
      {status.server && (
        <>
          <div class="grid grid-cols-1 md:grid-cols-3 gap-6 mb-8">
            <div class="bg-slate-800/50 border border-slate-700 rounded-lg p-6">
              <h2 class="text-xl font-semibold mb-4">Memory</h2>
              <div class="text-3xl font-bold mb-2">{status.server.memory.usagePercent}%</div>
              <div class="text-sm text-slate-400">{status.server.memory.used} / {status.server.memory.total}</div>
            </div>

            <div class="bg-slate-800/50 border border-slate-700 rounded-lg p-6">
              <h2 class="text-xl font-semibold mb-4">Status</h2>
              <div class="text-3xl font-bold mb-2">{status.health.toUpperCase()}</div>
              <div class="text-sm text-slate-400">{status.issues.length} issues</div>
            </div>

            <div class="bg-slate-800/50 border border-slate-700 rounded-lg p-6">
              <h2 class="text-xl font-semibold mb-4">Services</h2>
              <div class="space-y-1 text-sm">
                {status.server.services.map(s => (
                  <div>{s.name}: {s.status === "online" ? "✅" : "🔴"}</div>
                ))}
              </div>
            </div>
          </div>

          <div class="bg-slate-800/50 border border-slate-700 rounded-lg p-6 mb-8">
            <h2 class="text-xl font-semibold mb-4">Recent Logs</h2>
            <div class="max-h-96 overflow-y-auto space-y-1 text-xs font-mono">
              {status.recentLogs.map(log => (
                <div class="text-slate-300">[{log.level}] {log.message}</div>
              ))}
            </div>
          </div>
        </>
      )}
    </div>
  </div>
  <script>
    setInterval(() => location.reload(), 30000);
  </script>
</Layout>
