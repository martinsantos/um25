    renderTable(data) {
      if (!Array.isArray(data) || data.length === 0) return '<div class="output-line">Sin datos</div>';

      const headers = Object.keys(data[0]);
      let html = '<div class="output-line"><table class="output-table"><thead><tr>';

      headers.forEach(h => {
        html += `<td><strong>${h}</strong></td>`;
      });

      html += '</tr></thead><tbody>';

      data.forEach(row => {
        html += '<tr>';
        headers.forEach(h => {
          html += `<td>${row[h] || '—'}</td>`;
        });
        html += '</tr>';
      });

      html += '</tbody></table></div>';
      return html;
    }

    showLoading() {
      if (this.loading) {
        this.loading.classList.remove('hidden');
      }
      if (this.progress) {
        this.progress.style.width = '30%';
      }
    }

    hideLoading() {
      if (this.loading) {
        this.loading.classList.add('hidden');
      }
      if (this.progress) {
        this.progress.style.width = '0%';
      }
    }
  }

  // Inicializar cuando el DOM está listo
  function initializeTerminal() {
    // Prevent multiple initializations
    if (window.umTerminalInitialized) {
      return;
    }
    window.umTerminalInitialized = true;

    try {
      const terminal = new UMTerminalV4();
      console.log('[UM-CLI] Terminal initialized successfully');
    } catch (error) {
      console.error('[UM-CLI] Failed to initialize:', error);
      // Show error in a simple alert if DOM is ready
      setTimeout(() => {
        const output = document.getElementById('terminal-output');
        if (output) {
          output.innerHTML = '<div class="output-line output-error">❌ Error iniciando CLI: ' + error.message + '</div>';
        }
      }, 100);
    }
  }

  // Try multiple ways to initialize
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeTerminal);
  } else {
    // DOM already loaded
    initializeTerminal();
  }

  // Also try with a small delay as fallback (in case DOMContentLoaded already fired)
  setTimeout(initializeTerminal, 500);
</script>
