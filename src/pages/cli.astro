        const data = await response.json();

        if (data.success) {
          this.state.data = data.data || {};
          this.updateConnectionStatus(true);
        }
      } catch (err) {
        this.updateConnectionStatus(false);
      }
    }

    checkConnection() {
      setInterval(async () => {
        try {
          const response = await fetch(`${this.apiEndpoint}?action=health`);
          this.updateConnectionStatus(response.ok);
        } catch (err) {
          this.updateConnectionStatus(false);
        }
      }, 10000);
    }

    updateConnectionStatus(online) {
      this.state.directusOnline = online;
      if (online) {
        this.connectionStatus.textContent = '● Online';
        this.connectionStatus.className = 'status-value connected';
        this.directusStatus.textContent = '● Connected';
        this.directusStatus.className = 'status-value connected';
      } else {
        this.connectionStatus.textContent = '● Offline';
        this.connectionStatus.className = 'status-value disconnected';
        this.directusStatus.textContent = '● Disconnected';
        this.directusStatus.className = 'status-value disconnected';
      }
    }

