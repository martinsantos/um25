    async showAntecedentes(args) {
      const limit = parseInt(args[0]) || 10;
      try {
        const response = await fetch(`${this.apiEndpoint}?action=antecedentes&limit=${limit}`);
        const data = await response.json();

        if (data.success && data.data?.data) {
          const projects = data.data.data.slice(0, limit);
          const tableData = projects.map(p => ({
            'ID': p.id,
            'Cliente': p.cliente?.substring(0, 20) || 'N/A',
            'Proyecto': p.titulo?.substring(0, 30) || 'Sin título'
          }));

          return {
            type: 'table',
            data: tableData,
            output: `\n📊 ANTECEDENTES (${data.data.total} totales)\n`
          };
        }
      } catch (err) {
        return { type: 'error', output: `Error al cargar antecedentes: ${err.message}` };
      }

      return { type: 'info', output: 'Sin datos disponibles' };
    }

