    clientes(args) {
      const searchTerm = args.join(' ').toLowerCase();
      let clienteList = this.state.data.clientes;

      if (searchTerm) {
        clienteList = clienteList.filter(c => c.toLowerCase().includes(searchTerm));
      }

      const output = `\n👥 CLIENTES (${clienteList.length}):\n${clienteList.map((c, i) => `  ${i+1}. ${c}`).join('\n')}\n`;
      return { type: 'info', output };
    }

    grep(args) {
      if (args.length === 0) {
        return { type: 'error', output: 'Uso: grep "término"' };
      }

      const searchTerm = args.join(' ').toLowerCase();
      const results = this.state.data.antecedentes.filter(p =>
        p.titulo.toLowerCase().includes(searchTerm) ||
        (p.cliente && p.cliente.toLowerCase().includes(searchTerm)) ||
        (p.area && p.area.toLowerCase().includes(searchTerm))
      );

      if (results.length > 0) {
        const tableData = results.slice(0, 10).map(r => ({
          'ID': r.id,
          'Título': r.titulo.substring(0, 35),
          'Cliente': r.cliente || 'N/A'
        }));

        return { type: 'table', data: tableData, output: `\n🔍 BÚSQUEDA: "${searchTerm}" (${results.length} resultados, mostrando 10)\n` };
      } else {
        return { type: 'warning', output: `No se encontraron resultados para "${searchTerm}"` };
      }
    }

