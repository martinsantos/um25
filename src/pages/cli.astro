          const a = document.createElement('a');
          a.href = url;
          a.download = `ultima-milla-cli-${Date.now()}.json`;
          a.click();
          return { type: 'success', output: `✅ Exportando como JSON...` };
        } else if (format === 'csv') {
          let csv = 'ID,Título,Cliente,Año\n';
          this.state.data.antecedentes.forEach(p => {
            csv += `${p.id},"${p.titulo}","${p.cliente || 'N/A'}",${p.año}\n`;
          });
          const blob = new Blob([csv], { type: 'text/csv' });
          const url = URL.createObjectURL(blob);
          const a = document.createElement('a');
          a.href = url;
          a.download = `ultima-milla-cli-${Date.now()}.csv`;
          a.click();
          return { type: 'success', output: `✅ Exportando como CSV...` };
        }
        return { type: 'error', output: 'Formato no soportado (json, csv)' };
