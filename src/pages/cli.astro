    async grep(args) {
      if (args.length === 0) {
        return { type: 'error', output: 'Uso: grep "término"' };
      }

      const searchTerm = args.join(' ').toLowerCase();

      try {
        const response = await fetch(`${this.apiEndpoint}?action=search&q=${encodeURIComponent(searchTerm)}`);
        const data = await response.json();

        if (data.success && data.data?.count > 0) {
          const results = (data.data.results || []).slice(0, 10).map(r => ({
            'ID': r.id,
            'Título': r.titulo?.substring(0, 40) || 'N/A',
            'Cliente': r.cliente || 'N/A'
          }));

          return { type: 'table', data: results, output: `\n🔍 BÚSQUEDA: "${searchTerm}" (${data.data.count} resultados)\n` };
        } else {
          return { type: 'warning', output: `No se encontraron resultados para "${searchTerm}"` };
        }
      } catch (err) {
        return { type: 'error', output: `Error en búsqueda: ${err.message}` };
      }
    }

