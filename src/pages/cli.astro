  // Initialize when DOM is ready
  function initializeTerminal() {
    if (window.umTerminalV5Initialized) {
      console.log('[UM-CLI v5] Already initialized, skipping');
      return;
    }

    console.log('[UM-CLI v5] Attempting initialization...');

    try {
      const terminalEl = document.getElementById('um-terminal');
      const inputEl = document.getElementById('terminal-input');
      const outputEl = document.getElementById('terminal-output');

      if (!terminalEl || !inputEl || !outputEl) {
        console.error('[UM-CLI v5] Missing required DOM elements:', {
          terminalEl: !!terminalEl,
          inputEl: !!inputEl,
          outputEl: !!outputEl
        });
        return;
      }

      window.umTerminalV5Initialized = true;
      window.umTerminal = new UMTerminalV5();
      console.log('[UM-CLI v5] Terminal instance created successfully');
    } catch (e) {
      console.error('[UM-CLI v5] Initialization failed:', e);
      console.error('[UM-CLI v5] Error stack:', e.stack);
      window.umTerminalV5Initialized = false;
    }
  }

  if (document.readyState === 'loading') {
    console.log('[UM-CLI v5] DOM still loading, waiting for DOMContentLoaded');
    document.addEventListener('DOMContentLoaded', () => {
      console.log('[UM-CLI v5] DOMContentLoaded fired');
      initializeTerminal();
    });
  } else {
    console.log('[UM-CLI v5] DOM already loaded, initializing');
    initializeTerminal();
  }

  // Fallback initialization for safety
  setTimeout(() => {
    if (!window.umTerminalV5Initialized) {
      console.log('[UM-CLI v5] 100ms fallback - attempting initialization');
      initializeTerminal();
    }
  }, 100);

  setTimeout(() => {
    if (!window.umTerminalV5Initialized) {
      console.log('[UM-CLI v5] 500ms fallback - attempting initialization');
      initializeTerminal();
    }
  }, 500);

  setTimeout(() => {
    if (!window.umTerminalV5Initialized) {
      console.log('[UM-CLI v5] 1000ms fallback - attempting initialization');
      initializeTerminal();
    }
  }, 1000);
