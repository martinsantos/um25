    changeTheme(e) {
      const theme = (e.target?.value || e.value || 'default').toLowerCase();
      this.state.currentTheme = theme;
      if (this.terminal) {
        // Remove all theme classes
        this.terminal.classList.remove('default-theme', 'matrix-theme', 'neon-theme', 'retro-theme', 'dracula-theme');
        // Add the new theme class
        this.terminal.classList.add(`${theme}-theme`);
        this.terminal.setAttribute('data-theme', theme);
      }
      if (this.themeSelector) {
        this.themeSelector.value = theme;
      }
      return { type: 'success', output: `🎨 Tema cambiado a: ${theme}` };
    }

    toggleMatrix() {
      this.state.matrixActive = !this.state.matrixActive;
      if (this.matrixCanvas) {
        if (this.state.matrixActive) {
          this.startMatrix();
          return { type: 'success', output: '🟢 Efecto Matrix activado' };
        } else {
          this.stopMatrix();
          return { type: 'info', output: '⬜ Efecto Matrix desactivado' };
        }
      }
      return { type: 'info', output: 'Canvas no disponible' };
    }

    startMatrix() {
      if (!this.matrixCanvas) return;
      this.matrixCanvas.width = window.innerWidth;
      this.matrixCanvas.height = window.innerHeight;
      const ctx = this.matrixCanvas.getContext('2d');
      if (!ctx) return;

      const chars = '01ｦｧｨｩｪｫｬｭｮｯﾀﾁﾂﾃﾄﾅﾆﾇﾈﾉﾊﾋﾌﾍﾎﾏﾐﾑﾒﾓﾔﾕﾗﾘﾜ';
      const fontSize = 16;
      const columns = Math.floor(this.matrixCanvas.width / fontSize);
      const drops = Array(columns).fill(0);

      const draw = () => {
        ctx.fillStyle = 'rgba(10, 14, 39, 0.1)';
        ctx.fillRect(0, 0, this.matrixCanvas.width, this.matrixCanvas.height);
        ctx.fillStyle = '#00ffaa';
        ctx.font = `${fontSize}px monospace`;

        for (let i = 0; i < drops.length; i++) {
          const text = chars[Math.floor(Math.random() * chars.length)];
          ctx.fillText(text, i * fontSize, drops[i] * fontSize);
          drops[i]++;
          if (drops[i] * fontSize > this.matrixCanvas.height && Math.random() > 0.95) {
            drops[i] = 0;
          }
        }

        if (this.state.matrixActive) {
          requestAnimationFrame(draw);
        }
      };

      draw();
    }

    stopMatrix() {
      if (this.matrixCanvas) {
        const ctx = this.matrixCanvas.getContext('2d');
        if (ctx) {
          ctx.clearRect(0, 0, this.matrixCanvas.width, this.matrixCanvas.height);
        }
      }
    }

    showHistory() {
      const history = this.state.commandHistory.slice(0, 20);
      const output = history.length > 0
        ? history.map((cmd, i) => `  ${i+1}. ${cmd}`).join('\n')
        : 'Sin historial aún';
      return { type: 'info', output: `\n📜 HISTORIAL (últimos ${Math.min(20, history.length)}):\n${output}\n` };
    }

    calc(args) {
      try {
