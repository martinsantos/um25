    async exportData(args) {
      const format = args[0] || 'json';
      const tipo = args[1] || 'antecedentes';

      try {
        const response = await fetch(`${this.apiEndpoint}?action=${tipo}&limit=100`);
        const data = await response.json();

        if (data.success) {
          let content, filename, mimeType;

          if (format.toLowerCase() === 'json') {
            content = JSON.stringify(data.data, null, 2);
            filename = `${tipo}.json`;
            mimeType = 'application/json';
          } else if (format.toLowerCase() === 'csv') {
            content = this.convertToCSV(data.data?.data || []);
            filename = `${tipo}.csv`;
            mimeType = 'text/csv';
          } else {
            return { type: 'error', output: 'Formato no soportado. Usa: json o csv' };
          }

          this.downloadFile(content, filename, mimeType);
          return { type: 'success', output: `✅ Datos exportados a ${filename}` };
        }
      } catch (err) {
        return { type: 'error', output: `Error en exportación: ${err.message}` };
      }

      return { type: 'error', output: 'No se pudo exportar los datos' };
    }

    convertToCSV(data) {
      if (!Array.isArray(data) || data.length === 0) return '';

      const headers = Object.keys(data[0]);
      const rows = data.map(row =>
        headers.map(h => `"${(row[h] || '').toString().replace(/"/g, '""')}"`).join(',')
      );

      return [headers.join(','), ...rows].join('\n');
    }

    downloadFile(content, filename, mimeType) {
      const blob = new Blob([content], { type: mimeType });
      const url = URL.createObjectURL(blob);
      const a = document.createElement('a');
      a.href = url;
      a.download = filename;
      document.body.appendChild(a);
      a.click();
      document.body.removeChild(a);
      URL.revokeObjectURL(url);
    }

    changeTheme(e) {
      const theme = e.target.value;
      this.state.currentTheme = theme;
      this.terminal.className = `um-terminal ${theme}-theme`;

      if (theme === 'matrix') {
        this.startMatrix();
      } else {
        this.stopMatrix();
      }
    }

    changeThemeCmd(args) {
      const theme = args[0] || 'default';
      this.themeSelector.value = theme;
      this.changeTheme({ target: { value: theme } });
      return { type: 'success', output: `Tema cambiado a: ${theme}` };
    }

    startMatrix() {
      if (!this.matrixCanvas) return;

      this.matrixCanvas.style.display = 'block';
      const ctx = this.matrixCanvas.getContext('2d');
      this.matrixCanvas.width = this.terminal.offsetWidth;
      this.matrixCanvas.height = this.terminal.offsetHeight;

      const chars = '0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZ';
      const fontSize = 14;
      const columns = Math.floor(this.matrixCanvas.width / fontSize);
      const drops = Array(columns).fill(1);

      const interval = setInterval(() => {
        ctx.fillStyle = 'rgba(0, 0, 0, 0.05)';
        ctx.fillRect(0, 0, this.matrixCanvas.width, this.matrixCanvas.height);

        ctx.fillStyle = '#00ff00';
        ctx.font = `${fontSize}px monospace`;

        for (let i = 0; i < drops.length; i++) {
          const text = chars[Math.floor(Math.random() * chars.length)];
          ctx.fillText(text, i * fontSize, drops[i] * fontSize);

          if (drops[i] * fontSize > this.matrixCanvas.height && Math.random() > 0.975) {
            drops[i] = 0;
          }
          drops[i]++;
        }
      }, 35);

      return { type: 'success', output: '🟢 Efecto Matrix activado' };
    }

    stopMatrix() {
      if (this.matrixCanvas) {
        this.matrixCanvas.style.display = 'none';
      }
    }

    calc(args) {
      if (args.length === 0) {
        return { type: 'error', output: 'Uso: calc 2 + 2' };
      }

      try {
        const result = Function('"use strict"; return (' + args.join(' ') + ')')();
        return { type: 'success', output: `= ${result}` };
      } catch (err) {
        return { type: 'error', output: 'Error en cálculo' };
      }
    }

