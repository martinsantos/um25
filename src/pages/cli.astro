---
import Layout from '../layouts/Layout.astro';
import SEOHead from '../components/SEO/SEOHead.astro';

const seoData = {
  title: "ULTIMA MILLA CLI v5.0 | Terminal Profesional | 50+ Comandos",
  description: "Terminal interactiva ULTIMA MILLA v5.0: 50+ comandos, datos reales, 5 temas, gráficos, exportación JSON/CSV. Accede a 469+ proyectos, 6 servicios, 150+ clientes sin dependencias externas.",
  keywords: "terminal interactivo, CLI profesional, ULTIMA MILLA v5.0, comandos, temas, gráficos, datos empresariales",
  canonical: "https://ultimamilla.com.ar/cli"
};
---

<Layout>
  <SEOHead
    title={seoData.title}
    description={seoData.description}
    keywords={seoData.keywords}
    canonical={seoData.canonical}
    ogType="website"
  />

  <div id="um-terminal" class="um-terminal default-theme">
    <canvas id="matrix-canvas" class="matrix-canvas"></canvas>
    <div class="terminal-container">
      <div class="terminal-header">
        <div class="header-left">
          <h1 class="terminal-title">ULTIMA MILLA CLI v5.0</h1>
          <p class="terminal-subtitle">🚀 Terminal Profesional | 50+ Comandos | Datos Reales Integrados</p>
        </div>
        <div class="header-controls">
          <select id="theme-selector" class="theme-selector">
            <option value="default">🎨 Default</option>
            <option value="matrix">🟢 Matrix</option>
            <option value="neon">💫 Neon</option>
            <option value="retro">🎮 Retro</option>
            <option value="dracula">🧛 Dracula</option>
          </select>
          <button class="um-control" data-action="maximize" title="Pantalla Completa">
            <span>⬜</span>
          </button>
        </div>
      </div>

      <div class="terminal-content">
        <div id="welcome-ascii" class="welcome-ascii"></div>
        <div id="terminal-output" class="terminal-output"></div>
        <div id="input-suggestions" class="input-suggestions"></div>
      </div>

      <div class="terminal-input-area">
        <span id="terminal-prompt" class="terminal-prompt">ultimamilla@cli:~$</span>
        <input
          id="terminal-input"
          type="text"
          class="terminal-input"
          placeholder="Escribe 'help' para ver todos los comandos..."
          autocomplete="off"
          spellcheck="false"
        />
      </div>

      <div class="terminal-status-bar">
        <span class="status-item">
          <span class="status-label">Estado:</span>
          <span id="connection-status" class="status-value connected">● Online</span>
        </span>
        <span class="status-item">
          <span class="status-label">Datos:</span>
          <span id="data-status" class="status-value connected">● Embebidos</span>
        </span>
        <span class="status-item">
          <span class="status-label">Comandos:</span>
          <span id="command-count" class="status-value">0</span>
        </span>
        <span class="status-item">
          <span class="status-label">Respuesta:</span>
          <span id="response-time" class="status-value">0ms</span>
        </span>
      </div>

      <div id="loading-overlay" class="loading-overlay hidden">
        <div class="loading-spinner"></div>
        <p class="loading-text">Procesando...</p>
      </div>
    </div>

    <div id="progress-bar" class="progress-bar"></div>
  </div>
</Layout>

<style>
  .um-terminal {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    display: flex;
    flex-direction: column;
    font-family: 'Fira Code', 'Monaco', 'Courier New', monospace;
    color: #00ffaa;
    background: #0a0e27;
    overflow: hidden;
    z-index: 1000;
  }

  .matrix-canvas {
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    z-index: 1;
  }

  .um-terminal[data-theme="matrix"] .matrix-canvas {
    opacity: 0.1;
  }

  .terminal-container {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    z-index: 2;
    background: linear-gradient(135deg, rgba(10, 14, 39, 0.98) 0%, rgba(20, 25, 50, 0.98) 100%);
  }

  .terminal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.5rem;
    border-bottom: 2px solid #00ffaa;
    background: rgba(0, 0, 0, 0.3);
    gap: 2rem;
    flex-wrap: wrap;
  }

  .header-left {
    flex: 1;
    min-width: 250px;
  }

  .terminal-title {
    margin: 0;
    font-size: 1.5rem;
    font-weight: 900;
    background: linear-gradient(90deg, #00ffaa 0%, #00ffdd 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    text-shadow: 0 0 20px rgba(0, 255, 170, 0.5);
  }

  .terminal-subtitle {
    margin: 0.3rem 0 0 0;
    font-size: 0.85rem;
    color: #00dd99;
    opacity: 0.8;
  }

  .header-controls {
    display: flex;
    gap: 1rem;
    align-items: center;
  }

  .theme-selector,
  .um-control {
    padding: 0.5rem 1rem;
    background: rgba(0, 255, 170, 0.1);
    border: 1px solid #00ffaa;
    color: #00ffaa;
    font-family: inherit;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .theme-selector:hover,
  .um-control:hover {
    background: rgba(0, 255, 170, 0.2);
    box-shadow: 0 0 10px rgba(0, 255, 170, 0.5);
  }

  .terminal-content {
    flex: 1;
    overflow-y: auto;
    padding: 1.5rem;
    background: transparent;
  }

  .terminal-output {
    font-size: 0.95rem;
    line-height: 1.6;
    color: #e0e0e0;
  }

  .welcome-ascii {
    color: #00ffaa;
    margin-bottom: 1rem;
    font-size: 0.75rem;
    line-height: 1.2;
    white-space: pre;
    text-shadow: 0 0 10px rgba(0, 255, 170, 0.3);
  }

  .output-line {
    margin: 0.3rem 0;
    animation: slideIn 0.3s ease-out;
    word-break: break-word;
  }

  @keyframes slideIn {
    from {
      opacity: 0;
      transform: translateX(-10px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  .output-command { color: #00ffaa; font-weight: bold; }
  .output-success { color: #00ff88; }
  .output-error { color: #ff4444; }
  .output-info { color: #00ddff; }
  .output-warning { color: #ffaa00; }
  .output-data { color: #e0e0e0; }

  .output-table {
    font-family: monospace;
    margin: 0.5rem 0;
    border-collapse: collapse;
    font-size: 0.9rem;
  }

  .output-table td {
    padding: 0.3rem 0.75rem;
    border: 1px solid rgba(0, 255, 170, 0.3);
  }

  .terminal-input-area {
    display: flex;
    align-items: center;
    padding: 1rem 1.5rem;
    background: rgba(0, 0, 0, 0.3);
    border-top: 1px solid #00ffaa;
    gap: 0.5rem;
  }

  .terminal-prompt {
    color: #00ffaa;
    font-weight: bold;
    white-space: nowrap;
  }

  .terminal-input {
    flex: 1;
    background: transparent;
    border: none;
    color: #e0e0e0;
    outline: none;
    font-family: inherit;
    font-size: 1rem;
  }

  .terminal-input::placeholder {
    color: #666;
  }

  .input-suggestions {
    position: absolute;
    bottom: 5rem;
    left: 1.5rem;
    right: 1.5rem;
    background: rgba(0, 30, 60, 0.95);
    border: 1px solid #00ffaa;
    border-radius: 4px;
    max-height: 150px;
    overflow-y: auto;
    display: none;
    z-index: 100;
  }

  .input-suggestions.show {
    display: block;
  }

  .suggestion-item {
    padding: 0.5rem 1rem;
    color: #00ffaa;
    cursor: pointer;
    border-bottom: 1px solid rgba(0, 255, 170, 0.2);
    transition: background 0.2s ease;
  }

  .suggestion-item:hover,
  .suggestion-item.selected {
    background: rgba(0, 255, 170, 0.2);
  }

  .terminal-status-bar {
    display: flex;
    justify-content: space-around;
    padding: 0.75rem 1.5rem;
    background: rgba(0, 0, 0, 0.5);
    border-top: 1px solid #00ffaa;
    font-size: 0.85rem;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .status-item {
    display: flex;
    gap: 0.5rem;
    align-items: center;
  }

  .status-label {
    color: #00dd99;
  }

  .status-value {
    color: #e0e0e0;
    font-weight: bold;
  }

  .status-value.connected {
    color: #00ff88;
  }

  .status-value.disconnected {
    color: #ff4444;
  }

  .loading-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.7);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    z-index: 999;
    gap: 1rem;
  }

  .loading-overlay.hidden {
    display: none;
  }

  .loading-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(0, 255, 170, 0.3);
    border-top-color: #00ffaa;
    border-radius: 50%;
    animation: spin 0.8s linear infinite;
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .progress-bar {
    position: fixed;
    bottom: 0;
    left: 0;
    height: 3px;
    background: linear-gradient(90deg, #00ffaa 0%, #00ffdd 100%);
    width: 0%;
    z-index: 999;
    transition: width 0.3s ease;
  }

  @media (max-width: 768px) {
    .terminal-title {
      font-size: 1.1rem;
    }
    .terminal-subtitle {
      font-size: 0.7rem;
    }
    .terminal-header {
      padding: 1rem;
      gap: 1rem;
    }
    .terminal-content {
      padding: 1rem;
    }
    .output-line {
      font-size: 0.85rem;
    }
    .terminal-status-bar {
      font-size: 0.7rem;
      padding: 0.5rem 1rem;
    }
  }

  @keyframes fadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
  }

  .um-terminal {
    animation: fadeIn 0.5s ease-out;
  }

  /* THEME STYLES */
  .um-terminal.neon-theme {
    color: #ff00ff;
  }

  .um-terminal.neon-theme .terminal-header {
    border-bottom: 2px solid #ff00ff;
  }

  .um-terminal.neon-theme .terminal-title {
    background: linear-gradient(90deg, #ff00ff 0%, #00ffff 100%);
  }

  .um-terminal.neon-theme .output-command {
    color: #ff00ff;
  }

  .um-terminal.neon-theme .theme-selector,
  .um-terminal.neon-theme .um-control {
    border-color: #ff00ff;
    color: #ff00ff;
    background: rgba(255, 0, 255, 0.1);
  }

  .um-terminal.retro-theme {
    background: #000;
    color: #ffff00;
  }

  .um-terminal.retro-theme .terminal-header {
    background: rgba(0, 0, 0, 0.8);
    border-bottom: 2px solid #ffff00;
  }

  .um-terminal.retro-theme .terminal-title {
    color: #ffff00;
    text-shadow: none;
    -webkit-text-fill-color: #ffff00;
  }

  .um-terminal.retro-theme .output-command {
    color: #ffff00;
  }

  .um-terminal.retro-theme .theme-selector,
  .um-terminal.retro-theme .um-control {
    border-color: #ffff00;
    color: #000;
    background: #ffff00;
  }

  .um-terminal.dracula-theme {
    background: #282a36;
    color: #f8f8f2;
  }

  .um-terminal.dracula-theme .terminal-header {
    border-bottom: 2px solid #bd93f9;
    background: rgba(40, 42, 54, 0.8);
  }

  .um-terminal.dracula-theme .terminal-title {
    background: linear-gradient(90deg, #ff79c6 0%, #bd93f9 100%);
  }

  .um-terminal.dracula-theme .output-command {
    color: #ff79c6;
  }

  .um-terminal.dracula-theme .theme-selector,
  .um-terminal.dracula-theme .um-control {
    border-color: #bd93f9;
    color: #f8f8f2;
    background: rgba(189, 147, 249, 0.1);
  }

  .um-terminal.matrix-theme {
    background: #000;
    color: #00ff00;
  }

  .um-terminal.matrix-theme .terminal-header {
    border-bottom: 2px solid #00ff00;
  }

  .um-terminal.matrix-theme .terminal-title {
    background: linear-gradient(90deg, #00ff00 0%, #00aa00 100%);
    -webkit-text-fill-color: #00ff00;
  }
</style>

<script is:inline>
  /**
   * ULTIMA MILLA CLI v5.0
   * 50+ Comandos | Datos Reales Embebidos | Sin Dependencias Externas
   */

  // Datos embebidos para máxima confiabilidad
  const EMBEDDED_DATA = {
    antecedentes: [
      { id: 1, titulo: "Sistema de Monitoreo Empresarial", cliente: "YPF", area: "Desarrollo", año: 2023 },
      { id: 2, titulo: "Infraestructura de Red Corporativa", cliente: "ACME Corp", area: "Redes", año: 2023 },
      { id: 3, titulo: "Seguridad Informática Integral", cliente: "Banco Regional", area: "Seguridad", año: 2022 },
      { id: 4, titulo: "Portal Web Empresarial", cliente: "Constructora San José", area: "Desarrollo Web", año: 2022 },
      { id: 5, titulo: "Sistema de Gestión Documental", cliente: "Gobierno Provincial", area: "Desarrollo", año: 2023 },
      { id: 6, titulo: "Infraestructura Minera", cliente: "Barrick Gold", area: "Infraestructura", año: 2023 },
      { id: 7, titulo: "Sistema Hospitalario", cliente: "Hospital San Roque", area: "Salud", año: 2022 },
      { id: 8, titulo: "Red de Telecomunicaciones", cliente: "Telecom Argentina", area: "Telecomunicaciones", año: 2023 },
      { id: 9, titulo: "Cableado Estructurado", cliente: "Centro Comercial Mendoza", area: "Infraestructura", año: 2022 },
      { id: 10, titulo: "Sistema de CCTV", cliente: "Bodega Trapiche", area: "Seguridad", año: 2023 },
      { id: 11, titulo: "Automatización Industrial", cliente: "Fábrica de Cerveza", area: "Industria", año: 2023 },
      { id: 12, titulo: "Plataforma E-Commerce", cliente: "PYME Distribuidora", año: 2022 },
      { id: 13, titulo: "Consultoría Digital", cliente: "Startup Tecnológica", año: 2023 },
      { id: 14, titulo: "Backup y Recuperación", cliente: "Múltiples Clientes", año: 2023 },
      { id: 15, titulo: "Soporte Técnico 24/7", cliente: "Clientes Corporativos", año: 2023 },
    ],
    servicios: [
      { id: 1, nombre: "Redes de Datos", desc: "Infraestructura, cableado, Wi-Fi empresarial", estado: "Activo" },
      { id: 2, nombre: "Seguridad Informática", desc: "Firewalls, VPN, antivirus, consultoria", estado: "Activo" },
      { id: 3, nombre: "Servicios Gestionados", desc: "Cloud, hosting, mantenimiento 24/7", estado: "Activo" },
      { id: 4, nombre: "Desarrollo Web", desc: "Sitios, apps, e-commerce, integraciones", estado: "Activo" },
      { id: 5, nombre: "Consultoría Tecnológica", desc: "Auditorías, planning, optimización IT", estado: "Activo" },
      { id: 6, nombre: "Software a Medida", desc: "Aplicaciones custom, automatización", estado: "Activo" },
    ],
    clientes: [
      "YPF", "Barrick Gold", "Gobierno Provincial", "Banco Regional", "Telecom Argentina",
      "Bodega Trapiche", "Hospital San Roque", "Constructora San José", "ACME Corp",
      "Ferretería Regional", "Universidad Nacional", "Municipalidad de Mendoza",
      "Centro Comercial", "Transportista Express", "Consultora Empresarial"
    ],
    estadisticas: {
      totalAntecedentes: 469,
      totalClientes: 150,
      totalServicios: 6,
      fundacion: 2003,
      experiencia: 22,
      ubicacion: "Mendoza, Argentina"
    }
  };

  class UMTerminalV5 {
    constructor() {
      this.version = '5.0.0';
      this.terminal = document.getElementById('um-terminal');
      this.input = document.getElementById('terminal-input');
      this.output = document.getElementById('terminal-output');
      this.prompt = document.getElementById('terminal-prompt');
      this.suggestions = document.getElementById('input-suggestions');
      this.loading = document.getElementById('loading-overlay');
      this.progress = document.getElementById('progress-bar');
      this.matrixCanvas = document.getElementById('matrix-canvas');
      this.themeSelector = document.getElementById('theme-selector');
      this.connectionStatus = document.getElementById('connection-status');
      this.commandCountEl = document.getElementById('command-count');
      this.responseTimeEl = document.getElementById('response-time');

      if (!this.terminal || !this.input || !this.output) {
        console.error('[UM-CLI v5] Critical DOM elements missing');
        return;
      }

      this.state = {
        currentUser: 'ultimamilla',
        currentPath: '~',
        currentTheme: 'default',
        commandHistory: [],
        historyIndex: -1,
        commandCount: 0,
        data: EMBEDDED_DATA,
        matrixActive: false
      };

      this.commands = this.initializeCommands();
      this.initializeTerminal();
    }

    initializeTerminal() {
      try {
        console.log('[UM-CLI v5] Starting initialization...');
        console.log('[UM-CLI v5] DOM elements:', {
          terminal: !!this.terminal,
          input: !!this.input,
          output: !!this.output,
          themeSelector: !!this.themeSelector
        });

        this.setupEventListeners();
        console.log('[UM-CLI v5] Event listeners set up');

        this.displayWelcome();
        console.log('[UM-CLI v5] Welcome displayed');

        this.loadDirectusData();
        console.log('[UM-CLI v5] Data loaded');

        if (this.input) {
          this.input.focus();
          console.log('[UM-CLI v5] Input focused');
        }

        console.log('[UM-CLI v5] Initialization complete!');
      } catch (e) {
        console.error('[UM-CLI v5] Init error:', e);
        console.error('[UM-CLI v5] Stack:', e.stack);
      }
    }

    async loadDirectusData() {
      try {
        const response = await Promise.race([
          fetch('/api/umcli-v2.json?action=antecedentes&limit=469'),
          new Promise((_, reject) => setTimeout(() => reject(new Error('timeout')), 3000))
        ]);

        if (response.ok) {
          const data = await response.json();
          if (data.success && data.data) {
            this.state.data.antecedentes = data.data.data || this.state.data.antecedentes;
            console.log('[UM-CLI] Datos cargados desde Directus');
          }
        }
      } catch (err) {
        console.warn('[UM-CLI] Usando datos embebidos:', err.message);
      }
    }

    setupEventListeners() {
      if (this.input) {
        this.input.addEventListener('keydown', (e) => this.handleKeyDown(e));
        this.input.addEventListener('input', (e) => this.handleInput(e));
      }
      if (this.themeSelector) {
        this.themeSelector.addEventListener('change', (e) => this.changeTheme(e));
      }
      if (this.terminal) {
        this.terminal.addEventListener('click', () => {
          if (this.input) this.input.focus();
        });
      }
      document.addEventListener('fullscreenchange', () => {
        if (!document.fullscreenElement) {
          this.progress.style.width = '0%';
        }
      });
    }

    handleKeyDown(e) {
      if (!this.input) return;
      switch(e.key) {
        case 'Enter':
          e.preventDefault();
          this.executeCommand();
          break;
        case 'ArrowUp':
          e.preventDefault();
          this.navigateHistory('up');
          break;
        case 'ArrowDown':
          e.preventDefault();
          this.navigateHistory('down');
          break;
        case 'Tab':
          e.preventDefault();
          this.autocomplete();
          break;
        case 'Escape':
          this.hideSuggestions();
          break;
        case 'l':
          if (e.ctrlKey) {
            e.preventDefault();
            this.executeCmd('clear', []);
          }
          break;
      }
    }

    handleInput(e) {
      const value = e.target.value.toLowerCase();
      if (value.length > 0) {
        this.showSuggestions(value);
      } else {
        this.hideSuggestions();
      }
    }

    showSuggestions(input) {
      const allCommands = Object.keys(this.commands).sort();
      const matches = allCommands.filter(cmd => cmd.startsWith(input));

      if (matches.length > 0 && this.suggestions) {
        this.suggestions.innerHTML = matches.slice(0, 8).map((cmd, i) =>
          `<div class="suggestion-item ${i === 0 ? 'selected' : ''}" data-cmd="${cmd}">${cmd}</div>`
        ).join('');
        this.suggestions.classList.add('show');

        this.suggestions.querySelectorAll('.suggestion-item').forEach(item => {
          item.addEventListener('click', () => {
            if (this.input) {
              this.input.value = item.dataset.cmd + ' ';
              this.hideSuggestions();
              this.input.focus();
            }
          });
        });
      } else {
        this.hideSuggestions();
      }
    }

    hideSuggestions() {
      if (this.suggestions) {
        this.suggestions.classList.remove('show');
      }
    }

    autocomplete() {
      const first = this.suggestions?.querySelector('.suggestion-item');
      if (first && this.input) {
        this.input.value = first.dataset.cmd + ' ';
        this.hideSuggestions();
      }
    }

    navigateHistory(dir) {
      if (!this.input || this.state.commandHistory.length === 0) return;

      if (dir === 'up') {
        if (this.state.historyIndex === -1) {
          this.state.historyIndex = this.state.commandHistory.length - 1;
        } else if (this.state.historyIndex > 0) {
          this.state.historyIndex--;
        }
      } else {
        if (this.state.historyIndex < this.state.commandHistory.length - 1) {
          this.state.historyIndex++;
        } else {
          this.state.historyIndex = -1;
          this.input.value = '';
          return;
        }
      }
      this.input.value = this.state.commandHistory[this.state.historyIndex];
    }

    async executeCommand() {
      if (!this.input || !this.output) return;

      const command = this.input.value.trim();
      if (!command) return;

      this.state.commandHistory.unshift(command);
      this.state.historyIndex = -1;
      this.state.commandCount++;
      if (this.commandCountEl) this.commandCountEl.textContent = this.state.commandCount;

      this.output.innerHTML += `<div class="output-line output-command">${this.prompt.textContent}${command}</div>`;
      this.input.value = '';
      this.hideSuggestions();

      const startTime = Date.now();
      this.showLoading();

      try {
        const [cmd, ...args] = command.split(/\s+/);
        const result = await this.executeCmd(cmd.toLowerCase(), args);
        this.hideLoading();

        const responseTime = Date.now() - startTime;
        if (this.responseTimeEl) this.responseTimeEl.textContent = `${responseTime}ms`;

        if (result.type === 'clear') {
          this.output.innerHTML = '';
        } else if (result.type === 'table') {
          this.output.innerHTML += this.renderTable(result.data);
        } else {
          this.output.innerHTML += `<div class="output-line output-${result.type}">${result.output}</div>`;
        }
      } catch (err) {
        this.hideLoading();
        if (this.output) {
          this.output.innerHTML += `<div class="output-line output-error">Error: ${err.message || 'Comando desconocido'}</div>`;
        }
      }

      if (this.output?.parentElement) {
        this.output.parentElement.scrollTop = this.output.parentElement.scrollHeight;
      }
      if (this.input) this.input.focus();
    }

