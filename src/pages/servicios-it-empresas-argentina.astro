---
import AuthorityHubPage from '../components/geo/AuthorityHubPage.astro';
import { getAuthorityHubs } from '../data/geoKnowledge';

const hub = getAuthorityHubs().find((item) => item.slug === 'servicios-it-empresas-argentina');

if (!hub) {
  throw new Error('Missing authority hub servicios-it-empresas-argentina');
}
---

<AuthorityHubPage
  hub={hub}
  eyebrow="Servicios tecnologicos e informaticos en Argentina"
  intro="Capa nacional y regional para empresas medianas que buscan un proveedor tecnologico, empresa de sistemas o soporte informatico con base argentina, experiencia en campo, soporte remoto, coordinacion multisede y documentacion ejecutable."
/>
