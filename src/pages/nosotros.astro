---
import LayoutV4 from '../layouts/LayoutV4.astro';
import { editorialImages, editorialImageDimensions } from '../data/editorialImageSystem';
import { resolveReplicaH1 } from '../utils/replicaProdCopy';
import { getAntecedentesCatalogCount } from '../utils/verifiedProof';

const nosotrosH1 = resolveReplicaH1('/nosotros', 'Una empresa técnica para operaciones que no pueden detenerse');
const projectCount = getAntecedentesCatalogCount();

const metrics = [
  { value: '22+', label: 'años de trayectoria técnica' },
  { value: String(projectCount), label: 'proyectos documentados' },
  { value: '24/7', label: 'soporte operativo con abono' },
];

const principles = [
  ['Ingeniería primero', 'Cada decisión se justifica por disponibilidad, seguridad, mantenibilidad y costo operativo.'],
  ['Ejecución en campo', 'Diseñamos con conocimiento real de obra, salas técnicas, racks, tendidos, energía y operación diaria.'],
  ['Documentación útil', 'Cada entrega se puede operar, auditar, ampliar y sostener en el tiempo.'],
  ['Continuidad como criterio', 'El soporte, el mantenimiento y la trazabilidad forman parte del diseño desde el primer día.']
];

const capabilities = [
  'Redes, fibra, switching, WiFi corporativo y radioenlaces',
  'Seguridad electrónica, CCTV, accesos e intrusión',
  'Telecomunicaciones, voz, datos, video y conectividad distribuida',
  'Software a medida, SGI, APIs, tableros e integraciones',
  'Soporte 24/7, mantenimiento preventivo y respuesta a incidentes',
  'Detección de incendios y eléctricos dedicados para IT'
];

const milestones = [
  ['2003', 'Origen en infraestructura y telecomunicaciones', 'Instalación, tendidos y continuidad para organizaciones con operación presencial.'],
  ['2010', 'Integración de seguridad electrónica y software operativo', 'Un solo criterio para red, monitoreo, accesos y sistemas que sostienen el negocio.'],
  ['2018', 'Soporte 24/7 y archivo de proyectos', 'Respuesta en incidentes y registro verificable por sector y servicio.'],
  ['Hoy', 'Servicios IT integrales en Argentina', 'Mendoza, Cuyo, Patagonia y proyectos nacionales con evidencia en campo.'],
];

const sites = [
  { name: 'Mendoza', role: 'Sede central', detail: 'Houssay 1159, Guaymallén', href: '/servicios-it-empresas-mendoza' },
  { name: 'San Juan', role: 'Cuyo', href: '/servicios-it-empresas-argentina' },
  { name: 'San Luis', role: 'Cuyo', href: '/servicios-it-empresas-argentina' },
  { name: 'Neuquén', role: 'Patagonia', href: '/servicios-it-empresas-argentina' },
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'Nosotros | ULTIMA MILLA',
  url: 'https://www.ultimamilla.com.ar/nosotros',
  significantLink: [
    'https://www.ultimamilla.com.ar/servicios',
    'https://www.ultimamilla.com.ar/antecedentes',
    'https://www.ultimamilla.com.ar/sectores',
    'https://www.ultimamilla.com.ar/contacto',
    'https://www.ultimamilla.com.ar/geo',
  ],
  about: {
    '@type': 'Organization',
    name: 'ULTIMA MILLA',
    url: 'https://www.ultimamilla.com.ar',
    description: 'Empresa argentina de servicios IT integrales, infraestructura tecnológica, telecomunicaciones, seguridad electrónica, software y soporte.'
  },
  hasPart: [
    { '@type': 'WebPage', name: 'Servicios IT integrales', url: 'https://www.ultimamilla.com.ar/servicios' },
    { '@type': 'WebPage', name: 'Antecedentes técnicos', url: 'https://www.ultimamilla.com.ar/antecedentes' },
    { '@type': 'WebPage', name: 'Sectores ULTIMA MILLA', url: 'https://www.ultimamilla.com.ar/sectores' },
  ],
};
---

<LayoutV4
  skin="black"
  title="Una empresa técnica para operaciones que no pueden detenerse | ULTIMA MILLA"
  description="ULTIMA MILLA integra redes, telecomunicaciones, seguridad electrónica, software, soporte y consultoría IT para empresas con operación crítica en Argentina."
  keywords="empresa servicios IT, Ultima Milla, infraestructura tecnologica, telecomunicaciones, seguridad electronica, software, soporte IT Mendoza Argentina"
  image={editorialImages.aboutHero}
  imageWidth={editorialImageDimensions.width}
  imageHeight={editorialImageDimensions.height}
  structuredData={structuredData}
>
  <div class="abx">
    <section class="abx-hero" aria-labelledby="abxTitle">
      <div class="abx-shell">
        <nav class="abx-crumbs" aria-label="Migas de pan">
          <a href="/">Inicio</a><span aria-hidden="true">/</span><span aria-current="page">Nosotros</span>
        </nav>
        <div class="abx-hero__grid">
          <div>
            <p class="abx-kicker">Nosotros</p>
            <h1 id="abxTitle">{nosotrosH1}</h1>
          </div>
          <div class="abx-hero__side">
            <p class="abx-lead">
              ULTIMA MILLA integra infraestructura, comunicaciones, seguridad y software con criterio de
              continuidad operativa. Diseño, instalación y soporte trabajan en un mismo sistema.
            </p>
            <div class="abx-actions">
              <a class="abx-btn" href="/antecedentes">Ver proyectos <span aria-hidden="true">→</span></a>
              <a class="abx-link" href="/servicios">Servicios <span aria-hidden="true">→</span></a>
            </div>
          </div>
        </div>
      </div>

      <figure class="abx-hero__media">
        <img
          src="/images/editorial/umsa-about-engineering.webp"
          alt="Equipo técnico de ULTIMA MILLA saliendo de una sala de racks hacia la cordillera, con valijas de herramientas"
          width="1672"
          height="941"
          loading="eager"
          fetchpriority="high"
          decoding="async"
        />
      </figure>

      <div class="abx-shell">
        <dl class="abx-metrics">
          {metrics.map((m) => (
            <div><dd>{m.value}</dd><dt>{m.label}</dt></div>
          ))}
        </dl>
      </div>
    </section>

    <section class="abx-section" aria-labelledby="abxPosition">
      <div class="abx-shell abx-split">
        <div>
          <p class="abx-kicker">Posicionamiento</p>
          <h2 id="abxPosition">Servicios IT integrales, con responsabilidad sobre el resultado</h2>
        </div>
        <div class="abx-prose">
          <p>
            Un mismo equipo releva, diseña, ejecuta, documenta y sostiene los componentes que deben
            convivir: red, energía, seguridad, software, comunicaciones y soporte.
          </p>
          <p>
            Ese enfoque permite reducir puntos ciegos, ordenar decisiones técnicas y convertir cada
            proyecto en una plataforma operable para el cliente.
          </p>
        </div>
      </div>
    </section>

    <section class="abx-section abx-section--panel" aria-labelledby="abxPrinciples">
      <div class="abx-shell">
        <div class="abx-head">
          <p class="abx-kicker">Criterios</p>
          <h2 id="abxPrinciples">Cómo trabajamos</h2>
        </div>
        <ol class="abx-principles">
          {principles.map(([title, text], index) => (
            <li>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="abx-section" aria-labelledby="abxCapabilities">
      <div class="abx-shell abx-cap">
        <figure class="abx-cap__media">
          <img src={editorialImages.aboutCapabilities} alt="Edificio en obra con estructura, cerramientos y tendidos en ejecución" loading="lazy" decoding="async" width={editorialImageDimensions.width} height={editorialImageDimensions.height} />
        </figure>
        <div>
          <p class="abx-kicker">Capacidad conectada</p>
          <h2 id="abxCapabilities">Una mesa técnica para resolver el sistema completo</h2>
          <ul class="abx-cap__list">
            {capabilities.map((capability) => <li>{capability}</li>)}
          </ul>
        </div>
      </div>
    </section>

    <section class="abx-section abx-section--panel" aria-labelledby="abxTimeline">
      <div class="abx-shell">
        <div class="abx-head">
          <p class="abx-kicker">Trayectoria</p>
          <h2 id="abxTimeline">Hitos que sostienen la operación en campo</h2>
        </div>
        <ol class="abx-timeline">
          {milestones.map(([year, title, text]) => (
            <li>
              <span class="abx-timeline__year">{year}</span>
              <h3>{title}</h3>
              <p>{text}</p>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section class="abx-section" aria-labelledby="abxSites">
      <div class="abx-shell abx-split">
        <div>
          <p class="abx-kicker">Sedes y cobertura</p>
          <h2 id="abxSites">Desde Mendoza para Cuyo, Patagonia y el país</h2>
          <p class="abx-lead abx-lead--sm">Base técnica en Mendoza, con cobertura regional para proyectos, mantenimiento y soporte.</p>
        </div>
        <ul class="abx-sites">
          {sites.map((s) => (
            <li>
              <a href={s.href}>
                <strong>{s.name}</strong>
                <span class="abx-sites__role">{s.role}</span>
                {s.detail && <span class="abx-sites__detail">{s.detail}</span>}
                <span class="abx-sites__arrow" aria-hidden="true">→</span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="abx-close" aria-labelledby="abxClose">
      <div class="abx-shell abx-split">
        <h2 id="abxClose">La trayectoria importa cuando el sitio, el edificio o la planta ya están funcionando.</h2>
        <div class="abx-prose">
          <p>
            Muchos proyectos se definen en condiciones reales: ventanas de intervención cortas, edificios
            ocupados, equipos de terceros, documentación incompleta y urgencia operativa. Ahí la experiencia
            deja cada sistema instalado, documentado y operable desde el primer día.
          </p>
          <div class="abx-actions">
            <a class="abx-btn" href="/antecedentes">Revisar los {projectCount} proyectos <span aria-hidden="true">→</span></a>
            <a class="abx-link" href="/contacto">Hablar con un técnico <span aria-hidden="true">→</span></a>
          </div>
        </div>
      </div>
    </section>
  </div>
</LayoutV4>

<style>
  :global(body[data-skin]) main { background: var(--x-ink); }

  .abx {
    background: var(--x-ink);
    color: var(--x-text);
    font-family: var(--um-font-editorial);
  }

  .abx-shell {
    width: min(var(--um-container-wide, 1400px), calc(100% - 2 * var(--x-gutter)));
    margin-inline: auto;
  }

  /* Kicker: barra roja 28×2 + 13px uppercase */
  .abx-kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 24px;
    font-size: var(--x-fs-kicker);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--x-muted);
  }
  .abx-kicker::before { content: ''; flex: none; width: 28px; height: 2px; background: var(--x-red); }

  .abx h1,
  .abx h2,
  .abx h3 {
    font-family: var(--um-font-editorial);
    color: var(--x-text);
    margin: 0;
    max-width: none;
    text-wrap: balance;
  }
  .abx h2 {
    font-size: var(--x-fs-h2) !important;
    line-height: 1.08 !important;
    font-weight: 600 !important;
    letter-spacing: -.02em !important;
    max-width: 20ch;
  }
  .abx h3 {
    font-size: var(--x-fs-h3) !important;
    line-height: 1.3 !important;
    font-weight: 600 !important;
    letter-spacing: -.005em !important;
  }

  .abx-lead {
    margin: 0;
    max-width: 52ch;
    font-size: var(--x-fs-lead);
    line-height: 1.55;
    color: var(--x-text-2);
  }
  .abx-lead--sm { margin-top: 24px; font-size: 1.0625rem; }

  .abx-prose p {
    margin: 0;
    max-width: 62ch;
    font-size: 1.0625rem;
    line-height: 1.65;
    color: var(--x-text-2);
  }
  .abx-prose p + p { margin-top: 24px; }

  /* Botones: 0 radio, 48px, un solo primario por pantalla */
  .abx-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 16px 32px; margin-top: 32px; }
  .abx-btn {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 48px;
    padding: 0 24px;
    background: var(--x-red);
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0;
    transition: background-color 160ms var(--x-ease);
  }
  .abx-btn:hover { background: var(--x-red-hover); }
  .abx-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    min-height: 48px;
    color: var(--x-text);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
  }
  .abx-link span, .abx-btn span { transition: transform 160ms var(--x-ease); }
  .abx-link:hover span, .abx-btn:hover span { transform: translateX(3px); }
  .abx-btn:focus-visible, .abx-link:focus-visible, .abx-sites a:focus-visible, .abx-crumbs a:focus-visible {
    outline: 2px solid var(--x-text);
    outline-offset: 3px;
  }

  /* Hero */
  .abx-hero { padding-top: clamp(32px, 4vw, 56px); }
  .abx-crumbs {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: clamp(32px, 4vw, 64px);
    font-size: var(--x-fs-meta);
    color: var(--x-muted);
  }
  .abx-crumbs a { display: inline-flex; align-items: center; min-height: 44px; min-width: 44px; color: var(--x-text-2); text-decoration: none; transition: color 160ms var(--x-ease); }
  .abx-crumbs a:hover { color: var(--x-text); }
  .abx-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(0, .65fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: end;
  }
  .abx-hero h1 {
    font-size: var(--x-fs-display) !important;
    line-height: .98 !important;
    font-weight: 600 !important;
    letter-spacing: -.03em !important;
    max-width: 17ch;
  }
  .abx-hero__side { padding-bottom: 8px; }
  .abx-hero__media {
    margin: clamp(48px, 5vw, 80px) 0 0;
    border-top: 1px solid var(--x-line);
    border-bottom: 1px solid var(--x-line);
    background: var(--x-panel);
  }
  .abx-hero__media img {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1672 / 800;
    max-height: 78vh;
    object-fit: cover;
    object-position: 50% 45%;
  }

  .abx-metrics {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    padding: 0;
  }
  .abx-metrics > div {
    display: flex;
    flex-direction: column;
    gap: 8px;
    padding: 32px 24px 0 0;
  }
  .abx-metrics > div + div { padding-left: 24px; border-left: 1px solid var(--x-line); }
  .abx-metrics dd {
    margin: 0;
    font-size: clamp(2.25rem, 3.4vw, 3.25rem);
    line-height: 1;
    font-weight: 600;
    letter-spacing: -.025em;
    font-variant-numeric: tabular-nums;
    color: var(--x-text);
  }
  .abx-metrics dt {
    font-size: var(--x-fs-meta);
    line-height: 1.45;
    color: var(--x-muted);
  }

  /* Secciones */
  .abx-section { padding-block: var(--x-section); }
  .abx-section--panel {
    background: var(--x-panel);
    border-top: 1px solid var(--x-line);
    border-bottom: 1px solid var(--x-line);
  }
  .abx-head { margin-bottom: 48px; }
  .abx-split {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: start;
  }
  .abx-split > .abx-prose { padding-top: 40px; }

  /* Principios */
  .abx-principles {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .abx-principles li {
    padding-top: 24px;
    border-top: 1px solid var(--x-line-strong);
  }
  .abx-principles span {
    display: block;
    margin-bottom: 48px;
    font-size: var(--x-fs-meta);
    font-weight: 600;
    color: var(--x-muted);
    font-variant-numeric: tabular-nums;
  }
  .abx-principles p {
    margin: 12px 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--x-text-2);
  }

  /* Capacidades */
  .abx-cap {
    display: grid;
    grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 96px);
    align-items: center;
  }
  .abx-cap__media {
    margin: 0;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid var(--x-line);
    background: var(--x-panel);
  }
  .abx-cap__media img { width: 100%; height: 100%; object-fit: cover; display: block; filter: saturate(.85) brightness(.9); }
  .abx-cap__list {
    margin: 48px 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--x-line);
  }
  .abx-cap__list li {
    display: flex;
    gap: 16px;
    align-items: baseline;
    padding: 16px 0;
    border-bottom: 1px solid var(--x-line);
    font-size: 1.0625rem;
    line-height: 1.45;
    color: var(--x-text);
  }
  .abx-cap__list li::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    background: var(--x-muted);
    transform: translateY(-2px);
  }

  /* Trayectoria */
  .abx-timeline {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--x-line-strong);
  }
  .abx-timeline li { position: relative; padding-top: 32px; }
  .abx-timeline li::before {
    content: '';
    position: absolute;
    top: -5px;
    left: 0;
    width: 9px;
    height: 9px;
    background: var(--x-panel);
    border: 1px solid var(--x-text-2);
  }
  .abx-timeline li:last-child::before { background: var(--x-red); border-color: var(--x-red); }
  .abx-timeline__year {
    display: block;
    margin-bottom: 16px;
    font-size: clamp(2rem, 2.6vw, 2.5rem);
    line-height: 1;
    font-weight: 600;
    letter-spacing: -.02em;
    font-variant-numeric: tabular-nums;
    color: var(--x-text);
  }
  .abx-timeline p {
    margin: 12px 0 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--x-text-2);
  }

  /* Sedes */
  .abx-sites { margin: 0; padding: 0; list-style: none; border-top: 1px solid var(--x-line); }
  .abx-sites a {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    grid-template-areas: 'name arrow' 'role arrow' 'detail arrow';
    column-gap: 16px;
    row-gap: 4px;
    padding: 24px 0;
    border-bottom: 1px solid var(--x-line);
    color: var(--x-text);
    text-decoration: none;
  }
  .abx-sites strong { grid-area: name; font-size: 1.25rem; line-height: 1.3; font-weight: 600; }
  .abx-sites__role { grid-area: role; font-size: var(--x-fs-meta); line-height: 1.45; color: var(--x-text-2); }
  .abx-sites__detail { grid-area: detail; font-size: var(--x-fs-meta); line-height: 1.45; color: var(--x-muted); }
  .abx-sites__arrow { grid-area: arrow; align-self: center; font-size: 1.25rem; color: var(--x-muted); transition: transform 160ms var(--x-ease), color 160ms var(--x-ease); }
  .abx-sites a:hover .abx-sites__arrow { transform: translateX(4px); color: var(--x-text); }

  /* Cierre */
  .abx-close {
    padding-block: var(--x-section);
    background: var(--x-panel);
    border-top: 1px solid var(--x-line);
  }
  .abx-close h2 { max-width: 18ch; }
  .abx-close .abx-prose { padding-top: 8px; }

  @media (max-width: 1080px) {
    .abx-principles, .abx-timeline { grid-template-columns: repeat(2, minmax(0, 1fr)); row-gap: 48px; }
    .abx-timeline { border-top: 0; }
    .abx-timeline li { border-top: 1px solid var(--x-line-strong); }
  }

  @media (max-width: 900px) {
    .abx-hero__grid, .abx-split, .abx-cap { grid-template-columns: 1fr; }
    .abx-hero__grid { align-items: start; gap: 32px; }
    .abx-split > .abx-prose { padding-top: 0; }
    .abx-cap__media { aspect-ratio: 16 / 10; }
    .abx h2 { max-width: 22ch; }
  }

  @media (max-width: 640px) {
    .abx-crumbs { margin-bottom: 24px; }
    .abx-hero__media { margin-top: 48px; }
    .abx-hero__media img { aspect-ratio: 4 / 3; object-position: 58% 50%; }
    .abx-metrics { grid-template-columns: 1fr; }
    .abx-metrics > div { flex-direction: row; align-items: baseline; gap: 16px; padding: 16px 0; border-bottom: 1px solid var(--x-line); }
    .abx-metrics > div + div { padding-left: 0; border-left: 0; }
    .abx-metrics dd { min-width: 3.4ch; font-size: 2.25rem; }
    .abx-principles, .abx-timeline { grid-template-columns: 1fr; gap: 16px; row-gap: 32px; }
    .abx-principles span { margin-bottom: 16px; }
    .abx-head { margin-bottom: 32px; }
    .abx-cap__list { margin-top: 32px; }
    .abx-actions { gap: 8px 24px; }
    .abx-btn { width: 100%; justify-content: space-between; }
  }

  @media (prefers-reduced-motion: reduce) {
    .abx *, .abx *::before { transition: none !important; }
  }
</style>
