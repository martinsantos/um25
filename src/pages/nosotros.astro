---
import Layout from '../layouts/Layout.astro';
import SEOHead from '../components/SEO/SEOHead.astro';
import Breadcrumbs from '../components/SEO/Breadcrumbs.astro';

// SEO metadata optimizado para página Nosotros con enfoque local
const seoData = {
  title: "Sobre ULTIMA MILLA Mendoza | +20 Años Líderes en Servicios IT | Historia y Equipo",
  description: "Conoce ULTIMA MILLA: empresa líder en servicios IT de Mendoza desde 2000. +469 proyectos exitosos con Gobierno de Mendoza, AFIP, Banco Credicoop. Equipo especializado en infraestructura, redes y desarrollo.",
  keywords: "sobre ultima milla mendoza, historia empresa IT mendoza, equipo tecnológico mendoza, especialistas comunicaciones mendoza, sistemas integración argentina, empresa local tecnología",
  canonical: "https://ultimamilla.com.ar/nosotros"
};

// Breadcrumbs
const breadcrumbs = [
  { name: "Inicio", url: "/" },
  { name: "Nosotros", url: "/nosotros", current: true }
];

// Array de imágenes tecnológicas del hero (mismo que en index.astro)
const techImages = [
  'https://images.unsplash.com/photo-1518709268805-4e9042af2176?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Servidores
  'https://images.unsplash.com/photo-1558494949-ef010cbdcc31?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Código
  'https://images.unsplash.com/photo-1451187580459-43490279c0fa?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Tecnología espacial
  'https://images.unsplash.com/photo-1504384308090-c894fdcc538d?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Laptop código
  'https://images.unsplash.com/photo-1537432376769-00f83c2f9c52?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Cables red
  'https://images.unsplash.com/photo-1544197150-b99a580bb7a8?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Fibra óptica
  'https://images.unsplash.com/photo-1563206767-5b18f218e8de?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Circuitos
  'https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // AI/ML
  'https://images.unsplash.com/photo-1550751827-4bd374c3f58b?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Código terminal
  'https://images.unsplash.com/photo-1555949963-aa79dcee981c?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Programación
  'https://images.unsplash.com/photo-1573164713714-d95e436ab8d6?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Blockchain
  'https://images.unsplash.com/photo-1551288049-bebda4e38f71?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Gráficos datos
  'https://images.unsplash.com/photo-1460925895917-afdab827c52f?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Analytics
  'https://images.unsplash.com/photo-1504639725590-34d0984388bd?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Desarrollo
  'https://images.unsplash.com/photo-1526374965328-7f61d4dc18c5?ixlib=rb-4.0.3&auto=format&fit=crop&w=2000&q=80', // Matemáticas
];

// Seleccionar imagen aleatoria
const randomImage = techImages[Math.floor(Math.random() * techImages.length)];
---

<Layout>
  <SEOHead 
    title={seoData.title}
    description={seoData.description}
    keywords={seoData.keywords}
    canonical={seoData.canonical}
    ogType="website"
    breadcrumbs={breadcrumbs}
  />

  <div class="bg-white pt-16 py-12">
    <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="text-center mb-12">
        <h1 class="text-5xl font-black text-gray-900 mb-6">ULTIMA MILLA en <span class="text-blue-600">Mendoza</span></h1>
        <p class="text-xl text-gray-600 max-w-3xl mx-auto">
          La empresa líder en servicios IT de Mendoza desde el año 2000
        </p>
      </div>
			<!-- Estadísticas y Historia -->
			<div class="grid md:grid-cols-2 gap-12 mb-16">
				<div>
					<img id="heroImage" src={randomImage} alt="Infraestructura tecnológica ULTIMA MILLA - Empresa IT líder en Mendoza desde 2000" class="w-full h-80 object-cover rounded-xl shadow-lg mb-6">
				</div>
				<div class="flex flex-col justify-center">
					<h2 class="text-3xl font-black text-gray-900 mb-6">Nuestra Historia en Mendoza</h2>
					<p class="text-lg text-gray-700 mb-6 leading-relaxed">
						<strong>ULTIMA MILLA</strong> nació en Mendoza como un equipo de especialistas en comunicaciones, sistemas e integración. Desde el año <strong>2000</strong>, transformamos necesidades operativas en soluciones tecnológicas concretas para empresas mendocinas.
					</p>
					<div class="grid grid-cols-2 gap-6 mb-6">
						<div class="text-center p-4 bg-blue-50 rounded-lg">
							<div class="text-3xl font-black text-blue-600 mb-2">+469</div>
							<div class="text-sm font-semibold text-gray-600">Proyectos Exitosos</div>
						</div>
						<div class="text-center p-4 bg-green-50 rounded-lg">
							<div class="text-3xl font-black text-green-600 mb-2">+20</div>
							<div class="text-sm font-semibold text-gray-600">Años en Mendoza</div>
						</div>
					</div>
				</div>
			</div>

			<!-- Sectores Atendidos -->
			<div class="mb-16">
				<h2 class="text-3xl font-black text-gray-900 mb-8 text-center">Sectores que Atendemos en Mendoza</h2>
				<div class="grid md:grid-cols-3 gap-6">
					<div class="bg-white p-6 rounded-xl shadow-lg text-center">
						<div class="w-12 h-12 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-4">
							<svg class="w-6 h-6 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
								<path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
								<path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold text-gray-900 mb-3">Gobierno</h3>
						<p class="text-gray-600">Provincial y nacional, estadios, eventos deportivos</p>
					</div>
					<div class="bg-white p-6 rounded-xl shadow-lg text-center">
						<div class="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-4">
							<svg class="w-6 h-6 text-purple-600" fill="currentColor" viewBox="0 0 20 20">
								<path d="M13 6a3 3 0 11-6 0 3 3 0 016 0zM18 8a2 2 0 11-4 0 2 2 0 014 0zM14 15a4 4 0 00-8 0v3h8v-3z"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold text-gray-900 mb-3">Sector Privado</h3>
						<p class="text-gray-600">Bancos, empresas vitivinícolas, medios de comunicación</p>
					</div>
					<div class="bg-white p-6 rounded-xl shadow-lg text-center">
						<div class="w-12 h-12 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-4">
							<svg class="w-6 h-6 text-green-600" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M4 4a2 2 0 012-2h8a2 2 0 012 2v12a1 1 0 110 2h-3a1 1 0 01-1-1v-2a1 1 0 00-1-1H9a1 1 0 00-1 1v2a1 1 0 01-1 1H4a1 1 0 110-2V4zm3 1h2v2H7V5zm2 4H7v2h2V9zm2-4h2v2h-2V5zm2 4h-2v2h2V9z" clip-rule="evenodd"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold text-gray-900 mb-3">Salud & Educación</h3>
						<p class="text-gray-600">Hospitales, universidades, centros educativos</p>
					</div>
				</div>
			</div>

			<!-- Servicios que Ofrecemos -->
			<div class="mb-16">
				<h2 class="text-3xl font-black text-gray-900 mb-8 text-center">Nuestros Servicios IT en Mendoza</h2>
				<div class="grid md:grid-cols-2 gap-8">
					<div class="bg-blue-50 p-6 rounded-xl">
						<h3 class="text-xl font-bold text-blue-800 mb-4">Infraestructura & Redes</h3>
						<ul class="space-y-3">
							<li class="flex items-start">
								<svg class="w-5 h-5 text-blue-600 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
									<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
								</svg>
								<span class="text-gray-700">Cableado estructurado y fibra óptica</span>
							</li>
							<li class="flex items-start">
								<svg class="w-5 h-5 text-blue-600 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
									<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
								</svg>
								<span class="text-gray-700">Radioenlaces y telecomunicaciones</span>
							</li>
							<li class="flex items-start">
								<svg class="w-5 h-5 text-blue-600 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
									<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
								</svg>
								<span class="text-gray-700">Centros de datos y servidores</span>
							</li>
						</ul>
					</div>
					<div class="bg-green-50 p-6 rounded-xl">
						<h3 class="text-xl font-bold text-green-800 mb-4">Desarrollo & Seguridad</h3>
						<ul class="space-y-3">
							<li class="flex items-start">
								<svg class="w-5 h-5 text-green-600 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
									<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
								</svg>
								<span class="text-gray-700">Software a medida e integraciones API</span>
							</li>
							<li class="flex items-start">
								<svg class="w-5 h-5 text-green-600 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
									<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
								</svg>
								<span class="text-gray-700">Seguridad física y digital</span>
							</li>
							<li class="flex items-start">
								<svg class="w-5 h-5 text-green-600 mr-3 mt-0.5 flex-shrink-0" fill="currentColor" viewBox="0 0 20 20">
									<path fill-rule="evenodd" d="M16.707 5.293a1 1 0 010 1.414l-8 8a1 1 0 01-1.414 0l-4-4a1 1 0 011.414-1.414L8 12.586l7.293-7.293a1 1 0 011.414 0z" clip-rule="evenodd"/>
								</svg>
								<span class="text-gray-700">Modernización cloud e infraestructura</span>
							</li>
						</ul>
					</div>
				</div>
			</div>

			<!-- Antecedentes Verificables -->
			<div class="mb-16">
				<h2 class="text-3xl font-black text-gray-900 mb-8 text-center">Antecedentes Verificables en Mendoza</h2>
				<div class="bg-gray-50 p-8 rounded-xl">
					<p class="text-lg text-gray-700 leading-relaxed text-center mb-8">
						Nuestro portfolio incluye <strong>+469 proyectos documentados</strong> con clientes de prestigio en Mendoza y Argentina.
					</p>
					<div class="grid md:grid-cols-3 gap-6">
						<div class="bg-white p-6 rounded-lg shadow text-center">
							<div class="text-2xl font-black text-blue-600 mb-2">Gobierno</div>
							<p class="text-sm text-gray-600">Gobierno de Mendoza, AFIP, Estadio Malvinas Argentinas</p>
						</div>
						<div class="bg-white p-6 rounded-lg shadow text-center">
							<div class="text-2xl font-black text-green-600 mb-2">Empresas</div>
							<p class="text-sm text-gray-600">Banco Credicoop, CNN, Aeropuertos Argentina 2000</p>
						</div>
						<div class="bg-white p-6 rounded-lg shadow text-center">
							<div class="text-2xl font-black text-purple-600 mb-2">Eventos</div>
							<p class="text-sm text-gray-600">Copa América, infraestructura deportiva, grandes obras</p>
						</div>
					</div>
					<div class="text-center mt-8">
						<a href="/antecedentes" class="bg-blue-600 text-white px-8 py-3 rounded-lg font-semibold hover:bg-blue-700 transition-colors inline-block">
							Ver Todos los Proyectos
						</a>
					</div>
				</div>
			</div>

			<!-- Diferencial Competitivo -->
			<div class="mb-16">
				<h2 class="text-3xl font-black text-gray-900 mb-12 text-center">¿Por qué elegirnos en Mendoza?</h2>
				<div class="grid md:grid-cols-3 gap-8">
					<div class="text-center p-6">
						<div class="w-16 h-16 bg-blue-100 rounded-full flex items-center justify-center mx-auto mb-6">
							<svg class="w-8 h-8 text-blue-600" fill="currentColor" viewBox="0 0 20 20">
								<path d="M10 12a2 2 0 100-4 2 2 0 000 4z"/>
								<path fill-rule="evenodd" d="M.458 10C1.732 5.943 5.522 3 10 3s8.268 2.943 9.542 7c-1.274 4.057-5.064 7-9.542 7S1.732 14.057.458 10zM14 10a4 4 0 11-8 0 4 4 0 018 0z" clip-rule="evenodd"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold text-gray-900 mb-4">ADN Mendocino</h3>
						<p class="text-gray-600 leading-relaxed">
							Presencia local con capacidad nacional. Conocemos las necesidades específicas de las empresas mendocinas y la normativa provincial.
						</p>
					</div>
					<div class="text-center p-6">
						<div class="w-16 h-16 bg-green-100 rounded-full flex items-center justify-center mx-auto mb-6">
							<svg class="w-8 h-8 text-green-600" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M11.3 1.046A1 1 0 0112 2v5h4a1 1 0 01.82 1.573l-7 10A1 1 0 018 18v-5H4a1 1 0 01-.82-1.573l7-10a1 1 0 011.12-.38z" clip-rule="evenodd"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold text-gray-900 mb-4">Tecnología Abierta</h3>
						<p class="text-gray-600 leading-relaxed">
							Soluciones independientes sin dependencia de licencias extranjeras. Libertad tecnológica que reduce costos y aumenta flexibilidad.
						</p>
					</div>
					<div class="text-center p-6">
						<div class="w-16 h-16 bg-purple-100 rounded-full flex items-center justify-center mx-auto mb-6">
							<svg class="w-8 h-8 text-purple-600" fill="currentColor" viewBox="0 0 20 20">
								<path fill-rule="evenodd" d="M6.267 3.455a3.066 3.066 0 001.745-.723 3.066 3.066 0 013.976 0 3.066 3.066 0 001.745.723 3.066 3.066 0 012.812 2.812c.051.643.304 1.254.723 1.745a3.066 3.066 0 010 3.976 3.066 3.066 0 00-.723 1.745 3.066 3.066 0 01-2.812 2.812 3.066 3.066 0 00-1.745.723 3.066 3.066 0 01-3.976 0 3.066 3.066 0 00-1.745-.723 3.066 3.066 0 01-2.812-2.812 3.066 3.066 0 00-.723-1.745 3.066 3.066 0 010-3.976 3.066 3.066 0 00.723-1.745 3.066 3.066 0 012.812-2.812zm7.44 5.252a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
							</svg>
						</div>
						<h3 class="text-xl font-bold text-gray-900 mb-4">Transparencia Total</h3>
						<p class="text-gray-600 leading-relaxed">
							Documentación pública de proyectos con presupuestos y resultados. Trazabilidad completa para evaluar impacto y ROI.
						</p>
					</div>
				</div>
			</div>

			<!-- Call to Action -->
			<div class="text-center">
				<h2 class="text-3xl font-black text-gray-900 mb-6">¿Listo para transformar tu empresa en Mendoza?</h2>
				<p class="text-lg text-gray-600 mb-8 max-w-2xl mx-auto">
					Con +20 años de experiencia y +469 proyectos exitosos, somos tu socio tecnológico de confianza en Mendoza.
				</p>
				<div class="flex flex-col sm:flex-row gap-4 justify-center">
					<a href="/contacto" class="bg-blue-600 text-white px-8 py-4 rounded-lg font-bold text-lg hover:bg-blue-700 transition-colors">
						Consulta Gratuita
					</a>
					<a href="/antecedentes" class="border-2 border-blue-600 text-blue-600 px-8 py-4 rounded-lg font-bold text-lg hover:bg-blue-50 transition-colors">
						Ver Nuestros Proyectos
					</a>
				</div>
			</div>
			</div>
		</div>
	</div>
</Layout>
