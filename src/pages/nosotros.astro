---
/**
 * Nosotros (About Us) - V4 Design System
 * Corporate page with company history, process workflow, and contact form
 */

import LayoutV4 from '../layouts/LayoutV4.astro';
import HeroPageV4 from '../components/v4/HeroPageV4.astro';
import CTASection from '../components/v4/CTASection.astro';
---

<LayoutV4
  title="Sobre Nosotros - ULTIMA MILLA"
  description="Conozca a ULTIMA MILLA: Líderes en servicios IT, infraestructura y telecomunicaciones en Mendoza y Argentina. +20 años de experiencia y +469 proyectos exitosos."
  keywords="sobre nosotros ultima milla, empresa it mendoza, historia ultima milla, equipo tecnologia argentina, vision mision valores"
>
  <HeroPageV4
    title="Infraestructura y Tecnología"
    titleHighlight="que Impulsa"
    subtitle="Más de dos décadas transformando empresas en Mendoza y Argentina con soluciones IT robustas, escalables y seguras."
    breadcrumb={[
      { label: 'Inicio', href: '/' },
      { label: 'Nosotros', href: '/nosotros' },
    ]}
    badge={{ icon: 'users', text: 'Sobre Nosotros' }}
    backgroundImage="https://images.unsplash.com/photo-1522071820081-009f0129c71c?w=1920&q=80"
    stats={[
      { value: '+469', label: 'Proyectos Exitosos' },
      { value: '+20', label: 'Años de Trayectoria' },
      { value: '24/7', label: 'Soporte Crítico' },
    ]}
  />

	<div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 section-padding">

		<!-- Imagen Principal -->
		<div class="mb-16 sm:mb-20 reveal">
			<img src="/nosotros-tech.jpg" alt="Infraestructura tecnológica ULTIMA MILLA" class="w-full h-[400px] sm:h-[500px] object-cover rounded-2xl">
		</div>

		<!-- Proceso de Desarrollo -->
		<div class="mb-16 sm:mb-20">
			<div class="text-center mb-10 sm:mb-14 reveal">
				<div class="flex justify-center mb-4"><div class="section-accent"></div></div>
				<h2 class="text-fluid-title text-um-dark mb-3">
					Nuestro enfoque <span class="text-um-primary">profesional</span>
				</h2>
				<p class="text-um-text-tertiary max-w-2xl mx-auto">
					Metodología probada para garantizar resultados excepcionales en cada proyecto de infraestructura y software.
				</p>
			</div>

			<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 reveal-stagger">
				<div class="reveal bg-white p-6 rounded-2xl border border-um-border hover:border-um-primary/20 hover:shadow-elevated transition-all duration-300">
					<div class="w-10 h-10 bg-um-elevated rounded-full flex items-center justify-center mb-4">
						<span class="text-um-dark font-bold text-sm" style="font-family:'JetBrains Mono',monospace;">1</span>
					</div>
					<h3 class="text-lg font-semibold text-um-dark mb-2">Consultoría</h3>
					<p class="text-sm text-um-text-tertiary leading-relaxed">Análisis profundo de necesidades y objetivos operativos.</p>
				</div>

				<div class="reveal bg-white p-6 rounded-2xl border border-um-border hover:border-um-primary/20 hover:shadow-elevated transition-all duration-300">
					<div class="w-10 h-10 bg-um-elevated rounded-full flex items-center justify-center mb-4">
						<span class="text-um-dark font-bold text-sm" style="font-family:'JetBrains Mono',monospace;">2</span>
					</div>
					<h3 class="text-lg font-semibold text-um-dark mb-2">Diseño</h3>
					<p class="text-sm text-um-text-tertiary leading-relaxed">Arquitectura de soluciones a medida, escalables y eficientes.</p>
				</div>

				<div class="reveal bg-white p-6 rounded-2xl border border-um-border hover:border-um-primary/20 hover:shadow-elevated transition-all duration-300">
					<div class="w-10 h-10 bg-um-elevated rounded-full flex items-center justify-center mb-4">
						<span class="text-um-dark font-bold text-sm" style="font-family:'JetBrains Mono',monospace;">3</span>
					</div>
					<h3 class="text-lg font-semibold text-um-dark mb-2">Implementación</h3>
					<p class="text-sm text-um-text-tertiary leading-relaxed">Despliegue técnico con estándares de calidad internacionales.</p>
				</div>

				<div class="reveal bg-white p-6 rounded-2xl border border-um-border hover:border-um-primary/20 hover:shadow-elevated transition-all duration-300">
					<div class="w-10 h-10 bg-um-elevated rounded-full flex items-center justify-center mb-4">
						<span class="text-um-dark font-bold text-sm" style="font-family:'JetBrains Mono',monospace;">4</span>
					</div>
					<h3 class="text-lg font-semibold text-um-dark mb-2">Soporte</h3>
					<p class="text-sm text-um-text-tertiary leading-relaxed">Mantenimiento proactivo y garantía de continuidad operativa.</p>
				</div>
			</div>
		</div>

		<!-- Contenido Corporativo -->
		<div class="max-w-4xl mx-auto mb-16 sm:mb-20 reveal">
			<div class="text-center mb-10">
				<div class="flex justify-center mb-4"><div class="section-accent"></div></div>
				<h2 class="text-fluid-title text-um-dark">Nuestra Historia y Visión</h2>
			</div>
			<p class="text-um-text-secondary leading-relaxed mb-8">
				<strong class="text-um-dark">ULTIMA MILLA</strong> nació como un equipo de especialistas en comunicaciones, sistemas e integración para transformar necesidades operativas en soluciones tecnológicas concretas. Nuestra trayectoria incluye proyectos desde inicios de los 2000 hasta la actualidad, con presencia en sectores: gobierno provincial y nacional, salud, educación, agronegocios y obra civil, además de clientes privados como bancos y medios.
			</p>

			<div class="grid md:grid-cols-2 gap-10 mt-12">
				<div>
					<h3 class="text-xl font-semibold text-um-dark mb-4">Qué Ofrecemos</h3>
					<ul class="space-y-3 text-sm">
						<li class="flex items-start gap-3"><span class="w-1.5 h-1.5 rounded-full bg-um-primary mt-2 shrink-0"></span><span class="text-um-text-secondary">Ingeniería y operación de redes y telecomunicaciones.</span></li>
						<li class="flex items-start gap-3"><span class="w-1.5 h-1.5 rounded-full bg-um-primary mt-2 shrink-0"></span><span class="text-um-text-secondary">Desarrollo de software a medida e integraciones API.</span></li>
						<li class="flex items-start gap-3"><span class="w-1.5 h-1.5 rounded-full bg-um-primary mt-2 shrink-0"></span><span class="text-um-text-secondary">Seguridad física y digital, gestión de incidentes.</span></li>
						<li class="flex items-start gap-3"><span class="w-1.5 h-1.5 rounded-full bg-um-primary mt-2 shrink-0"></span><span class="text-um-text-secondary">Servicios gestionados y soporte operativo.</span></li>
						<li class="flex items-start gap-3"><span class="w-1.5 h-1.5 rounded-full bg-um-primary mt-2 shrink-0"></span><span class="text-um-text-secondary">Migraciones y optimización de infraestructura.</span></li>
					</ul>
				</div>
				<div>
					<h3 class="text-xl font-semibold text-um-dark mb-4">Diferencial Competitivo</h3>
					<ul class="space-y-4 text-sm">
						<li>
							<strong class="text-um-dark">ADN regional:</strong> <span class="text-um-text-secondary">Operación desde Mendoza con capacidad nacional.</span>
						</li>
						<li>
							<strong class="text-um-dark">Tecnología abierta:</strong> <span class="text-um-text-secondary">Sin dependencia de licencias restrictivas.</span>
						</li>
						<li>
							<strong class="text-um-dark">Transparencia:</strong> <span class="text-um-text-secondary">Documentación pública y trazabilidad total.</span>
						</li>
					</ul>
				</div>
			</div>
		</div>
	</div>

	<!-- 5. CTA SECTION -->
	<CTASection
		variant="dark"
		badge="¿Necesita un socio tecnológico?"
		badgeIcon="rocket"
		titulo="Construyamos el Futuro de su Infraestructura Juntos"
		descripcion="Con más de 20 años de experiencia y 469 proyectos exitosos, estamos listos para transformar sus desafíos tecnológicos en oportunidades de crecimiento."
		primaryButtonText="Solicitar Consultoría Gratuita"
		primaryButtonUrl="/contacto"
		secondaryButtonText="Ver Casos de Éxito"
		secondaryButtonUrl="/antecedentes"
		secondaryButtonIcon="arrow-right"
	/>

	<!-- 6. FORMULARIO COMPLEJO INTEGRADO -->
	<div class="bg-gray-50 py-16 border-t border-gray-200">
		<div class="max-w-7xl mx-auto px-4">
			<div class="text-center mb-12">
				<h2 class="text-3xl font-bold text-gray-900 mb-4">Solicitar Presupuesto / Contacto</h2>
				<p class="text-xl text-gray-500 max-w-3xl mx-auto">
					Cuéntanos sobre tu proyecto. Te responderemos con una propuesta detallada.
				</p>
			</div>

			<div class="grid grid-cols-1 lg:grid-cols-2 gap-8" id="contact-layout">
				<!-- Formulario -->
				<div class="relative">
					<div class="bg-white p-8 rounded-2xl shadow-elevated border border-gray-100 h-full">
						<h2 class="text-2xl font-bold text-gray-900 mb-6">Detalles del Proyecto</h2>

						<form id="contactForm" class="space-y-6">
							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								<div>
									<label for="name" class="block text-sm font-semibold text-gray-700 mb-2">Nombre *</label>
									<input type="text" id="name" name="name" required placeholder="Tu nombre completo" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:border-gray-900 focus:ring-2 focus:ring-gray-900/10 transition-all" />
									<span class="text-red-500 text-sm hidden" id="nameError"></span>
								</div>
								<div>
									<label for="company" class="block text-sm font-semibold text-gray-700 mb-2">Empresa</label>
									<input type="text" id="company" name="company" placeholder="Nombre de tu empresa" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:border-gray-900 focus:ring-2 focus:ring-gray-900/10 transition-all" />
								</div>
							</div>

							<div class="grid grid-cols-1 md:grid-cols-2 gap-4">
								<div>
									<label for="email" class="block text-sm font-semibold text-gray-700 mb-2">Email *</label>
									<input type="email" id="email" name="email" required placeholder="tu@email.com" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:border-gray-900 focus:ring-2 focus:ring-gray-900/10 transition-all" />
									<span class="text-red-500 text-sm hidden" id="emailError"></span>
								</div>
								<div>
									<label for="phone" class="block text-sm font-semibold text-gray-700 mb-2">Teléfono</label>
									<input type="tel" id="phone" name="phone" placeholder="+54 (11) 1234-5678" class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:border-gray-900 focus:ring-2 focus:ring-gray-900/10 transition-all" />
								</div>
							</div>

							<div>
								<label for="projectType" class="block text-sm font-semibold text-gray-700 mb-2">Tipo de proyecto *</label>
								<div class="grid grid-cols-2 md:grid-cols-5 gap-3">
									<label class="flex items-center p-3 border border-gray-200 rounded-lg cursor-pointer hover:border-gray-900 transition-colors">
										<input type="checkbox" name="projectType" value="datos" class="sr-only">
										<div class="w-4 h-4 border-2 border-gray-300 rounded mr-3 flex items-center justify-center"><div class="w-2 h-2 bg-gray-900 rounded hidden"></div></div>
										<span class="text-sm font-medium">Datos</span>
									</label>
									<label class="flex items-center p-3 border border-gray-200 rounded-lg cursor-pointer hover:border-gray-900 transition-colors">
										<input type="checkbox" name="projectType" value="control" class="sr-only">
										<div class="w-4 h-4 border-2 border-gray-300 rounded mr-3 flex items-center justify-center"><div class="w-2 h-2 bg-gray-900 rounded hidden"></div></div>
										<span class="text-sm font-medium">Control</span>
									</label>
									<label class="flex items-center p-3 border border-gray-200 rounded-lg cursor-pointer hover:border-gray-900 transition-colors">
										<input type="checkbox" name="projectType" value="incendio" class="sr-only">
										<div class="w-4 h-4 border-2 border-gray-300 rounded mr-3 flex items-center justify-center"><div class="w-2 h-2 bg-gray-900 rounded hidden"></div></div>
										<span class="text-sm font-medium">Incendio</span>
									</label>
									<label class="flex items-center p-3 border border-gray-200 rounded-lg cursor-pointer hover:border-gray-900 transition-colors">
										<input type="checkbox" name="projectType" value="software" class="sr-only">
										<div class="w-4 h-4 border-2 border-gray-300 rounded mr-3 flex items-center justify-center"><div class="w-2 h-2 bg-gray-900 rounded hidden"></div></div>
										<span class="text-sm font-medium">Software</span>
									</label>
									<label class="flex items-center p-3 border border-gray-200 rounded-lg cursor-pointer hover:border-gray-900 transition-colors">
										<input type="checkbox" name="projectType" value="soporte" class="sr-only">
										<div class="w-4 h-4 border-2 border-gray-300 rounded mr-3 flex items-center justify-center"><div class="w-2 h-2 bg-gray-900 rounded hidden"></div></div>
										<span class="text-sm font-medium">Soporte</span>
									</label>
								</div>
								<span class="text-red-500 text-sm hidden" id="projectTypeError"></span>
							</div>

							<input type="text" name="website" style="display:none" tabindex="-1" autocomplete="off" />

							<div>
								<label for="budget" class="block text-sm font-semibold text-gray-700 mb-2">Presupuesto estimado *</label>
								<div class="grid grid-cols-2 md:grid-cols-4 gap-3">
									<label class="flex items-center p-3 border border-gray-200 rounded-lg cursor-pointer hover:border-gray-900 transition-colors">
										<input type="radio" name="budget" value="5000-15000" class="sr-only">
										<div class="w-4 h-4 border-2 border-gray-300 rounded-full mr-3 flex items-center justify-center"><div class="w-2 h-2 bg-gray-900 rounded-full hidden"></div></div>
										<span class="text-sm font-medium">$5k-$15k</span>
									</label>
									<label class="flex items-center p-3 border border-gray-200 rounded-lg cursor-pointer hover:border-gray-900 transition-colors">
										<input type="radio" name="budget" value="15000-35000" class="sr-only">
										<div class="w-4 h-4 border-2 border-gray-300 rounded-full mr-3 flex items-center justify-center"><div class="w-2 h-2 bg-gray-900 rounded-full hidden"></div></div>
										<span class="text-sm font-medium">$15k-$35k</span>
									</label>
									<label class="flex items-center p-3 border border-gray-200 rounded-lg cursor-pointer hover:border-gray-900 transition-colors">
										<input type="radio" name="budget" value="35000-75000" class="sr-only">
										<div class="w-4 h-4 border-2 border-gray-300 rounded-full mr-3 flex items-center justify-center"><div class="w-2 h-2 bg-gray-900 rounded-full hidden"></div></div>
										<span class="text-sm font-medium">$35k-$75k</span>
									</label>
									<label class="flex items-center p-3 border border-gray-200 rounded-lg cursor-pointer hover:border-gray-900 transition-colors">
										<input type="radio" name="budget" value="75000+" class="sr-only">
										<div class="w-4 h-4 border-2 border-gray-300 rounded-full mr-3 flex items-center justify-center"><div class="w-2 h-2 bg-gray-900 rounded-full hidden"></div></div>
										<span class="text-sm font-medium">$75k+</span>
									</label>
								</div>
							</div>

							<div>
								<label for="timeline" class="block text-sm font-semibold text-gray-700 mb-2">Timeline preferido *</label>
								<div class="grid grid-cols-2 md:grid-cols-4 gap-3">
									<label class="flex flex-col items-center p-4 border border-gray-200 rounded-lg cursor-pointer hover:border-gray-900 transition-colors">
										<input type="radio" name="timeline" value="1-2-meses" class="sr-only">
										<span class="text-sm font-medium">1-2 meses</span>
									</label>
									<label class="flex flex-col items-center p-4 border border-gray-200 rounded-lg cursor-pointer hover:border-gray-900 transition-colors">
										<input type="radio" name="timeline" value="2-4-meses" class="sr-only">
										<span class="text-sm font-medium">2-4 meses</span>
									</label>
									<label class="flex flex-col items-center p-4 border border-gray-200 rounded-lg cursor-pointer hover:border-gray-900 transition-colors">
										<input type="radio" name="timeline" value="4-6-meses" class="sr-only">
										<span class="text-sm font-medium">4-6 meses</span>
									</label>
									<label class="flex flex-col items-center p-4 border border-gray-200 rounded-lg cursor-pointer hover:border-gray-900 transition-colors">
										<input type="radio" name="timeline" value="6+-meses" class="sr-only">
										<span class="text-sm font-medium">6+ meses</span>
									</label>
								</div>
							</div>

							<div>
								<label for="message" class="block text-sm font-semibold text-gray-700 mb-2">Descripción del proyecto *</label>
								<textarea id="message" name="message" required rows="4" placeholder="Describe tu proyecto, objetivos, funcionalidades necesarias..." class="w-full px-4 py-3 border border-gray-200 rounded-xl focus:outline-none focus:border-gray-900 focus:ring-2 focus:ring-gray-900/10 transition-all"></textarea>
								<span class="text-red-500 text-sm hidden" id="messageError"></span>
							</div>

							<div class="w-full flex justify-end">
								<button type="submit" class="bg-gray-900 hover:bg-gray-800 text-white font-semibold py-4 px-8 rounded-xl transition-colors">
									ENVIAR SOLICITUD
								</button>
							</div>

							<div id="successMessage" class="hidden bg-green-50 border border-green-200 text-green-700 p-4 rounded-xl">
								Mensaje enviado exitosamente. Nos pondremos en contacto contigo pronto.
							</div>
							<div id="errorMessage" class="hidden bg-red-50 border border-red-200 text-red-700 p-4 rounded-xl">
								Hubo un error al enviar el mensaje. Por favor, intenta nuevamente.
							</div>
						</form>
					</div>
				</div>

				<!-- Canales de Contacto -->
				<div class="sticky top-8 space-y-8">
					<div class="bg-white p-6 rounded-2xl shadow-soft">
						<h2 class="text-2xl font-bold text-gray-900 mb-3">
							Contacto directo en <span class="text-um-primary">Mendoza</span>
						</h2>
						<p class="text-gray-500 text-sm">
							Presencia local con atención personalizada. Estamos disponibles a través de múltiples canales para empresas mendocinas.
						</p>
					</div>

					<div class="bg-white p-6 rounded-2xl shadow-soft hover:shadow-elevated transition-all duration-300">
						<div class="flex items-center space-x-4">
							<div class="w-14 h-14 bg-gray-100 rounded-xl flex items-center justify-center">
								<svg class="w-7 h-7 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
							</div>
							<div class="flex-1">
								<h3 class="text-xl font-bold text-gray-900">Email Mendoza</h3>
								<p class="text-gray-500 text-sm mb-2">Escríbenos directamente</p>
								<p class="text-um-primary font-semibold">contacto@ultimamilla.com.ar</p>
							</div>
						</div>
					</div>

					<div class="bg-gray-50 p-6 rounded-2xl">
						<div class="flex items-center mb-4">
							<svg class="w-6 h-6 text-gray-600 mr-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
							<h3 class="text-xl font-bold text-gray-900">Horarios de atención</h3>
						</div>
						<div class="grid grid-cols-2 gap-4 text-sm">
							<div>
								<p class="font-semibold text-gray-900">Lunes - Viernes</p>
								<p class="text-gray-500">9:00 AM - 6:00 PM</p>
							</div>
							<div>
								<p class="font-semibold text-gray-900">Fines de semana</p>
								<p class="text-gray-500">Emergencias</p>
							</div>
						</div>
					</div>
				</div>
			</div>
		</div>
	</div>
</LayoutV4>

<script>
	const form = document.getElementById('contactForm') as HTMLFormElement;
	const successMessage = document.getElementById('successMessage');
	const errorMessage = document.getElementById('errorMessage');
	const errorElements = {
		name: document.getElementById('nameError'),
		email: document.getElementById('emailError'),
		message: document.getElementById('messageError')
	};

	document.addEventListener('DOMContentLoaded', () => {
		document.querySelectorAll('input[type="checkbox"]').forEach(checkbox => {
			checkbox.addEventListener('change', function() {
				const label = this.closest('label');
				const indicator = label?.querySelector('div > div');
				if ((this as HTMLInputElement).checked) {
					label?.classList.add('border-gray-900', 'bg-gray-50');
					indicator?.classList.remove('hidden');
				} else {
					label?.classList.remove('border-gray-900', 'bg-gray-50');
					indicator?.classList.add('hidden');
				}
			});
		});

		document.querySelectorAll('input[type="radio"]').forEach(radio => {
			radio.addEventListener('change', function() {
				const name = (this as HTMLInputElement).name;
				document.querySelectorAll(`input[name="${name}"]`).forEach(r => {
					const label = r.closest('label');
					const indicator = label?.querySelector('div > div');
					label?.classList.remove('border-gray-900', 'bg-gray-50');
					indicator?.classList.add('hidden');
				});
				
				const label = this.closest('label');
				const indicator = label?.querySelector('div > div');
				label?.classList.add('border-gray-900', 'bg-gray-50');
				indicator?.classList.remove('hidden');
			});
		});
	});

	function isValidEmail(email: string) {
		const re = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
		return re.test(email);
	}

	function showError(field: keyof typeof errorElements, message: string) {
		const errorElement = errorElements[field];
		if (errorElement) {
			errorElement.textContent = message;
			errorElement.classList.remove('hidden');
		}
	}

	function clearErrors() {
		Object.values(errorElements).forEach(element => {
			if (element) {
				element.textContent = '';
				element.classList.add('hidden');
			}
		});
		successMessage?.classList.add('hidden');
		errorMessage?.classList.add('hidden');
	}

	if (form) {
		form.addEventListener('submit', async (e) => {
			e.preventDefault();
			clearErrors();

			const formData = new FormData(form);
			const data = Object.fromEntries(formData);
			let hasErrors = false;

			if (!data.name) { showError('name', 'El nombre es requerido'); hasErrors = true; }
			if (!data.email) { showError('email', 'El email es requerido'); hasErrors = true; }
			else if (!isValidEmail(data.email.toString())) { showError('email', 'Por favor ingresa un email válido'); hasErrors = true; }
			if (!data.message) { showError('message', 'El mensaje es requerido'); hasErrors = true; }

			if (hasErrors) return;

			try {
				const projectTypes = [];
				document.querySelectorAll('input[name="projectType"]:checked').forEach(checkbox => {
					projectTypes.push((checkbox as HTMLInputElement).value);
				});
				
				const submitData = {
					name: data.name,
					email: data.email,
					company: data.company || '',
					phone: data.phone || '',
					projectType: projectTypes,
					budget: data.budget || '',
					timeline: data.timeline || '',
					message: data.message,
					website: data.website || ''
				};
				
				const response = await fetch('/api/contact', {
					method: 'POST',
					headers: { 'Content-Type': 'application/json' },
					body: JSON.stringify(submitData)
				});
				
				const result = await response.json();
				
				if (result.success) {
					if (successMessage) {
						successMessage.textContent = result.message || 'Mensaje enviado exitosamente. Te contactaremos pronto.';
						successMessage.classList.remove('hidden');
						form.reset();
						document.querySelectorAll('label').forEach(label => {
							label.classList.remove('border-gray-900', 'bg-gray-50');
							const indicator = label.querySelector('div > div');
							indicator?.classList.add('hidden');
						});
					}
				} else {
					if (errorMessage) {
						errorMessage.textContent = result.message || 'Error al enviar el mensaje. Por favor, intenta nuevamente.';
						errorMessage.classList.remove('hidden');
					}
				}
			} catch (error) {
				console.error('Error al enviar formulario:', error);
				if (errorMessage) {
					errorMessage.textContent = 'Error de conexión. Por favor, intenta nuevamente o contacta por email.';
					errorMessage.classList.remove('hidden');
				}
			}
		});
	}
</script>

<style>
  #contact-layout {
    position: relative;
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  
  @media (min-width: 1024px) {
    #contact-layout {
      grid-template-columns: 1fr 1fr;
      align-items: start;
    }

    #contact-layout > div:last-child {
      position: sticky;
      top: 2rem;
      align-self: flex-start;
    }
  }

  @media (max-width: 1023px) {
    #contact-layout > div:first-child {
      order: 1;
    }
    #contact-layout > div:last-child {
      order: 2;
      text-align: center;
    }
  }
</style>
