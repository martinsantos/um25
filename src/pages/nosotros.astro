---
import LayoutV4 from '../layouts/LayoutV4.astro';
import MetricStrip from '../components/um/MetricStrip.astro';
import SectionHeader from '../components/um/SectionHeader.astro';
import UMButton from '../components/um/UMButton.astro';
import { editorialImages, editorialImageDimensions } from '../data/editorialImageSystem';
import { resolveReplicaH1 } from '../utils/replicaProdCopy';
import { getAntecedentesCountShort } from '../utils/verifiedProof';

const nosotrosH1 = resolveReplicaH1('/nosotros', 'Una empresa técnica para operaciones que no pueden detenerse');

const principles = [
  ['Ingeniería antes que marketing', 'Cada decisión se justifica por disponibilidad, seguridad, mantenibilidad y costo operativo.'],
  ['Ejecución en campo', 'Diseñamos con conocimiento real de obra, salas técnicas, racks, tendidos, energía y operación diaria.'],
  ['Documentación útil', 'La entrega debe poder operarse, auditarse, ampliar y sostener sin depender de memoria informal.'],
  ['Continuidad como criterio', 'El soporte, el mantenimiento y la trazabilidad forman parte del diseño, no del cierre comercial.']
];

const capabilities = [
  'Redes, fibra, switching, WiFi corporativo y radioenlaces',
  'Seguridad electrónica, CCTV, accesos e intrusión',
  'Telecomunicaciones, voz, datos, video y conectividad distribuida',
  'Software a medida, SGI, APIs, tableros e integraciones',
  'Soporte 24/7, mantenimiento preventivo y respuesta a incidentes',
  'Detección de incendios y eléctricos dedicados para IT'
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'Nosotros | ULTIMA MILLA',
  url: 'https://www.ultimamilla.com.ar/nosotros',
  significantLink: [
    'https://www.ultimamilla.com.ar/servicios',
    'https://www.ultimamilla.com.ar/antecedentes',
    'https://www.ultimamilla.com.ar/sectores',
    'https://www.ultimamilla.com.ar/contacto',
    'https://www.ultimamilla.com.ar/geo',
  ],
  about: {
    '@type': 'Organization',
    name: 'ULTIMA MILLA',
    url: 'https://www.ultimamilla.com.ar',
    description: 'Empresa argentina de servicios IT integrales, infraestructura tecnológica, telecomunicaciones, seguridad electrónica, software y soporte.'
  },
  hasPart: [
    { '@type': 'WebPage', name: 'Servicios IT integrales', url: 'https://www.ultimamilla.com.ar/servicios' },
    { '@type': 'WebPage', name: 'Antecedentes técnicos', url: 'https://www.ultimamilla.com.ar/antecedentes' },
    { '@type': 'WebPage', name: 'Sectores ULTIMA MILLA', url: 'https://www.ultimamilla.com.ar/sectores' },
  ],
};
---

<LayoutV4
  title="Una empresa técnica para operaciones que no pueden detenerse | ULTIMA MILLA"
  description="ULTIMA MILLA integra redes, telecomunicaciones, seguridad electrónica, software, soporte y consultoría IT para empresas con operación crítica en Argentina."
  keywords="empresa servicios IT, Ultima Milla, infraestructura tecnologica, telecomunicaciones, seguridad electronica, software, soporte IT Mendoza Argentina"
  image={editorialImages.aboutHero}
  imageWidth={editorialImageDimensions.width}
  imageHeight={editorialImageDimensions.height}
  structuredData={structuredData}
>
  <section class="about-hero">
    <div class="um-container about-hero__grid">
      <div class="about-hero__copy">
        <nav class="about-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Inicio</a>
          <span>/</span>
          <span>Nosotros</span>
        </nav>
        <h1>{nosotrosH1}</h1>
        <p>
          ULTIMA MILLA integra infraestructura, comunicaciones, seguridad y software con criterio de
          continuidad operativa. Nuestra diferencia está en unir diseño, instalación y soporte en un
          mismo sistema de trabajo.
        </p>
        <div class="about-hero__actions" aria-label="Acciones institucionales">
          <UMButton href="/antecedentes">Ver antecedentes</UMButton>
          <UMButton href="/servicios" variant="secondary">Ver servicios</UMButton>
        </div>
        <MetricStrip
          class="about-hero__proof"
          metrics={[
            { value: 'Desde 2000', label: 'trayectoria técnica' },
            { value: getAntecedentesCountShort(), label: 'proyectos' },
            { value: '24/7', label: 'soporte operativo' },
          ]}
        />
      </div>
      <figure class="about-hero__media">
        <img src={editorialImages.aboutHero} alt="Documentación técnica e infraestructura operativa de ULTIMA MILLA" loading="eager" fetchpriority="high" decoding="async" width={editorialImageDimensions.width} height={editorialImageDimensions.height} />
        <figcaption>Diseño, instalación y soporte bajo una misma responsabilidad técnica.</figcaption>
      </figure>
    </div>
  </section>

  <section class="um-section about-position">
    <div class="um-container about-position__grid">
      <div>
        <SectionHeader
          kicker="Posicionamiento"
          title="Servicios IT integrales, con responsabilidad sobre el resultado"
        />
      </div>
      <div>
        <p>
          No trabajamos como una suma de proveedores desconectados. Relevamos, diseñamos, ejecutamos,
          documentamos y sostenemos componentes que deben convivir: red, energía, seguridad, software,
          comunicaciones y soporte.
        </p>
        <p>
          Ese enfoque permite reducir puntos ciegos, ordenar decisiones técnicas y convertir cada
          proyecto en una plataforma operable para el cliente.
        </p>
      </div>
    </div>
  </section>

  <section class="about-principles">
    <div class="um-container">
      <div class="about-principles__head">
        <SectionHeader kicker="Criterios" title="El estándar de trabajo que debe verse en la web" />
      </div>
      <div class="principles-grid">
        {principles.map(([title, text], index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="about-capabilities">
    <div class="um-container about-capabilities__grid">
      <div class="about-capabilities__media">
        <img src={editorialImages.aboutCapabilities} alt="Infraestructura eléctrica, cableado y control para sistemas IT" loading="lazy" width={editorialImageDimensions.width} height={editorialImageDimensions.height} />
      </div>
      <div>
        <SectionHeader kicker="Capacidad conectada" title="Una mesa técnica para resolver el sistema completo" />
        <ul>
          {capabilities.map((capability) => <li>{capability}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="about-timeline">
    <div class="um-container">
      <SectionHeader kicker="Trayectoria" title="Hitos que sostienen la operación en campo" />
      <ol class="about-timeline__list">
        <li>
          <span>2000</span>
          <div>
            <strong>Origen en infraestructura y telecomunicaciones</strong>
            <p>Instalación, tendidos y continuidad para organizaciones con operación presencial.</p>
          </div>
        </li>
        <li>
          <span>2010</span>
          <div>
            <strong>Integración de seguridad electrónica y software operativo</strong>
            <p>Un solo criterio para red, monitoreo, accesos y sistemas que sostienen el negocio.</p>
          </div>
        </li>
        <li>
          <span>2018</span>
          <div>
            <strong>Soporte 24/7 y documentación de antecedentes</strong>
            <p>Respuesta en incidentes y archivo verificable por sector y servicio.</p>
          </div>
        </li>
        <li>
          <span>Hoy</span>
          <div>
            <strong>Servicios IT integrales en Argentina</strong>
            <p>Mendoza, Cuyo, Patagonia y proyectos nacionales con evidencia operativa visible.</p>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <section class="about-proof">
    <div class="um-container about-proof__grid">
      <div>
        <h2>La trayectoria importa cuando el sitio, el edificio o la planta ya están funcionando.</h2>
      </div>
      <div>
        <p>
          Muchos proyectos se definen en condiciones reales: ventanas de intervención cortas, edificios
          ocupados, equipos de terceros, documentación incompleta y urgencia operativa. Ahí la experiencia
          no es un claim: es la diferencia entre instalar algo y dejarlo operable.
        </p>
        <UMButton href="/antecedentes">Revisar antecedentes</UMButton>
      </div>
    </div>
  </section>
</LayoutV4>

<style>
  .about-hero {
    background: #0a0c0d;
    color: #ffffff;
    padding: clamp(44px, 5.8vw, 76px) 0 clamp(48px, 6.4vw, 86px);
    border-bottom: 0;
  }

  .about-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.08fr) minmax(360px, 0.92fr);
    gap: clamp(42px, 7vw, 96px);
    align-items: center;
  }

  .about-hero__copy {
    min-width: 0;
  }

  .about-breadcrumb {
    display: flex;
    gap: 0.55rem;
    margin-bottom: clamp(24px, 3.4vw, 42px);
    color: #c4c7cc;
    font-size: 1rem;
    font-weight: 700;
  }

  .about-breadcrumb a:hover {
    color: #ffffff;
  }

  .about-breadcrumb a:focus-visible {
    outline: 2px solid #ffffff;
    outline-offset: 4px;
  }

  .about-hero h1 {
    max-width: 840px;
    color: #ffffff;
    font-size: clamp(2.25rem, 3.7vw, 3.62rem);
    line-height: 1.06;
    font-weight: 600;
    letter-spacing: var(--um-display-tracking);
    text-wrap: balance;
    overflow-wrap: normal;
    hyphens: none;
  }

  .about-hero p {
    max-width: 680px;
    margin-top: 1.25rem;
    color: #c4c7cc;
    font-size: clamp(1rem, 1.08vw, 1.12rem);
    line-height: 1.68;
  }

  .about-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: clamp(22px, 2.6vw, 30px);
  }

  :global(.about-hero .um-btn-secondary) {
    border: 1px solid rgba(255, 255, 255, 0.5);
    background: transparent;
    color: #ffffff;
  }

  :global(.about-hero .um-btn-secondary:hover),
  :global(.about-hero .um-btn-secondary:focus-visible) {
    border-color: #ffffff;
    background: #ffffff;
    color: #111111;
  }

  :global(.about-hero__proof.um-metric-strip) {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: clamp(30px, 4vw, 46px) 0 0;
    padding: 18px 0 0;
    border-top: 1px solid rgba(255, 255, 255, 0.24);
    border-bottom: 0;
    background: transparent;
  }

  :global(.about-hero__proof.um-metric-strip > *) {
    min-width: 0;
    padding: 0.9rem 1rem 1rem;
    border-bottom: 0;
  }

  :global(.about-hero__proof.um-metric-strip > *:last-child) {
    border-bottom: 0;
  }

  :global(.about-hero__proof.um-metric-strip strong) {
    color: #ffffff;
    font-size: clamp(1.22rem, 1.6vw, 1.62rem);
    line-height: 1.1;
    font-weight: 600;
  }

  :global(.about-hero__proof.um-metric-strip span) {
    display: block;
    margin-top: 0.45rem;
    color: #c4c7cc;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
    overflow-wrap: normal;
  }

  .about-hero__media {
    min-width: 0;
    margin: 0;
  }

  .about-hero__media img {
    display: block;
    width: 100%;
    min-height: clamp(430px, 46vw, 610px);
    height: 100%;
    object-fit: cover;
    border: 0;
    border-radius: 0;
    filter: saturate(0.82) contrast(1.1);
  }

  .about-hero__media figcaption {
    margin-top: 12px;
    color: #c4c7cc;
    font-size: 1rem;
    line-height: 1.45;
  }

  .about-position {
    background: #fff;
  }

  .about-position__grid,
  .about-proof__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 7vw, 96px);
  }

  .about-position h2,
  .about-proof h2 {
    margin-top: 1rem;
    color: #111;
    font-size: clamp(1.82rem, 2.35vw, 2.55rem);
    line-height: 1.12;
    font-weight: 600;
  }

  .about-position p,
  .about-proof p {
    color: var(--um-muted);
    font-size: clamp(1rem, 1.08vw, 1.1rem);
    line-height: 1.78;
  }

  .about-position p + p {
    margin-top: 1.3rem;
  }

  .about-principles {
    background: #fff;
    padding: clamp(64px, 8vw, 112px) 0;
    border-top: 0;
    border-bottom: 0;
  }

  .about-principles__head {
    display: grid;
    grid-template-columns: 0.6fr 1fr;
    gap: clamp(24px, 5vw, 70px);
    align-items: end;
    margin-bottom: clamp(34px, 6vw, 72px);
  }

  .about-principles__head h2 {
    color: #111;
    font-size: clamp(1.82rem, 2.35vw, 2.55rem);
    line-height: 1.12;
    font-weight: 600;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(10px, 1.45vw, 16px);
    border-top: 0;
  }

  .principles-grid article {
    min-height: 230px;
    padding: clamp(22px, 3vw, 34px);
    background: #f7f8f9;
    border-right: 0;
  }

  .principles-grid article:last-child {
    border-right: 0;
  }

  .principles-grid article span {
    color: var(--um-red);
    font-size: 1rem;
    font-weight: 700;
  }

  .principles-grid h3 {
    margin-top: 1.15rem;
    color: #111;
    font-size: 1.22rem;
    line-height: 1.18;
    font-weight: 600;
  }

  .principles-grid p {
    margin-top: 0.9rem;
    color: var(--um-muted);
    line-height: 1.68;
  }

  .about-capabilities {
    background: #fff;
    padding: clamp(64px, 8vw, 112px) 0;
  }

  .about-capabilities__grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.82fr) minmax(0, 1fr);
    gap: clamp(34px, 7vw, 96px);
    align-items: center;
  }

  .about-capabilities__media {
    height: clamp(360px, 48vw, 650px);
    overflow: hidden;
    border-radius: 6px;
    background: #111;
  }

  .about-capabilities__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) contrast(1.05);
  }

  .about-capabilities h2 {
    margin-top: 1rem;
    color: #111;
    font-size: clamp(1.82rem, 2.35vw, 2.55rem);
    line-height: 1.12;
    font-weight: 600;
    text-wrap: balance;
  }

  .about-capabilities ul {
    display: grid;
    gap: 10px;
    margin: clamp(28px, 4vw, 46px) 0 0;
    padding: 0;
    list-style: none;
    border-top: 0;
  }

  .about-capabilities li {
    padding: 1rem 0;
    background: #fff;
    color: #111;
    font-weight: 600;
    line-height: 1.45;
    border-bottom: 0;
  }

  .about-capabilities li::before {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 0.75rem;
    background: var(--um-red);
    vertical-align: 0.08em;
  }

  .about-proof {
    background: #fff;
    color: #111;
    padding: clamp(64px, 8vw, 112px) 0;
    border-top: 0;
  }

  .about-proof h2 {
    color: #111;
  }

  .about-proof p {
    color: var(--um-muted);
  }

  .about-proof a {
    margin-top: 1.6rem;
  }

  .about-timeline {
    background: #fff;
    padding: clamp(64px, 8vw, 112px) 0;
    border-top: 0;
  }

  .about-timeline__list {
    display: grid;
    gap: 0;
    margin: clamp(28px, 4vw, 48px) 0 0;
    padding: 0;
    list-style: none;
    border-top: 0;
  }

  .about-timeline__list li {
    display: grid;
    grid-template-columns: 88px minmax(0, 1fr);
    gap: clamp(20px, 3vw, 40px);
    padding: clamp(22px, 2.8vw, 30px) 0;
    border-bottom: 0;
    transition: background-color 180ms ease;
  }

  .about-timeline__list li:hover {
    background: rgba(220, 38, 38, 0.03);
  }

  .about-timeline__list li > span {
    color: var(--um-red);
    font-family: var(--um-font-display);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .about-timeline__list strong {
    display: block;
    color: #111;
    font-family: var(--um-font-display);
    font-size: clamp(1.12rem, 1.4vw, 1.28rem);
    font-weight: 600;
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .about-timeline__list p {
    margin: 10px 0 0;
    color: var(--um-muted);
    font-size: 1rem;
    line-height: 1.65;
  }

  @media (max-width: 920px) {
    .about-hero__grid,
    .about-position__grid,
    .about-principles__head,
    .about-capabilities__grid,
    .about-proof__grid {
      grid-template-columns: 1fr;
    }

    .about-hero__media img {
      min-height: 0;
      aspect-ratio: 16 / 9;
    }

    .principles-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .about-hero {
      padding: 30px 0 34px;
    }

    .about-hero__grid {
      gap: 32px;
    }

    .about-breadcrumb {
      margin-bottom: 20px;
    }

    .about-hero h1 {
      font-size: clamp(2.08rem, 10.2vw, 2.28rem);
      line-height: 1.13;
      overflow-wrap: normal;
    }

    .about-hero p {
      margin-top: 1rem;
      line-height: 1.62;
    }

    .about-hero__actions {
      display: grid;
      gap: 10px;
    }

    :global(.about-hero__proof.um-metric-strip) {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      margin-top: 26px;
      padding: 14px 0 0;
      border-bottom: 0;
      overflow: hidden;
    }

    :global(.about-hero__proof.um-metric-strip > *) {
      padding: 14px 16px 16px;
      border-bottom: 0;
      border-right: 0;
    }

    :global(.about-hero__proof.um-metric-strip > *:last-child) {
      border-right: 0;
    }

    :global(.about-hero__proof.um-metric-strip strong) {
      font-size: 1.34rem;
    }

    :global(.about-hero__proof.um-metric-strip span) {
      font-size: 1rem;
      line-height: 1.2;
    }

    .about-timeline__list li {
      grid-template-columns: 1fr;
      gap: 10px;
    }

    .about-timeline__list li > span {
      font-size: 1rem;
    }

    .principles-grid {
      grid-template-columns: 1fr;
    }
  }
  .about-hero h1,
  .about-position h2,
  .about-principles__head h2,
  .about-capabilities h2,
  .about-proof h2 {
    letter-spacing: 0;
  }

  .about-hero__media img,
  .about-capabilities__media,
  .principles-grid article,
  .about-hero__proof {
    border-radius: 0;
    box-shadow: none;
  }

  .principles-grid article,
  .about-capabilities li {
    border-top: 0;
  }
</style>
