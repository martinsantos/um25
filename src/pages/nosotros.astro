---
import LayoutV4 from '../layouts/LayoutV4.astro';

const principles = [
  ['Ingeniería antes que marketing', 'Cada decisión se justifica por disponibilidad, seguridad, mantenibilidad y costo operativo.'],
  ['Ejecución en campo', 'Diseñamos con conocimiento real de obra, salas técnicas, racks, tendidos, energía y operación diaria.'],
  ['Documentación útil', 'La entrega debe poder operarse, auditarse, ampliar y sostener sin depender de memoria informal.'],
  ['Continuidad como criterio', 'El soporte, el mantenimiento y la trazabilidad forman parte del diseño, no del cierre comercial.']
];

const capabilities = [
  'Redes, fibra, switching, WiFi corporativo y radioenlaces',
  'Seguridad electrónica, CCTV, accesos e intrusión',
  'Telecomunicaciones, voz, datos, video y conectividad distribuida',
  'Software a medida, SGI, APIs, tableros e integraciones',
  'Soporte 24/7, mantenimiento preventivo y respuesta a incidentes',
  'Detección de incendios y eléctricos dedicados para IT'
];

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'AboutPage',
  name: 'Nosotros | ULTIMA MILLA',
  url: 'https://ultimamilla.com.ar/nosotros',
  about: {
    '@type': 'Organization',
    name: 'ULTIMA MILLA',
    url: 'https://ultimamilla.com.ar',
    description: 'Empresa argentina de servicios IT integrales, infraestructura tecnológica, telecomunicaciones, seguridad electrónica, software y soporte.'
  }
};
---

<LayoutV4
  title="Empresa de servicios IT integrales | ULTIMA MILLA"
  description="ULTIMA MILLA integra redes, telecomunicaciones, seguridad electrónica, software, soporte y consultoría IT para empresas con operación crítica en Argentina."
  keywords="empresa servicios IT, Ultima Milla, infraestructura tecnologica, telecomunicaciones, seguridad electronica, software, soporte IT Mendoza Argentina"
  structuredData={structuredData}
>
  <section class="about-hero">
    <div class="um-container about-hero__grid">
      <div>
        <nav class="about-breadcrumb" aria-label="Breadcrumb">
          <a href="/">Inicio</a>
          <span>/</span>
          <span>Nosotros</span>
        </nav>
        <h1>Una empresa técnica para operaciones que no pueden detenerse</h1>
        <p>
          ULTIMA MILLA integra infraestructura, comunicaciones, seguridad y software con criterio de
          continuidad operativa. Nuestra diferencia está en unir diseño, instalación y soporte en un
          mismo sistema de trabajo.
        </p>
      </div>
      <div class="about-hero__proof">
        <div>
          <strong>22+</strong>
          <span>trayectoria técnica</span>
        </div>
        <div>
          <strong>469+</strong>
          <span>antecedentes</span>
        </div>
        <div>
          <strong>24/7</strong>
          <span>soporte operativo</span>
        </div>
      </div>
    </div>
  </section>

  <section class="about-image-band" aria-label="Infraestructura ULTIMA MILLA">
    <div class="um-container">
      <img src="/uploads/antecedentes/0021d14f-3f8a-4e39-9a03-dad7c8681c0d.jpg" alt="Rack de comunicaciones y cableado técnico instalado por ULTIMA MILLA" loading="eager" />
    </div>
  </section>

  <section class="um-section about-position">
    <div class="um-container about-position__grid">
      <div>
        <span class="um-kicker">Posicionamiento</span>
        <h2>Servicios IT integrales, con responsabilidad sobre el resultado</h2>
      </div>
      <div>
        <p>
          No trabajamos como una suma de proveedores desconectados. Relevamos, diseñamos, ejecutamos,
          documentamos y sostenemos componentes que deben convivir: red, energía, seguridad, software,
          comunicaciones y soporte.
        </p>
        <p>
          Ese enfoque permite reducir puntos ciegos, ordenar decisiones técnicas y convertir cada
          proyecto en una plataforma operable para el cliente.
        </p>
      </div>
    </div>
  </section>

  <section class="about-principles">
    <div class="um-container">
      <div class="about-principles__head">
        <span class="um-kicker">Criterios</span>
        <h2>El estándar de trabajo que debe verse en la web</h2>
      </div>
      <div class="principles-grid">
        {principles.map(([title, text], index) => (
          <article>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h3>{title}</h3>
            <p>{text}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="about-capabilities">
    <div class="um-container about-capabilities__grid">
      <div class="about-capabilities__media">
        <img src="/uploads/antecedentes/06b069ad-dab6-4d04-84b7-150465976a4a.jpg" alt="Infraestructura eléctrica y de datos para sistemas IT" loading="lazy" />
      </div>
      <div>
        <span class="um-kicker">Capacidad conectada</span>
        <h2>Una mesa técnica para resolver el sistema completo</h2>
        <ul>
          {capabilities.map((capability) => <li>{capability}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="about-proof">
    <div class="um-container about-proof__grid">
      <div>
        <h2>La trayectoria importa cuando el sitio, el edificio o la planta ya están funcionando.</h2>
      </div>
      <div>
        <p>
          Muchos proyectos se definen en condiciones reales: ventanas de intervención cortas, edificios
          ocupados, equipos de terceros, documentación incompleta y urgencia operativa. Ahí la experiencia
          no es un claim: es la diferencia entre instalar algo y dejarlo operable.
        </p>
        <a href="/antecedentes" class="um-btn-primary">Revisar antecedentes</a>
      </div>
    </div>
  </section>
</LayoutV4>

<style>
  .about-hero {
    background: var(--skin-page, #fff);
    color: var(--skin-text, #0B0B0B);
    padding: clamp(40px, 5.4vw, 70px) 0 clamp(44px, 5.8vw, 76px);
    border-bottom: 1px solid var(--skin-line, #E5E7EB);
  }

  .about-hero__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.66fr) minmax(280px, 0.34fr);
    gap: clamp(36px, 7vw, 88px);
    align-items: start;
  }

  .about-breadcrumb {
    display: flex;
    gap: 0.55rem;
    margin-bottom: clamp(24px, 3.4vw, 42px);
    color: var(--skin-muted, #64748B);
    font-size: 1rem;
    font-weight: 700;
  }

  .about-breadcrumb a:hover {
    color: var(--um-red);
  }

  .about-hero h1 {
    max-width: 840px;
    color: var(--skin-text, #0B0B0B);
    font-size: clamp(2.08rem, 3.05vw, 3.08rem);
    line-height: 1.1;
    font-weight: 600;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .about-hero p {
    max-width: 680px;
    margin-top: 1.25rem;
    color: var(--skin-muted, #475569);
    font-size: clamp(1rem, 1.08vw, 1.12rem);
    line-height: 1.68;
  }

  .about-hero__proof {
    display: grid;
    border-top: 1px solid var(--skin-line, #DDE2EA);
    border-bottom: 1px solid var(--skin-line, #DDE2EA);
    background: #fff;
  }

  .about-hero__proof div {
    padding: 0.95rem 0 1rem;
    background: #fff;
    border-bottom: 1px solid var(--skin-line, #DDE2EA);
  }

  .about-hero__proof div:last-child {
    border-bottom: 0;
  }

  .about-hero__proof strong {
    display: block;
    color: var(--skin-text, #0B0B0B);
    font-size: clamp(1.35rem, 1.86vw, 1.86rem);
    line-height: 1.1;
    font-weight: 600;
  }

  .about-hero__proof span {
    display: block;
    margin-top: 0.45rem;
    color: var(--skin-muted, #64748B);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .about-image-band {
    background: var(--skin-page, #fff);
    padding: 0 0 clamp(44px, 7vw, 84px);
  }

  .about-image-band img {
    display: block;
    width: 100%;
    height: clamp(300px, 40vw, 540px);
    object-fit: cover;
    border: 1px solid var(--skin-line, #E5E7EB);
    border-radius: 0;
    filter: saturate(0.9) contrast(1.06);
  }

  .about-position {
    background: #fff;
  }

  .about-position__grid,
  .about-proof__grid {
    display: grid;
    grid-template-columns: 0.9fr 1.1fr;
    gap: clamp(32px, 7vw, 96px);
  }

  .about-position h2,
  .about-proof h2 {
    margin-top: 1rem;
    color: #111;
    font-size: clamp(1.82rem, 2.35vw, 2.55rem);
    line-height: 1.12;
    font-weight: 600;
  }

  .about-position p,
  .about-proof p {
    color: var(--um-muted);
    font-size: clamp(1rem, 1.08vw, 1.1rem);
    line-height: 1.78;
  }

  .about-position p + p {
    margin-top: 1.3rem;
  }

  .about-principles {
    background: #fff;
    padding: clamp(64px, 8vw, 112px) 0;
    border-top: 1px solid var(--um-line);
    border-bottom: 1px solid var(--um-line);
  }

  .about-principles__head {
    display: grid;
    grid-template-columns: 0.6fr 1fr;
    gap: clamp(24px, 5vw, 70px);
    align-items: end;
    margin-bottom: clamp(34px, 6vw, 72px);
  }

  .about-principles__head h2 {
    color: #111;
    font-size: clamp(1.82rem, 2.35vw, 2.55rem);
    line-height: 1.12;
    font-weight: 600;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0;
    border-top: 1px solid var(--um-line);
  }

  .principles-grid article {
    min-height: 230px;
    padding: clamp(22px, 3vw, 34px);
    background: #fff;
    border-right: 1px solid var(--um-line);
  }

  .principles-grid article:last-child {
    border-right: 0;
  }

  .principles-grid article span {
    color: var(--um-red);
    font-size: 1rem;
    font-weight: 700;
  }

  .principles-grid h3 {
    margin-top: 1.15rem;
    color: #111;
    font-size: 1.22rem;
    line-height: 1.18;
    font-weight: 600;
  }

  .principles-grid p {
    margin-top: 0.9rem;
    color: var(--um-muted);
    line-height: 1.68;
  }

  .about-capabilities {
    background: #fff;
    padding: clamp(64px, 8vw, 112px) 0;
  }

  .about-capabilities__grid {
    display: grid;
    grid-template-columns: minmax(280px, 0.82fr) minmax(0, 1fr);
    gap: clamp(34px, 7vw, 96px);
    align-items: center;
  }

  .about-capabilities__media {
    height: clamp(360px, 48vw, 650px);
    overflow: hidden;
    border-radius: 6px;
    background: #111;
  }

  .about-capabilities__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) contrast(1.05);
  }

  .about-capabilities h2 {
    margin-top: 1rem;
    color: #111;
    font-size: clamp(1.82rem, 2.35vw, 2.55rem);
    line-height: 1.12;
    font-weight: 600;
    text-wrap: balance;
  }

  .about-capabilities ul {
    display: grid;
    gap: 0;
    margin: clamp(28px, 4vw, 46px) 0 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--um-line);
  }

  .about-capabilities li {
    padding: 1rem 0;
    background: #fff;
    color: #111;
    font-weight: 600;
    line-height: 1.45;
    border-bottom: 1px solid var(--um-line);
  }

  .about-capabilities li::before {
    content: "";
    display: inline-block;
    width: 8px;
    height: 8px;
    margin-right: 0.75rem;
    background: var(--um-red);
    vertical-align: 0.08em;
  }

  .about-proof {
    background: #fff;
    color: #111;
    padding: clamp(64px, 8vw, 112px) 0;
    border-top: 1px solid var(--um-line);
  }

  .about-proof h2 {
    color: #111;
  }

  .about-proof p {
    color: var(--um-muted);
  }

  .about-proof a {
    margin-top: 1.6rem;
  }

  @media (max-width: 920px) {
    .about-hero__grid,
    .about-position__grid,
    .about-principles__head,
    .about-capabilities__grid,
    .about-proof__grid {
      grid-template-columns: 1fr;
    }

    .principles-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .about-hero h1 {
      font-size: clamp(1.78rem, 6.55vw, 2.12rem);
      line-height: 1.16;
      overflow-wrap: anywhere;
    }

    .principles-grid {
      grid-template-columns: 1fr;
    }
  }
  .about-hero h1,
  .about-position h2,
  .about-principles__head h2,
  .about-capabilities h2,
  .about-proof h2 {
    letter-spacing: 0;
  }

  .about-image-band img,
  .about-capabilities__media,
  .principles-grid article,
  .about-hero__proof {
    border-radius: 0;
    box-shadow: none;
  }

  .principles-grid article,
  .about-capabilities li {
    border-top: 0;
  }
</style>
