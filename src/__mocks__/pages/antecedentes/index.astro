---
// Mock para la página de antecedentes
export const getStaticPaths = () => ({
  paths: [{ params: {} }],
  fallback: false,
});

// Mock de los datos que devuelve la página
const mockData = {
  servicios: [],
  filterOptions: {},
  randomImages: [],
};

// Exportar los datos simulados
export const getStaticProps = () => ({
  props: mockData,
});
---

<!-- Mock del HTML de la página -->
<div class="antecedentes-page">
  <div class="bg-ultima-navy text-white py-16 md:py-24">
    <div class="container mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-bold mb-4">Nuestros Proyectos</h1>
      <p class="text-xl text-gray-300 max-w-3xl mx-auto">
        Descubre nuestra experiencia y casos de éxito en diferentes sectores e industrias.
      </p>
    </div>
  </div>
  
  <div class="container mx-auto px-4 py-12">
    <div class="filters-section">
      <!-- Filtros simulados -->
    </div>
    
    <div class="projects-grid">
      <!-- Proyectos simulados -->
    </div>
  </div>
</div>
