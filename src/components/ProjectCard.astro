---
interface Props {
  id: string;
  titulo: string;
  cliente: string;
  descripcion: string;
  fecha: string;
  area: string;
  servicio: string;
  imagen?: string;
  slug: string;
}

const { 
  id,
  titulo, 
  cliente, 
  descripcion, 
  fecha, 
  area, 
  servicio,
  imagen,
  slug 
} = Astro.props;

// NO fallbacks - image must come from Directus
if (!imagen) {
  console.error(`[ProjectCard] Missing image for: ${titulo} (ID: ${id})`);
}
const imageUrl = imagen;

// Formatear fecha
const formatDate = (dateString: string) => {
  if (!dateString) return '';
  try {
    const date = new Date(dateString);
    return date.toLocaleDateString('es-AR', {
      day: '2-digit',
      month: 'short',
      year: 'numeric'
    });
  } catch (e) {
    return dateString;
  }
};

---

<article class="project-card bg-white overflow-hidden flex flex-col h-full border border-gray-200">
  <a href={`/antecedentes/${id}/${slug}`} class="block group h-full flex flex-col cursor-pointer">
    <div class="relative overflow-hidden h-52 bg-gray-100">
      {imageUrl ? (
        <img
          src={imageUrl}
          alt={titulo}
          loading="lazy"
          class="w-full h-full object-cover"
          onerror="this.onerror=null;this.src='/images/default-background.jpg'"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center bg-um-gray text-um-dark">
          <p class="text-base">Imagen no disponible</p>
        </div>
      )}
    </div>
    
    <div class="p-6 flex-1 flex flex-col border-t-[3px] border-[#DC2626]">
      <div class="flex-1">
        <h3 class="text-2xl font-semibold text-gray-900 mb-3 line-clamp-2 group-hover:text-red-600 transition-colors leading-tight">{titulo}</h3>
        <p class="text-gray-600 mb-4 line-clamp-2">{descripcion}</p>
      </div>
      
      <div class="mt-4 pt-4 border-t border-gray-100">
        <div class="flex items-center text-base text-gray-500 mb-2">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          <span>{formatDate(fecha)}</span>
        </div>
        <div class="flex items-center text-base text-gray-500">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
          <span class="truncate">{cliente}</span>
        </div>
      </div>
    </div>
  </a>
  
  <div class="px-6 pb-4">
    <div class="flex flex-wrap gap-2">
      {area && (
        <span class="inline-flex items-center px-3 py-1 text-base font-bold bg-red-600 text-white">
          {area}
        </span>
      )}
      {servicio && (
        <span class="inline-flex items-center px-3 py-1 text-base font-bold bg-gray-100 text-gray-700">
          {servicio}
        </span>
      )}
    </div>
  </div>
</article>

<style>
  .project-card {
    transition: border-color 160ms ease, background-color 160ms ease;
  }

  .project-card:hover {
    border-color: rgba(220, 38, 38, 0.28);
  }
</style>
