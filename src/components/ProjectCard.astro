---
interface Props {
  id: string;
  titulo: string;
  cliente: string;
  descripcion: string;
  fecha: string;
  area: string;
  servicio: string;
  imagen?: string;
  slug: string;
}

const { 
  id,
  titulo, 
  cliente, 
  descripcion, 
  fecha, 
  area, 
  servicio,
  imagen,
  slug 
} = Astro.props;

const defaultImage = 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1200&q=80';
const imageUrl = imagen || defaultImage;

// Formatear fecha
const formatDate = (dateString: string) => {
  if (!dateString) return '';
  try {
    const date = new Date(dateString);
    return date.toLocaleDateString('es-AR', {
      day: '2-digit',
      month: 'short',
      year: 'numeric'
    });
  } catch (e) {
    return dateString;
  }
};
---

<article class="bg-white rounded-xl shadow-md overflow-hidden hover:shadow-xl transition-shadow duration-300 flex flex-col h-full">
  <a href={`/antecedentes/${id}/${slug}`} class="block group h-full flex flex-col">
    <div class="relative overflow-hidden h-48 bg-gray-100">
      <img 
        src={imageUrl}
        alt={titulo}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        onError="this.src='/images/placeholder-project.jpg'"
      />
      <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-4">
        <span class="text-white font-medium">Ver detalles →</span>
      </div>
    </div>
    
    <div class="p-6 flex-1 flex flex-col">
      <div class="flex-1">
        <h3 class="text-xl font-bold text-gray-900 mb-2 line-clamp-2">{titulo}</h3>
        <p class="text-gray-600 mb-4 line-clamp-2">{descripcion}</p>
      </div>
      
      <div class="mt-4 pt-4 border-t border-gray-100">
        <div class="flex items-center text-sm text-gray-500 mb-2">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          <span>{formatDate(fecha)}</span>
        </div>
        <div class="flex items-center text-sm text-gray-500">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
          <span class="truncate">{cliente}</span>
        </div>
      </div>
    </div>
  </a>
  
  <div class="px-6 pb-4">
    <div class="flex flex-wrap gap-2">
      {area && (
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-blue-100 text-blue-800">
          {area}
        </span>
      )}
      {servicio && (
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-purple-100 text-purple-800">
          {servicio}
        </span>
      )}
    </div>
  </div>
</article>
