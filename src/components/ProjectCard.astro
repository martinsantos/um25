---
interface Props {
  id: string;
  titulo: string;
  cliente: string;
  descripcion: string;
  fecha: string;
  area: string;
  servicio: string;
  imagen?: string;
  slug: string;
}

const { 
  id,
  titulo, 
  cliente, 
  descripcion, 
  fecha, 
  area, 
  servicio,
  imagen,
  slug 
} = Astro.props;

const defaultImage = 'https://images.unsplash.com/photo-1451187580459-43490279c0fa?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=1200&q=80';
const imageUrl = imagen || defaultImage;

// Formatear fecha
const formatDate = (dateString: string) => {
  if (!dateString) return '';
  try {
    const date = new Date(dateString);
    return date.toLocaleDateString('es-AR', {
      day: '2-digit',
      month: 'short',
      year: 'numeric'
    });
  } catch (e) {
    return dateString;
  }
};

// Mapeo de colores por categoría/sector
const getCategoryColors = (category: string): { bg: string; text: string } => {
  const normalizedCategory = category?.toLowerCase().trim() || '';

  // Mapeo de colores basado en categorías
  const colorMap: Record<string, { bg: string; text: string }> = {
    // Gobierno y Sector Público
    'gobierno': { bg: 'bg-blue-100', text: 'text-blue-800' },
    'sector público': { bg: 'bg-blue-100', text: 'text-blue-800' },
    'municipal': { bg: 'bg-blue-100', text: 'text-blue-800' },
    'municipalidad': { bg: 'bg-blue-100', text: 'text-blue-800' },

    // Aeropuertos y Transporte
    'aeropuertos': { bg: 'bg-sky-100', text: 'text-sky-800' },
    'aeropuerto': { bg: 'bg-sky-100', text: 'text-sky-800' },
    'transporte': { bg: 'bg-sky-100', text: 'text-sky-800' },

    // Bodegas y Agricultura
    'bodegas': { bg: 'bg-purple-100', text: 'text-purple-800' },
    'bodega': { bg: 'bg-purple-100', text: 'text-purple-800' },
    'vitivinícola': { bg: 'bg-purple-100', text: 'text-purple-800' },
    'agroindustria': { bg: 'bg-purple-100', text: 'text-purple-800' },

    // Salud
    'salud': { bg: 'bg-green-100', text: 'text-green-800' },
    'hospital': { bg: 'bg-green-100', text: 'text-green-800' },
    'clínica': { bg: 'bg-green-100', text: 'text-green-800' },
    'médico': { bg: 'bg-green-100', text: 'text-green-800' },

    // Data Center y TI
    'data center': { bg: 'bg-orange-100', text: 'text-orange-800' },
    'datacenter': { bg: 'bg-orange-100', text: 'text-orange-800' },
    'infraestructura': { bg: 'bg-orange-100', text: 'text-orange-800' },
    'ti': { bg: 'bg-orange-100', text: 'text-orange-800' },

    // Construcción
    'construcción': { bg: 'bg-amber-100', text: 'text-amber-800' },
    'constructora': { bg: 'bg-amber-100', text: 'text-amber-800' },
    'obra': { bg: 'bg-amber-100', text: 'text-amber-800' },

    // Industria y Manufactura
    'industria': { bg: 'bg-indigo-100', text: 'text-indigo-800' },
    'industrial': { bg: 'bg-indigo-100', text: 'text-indigo-800' },
    'manufactura': { bg: 'bg-indigo-100', text: 'text-indigo-800' },
    'fábrica': { bg: 'bg-indigo-100', text: 'text-indigo-800' },

    // Software y Desarrollo
    'software': { bg: 'bg-cyan-100', text: 'text-cyan-800' },
    'desarrollo': { bg: 'bg-cyan-100', text: 'text-cyan-800' },
    'aplicación': { bg: 'bg-cyan-100', text: 'text-cyan-800' },

    // Minería
    'minería': { bg: 'bg-slate-100', text: 'text-slate-800' },
    'minera': { bg: 'bg-slate-100', text: 'text-slate-800' },
    'mining': { bg: 'bg-slate-100', text: 'text-slate-800' },

    // Seguridad
    'seguridad': { bg: 'bg-red-100', text: 'text-red-800' },
    'seguridad electrónica': { bg: 'bg-red-100', text: 'text-red-800' },
    'cctv': { bg: 'bg-red-100', text: 'text-red-800' },

    // Telecomunicaciones y Redes
    'telecomunicaciones': { bg: 'bg-teal-100', text: 'text-teal-800' },
    'redes': { bg: 'bg-teal-100', text: 'text-teal-800' },
    'redes y comunicaciones': { bg: 'bg-teal-100', text: 'text-teal-800' },
    'comunicaciones': { bg: 'bg-teal-100', text: 'text-teal-800' },
  };

  // Buscar coincidencia exacta o parcial
  for (const [key, colors] of Object.entries(colorMap)) {
    if (normalizedCategory.includes(key) || key.includes(normalizedCategory)) {
      return colors;
    }
  }

  // Color por defecto (azul) si no hay coincidencia
  return { bg: 'bg-blue-100', text: 'text-blue-800' };
};

const areaColors = getCategoryColors(area);
---

<article class="bg-white rounded-xl shadow-lg overflow-hidden hover:shadow-2xl hover:shadow-blue-500/25 transition-all duration-300 transform hover:-translate-y-2 hover:scale-[1.02] hover:ring-4 hover:ring-blue-300/50 flex flex-col h-full border-2 border-transparent hover:border-blue-400">
  <a href={`/antecedentes/${id}/${slug}`} class="block group h-full flex flex-col cursor-pointer">
    <div class="relative overflow-hidden h-48 bg-gray-100">
      <img 
        src={imageUrl}
        alt={titulo}
        loading="lazy"
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
        onError="this.src='/images/placeholder-project.jpg'"
      />
    </div>
    
    <div class="p-6 flex-1 flex flex-col">
      <div class="flex-1">
        <h3 class="text-xl font-black text-gray-900 mb-2 line-clamp-2 group-hover:text-blue-600 transition-colors">{titulo}</h3>
        <p class="text-gray-600 mb-4 line-clamp-2">{descripcion}</p>
      </div>
      
      <div class="mt-4 pt-4 border-t border-gray-100">
        <div class="flex items-center text-sm text-gray-500 mb-2">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
          </svg>
          <span>{formatDate(fecha)}</span>
        </div>
        <div class="flex items-center text-sm text-gray-500">
          <svg class="w-4 h-4 mr-2" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"></path>
          </svg>
          <span class="truncate">{cliente}</span>
        </div>
      </div>
    </div>
  </a>
  
  <div class="px-6 pb-4">
    <div class="flex flex-wrap gap-2">
      {area && (
        <span class={`inline-flex items-center px-3 py-1 rounded-full text-xs font-medium ${areaColors.bg} ${areaColors.text}`}>
          {area}
        </span>
      )}
      {servicio && (
        <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-gray-100 text-gray-700">
          {servicio}
        </span>
      )}
    </div>
  </div>
</article>
