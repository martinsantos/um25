---
interface Props {
  id: string;
  titulo: string;
  cliente: string;
  descripcion: string;
  fecha: string;
  area: string;
  servicio: string;
  imagen?: string;
  slug: string;
}

const {
  id,
  titulo,
  cliente,
  descripcion,
  fecha,
  area,
  servicio,
  imagen,
  slug
} = Astro.props;

if (!imagen) {
  console.error(`[ProjectCard] Missing image for: ${titulo} (ID: ${id})`);
}
const imageUrl = imagen;

const formatDate = (dateString: string) => {
  if (!dateString) return '';
  try {
    const date = new Date(dateString);
    return date.toLocaleDateString('es-AR', {
      day: '2-digit',
      month: 'short',
      year: 'numeric'
    });
  } catch (e) {
    return dateString;
  }
};
---

<article class="group bg-white rounded-xl overflow-hidden shadow-soft hover:shadow-elevated transition-all duration-300 flex flex-col h-full">
  <a href={`/antecedentes/${id}/${slug}`} class="block h-full flex flex-col">
    <!-- Image -->
    <div class="relative overflow-hidden aspect-[4/3] bg-gray-100">
      {imageUrl ? (
        <img
          src={imageUrl}
          alt={titulo}
          loading="lazy"
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
          onerror="this.onerror=null;this.src='/images/default-background.jpg'"
        />
      ) : (
        <div class="w-full h-full flex items-center justify-center bg-gray-100 text-gray-400">
          <p class="text-sm">Imagen no disponible</p>
        </div>
      )}
    </div>

    <!-- Content -->
    <div class="p-5 sm:p-6 flex-1 flex flex-col">
      {/* Tags */}
      <div class="flex flex-wrap gap-2 mb-3">
        {area && (
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-600">
            {area}
          </span>
        )}
        {servicio && (
          <span class="inline-flex items-center px-2.5 py-0.5 rounded-full text-xs font-medium bg-gray-100 text-gray-500">
            {servicio}
          </span>
        )}
      </div>

      <h3 class="text-base sm:text-lg font-semibold text-gray-900 mb-2 line-clamp-2 group-hover:text-um-primary transition-colors leading-snug">
        {titulo}
      </h3>
      <p class="text-sm text-gray-500 mb-4 line-clamp-2 leading-relaxed">{descripcion}</p>

      {/* Meta */}
      <div class="mt-auto pt-4 border-t border-gray-100 flex items-center justify-between">
        <span class="text-xs text-gray-400 font-mono uppercase tracking-wider" style="font-family:'JetBrains Mono',monospace;">
          {cliente ? cliente.substring(0, 25) : ''}
        </span>
        <span class="text-um-primary text-xs font-medium flex items-center gap-1 group-hover:gap-2 transition-all">
          Ver proyecto
          <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </span>
      </div>
    </div>
  </a>
</article>

<style>
  @media (prefers-reduced-motion: reduce) {
    article, img {
      transition-duration: 0.01ms !important;
    }
  }
</style>
