---
// FormularioARCA.astro - Formulario interactivo de 2 secciones para Plantilla ARCA
// - Sección 1: Datos de la Empresa (CUIT, Razón Social, Domicilio, Condición IVA)
// - Sección 2: Datos de la Factura (Tipo, Fecha, Descripción, Importe)
// - Emite evento 'formDataChange' cuando cambian los datos
// - Responsivo: 2 columnas en desktop, 1 en mobile (Tailwind CSS)

interface Props {
  id?: string;
  onDataChange?: (data: Record<string, any>) => void;
}

const { id = 'formulario-arca' } = Astro.props;
---

<form {id} class="grid md:grid-cols-2 gap-6 max-w-4xl mx-auto p-6">
  <!-- Sección 1: Mi Empresa -->
  <fieldset class="md:col-span-2">
    <legend class="text-xl font-bold mb-4 text-gray-900">Mi Empresa</legend>

    <div class="grid md:grid-cols-2 gap-4">
      <div class="form-group">
        <label for="cuit" class="block text-sm font-medium text-gray-700 mb-1">
          CUIT
        </label>
        <input
          id="cuit"
          type="text"
          name="cuit"
          pattern="[0-9]{11}"
          placeholder="20123456789"
          required
          class="input-field w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
        />
        <small class="text-gray-500">Ingrese 11 dígitos sin guiones</small>
      </div>

      <div class="form-group">
        <label for="razon_social" class="block text-sm font-medium text-gray-700 mb-1">
          Razón Social
        </label>
        <input
          id="razon_social"
          type="text"
          name="razon_social"
          placeholder="Mi Empresa S.A."
          required
          class="input-field w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
        />
      </div>

      <div class="form-group md:col-span-2">
        <label for="domicilio" class="block text-sm font-medium text-gray-700 mb-1">
          Domicilio
        </label>
        <input
          id="domicilio"
          type="text"
          name="domicilio"
          placeholder="Av. Corrientes 1234, CABA"
          required
          class="input-field w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
        />
      </div>

      <div class="form-group md:col-span-2">
        <label for="condicion_iva" class="block text-sm font-medium text-gray-700 mb-1">
          Condición frente al IVA
        </label>
        <select
          id="condicion_iva"
          name="condicion_iva"
          required
          class="input-field w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="">Seleccionar...</option>
          <option value="Responsable Inscripto">Responsable Inscripto</option>
          <option value="Monotributo">Monotributo</option>
          <option value="Exento">Exento</option>
          <option value="No Responsable">No Responsable</option>
        </select>
      </div>
    </div>
  </fieldset>

  <!-- Sección 2: Nueva Factura -->
  <fieldset class="md:col-span-2">
    <legend class="text-xl font-bold mb-4 text-gray-900">Nueva Factura</legend>

    <div class="grid md:grid-cols-2 gap-4">
      <div class="form-group">
        <label for="tipo_comprobante" class="block text-sm font-medium text-gray-700 mb-1">
          Tipo de Comprobante
        </label>
        <select
          id="tipo_comprobante"
          name="tipo_comprobante"
          required
          class="input-field w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
        >
          <option value="">Seleccionar...</option>
          <option value="Factura A">Factura A (Responsable)</option>
          <option value="Factura B">Factura B (Otros Responsables)</option>
          <option value="Factura C">Factura C (Consumidor Final)</option>
          <option value="Nota de Crédito A">Nota de Crédito A</option>
          <option value="Nota de Débito A">Nota de Débito A</option>
        </select>
      </div>

      <div class="form-group">
        <label for="fecha_emision" class="block text-sm font-medium text-gray-700 mb-1">
          Fecha de Emisión
        </label>
        <input
          id="fecha_emision"
          type="date"
          name="fecha_emision"
          required
          class="input-field w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
        />
      </div>

      <div class="form-group md:col-span-2">
        <label for="descripcion" class="block text-sm font-medium text-gray-700 mb-1">
          Descripción del Comprobante
        </label>
        <input
          id="descripcion"
          type="text"
          name="descripcion"
          placeholder="Servicios de consultoría, productos vendidos, etc."
          required
          class="input-field w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
        />
      </div>

      <div class="form-group md:col-span-2">
        <label for="importe_total" class="block text-sm font-medium text-gray-700 mb-1">
          Importe Total (sin IVA)
        </label>
        <input
          id="importe_total"
          type="number"
          name="importe_total"
          placeholder="0.00"
          min="0"
          step="0.01"
          required
          class="input-field w-full px-4 py-2 border border-gray-300 rounded-md focus:ring-blue-500 focus:border-blue-500"
        />
      </div>
    </div>
  </fieldset>
</form>

<script is:inline>
  // Emitir evento formDataChange cuando cambien los datos del formulario
  const form = document.querySelector('#formulario-arca');

  if (form) {
    const handleChange = (event) => {
      const formData = new FormData(form);
      const data = Object.fromEntries(formData);

      // Emitir evento personalizado
      const customEvent = new CustomEvent('formDataChange', {
        detail: data,
        bubbles: true,
        cancelable: true,
      });

      form.dispatchEvent(customEvent);
    };

    // Escuchar cambios en todos los inputs y selects
    form.querySelectorAll('input, select').forEach((field) => {
      field.addEventListener('change', handleChange);
    });
  }
</script>

<style>
  .input-field {
    @apply transition-colors duration-200;
  }

  .input-field:focus {
    @apply outline-none ring-2 ring-blue-500 border-blue-500;
  }

  fieldset {
    @apply border border-gray-200 rounded-lg p-4 mb-4;
  }

  legend {
    @apply px-2 ml-2;
  }
</style>
