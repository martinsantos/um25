---
/**
 * Despiece de una escena: un solo escenario con el recorrido del servicio activo y la lista
 * de los ocho frentes, cada uno con la isometría de sus elementos (render Blender propio,
 * `/cine/servicios/{código}-x.webp`). Pasar el puntero (escritorio) o tocar (teléfono) un
 * servicio reproduce su recorrido en el escenario. Nunca un video ni una captura por ítem.
 */
import { SCENE_TITLES, sceneServiceCuts, type Scene } from '../../data/cine/scenes';
import { NAV_SERVICES } from '../../data/navigation';

interface Props { scene: Scene; sectorName?: string }
const { scene, sectorName } = Astro.props;
const cuts = sceneServiceCuts(scene);
const byCode = new Map(NAV_SERVICES.map((s) => [s.code, s]));
const title = SCENE_TITLES[scene];
// Isometría de los elementos del servicio; Redes sólo tiene la vista entera.
const iso = (code: string) => (code === '101' ? '/cine/servicios/101.webp' : `/cine/servicios/${code}-x.webp`);
const first = cuts[0];
---
{first && (
  <section class="um-desp" aria-labelledby="um-desp-title" data-despiece>
    <div class="um-desp__head">
      <h2 id="um-desp-title">{cuts.length === 8 ? 'Los ocho frentes' : `${cuts.length} frentes`} en {title.toLowerCase()}.</h2>
      <p>La misma instalación{sectorName ? ` de ${sectorName.toLowerCase()}` : ''}, sistema por sistema. Pasá por un servicio para ver su recorrido.</p>
    </div>
    <div class="um-desp__body">
      <div class="um-desp__stage">
        <video muted loop playsinline preload="metadata" src={first.video} aria-hidden="true"></video>
        <p class="um-desp__now" aria-live="polite">{byCode.get(first.code)?.name || first.service}</p>
      </div>
      <ul class="um-desp__list">
        {cuts.map((cut, i) => {
          const svc = byCode.get(cut.code);
          return (
            <li>
              <a class:list={['um-desp__item', { 'is-on': i === 0 }]} href={svc?.href || '/servicios'} data-cut={cut.video} data-name={svc?.name || cut.service}>
                <img src={iso(cut.code)} alt="" width="240" height="180" loading="lazy" decoding="async" />
                <span class="um-desp__text"><strong>{svc?.name || cut.service}</strong><small>{svc?.text}</small></span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  </section>
)}

<script>
  const bootDespiece = () => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches || Boolean((navigator as any).connection?.saveData);
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    document.querySelectorAll<HTMLElement>('[data-despiece]:not([data-bound])').forEach((root) => {
      root.dataset.bound = 'true';
      const video = root.querySelector<HTMLVideoElement>('.um-desp__stage video')!;
      const now = root.querySelector<HTMLElement>('.um-desp__now')!;
      const items = [...root.querySelectorAll<HTMLAnchorElement>('[data-cut]')];
      let visible = false, current = items[0] || null;
      const sync = () => { if (visible && !reduce && !document.hidden) video.play().catch(() => {}); else video.pause(); };
      const show = (item: HTMLAnchorElement) => {
        current = item;
        items.forEach((i) => i.classList.toggle('is-on', i === item));
        now.textContent = item.dataset.name || '';
        const src = item.dataset.cut || '';
        if (src && !video.src.endsWith(src)) { video.src = src; }
        sync();
      };
      items.forEach((item) => {
        if (fine) {
          item.addEventListener('pointerenter', () => show(item));
          item.addEventListener('focus', () => show(item));
        } else {
          // Táctil: el primer toque muestra el recorrido, el segundo navega.
          item.addEventListener('click', (event) => { if (current !== item) { event.preventDefault(); show(item); } });
        }
      });
      new IntersectionObserver(([e]) => { visible = e.isIntersecting; sync(); }, { threshold: .2 }).observe(root);
      document.addEventListener('visibilitychange', sync);
    });
  };
  bootDespiece();
  document.addEventListener('astro:page-load', bootDespiece);
</script>

<style>
  .um-desp { width: min(var(--um-container-wide), calc(100% - (var(--um-page-gutter) * 2))); margin: 0 auto; padding: clamp(48px, 7vw, 96px) 0 0; color: #fff; }
  .um-desp__head { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 16px clamp(28px, 5vw, 80px); align-items: end; margin-bottom: 28px; }
  .um-desp h2 { margin: 0; font-size: clamp(1.9rem, 3vw, 2.6rem) !important; line-height: 1.08 !important; font-weight: 600 !important; text-wrap: balance; }
  .um-desp__head > p { margin: 0; color: rgba(255, 255, 255, 0.78); font-size: 1.0625rem; line-height: 1.6; max-width: 52ch; }
  .um-desp__body { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(20px, 3vw, 40px); align-items: start; }
  .um-desp__stage { position: sticky; top: 88px; aspect-ratio: 16 / 10; overflow: hidden; background: #0a0b0d; }
  .um-desp__stage video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; }
  .um-desp__now { position: absolute; left: 20px; bottom: 16px; margin: 0; font-size: 1rem; color: rgba(255, 255, 255, 0.85); text-shadow: 0 1px 8px rgba(0, 0, 0, 0.6); }
  .um-desp__list { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 clamp(12px, 2vw, 24px); }
  .um-desp__item { display: grid; grid-template-columns: 88px minmax(0, 1fr); gap: 14px; align-items: center; padding: 12px 0; border-top: 1px solid rgba(255, 255, 255, 0.12); color: rgba(255, 255, 255, 0.72); text-decoration: none; transition: color 0.3s ease; }
  .um-desp__item img { width: 88px; aspect-ratio: 4 / 3; height: auto; object-fit: contain; background: #0a0b0d; border-radius: 2px; }
  .um-desp__item.is-on, .um-desp__item:hover, .um-desp__item:focus-visible { color: #fff; }
  .um-desp__item.is-on strong { border-bottom: 2px solid #dc2626; }
  .um-desp__item:focus-visible { outline: 2px solid #dc2626; outline-offset: 2px; }
  .um-desp__text strong { display: inline-block; font-size: 1.0625rem; font-weight: 600; padding-bottom: 2px; }
  .um-desp__text small { display: block; margin-top: 3px; font-size: 1rem; line-height: 1.4; color: #a1a1aa; }
  @media (max-width: 1100px) { .um-desp__list { grid-template-columns: 1fr; } }
  @media (max-width: 820px) {
    .um-desp__head { grid-template-columns: 1fr; }
    .um-desp__body { grid-template-columns: 1fr; }
    .um-desp__stage { position: sticky; top: 63px; z-index: 1; }
    .um-desp__list { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 12px; }
    .um-desp__item { grid-template-columns: 64px minmax(0, 1fr); gap: 10px; }
    .um-desp__item img { width: 64px; }
    .um-desp__text strong { font-size: 1rem; line-height: 1.25; overflow-wrap: anywhere; hyphens: auto; }
    .um-desp__text small { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .um-desp__stage video { display: none; } }
</style>
