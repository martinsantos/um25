---
/**
 * Despiece de la escena: debajo del banner, UN escenario con la isometría de los elementos del
 * servicio activo (render Blender propio: armado → explotado) y la lista de los ocho frentes.
 * Pasar el puntero (escritorio) o tocar (teléfono) un servicio lo activa: el escenario muestra
 * sus elementos despiezados y el banner de arriba corta al recorrido de ese servicio en la
 * misma escena. Nunca un video ni una captura por ítem.
 */
import { SCENE_TITLES, sceneServiceCuts, type Scene } from '../../data/cine/scenes';
import { NAV_SERVICES } from '../../data/navigation';
import { RENDERS } from '../../data/renders';

interface Props { scene: Scene; sectorName?: string }
const { scene, sectorName } = Astro.props;
const cuts = sceneServiceCuts(scene);
const byCode = new Map(NAV_SERVICES.map((s) => [s.code, s]));
const title = SCENE_TITLES[scene];
const items = cuts.map((cut) => {
  const svc = byCode.get(cut.code);
  const render = RENDERS[`servicio-${cut.code}`];
  return { cut, svc, render, parts: (render?.labels ?? []).slice(0, 3) };
}).filter((i) => i.render);
const first = items[0];
---
{first && (
  <section class="um-desp" aria-labelledby="um-desp-title" data-despiece>
    <div class="um-desp__head">
      <h2 id="um-desp-title">{items.length === 8 ? 'Los ocho frentes' : `${items.length} frentes`} en {title.toLowerCase()}.</h2>
      <p>La misma instalación{sectorName ? ` de ${sectorName.toLowerCase()}` : ''}, sistema por sistema. Pasá por un servicio: sus elementos se despiezan y el recorrido de arriba cambia de plano.</p>
    </div>
    <div class="um-desp__body">
      <div class="um-desp__stage">
        {items.map(({ cut, render }, i) => (
          <div class:list={['um-desp__layer', { 'is-on': i === 0 }]} data-layer={cut.code} style={`--rs-aspect:${render.aspect}`}>
            <img class="um-desp__poster" src={render.poster} alt={render.alt} width={render.posterWidth} height={render.posterHeight} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />
            {render.exploded && <img class="um-desp__exploded" src={render.exploded} alt="" width={render.posterWidth} height={render.posterHeight} loading="lazy" decoding="async" />}
          </div>
        ))}
        <p class="um-desp__now" aria-live="polite">{first.svc?.name || first.cut.service}</p>
      </div>
      <ol class="um-desp__list">
        {items.map(({ cut, svc, parts }, i) => (
          <li>
            <a class:list={['um-desp__item', { 'is-on': i === 0 }]} href={svc?.href || '/servicios'} data-code={cut.code} data-cut={cut.key} data-name={svc?.name || cut.service}>
              <strong>{svc?.name || cut.service}</strong>
              <span>{parts.map((p) => p.text).join(' · ') || svc?.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<script>
  const bootDespiece = () => {
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    document.querySelectorAll<HTMLElement>('[data-despiece]:not([data-bound])').forEach((root) => {
      root.dataset.bound = 'true';
      const layers = [...root.querySelectorAll<HTMLElement>('[data-layer]')];
      const now = root.querySelector<HTMLElement>('.um-desp__now')!;
      const items = [...root.querySelectorAll<HTMLAnchorElement>('[data-code]')];
      const banner = document.querySelector<HTMLElement>('[data-umc]');
      let current = items[0] || null, timer: ReturnType<typeof setTimeout> | undefined;
      const show = (item: HTMLAnchorElement) => {
        if (current === item) return;
        current = item;
        items.forEach((i) => i.classList.toggle('is-on', i === item));
        layers.forEach((l) => { const on = l.dataset.layer === item.dataset.code; l.classList.toggle('is-on', on); if (on) l.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => { img.loading = 'eager'; }); });
        now.textContent = item.dataset.name || '';
        // El banner corta al recorrido de este servicio en la escena (si lo tiene renderizado).
        clearTimeout(timer);
        timer = setTimeout(() => banner?.dispatchEvent(new CustomEvent('umc:cut', { detail: item.dataset.cut })), 350);
      };
      items.forEach((item) => {
        if (fine) {
          item.addEventListener('pointerenter', () => show(item));
          item.addEventListener('focus', () => show(item));
        } else {
          // Táctil: el primer toque activa, el segundo navega.
          item.addEventListener('click', (event) => { if (current !== item) { event.preventDefault(); show(item); } });
        }
      });
    });
  };
  bootDespiece();
  document.addEventListener('astro:page-load', bootDespiece);
</script>

<style>
  .um-desp { width: min(var(--um-container-wide), calc(100% - (var(--um-page-gutter) * 2))); margin: 0 auto; padding: clamp(48px, 7vw, 96px) 0 0; color: #fff; }
  .um-desp__head { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 16px clamp(28px, 5vw, 80px); align-items: end; margin-bottom: 28px; }
  .um-desp h2 { margin: 0; font-size: clamp(1.9rem, 3vw, 2.6rem) !important; line-height: 1.08 !important; font-weight: 600 !important; text-wrap: balance; }
  .um-desp__head > p { margin: 0; color: rgba(255, 255, 255, 0.78); font-size: 1.0625rem; line-height: 1.6; max-width: 52ch; }
  .um-desp__body { display: grid; grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(20px, 3vw, 48px); align-items: start; }
  .um-desp__stage { position: sticky; top: 88px; aspect-ratio: 4 / 3; overflow: hidden; background: #0a0b0d; }
  .um-desp__layer { position: absolute; inset: 0; opacity: 0; transition: opacity 0.5s ease; }
  .um-desp__layer.is-on { opacity: 1; }
  .um-desp__layer img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; display: block; }
  /* Despiece: el armado se funde en el explotado al activarse. */
  .um-desp__exploded { opacity: 0; transition: opacity 0.6s ease 0.25s; }
  .um-desp__layer.is-on .um-desp__exploded { opacity: 1; }
  .um-desp__now { position: absolute; left: 20px; bottom: 16px; margin: 0; font-size: 1rem; color: rgba(255, 255, 255, 0.85); }
  .um-desp__list { list-style: none; margin: 0; padding: 0; }
  .um-desp__item { display: block; padding: 16px 0; border-top: 1px solid rgba(255, 255, 255, 0.12); color: rgba(255, 255, 255, 0.62); text-decoration: none; transition: color 0.3s ease; }
  .um-desp__list li:last-child .um-desp__item { border-bottom: 1px solid rgba(255, 255, 255, 0.12); }
  .um-desp__item.is-on, .um-desp__item:hover, .um-desp__item:focus-visible { color: #fff; }
  .um-desp__item:focus-visible { outline: 2px solid #dc2626; outline-offset: 2px; }
  .um-desp__item strong { display: inline-block; font-size: 1.25rem; font-weight: 600; letter-spacing: -0.01em; padding-bottom: 2px; border-bottom: 2px solid transparent; transition: border-color 0.3s ease; }
  .um-desp__item.is-on strong { border-bottom-color: #dc2626; }
  .um-desp__item span { display: block; margin-top: 4px; font-size: 1rem; line-height: 1.45; color: #a1a1aa; }
  @media (max-width: 820px) {
    .um-desp__head { grid-template-columns: 1fr; }
    .um-desp__body { grid-template-columns: 1fr; }
    .um-desp__stage { position: sticky; top: 63px; z-index: 1; }
    .um-desp__item { padding: 12px 0; }
    .um-desp__item strong { font-size: 1.125rem; }
    .um-desp__item span { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .um-desp__layer, .um-desp__exploded { transition: none; } }
</style>
