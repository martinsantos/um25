---
/**
 * Rail de recorridos v4 de una escena: un plano por frente de servicio,
 * renderizado en la nube. Poster estable; el recorrido se reproduce al pasar
 * el puntero (escritorio) o al tocar (teléfono), un video a la vez.
 */
import { SCENE_TITLES, sceneServiceCuts, type Scene } from '../../data/cine/scenes';
import { NAV_SERVICES } from '../../data/navigation';

interface Props { scene: Scene; sectorName?: string }
const { scene, sectorName } = Astro.props;
const cuts = sceneServiceCuts(scene);
const byCode = new Map(NAV_SERVICES.map((s) => [s.code, s]));
const title = SCENE_TITLES[scene];
---
{cuts.length > 0 && (
  <section class="um-cuts" aria-labelledby="um-cuts-title" data-scene-rail>
    <div class="um-cuts__head">
      <div>
        <p class="um-cuts__kicker"><span></span>Recorridos por servicio</p>
        <h2 id="um-cuts-title">{cuts.length === 8 ? 'Los ocho frentes' : `${cuts.length} frentes`} en {title.toLowerCase()}.</h2>
      </div>
      <p>Cada plano recorre la misma instalación{sectorName ? ` de ${sectorName.toLowerCase()}` : ''} siguiendo un sistema. Pasá el puntero o tocá para verlo; el detalle del servicio tiene el recorrido completo.</p>
    </div>
    <ul class="um-cuts__grid">
      {cuts.map((cut) => {
        const svc = byCode.get(cut.code);
        return (
          <li>
            <a class="um-cuts__item" href={svc?.href || '/servicios'} data-cut>
              <span class="um-cuts__media">
                <img src={cut.poster} alt="" width="1920" height="1080" loading="lazy" decoding="async" />
                <video muted loop playsinline preload="none" data-src={cut.video} aria-hidden="true"></video>
                <span class="um-cuts__code">{cut.code}</span>
                <span class="um-cuts__tag">Render v4</span>
              </span>
              <span class="um-cuts__body">
                <strong>{svc?.name || cut.service}</strong>
                <span>{svc?.text}</span>
              </span>
            </a>
          </li>
        );
      })}
    </ul>
  </section>
)}

<script>
  const bootCuts = () => {
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches || Boolean((navigator as any).connection?.saveData);
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    document.querySelectorAll<HTMLElement>('[data-scene-rail]:not([data-bound])').forEach((rail) => {
      rail.dataset.bound = 'true';
      const items = [...rail.querySelectorAll<HTMLAnchorElement>('[data-cut]')];
      let playing: HTMLVideoElement | null = null;
      const stop = () => { if (playing) { playing.pause(); playing.closest('[data-cut]')?.classList.remove('is-playing'); playing = null; } };
      const start = (item: HTMLAnchorElement) => {
        if (reduce) return;
        const video = item.querySelector<HTMLVideoElement>('video');
        if (!video) return;
        if (playing === video) return;
        stop();
        if (!video.src && video.dataset.src) video.src = video.dataset.src;
        video.play().then(() => { item.classList.add('is-playing'); playing = video; }).catch(() => {});
      };
      items.forEach((item) => {
        if (fine) {
          item.addEventListener('pointerenter', () => start(item));
          item.addEventListener('pointerleave', stop);
          item.addEventListener('focus', () => start(item));
          item.addEventListener('blur', stop);
        } else {
          // Táctil: el primer toque reproduce, el segundo navega.
          item.addEventListener('click', (event) => {
            const video = item.querySelector<HTMLVideoElement>('video');
            if (video && playing !== video && !reduce) { event.preventDefault(); start(item); }
          });
        }
      });
      document.addEventListener('visibilitychange', () => { if (document.hidden) stop(); });
    });
  };
  bootCuts();
  document.addEventListener('astro:page-load', bootCuts);
</script>

<style>
  .um-cuts {
    width: min(var(--um-container-wide), calc(100% - (var(--um-page-gutter) * 2)));
    margin: 0 auto;
    padding: clamp(48px, 7vw, 96px) 0 0;
    color: #fff;
  }

  .um-cuts__head {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: 20px clamp(28px, 5vw, 80px);
    align-items: end;
    margin-bottom: 28px;
  }

  .um-cuts__kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 14px;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: rgba(255, 255, 255, 0.78);
  }

  .um-cuts__kicker span {
    width: 28px;
    height: 2px;
    background: #dc2626;
  }

  .um-cuts h2 {
    margin: 0;
    font-size: clamp(1.9rem, 3vw, 2.6rem) !important;
    line-height: 1.08 !important;
    font-weight: 600 !important;
    text-wrap: balance;
  }

  .um-cuts__head > p {
    margin: 0;
    color: rgba(255, 255, 255, 0.78);
    font-size: 1.0625rem;
    line-height: 1.6;
    max-width: 52ch;
  }

  .um-cuts__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: rgba(255, 255, 255, 0.12);
    border: 1px solid rgba(255, 255, 255, 0.12);
  }

  .um-cuts__item {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: #101113;
    color: #fff;
    text-decoration: none;
    transition: background-color 0.3s ease;
  }

  .um-cuts__item:hover,
  .um-cuts__item:focus-visible {
    background: #15171a;
  }

  .um-cuts__item:focus-visible {
    outline: 2px solid #dc2626;
    outline-offset: -2px;
  }

  .um-cuts__media {
    position: relative;
    display: block;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #0a0a0b;
  }

  .um-cuts__media img,
  .um-cuts__media video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .um-cuts__media video {
    opacity: 0;
    transition: opacity 0.5s ease;
  }

  .um-cuts__item.is-playing .um-cuts__media video {
    opacity: 1;
  }

  .um-cuts__code {
    position: absolute;
    left: 10px;
    top: 10px;
    padding: 3px 7px;
    background: rgba(16, 17, 19, 0.85);
    color: #fff;
    font-family: var(--um-font-mono);
    font-size: 1rem;
    line-height: 1.2;
  }

  .um-cuts__tag {
    position: absolute;
    right: 10px;
    bottom: 10px;
    padding: 3px 7px;
    background: rgba(16, 17, 19, 0.85);
    color: #a1a1aa;
    font-family: var(--um-font-mono);
    font-size: 1rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .um-cuts__body {
    display: block;
    padding: 14px 16px 18px;
    border-top: 2px solid transparent;
    transition: border-color 0.3s ease;
  }

  .um-cuts__item:hover .um-cuts__body,
  .um-cuts__item:focus-visible .um-cuts__body {
    border-top-color: #dc2626;
  }

  .um-cuts__body strong {
    display: block;
    font-size: 1.0625rem;
    font-weight: 600;
  }

  .um-cuts__body span {
    display: block;
    margin-top: 4px;
    color: #a1a1aa;
    font-size: 1rem;
    line-height: 1.45;
  }

  @media (max-width: 1100px) {
    .um-cuts__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 820px) {
    .um-cuts__head {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 560px) {
    .um-cuts__grid {
      grid-template-columns: 1fr;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .um-cuts__media video {
      display: none;
    }
  }
</style>
