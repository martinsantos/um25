---
// Real-time isometric explainer for a sector. three.js and the scene load only
// when the section approaches the viewport; until then the frame keeps its size.
interface Props {sector:string;eyebrow:string}
const {sector,eyebrow}=Astro.props;
---
<section class="iso3d" data-iso3d={sector} aria-label={`${eyebrow}: cómo se conectan energía, datos, seguridad y detección`}>
  <div class="iso3d__stage">
    <div class="iso3d__canvas" data-iso-canvas></div>
    <div class="iso3d__tags" data-iso-tags aria-hidden="true"></div>
    <div class="iso3d__cap" data-iso-caption aria-live="polite">
      <small><i></i>{eyebrow}</small>
      <h3></h3>
      <p></p>
    </div>
    <div class="iso3d__legend" aria-hidden="true">
      <span data-iso-layer="en" style="--c:#E2B04A"><b></b>Energía</span>
      <span data-iso-layer="da" style="--c:#3FC7B8"><b></b>Datos</span>
      <span data-iso-layer="se" style="--c:#8B7CF6"><b></b>Seguridad</span>
      <span data-iso-layer="de" style="--c:#F07A5A"><b></b>Detección</span>
    </div>
    <div class="iso3d__bar"><div class="iso3d__steps" data-iso-steps></div><button type="button" data-iso-play aria-label="Pausar recorrido">❚❚</button></div>
  </div>
</section>

<style>
  .iso3d{width:min(var(--um-container-wide),calc(100% - (var(--um-page-gutter) * 2)));margin:clamp(24px,4vw,56px) auto}
  .iso3d__stage{position:relative;aspect-ratio:16/9;max-height:860px;overflow:hidden;border:1px solid rgba(255,255,255,.08);background:radial-gradient(120% 90% at 50% 40%,#151a21 0%,#0b0e12 55%,#07080a 100%);color:#fff;font-family:var(--um-font-body,'UM Sans',Arial,sans-serif)}
  .iso3d__canvas,.iso3d__tags{position:absolute;inset:0}
  .iso3d__canvas :global(canvas){display:block;width:100%;height:100%}
  .iso3d__tags{pointer-events:none}
  .iso3d__cap{position:absolute;left:clamp(16px,2.4vw,32px);top:clamp(16px,2.4vw,32px);max-width:min(360px,calc(100% - 32px));pointer-events:none}
  .iso3d__cap small{display:flex;align-items:center;gap:10px;font-size:12px;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.6)}
  .iso3d__cap small i{width:28px;height:2px;background:#DC2626}
  .iso3d__cap h3{margin:12px 0 0;font-weight:700;font-size:clamp(22px,2.4vw,34px);line-height:1.1;letter-spacing:-.01em;min-height:1.1em}
  .iso3d__cap p{margin:10px 0 0;font-size:clamp(14px,1.05vw,17px);line-height:1.55;color:rgba(255,255,255,.72)}
  .iso3d__cap h3,.iso3d__cap p{transition:opacity .5s ease,transform .6s cubic-bezier(.2,.7,.1,1)}
  .iso3d__cap:global(.is-out) h3,.iso3d__cap:global(.is-out) p{opacity:0;transform:translateY(6px)}
  .iso3d__legend{position:absolute;left:clamp(16px,2.4vw,32px);bottom:clamp(16px,2.4vw,28px);display:flex;flex-wrap:wrap;gap:6px 18px;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:rgba(255,255,255,.5)}
  .iso3d__legend span{display:flex;align-items:center;gap:8px;transition:color .4s}
  .iso3d__legend b{width:8px;height:8px;border-radius:50%;background:var(--c)}
  .iso3d__legend span:global(.is-on){color:#fff}
  .iso3d__bar{position:absolute;right:clamp(16px,2.4vw,32px);bottom:clamp(16px,2.4vw,28px);display:flex;align-items:center;gap:14px}
  .iso3d__steps{display:flex;gap:6px}
  .iso3d__steps :global(i){width:22px;height:2px;background:rgba(255,255,255,.2);position:relative;overflow:hidden}
  .iso3d__steps :global(i)::after{content:'';position:absolute;inset:0;background:#fff;transform:scaleX(var(--p,0));transform-origin:left}
  .iso3d__bar button{width:40px;height:40px;border:1px solid rgba(255,255,255,.24);background:rgba(7,8,10,.5);color:#fff;cursor:pointer;display:grid;place-items:center;font-size:12px}
  .iso3d__bar button:focus-visible{outline:2px solid #DC2626;outline-offset:2px}
  .iso3d__tags :global(.iso3d__tag){position:absolute;transform:translate(10px,-50%);display:flex;align-items:center;gap:8px;padding:6px 10px 6px 8px;background:rgba(7,8,10,.82);border:1px solid rgba(255,255,255,.12);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;white-space:nowrap;opacity:0;transition:opacity .5s}
  .iso3d__tags :global(.iso3d__tag)::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--c,#fff)}
  .iso3d__tags :global(.iso3d__tag.is-on){opacity:.95}
  @media (max-width:760px){
    .iso3d__stage{aspect-ratio:auto;height:auto;max-height:none;display:flex;flex-direction:column}
    .iso3d__cap{position:relative;left:auto;top:auto;max-width:none;padding:20px 16px 0;order:-1}
    .iso3d__canvas{position:relative;inset:auto;width:100%;aspect-ratio:1/1}
    .iso3d__legend{position:static;padding:4px 16px 0}
    .iso3d__bar{position:static;padding:14px 16px 16px;justify-content:flex-end}
    .iso3d__tags :global(.iso3d__tag){font-size:10px}
  }
</style>

<script>
  function boot(){
    for(const host of document.querySelectorAll<HTMLElement>('[data-iso3d]')){
      if(host.dataset.isoBound)continue;host.dataset.isoBound='1';
      const io=new IntersectionObserver(async entries=>{
        if(!entries.some(e=>e.isIntersecting))return;io.disconnect();
        const [{mountIso},{SECTORS}]=await Promise.all([import('../../scripts/iso3d/engine.js'),import('../../scripts/iso3d/sectors.js')]);
        const build=(SECTORS as Record<string,any>)[host.dataset.iso3d||''];if(!build)return;
        const dispose=mountIso(host,build);
        document.addEventListener('astro:before-swap',()=>dispose(),{once:true});
      },{rootMargin:'600px 0px'});
      io.observe(host);
    }
  }
  boot();document.addEventListener('astro:page-load',boot);
</script>
