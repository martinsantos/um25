---
// What follows the sector film: the record of work in the same palette, stated in
// text (client, work, year), and one way forward. No illustrations posing as site photos.
import { SECTOR_STORIES } from '../../data/cine/sectorStories';
import { generateSlug } from '../../utils/slugUtils.js';
import antecedentesSnapshot from '../../data/snapshots/antecedentes.json';
// The CMS sector tag is loose (it files municipalities under construction, for example),
// so the list reads each case's own client, title and description.
const SECTOR_TEXT: Record<string, RegExp> = {
  salud: /hospital|cl[ií]nic|sanatorio|fuesmen|medicina|salud mental|caps\b/i,
  constructoras: /torre|edificio|consorcio|fideicomiso|constructora|desarrolladora/i,
  aeropuertos: /aeropuert|aa2000|aeroparque|terminal a[eé]rea/i,
  industria: /industr|planta(?! baja)|f[aá]brica|premix|frigor[ií]fico|metal[uú]rg/i,
  bodegas: /bodega|vi[nñ]edo|vitivin|\bvinos?\b/i,
  mineria: /miner|\bmina\b|yacimiento|campamento|radioenlace|enlace punto a punto/i,
};
interface Props { sector: string; antecedentesHref: string }
const { sector, antecedentesHref } = Astro.props;
const records: any[] = Array.isArray(antecedentesSnapshot) ? antecedentesSnapshot : (antecedentesSnapshot as any).data || [];
const match = SECTOR_TEXT[sector];
const EXCLUDE: Record<string, RegExp> = { industria: /c[aá]mara de comercio|evento|bodega/i };
const cases = match ? records.filter((r) => { const text = [r.Cliente, r.Titulo, r.Descripcion].join(' '); return match.test(text) && !EXCLUDE[sector]?.test(text); }).sort((a, b) => String(b.Fecha || '').localeCompare(String(a.Fecha || ''))) : [];
const caseHref = (r: any) => `/antecedentes/${r.id}/${generateSlug(r.Titulo || '')}`;
const story = SECTOR_STORIES[sector];
const clean = (v: unknown) => String(v || '').replace(/\s+/g, ' ').replace(/\s*-\s*$/, '').trim();
const titleCase = (v: string) => (v === v.toUpperCase() ? v.toLowerCase().replace(/(^|\s|\()(\p{L})/gu, (_, a, b) => a + b.toUpperCase()) : v);
// The archive often repeats the client inside the title; keep the work, drop the echo.
const work = (item: any) => {
  const client = clean(item.Cliente);
  let t = clean(item.Titulo).split(' - ')[0];
  if (client) t = t.replace(new RegExp(client.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'), 'ig'), '').replace(/\s{2,}/g, ' ').replace(/[\s:–-]+$/, '').trim();
  t = t.replace(/\s+(para|de|del|en|y|a)$/i, '').replace(/\bSiste?na\b|\bSitema\b/g, 'Sistema').replace(/\bremplazo\b/gi, 'reemplazo').replace(/\bdebiles\b/g, 'débiles').replace(/\binformatica\b/g, 'informática');
  t = t || clean(item.Titulo);
  return t.charAt(0).toUpperCase() + t.slice(1);
};
const seen = new Set<string>();
const rows = cases
  .map((item) => ({ client: titleCase(clean(item.Cliente) || 'Cliente reservado'), work: work(item), year: String(item.Fecha || '').slice(0, 4), href: caseHref(item) }))
  // Skip rows that say nothing on their own or belong to another sector's archive label.
  .filter((r) => { const k = `${r.client}|${r.work}`.toLowerCase(); if (seen.has(k) || r.work.length < 14 || /^adicional\b|sector p[uú]blico|actualizar presupuesto/i.test(r.work)) return false; seen.add(k); return true; })
  .slice(0, 6);
const total = story?.stats.find(([, l]) => /proyectos/i.test(l))?.[0];
---
{story && (
<section class="safter" aria-labelledby="safter-title">
  <div class="safter__shell">
    <header class="safter__head">
      <p class="safter__kicker"><b></b>Antecedentes</p>
      <h2 id="safter-title">Lo que ya instalamos en {story.label.toLowerCase()}.</h2>
      <a href={antecedentesHref}>{total ? `Ver los ${total} proyectos` : 'Ver todos los proyectos'} <span aria-hidden="true">→</span></a>
    </header>
    {rows.length > 0 && (
      <ol class="safter__list">
        {rows.map((r) => (
          <li><a href={r.href}><span class="safter__client">{r.client}</span><span class="safter__work">{r.work}</span><span class="safter__year">{r.year}</span><span class="safter__go" aria-hidden="true">→</span></a></li>
        ))}
      </ol>
    )}
    <div class="safter__close">
      <h2>Contanos cómo es tu operación.</h2>
      <p>Hacemos un relevamiento técnico y te proponemos el alcance, con casos comparables del sector.</p>
      <a class="safter__cta" href="/contacto">Solicitar relevamiento</a>
    </div>
  </div>
</section>)}

<style>
  .safter{background:#14232f;color:#fff;padding:clamp(72px,9vw,140px) 0}
  .safter__shell{width:min(var(--um-container-wide,1400px),calc(100% - (var(--um-page-gutter,24px) * 2)));margin:0 auto}
  .safter__head{display:grid;grid-template-columns:1fr auto;align-items:end;gap:12px 32px}
  .safter__kicker{grid-column:1/-1;display:flex;align-items:center;gap:14px;margin:0;font-size:13px;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.62)}
  .safter__kicker b{width:32px;height:2px;background:#DC2626}
  .safter.safter h2{margin:0;max-width:20ch;font-size:clamp(34px,3.6vw,56px)!important;line-height:1.05;letter-spacing:-.02em;color:#fff}
  .safter__head a{color:#fff;font-weight:700;text-decoration:none;border-bottom:2px solid #DC2626;padding-bottom:4px;white-space:nowrap}
  .safter__list{list-style:none;margin:clamp(36px,4vw,56px) 0 0;padding:0;border-top:1px solid rgba(255,255,255,.14)}
  .safter__list a{display:grid;grid-template-columns:minmax(180px,1fr) minmax(0,2fr) 64px 24px;gap:24px;align-items:baseline;padding:22px 4px;border-bottom:1px solid rgba(255,255,255,.14);color:#fff;text-decoration:none;transition:background .3s}
  .safter__list a:hover{background:rgba(255,255,255,.04)}
  .safter__client{font-size:18px;font-weight:700}
  .safter__work{font-size:17px;line-height:1.45;color:rgba(255,255,255,.78)}
  .safter__year{font-size:14px;color:rgba(255,255,255,.55);font-variant-numeric:tabular-nums;text-align:right}
  .safter__go{color:rgba(255,255,255,.4);transition:transform .3s,color .3s}
  .safter__list a:hover .safter__go{color:#fff;transform:translateX(4px)}
  .safter__list a:focus-visible,.safter a:focus-visible{outline:2px solid #DC2626;outline-offset:3px}
  .safter__close{margin-top:clamp(80px,10vw,140px);padding-top:clamp(40px,5vw,64px);border-top:1px solid rgba(255,255,255,.14);display:grid;grid-template-columns:1fr auto;gap:16px 48px;align-items:end}
  .safter__close p{margin:0;grid-column:1;max-width:44ch;font-size:18px;line-height:1.55;color:rgba(255,255,255,.78)}
  .safter__cta{grid-column:2;grid-row:1/3;align-self:end;padding:18px 26px;background:#DC2626;color:#fff;font-weight:700;text-decoration:none;white-space:nowrap}
  @media (max-width:820px){
    .safter__head{grid-template-columns:1fr}
    .safter__list a{grid-template-columns:1fr auto;gap:4px 16px;padding:18px 2px}
    .safter__client{grid-column:1}.safter__year{grid-column:2;grid-row:1}
    .safter__work{grid-column:1/-1;font-size:15px}.safter__go{display:none}
    .safter__close{grid-template-columns:1fr}.safter__cta{grid-column:1;grid-row:auto;justify-self:start}
  }
</style>
