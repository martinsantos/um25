---
// What follows a service's object band: what we do, where we did it, one way forward.
// Same palette and rhythm as the sector record, so services and sectors read as one site.
interface Case { href: string; client: string; title: string; year?: string; sector?: string }
interface Props {
  name: string;
  scope: string[];
  deliverable?: string;
  standard?: string;
  cases: Case[];
  sectors: { name: string; href: string }[];
  fichaHref?: string | null;
}
const { name, scope, deliverable, standard, cases, sectors, fichaHref } = Astro.props;
---
<section class="safter" aria-label={`${name}: qué hacemos y dónde lo hicimos`}>
  <div class="safter__shell">
    <header class="safter__head">
      <p class="safter__kicker"><b></b>Qué hacemos</p>
      <h2>{name}, de punta a punta.</h2>
    </header>
    <ol class="sa-scope">
      {scope.map((item, i) => <li><span>{String(i + 1).padStart(2, '0')}</span>{item}</li>)}
    </ol>
    {(deliverable || standard) && (
      <dl class="sa-facts">
        {deliverable && <div><dt>Lo que entregamos</dt><dd>{deliverable}</dd></div>}
        {standard && <div><dt>Bajo norma</dt><dd>{standard}</dd></div>}
        {fichaHref && <div><dt>Ficha técnica</dt><dd><a href={fichaHref}>Ver ficha completa →</a></dd></div>}
      </dl>
    )}

    {cases.length > 0 && (<>
      <header class="safter__head sa-gap">
        <p class="safter__kicker"><b></b>Antecedentes</p>
        <h2>Donde ya lo hicimos.</h2>
        <a href="/antecedentes">Ver todos los proyectos <span aria-hidden="true">→</span></a>
      </header>
      <ol class="safter__list">
        {cases.map((c) => (
          <li><a href={c.href}><span class="safter__client">{c.client}</span><span class="safter__work">{c.title}{c.sector && <em> · {c.sector}</em>}</span><span class="safter__year">{c.year}</span><span class="safter__go" aria-hidden="true">→</span></a></li>
        ))}
      </ol>
    </>)}

    {sectors.length > 0 && (
      <nav class="sa-sectors" aria-label="Sectores donde aplicamos este servicio">
        <p class="safter__kicker"><b></b>En qué sectores</p>
        <ul>{sectors.map((s) => <li><a href={s.href}>{s.name}</a></li>)}</ul>
      </nav>
    )}

    <div class="safter__close">
      <h2>Contanos qué necesitás resolver.</h2>
      <p>Hacemos un relevamiento técnico y te proponemos el alcance, con casos comparables.</p>
      <a class="safter__cta" href="/contacto">Solicitar relevamiento</a>
    </div>
  </div>
</section>

<style>
  .safter{background:#14232f;color:#fff;padding:clamp(72px,9vw,140px) 0}
  .safter__shell{width:min(var(--um-container-wide,1400px),calc(100% - (var(--um-page-gutter,24px) * 2)));margin:0 auto}
  .safter__head{display:grid;grid-template-columns:1fr auto;align-items:end;gap:12px 32px}
  .sa-gap{margin-top:clamp(72px,8vw,120px)}
  .safter.safter .safter__kicker{grid-column:1/-1;display:flex;align-items:center;gap:14px;margin:0;font-size:16px!important;letter-spacing:.2em;text-transform:uppercase;color:rgba(255,255,255,.62)!important}
  .safter__kicker b{width:32px;height:2px;background:#DC2626}
  .safter.safter h2{margin:0;max-width:20ch;font-size:clamp(34px,3.6vw,56px)!important;line-height:1.05;letter-spacing:-.02em;color:#fff!important}
  .safter__head a,.sa-facts a{color:#fff;font-weight:700;text-decoration:none;border-bottom:2px solid #DC2626;padding-bottom:4px;white-space:nowrap}
  .sa-scope{list-style:none;margin:clamp(32px,4vw,52px) 0 0;padding:0;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:0 48px;border-top:1px solid rgba(255,255,255,.14)}
  .safter.safter .sa-scope li{display:grid;grid-template-columns:44px 1fr;gap:12px;padding:22px 0;border-bottom:1px solid rgba(255,255,255,.14);font-size:19px!important;line-height:1.4;color:#fff!important}
  .sa-scope span{font-size:16px;color:rgba(255,255,255,.45);padding-top:4px;font-variant-numeric:tabular-nums}
  .sa-facts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;margin:36px 0 0}
  .safter.safter .sa-facts dt{font-size:16px!important;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.55)!important}
  .safter.safter .sa-facts dd{margin:8px 0 0;font-size:17px!important;line-height:1.45;color:#fff!important}
  .safter__list{list-style:none;margin:clamp(32px,4vw,52px) 0 0;padding:0;border-top:1px solid rgba(255,255,255,.14)}
  .safter__list a{display:grid;grid-template-columns:minmax(180px,1fr) minmax(0,2fr) 64px 24px;gap:24px;align-items:baseline;padding:22px 4px;border-bottom:1px solid rgba(255,255,255,.14);color:#fff;text-decoration:none;transition:background .3s}
  .safter__list a:hover{background:rgba(255,255,255,.04)}
  .safter__client{font-size:18px;font-weight:700}
  .safter__work{font-size:17px;line-height:1.45;color:rgba(255,255,255,.78)}
  .safter__work em{font-style:normal;color:rgba(255,255,255,.5)}
  .safter__year{font-size:16px;color:rgba(255,255,255,.55);text-align:right}
  .safter__go{color:rgba(255,255,255,.4);transition:transform .3s,color .3s}
  .safter__list a:hover .safter__go{color:#fff;transform:translateX(4px)}
  .sa-sectors{margin-top:clamp(56px,6vw,88px)}
  .sa-sectors ul{list-style:none;display:flex;flex-wrap:wrap;gap:10px;margin:22px 0 0;padding:0}
  .sa-sectors a{display:inline-block;padding:11px 18px;border:1px solid rgba(255,255,255,.22);color:#fff;text-decoration:none;font-size:16px;transition:border-color .3s,background .3s}
  .sa-sectors a:hover{border-color:#fff;background:rgba(255,255,255,.05)}
  .safter a:focus-visible{outline:2px solid #DC2626;outline-offset:3px}
  .safter__close{margin-top:clamp(80px,10vw,140px);padding-top:clamp(40px,5vw,64px);border-top:1px solid rgba(255,255,255,.14);display:grid;grid-template-columns:1fr auto;gap:16px 48px;align-items:end}
  .safter.safter .safter__close p{margin:0;grid-column:1;max-width:44ch;font-size:18px!important;line-height:1.55;color:rgba(255,255,255,.78)!important}
  .safter__cta{grid-column:2;grid-row:1/3;align-self:end;padding:18px 26px;background:#DC2626;color:#fff;font-weight:700;text-decoration:none;white-space:nowrap}
  @media (max-width:820px){
    .safter__head{grid-template-columns:1fr}
    .sa-scope,.sa-facts{grid-template-columns:1fr}
    .safter__list a{grid-template-columns:1fr auto;gap:4px 16px;padding:18px 2px}
    .safter__client{grid-column:1}.safter__year{grid-column:2;grid-row:1}
    .safter__work{grid-column:1/-1;font-size:16px}.safter__go{display:none}
    .safter__close{grid-template-columns:1fr}.safter__cta{grid-column:1;grid-row:auto;justify-self:start}
  }
</style>
