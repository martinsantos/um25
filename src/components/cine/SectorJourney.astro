---
import ServicesStory from './ServicesStory.astro';
import {NAV_SERVICES} from '../../data/navigation';
import {sectorProject} from '../../data/cine/sectorNarrative';
import type {Scene} from '../../data/cine/scenes';
interface Props {slug:string;scene:Scene;}
const {slug,scene}=Astro.props;
const project=sectorProject(slug,scene);
const services=NAV_SERVICES.filter(service=>project.chapters.some(chapter=>chapter.code===service.code));
---
<section class="sector-journey" id="sistemas" aria-labelledby="sector-journey-title">
 <header class="sector-journey__head"><div><p class="sector-journey__kicker"><span />Del proyecto a la operación</p><h2 id="sector-journey-title">{project.headline}</h2></div><p>{project.lead}</p></header>
 <ServicesStory services={services} project={project} single={slug==='software'} sector />
</section>
<style>
 .sector-journey{width:min(var(--um-container-wide,1400px),calc(100% - var(--um-page-gutter,24px)*2));margin:0 auto;padding:clamp(24px,3vw,40px) 0 0;color:#fff;scroll-margin-top:88px}
 .sector-journey__head{display:grid;grid-template-columns:minmax(0,1.2fr) minmax(0,1fr);gap:24px 64px;align-items:end;margin-bottom:24px}
 .sector-journey__kicker{display:flex;align-items:center;gap:14px;font-size:1rem;line-height:1.5;letter-spacing:.1em;text-transform:uppercase;color:#c4c7cc;margin:0 0 8px}.sector-journey__kicker span{width:28px;height:2px;background:var(--um-red,#dc2626)}
 .sector-journey h2{font-size:var(--um-world-h2,2.125rem);font-weight:var(--um-display-weight,600);line-height:1.12;max-width:28ch;margin:0;text-wrap:balance}
 .sector-journey__head>p{font-size:var(--um-copy-description,1.125rem);line-height:var(--um-body-line-height,1.62);color:#c4c7cc;max-width:50ch;margin:0}
 @media(max-width:760px){.sector-journey__head{grid-template-columns:1fr;gap:20px;margin-bottom:24px}.sector-journey h2{font-size:1.75rem}.sector-journey__head>p{font-size:1.0625rem}.sector-journey__kicker{font-size:1rem;letter-spacing:.08em}}
</style>
