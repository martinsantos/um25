---
/**
 * El escenario isométrico de cada servicio (2026-10-31): tres o cuatro vistas de dibujos reales.
 * Sistema: el edificio (public/cine/iso/site-building-v3.svg) con los sistemas del servicio
 * encendidos. Objeto: el equipo del servicio (public/cine/iso/service-<código>.svg, el mismo que
 * usa la propuesta) o, para los físicos, el despiece de src/assets/cine/isometric que se abre en
 * la vista "Despiece". Detalle: un acercamiento del mismo dibujo o la pieza de cerca. Consultoría
 * mira el edificio entero: sus vistas son el corte de las dos primeras plantas y la planta baja.
 * Todos los dibujos salen de los modelos 3D con scripts/cine/render-glb.mjs; nada dibujado a mano.
 * Ningún dibujo pesado va en el HTML: el objeto se trae de public/cine/iso cuando el escenario se
 * acerca a la pantalla (o la página queda quieta), y el sistema y el detalle después, al primer
 * gesto sobre las pestañas. Los despieces de los equipos físicos (chicos) siguen en línea. Así la
 * página no carga ni analiza medio megabyte de dibujo que todavía no se ve.
 */
import { ISOMETRIC_STUDIES } from '../../data/cine/isometric';
import { existePublico, leerPublico } from '../proto/isoData';
interface Props { code: string; compact?: boolean }
const { code, compact = false } = Astro.props;
const study = ISOMETRIC_STUDIES[code];
const despieces = import.meta.glob<string>('../../assets/cine/isometric/*-object.svg', { eager: true, query: '?raw', import: 'default' });
const detalles = import.meta.glob<string>('../../assets/cine/isometric/*-detail.svg', { eager: true, query: '?raw', import: 'default' });
const existe = (name: string) => existePublico(`cine/iso/${name}.svg`);
const publico = (name: string) => leerPublico(`cine/iso/${name}.svg`);
const systemSrc = '/cine/iso/site-building-v3.svg';
const objectInline = despieces[`../../assets/cine/isometric/${study.asset}-object.svg`] || '';
const objectSrc = objectInline ? '' : code === '106' ? '/cine/iso/site-building-v3-corte.svg' : `/cine/iso/service-${code}.svg`;
// El detalle: la pieza de los físicos viene de src/assets (en línea, es chica); los demás se traen de public.
const detailInline = code === '106' ? '' : detalles[`../../assets/cine/isometric/${study.asset}-detail.svg`] || '';
const detailSrc = detailInline ? '' : code === '106' ? '/cine/iso/site-building-v3-planta.svg' : existe(`service-${code}-detalle`) ? `/cine/iso/service-${code}-detalle.svg` : '';
const n = study.views.length;
const prefix = `iso-${code}`;
const first = study.views[1];
---
{<figure class:list={['iso', { 'iso--compact': compact }]} data-isometric data-iso-code={code} data-iso-view="1" data-svc={code}>
  <div class="iso__meta"><span>{study.name}</span><span>{study.object}</span><button type="button" class="iso__play" data-iso-play aria-pressed="false">Ver recorrido</button></div>
  <div class="iso__controls" role="group" aria-label={`Explorar ${study.name.toLowerCase()}`}>
    {study.views.map((view, i) => <button type="button" id={`${prefix}-view-${i}`} data-iso-select={i} data-title={view.title} data-description={view.description} aria-pressed={String(i === 1)}>{view.label}</button>)}
  </div>
  <div class="iso__frame">
    <div class="iso__drawing iso__drawing--sistema" data-iso-panel="system" data-src={systemSrc} hidden></div>
    {objectInline ? <div class="iso__drawing" data-iso-panel="object" set:html={objectInline} /> : <div class="iso__drawing" data-iso-panel="object" data-src={objectSrc} data-primero></div>}
    {detailInline ? <div class="iso__drawing" data-iso-panel="detail" hidden set:html={detailInline} /> : <div class="iso__drawing" data-iso-panel="detail" data-src={detailSrc} hidden></div>}
  </div>
  <figcaption class="iso__caption" aria-live="polite" aria-atomic="true">
    <div><h3 data-iso-title>{first.title}</h3><p data-iso-description>{first.description}</p></div>
    <span class="iso__step" aria-hidden="true"><b data-iso-step>02</b> / {String(n).padStart(2, '0')}</span>
  </figcaption>
  <ul class="iso__parts" aria-label="Qué forma el sistema">
    {study.parts.map((part) => <li><strong>{part.name}</strong><span>{part.detail}</span></li>)}
  </ul>
</figure>}
{!compact && <script src="/cine/isometric-services-2410.js" type="module" async is:inline />}
<script>
  // Los dibujos se traen de public/cine/iso: el objeto cuando el escenario se acerca a la pantalla (o la página queda quieta); los demás al primer gesto sobre las pestañas.
  document.querySelectorAll<HTMLElement>('[data-isometric]').forEach((root) => {
    const cargar = (panel: HTMLElement) => { if (!panel.dataset.src || panel.dataset.cargado) return; panel.dataset.cargado = '1'; fetch(panel.dataset.src, { priority: 'low' } as RequestInit).then((r) => (r.ok ? r.text() : '')).then((svg) => { if (svg) panel.innerHTML = svg.replace(/<\?xml[^>]*>/, ''); }).catch(() => { delete panel.dataset.cargado; }); };
    const primero = root.querySelector<HTMLElement>('[data-iso-panel][data-src][data-primero]');
    const resto = [...root.querySelectorAll<HTMLElement>('[data-iso-panel][data-src]:not([data-primero])')];
    const objeto = () => { if (primero) cargar(primero); };
    const todos = () => { objeto(); resto.forEach(cargar); };
    if (primero) new IntersectionObserver((es, o) => { if (es.some((e) => e.isIntersecting)) { o.disconnect(); objeto(); } }, { rootMargin: '1200px 0px' }).observe(root);
    const controles = root.querySelector('.iso__controls');
    ['pointerover', 'focusin', 'touchstart'].forEach((ev) => controles?.addEventListener(ev, todos, { once: true, passive: true }));
    root.addEventListener('um:iso-view', todos, { once: true });
    addEventListener('load', () => (window.requestIdleCallback || ((f: () => void) => setTimeout(f, 2000)))(todos), { once: true });
  });
</script>
<style>
  .iso{--skin-text:#fff;--skin-muted:#c4c7cc;--x-text:#fff;--x-text-2:#c4c7cc;margin:0;color:#fff;background:#090909;padding:clamp(20px,3.2vw,44px);display:grid;gap:0;min-width:0}
  .iso--compact{padding:0!important;height:100%;background:transparent}.iso--compact .iso__meta,.iso--compact .iso__caption,.iso--compact .iso__controls,.iso--compact .iso__parts{display:none}.iso--compact .iso__frame{height:100%;margin:0}
  .iso__meta{display:flex;flex-wrap:wrap;gap:8px 24px;align-items:baseline;justify-content:space-between;color:#c4c7cc;font-size:1rem;line-height:1.5;border-bottom:1px solid #ffffff24;padding-bottom:16px}
  .iso__meta span:first-child{font-weight:600;color:#fff}
  .iso__play{min-height:48px;min-width:44px;border:0;background:none;color:#fff;font:500 1rem var(--um-font-body,Arial,sans-serif);cursor:pointer;text-decoration:underline;text-decoration-color:#DC2626;text-underline-offset:6px;padding:0}
  .iso__drawing :global(.iso-operation-layer){transition:transform 640ms cubic-bezier(.65,0,.35,1)}
  .iso.is-open :global(.iso-operation-layer--middle){transform:translate(48px,-84px)}
  .iso.is-open :global(.iso-operation-layer--front){transform:translate(96px,-168px)}
  .iso__frame{height:clamp(340px,38vw,490px);position:relative;margin:8px 0 0;min-width:0}
  .iso__drawing{position:absolute;inset:0;width:100%;height:100%;display:block}
  .iso__drawing[hidden]{display:none}
  .iso__drawing :global(svg){display:block;height:100%!important;max-height:100%;width:100%;max-width:930px;margin-inline:auto;overflow:visible}
  .iso__drawing :global(.iso-lid){transform:translate(0,0);transition:transform 360ms cubic-bezier(.22,1,.36,1)}
  .iso.is-open :global(.iso-lid){transform:translate(95px,-170px)}
  .iso__drawing :global(.iso-internals),.iso__drawing :global(.iso-guides){opacity:0;transition:opacity 180ms ease}
  .iso.is-open :global(.iso-internals),.iso.is-open :global(.iso-guides){opacity:1}
  .iso__drawing.is-entering{animation:iso-enter 220ms ease-out both}
  @keyframes iso-enter{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
  /* Los dibujos del generador (sp-scene): la misma paleta y los mismos trazos que en la propuesta. */
  .iso__drawing :global(.sp-scene){--p-hi:#e6e8eb;--p-mid:#a0a6ad;--p-lo:#5c636b;--p-faint:#3a4048;--p-weight:1.1px}
  .iso__drawing :global(.sp-scene path),.iso__drawing :global(.sp-scene circle){vector-effect:non-scaling-stroke;shape-rendering:geometricPrecision}
  .iso__drawing :global(.pt-line){fill:none;stroke:var(--p-lo);stroke-width:var(--p-weight);stroke-linecap:round;stroke-linejoin:round}
  .iso__drawing :global(.pt-line[data-tone="hi"]){stroke:var(--p-hi)}.iso__drawing :global(.pt-line[data-tone="mid"]){stroke:var(--p-mid)}.iso__drawing :global(.pt-line[data-tone="faint"]){stroke:var(--p-faint)}
  .iso__drawing :global(.pt-contorno){stroke-width:1.8px}.iso__drawing :global(.pt-line[data-banda="lejos"]){stroke-width:.8px}
  .iso__drawing :global(.sp-route path){stroke-width:1.5px}
  .iso__drawing :global(.sp-pin),.iso__drawing :global(.sp-leader),.iso__drawing :global(.sp-effect),.iso__drawing :global(.sp-floor-label){display:none}
  .iso__drawing :global(.sp-solido){pointer-events:none}
  /* En el sistema, sólo los recorridos de este servicio se encienden; soporte y consultoría miran todos. */
  .iso__drawing--sistema :global(.sp-route){opacity:.1}
  .iso[data-svc="105"] .iso__drawing--sistema :global(.sp-route),.iso[data-svc="106"] .iso__drawing--sistema :global(.sp-route){opacity:.6}
  .iso[data-svc="101"] .iso__drawing--sistema :global(.sp-route--101),.iso[data-svc="102"] .iso__drawing--sistema :global(.sp-route--102),.iso[data-svc="103"] .iso__drawing--sistema :global(.sp-route--103),.iso[data-svc="104"] .iso__drawing--sistema :global(.sp-route--104),.iso[data-svc="107"] .iso__drawing--sistema :global(.sp-route--107),.iso[data-svc="108"] .iso__drawing--sistema :global(.sp-route--108){opacity:1}
  .iso__caption{display:flex;align-items:baseline;justify-content:space-between;gap:24px;padding:22px 0;border-top:1px solid #ffffff24;min-height:136px}
  .iso__caption h3{margin:0;color:#fff;font-size:var(--um-world-h3,1.25rem);font-weight:var(--um-display-weight,600);line-height:1.3}
  .iso__caption p{margin:10px 0 0;color:#c4c7cc;font-size:var(--um-copy-description,1.125rem);line-height:var(--um-body-line-height,1.62);max-width:72ch}
  .iso__step{font:400 1rem var(--um-font-mono,monospace);color:#c4c7cc;white-space:nowrap}
  .iso__step b{font-weight:500;color:#fff}
  .iso__controls{scroll-margin-top:88px;display:grid;grid-template-columns:repeat(auto-fit,minmax(0,1fr));border-block:1px solid #ffffff36}
  .iso__controls button{display:flex;align-items:center;justify-content:center;gap:12px;min-height:54px;padding:12px 8px;color:#c4c7cc;background:transparent;border:0;border-bottom:2px solid transparent;font:500 1rem var(--um-font-body,Arial,sans-serif);cursor:pointer;transition:color .2s,background .2s,border-color .2s}
  .iso__controls button+button{border-left:1px solid #ffffff24}
  .iso__controls button[aria-pressed=true]{background:#171717;color:#fff;border-bottom-color:#dc2626}
  .iso__controls span{font-variant-numeric:tabular-nums}
  .iso__controls button:focus-visible{outline:2px solid #fff;outline-offset:-5px}
  .iso__parts{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px;list-style:none;padding:28px 0 0;margin:0}
  .iso__parts li{display:grid;gap:10px;font-size:1rem;line-height:1.55}
  .iso__parts strong{font-weight:600;color:#fff}
  .iso__parts li>span{color:#c4c7cc}
  @media(hover:hover){.iso__controls button:hover{background:#1c1c1c;color:#fff}}
  @media(max-width:760px){.iso{padding:20px}.iso__meta{display:grid;gap:6px}.iso__frame{height:300px;margin:16px -8px 0}.iso__caption{padding:18px 0;gap:12px;min-height:172px}.iso__controls{grid-template-columns:repeat(auto-fit,minmax(120px,1fr))}.iso__controls button{min-height:48px;font-size:.9375rem}.iso__controls button+button{border-left:0}.iso__parts{grid-template-columns:1fr;gap:16px}}
  @media(prefers-reduced-motion:reduce){.iso__drawing.is-entering{animation:none}.iso__drawing :global(.iso-lid),.iso__drawing :global(.iso-operation-layer){transition:none}.iso__drawing :global(.iso-internals),.iso__drawing :global(.iso-guides){transition:none}}
  .iso__step{display:none}
</style>
