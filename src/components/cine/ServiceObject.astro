---
// A service's object, assembled and at work, floating on the page's paper: transparent
// canvas, soft contact shadow, no frame. The words stay in the page, not in the animation.
interface Props { code: string; kicker: string; title: string }
const { code, kicker, title } = Astro.props;
---
<section class="sobj" aria-label={title}>
  <div class="sobj__copy">
    <p class="sobj__kicker"><span></span>{kicker}</p>
    <h2>{title}</h2>
  </div>
  <div class="sobj__stage" data-service-object={code} aria-hidden="true"></div>
</section>
<style>
  .sobj{position:relative;display:grid;grid-template-columns:minmax(0,.8fr) minmax(0,1.2fr);align-items:center;min-height:min(78vh,760px);background:#fcfcf9;color:#182120;overflow:hidden}
  .sobj__copy{padding:clamp(48px,6vw,96px) 0 clamp(48px,6vw,96px) max(var(--um-page-gutter,24px),calc((100% - var(--um-container-wide,1400px))/2));position:relative;z-index:1}
  .sobj.sobj .sobj__kicker{display:flex;align-items:center;gap:14px;margin:0;font-size:13px!important;letter-spacing:.2em;text-transform:uppercase;color:#5f6368!important}
  .sobj__kicker span{width:32px;height:2px;background:#DC2626}
  .sobj.sobj h2{margin:18px 0 0;max-width:14ch;font-size:clamp(34px,4vw,64px)!important;line-height:1.04;letter-spacing:-.025em;color:#182120!important}
  .sobj__stage{position:relative;height:100%;min-height:min(78vh,760px);margin-right:max(0px,calc((100% - var(--um-container-wide,1400px))/2))}
  .sobj__stage :global(canvas){position:absolute;inset:0;width:100%;height:100%;display:block}
  @media (max-width:820px){
    .sobj{grid-template-columns:1fr;min-height:0}
    .sobj__copy{padding:48px var(--um-page-gutter,20px) 0}
    .sobj__stage{min-height:0;aspect-ratio:1/1}
  }
</style>
<script>
  function boot() {
    for (const host of document.querySelectorAll<HTMLElement>('[data-service-object]:not([data-bound])')) {
      host.dataset.bound = '1';
      const io = new IntersectionObserver(async (entries) => {
        if (!entries.some((e) => e.isIntersecting)) return; io.disconnect();
        const { mountObject } = await import('../../scripts/senal/objects.js');
        const dispose = mountObject(host, host.dataset.serviceObject || '');
        document.addEventListener('astro:before-swap', () => dispose(), { once: true });
      }, { rootMargin: '400px 0px' });
      io.observe(host);
    }
  }
  boot(); document.addEventListener('astro:page-load', boot);
</script>
