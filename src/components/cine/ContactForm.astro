---
// Formulario de contacto guiado. Envía a /api/contact con el mismo contrato que el
// modal global (name, email, company, message + campos de origen y anti-spam): tema,
// servicios, sede y urgencia se suman al mensaje y el tema viaja como originIntent,
// que el mail usa como asunto.
import { journeyContext, serviceJourney } from '../../data/propuesta/recorrido';
import { shellServiceCopy } from '../../config/i18nShell';
import { casoDeConsulta } from '../proto/relato';
import { anioObraArchivo, tituloObraArchivo } from '../proto/titulosArchivo';
import ContactScope from '../proto/ContactScope.astro';
import ContactOffice from '../proto/ContactOffice.astro';
import { isNamedClient } from '../proto/catalogEditorial';
import { pageCaseCandidates } from '../proto/caseSelection';
import { publicCaseTitle, samePublicClient } from '../proto/casePresentation';
import { homeProjectJourney, homeWorkContext, homeWorkReturn } from '../proto/portadaCases';
import { loadStories, thumbOf } from '../proto/isoData';
import { contactOrigin, contextualParams } from '../../lib/contactEntry';
import { catalogCaseJourney } from '../proto/catalogCaseJourney';
import { relatedCaseJourney } from '../proto/relatedCaseGroups';
import { caseJourney, contactPanelReturn } from '../../lib/caseJourney';
import { budgetSelections } from '../../data/budgetBrief';
import { datasheetSource } from '../../utils/datasheets';
interface Props { lang?: 'es' | 'en'; withOffice?: boolean }
const { lang = 'es', withOffice = false } = Astro.props;
const incoming = Astro.url.searchParams;
const referrer = Astro.request.headers.get('referer');
let from = contactOrigin(incoming.get('origen'));
if (!from && referrer) {
  try {
    const previous = new URL(referrer);
    if (previous.origin === Astro.url.origin) from = contactOrigin(previous.pathname);
  } catch { /* Referrers are optional. */ }
}
const params = contextualParams(incoming, from);
const budget = budgetSelections(params, lang);
const context = journeyContext(params, lang);
const intent = params.get('intent') || (budget.length ? 'presupuesto' : '');
const dossier = intent === 'documentacion';
const assessment = intent === 'relevamiento';
const sourceTitle = from ? incoming.get('tituloOrigen')?.trim().slice(0, 160) : '';
const sourceAction = from ? incoming.get('accion')?.trim().slice(0, 100) : '';
const college = from === '/software/gestion-de-comunidades-profesionales';
const draft = college && Astro.request.method === 'POST' ? await Astro.request.formData() : undefined;
const draftField = (key: string, limit: number) => {
  const value = draft?.get(key);
  return typeof value === 'string' ? value.trim().slice(0, limit) : '';
};
const evaluation = draftField('brief', 2800);
if (evaluation) budget.push({ label: 'Evaluación del colegio', value: evaluation });
const t = (es: string, en: string) => lang === 'en' ? en : es;
const assessmentTitle = t('Relevamiento técnico', 'Technical assessment');
const reference = params.get('antecedente') || '';
const hasReference = /^\d{1,8}$/.test(reference);
const homeContext = homeWorkContext(incoming);
const stories = hasReference || (homeContext && params.has('archivo')) ? (await loadStories()).stories : [];
const work = hasReference ? stories.find(item => item.id === Number(reference)) : undefined;
const archivo = work ? undefined : casoDeConsulta(from, params.get('archivo')) || undefined;
const archiveTitle = archivo ? tituloObraArchivo(archivo) : '';
const archiveHref = archivo ? from + '#archivo-' + archivo.id : undefined;
const project = work ? `UM-${work.id}` : '';
const originPath = from || work?.href || (lang === 'en' ? '/en/contact' : '/contacto');
const workTitle = work ? publicCaseTitle(work) : archiveTitle;
const workClient = work?.client || archivo?.cliente;
const referenceHref = work?.href || archiveHref;
const sourceWork = referenceHref && new URL(referenceHref, Astro.url);
const linkedWork = work && sourceWork?.pathname === from ? work : undefined;
const relatedJourney = lang === 'es' && linkedWork ? relatedCaseJourney(linkedWork, params, stories) : undefined;
const workJourney = linkedWork
  ? homeProjectJourney(linkedWork, incoming, stories) || relatedJourney || caseJourney(linkedWork, params, stories)
  : undefined;
const archiveSelection = incoming.get('seleccionArchivo');
const resultsJourney = lang === 'es' && work && sourceWork && sourceWork.pathname === from && archiveSelection
  ? catalogCaseJourney(work, new URLSearchParams(archiveSelection), stories)
  : undefined;
const returnToResults = resultsJourney || relatedJourney?.archive;
const archiveFromHome = archivo && sourceWork && homeContext && sourceWork.pathname === from;
if (archiveFromHome) sourceWork.search = new URLSearchParams(homeContext).toString();
const returnToWork = resultsJourney ? referenceHref + resultsJourney.query
  : workJourney ? referenceHref + '?' + workJourney.contact.toString()
  : archiveFromHome && homeWorkReturn(sourceWork, stories, archivo.id)
    ? sourceWork.pathname + sourceWork.search + sourceWork.hash
    : referenceHref;
const referenceLabel = t('Obra de referencia', 'Reference project');
const sourceLabel = [referenceLabel, project || (archivo && anioObraArchivo(archivo))].filter(Boolean).join(' · ');
const sheetCode = dossier ? /^\/servicios\/(10[1-8])\/ficha$/.exec(from)?.[1] : undefined;
const sheetSource = sheetCode && datasheetSource(params, sheetCode);
const sheetQuery = sheetSource && (sheetSource.sector ? '?sector=' + sheetSource.sector.slug : sheetSource.desde ? '?desde=' + sheetSource.desde : '');
const homeService = params.get('sistema') || '';
const fromHomeService = from === '/' && params.get('desde') === 'inicio-servicios' && /^10[1-8]$/.test(homeService);
const panelReturn = lang === 'es' ? contactPanelReturn(from, params, work) : undefined;
const documentationReturn = dossier && from === '/documentacion';
const assessmentReturn = assessment && (from === '/' || /^\/servicios\/10[1-8]$/.test(from));
const returnHref = panelReturn?.href || returnToWork || (sheetCode ? from + sheetQuery
  : documentationReturn ? '/documentacion#dossier'
  : fromHomeService ? (homeService === '101' ? '/' : '/?servicio=' + homeService) + '#servicios'
  : assessmentReturn ? from + '#consulta-principal' : undefined);
const returnLabel = panelReturn?.label || (returnToWork ? t('Volver a la obra', 'Return to the project')
  : sheetCode ? t('Volver a la ficha técnica', 'Return to the technical sheet')
  : documentationReturn ? t('Volver a Documentación técnica', 'Return to technical documentation')
  : fromHomeService ? t('Volver a Servicios de Inicio', 'Return to services on the home page')
  : from === '/' ? t('Volver a Inicio', 'Return to the home page')
  : t('Volver al servicio', 'Return to the service'));
const photo = work && /^\/images\/(?:photography|antecedentes)\//.test(work.image) ? thumbOf(work.image) : '';
const dossierSubject = [t('Solicitud de dossier', 'Dossier request'), context?.subject].filter(Boolean).join(' · ');
const subject = work ? `${t('Proyecto', 'Project')} ${project} · ${workTitle}`
  : archivo ? [referenceLabel + ' · ' + archiveTitle, archivo.cliente].filter(Boolean).join(' · ')
  : college ? 'Software para colegios profesionales'
  : dossier ? dossierSubject
  : assessment ? [assessmentTitle, context?.subject].filter(Boolean).join(' · ')
  : context?.subject || sourceTitle || undefined;
const group = work && Object.values(serviceJourney).flatMap(service => Object.values(service.groups))
  .find(({reference}) => reference?.id === work.id && (
    samePublicClient(reference.client, work.client) ||
    (reference.client === work.client && reference.title === workTitle)
  ));
const supportedServices = work && !group && lang === 'es'
  ? work.serviceCodes.filter(code => pageCaseCandidates([work], undefined, code).length > 0) : [];
const serviceQuestion = supportedServices.length === 1 ? serviceJourney[supportedServices[0]!]?.question : undefined;
if (work && context) budget.push({ label: t('Alcance', 'Scope'), value: context.subject });
const workQuestion = group && project === 'UM-3104'
  ? t('¿Qué accesos necesitás controlar y en qué sitio?', 'Which entrances do you need to control and where?')
  : lang === 'es' ? group?.question || serviceQuestion : undefined;
const question = work && ['directorio', 'inicio'].includes(params.get('desde') || '')
  ? workQuestion || context?.question
  : context?.question || workQuestion;
const messageQuestion = archivo
  ? t('¿Qué necesitás resolver y dónde se haría el trabajo?', 'What do you need to address, and where would the work take place?')
  : dossier && !project && !college
  ? t('¿Para qué proyecto o licitación necesitás el dossier?', 'Which project or tender needs the dossier?')
  : question || (project
  ? t('¿Qué necesitás implementar y en qué sitio?', 'What do you need to implement, and at which site?')
  : college ? '¿Qué necesitás resolver en tu colegio profesional?'
  : assessment ? t('¿Qué necesitás instalar o mejorar y en qué sede?', 'What do you need to install or improve, and at which site?')
  : undefined);
const emailRecipient = ['contacto', 'ultimamilla.com.ar'].join('@');
const emailContext = [subject, ...budget.map(item => item.label + ': ' + item.value), archiveHref || from || work?.href].filter(Boolean).join('\n');
const emailLink = 'mailto:' + emailRecipient + '?subject=' + encodeURIComponent(subject || t('Consulta desde la web', 'Website enquiry')) + '&body=' + encodeURIComponent([emailContext, messageQuestion].filter(Boolean).join('\n\n') + '\n\n');
const topics = [
  { id: 'diagnostico', label: t('Diagnóstico o incidente', 'Diagnosis or incident'), hint: t('Qué sistema falla, en qué sede y desde cuándo.', 'Which system is affected, where and since when.') },
  { id: 'relevamiento', label: t('Relevamiento técnico', 'Technical assessment'), hint: t('Qué hay que instalar o mejorar, cuántas sedes y qué restricciones tiene el edificio.', 'What needs to be installed or improved, how many sites and any building constraints.') },
  { id: 'abono', label: t('Abono de soporte 24/7', '24/7 support agreement'), hint: t('Qué activos son críticos, qué tiempo de respuesta necesitás y en qué horarios.', 'Which assets are critical, the response time you need and your operating hours.') },
  { id: 'pliego', label: t('Licitación o pliego', 'Tender or specification'), hint: t('Número de proceso, fechas y requisitos técnicos o de documentación.', 'Tender reference, dates and technical or documentation requirements.') },
  { id: 'otra', label: t('Otra consulta', 'Other enquiry'), hint: t('Contanos qué necesitás, en qué sede y para cuándo.', 'Tell us what you need, where and by when.') },
];
const services = ['Redes', 'Seguridad electrónica', 'Telecomunicaciones', 'Software a medida', 'Soporte 24/7', 'Consultoría IT', 'Detección de incendios', 'Eléctricos IT']
  .map((name, index) => shellServiceCopy(lang, String(101 + index), name, '').name);
const code = params.get('sistema') || '';
const selectedServices = new Set(params.getAll('servicio').map(value => value.toLowerCase()));
for (const serviceCode of new Set([code, ...(work?.serviceCodes || [])])) {
  if (/^10[1-8]$/.test(serviceCode)) selectedServices.add(services[Number(serviceCode) - 101]!.toLowerCase());
}
const optionalHint = t('Empresa, sede, servicios y urgencia', 'Company, site, services and urgency');
const hasDraftDetails = Boolean(draftField('institution', 120) || draftField('site', 180));
const initialTopic = params.get('tema') || '';
const defaultMessageHint = messageQuestion ? '' : t('Incluí la sede y el plazo, si ya los tenés.', 'Include your site and timeframe if you know them.');
const initialMessageHint = topics.find(topic => topic.id === initialTopic)?.hint || defaultMessageHint;
const urgencies = [t('Sin urgencia', 'No urgency'), t('Esta semana', 'This week'), t('Hoy: hay una falla en curso', 'Today: an incident is in progress'), t('Tengo fecha de pliego', 'I have a tender deadline')];
---
<div class="ctf" id={withOffice ? 'formulario' : undefined} data-ctf data-lang={lang} data-archivo={archivo ? archivo.id : undefined} data-subject={subject} data-college={college ? (draft ? 'quiz' : 'form') : undefined} data-origin-path={originPath} data-origin-title={(referenceHref ? subject : sourceTitle) || subject || originPath} data-origin-label={sourceAction} data-origin-intent={assessment ? assessmentTitle : intent?.slice(0, 80)}>
  <noscript>
    <style is:inline>[data-ctf] .ctf__form { display:none; }</style>
    {subject && <h2 class="ctf__subject">{subject}</h2>}
    <p>{t('Enviá tu consulta por email a', 'Email your enquiry to')} <a class="ctf__email" href={emailLink}>{emailRecipient}</a>.</p>
    {returnHref && <a class="ctf__return" href={returnHref}><span aria-hidden="true">←</span> {returnLabel}</a>}
    {returnToResults && <a class="ctf__return" href={returnToResults.href}>{returnToResults.label}</a>}
    {budget.length > 0 && <dl class="ctf__brief">{budget.map(item => <div><dt>{item.label}</dt><dd>{item.value}</dd></div>)}</dl>}
  </noscript>
  <form class="ctf__form" id="contactForm" method="post" action="/api/contact" novalidate>
    {subject && <header class="ctf__context">
      <div>
        {referenceHref && <small>{sourceLabel}</small>}
        <h2 class="ctf__subject">{workTitle || subject}</h2>
        {workClient && isNamedClient(workClient) && <p>{workClient}</p>}
      </div>
      {photo && <img src={photo} width="160" height="112" alt="" decoding="async" />}
      {returnHref && <nav class="ctf__context-links" aria-label={t('Volver desde la consulta', 'Return from the enquiry')}>
        <a class="ctf__return" href={returnHref}><span aria-hidden="true">←</span> {returnLabel}</a>
        {returnToResults && <a class="ctf__return" href={returnToResults.href}>{returnToResults.label}</a>}
      </nav>}
      {lang === 'es' && !dossier && !college && !archivo && <ContactScope params={params} work={work} />}
    </header>}
    {budget.length > 0 && <dl class="ctf__brief" data-work-scope={Boolean(work && context && budget.length === 1) || undefined} aria-label={t('Contexto del presupuesto', 'Project brief')}>
      {budget.map(item => <div data-brief-row data-college-evaluation={college && evaluation && item.value === evaluation ? true : undefined}><dt>{item.label}</dt><dd>{item.value}</dd></div>)}
    </dl>}
    <fieldset class="ctf__fields">
      <div class="ctf__field ctf__prompt">
        <label for="message">{messageQuestion || t('¿Qué necesitás resolver?', 'What do you need help with?')}&nbsp;<em aria-hidden="true">*</em></label>
        <small class="ctf__hint" id="message-hint" data-default={defaultMessageHint} hidden={!initialMessageHint}>{initialMessageHint}</small>
        <span class="ctf__message-input">
          <textarea id="message" data-question={messageQuestion} aria-describedby="message-hint error-message" name="message" required rows="4" maxlength="1200">{draftField('notes', 1200)}</textarea>
          <span class="ctf__count" aria-hidden="true" hidden><b data-count>0</b>/1200</span>
        </span>
        <small class="ctf__error" data-error-for="message" id="error-message"></small>
      </div>

      <div class="ctf__grid">
        <label class="ctf__field">
          <span>{t('Nombre', 'Name')}&nbsp;<em aria-hidden="true">*</em></span>
          <input type="text" id="name" value={draftField('person', 100)} aria-describedby="error-name" name="name" maxlength="100" required autocomplete="name" autocapitalize="words" enterkeyhint="next" placeholder={t('Nombre y apellido', 'Full name')} />
          <small class="ctf__error" data-error-for="name" id="error-name"></small>
        </label>
        <label class="ctf__field">
          <span>{t('Email de trabajo', 'Work email')}&nbsp;<em aria-hidden="true">*</em></span>
          <input type="email" id="email" aria-describedby="error-email" name="email" maxlength="120" required autocomplete="email" inputmode="email" autocapitalize="off" spellcheck="false" enterkeyhint="next" placeholder={t('mail@empresa.com', 'you@company.com')} />
          <small class="ctf__error" data-error-for="email" id="error-email"></small>
        </label>
      </div>

      <details class="ctf__more" data-ctf-more open={hasDraftDetails}>
        <summary>
          <span>
            <strong>{t('Detalles opcionales', 'Optional details')}</strong>
            <small data-detail-summary data-default={optionalHint}>{services.filter(service => selectedServices.has(service.toLowerCase())).join(' · ') || optionalHint}</small>
          </span>
          <span class="ctf__more-icon" aria-hidden="true"></span>
        </summary>
        <div class="ctf__optional-fields">
          <label class="ctf__field">
            <span>{t('Empresa u organismo', 'Company or organization')}</span>
            <input type="text" id="company" name="company" value={draftField('institution', 120)} autocomplete="organization" enterkeyhint="next" placeholder={t('Opcional', 'Optional')} />
          </label>

          <label class="ctf__field" hidden={Boolean(context) || assessment}>
            <span>{t('Motivo', 'Enquiry type')}</span>
            <select id="topic" name="topic">
              <option value="">{t('Elegí un motivo', 'Choose an enquiry type')}</option>
              {topics.map((t) => <option value={t.id} selected={initialTopic === t.id} data-label={t.label} data-hint={t.hint}>{t.label}</option>)}
            </select>
          </label>

          <fieldset class="ctf__group">
            <legend class="ctf__legend">{t('Servicios relacionados', 'Related services')}</legend>
            <div class="ctf__chips">
              {services.map((s, i) => (
                <label class="ctf__chip">
                  <input type="checkbox" name="services" checked={selectedServices.has(s.toLowerCase())} value={s} id={`service-${i}`} />
                  <span>{s}</span>
                </label>
              ))}
            </div>
          </fieldset>

          <div class="ctf__grid">
            <label class="ctf__field">
              <span>{t('Ciudad o sede', 'City or site')}</span>
              <input type="text" id="site" name="site" value={draftField('site', 180)} autocomplete="address-level2" enterkeyhint="next" placeholder={t('Ej.: Mendoza, 3 sedes', 'E.g. Mendoza, 3 sites')} />
            </label>
            <label class="ctf__field">
              <span>{t('Urgencia', 'Urgency')}</span>
              <select id="urgency" name="urgency">
                {urgencies.map((u) => <option value={u}>{u}</option>)}
              </select>
            </label>
          </div>
        </div>
      </details>
    </fieldset>

    <input type="text" name="website" class="ctf__hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <input type="text" name="contact_phone" class="ctf__hp" tabindex="-1" autocomplete="off" aria-hidden="true" />
    <input type="hidden" name="startedAt" value="" />
    <input type="hidden" name="contactProof" value="" />

    <div class="ctf__error-box" role="alert" tabindex="-1" hidden>
      <p data-ctf-error></p>
      <div class="ctf__error-actions">
        <a class="ctf__error-email">{t('Enviar por email', 'Send by email')}</a>
        <button type="button" class="ctf__error-copy" data-ctf-copy>{t('Copiar consulta', 'Copy enquiry')}</button>
      </div>
      <p data-ctf-copy-status role="status"></p>
      <textarea data-ctf-copy-text hidden readonly rows="4" aria-label={t('Texto de la consulta', 'Enquiry text')}></textarea>
    </div>
    <div class="ctf__submit">
      <button type="submit" class="ctf__btn" data-retry={t('Reintentar envío', 'Try sending again')}>
        <span data-ctf-submit-label>{t('Enviar consulta', 'Send enquiry')}</span><span class="ctf__arrow" aria-hidden="true">→</span>
      </button>
      <p data-ctf-status role="status">{t('Te respondemos por email en el día hábil.', 'We reply by email during business hours.')}</p>
    </div>
  </form>

  <div class="ctf__done" role="status" hidden tabindex="-1">
    <h2>{t('Consulta recibida', 'Enquiry received')}</h2>
    <p>{t('Te respondemos a', 'We’ll reply to')} <strong data-reply-email></strong>.</p>
    {referenceHref && <a class="ctf__done-work" href={returnToWork || referenceHref}>
      <small>{sourceLabel}</small>
      <strong>{workTitle} <span aria-hidden="true">↗</span></strong>
    </a>}
    {!referenceHref && subject && <p class="ctf__done-subject">{subject}</p>}
    <button type="button" class="ctf__btn ctf__btn--ghost" data-ctf-again>{t('Enviar otra consulta', 'Send another enquiry')}</button>
  </div>
</div>

{withOffice && <ContactOffice lang={lang} emailLink={emailLink} address={emailRecipient} />}

<script>
  import { collegeAttribution } from '../../lib/collegeAttribution';
  document.querySelectorAll<HTMLElement>('[data-ctf]').forEach((root) => {
    const t = (es: string, en: string) => root.dataset.lang === 'en' ? en : es;
    const form = root.querySelector<HTMLFormElement>('form')!;
    const done = root.querySelector<HTMLElement>('.ctf__done')!;
    const errorBox = form.querySelector<HTMLElement>('.ctf__error-box')!;
    const errorText = errorBox.querySelector<HTMLElement>('[data-ctf-error]')!;
    const errorEmail = errorBox.querySelector<HTMLAnchorElement>('.ctf__error-email')!;
    const copyButton = errorBox.querySelector<HTMLButtonElement>('[data-ctf-copy]')!;
    const copyStatus = errorBox.querySelector<HTMLElement>('[data-ctf-copy-status]')!;
    const copyText = errorBox.querySelector<HTMLTextAreaElement>('[data-ctf-copy-text]')!;
    const message = form.querySelector<HTMLTextAreaElement>('textarea[name="message"]')!;
    const count = root.querySelector<HTMLElement>('[data-count]')!;
    const fields = form.querySelector<HTMLFieldSetElement>('.ctf__fields')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const submitLabel = submit.querySelector<HTMLElement>('[data-ctf-submit-label]')!;
    const defaultSubmitLabel = submitLabel.textContent;
    const status = form.querySelector<HTMLElement>('[data-ctf-status]')!;
    const defaultStatus = status.textContent;
    const field = (name: string) => form.elements.namedItem(name) as HTMLInputElement | null;
    const stamp = () => {
      field('startedAt')!.value = String(Date.now());
      field('contactProof')!.value = `${Date.now()}:${Math.round(performance.now())}:${navigator.language || 'es-AR'}`;
    };
    stamp();

    const updateCount = () => {
      count.textContent = String(message.value.length);
      count.parentElement!.hidden = message.value.length < 1000;
    };
    updateCount();
    message.addEventListener('input', updateCount);
    const topicSelect = form.querySelector<HTMLSelectElement>('select[name="topic"]')!;
    const messageHint = form.querySelector<HTMLElement>('#message-hint')!;
    const selectedTopic = () => topicSelect.selectedOptions[0]?.value ? topicSelect.selectedOptions[0] : null;
    const syncHint = () => {
      messageHint.textContent = selectedTopic()?.dataset.hint || messageHint.dataset.default || '';
      messageHint.hidden = !messageHint.textContent;
      topicSelect.classList.toggle('is-empty', !topicSelect.value);
    };
    topicSelect.addEventListener('change', syncHint);
    syncHint();

    const more = root.querySelector<HTMLDetailsElement>('[data-ctf-more]')!;
    const initiallyOpen = more.open;
    const detailSummary = more.querySelector<HTMLElement>('[data-detail-summary]')!;
    const syncServices = () => {
      const selected = [...form.querySelectorAll<HTMLInputElement>('input[name="services"]:checked')];
      detailSummary.textContent = selected.map(input => input.value).join(' · ') || detailSummary.dataset.default!;
    };
    more.addEventListener('change', syncServices);
    syncServices();
    const requiredFields = ['name', 'email', 'message'] as const;
    type RequiredField = typeof requiredFields[number];
    const validate = (name: RequiredField) => {
      const value = field(name)!.value.trim();
      if (name === 'name') return value.length < 2 ? t('Ingresá tu nombre.', 'Enter your name.') : '';
      if (name === 'email') return !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value)
        ? t('Ingresá un email válido.', 'Enter a valid email address.') : '';
      if (message.dataset.question) return !value ? t('Escribí tu respuesta.', 'Enter your answer.') : '';
      return value.length < 12 ? t('Contanos un poco más para poder ayudarte.', 'Please add a little more detail so we can help.') : '';
    };
    const setFieldError = (name: RequiredField, text: string) => {
      const error = form.querySelector<HTMLElement>(`[data-error-for="${name}"]`)!;
      const input = field(name)!;
      error.textContent = text;
      if (text) input.setAttribute('aria-invalid', 'true');
      else input.removeAttribute('aria-invalid');
    };
    for (const name of requiredFields) {
      const input = field(name)!;
      input.addEventListener('input', () => {
        if (input.hasAttribute('aria-invalid')) setFieldError(name, validate(name));
      });
    }
    const mailto = (body: string) => {
      const address = ['contacto', 'ultimamilla.com.ar'].join('@');
      return `${['mai', 'lto:'].join('')}${address}?subject=${encodeURIComponent(t('Consulta desde la web ULTIMA MILLA', 'Enquiry from the ULTIMA MILLA website'))}&body=${encodeURIComponent(body)}`;
    };

    const campaign = root.dataset.college ? collegeAttribution(new URLSearchParams(location.search)) : {};
    const readEnquiry = () => {
      const topicInput = selectedTopic();
      const services = [...form.querySelectorAll<HTMLInputElement>('input[name="services"]:checked')].map((c) => c.value);
      const site = field('site')!.value.trim();
      const urgency = (form.elements.namedItem('urgency') as HTMLSelectElement).value;
      const header = [
        root.dataset.subject,
        ...[...form.querySelectorAll('[data-brief-row]:not([data-college-evaluation])')].map(row =>
          `${row.querySelector('dt')!.textContent}: ${row.querySelector('dd')!.textContent}`
        ),
        topicInput ? `Tema: ${topicInput.dataset.label}` : '',
        services.length ? `Servicios: ${services.join(', ')}` : '',
        site ? `Ciudad o sede: ${site}` : '',
        urgency && urgency !== t('Sin urgencia', 'No urgency') ? `Urgencia: ${urgency}` : '',
      ].filter(Boolean);
      const originUrl = new URL(root.dataset.originPath!, location.origin);
      if (root.dataset.archivo) originUrl.hash = 'archivo-' + root.dataset.archivo;
      for (const [key, value] of Object.entries(campaign)) originUrl.searchParams.set(key, value);
      const evaluation = form.querySelector('[data-college-evaluation] dd')?.textContent || '';
      const answer = [message.dataset.question, message.value.trim()].filter(Boolean).join('\n');
      return {
        name: field('name')!.value.trim(), email: field('email')!.value.trim(), evaluation,
        company: field('company')!.value.trim(),
        message: [...header, '', answer].join('\n').trim(),
        website: field('website')!.value,
        contact_phone: field('contact_phone')!.value,
        startedAt: field('startedAt')!.value,
        contactProof: field('contactProof')!.value,
        formVariant: root.dataset.college === 'quiz' ? 'comunidades-profesionales-quiz' : root.dataset.college ? 'comunidades-profesionales' : 'contacto-guiado',
        originPath: root.dataset.originPath,
        originTitle: root.dataset.originTitle,
        originLabel: root.dataset.originLabel || root.dataset.subject || services.join(', '),
        originIntent: root.dataset.originIntent || topicInput?.dataset.label || t('Consulta general', 'General enquiry'),
        originHref: originUrl.href,
      };
    };

    const updateEmailFallback = () => {
      if (errorBox.hidden) return;
      const data = readEnquiry();
      const signature = [data.name, data.email, data.company].filter(Boolean).join(' · ');
      const originTitle = data.originTitle !== root.dataset.subject && data.originTitle !== data.originPath ? data.originTitle : '';
      copyText.value = [data.message, data.evaluation, originTitle, data.originHref, signature].filter(Boolean).join('\n\n');
      errorEmail.href = mailto(copyText.value);
      copyStatus.textContent = '';
    };
    copyButton.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(copyText.value);
        copyText.hidden = true;
        copyStatus.textContent = t('Consulta copiada.', 'Enquiry copied.');
      } catch {
        copyText.hidden = false;
        copyText.focus();
        copyText.select();
        copyStatus.textContent = t('El texto está seleccionado. Podés copiarlo manualmente.', 'The text is selected. You can copy it manually.');
      }
    });
    form.addEventListener('input', updateEmailFallback);
    form.addEventListener('change', updateEmailFallback);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submit.disabled) return;
      errorBox.hidden = true;
      copyText.hidden = true;
      copyText.value = '';
      copyStatus.textContent = '';
      status.textContent = defaultStatus;
      submitLabel.textContent = defaultSubmitLabel;
      for (const name of requiredFields) setFieldError(name, validate(name));
      const firstError = fields.querySelector<HTMLElement>('[aria-invalid="true"]');
      if (firstError) {
        firstError.focus();
        return;
      }

      const payload = readEnquiry();
      const { email } = payload;
      fields.disabled = true;
      submit.disabled = true;
      submitLabel.textContent = t('Enviando…', 'Sending…');
      status.textContent = t('Enviando la consulta…', 'Sending your enquiry…');
      const controller = new AbortController();
      const deadline = setTimeout(() => controller.abort(), 20_000);
      let responseStatus: number | undefined;
      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
          signal: controller.signal,
        });
        responseStatus = res.status;
        const result = await res.json().catch(() => ({}));
        if (res.ok && result?.success === true) {
          if (root.dataset.college && !result.duplicate) {
            const layer = (window as Window & { dataLayer?: unknown[] }).dataLayer;
            function record(command: string, event: string, fields: Record<string, string>) { layer?.push(arguments); }
            record('event', 'gc_inquiry_confirmed', { campaign: 'comunidades_profesionales', placement: root.dataset.college, ...campaign });
          }
          done.querySelector<HTMLElement>('[data-reply-email]')!.textContent = email;
          form.hidden = true;
          done.hidden = false;
          done.focus();
          form.reset(); stamp(); updateCount(); syncHint(); syncServices(); more.open = initiallyOpen;
        } else {
          throw new Error(result.message || t('No se pudo enviar.', 'Your message could not be sent. Please try again.'));
        }
      } catch (err) {
        const reason = responseStatus === 429
          ? t('Hubo varios intentos de envío. Podés continuar por email o volver a intentar más tarde.', 'There have been several attempts. You can send by email or try again later.')
          : responseStatus === 400
            ? t('No se pudo procesar la consulta. Revisá los datos o enviala por email.', 'Your enquiry could not be processed. Check your details or send it by email.')
            : controller.signal.aborted || err instanceof TypeError || (responseStatus && responseStatus < 400)
              ? t('No pudimos confirmar el envío.', 'We couldn’t confirm delivery.')
              : t('El envío web no está disponible en este momento.', 'Web enquiries are temporarily unavailable.');
        errorText.textContent = reason + ' ' + t('Tus datos siguen en el formulario.', 'Your details are still in the form.');
        errorBox.hidden = false;
        updateEmailFallback();
      } finally {
        clearTimeout(deadline);
        fields.disabled = false;
        submit.disabled = false;
        status.textContent = errorBox.hidden ? defaultStatus : '';
        submitLabel.textContent = errorBox.hidden ? defaultSubmitLabel : submit.dataset.retry!;
      }
      if (!errorBox.hidden) errorBox.focus();
    });

    root.querySelector('[data-ctf-again]')?.addEventListener('click', () => {
      done.hidden = true;
      form.hidden = false;
      form.querySelector<HTMLElement>('[required]')?.focus();
    });
  });
</script>

