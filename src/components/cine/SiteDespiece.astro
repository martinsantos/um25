---
/**
 * Despiece de la escena: debajo del banner, la isometría del proyecto (SVG construido en código,
 * `src/assets/cine/isometric/site-*-v2.svg`) con la lista de los ocho frentes. El servicio activo
 * (hover en escritorio, toque en teléfono) enciende su recorrido en la isometría, sus equipos y su
 * pin, y pide al banner de arriba el recorrido de ese servicio en la misma escena. Un solo
 * escenario; nunca un video, una captura ni una miniatura por ítem.
 */
import { SCENE_TITLES, sceneServiceCuts, type Scene } from '../../data/cine/scenes';
import { NAV_SERVICES } from '../../data/navigation';

interface Props { scene: Scene; sectorSlug?: string; sectorName?: string }
const { scene, sectorSlug, sectorName } = Astro.props;
const SITE: Record<Scene, string> = { hospital: 'clinic', aeropuerto: 'terminal', bodega: 'winery', fachada: 'building', planta: 'plant' };
const site = sectorSlug === 'mineria' ? 'mine' : SITE[scene];
const files = import.meta.glob<string>('../../assets/cine/isometric/site-*-v2.svg', { eager: true, query: '?raw', import: 'default' });
const markup = files[`../../assets/cine/isometric/site-${site}-v2.svg`];
const cuts = sceneServiceCuts(scene);
const byCode = new Map(NAV_SERVICES.map((s) => [s.code, s]));
const title = SCENE_TITLES[scene];
const items = cuts.map((cut) => ({ cut, svc: byCode.get(cut.code) }));
const first = items[0];
---
{markup && first && (
  <section class="um-desp" aria-labelledby="um-desp-title" data-despiece data-project-service={first.cut.code}>
    <div class="um-desp__head">
      <h2 id="um-desp-title">{items.length === 8 ? 'Los ocho frentes' : `${items.length} frentes`} en {title.toLowerCase()}.</h2>
      <p>La misma instalación{sectorName ? ` de ${sectorName.toLowerCase()}` : ''}, sistema por sistema. Pasá por un servicio: su recorrido se enciende en el proyecto y la película de arriba cambia de plano.</p>
    </div>
    <div class="um-desp__body">
      <div class="um-desp__stage" data-project-floors={site === 'building' ? 3 : 1}>
        <Fragment set:html={markup} />
        <p class="um-desp__now" aria-live="polite">{first.svc?.name || first.cut.service}</p>
      </div>
      <ol class="um-desp__list">
        {items.map(({ cut, svc }, i) => (
          <li>
            <a class:list={['um-desp__item', { 'is-on': i === 0 }]} href={svc?.href || '/servicios'} data-code={cut.code} data-cut={cut.key} data-name={svc?.name || cut.service}>
              <strong>{svc?.name || cut.service}</strong>
              <span>{svc?.text}</span>
            </a>
          </li>
        ))}
      </ol>
    </div>
  </section>
)}

<script>
  const bootDespiece = () => {
    const fine = matchMedia('(hover: hover) and (pointer: fine)').matches;
    document.querySelectorAll<HTMLElement>('[data-despiece]:not([data-bound])').forEach((root) => {
      root.dataset.bound = 'true';
      const now = root.querySelector<HTMLElement>('.um-desp__now')!;
      // El dibujo llena el escenario: el viewBox se ajusta al contenido real de la isometría.
      const svg = root.querySelector<SVGSVGElement>('.um-desp__stage svg');
      const art = svg?.querySelector<SVGGraphicsElement>('.sp-root');
      if (svg && art) { try { const b = art.getBBox(); const pad = Math.max(b.width, b.height) * 0.04; svg.setAttribute('viewBox', `${b.x - pad} ${b.y - pad} ${b.width + pad * 2} ${b.height + pad * 2}`); svg.setAttribute('preserveAspectRatio', 'xMidYMid meet'); } catch (e) {} }
      const items = [...root.querySelectorAll<HTMLAnchorElement>('[data-code]')];
      const banner = document.querySelector<HTMLElement>('[data-umc]');
      let current = items[0] || null, timer: ReturnType<typeof setTimeout> | undefined;
      const show = (item: HTMLAnchorElement) => {
        if (current === item) return;
        current = item;
        items.forEach((i) => i.classList.toggle('is-on', i === item));
        root.dataset.projectService = item.dataset.code || '';
        now.textContent = item.dataset.name || '';
        clearTimeout(timer);
        timer = setTimeout(() => banner?.dispatchEvent(new CustomEvent('umc:cut', { detail: item.dataset.cut })), 350);
      };
      items.forEach((item) => {
        if (fine) {
          item.addEventListener('pointerenter', () => show(item));
          item.addEventListener('focus', () => show(item));
        } else {
          // Táctil: el primer toque activa, el segundo navega.
          item.addEventListener('click', (event) => { if (current !== item) { event.preventDefault(); show(item); } });
        }
      });
      new IntersectionObserver(([e]) => { root.dataset.visible = String(e.isIntersecting); }, { threshold: .2 }).observe(root);
    });
  };
  bootDespiece();
  document.addEventListener('astro:page-load', bootDespiece);
</script>

<style>
  .um-desp { width: min(var(--um-container-wide), calc(100% - (var(--um-page-gutter) * 2))); margin: 0 auto; padding: clamp(48px, 7vw, 96px) 0 0; color: #fff; }
  .um-desp__head { display: grid; grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr); gap: 16px clamp(28px, 5vw, 80px); align-items: end; margin-bottom: 28px; }
  .um-desp h2 { margin: 0; font-size: clamp(1.9rem, 3vw, 2.6rem) !important; line-height: 1.08 !important; font-weight: 600 !important; text-wrap: balance; }
  .um-desp__head > p { margin: 0; color: rgba(255, 255, 255, 0.78); font-size: 1.0625rem; line-height: 1.6; max-width: 52ch; }
  .um-desp__body { display: grid; grid-template-columns: minmax(0, 8fr) minmax(0, 4fr); gap: clamp(20px, 3vw, 48px); align-items: start; }
  .um-desp__stage { position: sticky; top: 88px; aspect-ratio: 5 / 3; overflow: hidden; background: #0a0b0d; padding: 4%; box-sizing: border-box; }
  .um-desp__stage :global(svg) { position: absolute; inset: 4%; width: 92%; height: 92%; display: block; overflow: visible; }
  /* Las rutas de todos los servicios quedan como trazas; la del servicio activo se enciende. */
  .um-desp :global(.sp-route path) { stroke-width: 1.2; }
  .um-desp :global(.sp-route) { opacity: .09; transition: opacity 800ms ease; }
  .um-desp :global(.sp-pin) { opacity: 0; transition: opacity 600ms ease; }
  .um-desp :global(.sp-leader) { opacity: 0; transition: opacity 900ms ease; }
  .um-desp :global(.sp-effect) { opacity: 0; pointer-events: none; transition: opacity 900ms ease; }
  .um-desp[data-project-service="106"] :global(.sp-route) { opacity: .7; }
  .um-desp[data-project-service="101"] :global(.sp-route--101), .um-desp[data-project-service="102"] :global(.sp-route--102), .um-desp[data-project-service="103"] :global(.sp-route--103), .um-desp[data-project-service="104"] :global(.sp-route--104), .um-desp[data-project-service="105"] :global(.sp-route--105), .um-desp[data-project-service="107"] :global(.sp-route--107), .um-desp[data-project-service="108"] :global(.sp-route--108) { opacity: .94; }
  .um-desp[data-project-service="101"] :global(.sp-pin--101), .um-desp[data-project-service="102"] :global(.sp-pin--102), .um-desp[data-project-service="103"] :global(.sp-pin--103), .um-desp[data-project-service="104"] :global(.sp-pin--104), .um-desp[data-project-service="105"] :global(.sp-pin--105), .um-desp[data-project-service="106"] :global(.sp-pin--106), .um-desp[data-project-service="107"] :global(.sp-pin--107), .um-desp[data-project-service="108"] :global(.sp-pin--108) { opacity: 1; }
  .um-desp[data-project-service="101"] :global([data-project-device="101"]), .um-desp[data-project-service="102"] :global([data-project-device="102"]), .um-desp[data-project-service="103"] :global([data-project-device="103"]), .um-desp[data-project-service="104"] :global([data-project-device="104"]), .um-desp[data-project-service="105"] :global([data-project-device="105"]), .um-desp[data-project-service="107"] :global([data-project-device="107"]), .um-desp[data-project-service="108"] :global([data-project-device="108"]) { stroke: #fff; stroke-opacity: 1; stroke-width: 1; }
  .um-desp[data-project-service="101"] :global(.sp-effect--101), .um-desp[data-project-service="102"] :global(.sp-effect--102), .um-desp[data-project-service="107"] :global(.sp-effect--107) { opacity: 1; }
  /* El recorrido activo se dibuja desde el rack cuando la sección está a la vista. */
  @keyframes um-desp-route { from { stroke-dashoffset: 2400; } to { stroke-dashoffset: 0; } }
  .um-desp[data-visible="true"][data-project-service="101"] :global(.sp-route--101 path), .um-desp[data-visible="true"][data-project-service="102"] :global(.sp-route--102 path), .um-desp[data-visible="true"][data-project-service="103"] :global(.sp-route--103 path), .um-desp[data-visible="true"][data-project-service="104"] :global(.sp-route--104 path), .um-desp[data-visible="true"][data-project-service="105"] :global(.sp-route--105 path), .um-desp[data-visible="true"][data-project-service="107"] :global(.sp-route--107 path), .um-desp[data-visible="true"][data-project-service="108"] :global(.sp-route--108 path) { stroke-dasharray: 2400; animation: um-desp-route 3200ms cubic-bezier(.22, 1, .36, 1) 1 both; }
  .um-desp__now { position: absolute; left: 20px; bottom: 16px; margin: 0; font-size: 1rem; color: rgba(255, 255, 255, 0.85); }
  .um-desp__list { list-style: none; margin: 0; padding: 0; }
  .um-desp__item { display: block; padding: 14px 0; border-top: 1px solid rgba(255, 255, 255, 0.12); color: rgba(255, 255, 255, 0.62); text-decoration: none; transition: color 0.3s ease; }
  .um-desp__list li:last-child .um-desp__item { border-bottom: 1px solid rgba(255, 255, 255, 0.12); }
  .um-desp__item.is-on, .um-desp__item:hover, .um-desp__item:focus-visible { color: #fff; }
  .um-desp__item:focus-visible { outline: 2px solid #dc2626; outline-offset: 2px; }
  .um-desp__item strong { display: inline-block; font-size: 1.1875rem; font-weight: 600; letter-spacing: -0.01em; padding-bottom: 2px; border-bottom: 2px solid transparent; transition: border-color 0.3s ease; }
  .um-desp__item.is-on strong { border-bottom-color: #dc2626; }
  .um-desp__item span { display: block; margin-top: 3px; font-size: 1rem; line-height: 1.45; color: #a1a1aa; }
  @media (max-width: 1100px) { .um-desp__body { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); } }
  @media (max-width: 820px) {
    .um-desp__head { grid-template-columns: 1fr; }
    .um-desp__body { grid-template-columns: 1fr; }
    .um-desp__stage { position: sticky; top: 63px; z-index: 1; aspect-ratio: 4 / 3; }
    .um-desp__item { padding: 11px 0; }
    .um-desp__item strong { font-size: 1.0625rem; }
    .um-desp__item span { display: none; }
  }
  @media (prefers-reduced-motion: reduce) { .um-desp :global(.sp-route path) { animation: none !important; } .um-desp :global(.sp-root), .um-desp :global(.sp-route), .um-desp :global(.sp-pin) { transition: none; } }
</style>
