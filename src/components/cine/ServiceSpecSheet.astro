---
/**
 * Ficha técnica de un frente de servicio: alcance, normas aplicables,
 * entregables, nivel de servicio, equipamiento típico y sectores. Es la
 * tabla de especificaciones que un proveedor global pone junto al alcance.
 * Los datos salen de src/data/serviceSpecs.ts; sin cifras sin fuente.
 */
import type { ServiceSpec } from '../../data/serviceSpecs';

interface Props {
  spec: ServiceSpec;
  /** Enlace a la ficha PDF (si existe). */
  pdfHref?: string | null;
  /** Enlace a la versión imprimible. */
  printHref?: string | null;
  /** Variante compacta para el PDF/impresión (sin acciones). */
  print?: boolean;
}
const { spec, pdfHref = null, printHref = null, print = false } = Astro.props;

const rows: { label: string; items: string[] }[] = [
  { label: 'Alcance', items: spec.scope },
  { label: 'Normas y referencias', items: spec.standards },
  { label: 'Entregables', items: spec.deliverables },
  { label: 'Nivel de servicio', items: spec.serviceLevel },
  { label: 'Equipamiento típico', items: spec.equipment },
];
---
<div class:list={['um-spec', { 'um-spec--print': print }]}>
  <p class="um-spec__caption">
    <span class="um-spec__code">SRV.{spec.code}</span>
    <span>Ficha técnica · {spec.name}</span>
    <span class="um-spec__rev">rev. {spec.revision}</span>
  </p>
  <table class="um-spec__table" aria-label={`Ficha técnica de ${spec.name}`}>
    <tbody>
      {rows.map((row) => (
        <tr>
          <th scope="row">{row.label}</th>
          <td>
            <ul>
              {row.items.map((item) => <li>{item}</li>)}
            </ul>
          </td>
        </tr>
      ))}
      <tr>
        <th scope="row">Sectores</th>
        <td>
          <ul class="um-spec__inline">
            {spec.sectors.map((s) => (
              print ? <li>{s.name}</li> : <li><a href={s.href}>{s.name}</a></li>
            ))}
          </ul>
        </td>
      </tr>
    </tbody>
  </table>
  {!print && (pdfHref || printHref) && (
    <div class="um-spec__actions">
      {pdfHref && <a class="um-spec__btn" href={pdfHref} download>Descargar ficha PDF <span aria-hidden="true">↓</span></a>}
      {printHref && <a class="um-spec__link" href={printHref} target="_blank" rel="noopener">Versión imprimible <span aria-hidden="true">↗</span></a>}
      <p class="um-spec__note">Revisión {spec.revision}. Los valores se ajustan por sitio en el relevamiento técnico.</p>
    </div>
  )}
</div>

<style>
  .um-spec {
    color: var(--x-text, #fafafa);
  }

  .um-spec__table {
    width: 100%;
    border-collapse: collapse;
    border-top: 1px solid var(--x-line-strong, rgba(255, 255, 255, 0.18));
  }

  .um-spec__caption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 6px 14px;
    margin: 0;
    padding: 0 0 14px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--x-text, #fafafa);
  }

  .um-spec__rev {
    margin-left: auto;
    font-family: var(--um-font-mono);
    font-weight: 400;
    color: var(--x-muted, #a1a1aa);
  }

  .um-spec__code {
    font-family: var(--um-font-mono);
    font-weight: 600;
    color: #dc2626;
    letter-spacing: 0.06em;
  }

  .um-spec__table th,
  .um-spec__table td {
    padding: 16px 0;
    border-bottom: 1px solid var(--x-line, rgba(255, 255, 255, 0.12));
    vertical-align: top;
    text-align: left;
  }

  .um-spec__table th {
    width: 220px;
    padding-right: 24px;
    color: var(--x-muted, #a1a1aa);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1.45;
  }

  .um-spec__table ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 6px;
  }

  .um-spec__table li {
    position: relative;
    padding-left: 18px;
    font-size: 1.0625rem;
    line-height: 1.5;
    color: var(--x-text, #fafafa);
  }

  .um-spec__table li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.72em;
    width: 8px;
    height: 1px;
    background: #dc2626;
  }

  .um-spec__inline {
    display: flex !important;
    flex-wrap: wrap;
    gap: 8px 18px !important;
  }

  .um-spec__inline li {
    padding-left: 0;
  }

  .um-spec__inline li::before {
    display: none;
  }

  .um-spec__inline a {
    color: var(--x-text, #fafafa);
    text-decoration: underline;
    text-decoration-color: var(--x-line-strong, rgba(255, 255, 255, 0.18));
    text-underline-offset: 5px;
  }

  .um-spec__inline a:hover,
  .um-spec__inline a:focus-visible {
    text-decoration-color: #dc2626;
  }

  .um-spec__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 14px 22px;
    margin-top: 22px;
  }

  .um-spec__btn {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 20px;
    background: #dc2626;
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
  }

  .um-spec__btn:hover,
  .um-spec__btn:focus-visible {
    background: #b91c1c;
  }

  .um-spec__link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    color: var(--x-text, #fafafa);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid #dc2626;
  }

  .um-spec__note {
    flex-basis: 100%;
    margin: 0;
    color: var(--x-muted, #a1a1aa);
    font-size: 1rem;
  }

  /* Variante impresa / PDF: fondo blanco, texto oscuro, sin acciones. */
  .um-spec--print {
    color: #111;
  }

  .um-spec--print .um-spec__caption,
  .um-spec--print .um-spec__table li,
  .um-spec--print .um-spec__inline li {
    color: #111;
  }

  .um-spec--print .um-spec__table {
    border-top-color: #111;
  }

  .um-spec--print .um-spec__table th,
  .um-spec--print .um-spec__table td {
    border-bottom-color: #d9dadd;
  }

  .um-spec--print .um-spec__table th {
    color: #5f6368;
  }

  @media (max-width: 760px) {
    .um-spec__table,
    .um-spec__table tbody,
    .um-spec__table tr,
    .um-spec__table th,
    .um-spec__table td {
      display: block;
      width: auto;
    }

    .um-spec__table th {
      padding: 14px 0 6px;
      border-bottom: 0;
    }

    .um-spec__table td {
      padding: 0 0 14px;
    }

    .um-spec__btn {
      width: 100%;
      justify-content: center;
    }
  }
</style>
