---
import scene from '../../assets/cine/isometric/network-rack-v10.svg?raw';
import sceneUrl from '../../assets/cine/isometric/network-rack-v10.svg?url';
import geometry from '../../assets/cine/isometric/network-rack-v10.json';
import {NETWORK_EQUIPMENT,EQUIPMENT_KITS} from '../../data/cine/networkAssembly';
interface Props {compact?:boolean;service?:string;catalog?:boolean;guided?:boolean}
const {compact=false,service='101',catalog=false,guided=false}=Astro.props;
const kit=EQUIPMENT_KITS[service]||EQUIPMENT_KITS['101'];
const equipment=catalog?NETWORK_EQUIPMENT:kit.parts.map(id=>NETWORK_EQUIPMENT.find(part=>part.id===id)!);
const views=['Sistema','Equipo','Interior','Detalle'];
---
<figure class:list={['network-journey',{'network-journey--compact':compact,'network-journey--guided':guided}]} data-network-journey data-network-guided={String(guided)} data-network-service={service} data-step="0" data-part={kit.initial} data-open="false">
 <script type="application/json" data-network-kits set:html={JSON.stringify(EQUIPMENT_KITS)} is:inline />
 <div class="network-journey__meta"><span data-network-name>{kit.name}</span><span>Equipos y conexiones</span></div>
 <div class="network-journey__status">
  <span data-network-tag>{kit.name}</span>
  <div><button type="button" data-network-door aria-pressed="false">Abrir gabinete <span aria-hidden="true">↗</span></button><button type="button" data-network-play aria-pressed="false">Ver recorrido <span aria-hidden="true">↗</span></button></div>
 </div>
 <details class="network-journey__explore" data-network-explore>
  <summary><span>Explorar equipos</span><span data-network-count>{kit.parts.length} piezas</span><span class="network-journey__expand" aria-hidden="true">+</span></summary>
  <div class="network-journey__exploration">
   {compact&&<p class="network-journey__service" data-network-name>{kit.name}</p>}
   <label class="network-journey__picker"><span>Equipo</span><select data-network-picker aria-label="Equipo del sistema">{kit.parts.map(id=><option value={id} selected={id===kit.initial}>{NETWORK_EQUIPMENT.find(part=>part.id===id)!.name}</option>)}</select></label>
   <div class="network-journey__controls" role="group" aria-label="Vistas del equipo">
    {views.map((view,i)=><button type="button" data-network-select={i} aria-pressed={String(i===0)}>{view}</button>)}
   </div>
  </div>
 </details>
 <div class="network-journey__library" hidden role="group" aria-label="Equipos de la instalación">
  <span class="network-journey__library-label">Extraer del sistema</span>
  <div class="network-journey__equipment">
   {equipment.map((equipment)=>{
    const model=geometry.models.find(m=>m.id===equipment.id)!;
    return <button type="button" data-network-part={equipment.id} data-location={model.z>0?'rack':'field'} data-title={equipment.title} data-copy={equipment.copy} data-points={JSON.stringify(equipment.points)} data-construction={equipment.construction} data-inside={equipment.inside} data-detail={equipment.detail} data-closeup={equipment.closeup} data-slot-x={model.slotX} data-slot-y={model.slotY} data-scale={model.scale} data-lift-x={model.lift[0]} data-lift-y={model.lift[1]} data-detail-scale={model.detailScale} data-piece-y={model.pieceY} data-open-y={model.openY} data-mobile-piece-y={model.mobilePieceY} hidden={!kit.parts.includes(equipment.id)} aria-pressed={String(equipment.id===kit.initial)}>{equipment.name}</button>;
   })}
  </div>
 </div>
 <ol class="network-journey__context" data-network-context aria-label="Recorrido del servicio">{kit.context.map((text,i)=><li>{i>0&&<span aria-hidden="true">→</span>}{text}</li>)}</ol>
 <div class="network-journey__canvas">{guided && <div class="network-journey__loading" data-network-source={sceneUrl} aria-live="polite"></div>}{!guided && <Fragment set:html={scene} />}</div>
 <figcaption class="network-journey__caption"><h3 data-network-title>{kit.overview}</h3><p data-network-copy>{kit.description}</p><ul class="network-journey__points" data-network-points hidden /></figcaption>
 <p class="network-journey__announcement" data-network-announce aria-live="polite" aria-atomic="true" />
</figure>
<script src="/cine/network-rack-v13.js" type="module" async is:inline />
