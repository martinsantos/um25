---
import scene from '../../assets/cine/isometric/network-rack-v8.svg?raw';
import geometry from '../../assets/cine/isometric/network-rack-v8.json';
import {NETWORK_EQUIPMENT,EQUIPMENT_KITS} from '../../data/cine/networkAssembly';
interface Props {compact?:boolean;service?:string;catalog?:boolean}
const {compact=false,service='101',catalog=false}=Astro.props;
const kit=EQUIPMENT_KITS[service]||EQUIPMENT_KITS['101'];
const equipment=catalog?NETWORK_EQUIPMENT:kit.parts.map(id=>NETWORK_EQUIPMENT.find(part=>part.id===id)!);
const views=[service==='101'||service==='108'?'Gabinete':'Proyecto','Pieza','Despiece','Conexión'];
---
<figure class:list={['network-journey',{'network-journey--compact':compact}]} data-network-journey data-network-service={service} data-step="0" data-part={kit.initial} data-open="false">
 <script type="application/json" data-network-kits set:html={JSON.stringify(EQUIPMENT_KITS)} is:inline />
 <div class="network-journey__meta"><span data-network-name>{kit.name}</span><span data-network-count>{kit.parts.length} elementos del sistema.</span></div>
 <div class="network-journey__status">
  <span data-network-tag>18U · cobre / fibra / cómputo / energía</span>
  <div><button type="button" data-network-door aria-pressed="false">Abrir gabinete <span aria-hidden="true">↗</span></button><button type="button" data-network-play aria-pressed="false">Ver recorrido <span aria-hidden="true">↗</span></button></div>
 </div>
 <div class="network-journey__controls" role="group" aria-label="Vistas del equipo">
  {views.map((view,i)=><button type="button" data-network-select={i} aria-pressed={String(i===0)}><span>0{i+1}</span>{view}</button>)}
 </div>
 <div class="network-journey__library" role="group" aria-label="Equipos de la instalación">
  <span class="network-journey__library-label">Extraer del sistema</span>
  <div class="network-journey__equipment">
   {equipment.map((equipment)=>{
    const model=geometry.models.find(m=>m.id===equipment.id)!;
    return <button type="button" data-network-part={equipment.id} data-location={model.z>0?'rack':'field'} data-title={equipment.title} data-copy={equipment.copy} data-construction={equipment.construction} data-inside={equipment.inside} data-detail={equipment.detail} data-closeup={equipment.closeup} data-slot-x={model.slotX} data-slot-y={model.slotY} data-scale={model.scale} data-lift-x={model.lift[0]} data-lift-y={model.lift[1]} data-detail-scale={model.detailScale} data-piece-y={model.pieceY} data-open-y={model.openY} data-mobile-piece-y={model.mobilePieceY} hidden={!kit.parts.includes(equipment.id)} aria-pressed={String(equipment.id===kit.initial)}>{equipment.name}</button>;
   })}
  </div>
 </div>
 <label class="network-journey__picker"><span>Equipo</span><select data-network-picker aria-label="Equipo del sistema">{kit.parts.map(id=><option value={id} selected={id===kit.initial}>{NETWORK_EQUIPMENT.find(part=>part.id===id)!.name}</option>)}</select></label>
 <div class="network-journey__canvas" set:html={scene} />
 {!compact && <figcaption class="network-journey__caption"><h3 data-network-title>{kit.overview}</h3><p data-network-copy>{kit.description}</p></figcaption>}
 <p class="network-journey__announcement" data-network-announce aria-live="polite" aria-atomic="true" />
</figure>
<script src="/cine/network-rack-v8.js" type="module" is:inline />
<style>
 .network-journey{margin:0;padding:24px 28px 0;background:#08090a;color:#fff;min-width:0;overflow:hidden;--x-text:#fff;--x-text-2:#c4c7cc}
 .network-journey__meta{display:flex;justify-content:space-between;gap:16px;font-size:1rem;color:#c4c7cc;line-height:1.5;padding-bottom:16px;border-bottom:1px solid #ffffff24}
 .network-journey__meta span:first-child{color:#fff;font-weight:600}
 .network-journey__canvas{height:clamp(400px,35vw,500px);position:relative;overflow:hidden}
 .network-journey__canvas :global(svg){position:absolute;inset:0;width:100%;height:100%!important;display:block;overflow:visible}
 .network-journey :global(.rk-cabinet),.network-journey :global(.rk-ground){transform:translate(505px,555px) scale(.43);transform-origin:0 0;transition:transform 1000ms cubic-bezier(.22,1,.36,1),opacity 600ms ease}
 .network-journey :global(.rk-ground){opacity:.55}
 .network-journey :global(.rk-door){transform:translate(var(--hinge-x),var(--hinge-y)) matrix(.866025404,.5,0,1,0,0);transition:transform 1100ms cubic-bezier(.22,1,.36,1);transform-origin:0 0}
 .network-journey[data-open="true"] :global(.rk-door){transform:translate(var(--hinge-x),var(--hinge-y)) matrix(-1.003442,.405579788,0,1,0,0)}
 .network-journey :global(.rk-rail){transition:transform 600ms cubic-bezier(.22,1,.36,1)}
 .network-journey :global(.rk-mounted){cursor:pointer}
 .network-journey :global(.rk-mounted[data-preview] .rk-rail){transform:translate(-69.282032px,40px)}
 .network-journey :global(.rk-rail){transition:transform 600ms cubic-bezier(.22,1,.36,1),opacity 400ms ease}
 .network-journey :global(.rk-slot-outline),.network-journey :global(.rk-leader){opacity:0;transition:opacity 400ms ease}
 .network-journey :global(.rk-focus){--part-scale:.98;--lift-x:52px;--lift-y:-175px;transform:translate(calc(505px + var(--slot-x)*.43),calc(555px + var(--slot-y)*.43)) scale(.43);transform-origin:0 0;opacity:0;transition:transform 1000ms cubic-bezier(.22,1,.36,1),opacity 500ms ease}
 .network-journey :global(.rk-cover){transform:translate(0,0);transition:transform 1000ms cubic-bezier(.22,1,.36,1)}
 .network-journey :global(.rk-guides){opacity:0;transition:opacity 450ms ease}
 .network-journey[data-step="2"] :global(.rk-guides){opacity:.55}
 .network-journey :global(.rk-detail){--detail-scale:.78;transform:translate(510px,510px) scale(.08);opacity:0;transform-origin:0 0;transition:transform 1000ms cubic-bezier(.22,1,.36,1),opacity 500ms ease}
 .network-journey :global(.rk-external){transform:translate(905px,430px) scale(.43);transform-origin:0 0;transition:opacity 500ms ease}
 .network-journey :global(.rk-external-link){transition:opacity 350ms ease}
 .network-journey :global(.rk-peripheral){display:none;cursor:pointer}
 .network-journey[data-network-service="101"] :global(.rk-peripheral[data-context-services="101"]),.network-journey[data-network-service="102"] :global(.rk-peripheral[data-context-services="102"]),.network-journey[data-network-service="103"] :global(.rk-peripheral[data-context-services="103"]),.network-journey[data-network-service="107"] :global(.rk-peripheral[data-context-services="107"]){display:block}
 .network-journey:not([data-network-service="101"]) :global(.rk-external-link),.network-journey:not([data-network-service="101"]) :global(.rk-overview-label){display:none}
 .network-journey :global(.rk-peripherals){transition:opacity 400ms ease}
 .network-journey[data-open="false"] :global(.rk-system-wire){opacity:0}
 .network-journey[data-step="1"] :global(.rk-peripherals),.network-journey[data-step="2"] :global(.rk-peripherals),.network-journey[data-step="3"] :global(.rk-peripherals){opacity:0;pointer-events:none}
 .network-journey :global(.rk-context-object){transform:translate(395px,562px) scale(.35);transform-origin:0 0;opacity:0;pointer-events:none}
 .network-journey[data-location="field"]:not([data-step="0"]) :global(.rk-context-object){opacity:.65}
 .network-journey[data-open="false"] :global(.rk-external-link),.network-journey[data-step="1"] :global(.rk-external-link),.network-journey[data-step="2"] :global(.rk-external-link),.network-journey[data-step="3"] :global(.rk-external-link){opacity:0}
 .network-journey :global(.rk-context-label){opacity:0;transition:opacity 500ms ease}
 .network-journey :global(.rk-patching){transition:opacity 350ms ease}
 .network-journey[data-step="1"] :global(.rk-cabinet),.network-journey[data-step="2"] :global(.rk-cabinet),.network-journey[data-step="3"] :global(.rk-cabinet){transform:translate(245px,517px) scale(.24);opacity:.7}
 .network-journey[data-step="1"] :global(.rk-ground),.network-journey[data-step="2"] :global(.rk-ground),.network-journey[data-step="3"] :global(.rk-ground),.network-journey[data-step="1"] :global(.rk-external),.network-journey[data-step="2"] :global(.rk-external),.network-journey[data-step="3"] :global(.rk-external),.network-journey[data-step="1"] :global(.rk-overview-label),.network-journey[data-step="2"] :global(.rk-overview-label),.network-journey[data-step="3"] :global(.rk-overview-label){opacity:0}
 .network-journey[data-step="1"] :global(.rk-context-label),.network-journey[data-step="2"] :global(.rk-context-label),.network-journey[data-step="3"] :global(.rk-context-label){opacity:1}
 .network-journey[data-step="1"] :global(.rk-focus){transform:translate(803px,var(--piece-y,370px)) scale(var(--part-scale));opacity:1}
 .network-journey[data-step="2"] :global(.rk-focus){transform:translate(788px,var(--open-y,473px)) scale(var(--part-scale));opacity:1}
 .network-journey[data-step="2"] :global(.rk-cover){transform:translate(var(--lift-x),var(--lift-y))}
 .network-journey[data-step="1"] :global(.rk-mounted[data-selected] .rk-rail),.network-journey[data-step="2"] :global(.rk-mounted[data-selected] .rk-rail),.network-journey[data-step="3"] :global(.rk-mounted[data-selected] .rk-rail){opacity:.14}
 .network-journey[data-step="1"] :global(.rk-slot-outline),.network-journey[data-step="2"] :global(.rk-slot-outline),.network-journey[data-step="3"] :global(.rk-slot-outline){opacity:0}
 .network-journey[data-step="1"] :global(.rk-mounted[data-selected] .rk-slot-outline),.network-journey[data-step="2"] :global(.rk-mounted[data-selected] .rk-slot-outline),.network-journey[data-step="3"] :global(.rk-mounted[data-selected] .rk-slot-outline){opacity:1}
 .network-journey[data-step="1"] :global(.rk-leader),.network-journey[data-step="2"] :global(.rk-leader){opacity:.7}
 .network-journey[data-step="1"] :global(.rk-patching),.network-journey[data-step="2"] :global(.rk-patching),.network-journey[data-step="3"] :global(.rk-patching){opacity:.22}
 .network-journey[data-step="3"] :global(.rk-focus){transform:translate(461px,584px) scale(.28);opacity:.55}
 .network-journey[data-step="3"] :global(.rk-detail){transform:translate(811px,330px) scale(var(--detail-scale));opacity:1}
 .network-journey[data-motion-scope="part"] :global(.rk-focus),.network-journey[data-motion-scope="part"] :global(.rk-detail),.network-journey[data-motion-scope="part"] :global(.rk-cover){transition:opacity 180ms ease}
 .network-journey__status{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:54px;color:#c4c7cc;font-size:1rem;line-height:1.5}
 .network-journey__status>div{display:flex;gap:24px}
 .network-journey__status button{border:0;background:none;color:#fff;cursor:pointer;min-height:54px;padding:10px 0;white-space:normal;text-align:left;font:500 1rem var(--um-font-body,'UM Sans',Arial,sans-serif)}
 .network-journey__status button span{margin-left:8px}
 .network-journey__controls{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid #ffffff36}
 .network-journey__controls button{display:flex;gap:12px;align-items:center;justify-content:center;min-height:56px;padding:12px 8px;font:500 1rem var(--um-font-body,'UM Sans',Arial,sans-serif);color:#c4c7cc;background:none;border:0;border-bottom:2px solid transparent;cursor:pointer}
 .network-journey__controls button[aria-pressed=true]{color:#fff;border-bottom-color:#dc2626;background:#ffffff06}
 .network-journey__controls button span{color:#c4c7cc;font-variant-numeric:tabular-nums}
 .network-journey__library{padding:17px 0;border-top:1px solid #ffffff24;display:flex;gap:20px;align-items:center}
 .network-journey__library-label{color:#c4c7cc;font-size:1rem;white-space:nowrap}
 .network-journey__hint{display:none}
 .network-journey__equipment::-webkit-scrollbar{display:none}
 .network-journey__equipment{scrollbar-width:none;display:flex;flex-wrap:wrap;column-gap:20px;row-gap:0;min-width:0}
 .network-journey__equipment button{position:relative;min-height:44px;background:none;border:0;padding:8px 0;color:#c4c7cc;cursor:pointer;font:500 1rem var(--um-font-body,'UM Sans',Arial,sans-serif);white-space:nowrap}
 .network-journey__equipment button[aria-pressed=true]{color:#fff}
 .network-journey__equipment button[aria-pressed=true]::after{content:'';position:absolute;left:0;right:0;bottom:3px;height:2px;background:#dc2626}
 .network-journey__picker{display:none;min-width:0}
 .network-journey button:focus-visible{outline:2px solid #fff;outline-offset:3px}
 .network-journey [hidden]{display:none!important}
 .network-journey__caption{padding:24px 0 28px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:32px;border-top:1px solid #ffffff24}
 .network-journey__caption h3{font-size:1.3rem;line-height:1.35;font-weight:600;margin:0;color:#fff;max-width:34ch}
 .network-journey__caption p{font-size:1rem;line-height:1.65;margin:0;color:#c4c7cc;max-width:60ch}
 .network-journey__announcement{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
 .network-journey--compact{padding:0 24px;display:flex;flex-direction:column}
 .network-journey--compact .network-journey__meta{display:none}
 .network-journey--compact .network-journey__canvas{height:clamp(290px,28vw,350px);order:0}
 .network-journey--compact :global(.rk-view-labels){display:none}
 .network-journey--compact .network-journey__status{order:1;flex-wrap:wrap;gap:0;padding-top:8px}
 .network-journey--compact .network-journey__status>span{display:none}
 .network-journey--compact .network-journey__status>div{width:100%;justify-content:space-between}
 .network-journey--compact .network-journey__controls{order:2;grid-template-columns:repeat(4,minmax(0,1fr))}
 .network-journey--compact .network-journey__library{order:3;display:block;padding:8px 0}
 .network-journey--compact .network-journey__library-label{display:none}
 .network-journey--compact .network-journey__equipment{column-gap:18px;flex-wrap:wrap;overflow-x:visible;padding:4px 0}
 .network-journey--compact .network-journey__hint{display:inline}
 .network-journey--compact .network-journey__picker{order:3}
 @media(max-width:1000px){.network-journey__library{display:block}.network-journey__library-label{display:block;margin-bottom:6px}}
 @media(max-width:760px){
  .network-journey{padding:16px 12px 0}
  .network-journey__meta{display:flex;gap:8px;padding-bottom:8px}.network-journey__meta span+span{display:none}
  .network-journey__canvas{height:360px}
  .network-journey__canvas :global(svg){width:160%;left:-34%;max-width:none}
  .network-journey :global(.rk-overview-label),.network-journey :global(.rk-context-label),.network-journey :global(.rk-ground){display:none}
  .network-journey :global(.rk-cabinet){transform:translate(700px,600px) scale(.54)}
  .network-journey[data-open="true"] :global(.rk-door){transform:translate(var(--hinge-x),var(--hinge-y)) matrix(-.517638090,.640856382,0,1,0,0)}
  .network-journey :global(.rk-external),.network-journey :global(.rk-external-link){display:none}
  .network-journey :global(.rk-context-object){display:none}
  .network-journey[data-network-service="101"] :global(.rk-peripherals){display:none}
  .network-journey[data-step="0"]:not([data-network-service="101"]) :global(.rk-cabinet){transform:translate(518.83721px,561.39535px) scale(.28)}
  .network-journey[data-step="0"]:not([data-network-service="101"]) :global(.rk-peripherals){transform:translate(190px,200px) scale(.65116279);transform-origin:0 0}
  .network-journey__status button span{display:none}
  .network-journey[data-step="1"] :global(.rk-cabinet),.network-journey[data-step="2"] :global(.rk-cabinet),.network-journey[data-step="3"] :global(.rk-cabinet){transform:translate(130px,568px) scale(.16);opacity:0}
  .network-journey[data-step="1"] :global(.rk-focus){transform:translate(658px,var(--mobile-piece-y,366px)) scale(calc(var(--part-scale)*1.08))}
  .network-journey[data-step="2"] :global(.rk-focus){transform:translate(640px,484px) scale(calc(var(--part-scale)*1.02))}
  .network-journey[data-step="3"] :global(.rk-focus){opacity:0}
  .network-journey[data-step="3"] :global(.rk-detail){transform:translate(653px,313px) scale(calc(var(--detail-scale)*1.08))}
  .network-journey[data-step="3"][data-part="switch"] :global(.rk-detail),.network-journey[data-step="3"][data-part="access"] :global(.rk-detail){transform:translate(683px,313px) scale(calc(var(--detail-scale)*1.08))}
  .network-journey[data-step="3"][data-part="outlet"] :global(.rk-detail),.network-journey[data-step="3"][data-part="injector"] :global(.rk-detail){transform:translate(683px,313px) scale(calc(var(--detail-scale)*1.08))}
  .network-journey[data-step="1"][data-part="server"] :global(.rk-focus){transform:translate(645px,366px) scale(calc(var(--part-scale)*1.05))}
  .network-journey[data-step="1"][data-part="ups"] :global(.rk-focus){transform:translate(640px,366px) scale(calc(var(--part-scale)*1.04))}
  .network-journey[data-step="2"][data-part="server"] :global(.rk-focus){transform:translate(638px,484px) scale(calc(var(--part-scale)*.99))}
  .network-journey[data-step="2"][data-part="fiber"] :global(.rk-focus){transform:translate(684px,484px) scale(calc(var(--part-scale)*.98))}
  .network-journey[data-step="2"][data-part="manager"] :global(.rk-focus){transform:translate(674px,484px) scale(calc(var(--part-scale)*1.02))}
  .network-journey[data-step="2"][data-part="access"] :global(.rk-focus){transform:translate(630px,484px) scale(calc(var(--part-scale)*1.02))}
  .network-journey__status{flex-wrap:wrap;gap:0;padding-top:10px}
  .network-journey__status>span{display:none}
  .network-journey__status>div{width:100%;justify-content:space-between;gap:12px}
  .network-journey__controls{grid-template-columns:repeat(4,minmax(0,1fr));column-gap:6px}
  .network-journey__controls button{min-height:56px;padding:8px 2px;gap:0}
  .network-journey__controls button span{display:none}
  .network-journey__library{display:none}
  .network-journey__picker{display:flex;gap:12px;align-items:center;padding:12px 0;color:#c4c7cc;font-size:1rem}
  .network-journey__picker select{min-width:0;flex:1;min-height:44px;border:1px solid #ffffff36;border-radius:0;background:#151b20;color:#fff;font:500 1rem var(--um-font-body,'UM Sans',Arial,sans-serif);padding:8px 12px;color-scheme:dark;cursor:pointer}
  .network-journey__picker select:focus-visible{outline:2px solid #fff;outline-offset:3px}
  .network-journey__hint{display:inline}
  .network-journey__caption{grid-template-columns:1fr;gap:12px;padding:20px 0 24px}
  .network-journey--compact{padding:0 12px}
  .network-journey--compact .network-journey__canvas{height:320px}
  .network-journey--compact .network-journey__controls{grid-template-columns:repeat(4,minmax(0,1fr))}
  .network-journey--compact .network-journey__library{display:none}
  .network-journey--compact .network-journey__equipment{flex-wrap:nowrap;overflow-x:auto}
  .network-journey :global(.rk-leader){display:none}
 }
 @media(prefers-reduced-motion:no-preference){
  .network-journey[data-visible="true"][data-open="true"][data-step="0"] :global(.rk-signal){animation:rk-signal 2.4s linear 3 both}
  .network-journey[data-visible="true"][data-step="3"][data-part="switch"] :global(#rk-switch-detail .rk-plug),.network-journey[data-visible="true"][data-step="3"][data-part="access"] :global(#rk-access-detail .rk-plug){animation:rk-insert 2.8s cubic-bezier(.22,1,.36,1) 1 both}
  .network-journey[data-visible="true"][data-step="3"][data-part="outlet"] :global(#rk-outlet-detail .rk-plug),.network-journey[data-visible="true"][data-step="3"][data-part="injector"] :global(#rk-injector-detail .rk-plug){animation:rk-insert 2.8s cubic-bezier(.22,1,.36,1) 1 both}
 }
 @keyframes rk-signal{to{stroke-dashoffset:0}}
 @keyframes rk-insert{0%,20%{transform:translate(0,0)}75%,100%{transform:translate(15.588457px,-9px)}}
 @media(prefers-reduced-motion:reduce){.network-journey :global(g){transition:none!important}.network-journey :global(.rk-signal),.network-journey :global(.rk-plug){animation:none!important}}
</style>
