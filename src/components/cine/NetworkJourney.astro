---
import scene from '../../assets/cine/isometric/network-journey-v7.svg?raw';
interface Props {compact?:boolean}
const {compact=false}=Astro.props;
const views=[
 {label:'En el proyecto',title:'El switch está en la sala IT.',copy:'Desde el rack, la red llega a los puestos de trabajo a través de la bandeja y el cableado de cada punto.',tag:'Ubicación · sala IT → puestos'},
 {label:'La pieza',title:'Un switch. Cada conexión visible.',copy:'24 puertos RJ45, cuatro SFP para fibra y una consola. Las orejas, las fijaciones y la ventilación pertenecen al mismo chasis.',tag:'Equipo · 24 RJ45 / 4 SFP / consola'},
 {label:'Despiece',title:'La cubierta se abre; el equipo conserva su lugar.',copy:'La chapa plegada se separa para mostrar los módulos de conexión, la placa y la disipación. El proyecto permanece a la izquierda.',tag:'Construcción · cubierta / electrónica / montaje'},
 {label:'El puerto',title:'El detalle sale de la misma pieza.',copy:'El puerto 06 lleva al jack: blindaje, espacio para la traba y ocho contactos. Una conexión física dentro de una red completa.',tag:'Detalle · jack RJ45 / ocho contactos'},
];
---
<figure class:list={['network-journey',{'network-journey--compact':compact}]} data-network-journey data-step="0">
 <div class="network-journey__meta"><span>Redes de datos</span><span>Del proyecto a la conexión</span></div>
 <div class="network-journey__canvas" set:html={scene} />
 <div class="network-journey__status"><span data-network-tag>{views[0].tag}</span><button type="button" data-network-play aria-pressed="false">Ver recorrido <span aria-hidden="true">↗</span></button></div>
 <div class="network-journey__controls" role="group" aria-label="Escalas de la red">
  {views.map((view,i)=><button type="button" data-network-select={i} data-title={view.title} data-copy={view.copy} data-tag={view.tag} aria-pressed={String(i===0)}><span>0{i+1}</span>{view.label}</button>)}
 </div>
 {!compact && <figcaption class="network-journey__caption"><h3 data-network-title>{views[0].title}</h3><p data-network-copy>{views[0].copy}</p></figcaption>}
 <p class="network-journey__announcement" data-network-announce aria-live="polite" aria-atomic="true" />
</figure>
<script src="/cine/network-journey-v7.js" type="module" is:inline />
<style>
 .network-journey{margin:0;padding:24px 28px 0;background:#11171d;color:#fff;min-width:0;overflow:hidden;--x-text:#fff;--x-text-2:#c4c7cc}
 .network-journey__meta{display:flex;justify-content:space-between;gap:16px;font-size:1rem;color:#c4c7cc;line-height:1.5;padding-bottom:16px;border-bottom:1px solid #ffffff24}
 .network-journey__meta span:first-child{color:#fff;font-weight:600}
 .network-journey__canvas{height:clamp(360px,33vw,460px);position:relative;overflow:hidden}
 .network-journey__canvas :global(svg){position:absolute;inset:0;width:100%;height:100%!important;display:block;overflow:visible}
 .network-journey :global(.nj-project){transform:translate(580px,398px) scale(1);transform-origin:0 0;transition:transform 1000ms cubic-bezier(.22,1,.36,1),opacity 600ms ease;opacity:1}
 .network-journey :global(.nj-device){transform:translate(453.9px,162.2px) scale(.048);transform-origin:0 0;transition:transform 1000ms cubic-bezier(.22,1,.36,1),opacity 300ms ease;opacity:1}
 .network-journey :global(.nj-shadow){opacity:0;transition:opacity 400ms ease}
 .network-journey :global(.nj-detail){transform:translate(585px,454px) scale(.035);transform-origin:0 0;opacity:0;transition:transform 1000ms cubic-bezier(.22,1,.36,1),opacity 400ms ease}
 .network-journey :global(.nj-connection),.network-journey :global(.nj-port-focus){opacity:0;transition:opacity 300ms ease}
 .network-journey :global(.nj-internals),.network-journey :global(.nj-guides){opacity:0;transition:opacity 280ms ease}
 .network-journey :global(.nj-cover){transform:translate(0,0);transition:transform 900ms cubic-bezier(.22,1,.36,1)}
 .network-journey[data-step="1"] :global(.nj-project),.network-journey[data-step="2"] :global(.nj-project),.network-journey[data-step="3"] :global(.nj-project){transform:translate(222px,342px) scale(.46);opacity:.7}
 .network-journey[data-step="1"] :global(.nj-device){transform:translate(820px,397px) scale(.91)}
 .network-journey[data-step="2"] :global(.nj-device){transform:translate(790px,480px) scale(.78)}
 .network-journey[data-step="2"] :global(.nj-cover){transform:translate(80px,-230px)}
 .network-journey[data-step="2"] :global(.nj-internals){opacity:1}
 .network-journey[data-step="3"] :global(.nj-device){transform:translate(361px,579px) scale(.25);opacity:.45}
 .network-journey[data-step="3"] :global(.nj-detail){transform:translate(826px,377px) scale(.91);opacity:1}
 .network-journey[data-step="1"] :global(.nj-shadow),.network-journey[data-step="2"] :global(.nj-shadow){opacity:.12}
 .network-journey[data-step="1"] :global(.nj-connection),.network-journey[data-step="2"] :global(.nj-connection){opacity:.75}
 .network-journey[data-step="1"] :global(.nj-port-focus){opacity:1}
 .network-journey__status{display:flex;align-items:center;justify-content:space-between;gap:16px;min-height:54px;color:#c4c7cc;font-size:1rem;line-height:1.5;border-top:1px solid #ffffff24}
 .network-journey__status button{border:0;background:none;color:#fff;cursor:pointer;min-height:54px;padding:10px 0 10px 16px;white-space:nowrap;font:500 1rem var(--um-font-body,'UM Sans',Arial,sans-serif)}
 .network-journey__status button span{margin-left:8px}
 .network-journey__controls{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));border-top:1px solid #ffffff36}
 .network-journey__controls button{display:flex;gap:12px;align-items:center;justify-content:center;min-height:56px;padding:12px 8px;font:500 1rem var(--um-font-body,'UM Sans',Arial,sans-serif);color:#c4c7cc;background:none;border:0;border-bottom:2px solid transparent;cursor:pointer}
 .network-journey__controls button[aria-pressed=true]{color:#fff;border-bottom-color:#dc2626;background:#ffffff06}
 .network-journey__controls button span{color:#c4c7cc;font-variant-numeric:tabular-nums}
 .network-journey button:focus-visible{outline:2px solid #fff;outline-offset:-4px}
 .network-journey__caption{padding:24px 0 28px;display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1.2fr);gap:32px;border-top:1px solid #ffffff24}
 .network-journey__caption h3{font-size:1.3rem;line-height:1.35;font-weight:600;margin:0;color:#fff;max-width:34ch}
 .network-journey__caption p{font-size:1rem;line-height:1.65;margin:0;color:#c4c7cc;max-width:60ch}
 .network-journey__announcement{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
 .network-journey--compact :global(.nj-label){display:none}
 .network-journey--compact{padding:0;background:transparent}
 .network-journey--compact .network-journey__meta{display:none}
 .network-journey--compact .network-journey__canvas{height:clamp(320px,29vw,410px)}
 .network-journey--compact .network-journey__status{align-items:flex-start;padding-top:8px;gap:8px}
 .network-journey--compact .network-journey__status>span{max-width:26ch;padding-top:10px}
 .network-journey--compact .network-journey__controls{grid-template-columns:1fr 1fr}
 .network-journey--compact .network-journey__controls button{justify-content:flex-start}
 @media(hover:hover){.network-journey__controls button:hover{background:#ffffff09;color:#fff}.network-journey__status button:hover{text-decoration:underline;text-underline-offset:5px}}
 @media(max-width:760px){.network-journey[data-step="3"] :global(.nj-detail){transform:translate(790px,377px) scale(.76)}.network-journey[data-step="3"] :global(.nj-device){opacity:0}.network-journey :global(.nj-label){display:none}.network-journey{padding:20px 16px 0}.network-journey__meta{display:grid;gap:4px}.network-journey__canvas{height:350px;margin-inline:-12px}.network-journey__controls{grid-template-columns:1fr 1fr}.network-journey__controls button{justify-content:flex-start;padding:12px 8px;gap:10px}.network-journey__status{align-items:flex-start;gap:8px}.network-journey__status>span{font-size:1rem;max-width:24ch;padding-block:12px}.network-journey__caption{grid-template-columns:1fr;gap:12px;padding:20px 0 24px}.network-journey[data-step="1"] :global(svg),.network-journey[data-step="2"] :global(svg),.network-journey[data-step="3"] :global(svg){width:180%;left:-65%}.network-journey[data-step="1"] :global(.nj-project),.network-journey[data-step="2"] :global(.nj-project),.network-journey[data-step="3"] :global(.nj-project),.network-journey[data-step="1"] :global(.nj-connection),.network-journey[data-step="2"] :global(.nj-connection){opacity:0}.network-journey--compact{padding:0}.network-journey--compact .network-journey__canvas{height:340px}}
 @media(prefers-reduced-motion:reduce){.network-journey :global(.nj-project),.network-journey :global(.nj-device),.network-journey :global(.nj-detail),.network-journey :global(.nj-cover){transition:none}}
</style>
