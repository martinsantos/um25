---
// Grilla de movies v4 (escena × servicio). Cada tarjeta muestra el póster; al pasar el
// mouse o enfocarla reproduce la vista previa liviana, y al elegirla abre la sala:
// la movie en 1080p (recorte cuadrado en teléfonos) con anterior/siguiente y los
// enlaces al servicio y al sector. Con `filters`, chips para filtrar por escena o servicio.
import type { Film } from '../../data/cine/films';
import { CINE_SCENES, CINE_SERVICES } from '../../data/cine/films';
import { SCENE_TITLES, SECTORS } from '../../data/cine/scenes';

interface Props {
  films: Film[];
  id?: string;
  kicker?: string;
  title: string;
  lead?: string;
  /** Qué se lee en cada tarjeta: el servicio (grilla de una escena) o la escena (de un servicio). */
  label?: 'service' | 'scene' | 'both';
  filters?: boolean;
  /** Filtro inicial con `filters` ("scene:bodega", "service:redes"); vacío = todas. */
  initial?: string;
  tone?: 'dark' | 'light';
}
const { films, id = 'movies', kicker, title, lead, label = 'both', filters = false, initial = '', tone = 'dark' } = Astro.props;
const [initKind, initValue] = filters ? initial.split(':') : [];
const shown = (f: Film) => !initKind || (initKind === 'scene' ? f.scene : f.service.key) === initValue;
const sectorHref = (scene: string) => `/${SECTORS.find((s) => s.scene === scene)?.slug || 'sectores'}`;
const scenes = CINE_SCENES.filter((s) => films.some((f) => f.scene === s));
const services = CINE_SERVICES.filter((s) => films.some((f) => f.service.key === s.key));
const data = films.map((f) => ({
  id: f.id, src: f.src, sq: f.sq, poster: f.poster,
  scene: f.sceneTitle, service: f.service.name, color: f.service.color,
  serviceHref: f.service.href, sectorHref: sectorHref(f.scene),
}));
---
{films.length > 0 && (
<section class:list={['umf', `umf--${tone}`]} id={id} aria-labelledby={`${id}-title`} data-umf data-films={JSON.stringify(data)}>
  <div class="umf-head">
    {kicker && <p class="umf-kicker">{kicker}</p>}
    <h2 id={`${id}-title`}>{title}</h2>
    {lead && <p class="umf-lead">{lead}</p>}
    {filters && (
      <div class="umf-filters" role="group" aria-label="Filtrar movies">
        <button type="button" data-umf-filter="" aria-pressed={String(!initKind)}>Todas <small>{films.length}</small></button>
        {scenes.map((s) => <button type="button" data-umf-filter={`scene:${s}`} aria-pressed={String(initial === `scene:${s}`)}>{SCENE_TITLES[s]}</button>)}
        <span class="umf-filters__sep" aria-hidden="true"></span>
        {services.map((s) => <button type="button" data-umf-filter={`service:${s.key}`} aria-pressed={String(initial === `service:${s.key}`)} style={`--c:${s.color}`}><i></i>{s.short}</button>)}
      </div>
    )}
  </div>
  <ul class="umf-grid" data-rail={title}>
    {films.map((f, i) => (
      <li data-scene={f.scene} data-service={f.service.key} hidden={!shown(f)}>
        <button type="button" class="umf-card" data-umf-open={i} style={`--c:${f.service.color}`}
          aria-label={`Ver la movie: ${f.service.name} en ${f.sceneTitle}`}>
          <span class="umf-media">
            <img src={f.poster} alt="" width="1920" height="1080" loading={i < 4 ? 'eager' : 'lazy'} decoding="async" />
            <video muted loop playsinline preload="none" disablepictureinpicture aria-hidden="true" data-src={f.src.replace(/\.mp4$/, '-preview.mp4')}></video>
            <span class="umf-play" aria-hidden="true"><svg viewBox="0 0 24 24"><path d="M8 5v14l11-7L8 5Z"/></svg></span>
          </span>
          <span class="umf-meta">
            {label !== 'scene' && <strong><i></i>{f.service.name}</strong>}
            {label !== 'service' && <span class="umf-scene">{f.sceneTitle}</span>}
          </span>
        </button>
      </li>
    ))}
  </ul>
</section>
)}

<script>
  type Item = { id: string; src: string; sq: string; poster: string; scene: string; service: string; color: string; serviceHref: string; sectorHref: string };
  const reduce = () => matchMedia('(prefers-reduced-motion: reduce)').matches || Boolean((navigator as any).connection?.saveData);
  const hover = matchMedia('(hover: hover) and (pointer: fine)');
  const narrow = () => innerWidth <= 720 && innerHeight > innerWidth;

  let dialog: HTMLDialogElement | null = null;
  const theater = () => {
    if (dialog) return dialog;
    dialog = document.createElement('dialog');
    dialog.className = 'umf-theater';
    dialog.innerHTML = `
      <div class="umf-theater__bar">
        <p><span data-t-scene></span><strong data-t-service></strong></p>
        <span class="umf-theater__count" data-t-count></span>
        <button type="button" data-t-close aria-label="Cerrar la movie">Cerrar <kbd>Esc</kbd></button>
      </div>
      <div class="umf-theater__stage">
        <video controls playsinline preload="auto" disablepictureinpicture></video>
        <button type="button" class="umf-theater__nav" data-t-step="-1" aria-label="Movie anterior"><svg viewBox="0 0 24 24"><path d="M15 5l-7 7 7 7"/></svg></button>
        <button type="button" class="umf-theater__nav" data-t-step="1" aria-label="Movie siguiente"><svg viewBox="0 0 24 24"><path d="M9 5l7 7-7 7"/></svg></button>
      </div>
      <div class="umf-theater__foot">
        <span class="umf-theater__note">Visualización conceptual · los equipos y lecturas son ilustrativos</span>
        <a data-t-service-link>Ver el servicio <span aria-hidden="true">↗</span></a>
        <a data-t-sector-link>Ver el sector <span aria-hidden="true">↗</span></a>
      </div>`;
    document.body.appendChild(dialog);
    const video = dialog.querySelector('video')!;
    dialog.querySelector('[data-t-close]')!.addEventListener('click', () => dialog!.close());
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog!.close(); });
    dialog.addEventListener('close', () => { video.pause(); video.removeAttribute('src'); video.load(); document.documentElement.classList.remove('umf-lock'); });
    dialog.querySelectorAll<HTMLButtonElement>('[data-t-step]').forEach((b) => b.addEventListener('click', () => (dialog as any).step(Number(b.dataset.tStep))));
    dialog.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowRight') (dialog as any).step(1);
      if (e.key === 'ArrowLeft') (dialog as any).step(-1);
    });
    return dialog;
  };

  const open = (items: Item[], start: number) => {
    const dlg = theater();
    const video = dlg.querySelector('video')!;
    let i = start;
    const show = () => {
      const it = items[i];
      dlg.style.setProperty('--c', it.color);
      dlg.querySelector('[data-t-scene]')!.textContent = it.scene;
      dlg.querySelector('[data-t-service]')!.textContent = it.service;
      dlg.querySelector('[data-t-count]')!.textContent = `${String(i + 1).padStart(2, '0')} / ${String(items.length).padStart(2, '0')}`;
      (dlg.querySelector('[data-t-service-link]') as HTMLAnchorElement).href = it.serviceHref;
      (dlg.querySelector('[data-t-sector-link]') as HTMLAnchorElement).href = it.sectorHref;
      dlg.setAttribute('aria-label', `${it.service} en ${it.scene}`);
      video.poster = it.poster;
      video.src = narrow() ? it.sq : it.src;
      video.loop = items.length === 1;
      video.play().catch(() => {});
    };
    (dlg as any).step = (d: number) => { i = (i + d + items.length) % items.length; show(); };
    video.onended = () => { if (items.length > 1) (dlg as any).step(1); };
    dlg.querySelectorAll<HTMLElement>('[data-t-step]').forEach((b) => { b.hidden = items.length < 2; });
    show();
    document.documentElement.classList.add('umf-lock');
    if (!dlg.open) dlg.showModal();
  };

  document.querySelectorAll<HTMLElement>('[data-umf]').forEach((root) => {
    const items: Item[] = JSON.parse(root.dataset.films || '[]');
    const cards = [...root.querySelectorAll<HTMLButtonElement>('[data-umf-open]')];
    const visible = () => cards.filter((c) => !c.closest('li')!.hidden);
    cards.forEach((card) => {
      const video = card.querySelector('video')!;
      const start = () => {
        if (reduce() || !hover.matches) return;
        if (!video.src) video.src = video.dataset.src!;
        video.play().then(() => card.classList.add('is-playing')).catch(() => {});
      };
      const stop = () => { video.pause(); card.classList.remove('is-playing'); };
      card.addEventListener('pointerenter', start);
      card.addEventListener('pointerleave', stop);
      card.addEventListener('focus', start);
      card.addEventListener('blur', stop);
      card.addEventListener('click', () => {
        stop();
        const list = visible();
        open(list.map((c) => items[Number(c.dataset.umfOpen)]), Math.max(0, list.indexOf(card)));
      });
    });
    const chips = [...root.querySelectorAll<HTMLButtonElement>('[data-umf-filter]')];
    chips.forEach((chip) => chip.addEventListener('click', () => {
      const [kind, value] = (chip.dataset.umfFilter || '').split(':');
      chips.forEach((c) => c.setAttribute('aria-pressed', String(c === chip)));
      root.querySelectorAll<HTMLLIElement>('.umf-grid > li').forEach((li) => {
        li.hidden = Boolean(kind) && li.dataset[kind as 'scene' | 'service'] !== value;
      });
    }));
  });
</script>

<style is:global>
  .umf { --umf-font: 'UM Sans', 'UM Sans Fallback', Arial, system-ui, sans-serif; --umf-gutter: clamp(20px, 4.6vw, 72px); padding: clamp(64px, 9vw, 128px) var(--umf-gutter); font-family: var(--umf-font); }
  .umf--dark { background: #07080a; color: #fff; }
  .umf--light { background: #f4f5f6; color: #111; }
  .umf-head { max-width: 1400px; margin: 0 auto clamp(28px, 4vw, 48px); }
  .umf-kicker { display: flex; align-items: center; gap: 12px; margin: 0 0 18px; font-size: .9rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; opacity: .84; }
  .umf-kicker::before { content: ''; width: 28px; height: 2px; background: #dc2626; }
  .umf h2 { margin: 0; max-width: 22ch; font: 600 clamp(2rem, 3.6vw, 3.4rem)/1.04 var(--umf-font); letter-spacing: -.03em; text-wrap: balance; }
  .umf-lead { margin: 18px 0 0; max-width: 62ch; font-size: clamp(1.02rem, 1.2vw, 1.15rem); line-height: 1.6; opacity: .78; text-wrap: pretty; }
  .umf-filters { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; margin-top: 28px; }
  .umf-filters button { display: inline-flex; align-items: center; gap: 8px; min-height: 40px; padding: 0 14px; border: 1px solid currentColor; border-color: rgba(127, 127, 127, .4); background: transparent; color: inherit; font: 500 .95rem var(--umf-font); cursor: pointer; transition: background .2s ease, border-color .2s ease; }
  .umf-filters button small { opacity: .6; font-variant-numeric: tabular-nums; }
  .umf-filters button i { width: 9px; height: 9px; border-radius: 2px; background: var(--c); }
  .umf-filters button:hover { border-color: currentColor; }
  .umf-filters button[aria-pressed='true'] { background: #dc2626; border-color: #dc2626; color: #fff; }
  .umf-filters__sep { width: 1px; height: 24px; margin: 0 6px; background: rgba(127, 127, 127, .4); }
  .umf-grid { list-style: none; margin: 0 auto; padding: 0; max-width: 1400px; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: clamp(10px, 1.2vw, 18px); }
  .umf-grid > li[hidden] { display: none; }
  .umf-card { display: block; width: 100%; padding: 0; border: 0; background: none; color: inherit; text-align: left; font: inherit; cursor: pointer; }
  .umf-media { position: relative; display: block; aspect-ratio: 16 / 9; overflow: hidden; background: #15171a; }
  .umf-media img, .umf-media video { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; transition: opacity .5s ease, transform .9s cubic-bezier(.2, .7, .2, 1); }
  .umf-media video { opacity: 0; }
  .umf-card.is-playing video { opacity: 1; }
  .umf-card:hover .umf-media img, .umf-card:focus-visible .umf-media img { transform: scale(1.03); }
  .umf-media::after { content: ''; position: absolute; inset: auto 0 0; height: 3px; background: var(--c); transform: scaleX(0); transform-origin: left; transition: transform .5s ease; }
  .umf-card:hover .umf-media::after, .umf-card:focus-visible .umf-media::after { transform: scaleX(1); }
  .umf-play { position: absolute; right: 12px; bottom: 12px; display: grid; place-items: center; width: 40px; height: 40px; border-radius: 50%; background: rgba(7, 8, 10, .62); backdrop-filter: blur(8px); transition: background .2s ease, opacity .3s ease; }
  .umf-play svg { width: 16px; height: 16px; fill: #fff; margin-left: 2px; }
  .umf-card:hover .umf-play { background: #dc2626; }
  .umf-meta { display: flex; flex-direction: column; gap: 4px; padding: 14px 2px 4px; }
  .umf-meta strong { display: flex; align-items: center; gap: 9px; font-size: 1.05rem; font-weight: 600; letter-spacing: -.01em; }
  .umf-meta strong i { flex: none; width: 9px; height: 9px; border-radius: 2px; background: var(--c); }
  .umf-scene { font-size: .95rem; opacity: .66; }
  .umf-card:focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
  @media (max-width: 1100px) { .umf-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 760px) {
    .umf-grid { display: flex; overflow-x: auto; scroll-snap-type: x mandatory; gap: 12px; margin-right: calc(var(--umf-gutter) * -1); padding-right: var(--umf-gutter); scrollbar-width: none; }
    .umf-grid::-webkit-scrollbar { display: none; }
    .umf-grid > li { flex: 0 0 82%; scroll-snap-align: start; }
    .umf-filters { flex-wrap: nowrap; overflow-x: auto; margin-right: calc(var(--umf-gutter) * -1); padding-right: var(--umf-gutter); scrollbar-width: none; }
    .umf-filters button { flex: none; }
  }

  html.umf-lock { overflow: hidden; }
  .umf-theater { width: min(1600px, 100vw); max-width: 100vw; height: min(100dvh, calc(min(1600px, 100vw) * 9 / 16 + 140px)); max-height: 100dvh; margin: auto; padding: 0; border: 0; background: #07080a; color: #fff; font-family: 'UM Sans', 'UM Sans Fallback', Arial, system-ui, sans-serif; display: none; grid-template-rows: auto minmax(0, 1fr) auto; }
  .umf-theater[open] { display: grid; }
  .umf-theater::backdrop { background: rgba(3, 4, 5, .9); backdrop-filter: blur(6px); }
  .umf-theater__bar, .umf-theater__foot { display: flex; align-items: center; gap: 18px; padding: 14px clamp(16px, 2vw, 28px); }
  .umf-theater__bar p { flex: 1; min-width: 0; margin: 0; display: flex; align-items: baseline; gap: 12px; flex-wrap: wrap; }
  .umf-theater__bar p span { font-size: .8rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: rgba(255, 255, 255, .64); }
  .umf-theater__bar p strong { font-size: 1.15rem; font-weight: 600; border-left: 3px solid var(--c); padding-left: 10px; }
  .umf-theater__count { font-variant-numeric: tabular-nums; color: rgba(255, 255, 255, .6); }
  .umf-theater button, .umf-theater a { color: #fff; font: inherit; }
  [data-t-close] { min-height: 40px; padding: 0 14px; border: 1px solid rgba(255, 255, 255, .3); background: transparent; cursor: pointer; }
  [data-t-close] kbd { margin-left: 6px; font: .75rem/1 inherit; opacity: .6; }
  .umf-theater__stage { position: relative; min-height: 0; background: #000; }
  .umf-theater__stage video { width: 100%; height: 100%; object-fit: contain; background: #000; }
  .umf-theater__nav { position: absolute; top: 50%; translate: 0 -50%; display: grid; place-items: center; width: 48px; height: 48px; border: 0; border-radius: 50%; background: rgba(7, 8, 10, .55); cursor: pointer; }
  .umf-theater__nav[hidden] { display: none; }
  .umf-theater__nav svg { width: 22px; height: 22px; fill: none; stroke: #fff; stroke-width: 2; }
  .umf-theater__nav:hover { background: #dc2626; }
  [data-t-step='-1'] { left: 16px; }
  [data-t-step='1'] { right: 16px; }
  .umf-theater__foot { flex-wrap: wrap; }
  .umf-theater__note { flex: 1; min-width: 200px; font-size: .85rem; color: rgba(255, 255, 255, .55); }
  .umf-theater__foot a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; background: #dc2626; text-decoration: none; font-weight: 600; }
  .umf-theater__foot a + a { background: transparent; border: 1px solid rgba(255, 255, 255, .34); }
  .umf-theater :focus-visible { outline: 2px solid #fff; outline-offset: 3px; }
  @media (max-width: 720px) { .umf-theater { height: 100dvh; } .umf-theater__nav { width: 40px; height: 40px; } [data-t-close] kbd { display: none; } }
  @media (prefers-reduced-motion: reduce) { .umf-media img, .umf-media video, .umf-media::after { transition: none; } .umf-card:hover .umf-media img { transform: none; } }
</style>
