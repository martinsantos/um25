---
// Banner cine: recorrido pre-renderizado con empalmes suaves y etiquetas de equipos.
// Portada: encadena las escenas. Sector o servicio: una escena en bucle.
// Las películas completas quedan en Blender; la exploración de servicios usa isométricos.
import '../../styles/cine-banner.css';
import { HOME_SCENES, cutCaption } from '../../data/cine/scenes';

interface Stat { label: string; value: string }
interface Link { href: string; label: string }
interface CinemaChapter {scene:string;name:string;text:string}
interface Props {
  variant?: 'home' | 'sector';
  chapters?:CinemaChapter[];
  motion?: 'auto' | 'still';
  annotations?: boolean;
  framing?: 'cover' | 'project';
  /** Escenas base o claves v4 "<escena>-<servicio>" (mismos archivos, con sufijo). */
  scenes?: string[];
  systems?: string[];
  kicker?: string;
  title: string;
  lead?: string;
  primary?: Link;
  secondary?: Link;
  stats?: Stat[];
  back?: Link;
  titleId?: string;
  /** Recorridos alternativos por escena ("bodega" → ["bodega-redes", …]): el reproductor
   *  elige uno al azar en cada pasada, así la película no es siempre la misma. */
  variants?: Record<string, string[]>;
  /** Escena con la que arranca esta visita (índice en `scenes`). */
  start?: number;
}
const {
  variant = 'home', chapters, motion = 'auto', annotations = true, framing = 'cover', scenes = HOME_SCENES.map((s) => s.scene), systems = [], kicker,
  title, lead, primary, secondary, stats = [], back, titleId = 'umcTitle', variants = {}, start = 0,
} = Astro.props;
const startIndex = Math.min(Math.max(Math.floor(start), 0), scenes.length - 1);
const first = scenes[startIndex];
const variantsAttr = Object.entries(variants).filter(([, v]) => v.length).map(([s, v]) => `${s}:${v.join('|')}`).join(';') || undefined;
const dot = title.endsWith('.');
const heading = dot ? title.slice(0, -1) : title;
const rail = chapters||HOME_SCENES.filter((s) => scenes.includes(s.scene));
const firstTitle = rail.find(chapter=>chapter.scene===first)?.name||cutCaption(first);
const disciplineComposition = /^(software|network|security|telecom|support|consulting|fire|power)-system-v\d+$/.test(first);
const productComposition = first==='software-system-v3';
const squarePosterMedia = disciplineComposition ? '(max-width:820px)' : '(max-width:546px) and (max-aspect-ratio:651/1000)';
---
<section class:list={['umc', `umc--${variant}`]} data-umc data-motion={motion} data-annotations={annotations?'tracked':'none'} data-framing={framing} data-composition={disciplineComposition?'discipline':undefined} data-product-composition={productComposition?'true':undefined} data-scenes={scenes.join(',')} data-systems={systems.join(',')} data-scene={first} data-start={startIndex} data-variants={variantsAttr} aria-labelledby={titleId}>
  <div class="umc-stage" aria-hidden="true">
    <picture>
      {framing==='project'&&<source media={squarePosterMedia} type="image/avif" srcset={`/cine/media/cine-${first}-poster-sq.avif`} data-poster-square />}
      {framing==='project'&&<source media={squarePosterMedia} type="image/jpeg" srcset={`/cine/media/cine-${first}-poster-sq.jpg`} data-poster-square />}
      <source type="image/avif" srcset={`/cine/media/cine-${first}-poster.avif`} />
      <img class="umc-poster" src={`/cine/media/cine-${first}-poster.jpg`} alt="" width="1920" height="1080" fetchpriority="high" decoding="async" />
    </picture>
    {motion!=='still'&&<video class="umc-video" muted playsinline preload="none" disablepictureinpicture></video>}
    {motion!=='still'&&<video class="umc-video" muted playsinline preload="none" disablepictureinpicture></video>}
    <div class="umc-grade"></div>
    <div class="umc-ar"></div>
  </div>

  <div class="umc-copy">
    {back && <a class="umc-back" href={back.href}>{back.label}</a>}
    {kicker && <p class="umc-eyebrow">{kicker}</p>}
    <h1 id={titleId}>{heading}{dot && <span class="umc-dot">.</span>}</h1>
    {lead && <p class="umc-lead">{lead}</p>}
    {(primary || secondary) && (
      <div class="umc-cta">
        {primary && <a class="umc-btn" href={primary.href}>{primary.label}<span aria-hidden="true">↗</span></a>}
        {secondary && <a class="umc-btn umc-btn--ghost" href={secondary.href}>{secondary.label}</a>}
      </div>
    )}
    {stats.length > 0 && (
      <dl class="umc-stats">
        {stats.map((s) => <div><dt>{s.label}</dt><dd>{s.value}</dd></div>)}
      </dl>
    )}
  </div>

  <div class="umc-foot">
    {variant === 'home' ? (
      <div class="umc-rail" style={`--umc-scenes:${rail.length}`} role="group" aria-label="Escenas por sector">
        {rail.map((s, i) => (
          <button type="button" data-umc-scene={s.scene} data-name={s.name} aria-pressed={s.scene === first ? 'true' : 'false'}>
            <span class="umc-rail__n">{String(i + 1).padStart(2, '0')}</span>
            <span class="umc-rail__t">{s.name}<small>{s.text}</small></span>
            <i class="umc-rail__bar"><b></b></i>
          </button>
        ))}
      </div>
    ) : (scenes.length > 1 || variantsAttr) ? (
      <p class="umc-caption" data-umc-caption>{firstTitle}</p>
    ) : (
      <span class="umc-caption" aria-hidden="true"></span>
    )}
    {motion!=='still'&&<div class="umc-tools">

      <button class="umc-tool umc-tool--icon" type="button" data-umc-motion aria-label="Pausar el recorrido">
        <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14"/></svg>
        <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5v14l12-7L7 5Z"/></svg>
      </button>
    </div>}
  </div>
</section>
<script src="/cine/cine-banner-v9.js" type="module" async is:inline></script>

<style>
 .umc[data-framing="project"] :global(.umc-stage){left:0;right:0}
 .umc[data-framing="project"] :global(.umc-poster),.umc[data-framing="project"] :global(.umc-video){object-fit:contain;object-position:center center}
 /* Each discipline film reserves the left column for reading. Its complete
    system remains visible beside the copy instead of behind it. */
 @media(min-width:821px){
  .umc[data-composition="discipline"] :global(.umc-stage){left:25%;right:0}
  .umc[data-composition="discipline"] :global(.umc-copy){width:min(520px,42%)}
  .umc[data-composition="discipline"] :global(.umc-poster),.umc[data-composition="discipline"] :global(.umc-video){top:0;bottom:0;height:auto;aspect-ratio:16/9;margin-block:auto;mask-image:linear-gradient(180deg,transparent,#000 14%,#000 86%,transparent)}
  .umc[data-composition="discipline"] :global(.umc-grade){background:linear-gradient(90deg,var(--umc-ink),transparent 20%),linear-gradient(0deg,var(--umc-ink),transparent 26%),linear-gradient(180deg,rgba(7,8,10,.3),transparent 18%)}
 }
 /* A narrow side-by-side composition needs a smaller heading role so the
    model and its explanation keep comparable visual weight. */
 @media(min-width:821px) and (max-width:1100px){
  .umc[data-composition="discipline"]{--um-world-h1:2.5rem}
 }
 @media(max-width:820px){
  /* Remove only the padding encoded around the mobile frame. Every
     equipment layer remain in view, at their original resolution. */
  .umc[data-composition="discipline"] :global(.umc-stage){top:24px;left:50%;right:auto;width:min(100%,600px);height:auto;aspect-ratio:38/27;transform:translateX(-50%)}
  .umc[data-composition="discipline"] :global(.umc-poster),.umc[data-composition="discipline"] :global(.umc-video){object-fit:cover;mask-image:linear-gradient(180deg,transparent,#000 19%,#000 81%,transparent)}
  .umc[data-composition="discipline"] :global(.umc-grade){background:none}
  .umc[data-composition="discipline"] :global(.umc-copy){padding-top:calc(min(100vw,600px) * 27 / 38 + 24px)}
  /* Keep the motion control beside the movie, above the fixed mobile dock. */
  .umc[data-composition="discipline"] :global(.umc-tools){position:absolute;top:12px;right:var(--umc-gutter)}
  .umc[data-composition="discipline"] :global(.umc-eyebrow){margin-bottom:14px}
  .umc[data-composition="discipline"] :global(.umc-lead){margin-top:16px}
  .umc[data-composition="discipline"] :global(.umc-cta){margin-top:24px}
  .umc--sector :global(.umc-stats){display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:16px}
  .umc--sector :global(.umc-stats div){padding:16px 0 0;margin-right:0}
  .umc--sector :global(.umc-stats dt){letter-spacing:0;text-transform:none}
 }
 /* Upright equipment reaches closer to the frame edges than the software
    surfaces. Keep the mast tops and cabinet feet inside the opaque region. */
 .umc[data-composition="discipline"]:not([data-scene^="software-system-v"]) :global(.umc-poster),
 .umc[data-composition="discipline"]:not([data-scene^="software-system-v"]) :global(.umc-video){mask-image:linear-gradient(180deg,transparent,#000 6%,#000 94%,transparent)}
 /* The product film uses the entire image, including its fine interface.
    Give it a separate column and preserve its edges through every close-up. */
 .umc[data-product-composition="true"] :global(.umc-poster),.umc[data-product-composition="true"] :global(.umc-video){mask-image:none}
 .umc[data-product-composition="true"] :global(.umc-grade){background:none}
 @media(min-width:821px){
  .umc[data-product-composition="true"] :global(.umc-stage){left:42%;right:0}
  .umc[data-product-composition="true"] :global(.umc-copy){width:min(520px,calc(42% - var(--umc-gutter) - 24px))}
 }
 @media(max-width:820px){
  .umc[data-product-composition="true"] :global(.umc-stage){aspect-ratio:16/9}
  .umc[data-product-composition="true"] :global(.umc-copy){padding-top:calc(min(100vw,600px) * 9 / 16 + 40px)}
 }
</style>
