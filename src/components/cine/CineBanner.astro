---
// Banner cine: plano Cycles pre-renderizado (vuelo imposible por la escena, con cortes
// "pop" entre edificio y esqueleto de sistemas) y etiquetas que siguen a los equipos.
// Portada: encadena las escenas. Sector o servicio: una escena en bucle.
// El 3D interactivo se abre sólo a pedido (/cine/cine-banner-accessible-2910.js; v5 = v4 + evento umc:cut desde el despiece).
// 2910: en teléfono y conexiones lentas la película no arranca sola (póster + botón); sin leyenda de escena.
import '../../styles/cine-banner.css';
import { HOME_SCENES, V4_CUTS, SOFTWARE_FILM } from '../../data/cine/scenes';

interface Stat { label: string; value: string }
interface Link { href: string; label: string }
interface Props {
  variant?: 'home' | 'sector';
  /** Escenas base o claves v4 "<escena>-<servicio>" (mismos archivos, con sufijo). */
  scenes?: string[];
  systems?: string[];
  kicker?: string;
  title: string;
  lead?: string;
  primary?: Link;
  secondary?: Link;
  stats?: Stat[];
  back?: Link;
  titleId?: string;
  /** Recorridos alternativos por escena ("bodega" → ["bodega-redes", …]): el reproductor
   *  elige uno al azar en cada pasada, así la película no es siempre la misma. */
  variants?: Record<string, string[]>;
  /** Escena con la que arranca esta visita (índice en `scenes`). */
  start?: number;
}
const {
  variant = 'home', scenes = HOME_SCENES.map((s) => s.scene), systems = [], kicker,
  title, lead, primary, secondary, stats = [], back, titleId = 'umcTitle', variants = {}, start = 0,
} = Astro.props;
const startIndex = Math.min(Math.max(Math.floor(start), 0), scenes.length - 1);
const first = scenes[startIndex];
const variantsAttr = Object.entries(variants).filter(([, v]) => v.length).map(([s, v]) => `${s}:${v.join('|')}`).join(';') || undefined;
const dot = title.endsWith('.');
const heading = dot ? title.slice(0, -1) : title;
const rail = HOME_SCENES.filter((s) => scenes.includes(s.scene));
const fallbackFor = (key: string) => key === SOFTWARE_FILM
  ? '/cine/iso/service-104.svg'
  : V4_CUTS[key]?.poster || `/cine/media/cine-${key.split('-')[0]}-poster.avif`;
const fallbackKeys = [...new Set([...scenes, ...Object.values(variants).flat()])];
const fallbacks = Object.fromEntries(fallbackKeys.map((key) => [key, fallbackFor(key)]));
const firstFallback = fallbackFor(first);
---
<section class:list={['umc', `umc--${variant}`]} data-umc data-scenes={scenes.join(',')} data-systems={systems.join(',')} data-scene={first} data-start={startIndex} data-variants={variantsAttr} data-fallbacks={JSON.stringify(fallbacks)} aria-labelledby={titleId}>
  <div class="umc-stage" aria-hidden="true">
    {/* Oculta durante el inicio normal; alternativa para movimiento reducido o video no disponible. */}
    <img class="umc-poster is-hidden" src={firstFallback} data-default={firstFallback} alt="" width="1920" height="1080" decoding="async" />
    <noscript><img class="umc-poster" src={firstFallback} alt="" width="1920" height="1080" /></noscript>
    <video class="umc-video" muted playsinline preload="none" disablepictureinpicture></video>
    <video class="umc-video" muted playsinline preload="none" disablepictureinpicture></video>
    <div class="umc-grade"></div>
    <div class="umc-ar"></div>
  </div>

  <div class="umc-copy">
    {back && <a class="umc-back" href={back.href}>{back.label}</a>}
    <h1 id={titleId}>{heading}{dot && <span class="umc-dot">.</span>}</h1>
    {lead && <p class="umc-lead">{lead}</p>}
    {(primary || secondary) && (
      <div class="umc-cta">
        {primary && <a class="umc-btn" href={primary.href}>{primary.label}<span aria-hidden="true">↗</span></a>}
        {secondary && <a class="umc-btn umc-btn--ghost" href={secondary.href}>{secondary.label}</a>}
      </div>
    )}
  </div>

  <div class="umc-foot">
    {variant === 'home' ? (
      <div class="umc-rail" role="group" aria-label="Escenas por sector">
        {rail.map((s, i) => (
          <button type="button" data-umc-scene={s.scene} aria-pressed={i === startIndex ? 'true' : 'false'}>
            <span class="umc-rail__t">{s.name}<small>{s.text}</small></span>
            <i class="umc-rail__bar"><b></b></i>
          </button>
        ))}
      </div>
    ) : (
      <span class="umc-caption" aria-hidden="true"></span>
    )}
    <div class="umc-tools">
      <button class="umc-tool umc-tool--icon" type="button" data-umc-motion aria-label="Pausar el recorrido">
        <svg class="i-pause" viewBox="0 0 24 24" aria-hidden="true"><path d="M8 5v14M16 5v14"/></svg>
        <svg class="i-play" viewBox="0 0 24 24" aria-hidden="true"><path d="M7 5v14l12-7L7 5Z"/></svg>
      </button>
    </div>
  </div>
</section>
<script src="/cine/cine-banner-accessible-2910.js" type="module" is:inline></script>
