---
/**
 * DeliveryProcess — cómo se construye software a medida, con el entregable de
 * cada paso a la vista (documentos dibujados en CSS, sin imágenes).
 */
interface Step { n: string; title: string; text: string; doc: string; kind: 'acta' | 'proto' | 'notas' | 'sla' }
const STEPS: Step[] = [
  { n: '01', title: 'Relevamiento en sitio', text: 'Entrevistas con quienes operan, inventario de sistemas existentes y el proceso dibujado tal como ocurre hoy.', doc: 'Acta de alcance firmada', kind: 'acta' },
  { n: '02', title: 'Prototipo navegable', text: 'Antes de programar, una maqueta que se recorre en el teléfono y en la oficina. Se corrige ahí, cuando cambiar es barato.', doc: 'Prototipo clicable', kind: 'proto' },
  { n: '03', title: 'Iteraciones quincenales', text: 'Cada dos semanas una versión en producción de prueba, con lo que entró y lo que falta por escrito.', doc: 'Notas de versión', kind: 'notas' },
  { n: '04', title: 'Soporte con SLA', text: 'Mesa de ayuda, monitoreo y mantenimiento del sistema entregado, con tiempos de respuesta pactados.', doc: 'Acuerdo de nivel de servicio', kind: 'sla' },
];
---
<ol class="dp" aria-label="Etapas de desarrollo">
  {STEPS.map((s) => (
    <li class="dp__step">
      <div class:list={['dp__doc', `dp__doc--${s.kind}`]} aria-hidden="true">
        <i class="dp__doc-head"></i>
        {s.kind === 'proto' ? (
          <span class="dp__doc-proto"><i></i><i></i><i></i><i></i></span>
        ) : s.kind === 'sla' ? (
          <span class="dp__doc-rows"><i style="--w:70%"></i><i style="--w:40%"></i><i style="--w:85%"></i><i style="--w:55%"></i></span>
        ) : (
          <span class="dp__doc-lines"><i style="--w:92%"></i><i style="--w:76%"></i><i style="--w:88%"></i><i style="--w:60%"></i><i style="--w:84%"></i></span>
        )}
        {s.kind === 'acta' && <b class="dp__doc-sign"></b>}
      </div>
      <div class="dp__copy">
        <span class="dp__num">{s.n}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
        <small>Entregable: {s.doc}</small>
      </div>
    </li>
  ))}
</ol>

<style>
  .dp { list-style: none; margin: 0; padding: 0; display: grid; gap: 24px; grid-template-columns: repeat(4, minmax(0, 1fr)); }
  .dp__step { display: grid; grid-template-rows: auto 1fr; align-content: start; gap: 16px; min-width: 0; border-top: 1px solid rgba(127, 127, 127, 0.3); padding-top: 18px; }
  .dp__doc {
    position: relative;
    aspect-ratio: 4 / 3;
    border: 1px solid rgba(127, 127, 127, 0.45);
    border-radius: var(--um-radius, 4px);
    background: rgba(127, 127, 127, 0.07);
    padding: 14px;
    display: grid;
    align-content: start;
    gap: 10px;
    overflow: hidden;
  }
  .dp__doc-head { display: block; width: 46%; height: 8px; border-radius: 2px; background: var(--um-red, #DC2626); }
  .dp__doc-lines, .dp__doc-rows { display: grid; gap: 7px; }
  .dp__doc-lines i { display: block; height: 5px; width: var(--w); border-radius: 2px; background: rgba(127, 127, 127, 0.55); }
  .dp__doc-rows i { display: block; height: 10px; width: var(--w); border-radius: 2px; background: rgba(127, 127, 127, 0.35); border-left: 3px solid rgba(127, 127, 127, 0.8); }
  .dp__doc-proto { display: grid; grid-template-columns: 1fr 1fr; gap: 7px; }
  .dp__doc-proto i { display: block; aspect-ratio: 5 / 3; border: 1px solid rgba(127, 127, 127, 0.6); border-radius: 3px; }
  .dp__doc-proto i:first-child { background: rgba(127, 127, 127, 0.3); }
  .dp__doc-sign { position: absolute; right: 14px; bottom: 12px; width: 34%; height: 2px; background: currentColor; opacity: 0.7; }
  .dp__doc-sign::before { content: ''; position: absolute; left: 10%; bottom: 4px; width: 60%; height: 12px; border-bottom: 1.5px solid currentColor; border-radius: 0 0 60% 40%; opacity: 0.8; }
  .dp__copy { display: grid; gap: 6px; align-content: start; }
  .dp__num { font-size: 1rem; font-weight: 600; color: var(--um-red, #DC2626); font-variant-numeric: var(--um-figures-tabular); }
  .dp__copy h3 { margin: 0; font-size: 1.125rem; line-height: 1.25; font-weight: 600; letter-spacing: -0.01em; }
  .dp__copy p { margin: 0; font-size: 1rem; opacity: 0.8; line-height: var(--um-body-line-height, 1.62); }
  .dp__copy small { font-size: 1rem; font-weight: 600; }
  @media (max-width: 980px) { .dp { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 560px) { .dp { grid-template-columns: 1fr; } .dp__step { grid-template-columns: 120px minmax(0, 1fr); align-items: start; } .dp__doc { aspect-ratio: 1; padding: 10px; gap: 7px; } }
</style>
