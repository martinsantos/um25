---
// Hero del servicio "Software a medida": la película en código (three.js).
// Las pantallas negras se ensamblan, se abren en sus capas y el flujo rojo une los datos.
// Misma voz visual que CineBanner (kicker con raya roja, punto final rojo, dos botones),
// pero la escena es WebGL en vivo, no un video pre-renderizado. La lógica vive en
// src/scripts/senal/software.js; acá sólo hay marco, leyendas por paso y texto del hero.
interface Link { href: string; label: string }
interface Props {
  kicker?: string;
  title: string;
  lead?: string;
  primary?: Link;
  secondary?: Link;
  back?: Link;
  titleId?: string;
}
const { kicker, title, lead, primary, secondary, back, titleId = 'sfilm-title' } = Astro.props;
const dot = title.endsWith('.');
const heading = dot ? title.slice(0, -1) : title;
---
<section class="sfilm" aria-labelledby={titleId}>
  <div
    class="sfilm__stage"
    data-senal
    role="img"
    aria-label="Animación: pantallas de un sistema a medida que se ensamblan, se abren en capas (interfaz, reglas, integraciones y datos) y se vuelven a cerrar."
  >
    <div class="senal__cap" data-senal-caption data-step="0" aria-hidden="true">
      <p><small><b></b>Software a medida</small><strong>Una orden reúne el trabajo y su contexto.</strong></p>
      <p><small><b></b>Por dentro</small><strong>Cada pantalla tiene capas que no se ven.</strong></p>
      <p><small><b></b>Reglas e integraciones</small><strong>Cada dato se valida y llega a su destino.</strong></p>
      <p><small><b></b>Historial</small><strong>Cada aprobación queda registrada.</strong></p>
      <p><small><b></b>Última Milla</small><strong class="senal__logo">ultimamilla<i>.</i>com<i>.</i>ar</strong></p>
    </div>
  </div>

  <div class="sfilm__copy">
    {back && <a class="sfilm__back" href={back.href}>{back.label}</a>}
    {kicker && <p class="sfilm__eyebrow">{kicker}</p>}
    <h1 id={titleId}>{heading}{dot && <span class="sfilm__dot">.</span>}</h1>
    {lead && <p class="sfilm__lead">{lead}</p>}
    {(primary || secondary) && (
      <div class="sfilm__cta">
        {primary && <a class="sfilm__btn" href={primary.href}>{primary.label}<span aria-hidden="true">↗</span></a>}
        {secondary && <a class="sfilm__btn sfilm__btn--ghost" href={secondary.href}>{secondary.label}</a>}
      </div>
    )}
  </div>
</section>

<script>
  // Se importa recién cuando hay fuente cargada: las texturas de las pantallas se dibujan
  // al evaluar el módulo y necesitan UM Sans lista. Si WebGL falla, queda el fondo oscuro
  // con el texto (el hero sigue siendo legible y con sus botones).
  const host = document.querySelector<HTMLElement>('.sfilm [data-senal]');
  if (host) {
    const fonts = (document as any).fonts;
    const ready: Promise<unknown> = fonts?.ready ?? Promise.resolve();
    Promise.race([ready, new Promise((r) => setTimeout(r, 1500))])
      .then(() => import('../../scripts/senal/software.js'))
      .then(({ mountSoftware }) => { mountSoftware(host); })
      .catch(() => { host.classList.add('is-static'); });
  }
</script>

<style is:global>
  .sfilm {
    --sf-red: #DC2626;
    --sf-ink: #0b1219;
    --sf-gutter: clamp(20px, 4.6vw, 72px);
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: grid;
    align-items: center;
    min-height: min(88vh, 900px);
    min-height: min(88svh, 900px);
    background: var(--sf-ink);
    color: #fff;
    font-family: var(--um-font-editorial, 'UM Sans', Arial, system-ui, sans-serif);
  }

  /* Escena: ocupa todo el fondo; el producto queda a la derecha del texto (lo resuelve el script). */
  .sfilm__stage { position: absolute; inset: 0; z-index: -1; background: var(--sf-ink); }
  .sfilm__stage canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
  .sfilm__stage::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background:
      linear-gradient(90deg, rgba(11, 18, 25, .94) 0%, rgba(11, 18, 25, .7) 26%, rgba(11, 18, 25, 0) 52%),
      linear-gradient(0deg, rgba(11, 18, 25, .8) 0%, rgba(11, 18, 25, 0) 30%);
  }

  /* Leyendas por paso: cambian con data-step (lo escribe el script). */
  .sfilm .senal__cap {
    position: absolute; z-index: 2;
    left: var(--sf-gutter); bottom: clamp(20px, 4vh, 40px);
    width: min(560px, calc(100% - var(--sf-gutter) * 2));
    height: 6.2rem;
  }
  .sfilm .senal__cap p {
    position: absolute; bottom: 0; left: 0; width: 100%; margin: 0;
    opacity: 0; transform: translateY(12px);
    transition: opacity .9s ease, transform 1.1s cubic-bezier(.2, .7, .1, 1);
  }
  .sfilm .senal__cap small {
    display: flex; align-items: center; gap: 14px;
    font-size: 1rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: rgba(255, 255, 255, .72);
  }
  .sfilm .senal__cap small b { display: block; width: 32px; height: 2px; background: var(--sf-red); }
  .sfilm .senal__cap strong {
    display: block; margin-top: 10px;
    font-size: clamp(1.25rem, 2vw, 1.9rem); font-weight: 600; line-height: 1.15; letter-spacing: -.02em; text-wrap: balance;
  }
  .sfilm .senal__cap[data-step="0"] p:nth-child(1),
  .sfilm .senal__cap[data-step="1"] p:nth-child(2),
  .sfilm .senal__cap[data-step="2"] p:nth-child(3),
  .sfilm .senal__cap[data-step="3"] p:nth-child(4),
  .sfilm .senal__cap[data-step="4"] p:nth-child(5) { opacity: 1; transform: none; }
  .sfilm .senal__logo { letter-spacing: -.025em; }
  .sfilm .senal__logo i { color: var(--sf-red); font-style: normal; }
  .sfilm .is-frozen .senal__cap p, .sfilm .is-static .senal__cap p { transition: none; }
  /* Sin WebGL no hay película: las leyendas no tienen a qué acompañar. */
  .sfilm .is-static .senal__cap { display: none; }

  /* Texto del hero (mismo lenguaje que .umc-*). */
  .sfilm__copy {
    z-index: 2;
    width: min(640px, calc(100% - var(--sf-gutter) * 2));
    margin-left: var(--sf-gutter);
    padding: 112px 0 150px;
  }
  .sfilm__back { display: flex; align-items: center; min-height: 44px; width: max-content; margin-bottom: 8px; color: rgba(255, 255, 255, .74); font-size: 1rem; text-decoration: none; }
  .sfilm__back:hover { color: #fff; }
  .sfilm__eyebrow {
    display: flex; align-items: center; gap: 12px; margin: 0 0 22px;
    font-size: 1rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: rgba(255, 255, 255, .84);
  }
  .sfilm__eyebrow::before { content: ''; width: 28px; height: 2px; background: var(--sf-red); }
  .sfilm h1 {
    margin: 0; max-width: 16ch;
    font: 600 clamp(2.6rem, 5vw, 4.8rem)/.98 var(--um-font-editorial, 'UM Sans', Arial, system-ui, sans-serif);
    letter-spacing: -.035em; text-wrap: balance;
  }
  .sfilm__dot { color: var(--sf-red); }
  .sfilm__lead { margin: 24px 0 0; max-width: 46ch; font-size: clamp(1.08rem, 1.3vw, 1.25rem); line-height: 1.55; color: rgba(255, 255, 255, .86); text-wrap: pretty; }
  .sfilm__cta { display: flex; flex-wrap: wrap; align-items: center; gap: 12px 14px; margin-top: 34px; }
  .sfilm__btn {
    display: inline-flex; align-items: center; gap: 12px; min-height: 52px; padding: 0 24px;
    background: var(--sf-red); color: #fff; font-weight: 600; font-size: 1rem; text-decoration: none;
    transition: background-color .2s ease, border-color .2s ease;
  }
  .sfilm__btn:hover { background: #b91c1c; }
  .sfilm__btn--ghost { background: rgba(11, 18, 25, .45); border: 1px solid rgba(255, 255, 255, .34); }
  .sfilm__btn--ghost:hover { background: rgba(11, 18, 25, .75); border-color: #fff; }
  .sfilm :focus-visible { outline: 2px solid #fff; outline-offset: 3px; }

  /* Celular: la escena arriba (cuadrada) y el texto debajo, sin desborde horizontal. */
  @media (max-width: 820px) {
    .sfilm { display: block; min-height: 0; }
    .sfilm__stage { position: relative; inset: auto; z-index: 0; aspect-ratio: 1 / 1; max-height: 520px; width: 100%; }
    .sfilm__stage::after {
      background: linear-gradient(0deg, var(--sf-ink) 0%, rgba(11, 18, 25, .55) 16%, rgba(11, 18, 25, 0) 38%),
        linear-gradient(180deg, rgba(11, 18, 25, .5) 0%, rgba(11, 18, 25, 0) 14%);
    }
    .sfilm .senal__cap { bottom: 16px; height: 5.4rem; }
    .sfilm .senal__cap strong { font-size: 1.2rem; }
    .sfilm__copy { padding: 8px 0 40px; width: calc(100% - var(--sf-gutter) * 2); }
    .sfilm h1 { font-size: clamp(2.3rem, 10.5vw, 3.2rem); }
  }

  @media (prefers-reduced-motion: reduce) {
    .sfilm .senal__cap p, .sfilm__btn { transition: none; }
  }
</style>
