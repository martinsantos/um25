---
import MiniIso from './MiniIso.astro';
import {ISO3D_TEXT} from '../../data/cine/iso3dText.js';
interface Props {sector:string}
const {sector}=Astro.props;
const text=(ISO3D_TEXT as Record<string,any>)[sector];
const LAYERS=[['en','Energía','#E2B04A'],['da','Datos','#3FC7B8'],['se','Seguridad','#8B7CF6'],['de','Detección','#F07A5A']];
---
{text && (
<section class="sector-layers" aria-labelledby={`layers-${sector}`}>
  <div class="sector-layers__head">
    <p class="sector-layers__kicker"><span></span>Cuatro capas</p>
    <h2 id={`layers-${sector}`}>Un sistema, cuatro capas resueltas por un mismo equipo.</h2>
  </div>
  <ol class="sector-layers__grid">
    {LAYERS.map(([k,name,color])=>(
      <li class="sector-layers__card" data-mini-hover style={`--c:${color}`}>
        <MiniIso sector={sector} layer={k} class="sector-layers__iso" />
        <p class="sector-layers__name"><b></b>{name}</p>
        <h3>{text[k][0]}</h3>
        <p>{text[k][1]}</p>
      </li>
    ))}
  </ol>
</section>)}
<style>
  .sector-layers{width:min(var(--um-container-wide),calc(100% - (var(--um-page-gutter) * 2)));margin:clamp(40px,6vw,88px) auto}
  .sector-layers__kicker{display:flex;align-items:center;gap:12px;margin:0;font-size:.8rem;letter-spacing:.16em;text-transform:uppercase;color:#c4c7cc}
  .sector-layers__kicker span{width:28px;height:2px;background:#DC2626}
  .sector-layers h2{margin:12px 0 0;max-width:24ch;font-size:clamp(1.6rem,2.6vw,2.4rem);line-height:1.12;letter-spacing:-.01em}
  .sector-layers__grid{list-style:none;margin:clamp(24px,3vw,40px) 0 0;padding:0;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:clamp(12px,1.6vw,24px)}
  .sector-layers__card{display:flex;flex-direction:column;border:1px solid rgba(255,255,255,.1);background:#0b0e12;transition:border-color .3s}
  .sector-layers__card:hover{border-color:color-mix(in srgb,var(--c) 55%,transparent)}
  .sector-layers__card :global(.sector-layers__iso){aspect-ratio:4/3}
  .sector-layers__name{display:flex;align-items:center;gap:8px;margin:18px 20px 0;font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;color:#fff}
  .sector-layers__name b{width:8px;height:8px;border-radius:50%;background:var(--c)}
  .sector-layers__card h3{margin:10px 20px 0;font-size:1.08rem;line-height:1.3}
  .sector-layers__card p:last-child{margin:8px 20px 22px;font-size:.95rem;line-height:1.55;color:#c4c7cc}
  @media (max-width:1100px){.sector-layers__grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media (max-width:560px){.sector-layers__grid{grid-template-columns:1fr}}
</style>
