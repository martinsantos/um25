---
import NetworkJourney from './NetworkJourney.astro';
import {ISOMETRIC_STUDIES} from '../../data/cine/isometric';
import {EQUIPMENT_KITS} from '../../data/cine/networkAssembly';
interface Service {code:string;name:string;href:string}
interface Props {services:Service[]}
const {services}=Astro.props;
const files=import.meta.glob<string>('../../assets/cine/isometric/*-*.svg',{eager:true,query:'?url',import:'default'});
const url=(asset:string,view:string)=>files[`../../assets/cine/isometric/${asset}-${view}.svg`];
const summaries:Record<string,string>={
 '101':'Cableado, fibra y equipos con una función identificable.',
 '102':'Cámaras, accesos y señales dentro del mismo sistema.',
 '103':'Datos, voz y video entre sitios conectados.',
 '104':'Procesos, información y acciones en una herramienta propia.',
 '105':'Estado, prioridad y respuesta para sostener la operación.',
 '106':'Arquitectura, evidencia y decisiones sobre el conjunto.',
 '107':'Dispositivos, lazo y central para una detección temprana.',
 '108':'Respaldo, alimentación y protección de las cargas críticas.',
};
const items=services.filter(s=>ISOMETRIC_STUDIES[s.code]).map(s=>({...s,study:ISOMETRIC_STUDIES[s.code]}));
const first=items[0];
---
{first && <div class="svc-story" data-service-atlas>
  <div class="svc-story__stage">
    <div class="svc-story__meta"><span>Un proyecto. Ocho sistemas.</span><span data-atlas-code>{first.code}</span></div>
    <div data-atlas-network><NetworkJourney compact catalog /></div>
    <div class="svc-story__frame" hidden><img src={url(first.study.asset,'object')} alt={first.study.object} width="1040" height="755" loading="lazy" decoding="async" data-atlas-image /></div>
    <div class="svc-story__views" hidden role="group" aria-label="Escala del servicio">
      <button type="button" data-atlas-view="system" aria-pressed="false">En el proyecto</button>
      <button type="button" data-atlas-view="object" aria-pressed="true">La pieza</button>
    </div>
    <div class="svc-story__caption" aria-live="polite" aria-atomic="true">
      <h3 data-atlas-title>{first.study.title}</h3>
      <p data-atlas-copy>{summaries[first.code]}</p>
      <a class="svc-story__link" href={first.href} data-atlas-link>Explorar {first.study.name.toLowerCase()} <span aria-hidden="true">→</span></a>
    </div>
  </div>
  <ol class="svc-story__list" aria-label="Sistemas del proyecto">
    {items.map((s,i)=><li class="svc-story__item">
      <button type="button" data-atlas-service={s.code} data-equipment-kit={EQUIPMENT_KITS[s.code]?s.code:undefined} data-object={url(s.study.asset,'object')} data-system={url(s.study.asset,'system')} data-name={s.study.name} data-title={s.study.title} data-copy={summaries[s.code]} data-context={s.study.views[0].description} data-alt={s.study.object} data-href={s.href} aria-pressed={String(i===0)}>
        <span class="svc-story__code">{s.code}</span><span class="svc-story__text"><strong>{s.study.name}</strong><span>{summaries[s.code]}</span></span><span class="svc-story__arrow" aria-hidden="true">↗</span>
      </button>
    </li>)}
  </ol>
</div>}
<script src="/cine/service-atlas-v7.js" type="module" is:inline />
<style>
 .svc-story{display:grid;grid-template-columns:minmax(0,7fr) minmax(0,5fr);gap:clamp(24px,4vw,64px);align-items:start}
 .svc-story__stage{background:#090909;color:#fff;padding:clamp(20px,2.8vw,36px);min-width:0}
 .svc-story__meta{display:flex;justify-content:space-between;gap:16px;font-size:1rem;color:#c4c7cc;line-height:1.5;border-bottom:1px solid #ffffff24;padding-bottom:16px}
 .svc-story__meta span:last-child{font-variant-numeric:tabular-nums}
 .svc-story [hidden]{display:none!important}
 .svc-story__frame{height:clamp(280px,29vw,405px);position:relative;min-width:0}
 .svc-story__frame img{width:100%;height:100%!important;object-fit:contain;display:block}
 .svc-story__frame.is-entering{animation:atlas-enter 220ms ease-out both}
 @keyframes atlas-enter{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:translateY(0)}}
 .svc-story__views{display:grid;grid-template-columns:1fr 1fr;border-block:1px solid #ffffff36}
 .svc-story__views button{color:#c4c7cc;font:500 1rem var(--um-font-body,'UM Sans',Arial,sans-serif);border:0;border-bottom:2px solid transparent;background:transparent;min-height:52px;padding:12px;cursor:pointer}
 .svc-story__views button+button{border-left:1px solid #ffffff24}
 .svc-story__views button[aria-pressed=true]{color:#fff;background:#171717;border-bottom-color:#dc2626}
 .svc-story__caption{padding-top:24px;min-height:186px}
 .svc-story__caption h3{margin:0;font-size:clamp(1.375rem,2vw,1.75rem);font-weight:600;line-height:1.25;color:#fff}
 .svc-story__caption p{font-size:1rem;line-height:1.6;color:#c4c7cc;max-width:58ch;margin:12px 0 0}
 .svc-story__link{display:inline-flex;gap:16px;align-items:center;min-height:44px;margin-top:12px;font-size:1rem;color:#fff;text-decoration:underline;text-decoration-color:#dc2626;text-underline-offset:7px}
 .svc-story__list{list-style:none;padding:0;margin:0;display:grid}
 .svc-story__item{margin:0;padding:0;border-bottom:1px solid #ffffff24}
 .svc-story__item:first-child{border-top:1px solid #ffffff24}
 .svc-story__item button{display:grid;grid-template-columns:40px minmax(0,1fr) 18px;gap:16px;align-items:baseline;min-height:82px;width:100%;padding:16px 16px 16px 14px;background:none;color:#fff;border:0;border-left:2px solid transparent;text-align:left;cursor:pointer;font:400 1rem var(--um-font-body,'UM Sans',Arial,sans-serif)}
 .svc-story__item button[aria-pressed=true]{border-left-color:#dc2626;background:#ffffff06}
 .svc-story__code{color:#c4c7cc;font-variant-numeric:tabular-nums}
 .svc-story__text{display:grid;gap:6px;min-width:0}
 .svc-story__text strong{overflow-wrap:anywhere;font-size:1.2rem;font-weight:600;line-height:1.25}
 .svc-story__text>span{font-size:1rem;line-height:1.45;color:#c4c7cc}
 .svc-story__arrow{color:#c4c7cc}
 .svc-story button:focus-visible,.svc-story a:focus-visible{outline:2px solid #fff;outline-offset:-4px}
 @media(hover:hover){.svc-story__item button:hover,.svc-story__views button:hover{background:#ffffff09;color:#fff}.svc-story__link:hover{text-decoration-thickness:2px}}
 @media(max-width:900px){.svc-story{grid-template-columns:1fr;gap:20px}.svc-story__list{grid-row:1;grid-template-columns:repeat(2,minmax(0,1fr));border-top:1px solid #ffffff24}.svc-story__item:first-child{border-top:0}.svc-story__item button{grid-template-columns:32px minmax(0,1fr);min-height:76px;gap:8px;padding:12px 10px}.svc-story__text strong{font-size:1rem;line-height:1.4}.svc-story__text>span,.svc-story__arrow{display:none}.svc-story__stage{padding:20px}.svc-story__frame{height:310px}.svc-story__caption{min-height:175px}}
 @media(prefers-reduced-motion:reduce){.svc-story__frame.is-entering{animation:none}}
</style>
