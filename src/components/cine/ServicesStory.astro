---
import DisciplineSystem from './DisciplineSystem.astro';
import {DISCIPLINE_SYSTEMS} from '../../data/cine/disciplineSystems';
import {operationScenes,operationOverview,overviewChapter} from '../../data/cine/operationNarrative';
import NetworkJourney from './NetworkJourney.astro';
import SoftwareLayers from './SoftwareLayers.astro';
import IsometricStage from './IsometricStage.astro';
import {ISOMETRIC_STUDIES} from '../../data/cine/isometric';
import type {SectorProject} from '../../data/cine/sectorNarrative';
import {SERVICE_NARRATIVE} from '../../data/cine/serviceNarrative';
import {EQUIPMENT_KITS,NETWORK_EQUIPMENT} from '../../data/cine/networkAssembly';
interface Service {code:string;name:string;href:string}
interface Props {services:Service[];project?:SectorProject;single?:boolean;sector?:boolean}
const {services,project,single=false,sector=false}=Astro.props;
const projectFiles=import.meta.glob<string>('../../assets/cine/isometric/site-*-v2.svg',{eager:true,query:'?raw',import:'default'});
const disciplineOnly=single&&services.length===1&&Boolean(DISCIPLINE_SYSTEMS[services[0].code]);
const projectMarkup=project&&!disciplineOnly?projectFiles[`../../assets/cine/isometric/site-${project.scene}-v2.svg`]:undefined;
const contextProject=sector&&Boolean(projectMarkup);
const contextualPlan=(project?.chapters||SERVICE_NARRATIVE).map(chapter=>(single||!sector)&&DISCIPLINE_SYSTEMS[chapter.code]?{...chapter,scenes:operationScenes(chapter.code,undefined),overview:operationOverview(chapter.code)}:chapter);
const plan=contextualPlan.map(chapter=>single?chapter:overviewChapter(chapter));
const files=import.meta.glob<string>('../../assets/cine/isometric/*-*.svg',{eager:true,query:'?url',import:'default'});
const url=(asset:string,view:string)=>files[`../../assets/cine/isometric/${asset}-${view}.svg`];
const messages:Record<string,{title:string;summary:string;copy:string}>={
 '101':{title:'Una red que conecta toda tu operación.',summary:'Cableado, fibra y Wi-Fi para comunicar puestos y sistemas.',copy:'Diseñamos e instalamos la red que une puestos, equipos y aplicaciones. Entregamos los puntos identificados y probados para que puedas operarla y mantenerla.'},
 '102':{title:'Ver lo que pasa. Controlar quién entra.',summary:'Video, grabación y control de accesos en el mismo proyecto.',copy:'Definimos la cobertura de las cámaras y los permisos de acceso para tu sitio. Integramos la red, la grabación y el control para que la información llegue a quien debe actuar.'},
 '103':{title:'Tus sitios conectados, aunque estén lejos.',summary:'Fibra y radioenlaces según el recorrido y la operación.',copy:'Evaluamos los extremos y diseñamos el enlace que comunica tus sedes. Integramos fibra, radio y equipos de red según la distancia, el ambiente y la capacidad necesaria.'},
 '104':{title:'Software que sigue la forma de trabajar de tu equipo.',summary:'Aplicaciones e integraciones para tus procesos.',copy:'Convertimos procesos y datos en herramientas propias. Roles, registros y acciones claras permiten que cada persona encuentre su tarea y la información que necesita.'},
 '105':{title:'Una respuesta organizada cuando algo falla.',summary:'Mesa de ayuda, seguimiento y mantenimiento IT.',copy:'Recibimos incidentes, definimos prioridades y seguimos cada caso hasta su resolución. El mantenimiento y la documentación ayudan a sostener la operación diaria.'},
 '106':{title:'Decisiones de tecnología con un plan claro.',summary:'Relevamiento, arquitectura y prioridades verificables.',copy:'Relevamos tu infraestructura y los riesgos de la operación. Ordenamos las decisiones en un plan con alcance, prioridades y documentación para evaluar cada inversión.'},
 '107':{title:'Detección temprana para activar la respuesta.',summary:'Dispositivos, central y puesta en marcha del sistema.',copy:'Diseñamos la detección según el riesgo y el lugar. Instalamos, probamos y documentamos los dispositivos y la central para que alarmas y fallas tengan una respuesta prevista.'},
 '108':{title:'Respaldo eléctrico donde tu operación lo necesita.',summary:'Alimentación, UPS y distribución para cargas de IT.',copy:'Definimos las cargas críticas y la autonomía necesaria. Integramos alimentación, respaldo y distribución para sostener los equipos y facilitar su mantenimiento.'},
};
const items=plan.map(chapter=>services.find(s=>s.code===chapter.code)).filter((s):s is Service=>!!s&&!!ISOMETRIC_STUDIES[s.code]).map(s=>({...s,study:ISOMETRIC_STUDIES[s.code],message:{...messages[s.code],...(sector?{title:plan.find(chapter=>chapter.code===s.code)!.scenes[0].title}:{})}}));
const narrative=plan.filter(chapter=>items.some(item=>item.code===chapter.code));
const phases=[{id:'system',name:'Proyecto'},{id:'object',name:'Pieza'},{id:'layers',name:'Interior'},{id:'detail',name:'Detalle'}];
const first=items[0];
const outline=(chapter:typeof narrative[number])=>chapter.overview||[chapter.scenes[0],chapter.scenes.find(scene=>scene.view==='layers')||chapter.scenes[1],chapter.scenes.at(-1)!];
const hasHardware=items.some(s=>s.code==='101'||Boolean(EQUIPMENT_KITS[s.code]));
const hasDiscipline=items.some(s=>Boolean(DISCIPLINE_SYSTEMS[s.code]));
const hasSoftware=items.some(s=>s.code==='104');
const hasSupport=items.some(s=>s.code==='105');
const hasConsulting=items.some(s=>s.code==='106');
const tabNames:Record<string,string>={'101':'Redes','102':'Seguridad','103':'Telecomunicaciones','104':'Software','105':'Soporte 24/7','106':'Consultoría','107':'Incendios','108':'Energía IT'};
---
{first && <div class:list={["svc-story",{"svc-story--project":Boolean(projectMarkup),"svc-story--single":single}]} data-service-atlas data-context-project={String(contextProject)} data-discipline-layout={String(hasDiscipline)} data-discipline-active={String(Boolean(DISCIPLINE_SYSTEMS[first.code])&&(!contextProject||first.code==='104'))} data-story-loop={String(Boolean(project)||items.length>1)} data-active-service={first.code} data-story-state="waiting" data-story-view="system">
 <script type="application/json" data-atlas-narrative set:html={JSON.stringify(narrative)} is:inline />
 <div class="svc-story__stage">
  <div class="svc-story__masthead"><span data-atlas-code>{first.study.name}</span><div class="svc-story__playback"><span class="svc-story__counter" data-atlas-counter>01 / {String(items.length).padStart(2,'0')}</span><span data-atlas-status>Recorrido automático</span><button type="button" data-atlas-play aria-pressed="false" hidden>Pausar</button></div></div>
  <header class="svc-story__heading"><h3 data-atlas-title>{first.message.title}</h3></header>
  <figure class="svc-story__explanation">
  <div class="svc-story__visual">
  <div class="svc-story__location"><span data-atlas-scale>En el proyecto</span><span data-atlas-part-name hidden /></div>
  <div class="svc-story__theater" data-atlas-theater>
   {hasDiscipline&&<DisciplineSystem visible={!contextProject||first.code==='104'} code={first.code} codes={items.map(item=>item.code)} />}
   {projectMarkup&&<div class="svc-story__project" data-atlas-project data-project-floors={project?.scene==='building'?3:1} data-project-service={first.code} data-project-view="0" data-project-open="false" data-project-visible="false"><Fragment set:html={projectMarkup} /></div>}
   {!hasDiscipline&&hasHardware&&<div data-atlas-network hidden={Boolean(project)}><NetworkJourney compact catalog guided /></div>}
   <div class="svc-story__frame" hidden>{!hasDiscipline&&hasSupport&&<div class="svc-story__operations" data-atlas-operation="105" hidden><IsometricStage code="105" compact /></div>}{!hasDiscipline&&hasConsulting&&<div class="svc-story__operations" data-atlas-operation="106" hidden><IsometricStage code="106" compact /></div>}{!hasDiscipline&&hasSoftware&&<div class="svc-story__software" data-atlas-software hidden><SoftwareLayers compact guided /></div>}<img src={project||hasDiscipline?undefined:url(first.study.asset,'object')} alt={first.study.object} width="1040" height="755" loading="lazy" decoding="async" data-atlas-image /></div>
  </div>
   <div class="svc-story__narration"><h4 class="svc-story__scene-title" data-atlas-scene-title>{narrative[0].scenes[0].title}</h4><p class="svc-story__illustration-copy" data-atlas-context>{narrative[0].scenes[0].copy}</p></div>
  </div>
  <figcaption class="svc-story__reading">
   <p class="svc-story__reading-label" data-atlas-reading-label>Cómo lo resolvemos</p>
   <ol class="svc-story__outline" data-atlas-outline>{outline(narrative[0]).map((scene,i)=><li data-story-point data-state={i===0?'current':'next'}><span class="svc-story__point-number" aria-hidden="true">0{i+1}</span><div><h4 data-point-title>{scene.title}</h4><p data-point-copy>{scene.copy}</p></div></li>)}</ol>
   <a class="svc-story__link" href={first.href} data-atlas-link>Explorar {first.study.name.toLowerCase()} <span aria-hidden="true">→</span></a>
  </figcaption>
   {project&&<ol class="svc-story__flow" data-atlas-flow aria-label="Cómo funciona el servicio">{narrative[0].scenes[0].flow?.nodes.map((node,i)=><li data-flow-node data-state={i===0?'current':'next'}><span class="svc-story__flow-dot" aria-hidden="true" /><span data-flow-label>{node}</span></li>)}</ol>}

  </figure>
  <div class="svc-story__beat" aria-label="Etapas del recorrido"><span data-atlas-beat="system">Proyecto</span><span data-atlas-beat="object">Equipo</span><span data-atlas-beat="layers">Por dentro</span><span data-atlas-beat="detail">Conexión</span><span data-atlas-beat="result">Resultado</span></div>
  {!hasDiscipline&&<details class="svc-story__technical"><summary>Volver a una vista</summary>
  <div class="svc-story__views" role="group" aria-label="Vistas del servicio">{phases.map((phase,i)=><button type="button" data-atlas-view={phase.id} aria-pressed={String(i===0)}><span aria-hidden="true">0{i+1}</span>{phase.name}</button>)}</div>
  </details>}
  {!hasDiscipline&&<div class="svc-story__exploration"><details class="svc-story__equipment" data-atlas-equipment><summary>Explorar otras piezas</summary><label><span>Equipo</span><select data-atlas-part aria-label="Equipo que querés explorar">{EQUIPMENT_KITS[first.code]?.parts.map(id=><option value={id} selected={id===EQUIPMENT_KITS[first.code].initial}>{NETWORK_EQUIPMENT.find(part=>part.id===id)?.name}</option>)}</select></label></details></div>}
  <p data-atlas-copy hidden>{first.message.copy}</p>
  <p class="svc-story__announcement" data-atlas-announce aria-live="polite" aria-atomic="true" />
 </div>
 <div class="svc-story__choice">
  <p class="svc-story__choice-title">{sector&&project?project.name:"Ocho servicios. Una operación conectada."}</p>
  <label class="svc-story__picker"><span>Servicio</span><select data-atlas-picker aria-label="Servicio que querés conocer">{items.map(s=><option value={s.code} selected={s===first}>{s.study.name}</option>)}</select></label>
  <ol class="svc-story__list" aria-label="Servicios disponibles">
   {items.map((s,i)=><li class="svc-story__item">
    <button type="button" data-atlas-service={s.code} data-equipment-kit={EQUIPMENT_KITS[s.code]?s.code:undefined} data-object={url(s.study.asset,'object')} data-system={url(s.study.asset,'system')} data-detail={url(s.study.asset,'detail')} data-name={s.study.name} data-title={s.message.title} data-copy={s.message.copy} data-context={s.study.views[0].description} data-object-copy={s.study.views[1].description} data-layers-copy={s.study.views[2].description} data-detail-copy={s.study.views[3].description} data-alt={s.study.object} data-href={s.href} aria-pressed={String(i===0)}>
     <span class="svc-story__code">{String(i+1).padStart(2,'0')}</span><span class="svc-story__text"><strong>{project?tabNames[s.code]:s.study.name}</strong><span>{s.message.summary}</span></span><span class="svc-story__arrow" aria-hidden="true">→</span>
    </button>
   </li>)}
  </ol>
 </div>
</div>}
<script src="/cine/isometric-services-v7.js" type="module" async is:inline />
<script src="/cine/service-atlas-v20.js" type="module" async is:inline />
<style>
 .svc-story{--skin-text:#fff;--skin-muted:#c4c7cc;--x-text:#fff;--x-text-2:#c4c7cc;color:#fff;min-width:0}
 .svc-story [hidden]{display:none!important}.svc-story button,.svc-story select,.svc-story summary,.svc-story a{font:500 1rem var(--um-font-body,'UM Sans',Arial,sans-serif)}
 .svc-story button:focus-visible,.svc-story a:focus-visible,.svc-story summary:focus-visible,.svc-story select:focus-visible{outline:2px solid #fff;outline-offset:4px}
 .svc-story__stage{min-width:0;scroll-margin-top:100px}.svc-story__masthead{display:flex;align-items:center;justify-content:space-between;gap:24px;border-top:1px solid #ffffff30;padding-top:20px;font-size:1rem;line-height:1.5;color:#c4c7cc}
 .svc-story__masthead>span{color:#fff}.svc-story__playback{display:flex;align-items:center;gap:20px;font-size:1rem}.svc-story__counter{font-variant-numeric:tabular-nums;color:#c4c7cc}.svc-story__playback button{padding:8px 0;min-height:44px;border:0;background:none;color:#fff;cursor:pointer;text-decoration:underline;text-underline-offset:6px;text-decoration-color:#dc2626}
 .svc-story__heading{padding:12px 0 28px}.svc-story__heading h3{font-size:clamp(1.5rem,2.6vw,2.25rem);font-weight:600;line-height:1.16;max-width:32ch;margin:0;text-wrap:balance;min-block-size:2.32em}
 .svc-story__explanation{display:grid;grid-template-columns:minmax(0,1.55fr) minmax(300px,1fr);gap:24px 56px;margin:0;align-items:start}
 .svc-story__visual{min-width:0}.svc-story__location{display:flex;justify-content:space-between;gap:16px;color:#c4c7cc;min-height:32px;font-size:1rem;line-height:1.5}.svc-story__location>span+span{color:#fff;text-align:right}
 .svc-story__theater{height:440px;position:relative;min-width:0;isolation:isolate;overflow:hidden}
 .svc-story__theater>[data-atlas-network],.svc-story__frame{width:100%;height:100%;position:absolute;inset:0;min-width:0;transition:opacity 1000ms ease,visibility 1000ms ease}
 [data-atlas-visible=false]{opacity:0;visibility:hidden;pointer-events:none}.svc-story__frame img{width:100%;height:100%!important;object-fit:contain;display:block}
 .svc-story__software,.svc-story__operations{width:100%;height:100%}
 .svc-story__narration{border-top:1px solid #ffffff24;padding-top:20px;min-height:150px}.svc-story__scene-title{font-size:1.125rem;line-height:1.4;font-weight:600;margin:0 0 10px;color:#fff}.svc-story__illustration-copy{font-size:1rem;line-height:1.55;color:#c4c7cc;margin:0;max-width:65ch}
 .svc-story__reading{padding-top:0;min-width:0}.svc-story__reading-label{font-size:1rem;line-height:1.5;margin:0 0 24px;color:#c4c7cc}
 .svc-story__outline{list-style:none;margin:0;padding:0}.svc-story__outline li{display:grid;grid-template-columns:26px minmax(0,1fr);gap:16px;padding:0 0 26px;position:relative;color:#c4c7cc}.svc-story__outline li::before{content:'';position:absolute;left:8px;top:30px;bottom:8px;width:1px;background:#ffffff25}.svc-story__outline li:last-child::before{display:none}
 .svc-story__point-number{font-size:1rem;line-height:1.5;font-variant-numeric:tabular-nums;transition:color 500ms ease}.svc-story__outline [data-state=current] .svc-story__point-number{color:#fff}.svc-story__outline [data-state=current] .svc-story__point-number::after{content:'';position:absolute;left:0;top:28px;width:18px;height:2px;background:#dc2626}
 .svc-story__outline h4{font-size:1.125rem;font-weight:500;line-height:1.4;color:#fff;margin:0 0 9px}.svc-story__outline p{font-size:1rem;line-height:1.55;margin:0}.svc-story__link{display:flex;align-items:center;justify-content:space-between;gap:20px;color:#fff;min-height:48px;text-decoration:underline;text-underline-offset:7px;text-decoration-color:#dc2626}
 .svc-story__flow{grid-column:1/-1;display:flex;gap:24px;margin:0;list-style:none;padding:16px 0;border-top:1px solid #ffffff24;color:#c4c7cc;font-size:1rem;line-height:1.5}.svc-story__flow li{display:flex;gap:24px;align-items:baseline;flex:1}.svc-story__flow li+li::before{content:'→';color:#dc2626}.svc-story__flow-dot{display:none}.svc-story__flow [data-state=current]{color:#fff}
 .svc-story__beat{display:flex;gap:24px;color:#c4c7cc;font-size:1rem;line-height:1.5;padding:8px 0 20px;overflow-x:auto;scrollbar-width:none}.svc-story__beat span{white-space:nowrap;padding-bottom:8px;border-bottom:2px solid transparent}.svc-story__beat [data-current=true]{color:#fff;border-bottom-color:#dc2626}
 .svc-story__choice{margin-top:24px}.svc-story__choice-title{color:#c4c7cc;font-size:1rem;margin:0 0 12px}.svc-story__list{list-style:none;display:grid;grid-template-columns:repeat(4,minmax(0,1fr));padding:0;margin:0;border-top:1px solid #ffffff30}.svc-story__item{min-width:0;border-bottom:1px solid #ffffff30}
 .svc-story__item button{display:flex;align-items:baseline;gap:12px;width:100%;min-height:64px;padding:16px 12px 16px 0;background:none;border:0;text-align:left;color:#c4c7cc;cursor:pointer}.svc-story__item button[aria-pressed=true]{color:#fff}.svc-story__item button[aria-pressed=true] .svc-story__code{color:#dc2626}.svc-story__code{font-variant-numeric:tabular-nums}.svc-story__text strong{font-weight:500;font-size:1rem;line-height:1.5}.svc-story__text>span,.svc-story__arrow,.svc-story__picker{display:none}
 .svc-story__technical,.svc-story__exploration{display:inline-block;vertical-align:top;margin-right:24px;color:#c4c7cc}.svc-story summary{cursor:pointer;min-height:44px;padding:12px 0}.svc-story__views{display:flex;flex-wrap:wrap;gap:16px}.svc-story__views button{padding:10px 0;background:none;border:0;color:#fff;cursor:pointer}.svc-story__views button span{display:none}.svc-story__views button[aria-pressed=true]{text-decoration:underline;text-decoration-color:#dc2626;text-underline-offset:6px}
 .svc-story__equipment label{display:flex;align-items:center;gap:12px}.svc-story__equipment select{min-height:44px;min-width:0;max-width:100%;padding:8px;background:#111;color:#fff;border:1px solid #ffffff40;color-scheme:dark}.svc-story__announcement{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
 .svc-story--single .svc-story__choice,.svc-story--single .svc-story__link{display:none}
 @media(hover:hover){.svc-story__item button:hover{color:#fff}.svc-story__link:hover{text-decoration-thickness:2px}}
 @media(min-width:1500px){.svc-story__theater{height:480px}}
 @media(max-width:1100px){.svc-story__explanation{gap:24px 32px;grid-template-columns:minmax(0,1.35fr) minmax(280px,1fr)}.svc-story__theater{height:380px}.svc-story__playback>span:nth-child(2){display:none}}
 @media(max-width:900px){.svc-story__explanation{display:block}.svc-story__heading h3{min-block-size:0}.svc-story__reading{padding-top:28px}.svc-story__outline{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:24px}.svc-story__outline li{display:block;padding-bottom:20px}.svc-story__outline li::before,.svc-story__point-number::after{display:none}.svc-story__point-number{display:block;margin-bottom:12px}.svc-story__link{max-width:400px}.svc-story__flow{margin-top:24px}.svc-story__narration{min-height:126px}.svc-story__theater{height:420px}}
 @media(max-width:600px){.svc-story__masthead{gap:12px;padding-top:12px}.svc-story__playback{gap:12px}.svc-story__heading{padding-bottom:24px}.svc-story__heading h3{font-size:1.5rem;min-block-size:3.48em}.svc-story__theater{height:310px}.svc-story__location{font-size:1rem;min-height:52px}.svc-story__location>span{max-width:60%}.svc-story__outline{display:block}.svc-story__outline li{display:grid;grid-template-columns:24px 1fr;gap:16px}.svc-story__point-number{margin:0}.svc-story__narration{min-height:190px}.svc-story__reading{padding-top:8px}.svc-story__reading-label{margin-bottom:20px}.svc-story__flow{display:none}.svc-story__beat{gap:20px}.svc-story__list{grid-template-columns:repeat(2,minmax(0,1fr))}.svc-story__choice-title{max-width:30ch}.svc-story__theater :global(.network-journey__canvas svg){width:160%;left:-34%;max-width:none}.svc-story__project :global(svg){position:absolute;width:160%;left:-34%;max-width:none}.svc-story__project:not([data-project-view="0"]) :global(.sp-root){transform:translate(220px,70px) scale(.20)}.svc-story__project :global(.sp-floor-label){display:none}.svc-story--project .svc-story__software,.svc-story--project .svc-story__operations{margin-left:16%;width:84%}}
 @media(prefers-reduced-motion:reduce){.svc-story__theater>*{transition:none!important}.svc-story__project :global(g){transition:none!important;animation:none!important}}

 .svc-story__project{position:absolute;inset:0;pointer-events:none}.svc-story__project :global(svg){width:100%;height:100%;overflow:visible}.svc-story__project :global(.sp-root){transform-origin:0 0;transform:translate(0,0) scale(1);transition:transform 1400ms cubic-bezier(.22,1,.36,1)}
 .svc-story__project[data-project-floors="1"][data-project-view="0"] :global(.sp-root){transform:translate(0,-100px) scale(1.04)}
 .svc-story__project[data-project-floors="1"][data-project-open=true][data-project-view="0"] :global(.sp-root){transform:translate(-20px,-112px) scale(1.08)}
 .svc-story__project[data-project-open=true][data-project-view="0"] :global(.sp-root){transform:translate(-20px,-12px) scale(1.04)}
 .svc-story__project:not([data-project-view="0"]) :global(.sp-root){transform:translate(-80px,340px) scale(.33)}
 .svc-story__project :global(.sp-route path){stroke-width:1.2}
 .svc-story__project :global(.sp-route){opacity:.075;transition:opacity 800ms ease}.svc-story__project :global(.sp-pin){opacity:0;transition:opacity 600ms ease}.svc-story__project :global(.sp-leader){opacity:0;transition:opacity 900ms ease}.svc-story__project:not([data-project-view="0"]) :global(.sp-leader){opacity:.7}
 .svc-story__project[data-project-service="106"] :global(.sp-route){opacity:.7}
 .svc-story__project[data-project-service="101"] :global(.sp-route--101){opacity:.94}.svc-story__project[data-project-service="101"] :global(.sp-pin--101){opacity:1}
 .svc-story__project[data-project-service="102"] :global(.sp-route--102){opacity:.94}.svc-story__project[data-project-service="102"] :global(.sp-pin--102){opacity:1}
 .svc-story__project[data-project-service="103"] :global(.sp-route--103){opacity:.94}.svc-story__project[data-project-service="103"] :global(.sp-pin--103){opacity:1}
 .svc-story__project[data-project-service="104"] :global(.sp-route--104){opacity:.94}.svc-story__project[data-project-service="104"] :global(.sp-pin--104){opacity:1}
