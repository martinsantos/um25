---
/**
 * Capacidad de proveedor: cómo entrega ULTIMA MILLA un proyecto, con qué
 * documentación y con qué cobertura. Textos tomados de /certificaciones,
 * /nosotros y los servicios publicados; sin cifras no aprobadas.
 */


const process = [
  ['Relevamiento', 'Visita técnica, inventario de sistemas existentes y definición de alcance con el responsable de operación.'],
  ['Ingeniería', 'Planos, memoria técnica y lista de materiales por sistema, según las normas aplicables a cada obra.'],
  ['Instalación', 'Ejecución en campo con equipo propio: tendidos, racks, energía, cámaras, paneles y puesta en marcha.'],
  ['Certificación y entrega', 'Protocolos de prueba, certificación de puntos con equipamiento Fluke y documentación de obra.'],
  ['Soporte 24/7', 'Mesa de ayuda, NOC y mantenimiento con SLA sobre lo instalado, con trazabilidad por ticket.'],
];

const outputs = ['Alcance e inventario', 'Planos y memoria técnica', 'Registro de instalación', 'Protocolos y mediciones', 'Tickets e historial'];
---
<div class="um-cap">
  <div class="um-cap__head">
    <div>
      <p class="um-cap__kicker"><span></span>Capacidad de proveedor</p>
      <h2>De la visita técnica a una entrega verificable.</h2>
    </div>
    <p>Cada etapa produce algo que tu equipo puede revisar. Esa documentación conecta la obra con su operación y su mantenimiento.</p>
  </div>

  <div class="um-cap__body">
    <ol class="um-cap__process" aria-label="Circuito de entrega">
      {process.map(([title, text], i) => (
        <li>
          <span class="um-cap__step">{String(i + 1).padStart(2, '0')}</span>
          <div>
            <strong>{title}</strong>
            <p>{text}</p>
          </div>
          <p class="um-cap__output"><span>Entregable</span><strong>{outputs[i]}</strong></p>
        </li>
      ))}
    </ol>


  </div>

  <div class="um-cap__ledger">
    <section class="um-cap__block" aria-labelledby="cap-doc">
      <h3 id="cap-doc">Entregables documentados</h3>
      <p>Revisá los criterios de certificación y la documentación técnica que acompaña la entrega de cada sistema.</p>
      <a href="/certificaciones">Ver documentación técnica <span aria-hidden="true">→</span></a>
    </section>

    <section class="um-cap__block um-cap__block--cta" aria-labelledby="cap-rfq">
      <h3 id="cap-rfq">Pedido de cotización</h3>
      <p>Enviá el pliego, el plano o una descripción del sitio. Definimos el alcance y la información técnica necesaria para preparar la propuesta.</p>
      <a class="um-cap__btn" href="/presupuesto-servicios-it-empresas">Pedir presupuesto <span aria-hidden="true">↗</span></a>
    </section>
  </div>
</div>

<style>
  .um-cap {
    color: #fff;
  }

  .um-cap__head {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 24px clamp(28px, 5vw, 80px);
    align-items: end;
    margin-bottom: clamp(32px, 4vw, 56px);
  }

  .um-cap__head > p {
    margin: 0;
    color: #c4c7cc;
    font-size: var(--um-copy-description, 1.125rem);
    line-height: var(--um-body-line-height, 1.62);
    max-width: 48ch;
  }

  .um-cap__kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 16px;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: #c4c7cc;
  }

  .um-cap__kicker span {
    width: 28px;
    height: 2px;
    background: #dc2626;
  }

  .um-cap h2 {
    margin: 0;
    font-size: var(--um-world-h2, 2.125rem) !important;
    line-height: var(--um-heading-h2-line-height, 1.12) !important;
    font-weight: 600 !important;
    letter-spacing: -0.025em;
    max-width: 20ch;
    text-wrap: balance;
  }

  .um-cap__body {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }

  .um-cap__process {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(255, 255, 255, 0.14);
  }

  .um-cap__process li {
    display: grid;
    grid-template-columns: 44px minmax(0, 1.6fr) minmax(180px, .8fr);
    gap: 12px;
    padding: 18px 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
  }

  .um-cap__step {
    font-family: var(--um-font-mono);
    font-size: 1rem;
    font-weight: 600;
    color: #dc2626;
    font-variant-numeric: tabular-nums;
    padding-top: 3px;
  }

  .um-cap__process strong {
    display: block;
    font-size: 1.12rem;
    font-weight: 600;
  }

  .um-cap__process p {
    margin: 6px 0 0;
    color: #c4c7cc;
    font-size: 1rem;
    line-height: 1.55;
  }

  .um-cap__ledger {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
    gap: clamp(24px, 5vw, 64px);
    margin-top: clamp(40px, 5vw, 72px);
    border-top: 1px solid rgba(255, 255, 255, 0.2);
  }

  .um-cap__block {
    display: flex;
    flex-direction: column;
    padding: 28px 0;
    background: transparent;
  }

  .um-cap__block--cta {
    background: transparent;
  }

  .um-cap__block h3 {
    margin: 0 0 18px;
    font-size: 1.25rem !important;
    line-height: 1.25 !important;
    font-weight: 600 !important;
  }

  .um-cap__block ul {
    list-style: none;
    margin: 0;
    padding: 0;
    flex: 1;
  }

  .um-cap__block li {
    display: grid;
    gap: 3px;
    padding: 12px 0;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
  }

  .um-cap__block li strong {
    font-size: 1rem;
    font-weight: 600;
  }

  .um-cap__block li span {
    color: #c4c7cc;
    font-size: 1rem;
    line-height: 1.5;
  }

  .um-cap__coverage li {
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
  }

  .um-cap__coverage li span {
    font-family: var(--um-font-mono);
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .um-cap__block > p {
    flex: 1;
    margin: 0;
    color: #c4c7cc;
    font-size: 1rem;
    line-height: 1.55;
  }

  .um-cap__block > a {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    align-self: flex-start;
    min-height: 44px;
    margin-top: 16px;
    font-size: 1rem;
    font-weight: 600;
    color: #fff;
    text-decoration: none;
    border-bottom: 1px solid #dc2626;
  }

  .um-cap__block > a:hover,
  .um-cap__block > a:focus-visible {
    border-bottom-color: #fff;
  }

  .um-cap__block > a.um-cap__btn {
    min-height: 52px;
    padding: 0 24px;
    background: #dc2626;
    border: 0;
  }

  .um-cap__block > a.um-cap__btn:hover,
  .um-cap__block > a.um-cap__btn:focus-visible {
    background: #b91c1c;
  }

  .um-cap__process .um-cap__output{margin:0;padding:0 0 0 24px;border-left:1px solid #ffffff20;align-self:center}
  .um-cap__output span{display:block;margin-bottom:6px;color:#c4c7cc;font-size:1rem}
  .um-cap__output strong{font-size:1rem;color:#fff;line-height:1.5}
  @media(max-width:600px){.um-cap__process li{grid-template-columns:28px minmax(0,1fr)}.um-cap__process .um-cap__output{grid-column:2;padding:8px 0 0;border:0}.um-cap__output span{display:inline;margin-right:8px}.um-cap__output strong{display:inline}}
  @media (max-width: 1100px) {
    .um-cap__ledger {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 900px) {
    .um-cap__head,
    .um-cap__body {
      grid-template-columns: 1fr;
    }

    .um-cap__stage {
      order: -1;
    }
  }

  @media (max-width: 760px) {
    .um-cap__head {
      gap: 14px;
      margin-bottom: 24px;
    }

    .um-cap h2 {
      font-size: 1.75rem !important;
    }

    .um-cap__process li {
      padding: 14px 0;
    }

    .um-cap__ledger {
      margin-top: 32px;
    }

    .um-cap__block > a.um-cap__btn {
      align-self: stretch;
      justify-content: center;
    }
  }
</style>
