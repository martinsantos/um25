---
// One stage, one reading: a sticky real-time isometry on one side and a list on the
// other. The item in the middle of the screen (or the one opened) drives the scene:
// its layer lights up, the skeleton opens and the camera moves to its equipment.
export interface StageItem {
  key: string;
  label: string;
  kicker?: string;
  promise?: string;
  sector: string;
  layer: string;
  point: string | null;
  film?: number;
  scope?: string[];
  equipment?: string[];
  deliverable?: string;
  standard?: string;
  links?: { label: string; href: string }[];
  cases?: { title: string; href: string; meta?: string }[];
}
interface Props { id: string; kicker: string; title: string; lead?: string; items: StageItem[]; open?: string }
const { id, kicker, title, lead, items, open } = Astro.props;
const COLOR: Record<string, string> = { en: '#E2B04A', da: '#3FC7B8', se: '#8B7CF6', de: '#F07A5A', all: '#ffffff' };
const LAYER: Record<string, string> = { en: 'Energía', da: 'Datos', se: 'Seguridad', de: 'Detección', all: 'Todas las capas' };
const first = items.find((item) => item.key === open) || items[0];
---
{first && (
<section class="stage" id={id} data-stage data-sector={first.sector} aria-labelledby={`${id}-title`}>
  <header class="stage__head">
    <p class="stage__kicker"><span></span>{kicker}</p>
    <h2 id={`${id}-title`}>{title}</h2>
    {lead && <p class="stage__lead">{lead}</p>}
  </header>
  <div class="stage__grid">
    <div class="stage__view">
      <div class="stage__sticky">
        <div class="stage__canvas" data-iso-canvas></div>
        <div class="stage__tags" data-iso-tags aria-hidden="true"></div>
        <p class="stage__now" aria-live="polite"><b data-stage-dot></b><span data-stage-now>{first.label}</span><em data-stage-layer>{LAYER[first.layer]}</em></p>
        {first.film !== undefined && <button type="button" class="stage__film" data-stage-film>Verlo en la película <span aria-hidden="true">↑</span></button>}
      </div>
    </div>
    <ol class="stage__list">
      {items.map((item, index) => (
        <li class:list={['stage__item', { 'is-open': item.key === first.key }]} data-stage-item data-key={item.key} data-sector={item.sector} data-layer={item.layer} data-point={item.point || ''} data-film={item.film ?? ''} data-label={item.label} data-layer-name={LAYER[item.layer]} style={`--c:${COLOR[item.layer]}`}>
          <button type="button" class="stage__toggle" aria-expanded={item.key === first.key ? 'true' : 'false'} aria-controls={`${id}-${item.key}`}>
            <span class="stage__num">{String(index + 1).padStart(2, '0')}</span>
            <span class="stage__name">{item.kicker && <small>{item.kicker}</small>}{item.label}</span>
            <span class="stage__chev" aria-hidden="true"></span>
          </button>
          {item.promise && <p class="stage__promise">{item.promise}</p>}
          <div class="stage__body" id={`${id}-${item.key}`}>
            <div class="stage__inner">
              {item.scope && item.scope.length > 0 && (<><h3>Qué hacemos</h3><ul class="stage__scope">{item.scope.map((s) => <li>{s}</li>)}</ul></>)}
              {item.equipment && item.equipment.length > 0 && (<><h3>Equipos</h3><ul class="stage__chips">{item.equipment.map((s) => <li>{s}</li>)}</ul></>)}
              {(item.deliverable || item.standard) && (
                <dl class="stage__facts">
                  {item.deliverable && <div><dt>Entregable clave</dt><dd>{item.deliverable}</dd></div>}
                  {item.standard && <div><dt>Norma de referencia</dt><dd>{item.standard}</dd></div>}
                </dl>
              )}
              {item.cases && item.cases.length > 0 && (<><h3>Antecedentes</h3><ul class="stage__cases">{item.cases.map((c) => <li><a href={c.href}>{c.title}{c.meta && <small>{c.meta}</small>}</a></li>)}</ul></>)}
              {item.links && item.links.length > 0 && <p class="stage__links">{item.links.map((l) => <a href={l.href}>{l.label} <span aria-hidden="true">→</span></a>)}</p>}
            </div>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>)}

<style>
  .stage{width:min(var(--um-container-wide),calc(100% - (var(--um-page-gutter) * 2)));margin:clamp(48px,7vw,104px) auto;color:#fff;background:#0a0b0d;padding:clamp(20px,3.2vw,48px);box-sizing:border-box}
  .stage__kicker{display:flex;align-items:center;gap:12px;margin:0;font-size:.8rem;letter-spacing:.16em;text-transform:uppercase;color:#c4c7cc}
  .stage__kicker span{width:28px;height:2px;background:#DC2626}
  .stage__head h2{margin:12px 0 0;max-width:22ch;font-size:clamp(1.7rem,2.8vw,2.6rem);line-height:1.1;letter-spacing:-.01em}
  .stage__lead{margin:14px 0 0;max-width:60ch;color:#c4c7cc;font-size:1.05rem;line-height:1.6}
  .stage__grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(320px,1fr);gap:clamp(24px,3vw,48px);margin-top:clamp(28px,3.4vw,48px);align-items:start}
  .stage__sticky{position:sticky;top:88px;aspect-ratio:4/3;max-height:calc(100svh - 120px);width:100%;overflow:hidden;border:1px solid rgba(255,255,255,.08);background:radial-gradient(120% 90% at 50% 40%,#151a21 0%,#0b0e12 55%,#07080a 100%)}
  .stage__view{align-self:stretch}
  .stage__canvas,.stage__tags{position:absolute;inset:0}
  .stage__canvas :global(canvas){display:block;width:100%;height:100%}
  .stage__tags{pointer-events:none}
  .stage__tags :global(.iso3d__tag){position:absolute;transform:translate(10px,-50%);display:flex;align-items:center;gap:8px;padding:6px 10px 6px 8px;background:rgba(7,8,10,.82);border:1px solid rgba(255,255,255,.12);font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;white-space:nowrap;opacity:0;transition:opacity .5s}
  .stage__tags :global(.iso3d__tag)::before{content:'';width:6px;height:6px;border-radius:50%;background:var(--c,#fff)}
  .stage__tags :global(.iso3d__tag.is-on){opacity:.95}
  .stage__now{position:absolute;left:16px;top:16px;display:flex;align-items:center;gap:10px;margin:0;padding:8px 12px;background:rgba(7,8,10,.78);border:1px solid rgba(255,255,255,.12);font-size:.82rem;letter-spacing:.06em}
  .stage__now b{width:8px;height:8px;border-radius:50%;background:var(--now,#fff);transition:background .4s}
  .stage__now em{font-style:normal;color:#c4c7cc}
  .stage__film{position:absolute;right:16px;bottom:16px;min-height:40px;padding:0 14px;border:1px solid rgba(255,255,255,.24);background:rgba(7,8,10,.6);color:#fff;font:inherit;font-size:.85rem;cursor:pointer}
  .stage__film:hover{border-color:#fff}
  .stage__film:focus-visible,.stage__toggle:focus-visible{outline:2px solid #DC2626;outline-offset:2px}
  .stage__list{list-style:none;margin:0;padding:0;border-top:1px solid rgba(255,255,255,.1)}
  .stage__item{position:relative;border-bottom:1px solid rgba(255,255,255,.1);padding:4px 0 4px 18px;transition:background .3s}
  .stage__item::before{content:'';position:absolute;left:0;top:14px;bottom:14px;width:2px;background:var(--c);transform:scaleY(0);transform-origin:top;transition:transform .4s cubic-bezier(.2,.7,.1,1)}
  .stage__item.is-active::before{transform:scaleY(1)}
  .stage__item.is-active{background:rgba(255,255,255,.025)}
  .stage__toggle{display:grid;grid-template-columns:36px minmax(0,1fr) 20px;align-items:center;gap:12px;width:100%;min-height:64px;padding:12px 8px 12px 0;border:0;background:none;color:inherit;font:inherit;text-align:left;cursor:pointer}
  .stage__num{font-size:.85rem;color:#8b9097;font-variant-numeric:tabular-nums}
  .stage__item.is-active .stage__num{color:#DC2626}
  .stage__name{display:flex;flex-direction:column;gap:2px;font-size:1.12rem;font-weight:700;line-height:1.25}
  .stage__name small{font-size:.72rem;font-weight:400;letter-spacing:.14em;text-transform:uppercase;color:#8b9097}
  .stage__chev{width:10px;height:10px;border-right:2px solid #8b9097;border-bottom:2px solid #8b9097;transform:rotate(45deg);transition:transform .3s;justify-self:center}
  .stage__item.is-open .stage__chev{transform:rotate(-135deg)}
  .stage__promise{margin:-4px 8px 12px 48px;color:#c4c7cc;font-size:.98rem;line-height:1.5}
  .stage__body{display:grid;grid-template-rows:0fr;transition:grid-template-rows .45s cubic-bezier(.2,.7,.1,1)}
  .stage__item.is-open .stage__body{grid-template-rows:1fr}
  .stage__inner{overflow:hidden;padding-left:48px;padding-right:8px}
  .stage__item.is-open .stage__inner{padding-bottom:20px}
  .stage__inner h3{margin:14px 0 8px;font-size:.74rem;letter-spacing:.16em;text-transform:uppercase;color:#8b9097;font-weight:600}
  .stage__scope{margin:0;padding:0 0 0 18px;color:#e6e8eb;line-height:1.55;font-size:.97rem}
  .stage__scope li+li{margin-top:4px}
  .stage__chips{list-style:none;display:flex;flex-wrap:wrap;gap:6px;margin:0;padding:0}
  .stage__chips li{padding:5px 10px;border:1px solid rgba(255,255,255,.14);font-size:.85rem;color:#e6e8eb}
  .stage__facts{display:grid;grid-template-columns:1fr 1fr;gap:12px;margin:16px 0 0}
  .stage__facts dt{font-size:.72rem;letter-spacing:.14em;text-transform:uppercase;color:#8b9097}
  .stage__facts dd{margin:4px 0 0;font-size:.95rem;line-height:1.45}
  .stage__cases{list-style:none;margin:0;padding:0}
  .stage__cases a{display:flex;flex-direction:column;gap:2px;padding:9px 0;border-top:1px solid rgba(255,255,255,.08);color:#fff;text-decoration:none;font-size:.95rem;line-height:1.4}
  .stage__cases a:hover{color:#fff;text-decoration:underline;text-underline-offset:3px}
  .stage__cases small{color:#8b9097;font-size:.8rem}
  .stage__links{display:flex;flex-wrap:wrap;gap:18px;margin:16px 0 0}
  .stage__links a{color:#fff;font-weight:600;text-decoration:none;border-bottom:1px solid #DC2626;padding-bottom:2px}
  @media (max-width:900px){
    .stage__grid{grid-template-columns:1fr}
    .stage__view{position:sticky;top:64px;z-index:2;background:#0a0b0d;padding-bottom:10px;box-shadow:0 12px 18px -10px #0a0b0d}
    .stage__sticky{position:relative;top:auto;aspect-ratio:16/10;max-height:42svh}
    .stage__facts{grid-template-columns:1fr}
  }
  @media (prefers-reduced-motion:reduce){.stage__body,.stage__item::before,.stage__chev{transition:none}}
</style>

<script>
  type StageApi = { set(o: { layer: string | null; point: string | null }): void; dispose(): void };
  function bindStage(root: HTMLElement) {
    if (root.dataset.stageBound) return; root.dataset.stageBound = '1';
    const items = [...root.querySelectorAll<HTMLElement>('[data-stage-item]')];
    const now = root.querySelector<HTMLElement>('[data-stage-now]')!, layerName = root.querySelector<HTMLElement>('[data-stage-layer]')!;
    const nowBox = root.querySelector<HTMLElement>('.stage__now')!, film = root.querySelector<HTMLButtonElement>('[data-stage-film]');
    let api: StageApi | null = null, sector = '', active: HTMLElement | null = null, pinned: HTMLElement | null = null, mod: any = null;
    async function show(item: HTMLElement) {
      if (active === item) return; active = item;
      items.forEach((i) => i.classList.toggle('is-active', i === item));
      now.textContent = item.dataset.label || ''; layerName.textContent = item.dataset.layerName || '';
      nowBox.style.setProperty('--now', getComputedStyle(item).getPropertyValue('--c'));
      if (film) film.hidden = item.dataset.film === '' || !document.querySelector('.umc video');
      if (!mod) return;
      if (item.dataset.sector !== sector) { api?.dispose(); sector = item.dataset.sector || ''; api = mod.mountStage(root, mod.SECTORS[sector]); }
      const layer = item.dataset.layer === 'all' ? 'all' : item.dataset.layer || null;
      api?.set({ layer, point: item.dataset.point || null });
    }
    function open(item: HTMLElement) {
      const willOpen = !item.classList.contains('is-open');
      items.forEach((i) => { const on = i === item && willOpen; i.classList.toggle('is-open', on); i.querySelector('.stage__toggle')?.setAttribute('aria-expanded', String(on)); });
      pinned = willOpen ? item : null; show(item);
    }
    items.forEach((item) => item.querySelector('.stage__toggle')?.addEventListener('click', () => open(item)));
    // Reading position drives the scene unless an item was opened by hand and is still on screen.
    const spy = new IntersectionObserver((entries) => {
      for (const e of entries) if (e.isIntersecting) { if (pinned && pinned !== e.target && isOnScreen(pinned)) continue; pinned = null; show(e.target as HTMLElement); }
    }, { rootMargin: '-45% 0px -45% 0px' });
    const isOnScreen = (el: HTMLElement) => { const r = el.getBoundingClientRect(); return r.bottom > 80 && r.top < innerHeight - 80; };
    items.forEach((i) => spy.observe(i));
    film?.addEventListener('click', () => {
      const t = Number(active?.dataset.film || 0), banner = document.querySelector<HTMLElement>('.umc');
      document.dispatchEvent(new CustomEvent('um:film-seek', { detail: { t } }));
      banner?.scrollIntoView({ behavior: matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth', block: 'start' });
    });
    const boot = new IntersectionObserver(async (entries) => {
      if (!entries.some((e) => e.isIntersecting)) return; boot.disconnect();
      const [engine, scenes] = await Promise.all([import('../../scripts/iso3d/engine.js'), import('../../scripts/iso3d/sectors.js')]);
      mod = { mountStage: engine.mountStage, SECTORS: scenes.SECTORS };
      const start = active || items.find((i) => i.classList.contains('is-open')) || items[0]; active = null; if (start) show(start);
    }, { rootMargin: '400px 0px' });
    boot.observe(root);
    show(items.find((i) => i.classList.contains('is-open')) || items[0]);
    document.addEventListener('astro:before-swap', () => { api?.dispose(); spy.disconnect(); boot.disconnect(); }, { once: true });
  }
  // The banner film jumps to the chapter that shows the service in context.
  if (!(window as any).__umFilmSeek) {
    (window as any).__umFilmSeek = true;
    document.addEventListener('um:film-seek', (e) => {
      const t = (e as CustomEvent).detail?.t ?? 0;
      const video = document.querySelector<HTMLVideoElement>('.umc video.is-on') || document.querySelector<HTMLVideoElement>('.umc video');
      if (!video) return; try { video.currentTime = t; void video.play(); } catch {}
    });
  }
  const bootAll = () => document.querySelectorAll<HTMLElement>('[data-stage]').forEach(bindStage);
  bootAll(); document.addEventListener('astro:page-load', bootAll);
</script>
