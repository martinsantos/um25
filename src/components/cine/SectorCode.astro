---
// A sector as an infographic you walk through: the model stays in view while the chapters
// scroll past it. Every service that applies to the sector is here — Consultoría opens with
// the survey, each physical service is a layer with its real equipment, standard and
// deliverable, the moment shows one of them working, and Soporte closes over the whole
// stack. Real cases sit under the service they describe.
import { SECTOR_FILMS, LAYER_STYLE } from '../../scripts/senal/sectorSpecs.js';
import { NAV_SERVICES } from '../../data/navigation';
import { SERVICE_SPECS } from '../../data/serviceSpecs';
import { sectorCases } from '../../data/cine/sectorCases';
interface Props { sector: keyof typeof SECTOR_FILMS }
const { sector } = Astro.props;
const spec = SECTOR_FILMS[sector];
const hrefOf = (code: number | string) => NAV_SERVICES.find((s) => s.code === String(code))?.href ?? '/servicios';
const nameOf = (code: number | string) => NAV_SERVICES.find((s) => s.code === String(code))?.name ?? '';
const facts = (code: number | string) => { const s = SERVICE_SPECS[String(code)]; return s ? [['Norma', s.keyStandard], ['Entrega', s.keyDeliverable]] : []; };
const cases = sectorCases(sector);
const casesOf = (code: number | string) => cases.filter((c) => c.svc === String(code)).slice(0, 3);
// Counts come from the model, so the text never says more than the drawing shows.
const NOCOUNT = new Set(['tray', 'fiber', 'loop', 'pipe', 'zone', 'card', 'cov']);
const countIn = (items: any[], kind: string) => items.filter((it) => it[0] === kind || (it[0] === 'node' && it[4] === kind)).length;
const countBase = (kind: string) => spec.pieces.filter((p) => p[0] === kind).length;
const BASE_COUNT = new Set(['bed', 'counter', 'cell', 'tank', 'mast', 'container', 'cabinet']);
const layers = spec.layers.map((l, i) => ({
  k: i, svc: l.svc, n: String(i + 1).padStart(2, '0'), name: LAYER_STYLE[l.svc].name, color: LAYER_STYLE[l.svc].color, href: hrefOf(l.svc),
  line: l.line, facts: facts(l.svc), cases: casesOf(l.svc),
  parts: l.parts.map(([label, kind]) => ({ label, kind, n: NOCOUNT.has(kind) ? 0 : countIn(l.items, kind) })),
}));
const place = spec.place.map(([label, kind]) => ({ label, kind, n: BASE_COUNT.has(kind) ? countBase(kind) : 0 }));
const [c0] = spec.captions;
// Three acts give the walk an arc; each service has its own verb instead of a repeated slide.
const ACT: Record<number, string> = { 108: 'Infraestructura', 101: 'Infraestructura', 103: 'Operación', 102: 'Operación', 107: 'Operación', 104: 'Gestión' };
// Each service says what it is worth, not what it is.
const VERB: Record<number, string> = {
  108: 'Si se corta la luz, lo crítico sigue.',
  101: 'Señal en cada rincón, cada punto certificado.',
  103: 'La voz llega a todo el lugar.',
  102: 'Lo que ve el operador, en cada acceso.',
  107: 'Del humo a la alarma, y la salida marcada.',
  104: 'Todo el edificio, en una pantalla.',
};
// The board counts only what the model holds.
const BOARD: Record<number, [string, string[], string]> = {
  108: ['UPS online', ['ups'], 'En línea'],
  101: ['Puntos de acceso Wi-Fi', ['ap'], 'Certificados'],
  103: ['Teléfonos, altavoces y radios', ['phone', 'speaker', 'radio'], 'Registrados'],
  102: ['Cámaras IP', ['cam'], 'Grabando'],
  107: ['Detectores', ['det', 'heat'], 'Normal'],
};
const boardRows = spec.layers.filter((l) => BOARD[l.svc]).map((l) => { const [label, kinds, status] = BOARD[l.svc]; return { label, status, color: LAYER_STYLE[l.svc].color, n: kinds.reduce((a, k) => a + countIn(l.items, k), 0) }; }).filter((r) => r.n > 0);
const hasCams = spec.layers.some((l) => l.svc === 102), hasBoard = spec.layers.some((l) => l.svc === 104);
// The record, once, at the end: what each service put in this place, under which standard,
// what it hands over, and the latest real case.
const partsText = (l: (typeof layers)[number]) => l.parts.map((p) => (p.n > 1 ? `${p.label} (${p.n})` : p.label)).join(' · ');
const ficha = [
  ...(spec.audit ? [{ k: -1, svc: 106, name: nameOf(106), color: '#DC2626', what: SERVICE_SPECS['106'].scope[0], facts: facts(106), last: casesOf(106)[0] }] : []),
  ...layers.map((l) => ({ k: l.k, svc: l.svc, name: l.name, color: l.color, what: partsText(l), facts: l.facts, last: l.cases[0] })),
  { k: -1, svc: 105, name: nameOf(105), color: '#1fae6b', what: SERVICE_SPECS['105'].scope[0], facts: facts(105), last: casesOf(105)[0] },
];
const m = spec.moment;
const id = (s: string) => `sc-${sector}-${s}`;
---
<section class="scode" data-scode={sector} aria-label={`${spec.name}: cómo lo instalamos, servicio por servicio`}>
  <div class="scode__grid">
    <div class="scode__stage" data-scode-stage>
      <div class="scode__callout" data-scode-callout aria-hidden="true"><b>{m.callout[0]}</b><span>{m.callout[1]}</span></div>
      <div class="scode__callout scode__desk" data-scode-desk data-phase="0" aria-hidden="true"><b>Mesa de ayuda 24/7</b><span data-p="0">Alerta del monitoreo</span><span data-p="1">Ticket abierto y asignado</span><span data-p="2">Resuelto y registrado</span></div>
      {hasCams && <div class="scode__cctv" data-scode-cctv aria-hidden="true"><span><i></i>Cámara IP · vista del operador</span></div>}
      {hasBoard && <div class="scode__panel" data-scode-panel aria-hidden="true"><b>Tablero · {spec.name}</b>{boardRows.map((r, i) => <p data-row={i} style={`--c:${r.color}`}><i></i><span>{r.label}</span><em>{r.n}</em><small>{r.status}</small></p>)}</div>}
      <div class="scode__legend" aria-hidden="true">{layers.map((l) => <span class="scode__layer" data-scode-layer style={`--c:${l.color}`}><b>{l.n}</b>{l.name}</span>)}</div>
    </div>

    <div class="scode__chapters">
      <article class="scode__ch scode__ch--place is-active" data-scode-ch="place" id={id('lugar')}>
        <div class="scode__txt">
          <p class="scode__kick"><i></i>{c0[0]}</p>
          <h3>{c0[1]}</h3>
        </div>
      </article>

      {spec.audit && (
        <article class="scode__ch scode__ch--low" data-scode-ch="audit" id={id('relevamiento')} style="--c:#DC2626">
          <div class="scode__txt">
            <p class="scode__kick"><i></i>{nameOf(106)}</p>
            <h3>Antes de instalar, relevamos lo que hay.</h3>
            <p class="scode__lead">{SERVICE_SPECS['106'].scope[0]}.</p>
          </div>
        </article>
      )}

      {layers.map((l, i) => (
        <article class:list={['scode__ch', i % 2 ? 'scode__ch--low' : '']} data-scode-ch={`layer-${l.k}`} id={id(`capa-${l.k + 1}`)} style={`--c:${l.color}`}>
          <div class="scode__txt">
            <p class="scode__kick scode__kick--layer"><span>{ACT[l.svc]}</span><b>{l.name}</b></p>
            <h3>{VERB[l.svc]}</h3>
            <p class="scode__lead">{l.line}</p>
            <a class="scode__svc" href={l.href}>{l.name} <span aria-hidden="true">→</span></a>
          </div>
        </article>
      ))}

      <article class="scode__ch scode__ch--long" data-scode-ch="moment" id={id('momento')} style={`--c:${LAYER_STYLE[m.svc].color}`}>
        <div class="scode__txt">
          <p class="scode__kick"><i></i>{m.kicker}</p>
          <h3 class="scode__big">{m.line}</h3>
        </div>
      </article>

      <article class="scode__ch scode__ch--low" data-scode-ch="support" id={id('soporte')} style="--c:#1fae6b">
        <div class="scode__txt">
          <p class="scode__kick"><i></i>{nameOf(105)}</p>
          <h3>Después de instalar, lo seguimos de día y de noche.</h3>
          <p class="scode__lead">{SERVICE_SPECS['105'].scope[2]}.</p>
        </div>
      </article>

      <article class="scode__ch scode__ch--ficha" data-scode-ch="ficha" id={id('ficha')}>
        <p class="scode__kick"><i></i>Ficha de la obra</p>
        <h3>Todo lo que instalamos en {spec.name.toLowerCase()}.</h3>
        <ol class="scode__ficha">
          {ficha.map((r) => (
            <li data-focus={r.k} style={`--c:${r.color}`}>
              <a class="scode__fname" href={hrefOf(r.svc)}>{r.name}</a>
              <p class="scode__fwhat">{r.what}</p>
              <dl>{r.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
              {r.last && <a class="scode__flast" href={r.last.href}>{r.last.client} · {r.last.work} · {r.last.year}</a>}
            </li>
          ))}
        </ol>
      </article>
    </div>
  </div>
</section>

<style>
  .scode{position:relative;background:#fcfcf9;color:#182120}
  .scode__grid{display:grid;grid-template-columns:minmax(0,5fr) minmax(0,7fr);width:100%}
  .scode__stage{grid-column:2;grid-row:1;position:sticky;top:var(--um-header-h,66px);height:calc(100vh - var(--um-header-h,66px));height:calc(100svh - var(--um-header-h,66px));align-self:start}
  .scode__stage :global(canvas){position:absolute;inset:0;width:100%;height:100%;display:block}
  .scode__chapters{grid-column:1;grid-row:1;padding:0 clamp(24px,3vw,56px) 0 max(var(--um-page-gutter,24px),calc((100vw - var(--um-container-wide,1400px))/2))}
  /* Each chapter is a stretch of scroll; its text holds still while the model plays it. */
  .scode__ch{position:relative;min-height:135vh}
  .scode__ch--place{min-height:115vh}
  .scode__ch--long{min-height:190vh}
  .scode__txt{position:sticky;top:calc(var(--um-header-h,66px) + 16vh);padding:8px 0 40px;opacity:0;transition:opacity .5s ease}
  .scode__ch--low .scode__txt{top:calc(var(--um-header-h,66px) + 40vh)}
  .scode__ch--place .scode__txt{top:calc(var(--um-header-h,66px) + 26vh)}
  .scode__ch.is-active .scode__txt{opacity:1}
  .scode.scode .scode__kick{display:flex;align-items:center;gap:14px;margin:0;font-size:13px!important;letter-spacing:.2em;text-transform:uppercase;color:#5f6368!important}
  .scode__kick i{width:32px;height:2px;background:var(--c,#DC2626)}
  .scode__kick--layer span{color:#8a9097}
  .scode__kick--layer b{padding-top:3px;border-top:2px solid var(--c);color:#182120;font-weight:700}
  .scode.scode h3{margin:16px 0 0;max-width:15ch;font-size:clamp(30px,3.1vw,50px)!important;line-height:1.04;letter-spacing:-.025em;color:#182120!important}
  .scode.scode .scode__big{max-width:13ch;font-size:clamp(36px,4vw,64px)!important}
  .scode.scode .scode__lead{margin:18px 0 0;max-width:36ch;font-size:17px!important;line-height:1.5;color:#3c423f!important}
  .scode__svc{display:inline-block;margin-top:20px;color:#182120;font-size:15px;font-weight:700;text-decoration:none;border-bottom:2px solid var(--c,#DC2626);padding-bottom:3px}
  .scode__ch--ficha{min-height:0;padding:12vh 0 16vh}
  .scode__ficha{list-style:none;margin:32px 0 0;padding:0;border-top:1px solid rgba(24,33,32,.14)}
  .scode__ficha li{display:grid;grid-template-columns:1fr;gap:6px;padding:16px 12px 16px 14px;border-bottom:1px solid rgba(24,33,32,.14);border-left:3px solid transparent;transition:background .25s,border-color .25s}
  .scode__ficha li:hover,.scode__ficha li:focus-within{background:rgba(24,33,32,.035);border-left-color:var(--c)}
  .scode__fname{color:#182120;font-size:18px;font-weight:700;text-decoration:none}
  .scode__fname:hover{color:var(--c)}
  .scode.scode .scode__fwhat{margin:0;font-size:14px!important;line-height:1.45;color:#3c423f!important}
  .scode__ficha dl{display:flex;flex-wrap:wrap;gap:4px 20px;margin:2px 0 0}
  .scode__ficha dl div{display:flex;gap:6px;align-items:baseline}
  .scode.scode .scode__ficha dt{font-size:11px!important;letter-spacing:.14em;text-transform:uppercase;color:#8a9097!important}
  .scode.scode .scode__ficha dd{margin:0;font-size:13px!important;color:#182120!important}
  .scode__flast{font-size:13px;color:#5f6368;text-decoration:none;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .scode__flast:hover{color:#182120;text-decoration:underline;text-decoration-color:var(--c)}
  .scode a:focus-visible,.scode button:focus-visible{outline:2px solid #DC2626;outline-offset:3px}
  .scode__layer{position:absolute;left:0;top:0;z-index:2;display:flex;align-items:center;gap:10px;padding-right:16px;opacity:0;white-space:nowrap;font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#5f6368;will-change:transform,opacity;transition:color .3s}
  .scode__layer b{display:inline-block;min-width:20px;padding:3px 0 2px;border-top:2px solid var(--c)}
  .scode__layer:global(.is-on){color:#182120}
  .scode__callout{position:absolute;left:0;top:0;z-index:2;opacity:0;margin-top:-14px;padding:12px 16px 12px 14px;background:#fff;border-left:3px solid #DC2626;box-shadow:0 10px 30px rgba(24,33,32,.12);white-space:nowrap;pointer-events:none}
  .scode__callout b{display:block;font-size:15px;color:#182120}
  .scode__callout span{display:block;margin-top:3px;font-size:13px;color:#5f6368}
  .scode__cctv{position:absolute;z-index:2;top:20px;right:24px;width:min(38%,380px);aspect-ratio:16/10;opacity:0;pointer-events:none;border:1px solid rgba(24,33,32,.5);box-shadow:0 14px 34px rgba(24,33,32,.18);-webkit-backdrop-filter:grayscale(1) contrast(1.15) brightness(1.1);backdrop-filter:grayscale(1) contrast(1.15) brightness(1.1);background:repeating-linear-gradient(0deg,rgba(255,255,255,.04) 0 1px,transparent 1px 3px)}
  .scode__cctv span{position:absolute;left:10px;top:8px;display:flex;align-items:center;gap:7px;font-size:11px;letter-spacing:.08em;text-transform:uppercase;color:#fff;text-shadow:0 1px 2px rgba(0,0,0,.6)}
  .scode__cctv i{width:7px;height:7px;border-radius:50%;background:#DC2626;box-shadow:0 0 6px #DC2626}
  .scode__panel{position:absolute;z-index:2;top:20px;right:24px;width:min(38%,360px);opacity:0;pointer-events:none;padding:16px 18px 10px;background:#16222d;color:#e8eef2;box-shadow:0 14px 34px rgba(24,33,32,.22);font-size:13px}
  .scode__panel b{display:block;margin-bottom:10px;font-size:14px;color:#fff}
  .scode__panel p{display:grid;grid-template-columns:10px 1fr auto auto;gap:10px;align-items:center;margin:0;padding:8px 0;border-top:1px solid rgba(255,255,255,.08);opacity:0;transform:translateY(6px);transition:opacity .4s ease,transform .5s cubic-bezier(.2,.7,.1,1)}
  .scode__panel p:global(.on){opacity:1;transform:none}
  .scode__panel p i{width:7px;height:7px;border-radius:50%;background:var(--c)}
  .scode__panel p em{font-style:normal;font-weight:700;font-variant-numeric:tabular-nums}
  .scode__panel p small{font-size:11px;color:#3fd08a;letter-spacing:.04em}
  .scode__desk span{display:none}
  .scode__desk[data-phase="0"] span[data-p="0"],.scode__desk[data-phase="1"] span[data-p="1"]{display:block}
  .scode__desk[data-phase="2"] span[data-p="2"]{display:block;color:#13804d}
  .scode__desk[data-phase="2"]{border-left-color:#1fae6b}
  @media (max-width:899px){
    .scode__grid{grid-template-columns:1fr}
    .scode__stage{grid-column:1;top:var(--um-header-h,60px);height:min(54svh,100vw);z-index:2;background:#fcfcf9;box-shadow:0 1px 0 rgba(24,33,32,.08)}
    .scode__chapters{grid-row:2;padding:0 var(--um-page-gutter,20px)}
    .scode__ch{min-height:110svh}.scode__ch--place{min-height:80svh}.scode__ch--long{min-height:150svh}
    .scode__txt,.scode__ch--low .scode__txt,.scode__ch--place .scode__txt{top:calc(var(--um-header-h,60px) + min(54svh,100vw) + 16px)}
    .scode__legend,.scode__callout{display:none}
    .scode__cctv,.scode__panel{top:10px;right:10px;width:48%}
    .scode__panel{padding:10px 12px 6px;font-size:11px}.scode__panel p{gap:6px;padding:5px 0}
    .scode.scode h3{font-size:clamp(26px,7vw,34px)!important}
    .scode.scode .scode__big{font-size:clamp(30px,8.4vw,40px)!important}
    .scode__ch--ficha{padding:40px 0 60px}
  }
  @media (prefers-reduced-motion:reduce){.scode__txt{transition:none}}
  .scode:global(.is-pinned) .scode__ch:not(.is-active){display:none}
  .scode:global(.is-pinned) .scode__ch{min-height:0}
  .scode:global(.is-pinned) .scode__txt{position:relative;top:auto;padding-top:22vh}
</style>

<script>
  import { SECTOR_FILMS } from '../../scripts/senal/sectorSpecs.js';
  type Api = { dispose: () => void; setChapter: (c: string) => void; setProgress: (q: number) => void; setFocus: (k: number | null) => void };
  function boot() {
    document.querySelectorAll<HTMLElement>('[data-scode]:not([data-bound])').forEach((host) => {
      host.dataset.bound = '1';
      const chapters = [...host.querySelectorAll<HTMLElement>('[data-scode-ch]')];
      const q = new URLSearchParams(location.search), pinned = q.get('ch');
      let api: Api | null = null, current = '', progress = 0;
      // Review captures: ?ch= pins one chapter and shows it alone (?q= pins its progress).
      if (pinned) host.classList.add('is-pinned');
      const activate = (name: string) => {
        if (name === current) return; current = name;
        chapters.forEach((c) => c.classList.toggle('is-active', c.dataset.scodeCh === name));
        api?.setChapter(name);
      };
      // The chapter under the reading line is active; how far it has been read is its timeline.
      let ticking = false;
      const read = () => {
        ticking = false;
        if (pinned) { activate(pinned); api?.setProgress(Number(q.get('q') ?? .5)); return; }
        const line = innerHeight * (matchMedia('(max-width: 899px)').matches ? .78 : .5);
        for (const c of chapters) {
          const r = c.getBoundingClientRect();
          if (r.top <= line && r.bottom > line) { activate(c.dataset.scodeCh || 'place'); progress = Math.min(1, Math.max(0, (line - r.top) / Math.max(1, r.height - innerHeight * .25))); api?.setProgress(progress); break; }
        }
      };
      const onScroll = () => { if (!ticking) { ticking = true; requestAnimationFrame(read); } };
      addEventListener('scroll', onScroll, { passive: true }); addEventListener('resize', onScroll); read();
      // The record drives the model too: pointing at a service lights its layer.
      host.querySelectorAll<HTMLElement>('[data-focus]').forEach((li) => {
        const k = Number(li.dataset.focus);
        const on = () => api?.setFocus(k >= 0 ? k : null), off = () => api?.setFocus(null);
        li.addEventListener('mouseenter', on); li.addEventListener('mouseleave', off); li.addEventListener('focusin', on); li.addEventListener('focusout', off);
      });
      const mount = new IntersectionObserver(async ([e]) => {
        if (!e.isIntersecting || api) return; mount.disconnect();
        const { mountSector } = await import('../../scripts/senal/sector.js');
        api = (await mountSector(host, SECTOR_FILMS[host.dataset.scode as keyof typeof SECTOR_FILMS])) as Api;
        const name = current || 'place'; current = ''; activate(name); read();
      }, { rootMargin: '400px 0px' });
      mount.observe(host);
      document.addEventListener('astro:before-swap', () => { removeEventListener('scroll', onScroll); removeEventListener('resize', onScroll); mount.disconnect(); api?.dispose(); }, { once: true });
    });
  }
  boot(); document.addEventListener('astro:page-load', boot);
</script>
