---
// A sector told in code, on the page's paper: the place, the four layers we install over
// it (each label links to its service) and one moment of the operation crossing them.
import { SECTOR_FILMS, LAYER_STYLE } from '../../scripts/senal/sectorSpecs.js';
import { NAV_SERVICES } from '../../data/navigation';
interface Props { sector: keyof typeof SECTOR_FILMS }
const { sector } = Astro.props;
const spec = SECTOR_FILMS[sector];
const hrefOf = (code: number) => NAV_SERVICES.find((s) => s.code === String(code))?.href ?? '/servicios';
const hot = spec.layers.flatMap((l) => l.items).find((it) => it[0] === 'card' && it[5]);
const layers = spec.layers.map((l, i) => ({ n: String(i + 1).padStart(2, '0'), name: LAYER_STYLE[l.svc].name, color: LAYER_STYLE[l.svc].color, href: hrefOf(l.svc) }));
---
<section class="scode" data-scode={sector} aria-label={`${spec.name}: cómo lo instalamos`}>
  <div class="scode__stage" data-scode-stage>
    {hot && <div class="scode__callout" data-scode-callout aria-hidden="true"><b>{hot[3]}</b><span>{hot[4]}</span></div>}
    <div class="scode__legend">{layers.map((l) => <a class="scode__layer" data-scode-layer href={l.href} style={`--c:${l.color}`}><b>{l.n}</b>{l.name}</a>)}</div>
  </div>
  <div class="scode__cap" data-scode-caption data-step="0" aria-live="polite">
    {spec.captions.map(([k, line]) => <p><small><i></i>{k}</small><strong>{line}</strong></p>)}
    <p><small><i></i>Última Milla</small><strong class="scode__logo">ultimamilla<em>.</em>com<em>.</em>ar</strong></p>
  </div>
</section>

<style>
  .scode{position:relative;background:#fcfcf9;color:#182120;height:min(100vh,920px);min-height:640px;overflow:hidden}
  .scode__stage{position:absolute;inset:0}
  .scode__legend{display:contents}
  .scode__stage :global(canvas){position:absolute;inset:0;width:100%;height:100%;display:block}
  .scode__layer{position:absolute;left:0;top:0;z-index:2;display:flex;align-items:center;gap:10px;padding-right:16px;opacity:0;white-space:nowrap;font-size:12px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#182120;text-decoration:none;will-change:transform,opacity}
  .scode__callout{position:absolute;left:0;top:0;z-index:2;opacity:0;margin-top:-14px;padding:12px 16px 12px 14px;background:#fff;border-left:3px solid #DC2626;box-shadow:0 10px 30px rgba(24,33,32,.12);white-space:nowrap;pointer-events:none}
  .scode__callout b{display:block;font-size:15px;color:#182120}
  .scode__callout span{display:block;margin-top:3px;font-size:13px;color:#5f6368}
  .scode__layer b{display:inline-block;min-width:22px;padding:3px 0 2px;border-top:2px solid var(--c);font-weight:700;color:#5f6368}
  .scode__layer:hover{color:var(--c)}
  .scode__layer:focus-visible{outline:2px solid #DC2626;outline-offset:4px;opacity:1!important}
  .scode__cap{position:absolute;z-index:3;left:max(var(--um-page-gutter,24px),calc((100% - var(--um-container-wide,1400px))/2));bottom:clamp(40px,9vh,104px);width:min(520px,34vw);height:0}
  .scode__cap p{position:absolute;left:0;bottom:0;width:100%;margin:0;opacity:0;transform:translateY(12px);transition:opacity .8s ease,transform 1s cubic-bezier(.2,.7,.1,1)}
  .scode.scode .scode__cap small{display:flex;align-items:center;gap:14px;font-size:13px!important;letter-spacing:.2em;text-transform:uppercase;color:#5f6368!important}
  .scode__cap small i{width:32px;height:2px;background:#DC2626}
  .scode.scode .scode__cap strong{display:block;margin-top:14px;font-size:clamp(30px,3.2vw,54px)!important;line-height:1.04;letter-spacing:-.025em;color:#182120!important}
  .scode__logo em{font-style:normal;color:#DC2626}
  .scode__cap[data-step="0"] p:nth-child(1),.scode__cap[data-step="1"] p:nth-child(2),.scode__cap[data-step="2"] p:nth-child(3),.scode__cap[data-step="3"] p:nth-child(4),.scode__cap[data-step="4"] p:nth-child(5){opacity:1;transform:none}
  :global(.is-frozen) .scode__cap p{transition:none}
  @media (max-width:899px){
    .scode{height:auto;min-height:0;display:flex;flex-direction:column}
    .scode__stage{position:relative;inset:auto;aspect-ratio:1/1.05}
    .scode__legend{position:absolute;left:var(--um-page-gutter,20px);right:var(--um-page-gutter,20px);top:12px;display:grid;grid-template-columns:1fr 1fr;gap:8px 16px;z-index:2}
    .scode__layer{position:static;transform:none!important;font-size:11px;letter-spacing:.1em;gap:8px;padding:0;white-space:normal}
    .scode__layer b{min-width:18px}
    .scode__callout{display:none}
    .scode__cap{position:relative;left:auto;bottom:auto;width:auto;height:150px;margin:0 var(--um-page-gutter,20px) 40px}
    .scode__cap p{top:0;bottom:auto}
  }
  @media (prefers-reduced-motion:reduce){.scode__cap p{transition:none}}
</style>

<script>
  import { SECTOR_FILMS } from '../../scripts/senal/sectorSpecs.js';
  function boot() {
    document.querySelectorAll<HTMLElement>('[data-scode]:not([data-bound])').forEach((host) => {
      host.dataset.bound = '1';
      let dispose: (() => void) | null = null;
      const io = new IntersectionObserver(async ([e]) => {
        if (!e.isIntersecting || dispose) return; io.disconnect();
        const { mountSector } = await import('../../scripts/senal/sector.js');
        dispose = await mountSector(host, SECTOR_FILMS[host.dataset.scode as keyof typeof SECTOR_FILMS]);
      }, { rootMargin: '400px 0px' });
      io.observe(host);
      document.addEventListener('astro:before-swap', () => { io.disconnect(); dispose?.(); }, { once: true });
    });
  }
  boot(); document.addEventListener('astro:page-load', boot);
</script>
