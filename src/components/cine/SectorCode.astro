---
// A sector as one composition: from the first frame the whole building is on — every
// service that applies to it, the camera feed and the board. The menu beside it hands the
// stage to one service at a time (its layer stands apart and plays its gesture); left
// alone, it walks through them by itself. Every word comes from the service record.
import { SECTOR_FILMS, LAYER_STYLE } from '../../scripts/senal/sectorSpecs.js';
import { NAV_SERVICES } from '../../data/navigation';
import { SERVICE_SPECS } from '../../data/serviceSpecs';
import { sectorCases } from '../../data/cine/sectorCases';
interface Props { sector: keyof typeof SECTOR_FILMS }
const { sector } = Astro.props;
const spec = SECTOR_FILMS[sector];
const hrefOf = (code: number | string) => NAV_SERVICES.find((s) => s.code === String(code))?.href ?? '/servicios';
const nameOf = (code: number | string) => NAV_SERVICES.find((s) => s.code === String(code))?.name ?? '';
const facts = (code: number | string) => { const s = SERVICE_SPECS[String(code)]; return s ? [['Norma', s.keyStandard], ['Entrega', s.keyDeliverable]] : []; };
const cases = sectorCases(sector);
const casesOf = (code: number | string) => cases.filter((c) => c.svc === String(code)).slice(0, 3);
// Counts come from the model, so the text never says more than the drawing shows.
const NOCOUNT = new Set(['tray', 'fiber', 'loop', 'pipe', 'zone', 'card', 'cov']);
const countIn = (items: any[], kind: string) => items.filter((it) => it[0] === kind || (it[0] === 'node' && it[4] === kind)).length;
const countBase = (kind: string) => spec.pieces.filter((p) => p[0] === kind).length;
const BASE_COUNT = new Set(['bed', 'counter', 'cell', 'tank', 'mast', 'container', 'cabinet']);
const layers = spec.layers.map((l, i) => ({
  k: i, svc: l.svc, n: String(i + 1).padStart(2, '0'), name: LAYER_STYLE[l.svc].name, color: LAYER_STYLE[l.svc].color, href: hrefOf(l.svc),
  line: l.line, facts: facts(l.svc), cases: casesOf(l.svc),
  parts: l.parts.map(([label, kind]) => ({ label, kind, n: NOCOUNT.has(kind) ? 0 : countIn(l.items, kind) })),
}));
const [c0] = spec.captions;
// Each service says what it is worth, not what it is.
const VERB: Record<number, string> = {
  108: 'Si se corta la luz, lo crítico sigue.',
  101: 'Señal en cada rincón, cada punto certificado.',
  103: 'La voz llega a todo el lugar.',
  102: 'Lo que ve el operador, en cada acceso.',
  107: 'Del humo a la alarma, y la salida marcada.',
  104: 'Todo el edificio, en una pantalla.',
};
// The board counts only what the model holds.
const BOARD: Record<number, [string, string[], string]> = {
  108: ['UPS', ['ups'], 'En línea'],
  101: ['Wi-Fi', ['ap'], 'Certificados'],
  103: ['Voz y voceo', ['phone', 'speaker', 'radio'], 'Registrados'],
  102: ['Cámaras', ['cam'], 'Grabando'],
  107: ['Detectores', ['det', 'heat'], 'Normal'],
};
const boardRows = spec.layers.filter((l) => BOARD[l.svc]).map((l) => { const [label, kinds, status] = BOARD[l.svc]; return { svc: l.svc, label, status, color: LAYER_STYLE[l.svc].color, n: kinds.reduce((a, k) => a + countIn(l.items, k), 0) }; }).filter((r) => r.n > 0);
const hasCams = spec.layers.some((l) => l.svc === 102), hasBoard = spec.layers.some((l) => l.svc === 104);
// Without custom software the board is the 24/7 monitoring every sector gets (105).
const boardTitle = hasBoard ? `Tablero · ${spec.name}` : `Monitoreo 24/7 · ${spec.name}`;
const boardSvcs = spec.layers.filter((l) => BOARD[l.svc]).map((l) => l.svc);
const partsText = (l: (typeof layers)[number]) => l.parts.map((p) => (p.n > 1 ? `${p.label} (${p.n})` : p.label)).join(' · ');
// The menu: Consultoría (where it applies), each layer bottom-up, then Soporte.
const items = [
  ...(spec.audit ? [{ key: 'audit', svc: 106, name: nameOf(106), color: '#DC2626', verb: 'Antes de instalar, relevamos lo que hay.', line: SERVICE_SPECS['106'].scope[0] + '.', parts: '', facts: facts(106), last: casesOf(106)[0], moment: null as null | string[] }] : []),
  ...layers.map((l) => ({ key: `layer-${l.k}`, svc: l.svc, name: l.name, color: l.color, verb: VERB[l.svc], line: l.line, parts: partsText(l), facts: l.facts, last: l.cases[0], moment: l.svc === spec.moment.svc ? [spec.moment.kicker, spec.moment.line] : null })),
  { key: 'support', svc: 105, name: nameOf(105), color: '#1fae6b', verb: 'Después de instalar, lo seguimos de día y de noche.', line: SERVICE_SPECS['105'].scope[2] + '.', parts: '', facts: facts(105), last: casesOf(105)[0], moment: null },
];
const m = spec.moment;
const id = (s: string) => `sc-${sector}-${s}`;
---
<section class="scode" data-scode={sector} aria-label={`${spec.name}: lo que instalamos, servicio por servicio`}>
  <div class="scode__grid">
    <div class="scode__side">
      <header class="scode__head">
        <p class="scode__kick"><i></i>{spec.name}</p>
        <h2>{c0[1]}</h2>
      </header>
      <ol class="scode__menu" data-scode-menu role="tablist" aria-label="Servicios">
        {items.map((it, i) => (
          <li><button type="button" role="tab" aria-selected="false" data-item={it.key} data-svc={it.svc} style={`--c:${it.color}`}>
            <b>{String(i + 1).padStart(2, '0')}</b><span>{it.name}</span><i aria-hidden="true"></i>
          </button></li>
        ))}
      </ol>
      <div class="scode__details">
        {items.map((it) => (
          <article class="scode__detail" data-detail={it.key} style={`--c:${it.color}`}>
            <h3>{it.verb}</h3>
            {it.moment ? <p class="scode__lead"><strong>{it.moment[0]}.</strong> {it.moment[1]}</p> : <p class="scode__lead">{it.line}</p>}
            {it.parts && <p class="scode__parts">{it.parts}</p>}
            <dl>{it.facts.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}</dl>
            <p class="scode__more">{it.last && <a class="scode__last" href={it.last.href}>{it.last.client} · {it.last.year}</a>}<a class="scode__svc" href={hrefOf(it.svc)}>{it.name} <span aria-hidden="true">→</span></a></p>
          </article>
        ))}
      </div>
    </div>
    <div class="scode__stage" data-scode-stage>
      <aside class="scode__rail" data-scode-rail aria-hidden="true">
        {hasCams && (
          <div class="scode__tile scode__tile--cam" data-tile="102">
            <header><i></i>Cámara IP<em>En vivo</em></header>
            <div class="scode__feed" data-scode-cctv></div>
          </div>
        )}
        <div class="scode__tile scode__tile--board" data-tile={hasBoard ? '104' : '105'} data-scode-panel>
          <header><i></i>{boardTitle}</header>
          {boardRows.map((r, i) => <p data-row={i} data-svc={r.svc} style={`--c:${r.color}`}><i></i><span>{r.label}</span><em>{r.n}</em><small>{r.status}</small></p>)}
        </div>
        <div class="scode__tile scode__tile--event" data-tile="event">
          <header><i></i>Eventos</header>
          <div class="scode__events">
            <p class="scode__calm">Sin novedades · monitoreo 24/7</p>
            <div class="scode__ev" data-scode-callout><b>{m.callout[0]}</b><span>{m.callout[1]}</span></div>
            <div class="scode__ev scode__desk" data-scode-desk data-phase="0"><b>Mesa de ayuda 24/7</b><span data-p="0">Alerta del monitoreo</span><span data-p="1">Ticket abierto y asignado</span><span data-p="2">Resuelto y registrado</span></div>
          </div>
        </div>
      </aside>
      <div class="scode__legend" aria-hidden="true">{layers.map((l) => <span class="scode__layer" data-scode-layer style={`--c:${l.color}`}><b>{l.n}</b>{l.name}</span>)}</div>
    </div>
  </div>
</section>

<style>
  .scode{position:relative;background:#fcfcf9;color:#182120}
  .scode__grid{display:grid;grid-template-columns:minmax(340px,4fr) minmax(0,8fr);height:clamp(680px,calc(100svh - var(--um-header-h,66px)),940px)}
  .scode__side{display:flex;flex-direction:column;justify-content:center;gap:20px;padding:clamp(28px,4vh,56px) clamp(20px,2.4vw,40px) clamp(40px,6vh,80px) max(var(--um-page-gutter,24px),calc((100vw - var(--um-container-wide,1400px))/2))}
  .scode.scode .scode__kick{display:flex;align-items:center;gap:14px;margin:0;font-size:13px!important;letter-spacing:.2em;text-transform:uppercase;color:#5f6368!important}
  .scode__kick i{width:32px;height:2px;background:#DC2626}
  .scode.scode h2{margin:12px 0 0;max-width:18ch;font-size:clamp(26px,2.3vw,38px)!important;line-height:1.04;letter-spacing:-.025em;color:#182120!important}
  .scode__menu{list-style:none;margin:0;padding:0;border-top:1px solid rgba(24,33,32,.12)}
  .scode__menu button{position:relative;display:grid;grid-template-columns:30px 1fr 12px;align-items:center;gap:12px;width:100%;padding:8px 4px 8px 0;border:0;border-bottom:1px solid rgba(24,33,32,.12);background:none;color:#5f6368;font:inherit;font-size:16px;text-align:left;cursor:pointer;transition:color .25s}
  .scode__menu button b{font-size:12px;font-weight:600;color:#8a9097;font-variant-numeric:tabular-nums}
  .scode__menu button i{width:8px;height:8px;border-radius:50%;background:var(--c);opacity:.35;transition:opacity .25s,transform .25s}
  .scode__menu button::after{content:'';position:absolute;left:0;bottom:-1px;height:2px;width:0;background:var(--c);transition:width .5s cubic-bezier(.2,.7,.1,1)}
  .scode__menu button:hover,.scode__menu button[aria-selected="true"]{color:#182120}
  .scode__menu button[aria-selected="true"] i{opacity:1;transform:scale(1.5)}
  .scode__menu button[aria-selected="true"]::after{width:100%}
  .scode__details{position:relative;min-height:210px}
  .scode__detail{position:absolute;inset:0 0 auto 0;opacity:0;transform:translateY(8px);pointer-events:none;transition:opacity .35s ease,transform .45s cubic-bezier(.2,.7,.1,1)}
  .scode__detail.is-on{opacity:1;transform:none;pointer-events:auto}
  .scode.scode .scode__detail h3{margin:0;max-width:20ch;font-size:clamp(22px,1.8vw,28px)!important;line-height:1.15;letter-spacing:-.015em;color:#182120!important}
  .scode.scode .scode__lead{margin:10px 0 0;max-width:44ch;font-size:15px!important;line-height:1.5;color:#3c423f!important}
  .scode.scode .scode__parts{margin:8px 0 0;max-width:46ch;font-size:13px!important;line-height:1.5;color:#5f6368!important}
  .scode__detail dl{display:flex;flex-wrap:wrap;gap:4px 22px;margin:12px 0 0}
  .scode__detail dl div{display:flex;gap:6px;align-items:baseline}
  .scode.scode .scode__detail dt{font-size:11px!important;letter-spacing:.14em;text-transform:uppercase;color:#8a9097!important}
  .scode.scode .scode__detail dd{margin:0;font-size:13px!important;color:#182120!important}
  .scode__more{display:flex;flex-wrap:wrap;align-items:baseline;gap:8px 20px;margin:14px 0 0}
  .scode__last{font-size:13px;color:#5f6368;text-decoration:none}
  .scode__last:hover{color:#182120;text-decoration:underline;text-decoration-color:var(--c)}
  .scode__svc{color:#182120;font-size:14px;font-weight:700;text-decoration:none;border-bottom:2px solid var(--c);padding-bottom:2px}
  .scode a:focus-visible,.scode button:focus-visible{outline:2px solid #DC2626;outline-offset:3px}
  .scode__stage{position:relative;min-height:0}
  .scode__stage :global(canvas){position:absolute;inset:0;width:100%;height:100%;display:block}
  .scode__layer{position:absolute;left:0;top:0;z-index:2;display:flex;align-items:center;gap:10px;padding-right:16px;opacity:0;white-space:nowrap;font-size:11px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:#182120;will-change:transform,opacity}
  .scode__layer b{display:inline-block;min-width:20px;padding:3px 0 2px;border-top:2px solid var(--c)}
  .scode__desk[data-phase="0"] span[data-p="0"],.scode__desk[data-phase="1"] span[data-p="1"]{display:block}
  .scode__desk[data-phase="2"] span[data-p="2"]{display:block;color:#3fd08a}
  .scode__desk[data-phase="2"]{border-left-color:#1fae6b}
  /* The two insets are part of the composition, and grow when their service has the stage. */

  /* The rail: three equal tiles, like a control desk beside the building. */
  .scode__rail{position:absolute;z-index:2;top:50%;right:clamp(16px,2.2vw,40px);transform:translateY(-50%);display:flex;flex-direction:column;gap:10px;width:clamp(230px,21vw,300px)}
  .scode__tile{background:#14202b;color:#e8eef2;border:1px solid rgba(255,255,255,.06);box-shadow:0 18px 40px -18px rgba(20,32,43,.55);transition:box-shadow .4s,border-color .4s}
  .scode.scode .scode__tile header{font-size:10px!important}
  .scode__tile header{display:flex;align-items:center;gap:8px;padding:9px 12px;font-size:10px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:rgba(232,238,242,.72);border-bottom:1px solid rgba(255,255,255,.06)}
  .scode__tile header i{width:6px;height:6px;border-radius:50%;background:#3fd08a}
  .scode.scode .scode__tile header em{margin-left:auto;font-size:10px!important;font-style:normal;font-weight:600;color:#ff6b6b;letter-spacing:.12em}
  .scode__tile--cam{background:transparent}
  .scode__tile--cam header{background:#14202b}
  .scode__tile--cam header i{background:#DC2626;box-shadow:0 0 6px #DC2626}
  .scode__feed{aspect-ratio:16/10;-webkit-backdrop-filter:grayscale(1) contrast(1.12);backdrop-filter:grayscale(1) contrast(1.12);background:repeating-linear-gradient(0deg,rgba(255,255,255,.035) 0 1px,transparent 1px 3px)}
  .scode__tile--board{padding-bottom:4px}
  .scode__tile--board p{display:grid;grid-template-columns:7px 1fr auto auto;gap:9px;align-items:center;margin:0 12px;padding:7px 0;border-top:1px solid rgba(255,255,255,.06);font-size:12px;opacity:.72;transition:opacity .35s}
  .scode__tile--board p:first-of-type{border-top:0}
  .scode__tile--board p:global(.hot){opacity:1}
  .scode__tile--board p i{width:6px;height:6px;border-radius:50%;background:var(--c)}
  .scode.scode .scode__tile--board p,.scode.scode .scode__tile--board p span,.scode.scode .scode__tile--board p em{font-size:12px!important;line-height:1.3;color:#e8eef2!important}
  .scode.scode .scode__tile--board p small{font-size:10px!important;color:#3fd08a!important}
  .scode__tile--board p em{font-style:normal;font-weight:700;font-variant-numeric:tabular-nums}
  .scode__tile--board p small{font-size:10px;color:#3fd08a}
  .scode__events{position:relative;min-height:62px;padding:12px}
  .scode__calm,.scode__ev{position:absolute;inset:12px;margin:0;font-size:12px;line-height:1.45;transition:opacity .35s}
  .scode__calm{color:rgba(232,238,242,.6)}
  .scode__ev{opacity:0;background:#14202b;border-left:2px solid #DC2626;padding-left:10px}
  .scode.scode .scode__ev b{display:block;font-size:13px!important;line-height:1.3;color:#fff!important}
  .scode.scode .scode__ev span{margin-top:2px;font-size:12px!important;line-height:1.35;color:rgba(232,238,242,.72)!important}
  .scode.scode .scode__calm{font-size:12px!important;color:rgba(232,238,242,.6)!important}
  .scode__ev > span:not([data-p]){display:block}
  .scode__desk span{display:none}
  /* The tile of the service on stage lights up with its colour. */
  .scode:global([data-active="102"]) .scode__tile--cam{border-color:#6b5be6;box-shadow:0 0 0 1px #6b5be6,0 18px 40px -18px rgba(20,32,43,.55)}
  .scode:global([data-active="104"]) .scode__tile--board,.scode:global([data-active="105"]) .scode__tile--board{border-color:#1fae6b;box-shadow:0 0 0 1px #1fae6b,0 18px 40px -18px rgba(20,32,43,.55)}
  @media (max-width:899px){
    .scode__grid{grid-template-columns:1fr;height:auto}
    .scode__side{display:contents}
    .scode__head{order:1;padding:56px var(--um-page-gutter,20px) 8px}
    .scode__stage{order:2;min-height:0;aspect-ratio:1/1.28}
    .scode__rail{top:auto;bottom:10px;left:10px;right:10px;transform:none;flex-direction:row;align-items:stretch;width:auto;gap:8px}
    .scode__rail .scode__tile{flex:1;min-width:0}
    .scode__tile--board{display:none}
    .scode__tile header{padding:6px 8px;font-size:9px;letter-spacing:.1em}
    .scode__events{min-height:0;height:calc(100% - 26px);padding:8px}
    .scode__calm,.scode__ev{inset:8px;font-size:11px}.scode__ev b{font-size:12px}
    .scode__menu{order:3;display:flex;gap:6px;overflow-x:auto;scroll-snap-type:x mandatory;margin:0;padding:12px var(--um-page-gutter,20px);border:0;scrollbar-width:none}
    .scode__menu::-webkit-scrollbar{display:none}
    .scode__menu li{flex:none;scroll-snap-align:center}
    .scode__menu button{width:auto;grid-template-columns:auto auto;gap:8px;padding:9px 14px;border:1px solid rgba(24,33,32,.16);border-radius:999px;font-size:14px;white-space:nowrap}
    .scode__menu button b{display:none}
    .scode__menu button::after{display:none}
    .scode__menu button[aria-selected="true"]{border-color:var(--c);box-shadow:inset 0 0 0 1px var(--c)}
    .scode__details{order:4;min-height:300px;margin:6px var(--um-page-gutter,20px) 48px}
  }
  @media (prefers-reduced-motion:reduce){.scode__detail,.scode__menu button::after{transition:none}}
</style>

<script>
  import { SECTOR_FILMS } from '../../scripts/senal/sectorSpecs.js';
  type Api = { dispose: () => void; setActive: (c: string | null) => void };
  const CYCLE = 6500;
  function boot() {
    document.querySelectorAll<HTMLElement>('[data-scode]:not([data-bound])').forEach((host) => {
      host.dataset.bound = '1';
      const buttons = [...host.querySelectorAll<HTMLButtonElement>('[data-item]')];
      const details = [...host.querySelectorAll<HTMLElement>('[data-detail]')];
      const menu = host.querySelector<HTMLElement>('[data-scode-menu]')!;
      const q = new URLSearchParams(location.search), pinned = q.get('item') || (q.has('rec') ? 'idle' : null);
      const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
      let api: Api | null = null, idx = -1, timer = 0, hold = false, inView = false;
      // At rest everything is on together; that is the first thing a reader sees.
      const rest = () => { idx = -1; buttons.forEach((x) => x.setAttribute('aria-selected', 'false')); details.forEach((d, j) => d.classList.toggle('is-on', false)); host.dataset.active = ''; api?.setActive(null); };
      const show = (i: number, user = false) => {
        idx = i; const b = buttons[i];
        buttons.forEach((x, j) => x.setAttribute('aria-selected', String(j === i)));
        details.forEach((d) => d.classList.toggle('is-on', d.dataset.detail === b.dataset.item));
        host.dataset.active = b.dataset.svc || '';
        api?.setActive(b.dataset.item || null);
        // Keep the active chip in view on phones without moving the page.
        if (getComputedStyle(menu).display === 'flex') { const li = b.parentElement!; menu.scrollTo({ left: li.offsetLeft - (menu.clientWidth - li.clientWidth) / 2, behavior: user ? 'smooth' : 'smooth' }); }
        schedule();
      };
      // Left alone, it walks the services; any touch or pointer hands control to the reader.
      const schedule = () => { clearTimeout(timer); if (reduce || hold || pinned || !inView || idx < 0) return; timer = window.setTimeout(() => show((idx + 1) % buttons.length), CYCLE); };
      buttons.forEach((b, i) => {
        b.addEventListener('mouseenter', () => { hold = true; show(i, true); });
        b.addEventListener('focus', () => { hold = true; show(i, true); });
        b.addEventListener('click', () => { hold = true; show(i, true); clearTimeout(timer); window.setTimeout(() => { hold = false; schedule(); }, 14000); });
      });
      menu.addEventListener('mouseleave', () => { hold = false; clearTimeout(timer); rest(); timer = window.setTimeout(() => show(0), 4000); });
      const seen = new IntersectionObserver(([e]) => { inView = e.isIntersecting; if (inView) schedule(); else clearTimeout(timer); }, { threshold: .35 });
      seen.observe(host);
      const mount = new IntersectionObserver(async ([e]) => {
        if (!e.isIntersecting || api) return; mount.disconnect();
        const { mountSector } = await import('../../scripts/senal/sector.js');
        api = (await mountSector(host, SECTOR_FILMS[host.dataset.scode as keyof typeof SECTOR_FILMS])) as Api;
        if (q.has('rec')) (window as any).__scode = { api, show, rest, items: buttons.map((b) => b.dataset.item) };
        if (pinned && pinned !== 'idle') show(Math.max(0, buttons.findIndex((b) => b.dataset.item === pinned)));
        else { rest(); if (!pinned && !reduce) { clearTimeout(timer); timer = window.setTimeout(() => show(0), 4000); } }
      }, { rootMargin: '400px 0px' });
      mount.observe(host);
      document.addEventListener('astro:before-swap', () => { clearTimeout(timer); seen.disconnect(); mount.disconnect(); api?.dispose(); }, { once: true });
    });
  }
  boot(); document.addEventListener('astro:page-load', boot);
</script>
