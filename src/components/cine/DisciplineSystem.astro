---
import {DISCIPLINE_SYSTEMS} from '../../data/cine/disciplineSystems';
import drawing from '../../assets/cine/isometric/discipline-systems-v1.svg?raw';
interface Props {code?:string;codes?:string[]}
const {code='103',codes=[]}=Astro.props;
const individual=import.meta.glob<string>('../../assets/cine/isometric/discipline-*-v1.svg',{eager:true,query:'?raw',import:'default'});
const markup=codes.length===1?individual[`../../assets/cine/isometric/discipline-${code}-v1.svg`]:drawing;
---
<div class="discipline-system" data-discipline-system data-visible={String(Boolean(DISCIPLINE_SYSTEMS[code]))} data-discipline-service={code} data-discipline-stage="-1" role="img" aria-label="Capas conectadas del servicio, explicadas en el recorrido contiguo">
 <Fragment set:html={markup} />
 <p class="discipline-system__key"><span aria-hidden="true"></span><span data-discipline-key>Un sistema. Todas sus capas.</span></p>
</div>
<style>
 .discipline-system{position:absolute;inset:0;visibility:hidden;opacity:0;pointer-events:none;transition:opacity 700ms ease;isolation:isolate}
 .discipline-system[data-visible=true]{visibility:visible;opacity:1}
 .discipline-system :global(.ds-svg){display:block;width:100%;height:100%;overflow:visible}
 .discipline-system :global(.ds-drawing){display:none}
 .discipline-system[data-discipline-service="101"] :global([data-discipline-drawing="101"]),.discipline-system[data-discipline-service="102"] :global([data-discipline-drawing="102"]),.discipline-system[data-discipline-service="103"] :global([data-discipline-drawing="103"]),.discipline-system[data-discipline-service="104"] :global([data-discipline-drawing="104"]),.discipline-system[data-discipline-service="105"] :global([data-discipline-drawing="105"]),.discipline-system[data-discipline-service="106"] :global([data-discipline-drawing="106"]),.discipline-system[data-discipline-service="107"] :global([data-discipline-drawing="107"]),.discipline-system[data-discipline-service="108"] :global([data-discipline-drawing="108"]){display:block}
 .discipline-system :global(.ds-node){opacity:.68;transition:opacity 900ms ease}
 .discipline-system :global(.ds-node[data-current=true]),.discipline-system[data-discipline-stage="-1"] :global(.ds-node),.discipline-system[data-discipline-stage="6"] :global(.ds-node){opacity:1}
 .discipline-system :global(.ds-cover){transition:transform 1800ms cubic-bezier(.22,1,.36,1)}
 .discipline-system :global(.ds-node[data-current=true] .ds-cover){transform:translate(var(--ds-lift-x,0px),var(--ds-lift))}
 .discipline-system :global(.ds-tag circle){transition:fill 600ms,stroke 600ms}
 .discipline-system :global(.ds-tag[data-current=true] circle){fill:#981b24;stroke:#f4b5b5}
 .discipline-system :global(.ds-packet){opacity:0;animation:discipline-signal 4200ms linear infinite}
 .discipline-system :global([data-current=true]>.ds-packet){opacity:1}
 .discipline-system :global([data-current=true]>.ds-route){stroke:#e0a4a7}
 .discipline-system__key{position:absolute;left:0;right:0;bottom:0;display:flex;align-items:center;gap:10px;margin:0;font-size:1rem;line-height:1.5;color:#c4c7cc}
 .discipline-system__key>span:first-child{width:20px;height:2px;background:#dc2626;flex-shrink:0}
 @keyframes discipline-signal{to{stroke-dashoffset:-100}}
 @media(prefers-reduced-motion:reduce){.discipline-system,.discipline-system :global(.ds-node),.discipline-system :global(.ds-cover){transition:none!important}.discipline-system :global(.ds-packet){animation:none;stroke-dasharray:none;stroke-width:1.6}}
</style>
