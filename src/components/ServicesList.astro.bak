import EnhancedImage from "./EnhancedImage.astro";
import EnhancedImage from "./EnhancedImage.astro";
import EnhancedImage from "./EnhancedImage.astro";
---
// Componente para mostrar la lista de servicios
const { services } = Astro.props;

// Función para limitar el texto
const truncateText = (text, maxLength = 100) => {
  if (!text) return '';
  return text.length > maxLength ? text.substring(0, maxLength) + '...' : text;
};

// Función para generar slugs
const generateSlug = (text = '') => {
  if (text === null || typeof text === 'undefined') {
    console.warn('[generateSlug] Input is null/undefined, returning "item".');
    return 'item';
  }
  const slug = String(text)
    .toLowerCase()
    .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
    .replace(/[^\w\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 50);
  return slug || 'item';
};

// Función para obtener el color del ícono basado en el índice
const getIconColor = (index) => {
  const colors = [
    'text-red-500',
    'text-blue-500',
    'text-green-500',
    'text-yellow-500',
    'text-purple-500',
    'text-pink-500',
  ];
  return colors[index % colors.length];
};

// Script para manejar la carga perezosa de imágenes y los estados de carga
const lazyLoadScript = `
  document.addEventListener('DOMContentLoaded', function() {
    // Configurar el Intersection Observer para carga perezosa
    const lazyImageObserver = new IntersectionObserver(function(entries, observer) {
      entries.forEach(function(entry) {
        if (entry.isIntersecting) {
          const lazyImage = entry.target;
          
          // Mostrar el indicador de carga
          const loadingIndicator = lazyImage.closest('.image-container').querySelector('.loading-indicator');
          if (loadingIndicator) {
            loadingIndicator.classList.remove('hidden');
          }
          
          // Cargar la imagen
          if (lazyImage.dataset.src) {
            lazyImage.src = lazyImage.dataset.src;
            lazyImage.removeAttribute('data-src');
          }
          
          // Configurar manejadores de eventos para la imagen
          lazyImage.onload = function() {
            // Ocultar indicador de carga cuando la imagen se cargue
            if (loadingIndicator) {
              loadingIndicator.classList.add('hidden');
            }
            // Mostrar la imagen con transición
            lazyImage.classList.remove('opacity-0');
            lazyImage.classList.add('opacity-100');
          };
          
          // Manejar errores de carga
          lazyImage.onerror = function() {
            console.error('Error al cargar la imagen:', lazyImage.dataset.src);
            if (loadingIndicator) {
              loadingIndicator.classList.add('hidden');
            }
            // Mostrar placeholder de error
            const placeholder = lazyImage.closest('.image-container').querySelector('.error-placeholder');
            if (placeholder) {
              placeholder.classList.remove('hidden');
            }
          };
          
          // Dejar de observar esta imagen
          lazyImageObserver.unobserve(lazyImage);
        }
      });
    }, {
      rootMargin: '200px', // Cargar imágenes cuando estén a 200px de entrar en la vista
      threshold: 0.01
    });
    
    // Observar todas las imágenes con carga perezosa
    document.querySelectorAll('img.lazy-load').forEach(function(img) {
      lazyImageObserver.observe(img);
    });
  });
`;
---

<div class="container mx-auto px-4">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {services.map((service, index) => {
      const serviceSlug = generateSlug(service.Titulo);
      const serviceUrl = `/servicios/${service.id}/${serviceSlug}`;
      const iconColor = getIconColor(index);
      
      return (
        <article 
          class="group relative overflow-hidden bg-white rounded-xl shadow-lg hover:shadow-2xl transition-all duration-300 transform hover:-translate-y-2 h-full flex flex-col"
          itemScope 
          itemType="https://schema.org/Service"
        >
          {/* Imagen del servicio */}
          <div class="relative pt-[56.25%] overflow-hidden image-container">
            {/* Indicador de carga */}
            <div class="absolute inset-0 flex items-center justify-center bg-gray-100 transition-opacity duration-300 loading-indicator">
              <div class="w-12 h-12 border-4 border-gray-200 border-t-red-500 rounded-full animate-spin"></div>
            </div>
            
            {/* Placeholder de error (oculto por defecto) */}
            <div class="absolute inset-0 bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center hidden error-placeholder">
              <span class={`text-6xl ${iconColor} opacity-20`}>
                {['📊', '💻', '📱', '🔒', '☁️', '🤖'][index % 6]}
              </span>
            </div>
            
              <EnhancedImage
                src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${service.Imagen.id}?width=600&quality=80&access_token=${import.meta.env.PUBLIC_DIRECTUS_TOKEN}`}
                alt={service.Titulo}
                width="600"
                height="400"
                class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-500 group-hover:scale-105"
                loading="lazy"
                itemProp="image"
                placeholderSrc={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${service.Imagen.id}?width=20&quality=10&blur=10`}
                fallbackSrc="/images/placeholder-service.jpg"
              />
              <EnhancedImage
                src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${service.Imagen.id}?width=600&quality=80&access_token=${import.meta.env.PUBLIC_DIRECTUS_TOKEN}`}
                alt={service.Titulo}
                width="600"
                height="400"
                class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-500 group-hover:scale-105"
                loading="lazy"
                itemProp="image"
                placeholderSrc={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${service.Imagen.id}?width=20&quality=10&blur=10`}
                fallbackSrc="/images/placeholder-service.jpg"
              />
                <img 
                  src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${service.Imagen.id}?width=20&quality=10&blur=10`}
                  alt=""
                  class="absolute inset-0 w-full h-full object-cover blur-sm scale-105"
                  aria-hidden="true"
                />
                
                {/* Imagen real con carga perezosa */}
                <img 
                  data-src={`${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${service.Imagen.id}?width=600&quality=80&access_token=${import.meta.env.PUBLIC_DIRECTUS_TOKEN}`}
                  alt={service.Titulo}
                  width="600"
                  height="400"
                  class="absolute inset-0 w-full h-full object-cover opacity-0 transition-opacity duration-500 group-hover:scale-105 lazy-load"
                  loading="lazy"
                  itemProp="image"
                />
              </>
            ) : (
              <div class="absolute inset-0 bg-gradient-to-br from-gray-100 to-gray-200 flex items-center justify-center">
                <span class={`text-6xl ${iconColor} opacity-20`}>
                  {['📊', '💻', '📱', '🔒', '☁️', '🤖'][index % 6]}
                </span>
              </div>
            )}
            {/* Overlay en hover */}
            <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-end p-6">
              <a 
                href={serviceUrl}
                class="inline-flex items-center text-white font-medium text-sm bg-red-600 hover:bg-red-700 px-4 py-2 rounded-full transition-all duration-300 transform translate-y-4 group-hover:translate-y-0 opacity-0 group-hover:opacity-100"
              >
                Ver detalles
                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </a>
            </div>
          </div>
          
          {/* Contenido de la tarjeta */}
          <div class="p-6 flex-grow flex flex-col">
            <div class="mb-4">
              <span class={`inline-flex items-center justify-center w-12 h-12 rounded-full ${iconColor} bg-opacity-10 mb-4`}>
                {['📊', '💻', '📱', '🔒', '☁️', '🤖'][index % 6]}
              </span>
              <h3 
                class="text-xl font-bold text-gray-900 mb-3 group-hover:text-red-600 transition-colors duration-300"
                itemProp="name"
              >
                {service.Titulo}
              </h3>
              <p 
                class="text-gray-600 mb-6 line-clamp-3"
                itemProp="description"
              >
                {truncateText(service.Descripcion, 150)}
              </p>
            </div>
            
            <div class="mt-auto">
              <div class="flex items-center justify-between">
                <a 
                  href={serviceUrl}
                  class="text-red-600 hover:text-red-700 font-medium inline-flex items-center transition-colors duration-200"
                  aria-label={`Ver más sobre ${service.Titulo}`}
                >
                  Saber más
                  <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                  </svg>
                </a>
                <span class="text-sm text-gray-500">
                  {['Básico', 'Estándar', 'Premium'][index % 3]}
                </span>
              </div>
            </div>
          </div>
          
          {/* Efecto de borde inferior */}
          <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-red-500 to-red-300 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500"></div>
        </article>
      );
    })}
  </div>
  
  {/* Botón para ver todos los servicios */}
  <div class="text-center mt-16">
    <a 
      href="/servicios" 
      class="inline-flex items-center px-8 py-3 border border-transparent text-base font-medium rounded-full text-white bg-red-600 hover:bg-red-700 shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-all duration-300"
    >
      Ver todos los servicios
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 1.414L10.586 9H7a1 1 0 100 2h3.586l-1.293 1.293a1 1 0 101.414 1.414l3-3a1 1 0 000-1.414z" clip-rule="evenodd" />
      </svg>
    </a>
  </div>
</div>

<style>
  /* Estilos adicionales para las tarjetas */
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  /* Efecto de escala suave en hover */
  .group:hover .group-hover\:scale-105 {
    transform: scale(1.05);
  }
  
  /* Transición suave para el borde inferior */
  .transition-border {
    transition: border-color 0.3s ease;
  }
  
  /* Mejoras de accesibilidad para enlaces */
  a:focus {
    outline: 2px solid rgba(220, 38, 38, 0.5);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }
  
  /* Estilos para el indicador de carga */
  .loading-indicator {
    z-index: 10;
    background-color: rgba(255, 255, 255, 0.8);
  }
  
  /* Transición de opacidad para imágenes */
  .opacity-0 { opacity: 0; }
  .opacity-100 { opacity: 1; }
  
  /* Asegurar que el contenedor de la imagen ocupe espacio */
  .image-container {
    position: relative;
    background-color: #f3f4f6;
  }
  
  /* Asegurar que las imágenes ocupen todo el espacio disponible */
  .image-container img {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  
  /* Clase de utilidad para ocultar elementos */
  .hidden {
    display: none;
  }
</style>

<script is:inline>{lazyLoadScript}</script>
