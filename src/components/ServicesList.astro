---
// Componente para mostrar la lista de servicios
const { services } = Astro.props;

// BREAKTHROUGH DEFINITIVO: Mapeo usando rutas normales - nginx corregido sirve imágenes desde contenedor Astro
// Nginx ya deriva correctamente /images/services/ al contenedor umbot-astro-static
const imageMapping = {
  1: '/images/services/servicios-it.jpg',        // Servicios IT
  2: '/images/services/redes-comunicaciones.jpg', // Redes de datos  
  3: '/images/services/ciberseguridad.jpg',       // Seguridad Informática
  4: '/images/services/telefonia.jpg',            // Telefonía y Citofonía
  5: '/images/services/servicios-it.jpg',         // Software a medida (fallback)
  6: '/images/services/servicios-web.jpg'         // Servicios Web
};

// RESTAURADO: Función para obtener URL de imagen por ID de servicio directo
const getImageUrl = (serviceId) => {
  // Usar mapeo directo por ID de servicio (las imágenes originales existen)
  if (imageMapping[serviceId]) {
    return imageMapping[serviceId];
  }
  
  // Fallback a imagen por defecto
  return '/images/services/default-service.jpg';
};

// Función para limitar el texto
const truncateText = (text, maxLength = 100) => {
  if (!text) return '';
  return text.length > maxLength ? text.substring(0, maxLength) + '...' : text;
};

// Función para generar slugs
const generateSlug = (text = '') => {
  if (text === null || typeof text === 'undefined') {
    console.warn('[generateSlug] Input is null/undefined, returning "item".');
    return 'item';
  }
  const slug = String(text)
    .toLowerCase()
    .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
    .replace(/[^\w\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 50);
  return slug || 'item';
};

// Función para obtener el color del ícono basado en el índice
const getIconColor = (index) => {
  const colors = [
    'text-red-500',
    'text-blue-500',
    'text-green-500',
    'text-yellow-500',
    'text-purple-500',
    'text-pink-500',
  ];
  return colors[index % colors.length];
};
---

<div class="container mx-auto px-4">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {services.map((service, index) => {
      const serviceSlug = generateSlug(service.Titulo);
      const serviceUrl = `/servicios/${service.id}/${serviceSlug}`;
      const iconColor = getIconColor(index);
      const iconEmoji = ['📊', '💻', '📱', '🔒', '☁️', '🤖'][index % 6];
      const imageUrl = getImageUrl(service.id); // RESTAURADO: usar service.id en lugar de service.Imagen (null)
      
      return (
        <a href={serviceUrl} class="block group cursor-pointer">
          <article 
            class="group relative overflow-hidden bg-white h-full flex flex-col border border-gray-200 transition-colors duration-200 hover:border-red-500"
            itemScope 
            itemType="https://schema.org/Service"
          >
            {/* Contenedor de la imagen */}
            <div class="relative pt-[56.25%] overflow-hidden">
              <img
                src={imageUrl}
                alt={service.Titulo || 'Servicio de consultoría'}
                width="600"
                height="400"
                loading="lazy"
                class="absolute inset-0 w-full h-full object-cover"
                onerror={`
                  if (this.src !== '/images/services/default-service.jpg') {
                    console.log('Error cargando imagen:', this.src, 'usando fallback:', '/images/services/default-service.jpg');
                    this.src = '/images/services/default-service.jpg';
                    this.alt = 'Imagen de servicio ${service.Titulo || 'genérico'}';
                  }
                `}
              />
            </div>
            
            {/* Contenido de la tarjeta */}
            <div class="p-6 flex-grow flex flex-col">
              <div class="mb-4">
                <span class={`inline-flex items-center justify-center w-12 h-12 rounded-[4px] ${iconColor} bg-opacity-10 mb-4`}>
                  {iconEmoji}
                </span>
                <h3 
                  class="text-xl font-semibold text-gray-900 mb-3 group-hover:text-red-600 transition-colors duration-300"
                  itemProp="name"
                >
                  {service.Titulo}
                </h3>
                <p 
                  class="text-gray-600 mb-6 line-clamp-3"
                  itemProp="description"
                >
                  {truncateText(service.Descripcion, 150)}
                </p>
              </div>
              
              <div class="mt-auto">
                <div class="flex items-center justify-between">
                  <span class="text-red-600 hover:text-red-700 font-medium inline-flex items-center transition-colors duration-200">
                    Saber más
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </span>
                  <span class="text-base text-gray-500">
                    {['Básico', 'Estándar', 'Premium'][index % 3]}
                  </span>
                </div>
              </div>
            </div>
            
            {/* Efecto de borde inferior */}
            <div class="absolute bottom-0 left-0 right-0 h-px bg-red-500 opacity-0 group-hover:opacity-100 transition-opacity duration-200"></div>
          </article>
        </a>
      );
    })}
  </div>
  
  {/* Botón para ver todos los servicios */}
  <div class="text-center mt-16">
    <a 
      href="/servicios" 
      class="inline-flex items-center px-8 py-3 border border-transparent text-base font-medium rounded-[4px] text-white bg-red-600 hover:bg-red-700 transition-colors duration-200"
    >
      Ver todos los servicios
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 1.414L10.586 9H7a1 1 0 100 2h3.586l-1.293 1.293a1 1 0 101.414 1.414l3-3a1 1 0 000-1.414z" clip-rule="evenodd" />
      </svg>
    </a>
  </div>
</div>

<style>
  /* Estilos para las tarjetas */
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  /* Mejoras de accesibilidad para enlaces */
  a:focus {
    outline: 2px solid rgba(220, 38, 38, 0.5);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }
</style>
