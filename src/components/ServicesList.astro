---
// Componente para mostrar la lista de servicios
import { getAssetUrl } from '../utils/imageUtils.js';

const { services } = Astro.props;

// Mapeo de IDs de servicio a asset IDs de Directus (fallback si service.Imagen no está disponible)
const assetIdMapping = {
  1: '2749f988-2e2d-4f32-9978-4dbeb4aa6ab2', // Servicios IT
  2: '18b5f4e3-4bc8-485d-a01c-8cbd53e25f4d', // Redes de datos  
  3: 'f2a65085-e6ad-49fc-a123-1b5dc19fc7ab', // Seguridad Informática
  4: '4ffcefb0-6cb8-4cfa-a748-bd4c3da1d716', // Telefonía y Citofonía
  5: '2749f988-2e2d-4f32-9978-4dbeb4aa6ab2', // Software a medida (fallback a IT)
  6: 'dc6d6069-23af-4d75-ae5a-38c830bf2b85'  // Servicios Web
};

// Función para obtener URL de imagen usando Directus assets con token
const getImageUrl = (service) => {
  // Prioridad 1: usar service.Imagen si existe (asset ID de Directus)
  if (service.Imagen) {
    return getAssetUrl(service.Imagen, true);
  }
  
  // Prioridad 2: usar mapeo por ID de servicio
  if (service.id && assetIdMapping[service.id]) {
    return getAssetUrl(assetIdMapping[service.id], true);
  }
  
  // Fallback a imagen por defecto
  return '/images/default-service.jpg';
};

// Función para limitar el texto
const truncateText = (text, maxLength = 100) => {
  if (!text) return '';
  return text.length > maxLength ? text.substring(0, maxLength) + '...' : text;
};

// Función para generar slugs
const generateSlug = (text = '') => {
  if (text === null || typeof text === 'undefined') {
    console.warn('[generateSlug] Input is null/undefined, returning "item".');
    return 'item';
  }
  const slug = String(text)
    .toLowerCase()
    .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
    .replace(/[^\w\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 50);
  return slug || 'item';
};

// Función para obtener el color del ícono basado en el índice
const getIconColor = (index) => {
  const colors = [
    'text-red-500',
    'text-blue-500',
    'text-green-500',
    'text-yellow-500',
    'text-purple-500',
    'text-pink-500',
  ];
  return colors[index % colors.length];
};
---

<div class="container mx-auto px-4">
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {services.map((service, index) => {
      const serviceSlug = generateSlug(service.Titulo);
      const serviceUrl = `/servicios/${service.id}/${serviceSlug}`;
      const iconColor = getIconColor(index);
      const iconEmoji = ['📊', '💻', '📱', '🔒', '☁️', '🤖'][index % 6];
      const imageUrl = getImageUrl(service); // Usar objeto service completo para obtener imagen desde Directus
      
      return (
        <a href={serviceUrl} class="block group cursor-pointer">
          <article 
            class="group relative overflow-hidden bg-white rounded-xl shadow-lg hover:shadow-2xl hover:shadow-blue-500/25 transition-all duration-300 transform hover:-translate-y-2 hover:scale-[1.02] hover:ring-4 hover:ring-blue-300/50 h-full flex flex-col border-2 border-transparent hover:border-blue-400"
            itemScope 
            itemType="https://schema.org/Service"
          >
            {/* Contenedor de la imagen */}
            <div class="relative pt-[56.25%] overflow-hidden">
              <img
                src={imageUrl}
                alt={service.Titulo || 'Servicio de consultoría'}
                width="600"
                height="400"
                loading="lazy"
                class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                onerror={`
                  if (this.src !== '/images/default-service.jpg') {
                    console.log('Error cargando imagen:', this.src, 'usando fallback:', '/images/default-service.jpg');
                    this.src = '/images/default-service.jpg';
                    this.alt = 'Imagen de servicio ${service.Titulo || 'genérico'}';
                  }
                `}
              />
            </div>
            
            {/* Contenido de la tarjeta */}
            <div class="p-6 flex-grow flex flex-col">
              <div class="mb-4">
                <span class={`inline-flex items-center justify-center w-12 h-12 rounded-full ${iconColor} bg-opacity-10 mb-4`}>
                  {iconEmoji}
                </span>
                <h3 
                  class="text-xl font-black text-gray-900 mb-3 group-hover:text-red-600 transition-colors duration-300"
                  itemProp="name"
                >
                  {service.Titulo}
                </h3>
                <p 
                  class="text-gray-600 mb-6 line-clamp-3"
                  itemProp="description"
                >
                  {truncateText(service.Descripcion, 150)}
                </p>
              </div>
              
              <div class="mt-auto">
                <div class="flex items-center justify-between">
                  <span class="text-red-600 hover:text-red-700 font-medium inline-flex items-center transition-colors duration-200">
                    Saber más
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                    </svg>
                  </span>
                  <span class="text-sm text-gray-500">
                    {['Básico', 'Estándar', 'Premium'][index % 3]}
                  </span>
                </div>
              </div>
            </div>
            
            {/* Efecto de borde inferior */}
            <div class="absolute bottom-0 left-0 right-0 h-1 bg-gradient-to-r from-red-500 to-red-300 transform scale-x-0 group-hover:scale-x-100 transition-transform duration-500"></div>
          </article>
        </a>
      );
    })}
  </div>
  
  {/* Botón para ver todos los servicios */}
  <div class="text-center mt-16">
    <a 
      href="/servicios" 
      class="inline-flex items-center px-8 py-3 border border-transparent text-base font-medium rounded-full text-white bg-red-600 hover:bg-red-700 shadow-lg hover:shadow-xl transform hover:-translate-y-1 transition-all duration-300"
    >
      Ver todos los servicios
      <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" viewBox="0 0 20 20" fill="currentColor">
        <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-8.707l-3-3a1 1 0 00-1.414 1.414L10.586 9H7a1 1 0 100 2h3.586l-1.293 1.293a1 1 0 101.414 1.414l3-3a1 1 0 000-1.414z" clip-rule="evenodd" />
      </svg>
    </a>
  </div>
</div>

<style>
  /* Estilos para las tarjetas */
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  /* Efecto de escala suave en hover */
  .group:hover .group-hover\:scale-105 {
    transform: scale(1.05);
  }
  
  /* Mejoras de accesibilidad para enlaces */
  a:focus {
    outline: 2px solid rgba(220, 38, 38, 0.5);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }
</style>
