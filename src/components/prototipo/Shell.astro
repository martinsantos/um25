---
/**
 * Prototipo 2026-10-29 · cáscara común (barra, pie, tema papel, tipografía UM Sans).
 * Aislada del layout V4 para evaluar la dirección sin arrastrar v4.css. No indexable.
 */
interface Props { title: string; active?: 'inicio' | 'proyectos' | 'sistema' | 'notas' }
const { title, active } = Astro.props;
---
<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} · Prototipo | ULTIMA MILLA</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href="/fonts/um-sans/v2.0.0/UMSans2-Variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="stylesheet" href="/fonts/um-sans/v2.0.0/um-sans.css" />
    <slot name="head" />
  </head>
  <body>
    <header class="top">
      <a class="logo" href="/prototipo">ultimamilla<i>.</i>com<i>.</i>ar</a>
      <nav aria-label="Principal">
        <a href="/prototipo#sistemas" aria-current={active === 'inicio' ? 'page' : undefined}>Sistemas</a>
        <a href="/prototipo#lugares">Lugares</a>
        <a href="/prototipo/proyectos" aria-current={active === 'proyectos' ? 'page' : undefined}>Proyectos</a>
        <a href="/blog" aria-current={active === 'notas' ? 'page' : undefined}>Notas</a>
        <a class="cta" href="/prototipo#contacto">Contactar</a>
      </nav>
    </header>
    <slot />
    <footer class="foot">
      <span>ultimamilla.com.ar</span>
      <span>Houssay 1159, Guaymallén, Mendoza · contacto@ultimamilla.com.ar · Lunes a viernes, 8 a 18 h</span>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f2f0eb;
    --paper-2: #e9e6df;
    --board: #0c0f12;
    --ink: #0b0b0c;
    --ink-2: #4a4a4c;
    --ink-3: #8a8a8d;
    --line: rgba(11, 11, 12, .14);
    --red: #dc2626;
    --font: var(--um-font-family, 'UM Sans 2', 'UM Sans 1.2 Compatibility', Arial, system-ui, sans-serif);
    --gutter: clamp(16px, 3vw, 40px);
    --bar-h: 60px;
  }
  * { box-sizing: border-box; }
  html { background: var(--paper); color: var(--ink); font-family: var(--font); font-synthesis: none; -webkit-font-smoothing: antialiased; scroll-behavior: smooth; }
  body { margin: 0; font-size: 1rem; line-height: 1.5; }
  a { color: inherit; text-decoration: none; }
  button { font: inherit; color: inherit; background: none; border: 0; padding: 0; cursor: pointer; }
  img { max-width: 100%; }
  :focus-visible { outline: 2px solid var(--red); outline-offset: 3px; }
  h1, h2, h3 { margin: 0; font-weight: 600; letter-spacing: -.02em; text-wrap: balance; }
  h2 { font-size: clamp(1.6rem, 2.6vw, 2.25rem); line-height: 1.12; }
  h3 { font-size: 1.125rem; line-height: 1.3; }
  p { margin: 0; }

  .top { position: sticky; top: 0; z-index: 30; display: flex; align-items: center; justify-content: space-between; gap: 24px; height: var(--bar-h); padding: 0 var(--gutter); background: var(--paper); border-bottom: 1px solid var(--line); }
  .logo { font-weight: 600; font-size: 1.25rem; letter-spacing: -.02em; }
  .logo i { font-style: normal; color: var(--red); }
  .top nav { display: flex; gap: clamp(14px, 2vw, 28px); }
  .top nav a { padding: 8px 0; border-bottom: 2px solid transparent; }
  .top nav a:hover, .top nav a[aria-current="page"] { border-bottom-color: var(--ink); }
  .top nav a.cta { font-weight: 600; color: var(--red); }

  .wrap { padding: 0 var(--gutter); }
  .band { padding: clamp(40px, 6vw, 80px) var(--gutter); border-top: 1px solid var(--line); }
  .band__head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px 24px; margin-bottom: clamp(20px, 3vw, 32px); }
  .link { font-weight: 600; text-decoration: underline; text-decoration-color: var(--red); text-underline-offset: 4px; }
  .btn { display: inline-flex; align-items: center; gap: 10px; min-height: 52px; padding: 0 22px; background: var(--red); color: #fff; font-weight: 600; }
  .btn:hover { background: #b91c1c; }
  .btn--ghost { background: transparent; color: var(--ink); border: 1px solid var(--ink); }
  .btn--ghost:hover { background: var(--ink); color: #fff; }
  .muted { color: var(--ink-2); }
  .faint { color: var(--ink-3); }
  .num { font-variant-numeric: tabular-nums; }

  /* Filas de proyecto (misma pieza en portada y fichas) */
  .rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .rows li a { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 7fr) auto; gap: 8px 24px; padding: 14px 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  .rows b { font-weight: 600; }
  .rows span { color: var(--ink-2); }
  .rows em { font-style: normal; color: var(--ink-3); white-space: nowrap; font-variant-numeric: tabular-nums; }
  .rows li a:hover b { text-decoration: underline; text-decoration-color: var(--red); text-underline-offset: 3px; }

  /* Mosaico de fotos (misma pieza en portada y fichas) */
  .tiles { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px 18px; list-style: none; margin: 0; padding: 0; }
  .tile { display: grid; gap: 8px; min-width: 0; }
  .tile figure { margin: 0; aspect-ratio: 16 / 10; overflow: hidden; background: var(--paper-2); }
  .tile img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .tile b { display: block; font-weight: 600; line-height: 1.3; }
  .tile span { display: block; line-height: 1.35; color: var(--ink-2); overflow: hidden; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; }
  .tile em { display: block; font-style: normal; color: var(--ink-3); font-variant-numeric: tabular-nums; }
  .tile a:hover b { text-decoration: underline; text-decoration-color: var(--red); text-underline-offset: 3px; }

  .foot { display: flex; flex-wrap: wrap; gap: 8px 24px; justify-content: space-between; padding: 20px var(--gutter) 28px; border-top: 1px solid var(--line); color: var(--ink-2); }

  @media (max-width: 1100px) { .tiles { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 860px) {
    .top nav a:not(.cta) { display: none; }
    .rows li a { grid-template-columns: 1fr; gap: 2px; }
    .tiles { gap: 16px 12px; }
  }
</style>
