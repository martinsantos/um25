---
/**
 * Prototipo 2026-10-29 · la ficha única. Un solo formato para sistema, lugar y proyecto:
 * a la izquierda los datos fijos (qué, dónde, cuándo, con qué sistemas) y la acción;
 * a la derecha la imagen y el contenido en secciones de filas. Nada decorativo.
 */
interface Fact { dt: string; dd: string; href?: string }
interface Row { a: string; b?: string; href?: string }
interface Section { title: string; rows?: Row[]; items?: string[] }
interface Related { href: string; b: string; span: string; em: string }
interface Props {
  kind: string;
  kindHref?: string;
  title: string;
  lead?: string;
  facts: Fact[];
  stage: { image: string; alt?: string; caption?: string; width?: number; height?: number };
  sections: Section[];
  related?: Related[];
  relatedTitle?: string;
  relatedHref?: string;
  relatedLabel?: string;
}
const { kind, kindHref, title, lead, facts, stage, sections, related = [], relatedTitle, relatedHref, relatedLabel } = Astro.props;
---
<main class="ficha">
  <aside class="ficha__side">
    <p class="ficha__kind">{kindHref ? <a href={kindHref}>{kind}</a> : kind}</p>
    <h1 class="ficha__title">{title}</h1>
    {lead && <p class="ficha__lead">{lead}</p>}
    <dl class="ficha__facts">
      {facts.map((f) => (
        <div><dt>{f.dt}</dt><dd>{f.href ? <a class="link" href={f.href}>{f.dd}</a> : f.dd}</dd></div>
      ))}
    </dl>
    <a class="btn" href="/prototipo#contacto">Pedir un relevamiento</a>
  </aside>

  <div class="ficha__main">
    <figure class="ficha__stage">
      <img src={stage.image} alt={stage.alt || ''} width={stage.width || 1600} height={stage.height || 1000} loading="eager" fetchpriority="high" decoding="async" />
      {stage.caption && <figcaption>{stage.caption}</figcaption>}
    </figure>

    {sections.map((s) => (
      <section class="ficha__section">
        <h2>{s.title}</h2>
        {s.rows && (
          <ul class="ficha__rows">
            {s.rows.map((r) => (
              <li>
                {r.href ? <a class="link" href={r.href}>{r.a}</a> : <b>{r.a}</b>}
                {r.b && <span>{r.b}</span>}
              </li>
            ))}
          </ul>
        )}
        {s.items && (
          <ul class="ficha__list">
            {s.items.map((item) => <li>{item}</li>)}
          </ul>
        )}
      </section>
    ))}

    {related.length > 0 && (
      <section class="ficha__section">
        <div class="band__head" style="margin-bottom:16px">
          <h2>{relatedTitle}</h2>
          {relatedHref && <a class="link" href={relatedHref}>{relatedLabel}</a>}
        </div>
        <ol class="rows">
          {related.map((r) => (
            <li><a href={r.href}><b>{r.b}</b><span>{r.span}</span><em>{r.em}</em></a></li>
          ))}
        </ol>
      </section>
    )}
  </div>
</main>

<style is:global>
  .ficha { display: grid; grid-template-columns: minmax(280px, 30fr) minmax(0, 70fr); gap: clamp(28px, 5vw, 80px); padding: clamp(28px, 4vw, 56px) var(--gutter) clamp(48px, 6vw, 88px); }
  .ficha__side { position: sticky; top: calc(var(--bar-h) + 24px); align-self: start; }
  .ficha__kind { color: var(--ink-3); }
  .ficha__kind a { text-decoration: underline; text-underline-offset: 3px; }
  .ficha__title { margin-top: 10px; font-size: clamp(2rem, 3.4vw, 3.25rem); line-height: 1.02; font-weight: 700; letter-spacing: -.03em; }
  .ficha__lead { margin-top: 16px; font-size: 1.125rem; color: var(--ink-2); max-width: 44ch; }
  .ficha__facts { margin: 28px 0 0; padding: 0; border-top: 1px solid var(--line); }
  .ficha__facts div { display: grid; grid-template-columns: 120px minmax(0, 1fr); gap: 16px; padding: 12px 0; border-bottom: 1px solid var(--line); }
  .ficha__facts dt { color: var(--ink-3); }
  .ficha__facts dd { margin: 0; }
  .ficha__side .btn { margin-top: 24px; }
  .ficha__stage { margin: 0; }
  .ficha__stage img { display: block; width: 100%; height: auto; background: var(--paper-2); }
  .ficha__stage figcaption { margin-top: 10px; color: var(--ink-3); }
  .ficha__section { margin-top: clamp(36px, 5vw, 64px); }
  .ficha__section h2 { margin-bottom: 16px; }
  .ficha__rows { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .ficha__rows li { display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 3fr); gap: 8px 24px; padding: 12px 0; border-bottom: 1px solid var(--line); align-items: baseline; }
  .ficha__rows span { color: var(--ink-2); }
  .ficha__list { margin: 0; padding: 0 0 0 1.1em; color: var(--ink-2); }
  .ficha__list li { padding: 4px 0; }
  @media (max-width: 860px) {
    .ficha { grid-template-columns: 1fr; gap: 28px; }
    .ficha__side { position: static; }
    .ficha__rows li { grid-template-columns: 1fr; gap: 2px; }
  }
</style>
