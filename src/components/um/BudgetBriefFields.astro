---
/** Campos estructurados de presupuesto (maqueta, sin backend dedicado). */
import { budgetFields } from '../../data/budgetBrief';
interface Props {
  idPrefix?: string;
  locale?: 'es' | 'en';
  /** Una columna en paneles estrechos (p. ej. contacto) */
  singleColumn?: boolean;
}

const { idPrefix = 'budget', locale = 'es', singleColumn = false } = Astro.props;
const isEn = locale === 'en';
---

<fieldset class:list={['budget-brief-fields', singleColumn && 'budget-brief-fields--single']}>
  <legend>{isEn ? 'Project context' : 'Contexto del proyecto'}</legend>
  <div class="budget-brief-fields__grid">
    {budgetFields.map(field => (
      <label for={`${idPrefix}-${field.suffix}`}>
        <span>{field[locale]}</span>
        <select id={`${idPrefix}-${field.suffix}`} name={field.key} data-budget-field>
          <option value="">{isEn ? 'Select…' : 'Seleccionar…'}</option>
          {field.options.map(option => <option value={option.value}>{option[locale]}</option>)}
        </select>
      </label>
    ))}
  </div>
</fieldset>

<style>
  .budget-brief-fields {
    margin: 0 0 20px;
    padding: 0;
    border: 0;
  }

  .budget-brief-fields legend {
    margin-bottom: 12px;
    color: var(--skin-muted, #5f6368);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .budget-brief-fields__grid {
    display: grid;
    gap: 14px;
    grid-template-columns: 1fr;
    min-width: 0;
  }

  @media (min-width: 640px) {
    .budget-brief-fields:not(.budget-brief-fields--single) .budget-brief-fields__grid {
      grid-template-columns: 1fr 1fr;
    }
  }

  .budget-brief-fields label {
    display: grid;
    gap: 6px;
  }

  .budget-brief-fields label span {
    font-size: 1rem;
    font-weight: 600;
    color: var(--skin-text, #111);
  }

  .budget-brief-fields select {
    width: 100%;
    max-width: 100%;
    min-height: 44px;
    padding: 10px 12px;
    border: 0;
    border-radius: 0;
    font-size: 1rem;
    background: #f7f8f9;
    color: var(--skin-text, #111);
    box-shadow: inset 0 -1px 0 var(--skin-line, #d9dadd);
  }

  .budget-brief-fields select:focus-visible {
    outline: 2px solid var(--um-red);
    outline-offset: 2px;
  }
</style>
