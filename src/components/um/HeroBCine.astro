---
interface HeroBg {
  src: string;
  caption: string;
  loc: string;
  firstLiner: string;
  fx: 'type' | 'flap';
}

interface Props {
  position?: string;
  founded?: number;
}

const {
  position = 'Servicios IT integrales para operaciones que no pueden detenerse.',
  founded = 2000,
} = Astro.props;

const backgrounds: HeroBg[] = [
  {
    src: '/img/servicios/telecomunicaciones.webp',
    caption: 'TELECOMUNICACIONES DATOS/VOZ/VIDEO',
    loc: 'Patagonia',
    fx: 'flap',
    firstLiner: 'Enlaces donde no llega nadie mas.',
  },
  {
    src: '/hero/bodega.png',
    caption: 'REDES INDUSTRIALES EN CAVA',
    loc: 'Bodega Tapiz',
    fx: 'type',
    firstLiner: 'Trazabilidad de cosecha a botella.',
  },
  {
    src: '/hero/noc.png',
    caption: 'CENTRO DE OPERACIONES NOC',
    loc: 'Mendoza',
    fx: 'type',
    firstLiner: 'Monitoreo 24/7 sin puntos ciegos.',
  },
  {
    src: '/hero/fiber.png',
    caption: 'BACKBONE DE FIBRA OPTICA',
    loc: 'Aeropuertos Argentina 2000',
    fx: 'flap',
    firstLiner: 'Fibra certificada, operacion continua.',
  },
  {
    src: '/hero/cctv.png',
    caption: 'CENTRO DE MONITOREO CCTV',
    loc: 'Aeropuerto El Plumerillo',
    fx: 'flap',
    firstLiner: 'Evidencia visual accionable.',
  },
  {
    src: '/img/servicios/redes.webp',
    caption: 'CABLEADO ESTRUCTURADO CERTIFICADO',
    loc: 'Mendoza',
    fx: 'type',
    firstLiner: 'Redes que sostienen la operacion.',
  },
  {
    src: '/img/sectores/aeropuertos.webp',
    caption: 'OPERACION AEROPORTUARIA CONTINUA',
    loc: 'AA2000',
    fx: 'flap',
    firstLiner: 'Perimetro, pistas y terminal 24/7.',
  },
  {
    src: '/img/sectores/mineria.webp',
    caption: 'TELECOMUNICACIONES EN FAENA REMOTA',
    loc: 'Minera Frontera',
    fx: 'flap',
    firstLiner: 'Conectividad en campamento y mina.',
  },
  {
    src: '/hero/hospital.png',
    caption: 'INFRAESTRUCTURA CRITICA EN SALUD',
    loc: 'Hospital Perrupato',
    fx: 'type',
    firstLiner: 'Sistemas criticos con guardia real.',
  },
  {
    src: '/img/sectores/bodegas.webp',
    caption: 'OPERACION TECNOLOGICA EN BODEGA',
    loc: 'Valle de Uco',
    fx: 'type',
    firstLiner: 'Produccion conectada sin interrumpir planta.',
  },
  {
    src: '/img/servicios/seguridad-electronica.webp',
    caption: 'SEGURIDAD ELECTRONICA INTEGRADA',
    loc: 'Mendoza',
    fx: 'flap',
    firstLiner: 'CCTV, accesos y alarmas en una sola operacion.',
  },
  {
    src: '/img/servicios/deteccion-incendios.webp',
    caption: 'DETECCION Y ALARMA DE INCENDIOS',
    loc: 'Torre Thays',
    fx: 'flap',
    firstLiner: 'Deteccion temprana documentada.',
  },
  {
    src: '/img/servicios/software-a-medida.webp',
    caption: 'SOFTWARE OPERATIVO A MEDIDA',
    loc: 'Gobierno y empresas',
    fx: 'type',
