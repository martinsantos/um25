---
interface Props {
  href: string;
  number: string;
  title: string;
  description?: string;
  image?: string;
  imageAlt?: string;
  sector?: string;
  year?: string;
  actionLabel?: string;
  imageLoading?: 'lazy' | 'eager';
  eyebrow?: string;
  recordTone?: 'case' | 'technical-record' | 'documentary-record' | 'editorial-review';
  /** KPIs opcionales (B1) — solo se muestran si hay datos reales */
  metrics?: Array<{ value: string; label: string }>;
}

const {
  href,
  number,
  title,
  description,
  image,
  imageAlt = title,
  sector = '—',
  year = '—',
  actionLabel = 'Detalle',
  imageLoading = 'lazy',
  eyebrow = '',
  recordTone = 'case',
  metrics = [],
} = Astro.props;

const visibleMetrics = (metrics || []).filter((m) => m?.value && m?.label).slice(0, 3);
---

<a href={href} class="um-click-surface evidence-case-row">
  <span class="evidence-case-row__number">{number}</span>
  {image ? (
    <figure class="evidence-case-row__thumb">
      <img src={image} alt={imageAlt} loading={imageLoading} decoding="async" onerror="this.onerror=null;this.src='/images/default.jpg'" />
    </figure>
  ) : (
    <span class="evidence-case-row__thumb evidence-case-row__thumb--empty" aria-hidden="true"></span>
  )}
  <div class="evidence-case-row__copy">
    {eyebrow && <span class:list={['evidence-case-row__eyebrow', `is-${recordTone}`]}>{eyebrow}</span>}
    <h3>{title}</h3>
    {description && <p>{description}</p>}
    {visibleMetrics.length > 0 && (
      <ul class="evidence-case-row__metrics" aria-label="Resultados del proyecto">
        {visibleMetrics.map((metric) => (
          <li>
            <strong>{metric.value}</strong>
            <span>{metric.label}</span>
          </li>
        ))}
      </ul>
    )}
  </div>
  <div class="evidence-case-row__meta-group">
    <div class="evidence-case-row__meta">
      <span>Sector</span>
      <strong>{sector}</strong>
    </div>
    <div class="evidence-case-row__meta">
      <span>Año</span>
      <strong>{year}</strong>
    </div>
  </div>
  <em class="evidence-case-row__action">{actionLabel}</em>
</a>

<style>
  .evidence-case-row {
    display: grid;
    grid-template-columns: 3rem minmax(156px, 0.2fr) minmax(240px, 1fr) minmax(160px, 0.34fr) auto;
    column-gap: clamp(14px, 1.8vw, 24px);
    row-gap: 12px;
    align-items: center;
    margin-bottom: 0.9rem;
    padding: clamp(14px, 1.8vw, 20px);
    border: 1px solid #e3e6ea;
    border-radius: 6px;
    background: #fff;
    color: inherit;
    text-decoration: none;
    box-sizing: border-box;
    box-shadow: none;
    transition:
      background-color 180ms ease,
      border-color 180ms ease;
  }

  .evidence-case-row > * {
    min-width: 0;
  }

  .evidence-case-row:hover {
    border-color: color-mix(in srgb, var(--um-red) 34%, #e3e6ea);
    background: color-mix(in srgb, #ffffff 94%, var(--um-red) 6%);
  }

  .evidence-case-row:focus-visible {
    outline: 2px solid var(--um-red);
    outline-offset: 2px;
  }

  .evidence-case-row__number {
    align-self: center;
    color: var(--um-red);
    font-size: 1.0625rem;
    font-weight: 700;
    line-height: 1.2;
    text-align: left;
  }

  .evidence-case-row__thumb {
    margin: 0;
    overflow: hidden;
    width: 100%;
    height: auto;
    min-width: 156px;
    min-height: 112px;
    aspect-ratio: 16 / 10;
    border-radius: 4px;
    background: #eceff2;
  }

  .evidence-case-row__thumb--empty {
    display: block;
  }

  .evidence-case-row__thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(0.88) contrast(1.04);
  }

  .evidence-case-row__copy {
    min-width: 0;
  }

  .evidence-case-row__eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    margin-bottom: 8px;
    color: #4b5563;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .evidence-case-row__eyebrow::before {
    content: "";
    width: 18px;
    height: 2px;
    background: currentColor;
  }

  .evidence-case-row__eyebrow.is-case {
    color: var(--um-red);
  }

  .evidence-case-row__eyebrow.is-documentary-record,
  .evidence-case-row__eyebrow.is-technical-record {
    color: #6b7280;
  }

  .evidence-case-row__eyebrow.is-editorial-review {
    color: #92400e;
  }

  .evidence-case-row h3 {
    margin: 0;
    color: var(--skin-text, #0b0b0b);
    font-family: var(--um-font-display);
    font-size: clamp(1.12rem, 1.28vw, 1.32rem);
    font-weight: 600;
    line-height: 1.18;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }

  .evidence-case-row p {
    margin: 8px 0 0;
    color: #4b5563;
    font-size: 1.0625rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
  }

  .evidence-case-row__metrics {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
  }

  .evidence-case-row__metrics li {
    display: inline-flex;
    align-items: baseline;
    gap: 6px;
    font-size: 1rem;
    line-height: 1.3;
  }

  .evidence-case-row__metrics strong {
    color: var(--um-red);
    font-weight: 700;
  }

  .evidence-case-row__metrics span {
    color: #6b7280;
  }

  .evidence-case-row__meta-group {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
    align-items: start;
    min-width: 0;
  }

  .evidence-case-row__meta span {
    display: block;
    color: #6b7280;
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .evidence-case-row__meta strong {
    display: block;
    margin-top: 4px;
    color: var(--skin-text, #111);
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.25;
    overflow-wrap: anywhere;
  }

  .evidence-case-row__action {
    justify-self: end;
    color: var(--um-red);
    font-size: 1.0625rem;
    font-style: normal;
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 3px;
    text-decoration-color: transparent;
    transition: text-decoration-color 180ms ease;
    white-space: nowrap;
  }

  .evidence-case-row:hover .evidence-case-row__action {
    text-decoration-color: var(--um-red);
  }

  @media (max-width: 900px) {
    .evidence-case-row {
      grid-template-columns: minmax(112px, 0.34fr) minmax(0, 1fr);
      column-gap: 14px;
      align-items: start;
      padding: 14px;
    }

    .evidence-case-row__number {
      grid-row: 1;
      grid-column: 1;
      align-self: start;
      padding-top: 2px;
    }

    .evidence-case-row__thumb {
      grid-column: 1;
      grid-row: 2;
      width: 100%;
      min-width: 112px;
      max-width: none;
      height: auto;
      min-height: 72px;
      aspect-ratio: 4 / 3;
    }

    .evidence-case-row__copy {
      grid-column: 2;
      grid-row: 1 / span 2;
      align-self: center;
    }

    .evidence-case-row__meta-group {
      grid-column: 1 / -1;
      grid-template-columns: minmax(0, 1fr) minmax(3.5rem, 4.5rem);
    }

    .evidence-case-row__action {
      grid-column: 1 / -1;
      justify-self: start;
    }
  }

  @media (max-width: 520px) {
    .evidence-case-row {
      grid-template-columns: minmax(0, 1fr);
    }

    .evidence-case-row__number,
    .evidence-case-row__thumb,
    .evidence-case-row__copy,
    .evidence-case-row__meta-group,
    .evidence-case-row__action {
      grid-column: 1;
      grid-row: auto;
    }

    .evidence-case-row__thumb {
      min-width: 0;
      min-height: 160px;
      aspect-ratio: 16 / 9;
    }

    .evidence-case-row__copy {
      align-self: start;
    }
  }
</style>
