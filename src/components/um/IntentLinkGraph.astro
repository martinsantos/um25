---
import type { StrategicLinkGroup } from '../../data/strategicLinkGraph';

interface Props {
  kicker?: string;
  title: string;
  text: string;
  groups: StrategicLinkGroup[];
  class?: string;
}

const {
  kicker = 'Mapa de vinculacion',
  title,
  text,
  groups,
  class: className = '',
} = Astro.props;

const sectionId = `intent-link-graph-${title
  .toLowerCase()
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '')
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '')}`;

const visibleGroups = groups.filter((group) => group.items.length > 0);
---

{visibleGroups.length > 0 && (
  <section class:list={['um-intent-link-graph', className]} aria-labelledby={sectionId}>
    <div class="um-intent-link-graph__inner">
      <div class="um-intent-link-graph__header">
        <p class="um-intent-link-graph__kicker">{kicker}</p>
        <h2 id={sectionId}>{title}</h2>
        <p>{text}</p>
      </div>

      <div class="um-intent-link-graph__grid">
        {visibleGroups.map((group) => (
          <article class="um-intent-link-graph__group">
            <div class="um-intent-link-graph__group-header">
              <h3>{group.title}</h3>
              <p>{group.summary}</p>
            </div>

            <div class="um-intent-link-graph__items">
              {group.items.map((item) => (
                <a class={`um-intent-link-graph__item um-intent-link-graph__item--${item.kind || 'core'}`} href={item.href}>
                  {item.image && (
                    <span class="um-intent-link-graph__media" aria-hidden="true">
                      <img src={item.image} alt="" loading="lazy" decoding="async" />
                    </span>
                  )}
                  <span class="um-intent-link-graph__copy">
                    {item.eyebrow && <span class="um-intent-link-graph__eyebrow">{item.eyebrow}</span>}
                    <strong>{item.label}</strong>
                    <span>{item.summary}</span>
                  </span>
                  <span class="um-intent-link-graph__arrow" aria-hidden="true">&rarr;</span>
                </a>
              ))}
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .um-intent-link-graph {
    padding: clamp(4rem, 8vw, 7rem) 0;
    background:
      linear-gradient(180deg, rgba(248, 249, 250, 0.96), #ffffff 62%),
      #ffffff;
  }

  .um-intent-link-graph__inner {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
  }

  .um-intent-link-graph__header {
    max-width: 760px;
    margin-bottom: clamp(2rem, 5vw, 3.25rem);
  }

  .um-intent-link-graph__kicker,
  .um-intent-link-graph__eyebrow {
    margin: 0;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #dc2626;
  }

  .um-intent-link-graph h2,
  .um-intent-link-graph h3,
  .um-intent-link-graph p {
    margin: 0;
  }

  .um-intent-link-graph h2 {
    margin-top: 0.7rem;
    font-size: clamp(2rem, 4vw, 3.6rem);
    line-height: 0.98;
    font-weight: 600;
    color: #111827;
  }

  .um-intent-link-graph__header > p:last-child {
    margin-top: 1rem;
    font-size: 1.06rem;
    line-height: 1.7;
    color: #4b5563;
  }

  .um-intent-link-graph__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1px;
    background: #d1d5db;
    border: 1px solid #d1d5db;
  }

  .um-intent-link-graph__group {
    min-width: 0;
    background: #ffffff;
  }

  .um-intent-link-graph__group-header {
    padding: 1.25rem;
    min-height: 156px;
    border-bottom: 1px solid #e5e7eb;
  }

  .um-intent-link-graph__group-header h3 {
    font-size: 1rem;
    line-height: 1.25;
    font-weight: 600;
    color: #111827;
  }

  .um-intent-link-graph__group-header p {
    margin-top: 0.65rem;
    font-size: 1rem;
    line-height: 1.55;
    color: #6b7280;
  }

  .um-intent-link-graph__items {
    display: grid;
  }

  .um-intent-link-graph__item {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    min-height: 132px;
    padding: 1.15rem 1.25rem;
    color: inherit;
    text-decoration: none;
    border-bottom: 1px solid #e5e7eb;
    background: #ffffff;
    transition:
      background-color 180ms ease,
      box-shadow 180ms ease,
      color 180ms ease;
  }

  .um-intent-link-graph__item::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: #dc2626;
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 180ms ease;
  }

  .um-intent-link-graph__item:hover,
  .um-intent-link-graph__item:focus-visible {
    background: #f9fafb;
    color: #111827;
    box-shadow: inset 0 0 0 1px rgba(220, 38, 38, 0.18);
  }

  .um-intent-link-graph__item:hover::before,
  .um-intent-link-graph__item:focus-visible::before {
    transform: scaleY(1);
  }

  .um-intent-link-graph__item:focus-visible {
    outline: 3px solid rgba(220, 38, 38, 0.28);
    outline-offset: -3px;
  }

  .um-intent-link-graph__copy {
    display: grid;
    gap: 0.45rem;
    min-width: 0;
  }

  .um-intent-link-graph__copy strong {
    font-size: 1rem;
    line-height: 1.25;
    font-weight: 600;
    color: #111827;
  }

  .um-intent-link-graph__copy span:last-child {
    font-size: 1rem;
    line-height: 1.5;
    color: #6b7280;
  }

  .um-intent-link-graph__arrow {
    align-self: start;
    color: #9ca3af;
    font-weight: 700;
    transform: translateX(0);
    transition:
      color 180ms ease,
      transform 180ms ease;
  }

  .um-intent-link-graph__item:hover .um-intent-link-graph__arrow,
  .um-intent-link-graph__item:focus-visible .um-intent-link-graph__arrow {
    color: #dc2626;
    transform: translateX(4px);
  }

  .um-intent-link-graph__media {
    display: block;
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: #f3f4f6;
  }

  .um-intent-link-graph__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 1100px) {
    .um-intent-link-graph__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .um-intent-link-graph {
      padding: 3.5rem 0;
    }

    .um-intent-link-graph__inner {
      width: min(100% - 24px, 1180px);
    }

    .um-intent-link-graph__grid {
      grid-template-columns: 1fr;
    }

    .um-intent-link-graph__group-header,
    .um-intent-link-graph__item {
      min-height: auto;
      padding: 1.05rem;
    }
  }
</style>
