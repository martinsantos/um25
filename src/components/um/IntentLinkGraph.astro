---
import type { StrategicLinkGroup } from '../../data/strategicLinkGraph';

interface Props {
  kicker?: string;
  title: string;
  text: string;
  groups: StrategicLinkGroup[];
  class?: string;
}

const {
  kicker = 'Siguiente paso',
  title,
  text,
  groups,
  class: className = '',
} = Astro.props;

type LinkItem = StrategicLinkGroup['items'][number] & { sourceTitle: string };

const visibleGroups = groups.filter((group) => group.items.length > 0);
const primaryItems = visibleGroups.map((group) => ({ ...group.items[0], sourceTitle: group.title }));
const supplementalItems = visibleGroups.flatMap((group) =>
  group.items.slice(1).map((item) => ({ ...item, sourceTitle: group.title })),
);
const seen = new Set<string>();
const recommendedItems = [...primaryItems, ...supplementalItems]
  .filter((item) => {
    if (!item?.href || seen.has(item.href)) return false;
    seen.add(item.href);
    return true;
  })
  .slice(0, 4) as LinkItem[];

const sectionId = `intent-link-graph-${title
  .toLowerCase()
  .normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '')
  .replace(/[^a-z0-9]+/g, '-')
  .replace(/^-|-$/g, '')}`;

const categoryLabel = (value: string) => {
  const textValue = value.toLowerCase();
  if (/comercial|presupuesto|compra|cobertura|geo|ruta/.test(textValue)) return 'Presupuesto';
  if (/servicio|capacidad/.test(textValue)) return 'Servicio';
  if (/sector|vertical/.test(textValue)) return 'Sector';
  if (/evidencia|caso|antecedente/.test(textValue)) return 'Evidencia';
  if (/lectura|blog|nota/.test(textValue)) return 'Lectura';
  if (/siguiente|accion|acción|contacto/.test(textValue)) return 'Contacto';
  return value;
};

const actionLabel = (href: string) => {
  if (href.includes('/contacto')) return 'Contactar';
  if (href.includes('/antecedentes')) return 'Ver casos';
  if (href.includes('/servicios')) return 'Ver servicio';
  if (href.includes('/blog')) return 'Leer';
  return 'Ver detalle';
};
---

{recommendedItems.length > 0 && (
  <section class:list={['um-intent-link-graph', className]} aria-labelledby={sectionId}>
    <div class="um-intent-link-graph__inner">
      <div class="um-intent-link-graph__header">
        <p class="um-intent-link-graph__kicker">{kicker}</p>
        <h2 id={sectionId}>{title}</h2>
        <p>{text}</p>
      </div>

      <nav class="um-intent-link-graph__list" aria-label="Siguientes pasos recomendados">
        {recommendedItems.map((item) => (
          <a
            class={`um-click-surface um-intent-link-graph__item um-intent-link-graph__item--${item.kind || 'core'}`}
            href={item.href}
            aria-label={`${item.label}. ${item.summary}`}
          >
            <span class="um-intent-link-graph__eyebrow">{categoryLabel(item.sourceTitle)}</span>
            <strong>{item.label}</strong>
            <span>{item.summary}</span>
            <em class="um-click-action">
              {actionLabel(item.href)}
              <span aria-hidden="true">-&gt;</span>
            </em>
          </a>
        ))}
      </nav>
    </div>
  </section>
)}

<style>
  .um-intent-link-graph {
    padding: clamp(1.65rem, 3.4vw, 3rem) 0;
    background: linear-gradient(180deg, #ffffff 0%, #f7f8f9 100%);
    border-top: 1px solid #eceff2;
    border-bottom: 1px solid #eceff2;
    scroll-margin-top: 96px;
  }

  .um-intent-link-graph__inner {
    width: min(1180px, calc(100% - 32px));
    margin: 0 auto;
  }

  .um-intent-link-graph__header {
    display: grid;
    grid-template-columns: minmax(260px, 0.4fr) minmax(0, 0.6fr);
    grid-template-areas:
      "kicker text"
      "title text";
    gap: 0.75rem clamp(1.5rem, 4vw, 4.5rem);
    align-items: end;
    margin-bottom: clamp(1.15rem, 2.6vw, 2rem);
  }

  .um-intent-link-graph__kicker,
  .um-intent-link-graph__eyebrow {
    margin: 0;
    color: #dc2626;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .um-intent-link-graph__kicker {
    grid-area: kicker;
  }

  .um-intent-link-graph h2,
  .um-intent-link-graph p {
    margin: 0;
  }

  .um-intent-link-graph h2 {
    grid-area: title;
    margin-top: 0.75rem;
    color: #111827;
    font-size: clamp(1.75rem, 2.6vw, 2.65rem);
    line-height: 1.16;
    font-weight: 600;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .um-intent-link-graph__header > p:last-child {
    grid-area: text;
    max-width: 720px;
    color: #4b5563;
    font-size: 1.06rem;
    line-height: 1.58;
    align-self: end;
  }

  .um-intent-link-graph__list {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: clamp(0.85rem, 1.4vw, 1.15rem);
    background: transparent;
    border: 0;
  }

  .um-intent-link-graph__item {
    display: grid;
    align-content: start;
    min-height: 178px;
    border: 1px solid #e1e4e8;
    border-radius: 6px;
    padding: clamp(1rem, 1.6vw, 1.28rem);
    background: #ffffff;
    color: inherit;
    text-decoration: none;
    box-shadow: none;
    transition:
      background-color 180ms ease,
      border-color 180ms ease;
  }

  .um-intent-link-graph__item strong {
    margin-top: 0.7rem;
    color: #111827;
    font-family: var(--um-font-display);
    font-size: clamp(1.04rem, 1.16vw, 1.18rem);
    line-height: 1.18;
    font-weight: 600;
    text-wrap: balance;
  }

  .um-intent-link-graph__item > span:not(.um-intent-link-graph__eyebrow) {
    margin-top: 0.7rem;
    color: #5f6670;
    font-size: 1rem;
    line-height: 1.5;
  }

  .um-intent-link-graph__item em {
    align-self: end;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    width: fit-content;
    margin-top: 1.15rem;
    color: #111827;
    font-size: 1rem;
    font-style: normal;
    font-weight: 700;
    line-height: 1.2;
  }

  .um-intent-link-graph__item em span {
    display: inline-block;
    transition: transform 180ms ease;
  }

  .um-intent-link-graph__item:hover,
  .um-intent-link-graph__item:focus-visible {
    background: color-mix(in srgb, #ffffff 92%, var(--um-red, #dc2626) 8%);
    border-color: color-mix(in srgb, var(--um-red, #dc2626) 42%, #e1e4e8);
  }

  .um-intent-link-graph__item:hover em span,
  .um-intent-link-graph__item:focus-visible em span {
    transform: translateX(4px);
  }

  .um-intent-link-graph--contained {
    padding: clamp(2.25rem, 4vw, 3.25rem) 0;
    border: 0;
    background: transparent;
  }

  .um-intent-link-graph--contained .um-intent-link-graph__inner {
    width: 100%;
  }

  .um-intent-link-graph--contained .um-intent-link-graph__header {
    grid-template-areas:
      "kicker"
      "title"
      "text";
    grid-template-columns: 1fr;
    gap: 0.75rem;
    margin-bottom: 1.25rem;
  }

  .um-intent-link-graph--contained .um-intent-link-graph__header h2 {
    font-size: clamp(1.45rem, 2.1vw, 1.9rem);
  }

  .um-intent-link-graph--contained .um-intent-link-graph__list {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .um-intent-link-graph--contained .um-intent-link-graph__item {
    min-height: 156px;
  }

  @media (max-width: 980px) {
    .um-intent-link-graph__list {
      grid-template-columns: 1fr 1fr;
    }

    .um-intent-link-graph__header {
      grid-template-columns: 1fr;
      grid-template-areas:
        "kicker"
        "title"
        "text";
    }
  }

  @media (max-width: 640px) {
    .um-intent-link-graph {
      padding: 2.25rem 0;
    }

    .um-intent-link-graph__inner {
      width: min(100% - 24px, 1180px);
    }

    .um-intent-link-graph__header,
    .um-intent-link-graph__list,
    .um-intent-link-graph--contained .um-intent-link-graph__list {
      grid-template-columns: 1fr;
    }

    .um-intent-link-graph__item {
      min-height: auto;
    }
  }
</style>
