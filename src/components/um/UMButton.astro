---
interface Props {
  href: string;
  variant?: 'primary' | 'secondary';
  class?: string;
}

const { href, variant = 'primary', class: className } = Astro.props;
const variantClass = variant === 'secondary' ? 'um-btn-secondary' : 'um-btn-primary';
---

<a class:list={[variantClass, className]} href={href}>
  <slot />
</a>
