<script>
  import { contactLink, isContactPage } from '../../lib/contactEntry';
  import { collegeAttribution } from '../../lib/collegeAttribution';
  function prepare(link: HTMLAnchorElement, withLabel = false) {
    const href = link.getAttribute('href')?.trim();
    if (!href || href.startsWith('#') || href.startsWith('?')) return;
    const url = link;
    if (url.origin !== location.origin || !isContactPage(url.pathname)) return;
    if (isContactPage(location.pathname)) {
      if (url.pathname === location.pathname && !url.search) link.href = '#formulario';
      return;
    }
    const target = new URL(contactLink(location.pathname, url.pathname + url.search), location.href);
    if (location.pathname.replace(/\/$/, '') === '/software/gestion-de-comunidades-profesionales') {
      for (const [key, value] of Object.entries(collegeAttribution(new URLSearchParams(location.search)))) target.searchParams.set(key, value);
    }
    if (withLabel) {
      const title = document.querySelector('h1')?.textContent?.trim();
      const label = (link.getAttribute('aria-label') || link.textContent || '').trim();
      if (title) target.searchParams.set('tituloOrigen', title.slice(0, 160));
      if (label) target.searchParams.set('accion', label.slice(0, 100));
    }
    link.href = target.href;
  }
  document.querySelectorAll<HTMLAnchorElement>('a[href]').forEach(link => prepare(link));

  // Keep the global navigation in step with an explicitly opened system or winery zone.
  const destinations = [...document.querySelectorAll<HTMLAnchorElement>('a[data-contact-follow]')]
    .filter(link => link.pathname === '/contacto' && !isContactPage(location.pathname))
    .map(link => ({ link, base: link.href }));
  function syncContact() {
    const fragment = document.getElementById(location.hash.slice(1));
    const picker = fragment?.closest('[data-system-picker]') || fragment?.querySelector('[data-system-picker]');
    const system = picker?.querySelector('.systems > details[open]:not([hidden])')
      || fragment?.closest('[data-system-picker] .systems > details');
    const home = fragment?.closest('[data-home-service-picker]') || fragment?.querySelector('[data-home-service-picker]');
    const service = home?.querySelector<HTMLInputElement>('input[name="frente-portada"]:checked')?.value;
    const zone = document.querySelector<HTMLElement>('.winery [data-zone-panel]:not([hidden])');
    const requestedZone = new URLSearchParams(location.search).get('zona');
    const inWinery = fragment?.closest('.winery') || requestedZone === zone?.dataset.zonePanel;
    const panel = system || (inWinery ? zone : null);
    const action = panel?.querySelector<HTMLAnchorElement>('a[data-contact-question]');
    for (const { link, base } of destinations) {
      if (action) {
        const target = new URL(action.href);
        const intent = new URL(base).searchParams.get('intent');
        if (intent && !target.searchParams.has('intent')) target.searchParams.set('intent', intent);
        link.href = target.href;
      } else if (service && /^10[1-8]$/.test(service)) {
        const target = new URL(base);
        target.searchParams.set('sistema', service);
        target.searchParams.set('desde', 'inicio-servicios');
        link.href = target.href;
      } else if (system?.closest('[data-provision]')) {
        const general = new URL(base);
        general.searchParams.delete('grupo');
        general.searchParams.delete('antecedente');
        link.href = general.href;
      } else link.href = base;
    }
  }
  if (destinations.length) {
    syncContact();
    window.addEventListener('hashchange', syncContact);
    window.addEventListener('pageshow', syncContact);
    window.addEventListener('umsa:zone-selected', syncContact);
    window.addEventListener('umsa:system-selected', syncContact);
    window.addEventListener('umsa:home-service-selected', syncContact);
  }
  document.addEventListener('click', event => {
    const link = event.target instanceof Element && event.target.closest<HTMLAnchorElement>('a[href]');
    if (!link) return;
    if (link.hasAttribute('data-contact-follow')) syncContact();
    prepare(link, true);
  }, true);
  function legacyEntry(intent?: string) {
    if (isContactPage(location.pathname)) {
      document.getElementById('formulario')?.scrollIntoView();
      return;
    }
    const url = new URL(contactLink(location.pathname), location.href);
    if (intent) url.searchParams.set('intent', intent);
    location.assign(url.href);
  }
  window.addEventListener('umsa:contact:open', event => legacyEntry((event as CustomEvent).detail?.intent));
  const params = new URLSearchParams(location.search);
  if (params.get('contact') === '1') legacyEntry(params.get('intent') || undefined);
</script>
