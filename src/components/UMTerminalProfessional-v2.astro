---
// UMTerminalProfessional-v2.astro - Terminal profesional v2.0 con diseño móvil perfecto
---

<div id="um-terminal-container-v2" class="terminal-container-v2">
  <div id="um-terminal-v2" class="um-terminal-professional-v2">
    <!-- Terminal Header -->
    <div class="terminal-header-v2">
      <div class="terminal-controls-v2">
        <div class="control-v2 close-v2"></div>
        <div class="control-v2 minimize-v2"></div>
        <div class="control-v2 maximize-v2"></div>
      </div>
      <div class="terminal-title-v2">ULTIMA MILLA CLI v2.0 Enhanced - Mendoza, Argentina</div>
      <div class="terminal-status-v2">
        <div class="status-indicator-v2 online" id="connection-status-v2" title="Estado: Conectado v2.0"></div>
      </div>
    </div>
    
    <!-- Terminal Body -->
    <div class="terminal-body-v2" id="terminal-output-v2">
      <div class="welcome-message-v2">
        <pre id="welcome-ascii-v2" class="ascii-art-v2"></pre>
        <div class="welcome-info-v2">
          <div class="welcome-line-v2 typing-effect" data-delay="0">
            <span class="icon">🚀</span> Bienvenido a <strong>ULTIMA MILLA CLI v2.0</strong> - Terminal interactivo empresarial
          </div>
          <div class="welcome-line-v2 typing-effect" data-delay="600">
            <span class="icon">📊</span> Explora <strong>22 años</strong> de historia, <strong>469+ proyectos</strong> y <strong>150+ clientes</strong>
          </div>
          <div class="welcome-line-v2 typing-effect" data-delay="1200">
            <span class="icon">💡</span> Escribe <span class="command-highlight">help</span> para ver comandos disponibles
          </div>
          <div class="welcome-line-v2 typing-effect" data-delay="1800">
            <span class="icon">⚡</span> Prueba <span class="command-highlight">antecedentes</span> para datos reales de Directus
          </div>
          <div class="welcome-line-v2 typing-effect" data-delay="2400">
            <span class="icon">🔍</span> Usa <span class="command-highlight">grep "redes"</span> para búsquedas específicas
          </div>
          <div class="welcome-line-v2 typing-effect" data-delay="3000">
            <span class="icon">📞</span> Comando <span class="command-highlight">contacto</span> para enviar mensajes reales
          </div>
        </div>
      </div>
      
    </div>
    
    <!-- Command Input -->
    <div class="terminal-input-container-v2">
      <div class="prompt-v2">
        <span class="user">visitante</span><span class="at">@</span><span class="host">ultimamilla</span><span class="path">:~$</span>
      </div>
      <input 
        type="text" 
        id="terminal-input-v2" 
        class="terminal-input-v2" 
        placeholder="Escribe un comando..."
        autocomplete="off"
        spellcheck="false"
      />
    </div>
  </div>
</div>

<style>
/* =================================
   UM TERMINAL v2.0 - DISEÑO MÓVIL PERFECTO
   ================================= */

.terminal-container-v2 {
  position: relative;
  width: 100%;
  max-width: 100%;
  margin: 0;
  padding: 0;
  box-sizing: border-box;
}

.um-terminal-professional-v2 {
  background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f1419 100%);
  border-radius: 12px;
  box-shadow: 
    0 20px 40px rgba(0, 0, 0, 0.4),
    0 8px 16px rgba(0, 0, 0, 0.2),
    inset 0 1px 0 rgba(255, 255, 255, 0.1);
  font-family: 'Fira Code', 'Monaco', 'Consolas', monospace;
  font-size: 14px;
  line-height: 1.4;
  color: #e6e6e6;
  width: 100%;
  min-height: 400px;
  position: relative;
  overflow: hidden;
  border: none;
}

/* Terminal Header */
.terminal-header-v2 {
  background: linear-gradient(135deg, #2d2d44 0%, #1e1e2e 100%);
  padding: 12px 16px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  position: relative;
}

.terminal-controls-v2 {
  display: flex;
  gap: 8px;
}

.control-v2 {
  width: 12px;
  height: 12px;
  border-radius: 50%;
  cursor: pointer;
  transition: all 0.2s ease;
}

.close-v2 {
  background: linear-gradient(135deg, #ff5f57 0%, #ff3b30 100%);
}

.minimize-v2 {
  background: linear-gradient(135deg, #ffbd2e 0%, #ff9500 100%);
}

.maximize-v2 {
  background: linear-gradient(135deg, #28ca42 0%, #30d158 100%);
}

.control-v2:hover {
  transform: scale(1.1);
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
}

.terminal-title-v2 {
  font-size: 13px;
  font-weight: 600;
  color: #8892b0;
  text-align: center;
  flex: 1;
  text-shadow: 0 1px 2px rgba(0, 0, 0, 0.5);
}

.terminal-status-v2 {
  display: flex;
  align-items: center;
}

.status-indicator-v2 {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #28ca42;
  box-shadow: 0 0 8px rgba(40, 202, 66, 0.6);
  animation: pulse-v2 2s infinite;
}

@keyframes pulse-v2 {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.6; }
}

/* Terminal Body */
.terminal-body-v2 {
  padding: 20px;
  max-height: 400px;
  overflow-y: auto;
  background: rgba(0, 0, 0, 0.2);
  position: relative;
}

.terminal-body-v2::-webkit-scrollbar {
  width: 6px;
}

.terminal-body-v2::-webkit-scrollbar-track {
  background: rgba(255, 255, 255, 0.05);
  border-radius: 3px;
}

.terminal-body-v2::-webkit-scrollbar-thumb {
  background: rgba(255, 255, 255, 0.2);
  border-radius: 3px;
}

.welcome-message-v2 {
  margin-bottom: 20px;
}

.ascii-art-v2 {
  color: #64ffda;
  font-size: 12px;
  line-height: 1.2;
  margin-bottom: 15px;
  text-shadow: 0 0 10px rgba(100, 255, 218, 0.3);
  font-weight: bold;
}

.welcome-info-v2 {
  margin-bottom: 15px;
}

.welcome-line-v2 {
  margin: 8px 0;
  display: flex;
  align-items: center;
  gap: 8px;
  opacity: 1;
  animation: none;
}

.welcome-line-v2 .icon {
  font-size: 16px;
  min-width: 20px;
}

.command-highlight {
  background: rgba(100, 255, 218, 0.1);
  color: #64ffda;
  padding: 2px 6px;
  border-radius: 4px;
  font-weight: 600;
  border: 1px solid rgba(100, 255, 218, 0.2);
}

@keyframes fadeInUp-v2 {
  from {
    opacity: 0;
    transform: translateY(10px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

/* Loading Animation */
.loading-message-v2 {
  display: flex;
  align-items: center;
  gap: 12px;
  margin: 15px 0;
  color: #64ffda;
  opacity: 0;
  animation: fadeIn-v2 0.5s ease forwards 3.5s;
}

.loading-icon {
  font-size: 18px;
  animation: spin-v2 1s linear infinite;
}

@keyframes spin-v2 {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

.loading-bar {
  flex: 1;
  height: 4px;
  background: rgba(255, 255, 255, 0.1);
  border-radius: 2px;
  overflow: hidden;
}

.loading-progress {
  height: 100%;
  background: linear-gradient(90deg, #64ffda, #50fa7b);
  border-radius: 2px;
  width: 0%;
  animation: progress-v2 2s ease-in-out forwards;
}

@keyframes progress-v2 {
  to { width: 100%; }
}

@keyframes fadeIn-v2 {
  to { opacity: 1; }
}

/* Terminal Input */
.terminal-input-container-v2 {
  padding: 16px 20px;
  background: rgba(0, 0, 0, 0.3);
  border-top: 1px solid rgba(255, 255, 255, 0.1);
  display: flex;
  align-items: center;
  gap: 8px;
}

.prompt-v2 {
  color: #64ffda;
  font-weight: 600;
  white-space: nowrap;
  font-size: 14px;
}

.prompt-v2 .user {
  color: #50fa7b;
}

.prompt-v2 .at {
  color: #8892b0;
}

.prompt-v2 .host {
  color: #64ffda;
}

.prompt-v2 .path {
  color: #ffb86c;
}

.terminal-input-v2 {
  flex: 1;
  background: transparent;
  border: none;
  color: #e6e6e6;
  font-family: inherit;
  font-size: 14px;
  outline: none;
  padding: 0;
}

.terminal-input-v2::placeholder {
  color: #8892b0;
  font-style: italic;
}

/* =================================
   CRITICAL MOBILE FIXES - INLINE
   ================================= */

/* Force mobile container */
.um-cli-main-container {
  width: 100% !important;
  max-width: 100vw !important;
  margin: 0 !important;
  padding: 8px !important;
  box-sizing: border-box !important;
  overflow-x: hidden !important;
}

.hero-terminal-section {
  padding: 20px 0 !important;
  background: linear-gradient(135deg, #0a0a0a 0%, #1a1a2e 50%, #16213e 100%) !important;
  min-height: 100vh !important;
  display: flex !important;
  align-items: center !important;
  justify-content: center !important;
}

.hero-container {
  width: 100% !important;
  max-width: 1200px !important;
  margin: 0 auto !important;
  padding: 0 20px !important;
  box-sizing: border-box !important;
}

/* =================================
   RESPONSIVE DESIGN - MÓVIL PERFECTO
   ================================= */

@media (max-width: 768px) {
  .um-cli-main-container {
    padding: 5px !important;
  }
  
  .hero-terminal-section {
    padding: 10px 0 !important;
    min-height: 90vh !important;
  }
  
  .hero-container {
    padding: 0 10px !important;
  }
  
  .terminal-container-v2 {
    margin: 0 !important;
    padding: 4px !important;
    box-sizing: border-box !important;
  }
  
  .um-terminal-professional-v2 {
    border-radius: 8px;
    min-height: 350px;
    font-size: 13px;
  }
  
  .terminal-header-v2 {
    padding: 10px 12px;
  }
  
  .terminal-title-v2 {
    font-size: 11px;
    display: none; /* Ocultar en móvil para ahorrar espacio */
  }
  
  .terminal-body-v2 {
    padding: 12px;
    max-height: 300px;
  }
  
  .ascii-art-v2 {
    font-size: 10px;
  }
  
  .welcome-line-v2 {
    margin: 6px 0;
    font-size: 13px;
  }
  
  .welcome-line-v2 .icon {
    font-size: 14px;
    min-width: 18px;
  }
  
  .terminal-input-container-v2 {
    padding: 12px;
  }
  
  .prompt-v2 {
    font-size: 13px;
  }
  
  .terminal-input-v2 {
    font-size: 13px;
  }
}

@media (max-width: 480px) {
  .terminal-container-v2 {
    padding: 4px;
  }
  
  .um-terminal-professional-v2 {
    border-radius: 6px;
    min-height: 320px;
    font-size: 12px;
  }
  
  .terminal-header-v2 {
    padding: 8px 10px;
  }
  
  .control-v2 {
    width: 10px;
    height: 10px;
  }
  
  .terminal-body-v2 {
    padding: 10px;
    max-height: 280px;
  }
  
  .ascii-art-v2 {
    font-size: 9px;
    line-height: 1.1;
  }
  
  .welcome-line-v2 {
    margin: 4px 0;
    font-size: 12px;
    gap: 6px;
  }
  
  .welcome-line-v2 .icon {
    font-size: 13px;
    min-width: 16px;
  }
  
  .command-highlight {
    padding: 1px 4px;
    font-size: 11px;
    border-radius: 3px;
  }
  
  .terminal-input-container-v2 {
    padding: 10px;
    gap: 6px;
  }
  
  .prompt-v2 {
    font-size: 12px;
  }
  
  .terminal-input-v2 {
    font-size: 12px;
  }
}

/* =================================
   LANDSCAPE MOBILE OPTIMIZATION
   ================================= */

@media (max-width: 900px) and (orientation: landscape) {
  .um-terminal-professional-v2 {
    min-height: 280px;
  }
  
  .terminal-body-v2 {
    max-height: 200px;
    padding: 8px 12px;
  }
  
  .welcome-line-v2 {
    margin: 3px 0;
  }
  
  .ascii-art-v2 {
    margin-bottom: 8px;
  }
}

/* =================================
   DARK MODE IMPROVEMENTS
   ================================= */

@media (prefers-color-scheme: dark) {
  .um-terminal-professional-v2 {
    background: linear-gradient(135deg, #0d1117 0%, #161b22 50%, #21262d 100%);
    border-color: rgba(240, 246, 252, 0.1);
  }
  
  .terminal-header-v2 {
    background: linear-gradient(135deg, #21262d 0%, #161b22 100%);
  }
  
  .terminal-body-v2 {
    background: rgba(0, 0, 0, 0.4);
  }
}

/* =================================
   ACCESSIBILITY IMPROVEMENTS
   ================================= */

@media (prefers-reduced-motion: reduce) {
  .welcome-line-v2,
  .loading-message-v2,
  .loading-progress,
  .loading-icon,
  .status-indicator-v2 {
    animation: none !important;
  }
  
  .welcome-line-v2 {
    opacity: 1;
    transform: none;
  }
  
  .control-v2:hover {
    transform: none;
  }
}

/* =================================
   HIGH CONTRAST MODE
   ================================= */

@media (prefers-contrast: high) {
  .um-terminal-professional-v2 {
    border: 2px solid #ffffff;
    background: #000000;
  }
  
  .terminal-header-v2 {
    background: #1a1a1a;
    border-bottom: 2px solid #ffffff;
  }
  
  .command-highlight {
    background: #ffffff;
    color: #000000;
    border: 1px solid #ffffff;
  }
}
</style>

<script is:inline>
// UMTerminalEngine v2.0 Integration
document.addEventListener('DOMContentLoaded', function() {
  // ASCII Art para v2.0
  const asciiArt = `
██╗   ██╗██╗  ████████╗██╗███╗   ███╗ █████╗     ███╗   ███╗██╗██╗     ██╗      █████╗ 
██║   ██║██║  ╚══██╔══╝██║████╗ ████║██╔══██╗    ████╗ ████║██║██║     ██║     ██╔══██╗
██║   ██║██║     ██║   ██║██╔████╔██║███████║    ██╔████╔██║██║██║     ██║     ███████║
██║   ██║██║     ██║   ██║██║╚██╔╝██║██╔══██║    ██║╚██╔╝██║██║██║     ██║     ██╔══██║
╚██████╔╝███████╗██║   ██║██║ ╚═╝ ██║██║  ██║    ██║ ╚═╝ ██║██║███████╗███████╗██║  ██║
 ╚═════╝ ╚══════╝╚═╝   ╚═╝╚═╝     ╚═╝╚═╝  ╚═╝    ╚═╝     ╚═╝╚═╝╚══════╝╚══════╝╚═╝  ╚═╝
                                                                                        
                             v2.0 Enhanced Terminal Experience`;

  const welcomeAscii = document.getElementById('welcome-ascii-v2');
  if (welcomeAscii) {
    welcomeAscii.textContent = asciiArt;
  }

  // Enfocar input después de que se cargue
  setTimeout(() => {
    const terminalInput = document.getElementById('terminal-input-v2');
    if (terminalInput) {
      terminalInput.focus();
    }
  }, 1000);

  // Sync with mobile version via sessionStorage
  function syncWithMobile() {
    try {
      const mobileHistory = JSON.parse(sessionStorage.getItem('umcli_history') || '[]');
      if (mobileHistory.length > 0) {
        const outputArea = document.getElementById('terminal-output-v2');
        if (outputArea) {
          // Add indicator that session was restored
          const syncDiv = document.createElement('div');
          syncDiv.innerHTML = '<div style="color: #50fa7b; margin: 10px 0;">📱 Sesión sincronizada desde móvil (' + mobileHistory.length + ' comandos previos)</div>';
          outputArea.appendChild(syncDiv);
        }
      }
    } catch(e) {
      console.log('No mobile session to sync');
    }
  }
  
  // Event listeners para input con consistencia
  const terminalInput = document.getElementById('terminal-input-v2');
  if (terminalInput) {
    // Load any previous mobile session
    syncWithMobile();
    
    terminalInput.addEventListener('keydown', function(e) {
      if (e.key === 'Enter') {
        const command = this.value.trim();
        if (command) {
          // Store in sessionStorage for mobile consistency
          try {
            let commandHistory = JSON.parse(sessionStorage.getItem('umcli_history') || '[]');
            commandHistory.push({
              command: command,
              timestamp: Date.now(),
              device: 'desktop'
            });
            if (commandHistory.length > 50) {
              commandHistory = commandHistory.slice(-50);
            }
            sessionStorage.setItem('umcli_history', JSON.stringify(commandHistory));
          } catch(e) {
            console.log('SessionStorage not available');
          }
          
          // Add command to output visually
          const outputArea = document.getElementById('terminal-output-v2');
          if (outputArea) {
            const commandDiv = document.createElement('div');
            commandDiv.innerHTML = '<div style="color: #64ffda; margin: 5px 0;">umcli% ' + command + '</div>';
            outputArea.appendChild(commandDiv);
            
            // Add response (basic for now)
            const responseDiv = document.createElement('div');
            if (command.toLowerCase() === 'help') {
              responseDiv.innerHTML = `
                <div style="color: #e6e6e6; margin: 10px 0;">
                  🚀 <strong style="color: #64ffda;">UM-CLI v2.0 - Comandos disponibles:</strong><br/>
                  📊 <strong>DATOS REALES:</strong><br/>
                  • <span style="color: #64ffda;">antecedentes</span> - Ver casos de éxito reales<br/>
                  • <span style="color: #64ffda;">stats</span> - Estadísticas de la empresa<br/>
                  • <span style="color: #64ffda;">servicios</span> - Lista de servicios ofrecidos<br/>
                  • <span style="color: #64ffda;">proyectos</span> - Proyectos destacados<br/>
                  💡 Cambia a versión móvil para funcionalidad completa
                </div>
              `;
            } else {
              responseDiv.innerHTML = '<div style="color: #ffb86c; margin: 5px 0;">🔄 Comando procesado - cambia a versión móvil para funcionalidad completa</div>';
            }
            outputArea.appendChild(responseDiv);
            
            // Scroll to bottom
            outputArea.scrollTop = outputArea.scrollHeight;
          }
          
          this.value = '';
        }
      }
    });
  }
});
</script>
