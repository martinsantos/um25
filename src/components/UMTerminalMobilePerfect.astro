    // IMMEDIATE FIX: Apply styles right after adding to DOM
    setTimeout(() => {
      // Fix only problematic white background elements
      const problematicElements = line.querySelectorAll('span:not([style*="color"]), div:not([class*="command"])');
      problematicElements.forEach(el => {
        if (!el.style.color && el.tagName !== 'CODE' && el.tagName !== 'STRONG') {
          el.style.background = 'transparent';
          el.style.backgroundColor = 'transparent';
          // Only force text color if it's problematic
          const computedStyle = window.getComputedStyle(el);
          if (computedStyle.backgroundColor !== 'rgba(0, 0, 0, 0)' && computedStyle.backgroundColor !== 'transparent') {
            el.style.color = '#e6e6e6';
            el.style.webkitTextFillColor = '#e6e6e6';
          }
        }
      });
      
      // Scroll to bottom
      outputArea.scrollTop = outputArea.scrollHeight;
      const terminalBody = document.querySelector('.mobile-terminal-body');
      if (terminalBody) {
        terminalBody.scrollTop = terminalBody.scrollHeight;
      }
    }, 5);
  }
  
