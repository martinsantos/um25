---
interface Heading {
  level: number;
  id: string;
  text: string;
}
interface Props {
  headings: Heading[];
  title?: string;
}
const { headings, title } = Astro.props;
---

{headings.length > 0 && (
  <nav
    class="toc"
    x-data="{ active: '' }"
    x-init="
      const els = document.querySelectorAll('h2[id], h3[id]');
      const obs = new IntersectionObserver(entries => {
        entries.forEach(e => { if (e.isIntersecting) active = e.target.id; });
      }, { rootMargin: '-10% 0px -65% 0px' });
      els.forEach(el => obs.observe(el));
    "
    aria-label="Tabla de contenidos"
  >
    <p class="toc__label">Índice</p>
    <ul class="toc__list">
      {title && (
        <li class="toc__item">
          <a
            href="#"
            class="toc__link toc__link--title"
            :class={`active === '' ? 'toc__link--active' : ''`}
            onclick="window.scrollTo({top:0,behavior:'smooth'});return false;"
          >
            {title}
          </a>
        </li>
      )}
      {headings.map(h => (
        <li class={h.level === 3 ? 'toc__item toc__item--sub' : 'toc__item'}>
          <a
            href={`#${h.id}`}
            class="toc__link"
            :class={`active === '${h.id}' ? 'toc__link--active' : ''`}
          >
            {h.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .toc {
    display: none;
    position: sticky;
    top: 6rem;
    width: min(100%, 236px);
    max-height: calc(100svh - 7rem);
    flex-shrink: 0;
    align-self: flex-start;
    padding: 4px 0 8px 0;
    background: transparent;
    overflow-y: auto;
    scrollbar-width: thin;
  }
  @media (min-width: 900px) { .toc { display: block; } }

  .toc__label {
    font-family: var(--um-font-body);
    font-size: 16px;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0;
    color: #6b7280;
    margin: 0 0 12px;
  }

  .toc__list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid rgba(17, 17, 17, 0.08);
  }

  .toc__item {
    margin-bottom: 0;
  }

  .toc__item--sub {
    padding-left: 8px;
  }

  .toc__link {
    display: block;
    font-family: var(--um-font-body);
    font-size: 16px;
    line-height: 1.38;
    padding: 8px 4px 8px 0;
    color: #717986;
    text-decoration: none;
    transition: color .15s, transform .15s;
    overflow-wrap: anywhere;
  }
  .toc__link:hover {
    color: #111827;
    transform: none;
  }
  .toc__link--active {
    color: #111827;
    font-weight: 600;
  }

  /* Title item is slightly bolder */
  .toc__link--title {
    font-size: 16px;
    font-weight: 500;
    color: #4b5563;
    padding-bottom: 8px;
    margin-bottom: 2px;
  }
  .toc__link--title.toc__link--active {
    color: #111827;
    font-weight: 700;
  }

  .toc__item:has(.toc__link--active) {
    position: relative;
  }

  .toc__item:has(.toc__link--active)::before {
    content: "";
    position: absolute;
    left: -8px;
    top: 11px;
    bottom: 11px;
    width: 2px;
    background: #DC2626;
  }
</style>
