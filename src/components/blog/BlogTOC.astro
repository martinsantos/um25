---
/**
 * Índice del artículo: lista de h2/h3 con resaltado de la sección visible.
 * Sin dependencias: IntersectionObserver en un script propio.
 */
interface Heading {
  level: number;
  id: string;
  text: string;
}
interface Props {
  headings: Heading[];
}
const { headings } = Astro.props;
const items = headings.filter((h) => h.level === 2 || h.level === 3);
---

{items.length > 1 && (
  <nav class="btoc" aria-label="En este artículo">
    <p class="btoc__label">En este artículo</p>
    <ol class="btoc__list">
      {items.map((h) => (
        <li class:list={['btoc__item', h.level === 3 && 'btoc__item--sub']}>
          <a class="btoc__link" href={`#${h.id}`} data-toc-target={h.id}>{h.text}</a>
        </li>
      ))}
    </ol>
  </nav>
)}

<script>
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.btoc__link'));
  if (links.length && 'IntersectionObserver' in window) {
    const byId = new Map(links.map((link) => [link.dataset.tocTarget, link]));
    const setActive = (id: string) => {
      links.forEach((link) => link.classList.toggle('is-active', link.dataset.tocTarget === id));
    };
    const observer = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting && byId.has(entry.target.id)) setActive(entry.target.id);
      });
    }, { rootMargin: '-15% 0px -70% 0px' });
    byId.forEach((_link, id) => {
      const target = id ? document.getElementById(id) : null;
      if (target) observer.observe(target);
    });
  }
</script>

<style>
  .btoc { position: sticky; top: 112px; max-height: calc(100vh - 144px); overflow-y: auto; padding-right: 8px; }
  .btoc__label {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 16px;
    font-size: var(--x-fs-kicker);
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--x-muted);
  }
  .btoc__label::before { content: ''; flex: none; width: 28px; height: 2px; background: var(--x-red); }
  .btoc__list { margin: 0; padding: 0; list-style: none; border-left: 1px solid var(--x-line); }
  .btoc__link {
    display: block;
    margin-left: -1px;
    padding: 8px 0 8px 16px;
    border-left: 1px solid transparent;
    font-size: var(--x-fs-meta);
    line-height: 1.45;
    color: var(--x-muted);
    text-decoration: none;
    transition: color 160ms var(--x-ease), border-color 160ms var(--x-ease);
  }
  .btoc__item--sub .btoc__link { padding-left: 28px; }
  .btoc__link:hover { color: var(--x-text); }
  .btoc__link.is-active { color: var(--x-text); border-left-color: var(--x-text); }
</style>
