---
import { fetchBlogBand } from '../../utils/getBlogData';
import { blogImageUrl } from '../../utils/blogHelpers';
import { getCategoryLabel, formatBlogDate } from '../../utils/blogUtils';

const posts = await fetchBlogBand(3);
if (posts.length === 0) return;
---

<section class="bg-[#080808] border-t border-white/10 py-12">
  <div class="max-w-6xl mx-auto px-6 sm:px-8">

    <div class="flex items-center justify-between mb-8">
      <div class="flex items-center gap-3">
        <div class="w-6 h-px bg-[#DC2626]"></div>
        <span class="text-base font-mono text-white/30 uppercase tracking-widest">Lo último</span>
        <div class="w-16 h-px bg-white/15"></div>
      </div>
      <a href="/blog" class="text-base text-red-400 hover:text-red-300 transition-colors font-medium">
        <span>Ver todo</span>
        <svg width="16" height="16" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
          <path stroke-linecap="square" stroke-linejoin="miter" stroke-width="2" d="M5 12h14M13 6l6 6-6 6"/>
        </svg>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
      {posts.map(post => {
        const imgUrl = blogImageUrl(post.imagen_portada);
        const label = getCategoryLabel(post.categoria);
        const date = formatBlogDate(post.fecha_publicacion);
        return (
          <a
            href={`/blog/${post.slug}`}
            class="group block hover:bg-white/[0.03] transition-colors"
          >
            {imgUrl ? (
              <figure class="aspect-[16/10] overflow-hidden bg-white/[0.06]">
                <img
                  src={imgUrl}
                  alt=""
                  class="h-full w-full object-cover opacity-88 transition-opacity group-hover:opacity-100"
                  loading="lazy"
                />
              </figure>
            ) : (
              <div class="aspect-[16/10] bg-white/[0.06] flex items-center justify-center">
                <span class="w-6 h-px bg-[#DC2626]" aria-hidden="true"></span>
              </div>
            )}
            <div class="min-w-0 pt-4">
              <span
                class="text-base font-mono font-semibold uppercase tracking-widest text-[#DC2626]"
              >{label}</span>
              <p class="text-white/80 text-base font-medium leading-snug mt-0.5 line-clamp-2 group-hover:text-white transition-colors">
                {post.titulo}
              </p>
              <p class="text-white/30 text-base mt-1">{date}</p>
            </div>
          </a>
        );
      })}
    </div>
  </div>
</section>
