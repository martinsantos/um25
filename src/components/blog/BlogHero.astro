---
/**
 * Artículo destacado del índice del blog (sistema oscuro --x-*).
 */
import type { EntradaBlog } from '../../lib/directus';
import { blogPostImageAlt, blogPostImageUrl } from '../../utils/blogHelpers';
import { getCategoryLabel, formatBlogDateLong, toIsoDate } from '../../utils/blogUtils';

interface Props {
  post: EntradaBlog;
}

const { post } = Astro.props;
const href = `/blog/${post.slug}`;
const imgUrl = blogPostImageUrl(post);
const imgAlt = blogPostImageAlt(post);
const label = getCategoryLabel(post.categoria);
const date = formatBlogDateLong(post.fecha_publicacion);
const isoDate = toIsoDate(post.fecha_publicacion);
const excerpt = String(post.resumen || '').replace(/\s+/g, ' ').trim();
---

<article class="bfeat">
  <a class="bfeat__media" href={href} tabindex="-1" aria-hidden="true">
    <img src={imgUrl} alt={imgAlt} width="1280" height="720" loading="eager" fetchpriority="high" decoding="async" />
  </a>
  <div class="bfeat__body">
    <p class="bfeat__kicker">Artículo destacado</p>
    <p class="bfeat__meta">
      <span class="bfeat__cat">{label}</span>
      {date && <time datetime={isoDate}>{date}</time>}
      {post.tiempo_lectura ? <span>{post.tiempo_lectura} min de lectura</span> : null}
    </p>
    <h2 class="bfeat__title"><a href={href}>{post.titulo}</a></h2>
    {excerpt && <p class="bfeat__excerpt">{excerpt}</p>}
    <a class="bfeat__link" href={href} aria-label={`Leer el artículo: ${post.titulo}`}>
      Leer el artículo <span aria-hidden="true">→</span>
    </a>
  </div>
</article>

<style>
  .bfeat {
    display: grid;
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
    background: var(--x-panel);
    border: 1px solid var(--x-line);
  }
  .bfeat__media { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--x-panel-2); }
  .bfeat__media img { display: block; width: 100%; height: 100%; object-fit: cover; }

  .bfeat__body {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 16px;
    padding: clamp(24px, 3.2vw, 48px);
    min-width: 0;
  }
  .bfeat__kicker {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 0;
    font-size: var(--x-fs-kicker);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--x-muted);
  }
  .bfeat__kicker::before { content: ''; flex: none; width: 28px; height: 2px; background: var(--x-red); }
  .bfeat__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin: 0;
    font-size: var(--x-fs-meta);
    line-height: 1.45;
    color: var(--x-muted);
  }
  .bfeat__meta > * + *::before { content: '·'; margin-right: 12px; color: var(--x-line-strong); }
  .bfeat__cat { color: var(--x-text-2); font-weight: 600; }

  .bfeat__title {
    margin: 0;
    font-family: var(--um-font-editorial);
    font-size: clamp(1.75rem, 2.4vw, 2.25rem);
    line-height: 1.12;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--x-text);
    text-wrap: balance;
  }
  .bfeat__title a { color: inherit; text-decoration: none; transition: color 160ms var(--x-ease); }
  .bfeat__title a:hover { color: var(--x-text-2); }

  .bfeat__excerpt {
    margin: 0;
    max-width: 52ch;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--x-text-2);
  }
  .bfeat__link {
    align-self: flex-start;
    margin-top: 8px;
    font-size: 1rem;
    font-weight: 600;
    color: var(--x-text);
    text-decoration: underline;
    text-decoration-color: var(--x-line-strong);
    text-underline-offset: 6px;
    transition: text-decoration-color 160ms var(--x-ease);
  }
  .bfeat__link:hover { text-decoration-color: var(--x-red); }

  @media (max-width: 960px) {
    .bfeat { grid-template-columns: minmax(0, 1fr); }
  }
</style>
