---
import type { EntradaBlog } from '../../lib/directus';
import { blogPostImageAlt, blogPostImageUrl } from '../../utils/blogHelpers';
import { getCategoryLabel, formatBlogDate } from '../../utils/blogUtils';

interface Props {
  post: EntradaBlog;
}

const { post } = Astro.props;
const imgUrl = blogPostImageUrl(post);
const imgAlt = blogPostImageAlt(post);
const label = getCategoryLabel(post.categoria);
const date = formatBlogDate(post.fecha_publicacion);
---

<article class="hero-post">
  <a href={`/blog/${post.slug}`} class="hero-media" aria-label={`Leer ${post.titulo}`}>
    <img src={imgUrl} alt={imgAlt} class="hero-img" loading="eager" />
  </a>

  <div class="hero-body">
    <span class="hero-label">Lectura reciente</span>
    <div class="hero-meta">
      <span class="category-mark">{label}</span>
      <span class="meta-sep">·</span>
      <span class="meta-text">{post.tiempo_lectura} min de lectura</span>
      <span class="meta-sep">·</span>
      <span class="meta-text">{date}</span>
    </div>

    <h2 class="hero-title">
      <a href={`/blog/${post.slug}`}>{post.titulo}</a>
    </h2>

    <p class="hero-excerpt">{post.resumen.substring(0, 240)}{post.resumen.length > 240 ? '…' : ''}</p>

    <a href={`/blog/${post.slug}`} class="hero-link">
      Leer artículo
      <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</article>

<style>
  .hero-post {
    display: grid;
    grid-template-columns: minmax(340px, 0.5fr) minmax(0, 0.5fr);
    gap: 0;
    align-items: stretch;
    margin-bottom: clamp(20px, 3vw, 34px);
    background: transparent;
    border-top: 0;
  }

  .hero-media {
    display: block;
    min-height: 100%;
    border-radius: 0;
    overflow: hidden;
    background: #f4f6f8;
    text-decoration: none;
  }

  .hero-img {
    width: 100%;
    height: 100%;
    min-height: clamp(380px, 34vw, 500px);
    object-fit: cover;
    color: transparent;
    display: block;
  }

  .hero-label {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: clamp(20px, 2.4vw, 28px);
    font-family: var(--um-font-body);
    font-size: 16px;
    font-weight: 600;
    color: #111111;
    text-transform: uppercase;
  }

  .hero-label::before {
    content: "";
    width: 30px;
    height: 2px;
    background: var(--um-red);
  }

  .hero-body {
    align-self: center;
    padding: clamp(30px, 4.6vw, 54px) 0 clamp(30px, 4.6vw, 54px) clamp(32px, 4.6vw, 58px);
    min-width: 0;
    background: transparent;
  }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
    margin-bottom: 14px;
  }

  .category-mark {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-family: var(--um-font-body);
    font-size: 16px;
    font-weight: 600;
    color: var(--skin-muted);
    text-transform: none;
  }

  .category-mark::before {
    content: "";
    width: 0;
    height: 2px;
  }

  .meta-sep { color: #c8cdd4; font-size: 16px; }
  .meta-text {
    font-family: var(--um-font-body);
    font-size: 16px;
    color: var(--skin-muted);
  }

  .hero-title {
    font-family: var(--um-font-display);
    font-size: clamp(1.8rem, 2.12vw, 2.3rem);
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1.08;
    color: var(--skin-text);
    margin: 0 0 18px;
    text-wrap: balance;
    overflow-wrap: anywhere;
  }
  .hero-title a {
    color: inherit;
    text-decoration: none;
    transition: color .15s;
  }
  .hero-title a:hover { color: var(--um-red); }

  .hero-excerpt {
    font-family: var(--um-font-body);
    font-size: clamp(1rem, 1.08vw, 1.12rem);
    line-height: 1.72;
    color: var(--skin-muted);
    margin: 0 0 20px;
    overflow-wrap: anywhere;
  }

  :global(body[data-skin] main .blog-index .hero-title),
  :global(body[data-skin] main .blog-cat .hero-title) {
    font-size: clamp(1.88rem, 2.26vw, 2.46rem) !important;
    line-height: 1.1 !important;
    font-weight: 600 !important;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: var(--um-font-body);
    font-size: 16px;
    font-weight: 700;
    color: var(--um-red);
    text-decoration: none;
    transition: color .15s;
  }
  .hero-link:hover { color: #DC2626; }

  @media (max-width: 820px) {
    .hero-post {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0;
      margin-bottom: 28px;
      overflow-x: clip;
    }

    .hero-media {
      order: 1;
      min-height: 230px;
    }

    .hero-img {
      min-height: 230px;
    }

    .hero-body {
      order: 2;
      padding: 22px 0 24px;
    }

    .hero-meta {
      display: grid;
      grid-template-columns: 1fr;
      gap: 6px;
      align-items: start;
    }

    .hero-meta .meta-sep {
      display: none;
    }

    .hero-title {
      font-size: clamp(1.5rem, 5.8vw, 1.82rem);
      line-height: 1.12;
    }

    :global(body[data-skin] main .blog-index .hero-title),
    :global(body[data-skin] main .blog-cat .hero-title) {
      font-size: clamp(1.5rem, 5.8vw, 1.82rem) !important;
      line-height: 1.13 !important;
    }

    .hero-excerpt {
      display: -webkit-box;
      -webkit-line-clamp: 4;
      -webkit-box-orient: vertical;
      overflow: hidden;
      margin-bottom: 16px;
    }
  }
</style>
