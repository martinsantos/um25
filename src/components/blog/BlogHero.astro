---
import type { EntradaBlog } from '../../lib/directus';
import { blogImageUrl } from '../../utils/blogHelpers';
import { getCategoryColor, getCategoryLabel, formatBlogDate } from '../../utils/blogUtils';

interface Props {
  post: EntradaBlog;
}

const { post } = Astro.props;
const imgUrl = blogImageUrl(post.imagen_portada);
const color = getCategoryColor(post.categoria);
const label = getCategoryLabel(post.categoria);
const date = formatBlogDate(post.fecha_publicacion);
---

<article class="hero-post">
  {imgUrl && (
    <a href={`/blog/${post.slug}`} class="hero-img-wrap">
      <img src={imgUrl} alt={post.titulo} class="hero-img" loading="eager" />
    </a>
  )}

  <div class="hero-body">
    <div class="hero-meta">
      <span class="category-pill" style={`color:${color};border-color:${color}40;background:${color}0d`}>{label}</span>
      <span class="meta-sep">·</span>
      <span class="meta-text">{post.tiempo_lectura} min de lectura</span>
      <span class="meta-sep">·</span>
      <span class="meta-text">{date}</span>
    </div>

    <h2 class="hero-title">
      <a href={`/blog/${post.slug}`}>{post.titulo}</a>
    </h2>

    <p class="hero-excerpt">{post.resumen.substring(0, 240)}{post.resumen.length > 240 ? '…' : ''}</p>

    <a href={`/blog/${post.slug}`} class="hero-link">
      Leer artículo
      <svg width="14" height="14" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
      </svg>
    </a>
  </div>
</article>

<style>
  .hero-post {
    margin-bottom: 0;
    padding-bottom: 40px;
    border-bottom: 1px solid #f3f4f6;
  }

  .hero-img-wrap {
    display: block;
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 24px;
  }

  .hero-img {
    width: 100%;
    height: 320px;
    object-fit: cover;
    display: block;
    transition: transform .5s ease;
  }
  .hero-img-wrap:hover .hero-img { transform: scale(1.02); }

  .hero-body { padding: 0; }

  .hero-meta {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 12px;
  }

  .category-pill {
    font-family: Inter, system-ui, sans-serif;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: .08em;
    padding: 3px 10px;
    border: 1px solid;
    border-radius: 999px;
  }

  .meta-sep { color: #d1d5db; font-size: 12px; }
  .meta-text {
    font-family: Inter, system-ui, sans-serif;
    font-size: 13px;
    color: #9ca3af;
  }

  .hero-title {
    font-family: 'Merriweather', Georgia, serif;
    font-size: clamp(22px, 3.5vw, 28px);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.25;
    color: #111827;
    margin: 0 0 12px;
  }
  .hero-title a {
    color: inherit;
    text-decoration: none;
    transition: color .15s;
  }
  .hero-title a:hover { color: #1d4ed8; }

  .hero-excerpt {
    font-family: Inter, system-ui, sans-serif;
    font-size: 16px;
    line-height: 1.7;
    color: #6b7280;
    margin: 0 0 18px;
  }

  .hero-link {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-family: Inter, system-ui, sans-serif;
    font-size: 14px;
    font-weight: 500;
    color: #1d4ed8;
    text-decoration: none;
    transition: color .15s;
  }
  .hero-link:hover { color: #1e40af; }
</style>
