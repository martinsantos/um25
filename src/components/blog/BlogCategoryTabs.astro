---
interface Props {
  current?: string;
}

const { current } = Astro.props;

const tabs = [
  { label: 'Todos', href: '/blog', key: undefined },
  { label: 'Noticias', href: '/blog/categoria/noticias', key: 'noticias' },
  { label: 'Proyectos', href: '/blog/categoria/proyectos', key: 'proyectos' },
  { label: 'Técnico', href: '/blog/categoria/tecnico', key: 'tecnico' },
  { label: 'Tecnología', href: '/blog/categoria/tecnologia', key: 'tecnologia' },
  { label: 'Empresa', href: '/blog/categoria/empresa', key: 'empresa' },
];
---

<nav class="btabs" aria-label="Categorías del blog">
  <ul class="btabs__list">
    {tabs.map((tab) => {
      const isActive = tab.key === current || (!current && !tab.key);
      return (
        <li>
          <a
            href={tab.href}
            class:list={['btabs__tab', isActive && 'is-active']}
            aria-current={isActive ? 'page' : undefined}
          >
            {tab.label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .btabs { margin: 0 0 48px; border-bottom: 1px solid var(--x-line); }
  .btabs__list {
    display: flex;
    gap: 8px;
    margin: 0;
    padding: 0 0 16px;
    list-style: none;
    overflow-x: auto;
    scrollbar-width: none;
  }
  .btabs__list::-webkit-scrollbar { display: none; }
  .btabs__tab {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    border: 1px solid var(--x-line);
    border-radius: 4px;
    font-size: var(--x-fs-meta);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    color: var(--x-text-2);
    text-decoration: none;
    transition: border-color 160ms var(--x-ease), color 160ms var(--x-ease), background-color 160ms var(--x-ease);
  }
  .btabs__tab:hover { border-color: var(--x-line-strong); color: var(--x-text); }
  .btabs__tab.is-active { background: var(--x-text); border-color: var(--x-text); color: var(--x-ink); }
  .btabs__tab:focus-visible { outline: 2px solid var(--x-red); outline-offset: 2px; }
</style>
