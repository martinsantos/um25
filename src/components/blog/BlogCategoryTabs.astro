---
import { BLOG_LISTING_CATEGORIES } from '../../lib/blogListingRoute';
import { fetchPublishedBlogIndex } from '../../utils/blogPublishedIndex';
import { getCategoryLabel } from '../../utils/blogUtils';

interface Props {
  current?: string;
  query?: boolean;
}

const { current, query = false } = Astro.props;
const available = new Set((await fetchPublishedBlogIndex()).map((post) => post.categoria));
const tabs = [
  { label: 'Todas', href: '/blog', key: undefined },
  ...BLOG_LISTING_CATEGORIES.filter((category) => available.has(category)).map((category) => ({
    label: getCategoryLabel(category),
    href: query ? `/blog?categoria=${category}` : `/blog/categoria/${category}`,
    key: category,
  })),
];
---

<nav class:list={['btabs', query && 'btabs--query']} aria-label="Categorías del blog">
  <ul class="btabs__list">
    {tabs.map((tab) => {
      const isActive = tab.key === current || (!current && !tab.key);
      return (
        <li>
          <a
            href={tab.href}
            class:list={['btabs__tab', isActive && 'is-active']}
            aria-current={isActive ? 'page' : undefined}
          >
            {tab.label}
          </a>
        </li>
      );
    })}
  </ul>
</nav>

<style>
  .btabs { margin: 0 0 48px; border-bottom: 1px solid var(--x-line); }
  .btabs--query { margin: 20px 0 0; border-bottom: 0; }
  .btabs__list {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0 0 16px;
    list-style: none;
  }
  .btabs--query .btabs__list { padding-bottom: 0; }
  .btabs__tab {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border: 1px solid var(--x-line);
    border-radius: 4px;
    font-size: var(--x-fs-meta, 1rem);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    color: var(--x-text-2);
    text-decoration: none;
    transition: border-color 160ms var(--x-ease), color 160ms var(--x-ease), background-color 160ms var(--x-ease);
  }
  .btabs__tab:hover { border-color: var(--x-line-strong); color: var(--x-text); }
  .btabs__tab.is-active { background: var(--x-text); border-color: var(--x-text); color: var(--x-ink); }
  .btabs__tab:focus-visible { outline: 2px solid var(--x-red); outline-offset: 2px; }
</style>
