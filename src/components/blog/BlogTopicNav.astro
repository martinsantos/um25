---
import { ArrowUpRight, Cctv, CodeXml, Flame, Headset, Network, RadioTower, Workflow, Zap } from 'lucide-astro';
import { publishableServiceHubs } from '../../utils/blogTopicMap';

interface Props {
  current?: string;
  hubs?: ReturnType<typeof publishableServiceHubs>;
}
const { current, hubs = publishableServiceHubs() } = Astro.props;
const icons: Record<string, typeof Network> = {
  '101': Network, '102': Cctv, '103': RadioTower, '104': CodeXml,
  '105': Headset, '106': Workflow, '107': Flame, '108': Zap,
};
---

{hubs.length > 0 && (
  <nav id="temas" class="temas" aria-labelledby="temas-title" tabindex="-1">
    <h2 id="temas-title">Explorá por tema<span aria-hidden="true">.</span></h2>
    <ul>
      {hubs.map(({ cluster, count }) => {
        const Icon = icons[cluster.key] || Network;
        const active = cluster.hubSlug === current;
        return (
          <li>
            <a href={`/blog/tema/${cluster.hubSlug}`} aria-current={active ? 'page' : undefined}>
              <Icon size={19} aria-hidden="true" class="tema-icon" />
              <div class="tema-text">
                <strong>{cluster.label}</strong>
                <small>{count} notas</small>
              </div>
              <ArrowUpRight size={15} aria-hidden="true" class="tema-arrow" />
            </a>
          </li>
        );
      })}
    </ul>
  </nav>
)}

<style>
  .temas {
    margin-block: clamp(24px, 4vw, 52px);
    padding-block: 24px;
    border-top: 1px solid var(--line, var(--x-line));
    scroll-margin-top: 88px;
  }
  .temas h2 {
    margin: 0 0 16px;
    font: inherit;
    font-size: clamp(1.5rem, 2.6vw, 2.25rem);
    font-weight: 600;
    line-height: 1.15;
  }
  .temas h2 span, .tema-icon { color: var(--red, var(--x-red)); }
  .temas ul { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0 20px; list-style: none; padding: 0; margin: 0; }
  .temas li { border-bottom: 1px solid var(--line, var(--x-line)); }
  .temas a {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: start;
    align-content: center;
    gap: 4px 12px;
    min-height: 76px;
    height: 100%;
    padding: 10px 4px;
    color: inherit;
    text-decoration: none;
  }
  .tema-text { display: grid; gap: 4px; }
  .tema-text strong { font-size: 1rem; line-height: 1.25; overflow-wrap: anywhere; }
  .tema-text small, .tema-arrow { color: var(--ink-2, var(--x-text-2)); }
  .tema-text small { font-size: .875rem; }
  .temas a:is(:hover, :focus-visible, [aria-current]) strong { text-decoration: underline; text-underline-offset: .22em; }
  @media (max-width: 960px) { .temas ul { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 520px) {
    .temas ul { gap: 0 12px; }
    .temas a { grid-template-columns: auto minmax(0, 1fr); gap: 8px; padding-inline: 0; }
    .tema-arrow { display: none; }
  }
  @media (max-width: 420px) { .temas ul { grid-template-columns: minmax(0, 1fr); } .temas a { min-height: 59px; } }
</style>
