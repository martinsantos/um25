---
/**
 * Acceso a los listados temáticos del blog (/blog/tema/<slug>), uno por servicio
 * con notas suficientes según el mapa temático.
 */
import { publishableServiceHubs } from '../../utils/blogTopicMap';

interface Props {
  current?: string;
}

const { current } = Astro.props;
const hubs = publishableServiceHubs()
  .sort((a, b) => b.count - a.count)
  .map(({ cluster, count }) => ({
    href: `/blog/tema/${cluster.hubSlug}`,
    label: cluster.label,
    count,
    active: cluster.hubSlug === current,
  }));
---

{hubs.length > 0 && (
  <nav class="btn-topics" aria-label="Temas del blog">
    <p class="btn-topics__label">Por tema</p>
    <ul class="btn-topics__list">
      {hubs.map((hub) => (
        <li>
          <a
            href={hub.href}
            class:list={['btn-topics__item', hub.active && 'is-active']}
            aria-current={hub.active ? 'page' : undefined}
          >
            {hub.label}{" "}<span class="btn-topics__count">{hub.count}</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
)}

<style>
  .btn-topics { display: flex; flex-wrap: wrap; align-items: baseline; gap: 12px 16px; margin: -24px 0 48px; }
  .btn-topics__label {
    margin: 0; font-size: var(--x-fs-kicker); font-weight: 600; letter-spacing: .12em; text-transform: uppercase; color: var(--x-muted);
  }
  .btn-topics__list { display: flex; flex-wrap: wrap; gap: 8px 20px; margin: 0; padding: 0; list-style: none; }
  .btn-topics__item {
    font-size: var(--x-fs-meta); line-height: 1.45; color: var(--x-text-2);
    text-decoration: underline; text-decoration-color: var(--x-line-strong); text-underline-offset: 4px;
    transition: color 160ms var(--x-ease), text-decoration-color 160ms var(--x-ease);
  }
  .btn-topics__item:hover { color: var(--x-text); text-decoration-color: var(--x-red); }
  .btn-topics__item.is-active { color: var(--x-text); text-decoration-color: var(--x-red); }
  .btn-topics__count { color: var(--x-muted); font-variant-numeric: tabular-nums; }
  @media (max-width: 680px) { .btn-topics { margin-top: -16px; } }
  @media (prefers-reduced-motion: reduce) { .btn-topics__item { transition: none; } }
</style>
