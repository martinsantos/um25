---
/**
 * Tarjeta de artículo para las grillas del blog (sistema oscuro --x-*).
 * Imagen 16:9, categoría, fecha, tiempo de lectura, título y bajada.
 */
import type { EntradaBlog } from '../../lib/directus';
import { blogPostImageAlt, blogPostImageUrl } from '../../utils/blogHelpers';
import { formatBlogDate, getCategoryLabel } from '../../utils/blogUtils';

interface Props {
  post: EntradaBlog;
  headingLevel?: 'h2' | 'h3';
  eager?: boolean;
}

const { post, headingLevel = 'h3', eager = false } = Astro.props;
const href = `/blog/${post.slug}`;
const imgUrl = blogPostImageUrl(post);
const imgAlt = blogPostImageAlt(post);
const label = getCategoryLabel(post.categoria);
const date = formatBlogDate(post.fecha_publicacion);
const isoDate = post.fecha_publicacion ? new Date(post.fecha_publicacion).toISOString() : undefined;
const excerpt = String(post.resumen || '').replace(/\s+/g, ' ').trim();
const Heading = headingLevel;
---

<article class="bcard">
  <a class="bcard__media" href={href} tabindex="-1" aria-hidden="true">
    <img
      src={imgUrl}
      alt={imgAlt}
      width="640"
      height="360"
      loading={eager ? 'eager' : 'lazy'}
      decoding="async"
    />
  </a>
  <div class="bcard__body">
    <p class="bcard__meta">
      <span class="bcard__cat">{label}</span>
      {date && <time datetime={isoDate}>{date}</time>}
      {post.tiempo_lectura ? <span>{post.tiempo_lectura} min de lectura</span> : null}
    </p>
    <Heading class="bcard__title"><a href={href}>{post.titulo}</a></Heading>
    {excerpt && <p class="bcard__excerpt">{excerpt}</p>}
  </div>
</article>

<style>
  .bcard {
    position: relative;
    display: flex;
    flex-direction: column;
    min-width: 0;
    background: var(--x-panel);
    border: 1px solid var(--x-line);
    transition: border-color 160ms var(--x-ease), background-color 160ms var(--x-ease);
  }
  .bcard:hover { border-color: var(--x-line-strong); background: var(--x-panel-2); }
  .bcard:focus-within { border-color: var(--x-line-strong); }

  .bcard__media { display: block; aspect-ratio: 16 / 9; overflow: hidden; background: var(--x-panel-2); }
  .bcard__media img { display: block; width: 100%; height: 100%; object-fit: cover; transition: filter 160ms var(--x-ease); }
  .bcard:hover .bcard__media img { filter: brightness(1.08); }

  .bcard__body { display: flex; flex-direction: column; gap: 12px; padding: 24px; flex: 1; }

  .bcard__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 4px 12px;
    margin: 0;
    font-size: var(--x-fs-meta);
    line-height: 1.45;
    color: var(--x-muted);
  }
  .bcard__meta > * + *::before { content: '·'; margin-right: 12px; color: var(--x-line-strong); }
  .bcard__cat { color: var(--x-text-2); font-weight: 600; }

  .bcard__title {
    margin: 0;
    font-family: var(--um-font-editorial);
    font-size: var(--x-fs-h3);
    line-height: 1.3;
    font-weight: 600;
    letter-spacing: -0.01em;
    color: var(--x-text);
    text-wrap: pretty;
  }
  .bcard__title a { color: inherit; text-decoration: none; }
  /* Toda la tarjeta es clickeable a través del enlace del título. */
  .bcard__title a::after { content: ''; position: absolute; inset: 0; }
  .bcard__title a:focus-visible { outline: none; }
  .bcard:has(.bcard__title a:focus-visible) { outline: 2px solid var(--x-red); outline-offset: 2px; }

  .bcard__excerpt {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
    color: var(--x-muted);
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    .bcard, .bcard__media img { transition: none; }
    .bcard:hover .bcard__media img { transform: none; }
  }
</style>
