---
import type { EntradaBlog } from '../../lib/directus';
import { blogImageUrl } from '../../utils/blogHelpers';
import { getCategoryColor, getCategoryLabel, formatBlogDate } from '../../utils/blogUtils';

interface Props {
  post: EntradaBlog;
}

const { post } = Astro.props;
const imgUrl = blogImageUrl(post.imagen_portada);
const color = getCategoryColor(post.categoria);
const label = getCategoryLabel(post.categoria);
const date = formatBlogDate(post.fecha_publicacion);
---

<article class="py-10 border-b border-[#1e3a5f]/70 last:border-0">
  <div class="flex gap-8">
    <div class="flex-1 min-w-0">
      <div class="flex items-center gap-2.5 mb-4">
        <span
          class="text-[11px] font-mono font-bold uppercase tracking-widest"
          style={`color: ${color}`}
        >{label}</span>
        <span class="text-white/30 text-xs">·</span>
        <span class="text-white/50 text-sm">{post.tiempo_lectura} min</span>
        <span class="text-white/30 text-xs">·</span>
        <span class="text-white/50 text-sm">{date}</span>
      </div>

      <h2 class="mb-3" style="font-family:'Poppins','Century Gothic',sans-serif;font-size:20px;font-weight:700;letter-spacing:-0.02em;line-height:1.3;color:#e8edf4;">
        <a href={`/blog/${post.slug}`} class="hover:text-blue-300 transition-colors">
          {post.titulo}
        </a>
      </h2>

      <p class="mb-5" style="font-family:'Arial','Inter',system-ui,sans-serif;font-size:16px;line-height:1.75;color:#8fa8c0;">
        {post.resumen.substring(0, 220)}{post.resumen.length > 220 ? '…' : ''}
      </p>

      <a
        href={`/blog/${post.slug}`}
        class="inline-flex items-center gap-1.5 text-blue-400 hover:text-blue-300 text-sm font-medium transition-colors"
      >
        Leer artículo
        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
        </svg>
      </a>
    </div>

    {imgUrl && (
      <div class="flex-shrink-0 hidden sm:block">
        <a href={`/blog/${post.slug}`} class="block group">
          <img
            src={imgUrl}
            alt={post.titulo}
            class="w-40 h-28 object-cover rounded-xl opacity-75 group-hover:opacity-100 transition-opacity"
            loading="lazy"
          />
        </a>
      </div>
    )}
  </div>
</article>
