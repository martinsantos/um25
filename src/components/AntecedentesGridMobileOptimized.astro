---
// src/components/AntecedentesGridMobileOptimized.astro
// Grid adaptativo: 1 col móvil → 2 tablet → 3 desktop
// With working pagination: 6 items per page (2 rows x 3 cols)

import { directus } from '@/lib/directus';
import { readItems } from '@directus/sdk';

interface Props {
  items?: any[];           // ← Datos pre-filtrados por la página
  sector?: string;         // ← Mantener para compatibilidad
  limit?: number;
  title?: string;
  description?: string;
  badgeLabel?: string;     // ← Badge personalizado por sector (opcional)
}

const {
  items: passedItems = [],  // ← Recibir items de la página
  sector,
  limit = 25,
  title = 'Casos de Éxito',
  description = 'Descubre cómo hemos transformado empresas con soluciones IT estratégicas',
  badgeLabel = null       // ← Badge personalizado por sector (null = no mostrar badge)
} = Astro.props;

// Usar items pasados por la página, o intentar fetch solo como fallback
let items = passedItems;

// Solo fetch si NO hay items pasados
if (items.length === 0) {
  try {
    // Intentar con filtro de sector si se proporciona
    const filterConfig = sector
      ? { filter: { Sector: { _contains: sector } } }
      : {};

    const antecedentes = await directus.request(
      readItems('antecedentes', {
        ...filterConfig,
        fields: ['id', 'Titulo', 'Descripcion', 'Imagen', 'Cliente', 'Area', 'Unidad_de_negocio'],
        limit: limit,
        sort: ['-date_created']
      })
    );

    // Procesar imágenes con la lógica correcta
    if (antecedentes && Array.isArray(antecedentes)) {
      const { getAntecedenteImageUrl } = await import('../utils/directus.js');
      const { generateSlug } = await import('../utils/slugUtils.js');

      items = await Promise.all(
        antecedentes.map(async (item) => ({
          ...item,
          Nombre: item.Titulo,
          mapeo_imagenes_completo: await getAntecedenteImageUrl(item),
          slug: generateSlug(item.Titulo)
        }))
      );
    } else {
      items = [];
    }
  } catch (error) {
    console.warn('Error fetching antecedentes:', error);
    items = [];
  }
}

// Pagination configuration
const itemsPerPage = 6; // 2 rows x 3 columns
const totalPages = Math.ceil(items.length / itemsPerPage);
const paginatedItems = items.slice(0, itemsPerPage);
---

<section class="w-full px-4 sm:px-6 py-12 sm:py-16 max-w-7xl mx-auto" id="antecedentes-section">

  <!-- Header -->
  <div class="mb-10 sm:mb-14">
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-black text-gray-900 mb-3 sm:mb-4">
      {title}
    </h2>
    <p class="text-base sm:text-lg text-gray-600 max-w-2xl">
      {description}
    </p>
  </div>

  <!-- Store all items as data attributes for JavaScript pagination -->
  <div
    id="antecedentes-grid-data"
    data-items={JSON.stringify(items)}
    data-items-per-page={itemsPerPage}
    data-total-pages={totalPages}
    style="display: none;"
  ></div>

  <!-- Grid - Responsive columns with equal heights -->
  {items.length > 0 ? (
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-6 lg:gap-8 mb-10 sm:mb-14 auto-rows-fr" id="antecedentes-grid">
      {paginatedItems.map((item, index) => (
        <a href={`/antecedentes/${item.id}/${item.slug}`} class="group rounded-xl overflow-hidden bg-white border border-gray-200 hover:border-cyan-300 transition-all duration-300 hover:shadow-lg hover:shadow-cyan-500/10 flex flex-col h-full cursor-pointer no-underline"
          style={`animation: fadeInScale 0.6s ease-out ${index * 50}ms backwards`}
        >

          <!-- Image Container -->
          <div class="relative w-full h-40 sm:h-48 overflow-hidden bg-gray-100">
            {item.mapeo_imagenes_completo ? (
              <img
                src={item.mapeo_imagenes_completo}
                alt={item.Nombre}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300"
                loading="lazy"
              />
            ) : (
              <div class="w-full h-full bg-gradient-to-br from-cyan-100 to-blue-100 flex items-center justify-center">
                <svg class="w-12 h-12 text-cyan-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/>
                </svg>
              </div>
            )}
            <!-- Badge overlay - Solo mostrar si se proporciona badgeLabel -->
            {badgeLabel && (
              <div class="absolute top-2 sm:top-3 right-2 sm:right-3 px-2 sm:px-3 py-1 bg-cyan-500/90 text-white text-xs sm:text-sm font-semibold rounded-full backdrop-blur-sm">
                {badgeLabel}
              </div>
            )}
          </div>

          <!-- Content -->
          <div class="flex-1 p-4 sm:p-5 flex flex-col">
            <h3 class="text-lg sm:text-xl font-bold text-gray-900 mb-2 sm:mb-3 line-clamp-2 group-hover:text-cyan-600 transition-colors">
              {item.Nombre}
            </h3>

            <p class="text-sm sm:text-base text-gray-600 mb-4 sm:mb-6 line-clamp-3 flex-1">
              {item.Descripcion?.substring(0, 120)}...
            </p>

            <!-- CTA Link -->
            <a
              href={`/antecedentes/${item.id}/${item.slug}`}
              class="inline-flex items-center gap-2 text-sm sm:text-base font-semibold text-cyan-600 hover:text-cyan-700 group/link"
            >
              Ver Caso
              <svg class="w-4 h-4 sm:w-5 sm:h-5 transform group-hover/link:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
              </svg>
            </a>
          </div>
        </a>
      ))}
    </div>
  ) : (
    <!-- Empty State -->
    <div class="text-center py-12">
      <p class="text-gray-600 text-lg">No hay casos disponibles en este momento.</p>
    </div>
  )}

  <!-- Pagination for mobile -->
  {totalPages > 1 && (
    <div class="flex justify-center gap-2 flex-wrap" id="pagination-container">
      <button class="px-4 py-2 bg-gray-100 text-gray-900 rounded-lg hover:bg-gray-200 transition-colors font-medium disabled:opacity-50" id="btn-prev">
        ← Anterior
      </button>
      <div class="flex items-center gap-1 flex-wrap" id="page-buttons">
        {Array.from({ length: totalPages }, (_, i) => (
          <button
            class={`px-3 py-2 rounded-lg font-medium transition-colors ${
              i === 0
                ? 'bg-cyan-500 text-white'
                : 'text-gray-900 hover:bg-gray-100'
            }`}
            data-page={i + 1}
          >
            {i + 1}
          </button>
        ))}
      </div>
      <button class="px-4 py-2 bg-gray-100 text-gray-900 rounded-lg hover:bg-gray-200 transition-colors font-medium disabled:opacity-50" id="btn-next">
        Siguiente →
      </button>
    </div>
  )}

</section>

<style>
  @keyframes fadeInScale {
    from {
      opacity: 0;
      transform: scale(0.95);
    }
    to {
      opacity: 1;
      transform: scale(1);
    }
  }

  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const dataEl = document.getElementById('antecedentes-grid-data');
    if (!dataEl) return;

    try {
      const allItems = JSON.parse(dataEl.dataset.items || '[]');
      const itemsPerPage = parseInt(dataEl.dataset.itemsPerPage || '6');
      const totalPages = parseInt(dataEl.dataset.totalPages || '1');

      if (!Array.isArray(allItems) || allItems.length === 0) return;

      let currentPage = 1;
      const grid = document.getElementById('antecedentes-grid');
      const prevBtn = document.getElementById('btn-prev');
      const nextBtn = document.getElementById('btn-next');
      const pageButtons = document.querySelectorAll('[data-page]');

      if (!grid) return;

      function renderPage(page) {
        currentPage = Math.max(1, Math.min(page, totalPages));
        const start = (currentPage - 1) * itemsPerPage;
        const end = start + itemsPerPage;
        const pageItems = allItems.slice(start, end);

        grid.innerHTML = pageItems.map((item, idx) => `
          <a href="/antecedentes/${item.id}/${item.slug}" style="display: flex; flex-direction: column; height: 100%; text-decoration: none; color: inherit; border: 1px solid #e5e7eb; border-radius: 0.75rem; overflow: hidden; background: white; cursor: pointer; transition: all 0.3s ease; animation: fadeInScale 0.6s ease-out ${idx * 50}ms backwards;" onmouseover="this.style.borderColor='#06b6d4'; this.style.boxShadow='0 20px 25px -5px rgba(6, 182, 212, 0.1)';" onmouseout="this.style.borderColor='#e5e7eb'; this.style.boxShadow='none';">
            <div style="position: relative; width: 100%; height: 10rem; overflow: hidden; background-color: #f3f4f6;">
              ${item.mapeo_imagenes_completo ? `<img src="${item.mapeo_imagenes_completo}" alt="${item.Nombre}" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;" loading="lazy" onmouseover="this.style.transform='scale(1.05)';" onmouseout="this.style.transform='scale(1)';" />` : `<div style="width: 100%; height: 100%; background: linear-gradient(to bottom right, #cffafe, #dbeafe); display: flex; align-items: center; justify-content: center;"><svg style="width: 3rem; height: 3rem; color: #a5f3fc;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"/></svg></div>`}
            </div>
            <div style="flex: 1; padding: 1.25rem; display: flex; flex-direction: column;">
              <h3 style="font-size: 1.125rem; font-weight: 700; color: #111827; margin-bottom: 0.75rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; transition: color 0.2s ease;" onmouseover="this.style.color='#0891b2';" onmouseout="this.style.color='#111827';">${item.Nombre}</h3>
              <p style="font-size: 1rem; color: #4b5563; margin-bottom: 1.5rem; flex: 1; display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">${item.Descripcion?.substring(0, 120) || 'Sin descripción'}...</p>
              <a href="/antecedentes/${item.id}/${item.slug}" style="display: inline-flex; align-items: center; gap: 0.5rem; font-size: 1rem; font-weight: 600; color: #0891b2; text-decoration: none; transition: color 0.2s ease;" onmouseover="this.style.color='#0e7490';" onmouseout="this.style.color='#0891b2';">Ver Caso <svg style="width: 1.25rem; height: 1.25rem;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/></svg></a>
            </div>
          </a>
        `).join('');

        pageButtons.forEach(btn => {
          const page = parseInt(btn.getAttribute('data-page'));
          btn.classList.toggle('bg-cyan-500', page === currentPage);
          btn.classList.toggle('text-white', page === currentPage);
          btn.classList.toggle('text-gray-900', page !== currentPage);
          btn.classList.toggle('hover:bg-gray-100', page !== currentPage);
        });

        prevBtn.disabled = currentPage === 1;
        nextBtn.disabled = currentPage === totalPages;
        grid.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }

      prevBtn?.addEventListener('click', () => renderPage(currentPage - 1));
      nextBtn?.addEventListener('click', () => renderPage(currentPage + 1));
      pageButtons.forEach(btn => {
        btn.addEventListener('click', () => renderPage(parseInt(btn.dataset.page)));
      });
    } catch (error) {
      console.error('Pagination error:', error);
    }
  });
</script>
