---
/**
 * StatsBar Component V4
 *
 * Barra de estadísticas para mostrar métricas clave de un servicio.
 * Usado en página de detalle de servicio debajo del hero.
 *
 * Props:
 * - stats: Array de objetos {value: string, label: string}
 *
 * Ejemplo de uso:
 * <StatsBar stats={[
 *   { value: '94+', label: 'Proyectos Completados' },
 *   { value: '22+', label: 'Años de Experiencia' },
 *   { value: '25', label: 'Años de Garantía' },
 *   { value: '24/7', label: 'Soporte Técnico' }
 * ]} />
 */

export interface Stat {
  value: string;
  label: string;
}

export interface Props {
  stats?: Stat[];
  className?: string;
}

const {
  stats = [
    { value: '100+', label: 'Proyectos' },
    { value: '20+', label: 'Años' },
    { value: '99%', label: 'Satisfacción' },
    { value: '24/7', label: 'Soporte' }
  ],
  className = ''
} = Astro.props;

// Validar que haya stats
const validStats = stats && stats.length > 0 ? stats : [];
const hasStats = validStats.length > 0;

const countClass = `stats-bar-v4__grid--${Math.min(validStats.length, 4)}`;
---

{hasStats && (
  <section class={`stats-bar-v4 ${className}`}>
    <div class="stats-bar-v4__inner">
      <div class={`stats-bar-v4__grid ${countClass}`}>
        {validStats.map((stat) => (
          <div class="stats-bar-v4__item">
            <div class="stats-bar-v4__value">
              {stat.value}
            </div>
            <div class="stats-bar-v4__label">
              {stat.label}
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}

<style>
  .stats-bar-v4 {
    background: var(--skin-hero-bg);
    border-top: 0;
    border-bottom: 0;
    color: var(--skin-hero-text);
  }

  .stats-bar-v4__inner {
    width: min(100% - 32px, 1240px);
    margin-inline: auto;
    padding: clamp(22px, 3vw, 34px) 0;
  }

  .stats-bar-v4__grid {
    display: grid;
    gap: 0;
    background: transparent;
    border-left: 0;
    border-right: 0;
  }

  .stats-bar-v4__grid--1 {
    grid-template-columns: 1fr;
  }

  .stats-bar-v4__grid--2 {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .stats-bar-v4__grid--3 {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .stats-bar-v4__grid--4 {
    grid-template-columns: repeat(4, minmax(0, 1fr));
  }

  .stats-bar-v4__item {
    min-height: 96px;
    padding: 1.15rem 1.3rem;
    background: var(--skin-hero-bg);
    border-right: 1px solid color-mix(in srgb, var(--skin-hero-text) 9%, transparent);
  }

  .stats-bar-v4__item:last-child {
    border-right: 0;
  }

  .stats-bar-v4__value {
    color: var(--skin-hero-text);
    font-size: clamp(1.42rem, 1.9vw, 1.92rem);
    line-height: 1;
    font-weight: 600;
  }

  .stats-bar-v4__label {
    max-width: 210px;
    margin-top: 0.62rem;
    color: var(--skin-hero-muted);
    font-size: 1rem;
    line-height: 1.38;
  }

  .stats-bar-v4__value {
    animation: none;
  }

  @media (max-width: 760px) {
    .stats-bar-v4__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 460px) {
    .stats-bar-v4__grid {
      grid-template-columns: 1fr;
    }

    .stats-bar-v4__item {
      min-height: auto;
    }
  }
</style>
