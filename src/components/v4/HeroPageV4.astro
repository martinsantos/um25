---
/**
 * HeroPageV4 - Clean Typography Hero (V5 Light Sofisticado)
 * - Light background with subtle radial gradient
 * - Typography-first design — no background images
 * - Clean breadcrumb, stats inline
 */

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Badge {
  icon?: 'message' | 'briefcase' | 'building' | 'users' | 'zap' | 'shield' | 'code' | 'phone';
  text: string;
}

interface Stat {
  value: string;
  label: string;
}

interface Props {
  title: string;
  titleHighlight?: string;
  subtitle?: string;
  breadcrumb: BreadcrumbItem[];
  badge?: Badge;
  stats?: Stat[];
  backgroundImage?: string;
  compact?: boolean;
}

const {
  title,
  titleHighlight,
  subtitle,
  breadcrumb,
  badge,
  stats,
  backgroundImage,
  compact = false,
} = Astro.props;

const iconMap: Record<string, string> = {
  message: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>`,
  briefcase: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>`,
  building: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>`,
  users: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>`,
  zap: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"/>`,
  shield: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>`,
  code: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>`,
  phone: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>`,
};
---

<section class={`relative overflow-hidden ${compact ? 'pb-8 sm:pb-10' : 'pb-12 sm:pb-16 lg:pb-20'}`} style="background: radial-gradient(ellipse at top center, #F1F5F9, #FFFFFF 70%);">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 pt-6 sm:pt-10">
    {/* Breadcrumb */}
    <nav class="flex items-center gap-2 text-sm text-um-text-muted mb-6 sm:mb-8" aria-label="Breadcrumb">
      {breadcrumb.map((item, index) => (
        <>
          {index > 0 && (
            <span class="text-um-border-strong">/</span>
          )}
          {index === breadcrumb.length - 1 ? (
            <span class="text-um-text-tertiary" aria-current="page">{item.label}</span>
          ) : (
            <a href={item.href} class="hover:text-um-text-secondary transition-colors">{item.label}</a>
          )}
        </>
      ))}
    </nav>

    <div class={`${stats && stats.length > 0 ? 'lg:flex lg:items-end lg:justify-between lg:gap-12' : ''}`}>
      {/* Text Content */}
      <div class="max-w-3xl">
        {/* Badge */}
        {badge && (
          <span class="inline-flex items-center gap-2 px-3 py-1.5 bg-um-primary-light text-um-primary rounded-full text-xs font-semibold mb-5">
            {badge.icon && (
              <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={iconMap[badge.icon]} />
            )}
            {badge.text}
          </span>
        )}

        {/* Title */}
        <h1 class="text-fluid-hero text-um-dark mb-4 sm:mb-5">
          {title}
          {titleHighlight && (
            <>
              {' '}
              <span class="text-um-primary">{titleHighlight}</span>
            </>
          )}
        </h1>

        {/* Subtitle */}
        {subtitle && (
          <p class="text-base sm:text-lg text-um-text-tertiary leading-relaxed max-w-2xl">
            {subtitle}
          </p>
        )}
      </div>

      {/* Stats — inline style */}
      {stats && stats.length > 0 && (
        <div class="flex items-center gap-6 sm:gap-8 mt-8 lg:mt-0 lg:shrink-0">
          {stats.map((stat, index) => (
            <>
              {index > 0 && (
                <div class="w-px h-10 bg-um-border"></div>
              )}
              <div class="text-center">
                <div class="text-2xl sm:text-3xl font-bold text-um-dark font-mono" style="font-family:'JetBrains Mono',monospace;">{stat.value}</div>
                <div class="text-xs text-um-text-muted mt-1 uppercase tracking-wider">{stat.label}</div>
              </div>
            </>
          ))}
        </div>
      )}
    </div>
  </div>

  {/* Bottom accent line */}
  <div class="absolute bottom-0 left-0 right-0 h-px bg-gradient-to-r from-transparent via-um-border to-transparent"></div>
</section>
