---
/**
 * HeroPageV4 - Hero para páginas interiores V4 Design System
 * - Breadcrumb consistente
 * - Badge opcional
 * - Título y subtítulo
 * - Stats opcionales
 * - Imagen de fondo opcional
 */

interface BreadcrumbItem {
  label: string;
  href: string;
}

interface Badge {
  icon?: 'message' | 'briefcase' | 'building' | 'users' | 'zap' | 'shield' | 'code' | 'phone';
  text: string;
}

interface Stat {
  value: string;
  label: string;
}

interface Props {
  title: string;
  titleHighlight?: string;
  subtitle?: string;
  breadcrumb: BreadcrumbItem[];
  badge?: Badge;
  stats?: Stat[];
  backgroundImage?: string;
  compact?: boolean;
}

const {
  title,
  titleHighlight,
  subtitle,
  breadcrumb,
  badge,
  stats,
  backgroundImage,
  compact = false,
} = Astro.props;

// Icon mappings
const iconMap = {
  message: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z"/>`,
  briefcase: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>`,
  building: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-5m-9 0H3m2 0h5M9 7h1m-1 4h1m4-4h1m-1 4h1m-5 10v-5a1 1 0 011-1h2a1 1 0 011 1v5m-4 0h4"/>`,
  users: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4.354a4 4 0 110 5.292M15 21H3v-1a6 6 0 0112 0v1zm0 0h6v-1a6 6 0 00-9-5.197M13 7a4 4 0 11-8 0 4 4 0 018 0z"/>`,
  zap: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/>`,
  shield: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"/>`,
  code: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4"/>`,
  phone: `<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>`,
};
---

<section class={`um-page-hero relative overflow-hidden ${compact ? 'is-compact' : ''}`}>
  {/* Background image if provided */}
  {backgroundImage && (
    <div class="absolute inset-0">
      <img
        src={backgroundImage}
        alt=""
        class="um-page-hero__image w-full h-full object-cover"
        aria-hidden="true"
      />
      <div class="absolute inset-0 um-page-hero__wash"></div>
    </div>
  )}

  <div class="relative um-container pt-4 sm:pt-6">
    {/* Breadcrumb */}
    <nav class="um-page-crumbs flex items-center gap-2 text-base mb-8 sm:mb-10" aria-label="Breadcrumb">
      {breadcrumb.map((item, index) => (
        <>
          {index > 0 && (
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
          )}
          {index === breadcrumb.length - 1 ? (
            <span aria-current="page">{item.label}</span>
          ) : (
            <a href={item.href} class="transition-colors">{item.label}</a>
          )}
        </>
      ))}
    </nav>

    <div class={`um-page-hero__grid ${stats && stats.length > 0 ? 'has-stats' : ''}`}>
      {/* Text Content */}
      <div>
        {/* Badge */}
        {badge && (
          <span class="um-page-label">
            {badge.icon && (
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" set:html={iconMap[badge.icon]} aria-hidden="true" />
            )}
            {badge.text}
          </span>
        )}

        {/* Title */}
        <h1 class="um-page-title">
          {title}
          {titleHighlight && (
            <>
              <br />
              <span>{titleHighlight}</span>
            </>
          )}
        </h1>

        {/* Subtitle */}
        {subtitle && (
          <p class="um-page-subtitle">
            {subtitle}
          </p>
        )}
      </div>

      {/* Stats Grid */}
      {stats && stats.length > 0 && (
        <div class="um-page-stats">
          {stats.map((stat) => (
            <div class="um-page-stat">
              <div>{stat.value}</div>
              <span>{stat.label}</span>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .um-page-hero {
    background: var(--skin-hero-bg);
    color: var(--skin-hero-text);
    padding-bottom: clamp(48px, 6vw, 82px);
  }

  .um-page-hero.is-compact {
    padding-bottom: clamp(40px, 5vw, 64px);
  }

  .um-page-hero__wash {
    background: var(--skin-hero-wash);
  }

  .um-page-hero__image {
    filter: var(--skin-media-filter);
  }

  .um-page-crumbs {
    color: var(--skin-hero-muted);
  }

  .um-page-crumbs span {
    color: var(--skin-hero-text);
  }

  .um-page-crumbs a:hover {
    color: var(--skin-hero-text);
  }

  .um-page-hero__grid {
    display: grid;
    gap: clamp(32px, 5vw, 64px);
    align-items: end;
  }

  .um-page-hero__grid.has-stats {
    grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.72fr);
  }

  .um-page-label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    color: #DC2626;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
  }

  .um-page-label::before {
    content: "";
    display: inline-block;
    width: 34px;
    height: 2px;
    background: #DC2626;
  }

  .um-page-title {
    max-width: 860px;
    margin-bottom: clamp(18px, 2vw, 26px);
    color: var(--skin-hero-text);
    font-size: clamp(2.3rem, 3.9vw, 4.05rem);
    font-weight: var(--um-weight-title, 600);
    letter-spacing: 0;
    line-height: 1.06;
    text-wrap: balance;
  }

  .um-page-title span {
    color: #DC2626;
  }

  .um-page-subtitle {
    max-width: 720px;
    color: var(--skin-hero-muted);
    font-size: clamp(1.05rem, 1.25vw, 1.22rem);
    line-height: 1.62;
  }

  .um-page-stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(132px, 1fr));
    gap: 1px;
    border: 1px solid var(--skin-hero-line);
    background: var(--skin-hero-line);
  }

  .um-page-stat {
    min-height: 118px;
    padding: 1.35rem;
    background: var(--skin-hero-panel-solid);
  }

  .um-page-stat div {
    color: var(--skin-hero-text);
    font-size: clamp(1.7rem, 3vw, 3rem);
    font-weight: 700;
    line-height: 1;
  }

  .um-page-stat span {
    display: block;
    margin-top: 0.65rem;
    color: var(--skin-hero-muted);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
    text-transform: uppercase;
  }

  @media (max-width: 900px) {
    .um-page-hero__grid.has-stats {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 640px) {
    .um-page-title {
      font-size: clamp(2.05rem, 9vw, 2.9rem);
      line-height: 1.08;
    }

    .um-page-stats {
      grid-template-columns: 1fr;
    }
  }
</style>
