---
import { pageContactLink } from '../../lib/caseJourney';
/**
 * Barra de pestañas inferior para teléfono (app shell). Cuatro destinos fijos,
 * estado activo por ruta, safe-area iOS y sin JS obligatorio. Se oculta cuando
 * el menú móvil está abierto y en escritorio no existe.
 */
import { APP_TABS, directoryReturnHref } from '../../data/navigation';
import { shellLocale, shellRoutes } from '../../config/i18nShell';

interface Props { currentPath?: string }
const { currentPath = Astro.url.pathname } = Astro.props;
const clean = currentPath.replace(/\/$/, '') || '/';
const { lang, t } = shellLocale(currentPath);
const routes = shellRoutes(lang);
const tabHref: Record<string, string> = { '/sectores': routes.sectors, '/servicios': routes.services, '/antecedentes': routes.projects, '/contacto': routes.contact };
const tabLabel: Record<string, string> = { '/sectores': lang === 'en' ? t.destinationLabel(t.nav.sectors) : t.nav.sectors, '/servicios': t.tabs.services, '/antecedentes': lang === 'en' ? t.destinationLabel(t.tabs.projects) : t.tabs.projects, '/contacto': t.tabs.contact };
function currentSection(href: string) {
  const target = tabHref[href] || href;
  if (clean === target) return 'page';
  if (clean.startsWith(target + '/') ||
      (target === routes.sectors && ['/software', '/seguridad-electronica'].includes(clean))) return 'location';
}

const ICONS: Record<(typeof APP_TABS)[number]['icon'], string> = {
  services: '<rect x="3" y="4" width="18" height="6" rx="1"/><rect x="3" y="14" width="18" height="6" rx="1"/><path d="M7 7h.01M7 17h.01"/>',
  sectors: '<path d="M3 21h18"/><path d="M5 21V8l7-5 7 5v13"/><path d="M9 21v-6h6v6"/><path d="M9 11h.01M15 11h.01"/>',
  projects: '<path d="M4 20V6a2 2 0 0 1 2-2h5l2 2h5a2 2 0 0 1 2 2v12"/><path d="M4 20h16"/><path d="M8 14h8M8 17h5"/>',
  contact: '<path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/>',
};
---
<nav class="um-tabbar" aria-label={t.tabs.aria}>
  {APP_TABS.map((tab) => (
    <a data-contact-follow={tab.href === '/contacto' || undefined} href={tab.href === '/contacto' ? pageContactLink(Astro, routes.contact) : directoryReturnHref(tabHref[tab.href] || tab.href, currentPath)} class:list={['um-tabbar__item', { 'is-active': Boolean(currentSection(tab.href)) }]} aria-current={currentSection(tab.href)}>
      <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[tab.icon]} />
      <span>{tabLabel[tab.href] || tab.label}</span>
    </a>
  ))}
</nav>

<script>
  const tabBar = document.querySelector<HTMLElement>('.um-tabbar');
  if (tabBar) {
    const root = document.documentElement;
    const header = document.querySelector<HTMLElement>('.um-ops-header');
    const updateInset = () => {
      if (tabBar.offsetHeight) root.style.setProperty('--um-tabbar-height', `${tabBar.offsetHeight}px`);
    };
    updateInset();
    if ('ResizeObserver' in window) new ResizeObserver(updateInset).observe(tabBar);

    // El navegador puede dar foco a un elemento parcialmente tapado por la navegación fija.
    document.addEventListener('focusin', ({ target }) => {
      if (!(target instanceof HTMLElement) || target.closest(
        '.um-ops-header, .um-tabbar, .um-ops-mobile, .indice-ficha, dialog, [role="dialog"], .um-skip-link',
      )) return;
      requestAnimationFrame(() => {
        if (document.activeElement !== target || !target.matches(':focus-visible')) return;
        const focused = target.getBoundingClientRect();
        let headerBottom = Math.max(0, header?.getBoundingClientRect().bottom ?? 0);
        const index = document.querySelector<HTMLElement>('.indice-ficha[data-enhanced]')?.getBoundingClientRect();
        if (index && index.top <= headerBottom + 1) headerBottom = Math.max(headerBottom, index.bottom);
        if (focused.top < headerBottom && focused.bottom > 0) {
          window.scrollBy({ top: focused.top - headerBottom - 8, behavior: 'instant' });
          return;
        }
        if (!tabBar.offsetHeight) return;
        const bar = tabBar.getBoundingClientRect();
        if (focused.bottom <= bar.top || focused.top >= bar.bottom) return;
        const shift = Math.min(focused.bottom - bar.top + 8, focused.top - headerBottom - 8);
        if (shift > 0) window.scrollBy({ top: shift, behavior: 'instant' });
      });
    });
  }
</script>

<style>
  .um-tabbar {
    display: none;
  }

  @media (max-width: 760px) {
    :global(html) { scroll-padding-bottom: calc(var(--um-tabbar-height, 59px + env(safe-area-inset-bottom, 0px)) + 16px); }
    .um-tabbar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: var(--um-z-sticky);
      display: grid;
      grid-template-columns: repeat(4, auto);
      padding-bottom: env(safe-area-inset-bottom, 0px);
      background: rgba(10, 10, 11, 0.94);
      backdrop-filter: blur(14px);
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      color: #a1a1aa;
    }

    :global(html.um-ops-menu-open) .um-tabbar {
      display: none;
    }

    .um-tabbar__item {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      min-width: 0;
      min-height: 58px;
      padding: 8px clamp(4px, 1.2vw, 12px) 6px;
      color: inherit;
      text-decoration: none;
      font-size: 1rem;
      font-weight: 600;
      line-height: 1;
      position: relative;
      -webkit-tap-highlight-color: transparent;
    }

    .um-tabbar__item svg {
      width: 22px;
      height: 22px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.7;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .um-tabbar__item span {
      font-size: clamp(.875rem, 3.9vw, 1rem);
      text-align: center;
      max-width: 100%;
      overflow-wrap: anywhere;
      letter-spacing: 0.01em;
    }

    @media (max-width: 360px) {
      .um-tabbar__item span { font-size: .8125rem; letter-spacing: 0; }
    }

    .um-tabbar__item.is-active {
      background: #f4f4f5;
      color: #111;
    }

    @media (hover: hover) and (pointer: fine) {
      .um-tabbar__item:hover:not(.is-active) {
        color: #fff;
        background: rgba(255, 255, 255, 0.08);
      }
    }

    .um-tabbar__item.is-active::before {
      content: "";
      position: absolute;
      top: -1px;
      left: 18%;
      right: 18%;
      height: 2px;
      background: #dc2626;
    }

    .um-tabbar__item:active:not(.is-active) {
      background: rgba(255, 255, 255, 0.05);
    }

    .um-tabbar__item:focus-visible {
      outline: 2px solid currentColor;
      outline-offset: -4px;
    }

    /* El contenido y el pie dejan lugar a la barra (el layout fija body
       padding: 0, por eso la especificidad del atributo). */
    :global(body[data-skin]) {
      padding-bottom: var(--um-tabbar-height, calc(59px + env(safe-area-inset-bottom, 0px)));
    }
  }
</style>
