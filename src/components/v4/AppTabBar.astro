---
/**
 * Barra de pestañas inferior para teléfono (app shell). Cinco destinos fijos,
 * estado activo por ruta, safe-area iOS y sin JS obligatorio. Se oculta cuando
 * el menú móvil está abierto y en escritorio no existe.
 */
import { APP_TABS } from '../../data/navigation';

interface Props { currentPath?: string }
const { currentPath = Astro.url.pathname } = Astro.props;
const clean = currentPath.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? clean === '/' : clean.startsWith(href));

const ICONS: Record<(typeof APP_TABS)[number]['icon'], string> = {
  home: '<path d="M3 11 12 4l9 7"/><path d="M5 10v10h5v-6h4v6h5V10"/>',
  services: '<rect x="3" y="4" width="18" height="6" rx="1"/><rect x="3" y="14" width="18" height="6" rx="1"/><path d="M7 7h.01M7 17h.01"/>',
  sectors: '<path d="M3 21h18"/><path d="M5 21V8l7-5 7 5v13"/><path d="M9 21v-6h6v6"/><path d="M9 11h.01M15 11h.01"/>',
  projects: '<path d="M4 20V6a2 2 0 0 1 2-2h5l2 2h5a2 2 0 0 1 2 2v12"/><path d="M4 20h16"/><path d="M8 14h8M8 17h5"/>',
  contact: '<path d="M4 6h16v12H4z"/><path d="m4 7 8 6 8-6"/>',
};
---
<nav class="um-tabbar" aria-label="Navegación rápida">
  {APP_TABS.map((tab) => (
    <a href={tab.href} class:list={['um-tabbar__item', { 'is-active': isActive(tab.href) }]} aria-current={isActive(tab.href) ? 'page' : undefined}>
      <svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICONS[tab.icon]} />
      <span>{tab.label}</span>
    </a>
  ))}
</nav>

<style>
  .um-tabbar {
    display: none;
  }

  @media (max-width: 760px) {
    .um-tabbar {
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: var(--um-z-sticky);
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      padding-bottom: env(safe-area-inset-bottom, 0px);
      background: rgba(10, 10, 11, 0.94);
      backdrop-filter: blur(14px);
      border-top: 1px solid rgba(255, 255, 255, 0.12);
      color: #a1a1aa;
    }

    :global(html.um-ops-menu-open) .um-tabbar {
      display: none;
    }

    .um-tabbar__item {
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 4px;
      min-height: 58px;
      padding: 8px 2px 6px;
      color: inherit;
      text-decoration: none;
      font-size: 1rem;
      font-weight: 600;
      line-height: 1;
      position: relative;
      -webkit-tap-highlight-color: transparent;
    }

    .um-tabbar__item svg {
      width: 22px;
      height: 22px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.7;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .um-tabbar__item span {
      font-size: 1rem;
      letter-spacing: 0.01em;
    }

    .um-tabbar__item.is-active {
      color: #fff;
    }

    .um-tabbar__item.is-active::before {
      content: "";
      position: absolute;
      top: -1px;
      left: 18%;
      right: 18%;
      height: 2px;
      background: #dc2626;
    }

    .um-tabbar__item:active {
      background: rgba(255, 255, 255, 0.05);
    }

    .um-tabbar__item:focus-visible {
      outline: 2px solid #dc2626;
      outline-offset: -2px;
    }

    /* El contenido y el pie dejan lugar a la barra (el layout fija body
       padding: 0, por eso la especificidad del atributo). */
    :global(body[data-skin]) {
      padding-bottom: calc(58px + env(safe-area-inset-bottom, 0px));
    }

    /* La barra reemplaza al botón flotante de contacto. */
    :global(.um-ops-dock) {
      display: none !important;
    }
  }
</style>
