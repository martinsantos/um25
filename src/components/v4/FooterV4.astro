---
/**
 * FooterV4 - Dark Footer (V6 Dark Premium)
 * - bg-gray-900 with white text
 * - Clean grid, refined typography
 */

const currentYear = new Date().getFullYear();

const footerSections = {
  servicios: {
    title: 'Servicios',
    links: [
      { href: '/servicios/101/infraestructura-de-redes-cableado-fibra-optica-radioenlaces', label: 'Infraestructura de Redes' },
      { href: '/servicios/102/sistemas-de-seguridad-electronica-cctv-control-acceso-sistemas-de-deteccion-de-incendios-sdi', label: 'Seguridad Electrónica' },
      { href: '/servicios/103/telecomunicaciones-datos-voz-video', label: 'Telecomunicaciones' },
      { href: '/servicios/104/desarrollo-de-software-a-medida-web-mobile-erp', label: 'Desarrollo de Software' },
      { href: '/servicios/105/soporte-tecnico-247-mesa-de-ayuda-mantenimiento-it', label: 'Soporte Técnico 24/7' },
    ],
  },
  empresa: {
    title: 'Empresa',
    links: [
      { href: '/nosotros', label: 'Nosotros' },
      { href: '/antecedentes', label: 'Antecedentes' },
      { href: '/sectores', label: 'Sectores' },
      { href: '/contacto', label: 'Contacto' },
    ],
  },
};

const socialLinks = [
  {
    href: 'https://www.linkedin.com/company/ultimamilla',
    label: 'LinkedIn',
    icon: 'linkedin'
  },
  {
    href: 'https://twitter.com/ultimamilla',
    label: 'Twitter',
    icon: 'twitter'
  },
];
---

<footer class="relative bg-gray-950 text-white">
  <!-- Subtle gradient top edge -->
  <div class="absolute inset-x-0 top-0 h-px bg-gradient-to-r from-transparent via-gray-700 to-transparent"></div>
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 py-12 sm:py-16">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-10 lg:gap-12">

      <!-- Brand Column -->
      <div>
        <div class="mb-6">
          <span class="text-lg font-semibold text-white tracking-tight">
            ultima<span class="text-red-400 font-bold">milla</span>
          </span>
        </div>
        <p class="text-sm text-gray-400 leading-relaxed mb-6">
          Transformación digital para empresas en Mendoza, Cuyo y Patagonia. +22 años de experiencia en soluciones IT.
        </p>
        <div class="flex gap-3">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="w-9 h-9 rounded-lg bg-gray-800 flex items-center justify-center hover:bg-um-primary text-gray-400 hover:text-white transition-all min-h-[44px] min-w-[44px]"
              aria-label={`Seguir a Ultima Milla en ${social.label}`}
            >
              {social.icon === 'linkedin' && (
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              )}
              {social.icon === 'twitter' && (
                <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <!-- Servicios Column -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-5">{footerSections.servicios.title}</h4>
        <ul class="space-y-3 text-sm">
          {footerSections.servicios.links.map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Empresa Column -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-5">{footerSections.empresa.title}</h4>
        <ul class="space-y-3 text-sm">
          {footerSections.empresa.links.map((link) => (
            <li>
              <a href={link.href} class="text-gray-400 hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contacto Column -->
      <div>
        <h4 class="text-xs font-semibold uppercase tracking-widest text-gray-400 mb-5">Contacto</h4>
        <ul class="space-y-4 text-sm">
          <li class="flex items-start gap-3">
            <svg class="w-4 h-4 text-gray-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span class="text-gray-400">Houssay 1159, Guaymallén<br/>Mendoza M5519, Argentina</span>
          </li>
          <li class="flex items-center gap-3">
            <svg class="w-4 h-4 text-gray-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <a href="mailto:contacto@ultimamilla.com.ar" class="text-gray-400 hover:text-white transition-colors">
              contacto@ultimamilla.com.ar
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="border-t border-gray-800/50 mt-12 pt-8 flex flex-col sm:flex-row justify-between items-center gap-4">
      <p class="text-xs text-gray-500">&copy; {currentYear} Ultima Milla. Todos los derechos reservados.</p>
      <div class="flex gap-6 text-xs text-gray-500">
        <a href="/privacidad" class="hover:text-white transition-colors">Privacidad</a>
        <a href="/terminos" class="hover:text-white transition-colors">Términos</a>
      </div>
    </div>
  </div>
</footer>
