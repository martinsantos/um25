---
/**
 * FooterV4 - Footer responsivo V4 Design System
 * - Grid 1 → 2 → 4 columnas
 * - Links a todas las secciones
 * - Redes sociales
 * - Copyright dinámico
 */

import EmailLink from '../common/EmailLink.astro';

const currentYear = new Date().getFullYear();

// Footer navigation sections
const footerSections = {
  servicios: {
    title: 'Servicios',
    links: [
      { href: '/servicios/101/infraestructura-de-redes-cableado-fibra-optica-radioenlaces', label: 'Infraestructura de Redes' },
      { href: '/servicios/102/sistemas-de-seguridad-electronica-cctv-control-acceso-sistemas-de-deteccion-de-incendios-sdi', label: 'Seguridad Electrónica' },
      { href: '/servicios/103/telecomunicaciones-datos-voz-video', label: 'Telecomunicaciones' },
      { href: '/servicios/104/desarrollo-de-software-a-medida-web-mobile-erp', label: 'Desarrollo de Software' },
      { href: '/servicios/105/soporte-tecnico-247-mesa-de-ayuda-mantenimiento-it', label: 'Soporte Técnico 24/7' },
    ],
  },
  empresa: {
    title: 'Empresa',
    links: [
      { href: '/nosotros', label: 'Nosotros' },
      { href: '/antecedentes', label: 'Antecedentes' },
      { href: '/certificaciones', label: 'Certificaciones' },
      { href: '/sectores', label: 'Sectores' },
      { href: '/contacto', label: 'Contacto' },
    ],
  },
};

const socialLinks = [
  {
    href: 'https://www.linkedin.com/company/ultimamilla',
    label: 'LinkedIn',
    icon: 'linkedin'
  },
  {
    href: 'https://twitter.com/ultimamilla',
    label: 'Twitter',
    icon: 'twitter'
  },
];
---

<footer class="um-site-footer py-10 sm:py-12 lg:py-16">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8 sm:gap-10 lg:gap-12">

      <!-- Brand Column -->
      <div class="sm:text-left">
        <div class="flex items-center justify-start mb-4 sm:mb-6">
          <span class="um-footer-logo">ultimamilla<span>.</span>com<span>.</span>ar</span>
        </div>
        <p class="text-base leading-relaxed mb-4 sm:mb-6">
          Servicios IT integrales para continuidad operativa: redes, seguridad, software, energía y soporte para empresas en Mendoza, Cuyo y Patagonia.
        </p>
        <div class="flex gap-3 sm:gap-4 justify-center sm:justify-start">
          {socialLinks.map((social) => (
            <a
              href={social.href}
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="um-footer-social w-10 h-10 rounded-[4px] flex items-center justify-center transition-colors min-h-[44px] min-w-[44px]"
              aria-label={`Seguir a Ultima Milla en ${social.label}`}
            >
              {social.icon === 'linkedin' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
                </svg>
              )}
              {social.icon === 'twitter' && (
                <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
                </svg>
              )}
            </a>
          ))}
        </div>
      </div>

      <!-- Servicios Column -->
      <div class="text-center sm:text-left">
        <h4 class="font-bold mb-4 sm:mb-6">{footerSections.servicios.title}</h4>
        <ul class="space-y-2 sm:space-y-3 text-base">
          {footerSections.servicios.links.map((link) => (
            <li>
              <a href={link.href} class="transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Empresa Column -->
      <div class="text-center sm:text-left">
        <h4 class="font-bold mb-4 sm:mb-6">{footerSections.empresa.title}</h4>
        <ul class="space-y-2 sm:space-y-3 text-base">
          {footerSections.empresa.links.map((link) => (
            <li>
              <a href={link.href} class="transition-colors">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Contacto Column -->
      <div class="text-center sm:text-left">
        <h4 class="font-bold mb-4 sm:mb-6">Contacto</h4>
        <ul class="space-y-3 sm:space-y-4 text-base">
          <li class="flex items-start gap-3 justify-center sm:justify-start">
            <svg class="w-5 h-5 text-um-primary-light shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            <span class="text-left">Houssay 1159, Guaymallén<br/>Mendoza M5519, Argentina</span>
          </li>
          <li class="flex items-center gap-3 justify-center sm:justify-start">
            <svg class="w-5 h-5 text-um-primary-light shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            <EmailLink class="transition-colors" />
          </li>
        </ul>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="um-footer-bottom mt-8 sm:mt-12 pt-6 sm:pt-8 flex flex-col sm:flex-row justify-between items-center gap-4 text-center sm:text-left">
      <p class="text-base sm:text-base">© {currentYear} Ultima Milla. Todos los derechos reservados.</p>
      <div class="flex gap-4 sm:gap-6 text-base sm:text-base">
        <a href="/privacidad" class="transition-colors">Privacidad</a>
        <a href="/terminos" class="transition-colors">Términos</a>
      </div>
    </div>
  </div>
</footer>

<style>
  .um-site-footer {
    background: var(--skin-footer-bg);
    border-top: 1px solid var(--skin-footer-line);
    color: var(--skin-footer-text);
  }

  .um-footer-logo,
  .um-site-footer h4 {
    color: var(--skin-footer-heading);
  }

  .um-footer-logo {
    display: block;
    max-width: 100%;
    font-family: var(--um-font-logo);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1;
    overflow-wrap: anywhere;
  }

  .um-footer-logo span {
    color: var(--um-red);
  }

  .um-site-footer p,
  .um-site-footer li,
  .um-site-footer span {
    color: var(--skin-footer-text);
  }

  .um-site-footer a {
    color: inherit;
  }

  .um-site-footer a:hover {
    color: var(--skin-footer-heading);
  }

  .um-footer-social {
    background: color-mix(in srgb, var(--skin-footer-heading) 10%, transparent);
    color: var(--skin-footer-heading);
  }

  .um-footer-social:hover {
    background: var(--um-red);
    color: #fff;
  }

  .um-footer-bottom {
    border-top: 1px solid var(--skin-footer-line);
  }
</style>
