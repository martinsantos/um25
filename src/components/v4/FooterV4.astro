---
import UMLogo from '../brand/UMLogo.astro';
/**
 * FooterV4 - Footer responsivo V4 Design System
 * - Grid 1 → 2 → 4 columnas
 * - Links a todas las secciones
 * - Redes sociales
 * - Copyright dinámico
 */

import EmailLink from '../common/EmailLink.astro';
import { commercialHubLinkItems, commercialHubShortLabels } from '../../data/strategicLinkGraph';
import { shellLocale } from '../../config/i18nShell';
const { t: shellT, alternate: alternateLangHref, alternateLang } = shellLocale(Astro.url.pathname);

const currentYear = new Date().getFullYear();
const commercialHubFooterLinks = commercialHubLinkItems.map((link) => ({
  href: link.href,
  label: commercialHubShortLabels[link.href] || link.label,
}));

// Footer navigation sections
const footerSections = {
  servicios: {
    title: 'Servicios',
    links: [
      { href: '/servicios/101/infraestructura-de-redes-cableado-fibra-optica-radioenlaces', label: 'Infraestructura de Redes' },
      { href: '/servicios/102/sistemas-de-seguridad-electronica-cctv-control-acceso-sistemas-de-deteccion-de-incendios-sdi', label: 'Seguridad Electrónica' },
      { href: '/servicios/103/telecomunicaciones-datos-voz-video', label: 'Telecomunicaciones' },
      { href: '/servicios/104/desarrollo-de-software-a-medida-web-mobile-erp', label: 'Desarrollo de Software' },
      { href: '/servicios/105/soporte-tecnico-247-mesa-de-ayuda-mantenimiento-it', label: 'Soporte Técnico 24/7' },
    ],
  },
  empresa: {
    title: 'Empresa',
    links: [
      { href: '/nosotros', label: 'Nosotros' },
      { href: '/antecedentes', label: 'Antecedentes' },
      { href: '/certificaciones', label: 'Certificaciones' },
      { href: '/sectores', label: 'Sectores' },
      { href: '/contacto', label: 'Contacto' },
    ],
  },
  hubs: {
    title: 'Sedes',
    links: [
      ...commercialHubFooterLinks,
    ],
  },
};

const socialLinks = [
  {
    href: 'https://www.linkedin.com/company/ultimamilla',
    label: 'LinkedIn',
    icon: 'linkedin'
  },
  {
    href: 'https://twitter.com/ultimamilla',
    label: 'Twitter',
    icon: 'twitter'
  },
];
---

<footer class="um-site-footer um-foot">
  <div class="um-foot__shell">
    <div class="um-foot__row um-foot__brand">
      <a href="/" class="um-footer-logo" aria-label="Ir al inicio"><UMLogo title="ultimamilla.com.ar" /></a>
      <p class="um-foot__line">Houssay 1159, Guaymallén, Mendoza · <EmailLink class="um-footer-email" /> · Lunes a viernes, 8 a 18 h</p>
    </div>
    <nav class="um-foot__row um-foot__links" aria-label="Enlaces del pie">
      {footerSections.hubs.links.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
      <a href="/certificaciones">Certificaciones</a>
      <a href="/privacidad">{shellT.footer.privacy}</a>
      <a href="/terminos">{shellT.footer.terms}</a>
      <a href={alternateLangHref} class="um-footer-lang" hreflang={alternateLang} lang={alternateLang}>{shellT.lang.switchTo}</a>
      <span class="um-foot__copy">© {currentYear} Ultima Milla</span>
    </nav>
  </div>
</footer>

<style>
  .um-site-footer { background: var(--skin-footer-bg); border-top: 1px solid var(--skin-footer-line); color: var(--skin-footer-text); overflow-x: clip; }
  .um-footer-logo { color: var(--skin-footer-heading); }
  /* Barrido 24/10: pie de dos líneas (marca y datos directos; enlaces útiles). Sin columnas, redes ni descripción. */
  .um-foot { padding: 28px 0 36px; }
  .um-foot__shell { width: min(1400px, 100% - 48px); margin: 0 auto; display: grid; gap: 14px; }
  .um-foot__row { display: flex; flex-wrap: wrap; align-items: center; gap: 10px 24px; font-size: 1rem; line-height: 1.5; }
  .um-foot__brand { justify-content: space-between; }
  .um-footer-logo { display: inline-flex; width: 168px; }
  .um-foot__line { margin: 0; color: inherit; opacity: 0.86; }
  .um-foot__links a { color: inherit; text-decoration: none; opacity: 0.86; }
  .um-foot__links a:hover, .um-foot__links a:focus-visible { opacity: 1; text-decoration: underline; text-decoration-color: #dc2626; text-underline-offset: 5px; }
  .um-foot__copy { margin-left: auto; opacity: 0.7; }
  @media (max-width: 760px) {
    .um-foot__shell { width: min(1400px, 100% - 32px); }
    .um-foot__copy { margin-left: 0; }
  }
</style>
