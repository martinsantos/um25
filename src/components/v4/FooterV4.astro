---
import UMLogo from '../brand/UMLogo.astro';
import EmailLink from '../common/EmailLink.astro';
import { commercialHubLinkItems } from '../../data/strategicLinkGraph';
import { shellLocale } from '../../config/i18nShell';
import { publicDespiecePath } from '../../lib/despieceRoutes';
const { lang, t: shellT, alternate: alternateLangHref, alternateLang } = shellLocale(publicDespiecePath(Astro.url.pathname));

const currentYear = new Date().getFullYear();
const englishHubLabels: Record<string, string> = {
  '/servicios-it-empresas-mendoza': 'IT services in Mendoza',
  '/presupuesto-servicios-it-empresas': 'IT quote',
  '/proyectos-ingenieria-it-mendoza': 'IT engineering',
  '/servicios-it-empresas-argentina': 'IT services in Argentina',
};
const solutions = lang === 'en'
  ? commercialHubLinkItems.map((link) => ({
      href: link.href,
      label: shellT.destinationLabel(englishHubLabels[link.href] || link.label),
    }))
  : commercialHubLinkItems;

interface Props { compactBrand?: boolean }
const { compactBrand = false } = Astro.props;
const companyLinks = lang === 'en'
  ? [
      { href: '/en/about', label: 'About' },
      { href: '/en/services', label: shellT.nav.services },
      { href: '/blog', label: shellT.destinationLabel(shellT.nav.blog) },
      { href: '/certificaciones', label: 'Technical documentation (ES)' },
    ]
  : [
      { href: '/nosotros', label: 'Nosotros' },
      { href: '/documentacion', label: 'Documentación técnica' },
      { href: '/blog', label: shellT.nav.blog },
      { href: '/certificaciones', label: 'Certificaciones' },
    ];
---

<footer class="um-site-footer">
  <slot />
  <div class="um-foot">
    <div class="um-foot__shell">
      <div class="um-foot__brand">
        <a href={lang === 'en' ? '/en' : '/'} class="um-footer-logo" aria-label={shellT.footerShell.home}><UMLogo title="ultimamilla.com.ar" /></a>
        {compactBrand
          ? <p>{lang === 'en' ? 'IT services since 2003. Mendoza, Argentina.' : 'Servicios IT desde 2003. Mendoza, Argentina.'}</p>
          : <div class="um-foot__contact">
              <p>Houssay 1159, Guaymallén, Mendoza</p>
              <EmailLink class="um-footer-email" hrefFallback={lang === 'en' ? '/en/contact' : '/contacto'} />
              <p>{shellT.footerShell.locationHours}</p>
            </div>}
      </div>
      <nav class="um-foot__links" aria-label={lang === 'en' ? 'Footer links' : 'Enlaces del pie'}>
        <div class="um-foot__group">
          <p>{shellT.footerShell.company}</p>
          <ul>
            {companyLinks.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </div>
        <div class="um-foot__group">
          <p>{lang === 'en' ? 'Solutions and coverage' : 'Soluciones y cobertura'}</p>
          <ul>
            {solutions.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
            {lang === 'es' && <li><a href="/cctvai">UMSA CCTV AI</a></li>}
          </ul>
        </div>
        <div class="um-foot__legal">
          <a href="/privacidad">{shellT.destinationLabel(shellT.footer.privacy)}</a>
          <a href="/terminos">{shellT.destinationLabel(shellT.footer.terms)}</a>
          <a href={alternateLangHref} hreflang={alternateLang} lang={alternateLang}>{shellT.lang.switchTo}</a>
          <span>© {currentYear} Ultima Milla</span>
        </div>
      </nav>
    </div>
  </div>
</footer>

<style>
  .um-foot {
    background: var(--skin-footer-bg, var(--bg));
    border-top: 1px solid var(--skin-footer-line, var(--line));
    color: var(--skin-footer-text, var(--ink-2));
    padding-block: clamp(24px, 4vw, 48px) 16px;
  }
  .um-foot__shell {
    width: min(var(--um-container-wide, 1400px), calc(100% - var(--um-page-gutter, 20px) * 2));
    margin-inline: auto;
    display: grid;
    grid-template-columns: minmax(0, 4fr) minmax(0, 8fr);
    gap: 16px clamp(24px, 6vw, 96px);
    font-size: 1rem;
    line-height: 1.4;
  }
  .um-foot__brand > p { margin: 8px 0 0; }
  .um-foot__contact p { margin: 0; }
  .um-footer-logo {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    max-width: 100%;
    font-size: clamp(.95rem, 1.55vw, 1.2rem);
    color: var(--skin-footer-heading, var(--ink));
  }
  .um-foot__links {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px clamp(16px, 4vw, 64px);
  }
  .um-foot__group p {
    margin: 0;
    overflow-wrap: anywhere;
    padding-bottom: 6px;
    border-bottom: 1px solid var(--skin-footer-line, var(--line));
    color: var(--skin-footer-heading, var(--ink));
    font-weight: 650;
  }
  .um-foot__group ul { list-style: none; padding: 0; margin: 0; }
  .um-foot__legal {
    grid-column: 1 / -1;
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0 18px;
    border-top: 1px solid var(--skin-footer-line, var(--line));
  }
  .um-foot__legal span { margin-inline-start: auto; }
  .um-foot__links a, .um-foot__contact :global(a) {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 4px 0;
    max-width: 100%;
    overflow-wrap: anywhere;
    color: inherit;
    text-decoration: none;
  }
  .um-foot a:hover, .um-foot a:focus-visible {
    text-decoration: underline;
    text-decoration-color: var(--um-red, #dc2626);
    text-underline-offset: 4px;
  }
  .um-foot a:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  @media (max-width: 760px) {
    .um-foot__shell { grid-template-columns: minmax(0, 1fr); }
    .um-foot__legal span { margin-inline-start: 0; }
  }
</style>
