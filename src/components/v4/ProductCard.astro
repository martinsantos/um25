---
/**
 * ProductCard Component V4
 *
 * Card de producto con imagen, título, descripción, features y marcas.
 * Usado en página de detalle de servicio para mostrar productos/soluciones.
 *
 * Props:
 * - titulo: Título del producto
 * - descripcion: Descripción completa del producto
 * - imagen: URL de la imagen o UUID de Directus
 * - features: Array de strings con características (bullets)
 * - destacado: Texto destacado o diferenciador
 * - marcas: Array de strings con nombres de marcas
 * - imagePosition: 'left' | 'right' - Posición de la imagen
 * - orden: Número de orden (para alternar automáticamente)
 *
 * Ejemplo de uso:
 * <ProductCard
 *   titulo="Fibra Óptica de Alta Capacidad"
 *   descripcion="Implementamos redes de fibra óptica..."
 *   imagen="https://..."
 *   features={['Fusiones certificadas', 'Cables armados', 'Bandeja de empalmes']}
 *   marcas={['Furukawa', 'Commscope', 'Corning']}
 *   destacado="Con garantía de 25 años"
 *   imagePosition="left"
 * />
 */

import { getDirectusImageUrl } from '../../lib/directus.ts';

export interface Props {
  titulo: string;
  descripcion: string;
  imagen?: string;
  features?: string[];
  destacado?: string;
  marcas?: string[];
  imagePosition?: 'left' | 'right';
  orden?: number;
  className?: string;
}

const {
  titulo,
  descripcion,
  imagen,
  features = [],
  destacado,
  marcas = [],
  imagePosition,
  orden = 0,
  className = ''
} = Astro.props;

// Alternar posición automáticamente si no se especifica
const position = imagePosition || (orden % 2 === 0 ? 'left' : 'right');
const flexDirection = position === 'left' ? 'md:flex-row' : 'md:flex-row-reverse';

// Process image: ONLY from Directus - NO fallbacks
const imagenUrl = imagen ? getDirectusImageUrl(imagen) : '';
if (!imagenUrl && imagen) {
  console.error(`[ProductCard] Invalid image for ${titulo}: ${imagen}`);
}

// Validar que haya contenido
const hasFeatures = features.length > 0;
const hasMarcas = marcas.length > 0;
---

<div class={`flex flex-col ${flexDirection} items-center gap-6 sm:gap-8 lg:gap-12 ${className}`}>
  <!-- Imagen -->
  <div class="w-full md:w-1/2">
    <div class="relative">
      {imagenUrl ? (
        <img
          src={imagenUrl}
          alt={titulo}
          class="w-full rounded-2xl shadow-xl product-image"
          loading="lazy"
        />
      ) : (
        <div class="w-full aspect-video rounded-2xl bg-gray-100 flex items-center justify-center">
          <p class="text-gray-400 text-sm">Imagen no disponible</p>
        </div>
      )}
    </div>
  </div>

  <!-- Contenido -->
  <div class="w-full md:w-1/2 space-y-6">
    <!-- Título -->
    <h3 class="text-2xl font-bold text-slate-900">
      {titulo}
    </h3>

    <!-- Descripción -->
    <p class="text-slate-600 leading-relaxed text-lg">
      {descripcion}
    </p>

    <!-- Features (bullets con checkmarks) -->
    {hasFeatures && (
      <ul class="space-y-3">
        {features.map((feature) => (
          <li class="flex items-start space-x-3">
            <span class="text-um-primary font-bold text-xl leading-none mt-0.5">✓</span>
            <span class="text-slate-700">{feature}</span>
          </li>
        ))}
      </ul>
    )}

    <!-- Destacado con marcas -->
    {(destacado || hasMarcas) && (
      <div class="p-4 bg-sky-50 border-l-4 border-um-primary rounded-r-lg">
        {destacado && (
          <p class="text-sky-900 text-sm mb-2">
            {destacado}
          </p>
        )}
        {hasMarcas && (
          <p class="text-sky-900 font-medium text-sm">
            <strong>Marcas:</strong> {marcas.join(', ')}
          </p>
        )}
      </div>
    )}
  </div>
</div>

<style>
  /* Efecto de imagen con máscara radial (como en HTML original) */
  .product-image {
    mix-blend-mode: multiply;
    -webkit-mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, black 70%, transparent 100%);
    mask-image: radial-gradient(ellipse 90% 90% at 50% 50%, black 70%, transparent 100%);
  }

  /* Hover effect sutil en imagen */
  .product-image {
    transition: transform 0.4s ease, box-shadow 0.4s ease;
  }

  .product-image:hover {
    transform: scale(1.02);
    box-shadow: 0 25px 50px rgba(0, 0, 0, 0.15);
  }

  /* Animación para features */
  @media (prefers-reduced-motion: no-preference) {
    ul li {
      animation: fadeInLeft 0.5s ease-out;
      animation-fill-mode: both;
    }

    ul li:nth-child(1) { animation-delay: 0.1s; }
    ul li:nth-child(2) { animation-delay: 0.2s; }
    ul li:nth-child(3) { animation-delay: 0.3s; }
    ul li:nth-child(4) { animation-delay: 0.4s; }
    ul li:nth-child(5) { animation-delay: 0.5s; }
  }

  @keyframes fadeInLeft {
    from {
      opacity: 0;
      transform: translateX(-20px);
    }
    to {
      opacity: 1;
      transform: translateX(0);
    }
  }

  /* Accesibilidad: reducir animaciones */
  @media (prefers-reduced-motion: reduce) {
    .product-image,
    .product-image:hover,
    ul li {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>
