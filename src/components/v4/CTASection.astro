---
/**
 * CTASection Component V6 - Bold Statement CTA (Dark Premium)
 * Two variants:
 * - Dark (default): gray-900 bg, white text, white primary button
 * - Light: gray-50 bg, dark text, red primary button
 */

import { Rocket, Phone, Mail, ArrowRight } from 'lucide-astro';

export interface Props {
  badge?: string;
  badgeIcon?: string;
  titulo: string;
  descripcion?: string;
  primaryButtonText: string;
  primaryButtonUrl: string;
  secondaryButtonText?: string;
  secondaryButtonUrl?: string;
  secondaryButtonIcon?: string;
  backgroundImage?: string;
  darkOverlay?: number;
  className?: string;
  variant?: 'light' | 'dark';
}

const {
  badge = 'Comience su transformación',
  badgeIcon = 'rocket',
  titulo,
  descripcion,
  primaryButtonText,
  primaryButtonUrl,
  secondaryButtonText,
  secondaryButtonUrl,
  secondaryButtonIcon = 'phone',
  backgroundImage,
  darkOverlay = 90,
  className = '',
  variant = 'dark'
} = Astro.props;

const badgeIcons: Record<string, any> = {
  'rocket': Rocket,
  'arrow-right': ArrowRight,
  'mail': Mail
};

const buttonIcons: Record<string, any> = {
  'phone': Phone,
  'mail': Mail,
  'arrow-right': ArrowRight
};

const BadgeIcon = badgeIcons[badgeIcon] || Rocket;
const SecondaryIcon = buttonIcons[secondaryButtonIcon] || Phone;
const hasSecondaryButton = secondaryButtonText && secondaryButtonUrl;

const isDark = variant === 'dark';
---

<section class={`relative py-16 sm:py-20 lg:py-28 overflow-hidden ${isDark ? 'bg-gray-900' : 'bg-gray-50 border-t border-gray-200'} ${className}`} style={isDark ? 'background: radial-gradient(ellipse at center, #1F2937 0%, #111827 70%);' : ''}>
  {/* Radial glow for dark variant */}
  {isDark && (
    <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-[500px] h-[300px] bg-red-600/[0.03] rounded-full blur-3xl pointer-events-none"></div>
  )}
  {/* Background image for dark variant */}
  {isDark && backgroundImage && (
    <div class="absolute inset-0">
      <img
        src={backgroundImage}
        alt=""
        class="w-full h-full object-cover opacity-10"
        loading="lazy"
        aria-hidden="true"
      />
      <div class="absolute inset-0 bg-gray-900/90"></div>
    </div>
  )}

  <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    {/* Badge */}
    {badge && (
      <span class={`inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold mb-6 ${
        isDark ? 'bg-white/10 text-white/80' : 'bg-gray-900 text-white'
      }`}>
        <BadgeIcon class="w-3.5 h-3.5" />
        {badge}
      </span>
    )}

    {/* Title */}
    <h2 class={`text-2xl sm:text-3xl lg:text-4xl font-bold mb-5 leading-tight ${
      isDark ? 'text-white' : 'text-gray-900'
    }`}>
      {titulo}
    </h2>

    {/* Description */}
    {descripcion && (
      <p class={`text-base sm:text-lg mb-10 max-w-2xl mx-auto leading-relaxed ${
        isDark ? 'text-gray-400' : 'text-gray-500'
      }`}>
        {descripcion}
      </p>
    )}

    {/* Buttons */}
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href={primaryButtonUrl}
        class={`px-7 py-3.5 font-semibold rounded-xl transition-all duration-300 min-h-[48px] flex items-center justify-center text-sm ${
          isDark
            ? 'bg-white text-gray-900 hover:bg-gray-100 shadow-elevated hover:shadow-prominent'
            : 'bg-um-primary text-white hover:bg-um-primary-dark shadow-red hover:shadow-red-lg'
        }`}
      >
        {primaryButtonText}
      </a>

      {hasSecondaryButton && (
        <a
          href={secondaryButtonUrl}
          class={`px-7 py-3.5 font-semibold rounded-xl transition-all flex items-center justify-center gap-2 min-h-[48px] text-sm ${
            isDark
              ? 'border border-gray-600 text-gray-300 hover:text-white hover:border-gray-400'
              : 'border border-gray-300 text-gray-600 hover:border-gray-400 hover:bg-white'
          }`}
        >
          <SecondaryIcon class="w-4 h-4" />
          {secondaryButtonText}
        </a>
      )}
    </div>
  </div>
</section>
