---
/**
 * CTASection Component V5 - Clean Statement CTA
 * Two variants:
 * - Light (default): subtle bg, dark text
 * - Dark: slate-900 bg, white text — use sparingly for contrast
 */

import { Rocket, Phone, Mail, ArrowRight } from 'lucide-astro';

export interface Props {
  badge?: string;
  badgeIcon?: string;
  titulo: string;
  descripcion?: string;
  primaryButtonText: string;
  primaryButtonUrl: string;
  secondaryButtonText?: string;
  secondaryButtonUrl?: string;
  secondaryButtonIcon?: string;
  backgroundImage?: string;
  darkOverlay?: number;
  className?: string;
  variant?: 'light' | 'dark';
}

const {
  badge = 'Comience su transformación',
  badgeIcon = 'rocket',
  titulo,
  descripcion,
  primaryButtonText,
  primaryButtonUrl,
  secondaryButtonText,
  secondaryButtonUrl,
  secondaryButtonIcon = 'phone',
  backgroundImage,
  darkOverlay = 90,
  className = '',
  variant = 'light'
} = Astro.props;

const badgeIcons: Record<string, any> = {
  'rocket': Rocket,
  'arrow-right': ArrowRight,
  'mail': Mail
};

const buttonIcons: Record<string, any> = {
  'phone': Phone,
  'mail': Mail,
  'arrow-right': ArrowRight
};

const BadgeIcon = badgeIcons[badgeIcon] || Rocket;
const SecondaryIcon = buttonIcons[secondaryButtonIcon] || Phone;
const hasSecondaryButton = secondaryButtonText && secondaryButtonUrl;

const isDark = variant === 'dark';
---

<section class={`relative py-16 sm:py-20 lg:py-28 overflow-hidden ${isDark ? 'bg-um-dark' : 'bg-um-surface'} ${className}`}>
  {/* Background image for dark variant */}
  {isDark && backgroundImage && (
    <div class="absolute inset-0">
      <img
        src={backgroundImage}
        alt=""
        class="w-full h-full object-cover opacity-20"
        loading="lazy"
        aria-hidden="true"
      />
      <div class="absolute inset-0 bg-um-dark/80"></div>
    </div>
  )}

  <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    {/* Accent line */}
    <div class="flex justify-center mb-8">
      <div class={`w-12 h-0.5 rounded-full ${isDark ? 'bg-um-primary' : 'bg-um-primary'}`}></div>
    </div>

    {/* Badge */}
    {badge && (
      <span class={`inline-flex items-center gap-2 px-3 py-1.5 rounded-full text-xs font-semibold mb-6 ${
        isDark ? 'bg-white/10 text-white/80' : 'bg-um-primary-light text-um-primary'
      }`}>
        <BadgeIcon class="w-3.5 h-3.5" />
        {badge}
      </span>
    )}

    {/* Title */}
    <h2 class={`text-2xl sm:text-3xl lg:text-4xl font-bold mb-5 leading-tight ${
      isDark ? 'text-white' : 'text-um-dark'
    }`}>
      {titulo}
    </h2>

    {/* Description */}
    {descripcion && (
      <p class={`text-base sm:text-lg mb-10 max-w-2xl mx-auto leading-relaxed ${
        isDark ? 'text-slate-400' : 'text-um-text-tertiary'
      }`}>
        {descripcion}
      </p>
    )}

    {/* Buttons */}
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href={primaryButtonUrl}
        class={`px-7 py-3.5 font-semibold rounded-xl transition-all min-h-[48px] flex items-center justify-center text-sm ${
          isDark
            ? 'bg-white text-um-dark hover:bg-slate-100 shadow-elevated'
            : 'bg-um-primary text-white hover:bg-um-primary-dark shadow-red hover:shadow-red-lg'
        }`}
      >
        {primaryButtonText}
      </a>

      {hasSecondaryButton && (
        <a
          href={secondaryButtonUrl}
          class={`px-7 py-3.5 font-semibold rounded-xl transition-all flex items-center justify-center gap-2 min-h-[48px] text-sm ${
            isDark
              ? 'border border-white/20 text-white hover:bg-white/10'
              : 'border border-um-border text-um-text-secondary hover:border-um-border-strong hover:bg-white'
          }`}
        >
          <SecondaryIcon class="w-4 h-4" />
          {secondaryButtonText}
        </a>
      )}
    </div>
  </div>
</section>
