---
/**
 * CTASection V8 — Clean, impactful CTA
 * Aurora gradient effect for dark variant
 */

import { Rocket, Phone, Mail, ArrowRight } from 'lucide-astro';

export interface Props {
  badge?: string;
  badgeIcon?: string;
  titulo: string;
  descripcion?: string;
  primaryButtonText: string;
  primaryButtonUrl: string;
  secondaryButtonText?: string;
  secondaryButtonUrl?: string;
  secondaryButtonIcon?: string;
  backgroundImage?: string;
  darkOverlay?: number;
  className?: string;
  variant?: 'light' | 'dark';
}

const {
  badge = 'Comience su transformación',
  badgeIcon = 'rocket',
  titulo,
  descripcion,
  primaryButtonText,
  primaryButtonUrl,
  secondaryButtonText,
  secondaryButtonUrl,
  secondaryButtonIcon = 'phone',
  backgroundImage,
  darkOverlay = 90,
  className = '',
  variant = 'dark'
} = Astro.props;

const badgeIcons: Record<string, any> = {
  'rocket': Rocket,
  'arrow-right': ArrowRight,
  'mail': Mail
};

const buttonIcons: Record<string, any> = {
  'phone': Phone,
  'mail': Mail,
  'arrow-right': ArrowRight
};

const BadgeIcon = badgeIcons[badgeIcon] || Rocket;
const SecondaryIcon = buttonIcons[secondaryButtonIcon] || Phone;
const hasSecondaryButton = secondaryButtonText && secondaryButtonUrl;

const isDark = variant === 'dark';
---

<section class={`relative py-20 sm:py-24 lg:py-32 overflow-hidden ${isDark ? 'bg-gray-950' : 'bg-gray-50 border-t border-gray-100'} ${className}`}>
  {/* Aurora glow for dark variant */}
  {isDark && (
    <>
      <div class="aurora-bg"></div>
      <div class="noise-overlay"></div>
    </>
  )}

  {/* Background image for dark variant */}
  {isDark && backgroundImage && (
    <div class="absolute inset-0">
      <img
        src={backgroundImage}
        alt=""
        class="w-full h-full object-cover opacity-10"
        loading="lazy"
        aria-hidden="true"
      />
      <div class="absolute inset-0 bg-gray-950/90"></div>
    </div>
  )}

  <div class="relative z-10 max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
    {/* Badge */}
    {badge && (
      <span class={`inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full text-xs font-medium mb-6 ${
        isDark ? 'bg-white/[0.06] border border-white/[0.08] text-gray-300' : 'bg-gray-900 text-white'
      }`}>
        <BadgeIcon class="w-3.5 h-3.5" />
        {badge}
      </span>
    )}

    {/* Title */}
    <h2 class={`text-fluid-title mb-4 ${
      isDark ? 'text-white' : 'text-gray-900'
    }`}>
      {titulo}
    </h2>

    {/* Description */}
    {descripcion && (
      <p class={`text-base mb-10 max-w-lg mx-auto leading-relaxed ${
        isDark ? 'text-gray-400' : 'text-gray-500'
      }`}>
        {descripcion}
      </p>
    )}

    {/* Buttons */}
    <div class="flex flex-col sm:flex-row gap-3 justify-center">
      <a
        href={primaryButtonUrl}
        class={`px-7 py-3.5 font-semibold rounded-xl transition-all duration-200 min-h-[48px] flex items-center justify-center text-sm ${
          isDark
            ? 'bg-white text-gray-900 hover:bg-gray-100 shadow-lg shadow-white/10'
            : 'bg-red-600 text-white hover:bg-red-700'
        }`}
      >
        {primaryButtonText}
      </a>

      {hasSecondaryButton && (
        <a
          href={secondaryButtonUrl}
          class={`px-7 py-3.5 font-medium rounded-xl transition-all flex items-center justify-center gap-2 min-h-[48px] text-sm ${
            isDark
              ? 'border border-white/15 text-gray-300 hover:text-white hover:border-white/25 hover:bg-white/[0.05]'
              : 'border border-gray-200 text-gray-600 hover:border-gray-300 hover:bg-white'
          }`}
        >
          <SecondaryIcon class="w-4 h-4" />
          {secondaryButtonText}
        </a>
      )}
    </div>
  </div>
</section>
