---
/**
 * CTASection Component V4
 *
 * Sección de llamada a la acción (Call To Action) con fondo de imagen,
 * badge, título, descripción y botones.
 *
 * Usado en homepage y páginas de servicio para promover conversión.
 *
 * Props:
 * - badge: Texto del badge superior (opcional)
 * - badgeIcon: Nombre del ícono de Lucide para el badge
 * - titulo: Título principal del CTA
 * - descripcion: Descripción/subtítulo
 * - primaryButtonText: Texto del botón principal
 * - primaryButtonUrl: URL del botón principal
 * - secondaryButtonText: Texto del botón secundario (opcional)
 * - secondaryButtonUrl: URL del botón secundario
 * - secondaryButtonIcon: Ícono del botón secundario
 * - backgroundImage: URL de imagen de fondo
 * - darkOverlay: Opacidad del overlay oscuro (0-100)
 *
 * Ejemplo de uso:
 * <CTASection
 *   badge="Diagnóstico inicial"
 *   badgeIcon="rocket"
 *   titulo="¿Listo para modernizar su infraestructura IT?"
 *   descripcion="Contáctenos para relevar alcance, riesgos y próximos pasos"
 *   primaryButtonText="Solicitar relevamiento"
 *   primaryButtonUrl="/contacto"
 *   secondaryButtonText="contacto@ultimamilla.com.ar"
 *   secondaryButtonUrl="mailto:contacto@ultimamilla.com.ar"
 *   secondaryButtonIcon="mail"
 * />
 */

import { Phone, Mail, ArrowRight, ClipboardCheck } from 'lucide-astro';

export interface Props {
  badge?: string;
  badgeIcon?: string;
  titulo: string;
  descripcion?: string;
  primaryButtonText: string;
  primaryButtonUrl: string;
  secondaryButtonText?: string;
  secondaryButtonUrl?: string;
  secondaryButtonIcon?: string;
  backgroundImage?: string;
  darkOverlay?: number;
  className?: string;
}

const {
  badge = 'Diagnóstico inicial',
  badgeIcon = 'clipboard',
  titulo,
  descripcion,
  primaryButtonText,
  primaryButtonUrl,
  secondaryButtonText,
  secondaryButtonUrl,
  secondaryButtonIcon = 'phone',
  backgroundImage,
  darkOverlay = 90,
  className = ''
} = Astro.props;

// Mapeo de iconos
const badgeIcons: Record<string, any> = {
  'clipboard': ClipboardCheck,
  'arrow-right': ArrowRight,
  'mail': Mail
};

const buttonIcons: Record<string, any> = {
  'phone': Phone,
  'mail': Mail,
  'arrow-right': ArrowRight
};

const BadgeIcon = badgeIcons[badgeIcon] || ClipboardCheck;
const SecondaryIcon = buttonIcons[secondaryButtonIcon] || Phone;

// Calcular opacidad del overlay (inline style — Tailwind JIT can't generate dynamic opacity classes)
const overlayOpacity = Math.min(Math.max(darkOverlay, 0), 100);
const overlayStyle = `background: color-mix(in srgb, var(--skin-hero-bg) ${overlayOpacity}%, transparent)`;

// Imagen de fondo por defecto
const bgImage = backgroundImage || 'https://ultimamilla.com.ar/directus-assets/caffbcaa-2457-4fc9-9960-2e0601f27736';

// Validar que haya botón secundario
const hasSecondaryButton = secondaryButtonText && secondaryButtonUrl;
---

<section class={`um-cta relative py-12 sm:py-16 lg:py-24 xl:py-28 overflow-hidden ${className}`}>
  <!-- Background Image -->
  <div class="absolute inset-0">
    <img
      src={bgImage}
      alt="Background"
      class="um-cta__image w-full h-full object-cover"
      loading="lazy"
    />
    <div class="absolute inset-0" style={overlayStyle}></div>
  </div>

  <!-- Content -->
  <div class="relative um-container um-cta__content">
    <!-- Badge -->
    {badge && (
      <span class="um-cta__label">
        <BadgeIcon class="w-4 h-4" aria-hidden="true" />
        {badge}
      </span>
    )}

    <!-- Título -->
    <h2 class="um-cta__title">
      {titulo}
    </h2>

    <!-- Descripción -->
    {descripcion && (
      <p class="um-cta__description">
        {descripcion}
      </p>
    )}

    <!-- Botones -->
    <div class="um-cta__actions">
      <!-- Botón Principal -->
      <a
        href={primaryButtonUrl}
        class="um-cta__primary"
      >
        {primaryButtonText}
      </a>

      <!-- Botón Secundario -->
      {hasSecondaryButton && (
        <a
          href={secondaryButtonUrl}
          class="um-cta__secondary"
        >
          <SecondaryIcon class="w-5 h-5" />
          {secondaryButtonText}
        </a>
      )}
    </div>
  </div>
</section>

<style>
  .um-cta__content {
    max-width: 980px;
    text-align: left;
  }

  .um-cta__label {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-bottom: 1.25rem;
    color: #DC2626;
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1;
    text-transform: uppercase;
  }

  .um-cta__label::before {
    content: "";
    display: inline-block;
    width: 34px;
    height: 2px;
    background: #DC2626;
  }

  .um-cta__title {
    max-width: 860px;
    color: var(--skin-hero-text);
    font-size: clamp(1.85rem, 2.65vw, 2.72rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1.08;
    text-wrap: balance;
  }

  .um-cta__description {
    max-width: 720px;
    margin-top: 1.25rem;
    color: var(--skin-hero-muted);
    font-size: clamp(1rem, 1.35vw, 1.22rem);
    line-height: 1.7;
  }

  .um-cta__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
    margin-top: 2rem;
  }

  .um-cta__primary,
  .um-cta__secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0.9rem 1.25rem;
    border-radius: 6px;
    font-weight: 700;
    line-height: 1;
    transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  .um-cta__primary {
    border: 1px solid #DC2626;
    background: #DC2626;
    color: #fff;
  }

  .um-cta__primary:hover {
    border-color: #DC2626;
    background: #DC2626;
  }

  .um-cta__secondary {
    gap: 0.5rem;
    border: 1px solid var(--skin-hero-line);
    color: var(--skin-hero-text);
  }

  .um-cta__secondary:hover {
    border-color: var(--skin-hero-text);
    background: var(--skin-hero-text);
    color: var(--skin-hero-bg);
  }

  .um-cta__image {
    filter: var(--skin-media-filter);
  }

  .um-cta__content,
  h2,
  p,
  .flex {
    animation: none;
  }

  a {
    transition: background-color 180ms ease, color 180ms ease, border-color 180ms ease;
  }

  /* Accesibilidad */
  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      animation-duration: 0.01ms !important;
      transition-duration: 0.01ms !important;
    }
  }

  /* Touch targets mínimos para móvil */
  @media (max-width: 640px) {
    .um-cta__actions {
      flex-direction: column;
      align-items: stretch;
    }

    .um-cta__primary,
    .um-cta__secondary {
      width: 100%;
    }
  }
</style>
