---
/**
 * ServiceCard — Proportional, Futura headings, real photos
 */
import { withBase } from '../../lib/directus.ts';

export interface Props {
  id: number | string;
  slug?: string;
  titulo: string;
  descripcion?: string;
  imagen?: string;
  badge?: string;
  badgeColor?: string;
  cliente?: string;
  href?: string;
  icon?: string;
  iconColor?: string;
  index?: number;
}

const { id, slug, titulo, descripcion = '', badge, cliente, href, index = 0 } = Astro.props;

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const serviceUrl = href || (slug ? `${BASE}/servicios/${id}/${slug}` : `${BASE}/servicios/${id}`);
const num = String(index + 1).padStart(2, '0');

const heroImageMap: Record<string, string> = {
  '101': 'foto-redes', '102': 'foto-seguridad', '103': 'foto-telecom', '104': 'foto-software',
  '105': 'foto-soporte', '106': 'foto-consultoria', '107': 'foto-incendios', '108': 'foto-electricos',
};
const imgName = heroImageMap[String(id)] || 'foto-redes';
const imagenUrl = withBase(`/images/hero/${imgName}.jpg`);

const shortNames: Record<string, string> = {
  '101': 'Redes', '102': 'Seguridad', '103': 'Telecom', '104': 'Software',
  '105': 'Soporte', '106': 'Consultoría', '107': 'Incendios', '108': 'Eléctricos',
};
const shortName = shortNames[String(id)] || badge || 'Servicio';
---

<a href={serviceUrl} class="group block">
  <article class="relative rounded-xl overflow-hidden aspect-[3/4] bg-gray-200">
    <img src={imagenUrl} alt={titulo}
      class="absolute inset-0 w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
      loading="lazy" />
    <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-black/5 to-black/10"></div>

    <!-- Content overlay -->
    <div class="absolute inset-0 flex flex-col justify-between p-3.5 sm:p-4">
      <span class="text-white/25 text-3xl sm:text-4xl font-bold leading-none">{num}</span>
      <div>
        <h3 class="text-white text-sm sm:text-base font-bold uppercase tracking-wide leading-tight">{shortName}</h3>
        <span class="text-white/40 text-[10px] font-mono uppercase tracking-[0.15em] group-hover:text-white/70 transition-colors">
          Ver →
        </span>
      </div>
    </div>
  </article>
</a>
