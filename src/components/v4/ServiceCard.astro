---
/**
 * ServiceCard Component V7 - Bold Icon Card with gradient border
 * - Syne typography for titles
 * - Gradient border on hover (animated)
 * - Large icon with dramatic color shift
 * - Spring easing animations
 */

export interface Props {
  id: number | string;
  slug?: string;
  titulo: string;
  descripcion?: string;
  imagen?: string;
  badge?: string;
  badgeColor?: string;
  cliente?: string;
  href?: string;
  icon?: string;
}

const {
  id,
  slug,
  titulo,
  descripcion = '',
  imagen,
  badge,
  badgeColor = 'bg-gray-800',
  cliente = 'Tecnología',
  href,
  icon = 'globe'
} = Astro.props;

const serviceUrl = href || (slug ? `/servicios/${id}/${slug}` : `/servicios/${id}`);

const descripcionTruncada = descripcion.length > 100
  ? descripcion.substring(0, 100) + '...'
  : descripcion;

// SVG icon paths for each service type
const iconPaths: Record<string, string> = {
  'network': '<path d="M9 2v6m6-6v6M9 16v6m6-6v6M2 9h6m-6 6h6m10-6h6m-6 6h6M12 12h.01"/><circle cx="12" cy="12" r="4"/>',
  'shield': '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>',
  'radio': '<path d="M16.72 11.06A10.94 10.94 0 0 1 19 12.55"/><path d="M5 12.55a10.94 10.94 0 0 1 2.28-1.49"/><circle cx="12" cy="20" r="2"/><path d="M8.53 16.11a6 6 0 0 1 6.95 0"/><path d="M12 2v8"/>',
  'code': '<polyline points="16 18 22 12 16 6"/><polyline points="8 6 2 12 8 18"/>',
  'headphones': '<path d="M3 18v-6a9 9 0 0 1 18 0v6"/><path d="M21 19a2 2 0 0 1-2 2h-1a2 2 0 0 1-2-2v-3a2 2 0 0 1 2-2h3zM3 19a2 2 0 0 0 2 2h1a2 2 0 0 0 2-2v-3a2 2 0 0 0-2-2H3z"/>',
  'settings': '<circle cx="12" cy="12" r="3"/><path d="M12 1v2m0 18v2M4.22 4.22l1.42 1.42m12.72 12.72l1.42 1.42M1 12h2m18 0h2M4.22 19.78l1.42-1.42M18.36 5.64l1.42-1.42"/>',
  'flame': '<path d="M8.5 14.5A2.5 2.5 0 0 0 11 12c0-1.38-.5-2-1-3-1.072-2.143-.224-4.054 2-6 .5 2.5 2 4.9 4 6.5 2 1.6 3 3.5 3 5.5a7 7 0 1 1-14 0c0-1.153.433-2.294 1-3a2.5 2.5 0 0 0 2.5 2.5z"/>',
  'zap': '<polygon points="13 2 3 14 12 14 11 22 21 10 12 10 13 2"/>',
  'globe': '<circle cx="12" cy="12" r="10"/><line x1="2" y1="12" x2="22" y2="12"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/>',
  'server': '<rect x="2" y="2" width="20" height="8" rx="2" ry="2"/><rect x="2" y="14" width="20" height="8" rx="2" ry="2"/><line x1="6" y1="6" x2="6.01" y2="6"/><line x1="6" y1="18" x2="6.01" y2="18"/>',
  'cpu': '<rect x="4" y="4" width="16" height="16" rx="2" ry="2"/><rect x="9" y="9" width="6" height="6"/><line x1="9" y1="1" x2="9" y2="4"/><line x1="15" y1="1" x2="15" y2="4"/><line x1="9" y1="20" x2="9" y2="23"/><line x1="15" y1="20" x2="15" y2="23"/><line x1="20" y1="9" x2="23" y2="9"/><line x1="20" y1="14" x2="23" y2="14"/><line x1="1" y1="9" x2="4" y2="9"/><line x1="1" y1="14" x2="4" y2="14"/>',
};

const iconSvg = iconPaths[icon] || iconPaths['globe'];
---

<a href={serviceUrl} class="group flex flex-col h-full">
  <article class="service-card flex flex-col h-full bg-white rounded-2xl overflow-visible relative">
    <!-- Gradient border overlay -->
    <div class="gradient-border-wrap"></div>

    <div class="relative z-10 bg-white rounded-2xl flex flex-col h-full">
      <!-- Icon — larger, bolder -->
      <div class="p-6 sm:p-7 pb-0 sm:pb-0">
        <div class="w-14 h-14 rounded-2xl bg-gray-900 flex items-center justify-center mb-5 group-hover:bg-um-primary transition-colors duration-500 ease-spring">
          <svg class="w-7 h-7 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={iconSvg} />
        </div>

        <h3 class="text-base sm:text-lg font-bold text-gray-900 mb-2 leading-snug line-clamp-2 transition-colors" style="font-family:'Syne','Inter',sans-serif;">
          {titulo}
        </h3>

        <p class="text-gray-500 text-[13px] leading-relaxed line-clamp-3 mb-5">
          {descripcionTruncada}
        </p>
      </div>

      <!-- Footer -->
      <div class="mt-auto px-6 sm:px-7 py-4 border-t border-gray-100/80">
        <span class="text-gray-900 group-hover:text-um-primary text-sm font-semibold flex items-center gap-1.5 group-hover:gap-2.5 transition-all duration-300 ease-spring">
          Explorar
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </span>
      </div>
    </div>
  </article>
</a>

<style>
  .service-card {
    border: 1px solid rgba(229, 231, 235, 0.6);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1),
                box-shadow 0.5s cubic-bezier(0.22, 1, 0.36, 1),
                border-color 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .service-card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 12px rgba(0,0,0,0.03), 0 24px 48px rgba(0,0,0,0.08);
    border-color: rgba(220, 38, 38, 0.2);
  }

  .gradient-border-wrap {
    position: absolute;
    inset: -1px;
    border-radius: 1rem;
    background: linear-gradient(135deg, rgba(220,38,38,0.4), transparent 40%, transparent 60%, rgba(220,38,38,0.2));
    opacity: 0;
    transition: opacity 0.5s ease;
    pointer-events: none;
    z-index: 0;
  }

  .service-card:hover .gradient-border-wrap {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .service-card {
      transition-duration: 0.01ms !important;
    }
  }
</style>
