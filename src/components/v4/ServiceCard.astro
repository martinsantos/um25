---
/**
 * ServiceCard — Brutalist: Full photo + giant type overlay
 * Like a magazine cover: photo fills everything, type sits on top
 */
import { withBase } from '../../lib/directus.ts';

export interface Props {
  id: number | string;
  slug?: string;
  titulo: string;
  descripcion?: string;
  imagen?: string;
  badge?: string;
  badgeColor?: string;
  cliente?: string;
  href?: string;
  icon?: string;
  iconColor?: string;
  index?: number;
}

const { id, slug, titulo, descripcion = '', badge, cliente, href, index = 0 } = Astro.props;

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const serviceUrl = href || (slug ? `${BASE}/servicios/${id}/${slug}` : `${BASE}/servicios/${id}`);

const num = String(index + 1).padStart(2, '0');

// Map service IDs to the new hero images
const heroImageMap: Record<string, string> = {
  '101': 'foto-redes', '102': 'foto-seguridad', '103': 'foto-telecom', '104': 'foto-software',
  '105': 'foto-soporte', '106': 'foto-consultoria', '107': 'foto-incendios', '108': 'foto-electricos',
};
const imgName = heroImageMap[String(id)] || 'hero-redes';
const imagenUrl = withBase(`/images/hero/${imgName}.jpg`);

// Short service name for overlay
const shortNames: Record<string, string> = {
  '101': 'Redes', '102': 'Seguridad', '103': 'Telecom', '104': 'Software',
  '105': 'Soporte', '106': 'Consultoría', '107': 'Incendios', '108': 'Eléctricos',
};
const shortName = shortNames[String(id)] || badge || 'Servicio';
---

<a href={serviceUrl} class="group block">
  <article class="relative rounded-2xl overflow-hidden aspect-[3/4] sm:aspect-[4/5] bg-gray-900">
    <!-- Full photo -->
    <img
      src={imagenUrl}
      alt={titulo}
      class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.05]"
      loading="lazy"
    />

    <!-- Darkening gradient for text readability -->
    <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/10 to-black/20"></div>

    <!-- Giant type overlay -->
    <div class="absolute inset-0 flex flex-col justify-between p-4 sm:p-5">
      <!-- Number top-left -->
      <span class="text-white/30 text-5xl sm:text-6xl font-black leading-none" style="letter-spacing:-0.04em;">{num}</span>

      <!-- Name + description bottom -->
      <div>
        <h3 class="text-white text-xl sm:text-2xl lg:text-3xl font-black uppercase tracking-tight leading-none mb-1" style="letter-spacing:-0.02em;">
          {shortName}
        </h3>
        <span class="text-white/50 text-[10px] sm:text-xs font-mono uppercase tracking-[0.2em] group-hover:text-white/80 transition-colors">
          Ver servicio →
        </span>
      </div>
    </div>
  </article>
</a>
