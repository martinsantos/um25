---
/**
 * ServiceCard — Brutalist Editorial Style
 * Giant number + service name + real photo with rounded corners
 */
import { getDirectusImageUrl, withBase } from '../../lib/directus.ts';

export interface Props {
  id: number | string;
  slug?: string;
  titulo: string;
  descripcion?: string;
  imagen?: string;
  badge?: string;
  badgeColor?: string;
  cliente?: string;
  href?: string;
  icon?: string;
  iconColor?: string;
  index?: number;
}

const { id, slug, titulo, descripcion = '', imagen, badge, cliente = 'Tecnología', href, index = 0 } = Astro.props;

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const serviceUrl = href || (slug ? `${BASE}/servicios/${id}/${slug}` : `${BASE}/servicios/${id}`);

let imagenUrl = getDirectusImageUrl(imagen);
if (!imagenUrl || imagenUrl.includes('default-background')) {
  imagenUrl = withBase(`/images/services/servicio-${id}-${slug?.split('-')[0] || 'default'}.jpg`);
}

const num = String(index + 1).padStart(2, '0');
const desc = descripcion.replace(/<[^>]+>/g, '').substring(0, 90);
---

<a href={serviceUrl} class="group block">
  <article class="h-full">
    <!-- Photo: large, visible, rounded -->
    <div class="relative aspect-[4/3] rounded-2xl overflow-hidden mb-4 bg-gray-100">
      <img
        src={imagenUrl}
        alt={titulo}
        class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-[1.03]"
        loading="lazy"
        onerror="this.parentElement.style.background='#f1f5f9'"
      />
    </div>

    <!-- Number + Title -->
    <div class="flex gap-3 items-baseline mb-2">
      <span class="text-gray-300 text-xs font-mono tracking-wider">{num}</span>
      <h3 class="text-base sm:text-lg font-bold text-gray-900 group-hover:text-red-600 transition-colors leading-snug text-pretty">
        {titulo}
      </h3>
    </div>

    <p class="text-gray-500 text-sm leading-relaxed pl-8">{desc}...</p>
  </article>
</a>
