---
/**
 * ServiceCard Component V5 - Minimal Elevated
 * - Clean white card with border
 * - Image with rounded corners
 * - Refined hover: border color shift + subtle shadow
 * - Arrow link that slides on hover
 */

import { getDirectusImageUrl, getDirectusImageFallback } from '../../lib/directus.ts';

export interface Props {
  id: number | string;
  slug?: string;
  titulo: string;
  descripcion?: string;
  imagen?: string;
  badge?: string;
  badgeColor?: string;
  cliente?: string;
  href?: string;
}

const {
  id,
  slug,
  titulo,
  descripcion = '',
  imagen,
  badge,
  badgeColor = 'bg-slate-800',
  cliente = 'Tecnología',
  href
} = Astro.props;

const serviceUrl = href || (slug ? `/servicios/${id}/${slug}` : `/servicios/${id}`);
const imagenUrl = getDirectusImageUrl(imagen);
const fallbackUrl = getDirectusImageFallback(imagen);

const descripcionTruncada = descripcion.length > 150
  ? descripcion.substring(0, 150) + '...'
  : descripcion;
---

<a href={serviceUrl} class="group flex flex-col h-full">
  <article class="flex flex-col h-full bg-white rounded-2xl overflow-hidden border border-um-border hover:border-um-primary/30 transition-all duration-300 hover:shadow-elevated">
    <!-- Image -->
    <div class="relative aspect-[16/9] overflow-hidden bg-um-elevated">
      {imagenUrl ? (
        <img
          src={imagenUrl}
          alt={titulo}
          width="640"
          height="360"
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]"
          loading="lazy"
          decoding="async"
          onerror={`this.onerror=null; this.src='${fallbackUrl}'`}
        />
      ) : (
        <img
          src={fallbackUrl}
          alt={titulo}
          width="640"
          height="360"
          class="w-full h-full object-cover"
          loading="lazy"
          decoding="async"
        />
      )}

      {badge && (
        <div class="absolute top-3 left-3">
          <span class={`inline-flex items-center px-2.5 py-1 rounded-lg text-xs font-medium ${badgeColor} text-white`}>
            {badge}
          </span>
        </div>
      )}
    </div>

    <!-- Content -->
    <div class="flex flex-col flex-grow p-5 sm:p-6">
      <h3 class="text-base sm:text-lg font-semibold text-um-dark mb-2 group-hover:text-um-primary transition-colors line-clamp-2 leading-snug">
        {titulo}
      </h3>

      <p class="text-um-text-tertiary text-sm mb-5 line-clamp-3 flex-grow leading-relaxed">
        {descripcionTruncada}
      </p>

      <div class="pt-4 border-t border-um-border-subtle mt-auto flex items-center justify-between">
        <span class="text-xs font-medium text-um-text-muted uppercase tracking-wider">
          {cliente}
        </span>
        <span class="text-um-primary text-sm font-medium flex items-center gap-1.5 group-hover:gap-2.5 transition-all">
          Ver detalles
          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </span>
      </div>
    </div>
  </article>
</a>

<style>
  @media (prefers-reduced-motion: reduce) {
    article, img {
      transition-duration: 0.01ms !important;
    }
  }
</style>
