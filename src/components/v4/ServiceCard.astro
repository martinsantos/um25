---
/**
 * ServiceCard Component V4
 *
 * Card de servicio con imagen de fondo, ícono, título y descripción.
 * Usado en homepage y listado de servicios.
 *
 * Props:
 * - id: ID del servicio (para generar link)
 * - slug: Slug URL-friendly del servicio
 * - titulo: Título del servicio
 * - subtitulo: Descripción corta
 * - imagen: URL de imagen de fondo
 * - icon: Nombre del ícono de Lucide
 * - iconColor: Color del fondo del ícono (ej: 'bg-blue-600/90')
 * - href: URL personalizada (opcional, por defecto usa id)
 *
 * Ejemplo de uso:
 * <ServiceCard
 *   id={101}
 *   titulo="Infraestructura de Redes"
 *   subtitulo="Cableado, fibra óptica y radioenlaces"
 *   imagen="https://..."
 *   icon="network"
 *   iconColor="bg-blue-600/90"
 * />
 */

import {
  Network,
  Shield,
  Radio,
  Code,
  Headphones,
  Lightbulb,
  Flame,
  Zap,
  Box
} from 'lucide-astro';
import { getDirectusImageUrl } from '../../lib/directus.ts';

export interface Props {
  id: number | string;
  slug?: string;
  titulo: string;
  subtitulo?: string;
  imagen?: string;
  icon?: string;
  iconColor?: string;
  href?: string;
  className?: string;
}

const {
  id,
  slug,
  titulo,
  subtitulo = '',
  imagen,
  icon = 'box',
  iconColor = 'bg-um-primary/90',
  href,
  className = ''
} = Astro.props;

// Generar URL del servicio
const serviceUrl = href || (slug ? `/servicios/${id}/${slug}` : `/servicios/${id}`);

// Procesar imagen: si es UUID usa getDirectusImageUrl, si es URL usa directamente, sino usa placeholder
let imagenUrl = '/images/services/default-service.jpg';
if (imagen) {
  // Check if it's a UUID (format: xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx)
  if (imagen.match(/^[a-f0-9]{8}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{4}-[a-f0-9]{12}$/i)) {
    imagenUrl = getDirectusImageUrl(imagen);
  } else {
    imagenUrl = imagen;
  }
}

// Mapeo de iconos de Lucide a componentes
const iconComponents: Record<string, any> = {
  'network': Network,
  'shield': Shield,
  'radio-tower': Radio,
  'radio': Radio,
  'code-2': Code,
  'code': Code,
  'headphones': Headphones,
  'lightbulb': Lightbulb,
  'flame': Flame,
  'zap': Zap,
  'box': Box
};

const IconComponent = iconComponents[icon] || Box;
---

<a
  href={serviceUrl}
  class={`card-hover group relative rounded-2xl overflow-hidden aspect-square sm:aspect-[4/5] block ${className}`}
  aria-label={`Ver servicio: ${titulo}`}
>
  <!-- Imagen de fondo -->
  <img
    src={imagenUrl}
    alt={titulo}
    class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
    loading="lazy"
  />

  <!-- Overlay con gradiente -->
  <div class="absolute inset-0 bg-gradient-to-t from-um-dark via-um-dark/40 to-transparent"></div>

  <!-- Contenido -->
  <div class="absolute inset-0 p-4 sm:p-6 flex flex-col justify-end">
    <!-- Ícono -->
    <div class={`w-10 h-10 sm:w-12 sm:h-12 rounded-xl ${iconColor} flex items-center justify-center mb-2 sm:mb-4 transition-transform group-hover:scale-110`}>
      <IconComponent class="w-5 h-5 sm:w-6 sm:h-6 text-white" />
    </div>

    <!-- Título -->
    <h3 class="text-lg sm:text-xl font-bold text-white mb-1 sm:mb-2 group-hover:text-um-primary-light transition-colors">
      {titulo}
    </h3>

    <!-- Subtítulo/Descripción -->
    {subtitulo && (
      <p class="text-xs sm:text-sm text-gray-300 line-clamp-2">
        {subtitulo}
      </p>
    )}
  </div>
</a>

<style>
  /* Hover effect */
  .card-hover {
    transition: all 0.3s ease;
  }

  .card-hover:hover {
    transform: translateY(-8px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.12);
  }

  /* Line clamp para descripción */
  .line-clamp-2 {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  /* Animación reducida para accesibilidad */
  @media (prefers-reduced-motion: reduce) {
    .card-hover,
    .card-hover:hover,
    img,
    div {
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
    }
  }
</style>
