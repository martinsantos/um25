---
/**
 * ServiceCard V5 — Premium Icon-First Design
 * Clean gradient + large SVG icon + no muddy image blends
 * Animated gradient border on hover (@property)
 */
import { withBase } from '../../lib/directus.ts';

export interface Props {
  id: number | string;
  slug?: string;
  titulo: string;
  descripcion?: string;
  imagen?: string;
  badge?: string;
  badgeColor?: string;
  cliente?: string;
  href?: string;
  icon?: string;
  iconColor?: string;
}

const { id, slug, titulo, descripcion = '', imagen, badge, badgeColor, cliente = 'Tecnología', href, icon } = Astro.props;

const BASE = (import.meta.env.BASE_URL || '/').replace(/\/$/, '');
const serviceUrl = href || (slug ? `${BASE}/servicios/${id}/${slug}` : `${BASE}/servicios/${id}`);

const descripcionCorta = descripcion.replace(/<[^>]+>/g, '').substring(0, 120);

// Gradient + accent color per service
const serviceStyle: Record<string, { gradient: string; accent: string; iconBg: string }> = {
  '101': { gradient: 'from-sky-500 to-blue-700', accent: '#0ea5e9', iconBg: 'bg-sky-500' },
  '102': { gradient: 'from-rose-500 to-red-700', accent: '#f43f5e', iconBg: 'bg-rose-500' },
  '103': { gradient: 'from-teal-400 to-cyan-700', accent: '#14b8a6', iconBg: 'bg-teal-500' },
  '104': { gradient: 'from-violet-500 to-purple-800', accent: '#8b5cf6', iconBg: 'bg-violet-500' },
  '105': { gradient: 'from-amber-400 to-orange-600', accent: '#f59e0b', iconBg: 'bg-amber-500' },
  '106': { gradient: 'from-emerald-400 to-green-700', accent: '#10b981', iconBg: 'bg-emerald-500' },
  '107': { gradient: 'from-orange-500 to-red-700', accent: '#f97316', iconBg: 'bg-orange-500' },
  '108': { gradient: 'from-yellow-400 to-amber-600', accent: '#eab308', iconBg: 'bg-yellow-500' },
};
const style = serviceStyle[String(id)] || { gradient: 'from-gray-500 to-gray-700', accent: '#6b7280', iconBg: 'bg-gray-500' };

// SVG icon paths (Lucide-style)
const iconPaths: Record<string, string> = {
  'network': 'M9 3v2m6-2v2M9 19v2m6-2v2M5 9H3m2 6H3m18-6h-2m2 6h-2M7 19h10a2 2 0 002-2V7a2 2 0 00-2-2H7a2 2 0 00-2 2v10a2 2 0 002 2zM9 9h6v6H9V9z',
  'shield': 'M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z',
  'radio': 'M8.111 16.404a5.5 5.5 0 017.778 0M12 20h.01m-7.08-7.071c3.904-3.905 10.236-3.905 14.141 0M1.394 9.393c5.857-5.858 15.355-5.858 21.213 0',
  'code': 'M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4',
  'headphones': 'M3 18v-6a9 9 0 0118 0v6M21 19a2 2 0 01-2 2h-1a2 2 0 01-2-2v-3a2 2 0 012-2h3zM3 19a2 2 0 002 2h1a2 2 0 002-2v-3a2 2 0 00-2-2H3z',
  'lightbulb': 'M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z',
  'flame': 'M17.657 18.657A8 8 0 016.343 7.343S7 9 9 10c0-2 .5-5 2.986-7C14 5 16.09 5.777 17.656 7.343A7.975 7.975 0 0120 13a7.975 7.975 0 01-2.343 5.657z',
  'zap': 'M13 10V3L4 14h7v7l9-11h-7z',
};
const iconD = iconPaths[icon || ''] || iconPaths['network'];
---

<a href={serviceUrl} class="group block">
  <article class="service-card-v5 relative overflow-hidden rounded-2xl bg-white border border-gray-200/60 transition-all duration-500 hover:border-transparent hover:shadow-2xl hover:shadow-black/10 hover:-translate-y-2" style={`--card-accent: ${style.accent}`}>
    <!-- Animated gradient border on hover (visible via pseudo-element) -->
    <div class="absolute inset-0 rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 animated-gradient-border -z-10" style="padding: 1.5px; -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0); mask-composite: exclude;"></div>

    <!-- Header: Gradient + Large Icon -->
    <div class={`relative h-32 sm:h-36 bg-gradient-to-br ${style.gradient} flex items-center justify-center overflow-hidden`}>
      <!-- Geometric pattern overlay -->
      <div class="absolute inset-0 opacity-10" style="background-image: radial-gradient(circle at 20% 50%, white 1px, transparent 1px), radial-gradient(circle at 80% 20%, white 1px, transparent 1px), radial-gradient(circle at 60% 80%, white 1px, transparent 1px); background-size: 60px 60px, 80px 80px, 40px 40px;"></div>

      <!-- Large SVG icon -->
      <div class="relative z-10 w-16 h-16 sm:w-20 sm:h-20 rounded-2xl bg-white/15 backdrop-blur-sm flex items-center justify-center border border-white/20 group-hover:scale-110 group-hover:bg-white/25 transition-all duration-500">
        <svg class="w-8 h-8 sm:w-10 sm:h-10 text-white drop-shadow-lg" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" d={iconD}/>
        </svg>
      </div>

      <!-- Badge -->
      {badge && (
        <span class="absolute top-3 left-3 text-[10px] font-black tracking-widest text-white/80 uppercase">{badge}</span>
      )}
    </div>

    <!-- Content -->
    <div class="p-5 sm:p-6">
      <h3 class="text-base sm:text-lg font-bold text-gray-900 mb-2 group-hover:text-[var(--card-accent)] transition-colors text-pretty leading-snug">
        {titulo}
      </h3>
      <p class="text-gray-500 text-sm leading-relaxed mb-4 line-clamp-2">
        {descripcionCorta}...
      </p>
      <div class="flex items-center justify-between">
        <span class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider">{cliente}</span>
        <span class="inline-flex items-center gap-1.5 text-sm font-bold group-hover:gap-3 transition-all" style={`color: ${style.accent}`}>
          Explorar
          <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" d="M13 7l5 5m0 0l-5 5m5-5H6"/>
          </svg>
        </span>
      </div>
    </div>
  </article>
</a>

<style>
  .line-clamp-2 { display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
</style>
