---
import { pageContactLink } from '../../lib/caseJourney';
import UMLogo from '../brand/UMLogo.astro';
import { directoryReturnHref, NAV_SECTORS, NAV_SERVICES } from '../../data/navigation';
import { SERVICE_NAV_MEDIA, SECTOR_NAV_MEDIA } from '../../data/navigationMedia';
import { shellLocale, shellRoutes, shellServiceCopy, shellSectorCopy } from '../../config/i18nShell';
/** Cabecera comercial UMSA: marca, navegación principal (con mega-menú de
 *  servicios y sectores en escritorio) y contacto. */

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const { lang, t, alternate, alternateLang } = shellLocale(currentPath);
const routes = shellRoutes(lang);

const navItems: { href: string; label: string; mega?: 'servicios' | 'sectores' }[] = [
  { href: routes.home, label: t.nav.home },
  { href: routes.services, label: t.nav.services, mega: 'servicios' },
  { href: routes.sectors, label: lang === 'en' ? t.destinationLabel(t.nav.sectors) : t.nav.sectors, mega: 'sectores' },
  { href: routes.projects, label: lang === 'en' ? t.destinationLabel(t.nav.projects) : t.nav.projects },
  { href: routes.blog, label: lang === 'en' ? t.destinationLabel(t.nav.blog) : t.nav.blog },
];

const moreItems = [
  { href: routes.about, label: lang === 'en' ? 'About' : 'Nosotros' },
  { href: routes.cctv, label: lang === 'en' ? 'UMSA CCTV AI (ES)' : 'UMSA CCTV AI' },
  { href: routes.certifications, label: lang === 'en' ? t.destinationLabel('Technical documentation') : 'Certificaciones' },
  { href: routes.contact, label: lang === 'en' ? 'Contact' : 'Contacto' },
];

const isActive = (href: string) => {
  let clean = currentPath.replace(/\/$/, '') || '/';
  const target = href.replace(/\/$/, '') || '/';
  const matchesPath = (path: string, base: string) => path === base || path.startsWith(`${base}/`);
  if (target === '/' || target === '/en') return clean === target;
  if (target === '/sectores' && ['/software', '/seguridad-electronica'].includes(clean)) return true;
  const service = target.match(/^\/servicios\/(10[1-8])(?:\/|$)/);
  if (service) return matchesPath(clean, `/servicios/${service[1]}`);
  // Los destinos históricos /bodegas, etc. conservan su selección en /sectores/bodegas.
  if (target !== '/sectores' && !target.startsWith('/sectores/')) clean = clean.replace(/^\/sectores\//, '/');
  return matchesPath(clean, target);
};

const currentMarker = (href: string) => isActive(href)
  ? (href === (currentPath.replace(/\/$/, '') || '/') ? 'page' : 'location')
  : undefined;

const mobileCatalogs = {
  servicios: {
    all: t.megaServices.all,
    entries: NAV_SERVICES.map(s => ({ href: s.href, image: SERVICE_NAV_MEDIA[s.code], ...shellServiceCopy(lang, s.code, s.name, s.text) })),
  },
  sectores: {
    all: lang === 'en' ? t.destinationLabel(t.megaSectors.all) : t.megaSectors.all,
    entries: NAV_SECTORS.map(s => ({ href: s.href, image: SECTOR_NAV_MEDIA[s.slug], ...shellSectorCopy(lang, s.slug, s.name, s.text) })),
  },
};

---

<header class="um-ops-header">
  <div class="um-ops-header__main">
    <div class="um-ops-container um-ops-header__row">
      <a href={routes.home} class="um-ops-logo" aria-current={isActive(routes.home) ? 'page' : undefined} aria-label={t.footerShell.home}>
        <UMLogo title="ultimamilla.com.ar" />
      </a>

      <nav class="um-ops-nav" aria-label={lang === 'en' ? 'Main navigation' : 'Navegación principal'}>
        {navItems.map((item) => item.mega ? (
          <div class:list={['um-ops-mega', { 'is-active': isActive(item.href) }]} data-mega={item.mega}>
            <a href={directoryReturnHref(item.href, currentPath)} class:list={['um-ops-nav__link', 'um-ops-mega__link', { 'is-active': isActive(item.href) }]} aria-current={currentMarker(item.href)}>
              {item.label}
            </a>
            <button type="button" class="um-ops-mega__toggle" aria-expanded="false" aria-controls={`um-mega-${item.mega}`} aria-label={lang === 'en' ? `${item.mega === 'servicios' ? t.nav.services : t.nav.sectors} menu` : `Menú de ${item.label.toLowerCase()}`}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </button>
            <div class="um-ops-mega__panel" id={`um-mega-${item.mega}`}>
              <div class="um-ops-container um-ops-mega__inner">
                {item.mega === 'servicios' ? (
                  <>
                    <div class="um-ops-mega__intro">
                      <p class="um-ops-mega__kicker">{t.megaServices.kicker}</p>
                      <p class="um-ops-mega__lead">{t.megaServices.lead}</p>
                      <a class="um-ops-mega__all" href={directoryReturnHref(routes.services, currentPath)}>{t.megaServices.all} <span aria-hidden="true">→</span></a>
                    </div>
                    <ul class="um-ops-mega__grid um-ops-mega__grid--services">
                      {NAV_SERVICES.map((s) => (
                        <li>
                          <a href={s.href} class:list={[{ 'is-active': isActive(s.href) }]} aria-current={currentMarker(s.href)}>
                            <img class="um-ops-mega__thumb" src={SERVICE_NAV_MEDIA[s.code]} width="112" height="84" alt="" loading="lazy" decoding="async" />
                            <span class="um-ops-mega__code">{s.code}</span>
                            <span class="um-ops-mega__name">{lang === 'en' ? t.destinationLabel(shellServiceCopy(lang, s.code, s.name, s.text).name) : s.name}</span>
                            <span class="um-ops-mega__text">{shellServiceCopy(lang, s.code, s.name, s.text).text}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : (
                  <>
                    <div class="um-ops-mega__intro">
                      <p class="um-ops-mega__kicker">{t.megaSectors.kicker}</p>
                      <p class="um-ops-mega__lead">{t.megaSectors.lead}</p>
                      <a class="um-ops-mega__all" href={directoryReturnHref(routes.sectors, currentPath)}>{lang === 'en' ? t.destinationLabel(t.megaSectors.all) : t.megaSectors.all} <span aria-hidden="true">→</span></a>
                    </div>
                    <ul class="um-ops-mega__grid um-ops-mega__grid--sectors">
                      {NAV_SECTORS.map((s) => (
                        <li>
                          <a href={s.href} class:list={[{ 'is-active': isActive(s.href) }]} aria-current={currentMarker(s.href)}>
                            <img class="um-ops-mega__thumb" src={SECTOR_NAV_MEDIA[s.slug]} width="112" height="84" alt="" loading="lazy" decoding="async" />
                            <span class="um-ops-mega__name">{lang === 'en' ? t.destinationLabel(shellSectorCopy(lang, s.slug, s.name, s.text).name) : s.name}</span>
                            <span class="um-ops-mega__text">{shellSectorCopy(lang, s.slug, s.name, s.text).text}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
              </div>
            </div>
          </div>
        ) : (
          <a href={item.href} class:list={['um-ops-nav__link', { 'is-active': isActive(item.href) }]} aria-current={currentMarker(item.href)}>
            {item.label}
          </a>
        ))}

      </nav>


      {lang === 'en' ? (
        <a data-contact-follow href={pageContactLink(Astro, routes.contact)} class="um-ops-cta">{t.nav.contact}</a>
      ) : (
        <a data-contact-follow href={pageContactLink(Astro)} class="um-ops-cta">Contactar</a>
      )}

      <button
        id="menuToggle"
        class="um-ops-menu-toggle"
        type="button"
        aria-label={t.mobile.open}
        data-label-open={t.mobile.open}
        data-label-close={t.mobile.close}
        aria-expanded="false"
        aria-controls="mobileMenu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
      <noscript>
        <style is:inline>@media (max-width:1110px) { #menuToggle { display:none; } }</style>
        <details class="um-ops-nojs">
          <summary>{lang === 'en' ? 'Menu' : 'Menú'}</summary>
          <nav aria-label={lang === 'en' ? 'Main navigation' : 'Navegación principal'}>
            <ul>
              {[...navItems, ...moreItems].map(item => (
                <li><a href={item.href === routes.contact ? pageContactLink(Astro, routes.contact) : directoryReturnHref(item.href, currentPath)}
                  aria-current={currentMarker(item.href)}>{item.label}</a></li>
              ))}
              <li><a href={alternate} hreflang={alternateLang} lang={alternateLang}>{t.lang.switchTo}</a></li>
            </ul>
          </nav>
        </details>
      </noscript>
    </div>
  </div>

</header>

<div id="mobileMenu" class="um-ops-mobile" hidden>
  <nav class="um-ops-container um-ops-mobile__inner" aria-label={lang === 'en' ? 'Mobile menu' : 'Menú móvil'}>
    <div class="um-ops-mobile__switch" data-menu-catalogs hidden>
      <button type="button" data-menu-index><span aria-hidden="true">←</span> {lang === 'en' ? 'Menu' : 'Menú'}</button>
      <div role="group" aria-label={lang === 'en' ? 'Catalogue' : 'Catálogo'}>
        {navItems.filter(item => item.mega).map(item =>
          <button type="button" data-menu-catalog={item.mega} aria-pressed="false" aria-controls={`mobile-${item.mega}`}>{item.mega === 'servicios' ? t.nav.services : t.nav.sectors}</button>
        )}
      </div>
    </div>
    <ul class="um-ops-mobile__primary">
      {navItems.map(item => {
        const catalog = item.mega && mobileCatalogs[item.mega];
        const current = isActive(item.href);
        const currentEntry = catalog && catalog.entries.find(entry => isActive(entry.href));
        return (
          <li>
            {catalog ? (
              <>
                <button type="button" class:list={['um-ops-mobile__row', { 'is-active': current }]}
                  data-mobile-group-toggle data-menu-current={current || undefined} aria-expanded="false" aria-controls={'mobile-' + item.mega}
                  aria-labelledby={'mobile-label-' + item.mega}
                  aria-describedby={currentEntry ? 'mobile-current-' + item.mega : undefined}>
                  <span>
                    <span id={'mobile-label-' + item.mega}>{item.label}</span>
                    {currentEntry && <small id={'mobile-current-' + item.mega}>{currentEntry.name}</small>}
                  </span>
                  <svg class="um-ops-mobile__chevron" viewBox="0 0 24 24" aria-hidden="true"><path d="m9 6 6 6-6 6" /></svg>
                </button>
                <div id={'mobile-' + item.mega} data-mobile-catalog-panel hidden>
                  <a class="um-ops-mobile__all" href={directoryReturnHref(item.href, currentPath)} aria-current={currentMarker(item.href)}>
                    {catalog.all} <span aria-hidden="true">→</span>
                  </a>
                  <ul class="um-ops-mobile__destinations">
                    {catalog.entries.map(s => <li><a href={s.href} aria-current={currentMarker(s.href)}>
                      <img src={s.image} width="46" height="46" alt="" loading="lazy" decoding="async" />
                      <span><strong>{lang === 'en' ? t.destinationLabel(s.name) : s.name}</strong><span>{s.text}</span></span>
                    </a></li>)}
                  </ul>
                </div>
              </>
            ) : (
              <a href={item.href} class:list={['um-ops-mobile__row', { 'is-active': current }]}
                data-menu-current={current || undefined} aria-current={currentMarker(item.href)}>{item.label}</a>
            )}
          </li>
        );
      })}
    </ul>
    <p class="um-ops-mobile__label">{t.mobile.more}</p>
    <ul class="um-ops-mobile__secondary">
      {moreItems.filter((item) => item.href !== routes.contact).map((item) => (
        <li>
          <a href={item.href} class:list={[{ 'is-active': isActive(item.href) }]} aria-current={currentMarker(item.href)}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="um-ops-mobile__foot">
      <a data-contact-follow href={pageContactLink(Astro, routes.contact)} class="um-ops-mobile__cta">
        {t.nav.contact}
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 8h9M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
      </a>
      <p>{t.mobile.hours} · <a href={alternate} hreflang={alternateLang} lang={alternateLang}>{t.lang.switchTo}</a></p>
    </div>
  </nav>
</div>

<style>
  .um-ops-header {
    position: sticky;
    top: 0;
    z-index: var(--um-z-header);
    isolation: isolate;
    background: rgba(10,10,11,0.92);
    color: #fff;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    backdrop-filter: blur(14px);
  }

  .um-ops-container {
    /* Share the same reading axis as the public page shells. */
    width: min(var(--um-container-wide), calc(100% - (var(--um-page-gutter) * 2)));
    margin-inline: auto;
  }

  .um-ops-header__main {
    position: relative;
    z-index: 2;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .um-ops-header__row {
    display: flex;
    min-height: 64px;
    align-items: center;
    gap: 12px;
  }

  .um-ops-logo {
    /* Área táctil de 44 px sin alterar el tamaño ni la posición del logo. */
    padding-block: 12px;
    margin-block: -12px;
    flex: 0 0 auto;
    color: #fff;
    display: block;
    font-size: clamp(1.25rem, 1.5vw, 1.4rem);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .um-ops-logo span {
    color: #dc2626;
  }

  .um-ops-tag,
  .um-ops-ticker {
    font-family: var(--um-font-mono);
    text-transform: uppercase;
    letter-spacing: 0.17em;
  }

  .um-ops-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(255,255,255,0.12);
    padding: 6px 9px;
    color: #71717a;
    font-size: 16px;
    line-height: 1;
  }

  .um-ops-tag i,
  .um-ops-ticker__badge i {
    position: relative;
    width: 6px;
    height: 6px;
    display: inline-flex;
  }

  .um-ops-tag i::before,
  .um-ops-tag i::after,
  .um-ops-ticker__badge i::before,
  .um-ops-ticker__badge i::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #dc2626;
  }

  .um-ops-tag i::before,
  .um-ops-ticker__badge i::before {
    animation: um-ops-ping 1.8s cubic-bezier(0,0,0.2,1) infinite;
  }

  @keyframes um-ops-ping {
    75%, 100% { transform: scale(2.5); opacity: 0; }
  }

  .um-ops-nav {
    /* Sin posicionamiento propio: el panel del mega-menú se ancla al ancho
       completo de .um-ops-header__main. */
    position: static;
    align-self: stretch;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
    margin-left: auto;
  }

  .um-ops-nav__link,
  .um-ops-more__trigger {
    position: relative;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 7px;
    border: 0;
    background: transparent;
    color: #a1a1aa;
    padding: 0 15px;
    font-family: var(--um-font-body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
  }

  .um-ops-nav__link:hover,
  .um-ops-nav__link.is-active,
  .um-ops-more:hover .um-ops-more__trigger,
  .um-ops-more.is-active .um-ops-more__trigger {
    color: #fff;
  }

  .um-ops-nav__link:focus-visible,
  .um-ops-cta:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .um-ops-nav__link.is-active::after,
  .um-ops-more.is-active .um-ops-more__trigger::after,
  .um-ops-more:hover .um-ops-more__trigger::after {
    content: "";
    position: absolute;
    left: 15px;
    right: 15px;
    bottom: 0;
    height: 2px;
    background: #dc2626;
  }

  /* Mega-menú de escritorio: Servicios y Sectores despliegan un panel a todo
     el ancho con los ocho frentes / nueve sectores, código y promesa. */
  .um-ops-mega {
    align-self: stretch;
    display: inline-flex;
    align-items: center;
  }

  .um-ops-mega__link {
    padding-right: 4px;
  }

  .um-ops-mega__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    min-height: 44px;
    margin-right: 0;
    border: 0;
    background: transparent;
    color: #a1a1aa;
    cursor: pointer;
  }

  .um-ops-mega__toggle svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    transition: transform 0.18s ease;
  }

  .um-ops-mega:hover .um-ops-mega__toggle,
  .um-ops-mega.is-open .um-ops-mega__toggle,
  .um-ops-mega__toggle:focus-visible {
    color: #fff;
  }

  .um-ops-mega.is-open .um-ops-mega__toggle svg {
    transform: rotate(180deg);
  }

  .um-ops-mega__toggle:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .um-ops-mega:hover .um-ops-mega__link,
  .um-ops-mega.is-open .um-ops-mega__link {
    color: #fff;
  }

  /* El subrayado cubre texto y flecha juntos: sale del link (que ya está
     posicionado) y se estira sobre el botón de la flecha. .um-ops-mega NO se
     posiciona: el panel tiene que anclarse al ancho completo del header. */
  .um-ops-mega:hover .um-ops-mega__link::after,
  .um-ops-mega.is-open .um-ops-mega__link::after {
    content: "";
    position: absolute;
    left: 15px;
    right: -22px;
    bottom: 0;
    height: 2px;
    background: #dc2626;
  }

  .um-ops-mega__panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: var(--um-z-header-menu);
    padding: 20px 0 24px;
    max-height: calc(100dvh - 66px);
    overflow-y: auto;
    overscroll-behavior: contain;
    background: #0b0b0c;
    border-top: 1px solid rgba(220,38,38,0.42);
    border-bottom: 1px solid rgba(255,255,255,0.1);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0s linear 0.16s;
  }

  .um-ops-mega:not([data-interactive]):hover .um-ops-mega__panel,
  .um-ops-mega.is-open .um-ops-mega__panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition-delay: 0.06s, 0.06s, 0s;
  }

  .um-ops-mega__inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
    align-items: start;
  }

  .um-ops-mega__intro { display: grid; grid-template-columns: minmax(0, 1fr) auto; gap: 6px 32px; align-items: start; }
  .um-ops-mega__intro .um-ops-mega__all { grid-column: 2; grid-row: 1 / 3; margin-top: 0; align-self: center; }

  .um-ops-mega__kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: #fff;
    font-weight: 600;
    letter-spacing: 0;
    font-size: 1.375rem;
    line-height: 1.3;
  }

  .um-ops-mega__kicker i {
    width: 22px;
    height: 2px;
    background: #dc2626;
  }

  .um-ops-mega__lead {
    margin: 0;
    color: #c4c7cc;
    font-size: 1rem;
    line-height: 1.55;
    max-width: 78ch;
  }

  .um-ops-mega__all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    min-height: 44px;
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid #dc2626;
  }

  .um-ops-mega__all:hover,
  .um-ops-mega__all:focus-visible {
    color: #fff;
    border-bottom-color: #fff;
  }

  .um-ops-mega__all:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 2px;
  }

  .um-ops-mega__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 4px 12px;
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  .um-ops-mega__grid--services {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  @media (min-width: 1360px) {
    .um-ops-mega__grid--services { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  .um-ops-mega__grid--sectors {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .um-ops-mega__grid a {
    display: grid;
    grid-template-columns: 80px 3ch minmax(0, 1fr);
    grid-template-areas: "image code name" "image . text";
    grid-template-rows: min-content 1fr;
    column-gap: 10px;
    align-content: start;
    height: 100%;
    padding: 12px;
    border: 1px solid transparent;
    border-left-width: 3px;
    border-bottom-color: rgba(255,255,255,0.14);
    color: #fff;
    text-decoration: none;
    transition: background-color 0.15s ease, border-color 0.15s ease;
  }

  .um-ops-mega__grid--sectors a {
    grid-template-columns: 80px minmax(0, 1fr);
    grid-template-areas: "image name" "image text";
  }

  /* A lazy image in a visibility:hidden panel can still be fetched before the menu opens. */
  .um-ops-mega:not(.is-open):not(:hover) .um-ops-mega__thumb,
  .um-ops-mega[data-interactive]:not(.is-open) .um-ops-mega__thumb { display:none; }
  .um-ops-mega__thumb { grid-area: image; width: 100%; height: 64px; object-fit: cover; align-self: start; }
  @media (max-width: 1279px) {
    .um-ops-mega__grid a { grid-template-columns: 72px 3ch minmax(0,1fr); }
    .um-ops-mega__grid--sectors a { grid-template-columns: 64px minmax(0,1fr); }
  }

  .um-ops-mega__grid a:hover,
  .um-ops-mega__grid a:focus-visible {
    background: #303034;
    border-color: #74747e;
    border-left-color: #dc2626;
  }

  .um-ops-mega__grid a.is-active {
    background: #f4f4f5;
    border-color: #f4f4f5;
    border-left-color: #dc2626;
    color: #111;
  }

  .um-ops-mega__grid a.is-active :is(.um-ops-mega__code, .um-ops-mega__name, .um-ops-mega__text) {
    color: #111;
