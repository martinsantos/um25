---
/** Cabecera comercial UMSA: marca, navegación principal y contacto. */

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { href: '/', label: 'Inicio' },
  { href: '/servicios', label: 'Servicios' },
  { href: '/sectores', label: 'Sectores' },
  { href: '/antecedentes', label: 'Antecedentes' },
  { href: '/blog', label: 'Blog' },
];

const moreItems = [
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/cctvai', label: 'UMSA CCTV AI' },
  { href: '/certificaciones', label: 'Certificaciones' },
  { href: '/contacto', label: 'Contacto' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};

const moreIsActive = moreItems.some((item) => isActive(item.href));
---

<header class="um-ops-header">
  <div class="um-ops-header__main">
    <div class="um-ops-container um-ops-header__row">
      <a href="/" class="um-ops-logo" aria-label="Ir al inicio">
        <img
          src="/images/logo-dark.svg"
          alt=""
          width="620"
          height="100"
          decoding="async"
          fetchpriority="high"
        />
      </a>

      <nav class="um-ops-nav" aria-label="Navegación principal">
        {navItems.map((item) => (
          <a href={item.href} class:list={['um-ops-nav__link', { 'is-active': isActive(item.href) }]}>
            {item.label}
          </a>
        ))}

        <div class:list={['um-ops-more', { 'is-active': moreIsActive }]}>
          <button type="button" class="um-ops-more__trigger" aria-haspopup="true" aria-expanded="false">
            Más
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </button>
          <div class="um-ops-more__menu" role="menu">
            {moreItems.map((item) => (
              <a href={item.href} role="menuitem" class:list={[{ 'is-active': isActive(item.href) }]}>
                {item.label}
              </a>
            ))}
          </div>
        </div>
      </nav>

      <a href="/contacto" class="um-ops-cta">
        Contactar
      </a>

      <button
        id="menuToggle"
        class="um-ops-menu-toggle"
        type="button"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobileMenu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

  <div id="mobileMenu" class="um-ops-mobile" hidden>
    <nav class="um-ops-container" aria-label="Menú móvil">
      {navItems.map((item) => (
        <a href={item.href} class:list={[{ 'is-active': isActive(item.href) }]}>
          {item.label}
        </a>
      ))}
      <p>Más</p>
      {moreItems.map((item) => (
        <a href={item.href} class:list={[{ 'is-active': isActive(item.href) }]}>
          {item.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<style>
  .um-ops-header {
    position: sticky;
    top: 0;
    z-index: var(--um-z-header);
    isolation: isolate;
    background: rgba(10,10,11,0.97);
    color: #fff;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    backdrop-filter: blur(8px);
  }

  .um-ops-container {
    /* Share the same reading axis as the public page shells. */
    width: min(var(--um-container-wide), calc(100% - (var(--um-page-gutter) * 2)));
    margin-inline: auto;
  }

  .um-ops-header__main {
    position: relative;
    z-index: 2;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .um-ops-header__row {
    display: flex;
    min-height: 72px;
    align-items: center;
    gap: 16px;
  }

  .um-ops-logo {
    flex: 0 0 auto;
    display: inline-flex;
    width: clamp(12.875rem, 16vw, 14.25rem);
    min-height: 44px;
    align-items: center;
    text-decoration: none;
  }

  .um-ops-logo img {
    display: block;
    width: 100%;
    height: auto;
    transform: translateY(14%);
  }

  .um-ops-tag,
  .um-ops-ticker,
  .um-ops-mobile p {
    font-family: var(--um-font-mono);
    text-transform: uppercase;
    letter-spacing: 0.17em;
  }

  .um-ops-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(255,255,255,0.12);
    padding: 6px 9px;
    color: #71717a;
    font-size: 16px;
    line-height: 1;
  }

  .um-ops-tag i,
  .um-ops-ticker__badge i {
    position: relative;
    width: 6px;
    height: 6px;
    display: inline-flex;
  }

  .um-ops-tag i::before,
  .um-ops-tag i::after,
  .um-ops-ticker__badge i::before,
  .um-ops-ticker__badge i::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #dc2626;
  }

  .um-ops-tag i::before,
  .um-ops-ticker__badge i::before {
    animation: um-ops-ping 1.8s cubic-bezier(0,0,0.2,1) infinite;
  }

  @keyframes um-ops-ping {
    75%, 100% { transform: scale(2.5); opacity: 0; }
  }

  .um-ops-nav {
    position: relative;
    z-index: 3;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
    margin-left: auto;
  }

  .um-ops-nav__link,
  .um-ops-more__trigger {
    position: relative;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 7px;
    border: 0;
    background: transparent;
    color: #c4c7cc;
    padding: 0 17px;
    font-family: var(--um-font-body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
  }

  .um-ops-nav__link:hover,
  .um-ops-nav__link.is-active,
  .um-ops-more:hover .um-ops-more__trigger,
  .um-ops-more.is-active .um-ops-more__trigger {
    color: #fff;
    background: rgba(255,255,255,0.035);
  }

  .um-ops-nav__link.is-active::after,
  .um-ops-more.is-active .um-ops-more__trigger::after,
  .um-ops-more:hover .um-ops-more__trigger::after {
    content: "";
    position: absolute;
    left: 17px;
    right: 17px;
    bottom: 0;
    height: 2px;
    background: #dc2626;
  }

  .um-ops-more {
    position: relative;
    z-index: 4;
  }

  .um-ops-more__trigger svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .um-ops-more__menu {
    position: absolute;
    top: calc(100% + 0px);
    right: 0;
    min-width: 230px;
    padding: 8px 0;
    border: 1px solid rgba(255,255,255,0.1);
    background: #111113;
    border-top-color: rgba(220,38,38,0.42);
    z-index: var(--um-z-header-menu);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
    box-shadow: 0 1px 2px rgba(0,0,0,0.22), 0 8px 24px rgba(0,0,0,0.18);
  }

  .um-ops-more:hover .um-ops-more__menu,
  .um-ops-more:focus-within .um-ops-more__menu {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .um-ops-more__menu a {
    display: block;
    color: #c4c7cc;
    padding: 13px 18px;
    font-size: 16px;
    line-height: 1;
    text-decoration: none;
  }

  .um-ops-more__menu a:hover,
  .um-ops-more__menu a.is-active {
    color: #fff;
    background: rgba(220,38,38,0.09);
  }

  .um-ops-cta {
    display: inline-flex;
    min-height: 48px;
    align-items: center;
    gap: 8px;
    margin-left: 12px;
    background: #dc2626;
    color: #fff;
    padding: 0 24px;
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .um-ops-cta:hover {
    background: #b91c1c;
  }

  .um-ops-menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    margin-left: auto;
    border: 0;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }

  .um-ops-menu-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    margin: 5px auto;
    background: currentColor;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }

  .um-ops-menu-toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .um-ops-menu-toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .um-ops-menu-toggle[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .um-ops-ticker {
    display: none;
  }

  .um-ops-ticker__row {
    display: flex;
    min-height: 28px;
    align-items: stretch;
  }

  .um-ops-ticker a {
    text-decoration: none;
  }

  .um-ops-ticker__badge,
  .um-ops-ticker__kpis,
  .um-ops-ticker__sla {
    border-color: rgba(255,255,255,0.08);
  }

  .um-ops-ticker__badge,
  .um-ops-ticker__sla {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #71717a;
    white-space: nowrap;
  }

  .um-ops-ticker__badge {
    border-right: 1px solid rgba(255,255,255,0.08);
    padding: 0 16px 0 0;
  }

  .um-ops-ticker__badge span {
    color: #2d8a2d;
    font-weight: 700;
  }

  .um-ops-ticker__badge svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: #dc2626;
    stroke-width: 2;
  }

  .um-ops-ticker__kpis {
    display: flex;
    align-items: center;
    gap: 18px;
    border-right: 1px solid rgba(255,255,255,0.08);
    padding: 0 18px;
    white-space: nowrap;
  }

  .um-ops-ticker__kpis a,
  .um-ops-ticker__sla {
    color: #71717a;
  }

  .um-ops-ticker__kpis strong:first-child {
    color: #2d8a2d;
  }

  .um-ops-ticker strong {
    color: #fff;
    font: inherit;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .um-ops-ticker__marquee {
    flex: 1 1 0;
    width: 0;
    min-width: 0;
    overflow: hidden;
    overflow: clip;
  }

  .um-ops-ticker__track {
    display: flex;
    width: 100%;
    max-width: 100%;
    min-height: 28px;
    align-items: center;
    overflow: hidden;
  }

  .um-ops-event {
    flex: 1 1 0;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #a1a1aa;
    padding: 0 16px;
    font-size: 0.625rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .um-ops-event span {
    color: #52525b;
    font-variant-numeric: tabular-nums;
  }

  .um-ops-event i {
    font-style: normal;
    font-weight: 700;
  }

  .um-ops-event i.is-ok { color: #2d8a2d; }
  .um-ops-event i.is-warn { color: #dc2626; }
  .um-ops-event i.is-info { color: #1a56c0; }

  .um-ops-event em {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-style: normal;
  }

  .um-ops-event b {
    color: #3f3f46;
    font-weight: 400;
  }

  .um-ops-ticker__sla {
    border-left: 1px solid rgba(255,255,255,0.08);
    padding-left: 18px;
  }

  .um-ops-mobile {
    position: relative;
    z-index: 2;
    border-top: 1px solid rgba(255,255,255,0.1);
    background: #0a0a0b;
    max-height: calc(100dvh - 62px);
    overflow-y: auto;
    overscroll-behavior: contain;
    border-bottom: 1px solid rgba(255,255,255,0.12);
  }

  .um-ops-mobile nav {
    display: grid;
    gap: 2px;
    padding-top: 12px;
    padding-bottom: 14px;
  }

  .um-ops-mobile a {
    display: flex;
    min-height: 52px;
    align-items: center;
    gap: 10px;
    border-left: 2px solid transparent;
    color: #c4c7cc;
    padding: 0 14px;
    font-size: 16px;
    font-weight: 600;
    text-decoration: none;
  }

  .um-ops-mobile a:hover,
  .um-ops-mobile a.is-active {
    border-left-color: #dc2626;
    color: #fff;
    background: rgba(220,38,38,0.08);
  }

  .um-ops-mobile a span {
    color: #52525b;
    font-size: 9px;
  }

  .um-ops-mobile p {
    margin: 16px 0 6px;
    padding: 0 12px;
    color: #8b8b94;
    font-size: 16px;
    line-height: 1.3;
  }

  @media (max-width: 1110px) {
    .um-ops-nav,
    .um-ops-cta,
    .um-ops-tag {
      display: none;
    }

    .um-ops-menu-toggle {
      display: block;
    }

    .um-ops-header__row {
      min-height: 64px;
    }
  }

  @media (max-width: 760px) {
    .um-ops-container {
      width: min(100% - 32px, var(--um-container-wide));
    }

    .um-ops-logo {
      width: clamp(11.75rem, 56vw, 13.5rem);
    }

    .um-ops-ticker {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .um-ops-ticker__track,
    .um-ops-tag i::before,
    .um-ops-ticker__badge i::before {
      animation: none;
    }
  }

  @media (hover: hover) {
    .um-ops-nav__link,
    .um-ops-more__trigger,
    .um-ops-cta,
    .um-ops-more__menu a,
    .um-ops-mobile a {
      transition: color 140ms ease, background-color 140ms ease, border-color 140ms ease;
    }
  }
</style>

<script>
  const initOpsNavigation = () => {
    const menuToggle = document.getElementById('menuToggle');
    const mobileMenu = document.getElementById('mobileMenu');
    if (!menuToggle || !mobileMenu || menuToggle.dataset.bound === 'true') return;

    menuToggle.dataset.bound = 'true';
    const closeMenu = () => {
      mobileMenu.setAttribute('hidden', '');
      menuToggle.setAttribute('aria-expanded', 'false');
      menuToggle.setAttribute('aria-label', 'Abrir menú');
    };

    menuToggle.addEventListener('click', () => {
      const willOpen = mobileMenu.hasAttribute('hidden');
      mobileMenu.toggleAttribute('hidden', !willOpen);
      menuToggle.setAttribute('aria-expanded', willOpen ? 'true' : 'false');
      menuToggle.setAttribute('aria-label', willOpen ? 'Cerrar menú' : 'Abrir menú');
    });

    mobileMenu.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && !mobileMenu.hasAttribute('hidden')) {
        closeMenu();
        menuToggle.focus();
      }
    });
  };

  initOpsNavigation();
  document.addEventListener('astro:page-load', initOpsNavigation);
</script>
