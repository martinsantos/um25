---
/**
 * NavbarV4 - Solid Clean Bar (V6 Dark Premium)
 * - Solid white with border-bottom
 * - Black CTA button (not red — more elegant)
 * - Shadow on scroll
 * - Touch targets 44px min
 */

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

const navItems = [
  { href: '/servicios', label: 'Servicios' },
  { href: '/antecedentes', label: 'Antecedentes' },
  { href: '/sectores', label: 'Sectores' },
  { href: '/nosotros', label: 'Nosotros' },
];

const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<header id="navHeader" class="fixed top-0 left-0 right-0 z-50 bg-white border-b border-gray-100 transition-shadow duration-300">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a href="/" class="flex items-center gap-2 group">
        <span class="font-brand text-xl text-gray-900" style="font-family:'Futura PT','Futura',sans-serif;letter-spacing:-0.03em;font-weight:500;">
          ultima<span class="text-um-primary" style="font-weight:700;">milla</span>
        </span>
      </a>

      <!-- Desktop Menu -->
      <div class="hidden md:flex items-center gap-1">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`relative px-4 py-2 text-sm font-medium rounded-lg transition-colors ${
              isActive(item.href)
                ? 'text-gray-900 font-semibold'
                : 'text-gray-500 hover:text-gray-900 hover:bg-gray-50'
            }`}
          >
            {item.label}
            {isActive(item.href) && (
              <span class="absolute bottom-0 left-1/2 -translate-x-1/2 w-4 h-0.5 bg-gray-900 rounded-full"></span>
            )}
          </a>
        ))}
        <a
          href="/contacto"
          class="ml-4 px-5 py-2 bg-gray-900 text-white rounded-lg text-sm font-medium hover:bg-gray-800 transition-colors"
        >
          Contacto
        </a>
      </div>

      <!-- Hamburger Button -->
      <button
        id="menuToggle"
        class="md:hidden p-2 -mr-2 rounded-xl hover:bg-gray-50 min-h-[44px] min-w-[44px] flex items-center justify-center transition-colors"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobileMenu"
      >
        <svg id="hamburgerIcon" class="w-5 h-5 text-gray-900" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="closeIcon" class="w-5 h-5 text-gray-900 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu -->
  <div id="mobileMenu" class="mobile-menu-hidden md:hidden border-t border-gray-100">
    <div class="px-4 py-3 space-y-1 bg-white">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`block px-4 py-3 rounded-xl min-h-[44px] flex items-center text-sm font-medium transition-colors ${
            isActive(item.href)
              ? 'text-gray-900 bg-gray-50 font-semibold'
              : 'text-gray-500 hover:bg-gray-50 hover:text-gray-900'
          }`}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/contacto"
        class="block px-4 py-3 mt-2 rounded-xl min-h-[44px] flex items-center justify-center text-sm font-semibold bg-gray-900 text-white hover:bg-gray-800 transition-colors"
      >
        Contacto
      </a>
    </div>
  </div>
</header>

<!-- Spacer -->
<div class="h-16"></div>

<style>
  .mobile-menu-hidden {
    display: none;
  }
  .mobile-menu-visible {
    display: block;
  }

  /* Scrolled state — glassmorphism + multi-layer shadow */
  .nav-scrolled {
    background: rgba(255, 255, 255, 0.85) !important;
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    box-shadow: 0 1px 2px rgba(0,0,0,0.04), 0 1px 3px rgba(0,0,0,0.06) !important;
  }

  @media (prefers-reduced-motion: reduce) {
    .mobile-menu-hidden,
    .mobile-menu-visible {
      transition: none;
    }
  }
</style>

<script>
  const menuToggle = document.getElementById('menuToggle');
  const mobileMenu = document.getElementById('mobileMenu');
  const hamburgerIcon = document.getElementById('hamburgerIcon');
  const closeIcon = document.getElementById('closeIcon');
  const navHeader = document.getElementById('navHeader');

  if (menuToggle && mobileMenu && hamburgerIcon && closeIcon) {
    menuToggle.addEventListener('click', function() {
      const isHidden = mobileMenu.classList.contains('mobile-menu-hidden');
      if (isHidden) {
        mobileMenu.classList.remove('mobile-menu-hidden');
        mobileMenu.classList.add('mobile-menu-visible');
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        menuToggle.setAttribute('aria-expanded', 'true');
        menuToggle.setAttribute('aria-label', 'Cerrar menú');
      } else {
        mobileMenu.classList.remove('mobile-menu-visible');
        mobileMenu.classList.add('mobile-menu-hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.setAttribute('aria-label', 'Abrir menú');
      }
    });

    mobileMenu.querySelectorAll('a').forEach(function(link) {
      link.addEventListener('click', function() {
        mobileMenu.classList.remove('mobile-menu-visible');
        mobileMenu.classList.add('mobile-menu-hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.setAttribute('aria-label', 'Abrir menú');
      });
    });

    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && mobileMenu.classList.contains('mobile-menu-visible')) {
        mobileMenu.classList.remove('mobile-menu-visible');
        mobileMenu.classList.add('mobile-menu-hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.setAttribute('aria-label', 'Abrir menú');
        menuToggle.focus();
      }
    });

    document.addEventListener('click', function(e) {
      const target = e.target as Node;
      if (!menuToggle.contains(target) && !mobileMenu.contains(target) && mobileMenu.classList.contains('mobile-menu-visible')) {
        mobileMenu.classList.remove('mobile-menu-visible');
        mobileMenu.classList.add('mobile-menu-hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.setAttribute('aria-label', 'Abrir menú');
      }
    });
  }

  // Scroll behavior — add shadow
  if (navHeader) {
    window.addEventListener('scroll', function() {
      if (window.scrollY > 10) {
        navHeader.classList.add('nav-scrolled');
      } else {
        navHeader.classList.remove('nav-scrolled');
      }
    }, { passive: true });
  }
</script>
