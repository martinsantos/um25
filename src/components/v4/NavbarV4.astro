---
import UMLogo from '../brand/UMLogo.astro';
import { NAV_SECTORS, NAV_SERVICES } from '../../data/navigation';
import { shellLocale, shellRoutes } from '../../config/i18nShell';
/** Cabecera comercial UMSA: marca, navegación principal (con mega-menú de
 *  servicios y sectores en escritorio) y contacto. */

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const { lang, t, alternate, alternateLang } = shellLocale(currentPath);
const routes = shellRoutes(lang);

const navItems: { href: string; label: string; mega?: 'servicios' | 'sectores' }[] = [
  { href: routes.home, label: t.nav.home },
  { href: routes.services, label: t.nav.services, mega: 'servicios' },
  { href: routes.sectors, label: t.nav.sectors, mega: 'sectores' },
  { href: routes.projects, label: t.nav.projects },
  { href: routes.blog, label: t.nav.blog },
];

const moreItems = [
  { href: routes.about, label: lang === 'en' ? 'About' : 'Nosotros' },
  { href: routes.cctv, label: 'UMSA CCTV AI' },
  { href: routes.certifications, label: lang === 'en' ? 'Technical documentation' : 'Certificaciones' },
  { href: routes.contact, label: lang === 'en' ? 'Contact' : 'Contacto' },
];

const isActive = (href: string) => {
  const clean = currentPath.replace(/\/$/, '') || '/';
  const target = href.replace(/\/$/, '') || '/';
  if (target === '/' || target === '/en') return clean === target;
  return clean.startsWith(target);
};

const moreIsActive = moreItems.some((item) => isActive(item.href));
---

<header class="um-ops-header">
  <div class="um-ops-header__main">
    <div class="um-ops-container um-ops-header__row">
      <a href="/" class="um-ops-logo" aria-label="Ir al inicio">
        <UMLogo title="ultimamilla.com.ar" />
      </a>

      <nav class="um-ops-nav" aria-label="Navegación principal">
        {navItems.map((item) => item.mega ? (
          <div class:list={['um-ops-mega', { 'is-active': isActive(item.href) }]} data-mega={item.mega}>
            <a href={item.href} class:list={['um-ops-nav__link', 'um-ops-mega__link', { 'is-active': isActive(item.href) }]}>
              {item.label}
            </a>
            <button type="button" class="um-ops-mega__toggle" aria-expanded="false" aria-controls={`um-mega-${item.mega}`} aria-label={item.mega === 'servicios' ? t.megaServices.open : t.megaSectors.open}>
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
            </button>
            <div class="um-ops-mega__panel" id={`um-mega-${item.mega}`}>
              <div class="um-ops-container um-ops-mega__inner">
                {item.mega === 'servicios' ? (
                  <>
                    <div class="um-ops-mega__intro">
                      <p class="um-ops-mega__kicker"><i></i>{t.megaServices.kicker}</p>
                      <p class="um-ops-mega__lead">{t.megaServices.lead}</p>
                      <a class="um-ops-mega__all" href={routes.services}>{t.megaServices.all} <span aria-hidden="true">→</span></a>
                    </div>
                    <ul class="um-ops-mega__grid um-ops-mega__grid--services">
                      {NAV_SERVICES.map((s) => (
                        <li>
                          <a href={s.href} class:list={[{ 'is-active': currentPath.startsWith(`/servicios/${s.code}`) }]}>
                            <span class="um-ops-mega__code">{s.code}</span>
                            <span class="um-ops-mega__name">{s.name}</span>
                            <span class="um-ops-mega__text">{s.text}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                ) : (
                  <>
                    <div class="um-ops-mega__intro">
                      <p class="um-ops-mega__kicker"><i></i>{t.megaSectors.kicker}</p>
                      <p class="um-ops-mega__lead">{t.megaSectors.lead}</p>
                      <a class="um-ops-mega__all" href={routes.sectors}>{t.megaSectors.all} <span aria-hidden="true">→</span></a>
                    </div>
                    <ul class="um-ops-mega__grid um-ops-mega__grid--sectors">
                      {NAV_SECTORS.map((s) => (
                        <li>
                          <a href={s.href} class:list={[{ 'is-active': isActive(s.href) }]}>
                            <span class="um-ops-mega__code" aria-label={s.count ? `${s.count} casos documentados` : undefined}>{s.count ?? '—'}</span>
                            <span class="um-ops-mega__name">{s.name}</span>
                            <span class="um-ops-mega__text">{s.text}</span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </>
                )}
              </div>
            </div>
          </div>
        ) : (
          <a href={item.href} class:list={['um-ops-nav__link', { 'is-active': isActive(item.href) }]}>
            {item.label}
          </a>
        ))}

        <div class:list={['um-ops-more', { 'is-active': moreIsActive }]}>
          <button type="button" class="um-ops-more__trigger" aria-haspopup="true" aria-expanded="false">
            {t.nav.more}
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
          </button>
          <div class="um-ops-more__menu" role="menu">
            {moreItems.map((item) => (
              <a href={item.href} role="menuitem" class:list={[{ 'is-active': isActive(item.href) }]}>
                {item.label}
              </a>
            ))}
          </div>
        </div>
      </nav>

      <a href={alternate} class="um-ops-lang" hreflang={alternateLang} lang={alternateLang} aria-label={t.lang.switchTo} title={t.lang.switchTo}>
        {t.lang.code}
      </a>

      {lang === 'en' ? (
        <a href="/en/contacto" class="um-ops-cta">{t.nav.contact}</a>
      ) : (
        <a href="/contacto" class="um-ops-cta">
          Contactar
        </a>
      )}

      <button
        id="menuToggle"
        class="um-ops-menu-toggle"
        type="button"
        aria-label={t.mobile.open}
        data-label-open={t.mobile.open}
        data-label-close={t.mobile.close}
        aria-expanded="false"
        aria-controls="mobileMenu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </div>

</header>

<div id="mobileMenu" class="um-ops-mobile" hidden>
  <nav class="um-ops-container um-ops-mobile__inner" aria-label="Menú móvil">
    <ul class="um-ops-mobile__primary">
      {navItems.map((item) => (
        <li>
          <a href={item.href} class:list={[{ 'is-active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <p class="um-ops-mobile__label">{t.mobile.more}</p>
    <ul class="um-ops-mobile__secondary">
      {moreItems.filter((item) => item.href !== routes.contact).map((item) => (
        <li>
          <a href={item.href} class:list={[{ 'is-active': isActive(item.href) }]} aria-current={isActive(item.href) ? 'page' : undefined}>
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <div class="um-ops-mobile__foot">
      <a href={routes.contact} class="um-ops-mobile__cta">
        {t.nav.contact}
        <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 8h9M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
      </a>
      <p>{t.mobile.hours} · <a href={alternate} hreflang={alternateLang} lang={alternateLang}>{t.lang.switchTo}</a></p>
    </div>
  </nav>
</div>

<div class="um-ops-dock" data-ops-dock aria-hidden="true">
  <a href={routes.contact} class="um-ops-dock__cta" data-ops-dock-cta tabindex="-1">
    {t.nav.contact}
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true"><path d="M3 8h9M8.5 4l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.6" /></svg>
  </a>
</div>

<style>
  .um-ops-header {
    position: sticky;
    top: 0;
    z-index: var(--um-z-header);
    isolation: isolate;
    background: rgba(10,10,11,0.92);
    color: #fff;
    border-bottom: 1px solid rgba(255,255,255,0.1);
    backdrop-filter: blur(14px);
  }

  .um-ops-container {
    /* Share the same reading axis as the public page shells. */
    width: min(var(--um-container-wide), calc(100% - (var(--um-page-gutter) * 2)));
    margin-inline: auto;
  }

  .um-ops-header__main {
    position: relative;
    z-index: 2;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .um-ops-header__row {
    display: flex;
    min-height: 64px;
    align-items: center;
    gap: 12px;
  }

  .um-ops-logo {
    /* Área táctil de 44 px sin alterar el tamaño ni la posición del logo. */
    padding-block: 12px;
    margin-block: -12px;
    flex: 0 0 auto;
    color: #fff;
    display: block;
    font-size: clamp(1.25rem, 1.5vw, 1.4rem);
    line-height: 1;
    text-decoration: none;
    white-space: nowrap;
  }

  .um-ops-logo span {
    color: #dc2626;
  }

  .um-ops-tag,
  .um-ops-ticker {
    font-family: var(--um-font-mono);
    text-transform: uppercase;
    letter-spacing: 0.17em;
  }

  .um-ops-tag {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    border: 1px solid rgba(255,255,255,0.12);
    padding: 6px 9px;
    color: #71717a;
    font-size: 16px;
    line-height: 1;
  }

  .um-ops-tag i,
  .um-ops-ticker__badge i {
    position: relative;
    width: 6px;
    height: 6px;
    display: inline-flex;
  }

  .um-ops-tag i::before,
  .um-ops-tag i::after,
  .um-ops-ticker__badge i::before,
  .um-ops-ticker__badge i::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: #dc2626;
  }

  .um-ops-tag i::before,
  .um-ops-ticker__badge i::before {
    animation: um-ops-ping 1.8s cubic-bezier(0,0,0.2,1) infinite;
  }

  @keyframes um-ops-ping {
    75%, 100% { transform: scale(2.5); opacity: 0; }
  }

  .um-ops-nav {
    /* Sin posicionamiento propio: el panel del mega-menú se ancla al ancho
       completo de .um-ops-header__main. */
    position: static;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 2px;
    margin-left: auto;
  }

  .um-ops-nav__link,
  .um-ops-more__trigger {
    position: relative;
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 7px;
    border: 0;
    background: transparent;
    color: #a1a1aa;
    padding: 0 15px;
    font-family: var(--um-font-body);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1;
    text-decoration: none;
    cursor: pointer;
  }

  .um-ops-nav__link:hover,
  .um-ops-nav__link.is-active,
  .um-ops-more:hover .um-ops-more__trigger,
  .um-ops-more.is-active .um-ops-more__trigger {
    color: #fff;
  }

  .um-ops-nav__link.is-active::after,
  .um-ops-more.is-active .um-ops-more__trigger::after,
  .um-ops-more:hover .um-ops-more__trigger::after {
    content: "";
    position: absolute;
    left: 15px;
    right: 15px;
    bottom: 0;
    height: 2px;
    background: #dc2626;
  }

  /* Mega-menú de escritorio: Servicios y Sectores despliegan un panel a todo
     el ancho con los ocho frentes / nueve sectores, código y promesa. */
  .um-ops-mega {
    display: inline-flex;
    align-items: center;
  }

  .um-ops-mega__link {
    padding-right: 4px;
  }

  .um-ops-mega__toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    min-height: 44px;
    margin-right: 6px;
    border: 0;
    background: transparent;
    color: #a1a1aa;
    cursor: pointer;
  }

  .um-ops-mega__toggle svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    transition: transform 0.18s ease;
  }

  .um-ops-mega:hover .um-ops-mega__toggle,
  .um-ops-mega.is-open .um-ops-mega__toggle,
  .um-ops-mega__toggle:focus-visible {
    color: #fff;
  }

  .um-ops-mega.is-open .um-ops-mega__toggle svg {
    transform: rotate(180deg);
  }

  .um-ops-mega__toggle:focus-visible {
    outline: 2px solid #dc2626;
    outline-offset: -2px;
  }

  .um-ops-mega:hover .um-ops-mega__link,
  .um-ops-mega.is-open .um-ops-mega__link {
    color: #fff;
  }

  /* El subrayado cubre texto y flecha juntos: sale del link (que ya está
     posicionado) y se estira sobre el botón de la flecha. .um-ops-mega NO se
     posiciona: el panel tiene que anclarse al ancho completo del header. */
  .um-ops-mega:hover .um-ops-mega__link::after,
  .um-ops-mega.is-open .um-ops-mega__link::after {
    content: "";
    position: absolute;
    left: 15px;
    right: -22px;
    bottom: 0;
    height: 2px;
    background: #dc2626;
  }

  .um-ops-mega__panel {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: var(--um-z-header-menu);
    padding: 28px 0 34px;
    background: #0b0b0c;
    border-top: 1px solid rgba(220,38,38,0.42);
    border-bottom: 1px solid rgba(255,255,255,0.1);
    opacity: 0;
    visibility: hidden;
    transform: translateY(-4px);
    transition: opacity 0.16s ease, transform 0.16s ease, visibility 0s linear 0.16s;
  }

  .um-ops-mega:hover .um-ops-mega__panel,
  .um-ops-mega.is-open .um-ops-mega__panel {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    transition-delay: 0.06s, 0.06s, 0s;
  }

  .um-ops-mega__inner {
    display: grid;
    grid-template-columns: minmax(240px, 300px) minmax(0, 1fr);
    gap: clamp(28px, 4vw, 64px);
    align-items: start;
  }

  .um-ops-mega__kicker {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .um-ops-mega__kicker i {
    width: 22px;
    height: 2px;
    background: #dc2626;
  }

  .um-ops-mega__lead {
    margin: 14px 0 0;
    color: #a1a1aa;
    font-size: 1rem;
    line-height: 1.55;
    max-width: 30ch;
  }

  .um-ops-mega__all {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: 18px;
    min-height: 44px;
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-bottom: 1px solid #dc2626;
  }

  .um-ops-mega__all:hover,
  .um-ops-mega__all:focus-visible {
    color: #fff;
    border-bottom-color: #fff;
  }

  .um-ops-mega__grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0 24px;
    border-top: 1px solid rgba(255,255,255,0.1);
  }

  .um-ops-mega__grid--services {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .um-ops-mega__grid--sectors {
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .um-ops-mega__grid a {
    display: grid;
    grid-template-columns: 52px minmax(0, 1fr);
    grid-template-areas: "code name" "code text";
    column-gap: 10px;
    padding: 13px 10px 14px 0;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    color: #fff;
    text-decoration: none;
    transition: background-color 0.15s ease;
  }

  .um-ops-mega__grid a:hover,
  .um-ops-mega__grid a:focus-visible,
  .um-ops-mega__grid a.is-active {
    background: rgba(255,255,255,0.045);
  }

  .um-ops-mega__grid a:focus-visible {
    outline: 2px solid #dc2626;
    outline-offset: -2px;
  }

  .um-ops-mega__code {
    grid-area: code;
    font-family: var(--um-font-mono);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
    color: #71717a;
    font-variant-numeric: tabular-nums;
    padding-top: 1px;
  }

  .um-ops-mega__grid a:hover .um-ops-mega__code,
  .um-ops-mega__grid a.is-active .um-ops-mega__code {
    color: #dc2626;
  }

  .um-ops-mega__name {
    grid-area: name;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .um-ops-mega__text {
    grid-area: text;
    margin-top: 3px;
    color: #a1a1aa;
    font-size: 1rem;
    line-height: 1.45;
  }

  @media (prefers-reduced-motion: reduce) {
    .um-ops-mega__panel,
    .um-ops-mega__toggle svg {
      transition: none;
    }
  }

  .um-ops-more {
    position: relative;
    z-index: 4;
  }

  .um-ops-more__trigger svg {
    width: 12px;
    height: 12px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }

  .um-ops-more__menu {
    position: absolute;
    top: calc(100% + 0px);
    right: 0;
    min-width: 230px;
    padding: 10px 0;
    border: 1px solid rgba(255,255,255,0.1);
    background: #101012;
    border-top-color: rgba(220,38,38,0.42);
    z-index: var(--um-z-header-menu);
    opacity: 0;
    pointer-events: none;
    transform: translateY(-4px);
    transition: opacity 0.15s ease, transform 0.15s ease;
  }

  .um-ops-more:hover .um-ops-more__menu,
  .um-ops-more:focus-within .um-ops-more__menu {
    opacity: 1;
    pointer-events: auto;
    transform: translateY(0);
  }

  .um-ops-more__menu a {
    display: block;
    color: #a1a1aa;
    padding: 11px 18px;
    font-size: 16px;
    line-height: 1;
    text-decoration: none;
  }

  .um-ops-more__menu a:hover,
  .um-ops-more__menu a.is-active {
    color: #fff;
    background: rgba(220,38,38,0.09);
  }

  .um-ops-lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 44px;
    margin-left: 6px;
    padding: 0 8px;
    color: #a1a1aa;
    font-family: var(--um-font-mono);
    font-size: 1rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-decoration: none;
    border: 1px solid rgba(255,255,255,0.14);
  }

  .um-ops-lang:hover,
  .um-ops-lang:focus-visible {
    color: #fff;
    border-color: rgba(255,255,255,0.4);
  }

  .um-ops-lang:focus-visible {
    outline: 2px solid #dc2626;
    outline-offset: 2px;
  }

  .um-ops-cta {
    display: inline-flex;
    min-height: 44px;
    align-items: center;
    gap: 8px;
    margin-left: 12px;
    background: #dc2626;
    color: #fff;
    padding: 0 20px;
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    white-space: nowrap;
  }

  .um-ops-cta:hover {
    background: #dc2626;
    opacity: 0.9;
  }

  .um-ops-menu-toggle {
    display: none;
    width: 44px;
    height: 44px;
    margin-left: auto;
    border: 0;
    background: transparent;
    color: #fff;
    cursor: pointer;
  }

  .um-ops-menu-toggle span {
    display: block;
    width: 24px;
    height: 2px;
    margin: 5px auto;
    background: currentColor;
    transition: transform 0.18s ease, opacity 0.18s ease;
  }

  .um-ops-menu-toggle[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .um-ops-menu-toggle[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .um-ops-menu-toggle[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .um-ops-ticker {
    display: none;
  }

  .um-ops-ticker__row {
    display: flex;
    min-height: 28px;
    align-items: stretch;
  }

  .um-ops-ticker a {
    text-decoration: none;
  }

  .um-ops-ticker__badge,
  .um-ops-ticker__kpis,
  .um-ops-ticker__sla {
    border-color: rgba(255,255,255,0.08);
  }

  .um-ops-ticker__badge,
  .um-ops-ticker__sla {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #71717a;
    white-space: nowrap;
  }

  .um-ops-ticker__badge {
    border-right: 1px solid rgba(255,255,255,0.08);
    padding: 0 16px 0 0;
  }

  .um-ops-ticker__badge span {
    color: #2d8a2d;
    font-weight: 700;
  }

  .um-ops-ticker__badge svg {
    width: 13px;
    height: 13px;
    fill: none;
    stroke: #dc2626;
    stroke-width: 2;
  }

  .um-ops-ticker__kpis {
    display: flex;
    align-items: center;
    gap: 18px;
    border-right: 1px solid rgba(255,255,255,0.08);
    padding: 0 18px;
    white-space: nowrap;
  }

  .um-ops-ticker__kpis a,
  .um-ops-ticker__sla {
    color: #71717a;
  }

  .um-ops-ticker__kpis strong:first-child {
    color: #2d8a2d;
  }

  .um-ops-ticker strong {
    color: #fff;
    font: inherit;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .um-ops-ticker__marquee {
    flex: 1 1 0;
    width: 0;
    min-width: 0;
    overflow: hidden;
    overflow: clip;
  }

  .um-ops-ticker__track {
    display: flex;
    width: 100%;
    max-width: 100%;
    min-height: 28px;
    align-items: center;
    overflow: hidden;
  }

  .um-ops-event {
    flex: 1 1 0;
    min-width: 0;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: #a1a1aa;
    padding: 0 16px;
    font-size: 0.625rem;
    letter-spacing: 0;
    text-transform: none;
  }

  .um-ops-event span {
    color: #52525b;
    font-variant-numeric: tabular-nums;
  }

  .um-ops-event i {
    font-style: normal;
    font-weight: 700;
  }

  .um-ops-event i.is-ok { color: #2d8a2d; }
  .um-ops-event i.is-warn { color: #dc2626; }
  .um-ops-event i.is-info { color: #1a56c0; }

  .um-ops-event em {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-style: normal;
  }

  .um-ops-event b {
    color: #3f3f46;
    font-weight: 400;
  }

  .um-ops-ticker__sla {
    border-left: 1px solid rgba(255,255,255,0.08);
    padding-left: 18px;
  }

  /* Menú móvil: panel a pantalla completa bajo la cabecera, con jerarquía
     primaria/secundaria, CTA fijo al pie y scroll de fondo bloqueado. */
  .um-ops-mobile {
    position: fixed;
    inset: var(--um-ops-header-h, 63px) 0 0 0;
    z-index: var(--um-z-header);
    display: flex;
    flex-direction: column;
    background: #0a0a0b;
    border-top: 1px solid rgba(255,255,255,0.1);
    overflow-y: auto;
    overscroll-behavior: contain;
    animation: um-ops-menu-in 240ms cubic-bezier(.2,.8,.2,1);
  }

  .um-ops-mobile[hidden] {
    display: none;
  }

  @keyframes um-ops-menu-in {
    from { opacity: 0; transform: translateY(-8px); }
    to { opacity: 1; transform: none; }
  }

  .um-ops-mobile__inner {
    display: flex;
    flex: 1 0 auto;
    flex-direction: column;
    padding-top: 8px;
    padding-bottom: calc(24px + env(safe-area-inset-bottom, 0px));
  }

  .um-ops-mobile ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .um-ops-mobile__primary a {
    display: flex;
    min-height: 56px;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    color: #fafafa;
    font-family: var(--um-font-editorial, var(--um-font-body));
    font-size: 1.625rem;
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.1;
    text-decoration: none;
  }

  .um-ops-mobile__primary a::after {
    content: "";
    width: 8px;
    height: 8px;
    background: transparent;
  }

  .um-ops-mobile__primary a.is-active::after {
    background: #dc2626;
  }

  .um-ops-mobile__label {
    display: flex;
    align-items: center;
    gap: 12px;
    margin: 28px 0 4px;
    color: #a1a1aa;
    font-family: var(--um-font-editorial, var(--um-font-body));
    font-size: var(--x-fs-kicker);
    font-weight: 600;
    letter-spacing: 0.12em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .um-ops-mobile__label::before {
    content: "";
    width: 28px;
    height: 2px;
    background: #dc2626;
  }

  .um-ops-mobile__secondary a {
    display: flex;
    min-height: 44px;
    align-items: center;
    color: #d4d4d8;
    font-size: 1.0625rem;
    font-weight: 500;
    text-decoration: none;
  }

  .um-ops-mobile__secondary a.is-active,
  .um-ops-mobile__secondary a:hover,
  .um-ops-mobile__primary a:hover {
    color: #fff;
  }

  .um-ops-mobile__foot {
    margin-top: auto;
    padding-top: 32px;
  }

  .um-ops-mobile__cta {
    display: flex;
    min-height: 52px;
    align-items: center;
    justify-content: center;
    gap: 10px;
    background: #dc2626;
    color: #fff;
    font-size: 1.0625rem;
    font-weight: 700;
    text-decoration: none;
  }

  .um-ops-mobile__cta:active {
    background: #b91c1c;
  }

  .um-ops-mobile__foot p {
    margin: 12px 0 0;
    color: #a1a1aa;
    font-size: var(--x-fs-meta);
    line-height: 1.45;
    text-align: center;
  }

  .um-ops-mobile__foot p a {
    color: #fff;
    text-decoration: underline;
    text-decoration-color: #dc2626;
    text-underline-offset: 4px;
  }

  .um-ops-mobile a:focus-visible,
  .um-ops-menu-toggle:focus-visible,
  .um-ops-dock__cta:focus-visible {
    outline: 2px solid #dc2626;
    outline-offset: 2px;
  }

  /* Acceso rápido a contacto en teléfono: aparece al dejar el hero y se retira
     cuando hay otro CTA de contacto, el pie o un formulario a la vista. */
  .um-ops-dock {
    display: none;
  }

  @media (max-width: 760px) {
    .um-ops-dock {
      position: fixed;
      right: 16px;
      bottom: calc(16px + env(safe-area-inset-bottom, 0px));
      z-index: var(--um-z-sticky);
      display: block;
      opacity: 0;
      pointer-events: none;
      transform: translateY(12px);
      transition: opacity 240ms cubic-bezier(.2,.8,.2,1), transform 240ms cubic-bezier(.2,.8,.2,1);
    }

    .um-ops-dock.is-on {
      opacity: 1;
      pointer-events: auto;
      transform: none;
    }

    .um-ops-dock__cta {
      display: inline-flex;
      min-height: 48px;
      align-items: center;
      gap: 10px;
      padding: 0 20px;
      border: 1px solid rgba(255,255,255,0.14);
      background: #dc2626;
      color: #fff;
      font-size: 1rem;
      font-weight: 700;
      text-decoration: none;
      box-shadow: 0 8px 24px rgba(0,0,0,0.45);
    }

    .um-ops-dock__cta:active {
      background: #b91c1c;
    }
  }

  /* El bloqueo va en body: el body propaga su overflow al viewport, así la
     cabecera sticky sigue anclada arriba mientras el menú está abierto. */
  :global(html.um-ops-menu-open body) {
    overflow: hidden;
  }

  :global(html.um-ops-menu-open) .um-ops-mobile {
    touch-action: pan-y;
  }

  @media (max-width: 1110px) {
    .um-ops-nav,
    .um-ops-tag {
      display: none;
    }

    .um-ops-cta {
      margin-left: auto;
    }

    .um-ops-menu-toggle {
      display: block;
      margin-left: 4px;
    }

    .um-ops-header__row {
      min-height: 62px;
    }
  }

  @media (min-width: 1111px) {
    .um-ops-mobile,
    .um-ops-dock {
      display: none !important;
    }
  }

  @media (max-width: 760px) {
    .um-ops-cta {
      display: none;
    }

    .um-ops-lang {
      margin-left: auto;
      margin-right: 4px;
    }

    .um-ops-menu-toggle {
      margin-left: auto;
    }

    .um-ops-container {
      width: min(100% - 32px, var(--um-container-wide));
    }

    .um-ops-logo {
      font-size: clamp(1.05rem, 5vw, 1.28rem);
    }

    .um-ops-ticker {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .um-ops-mobile,
    .um-ops-dock {
      animation: none;
      transition: none;
    }

    .um-ops-ticker__track,
    .um-ops-tag i::before,
    .um-ops-ticker__badge i::before {
      animation: none;
    }
  }
</style>

<script>
  const initOpsNavigation = () => {
    const header = document.querySelector<HTMLElement>('.um-ops-header');
    const menuToggle = document.getElementById('menuToggle');
    const mobileMenu = document.getElementById('mobileMenu');
    if (!header || !menuToggle || !mobileMenu || menuToggle.dataset.bound === 'true') return;
    menuToggle.dataset.bound = 'true';

    // Mega-menú de escritorio: hover lo abre por CSS; teclado y clic usan is-open.
    const megas = [...document.querySelectorAll<HTMLElement>('.um-ops-mega')];
    const closeMegas = (except?: HTMLElement) => {
      megas.forEach((m) => {
        if (m === except) return;
        m.classList.remove('is-open');
        m.querySelector<HTMLButtonElement>('.um-ops-mega__toggle')?.setAttribute('aria-expanded', 'false');
      });
    };
    megas.forEach((mega) => {
      const toggle = mega.querySelector<HTMLButtonElement>('.um-ops-mega__toggle');
      const link = mega.querySelector<HTMLAnchorElement>('.um-ops-mega__link');
      if (!toggle) return;
      const setOpen = (open: boolean) => {
        closeMegas(mega);
        mega.classList.toggle('is-open', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      toggle.addEventListener('click', () => setOpen(!mega.classList.contains('is-open')));
      link?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown') { event.preventDefault(); setOpen(true); mega.querySelector<HTMLAnchorElement>('.um-ops-mega__grid a')?.focus(); }
      });
      mega.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && mega.classList.contains('is-open')) { event.preventDefault(); setOpen(false); toggle.focus(); }
      });
      mega.addEventListener('focusout', (event) => {
        const next = event.relatedTarget as Node | null;
        if (next && !mega.contains(next)) setOpen(false);
      });
      mega.addEventListener('mouseleave', () => { if (mega.classList.contains('is-open')) setOpen(false); });
    });
    document.addEventListener('click', (event) => {
      if (!megas.some((m) => m.contains(event.target as Node))) closeMegas();
    });

    const root = document.documentElement;
    const desktop = matchMedia('(min-width: 1111px)');
    const focusables = () => [menuToggle, ...mobileMenu.querySelectorAll<HTMLElement>('a[href], button')];
    // Todo lo que no es la cabecera ni el menú queda inerte mientras el menú está abierto.
    const outside = () => [...document.body.children].filter((el) => el !== header && el !== mobileMenu && el.tagName !== 'SCRIPT') as HTMLElement[];

    const isOpen = () => !mobileMenu.hasAttribute('hidden');
    let savedY = 0;
    const openMenu = () => {
      savedY = scrollY;
      root.style.setProperty('--um-ops-header-h', `${Math.max(0, Math.round(header.getBoundingClientRect().bottom))}px`);
      mobileMenu.removeAttribute('hidden');
      root.classList.add('um-ops-menu-open');
      outside().forEach((el) => { el.inert = true; });
      menuToggle.setAttribute('aria-expanded', 'true');
      menuToggle.setAttribute('aria-label', menuToggle.dataset.labelClose || 'Cerrar menú');
      mobileMenu.querySelector<HTMLElement>('a[href]')?.focus({ preventScroll: true });
    };
    const closeMenu = (restoreFocus = false) => {
      if (!isOpen()) return;
      mobileMenu.setAttribute('hidden', '');
      root.classList.remove('um-ops-menu-open');
      outside().forEach((el) => { el.inert = false; });
      if (Math.abs(scrollY - savedY) > 1) scrollTo({ top: savedY, behavior: 'instant' as ScrollBehavior });
      menuToggle.setAttribute('aria-expanded', 'false');
      menuToggle.setAttribute('aria-label', menuToggle.dataset.labelOpen || 'Abrir menú');
      if (restoreFocus) menuToggle.focus();
    };

    menuToggle.addEventListener('click', () => (isOpen() ? closeMenu() : openMenu()));
    mobileMenu.querySelectorAll('a').forEach((link) => link.addEventListener('click', () => closeMenu()));
    document.addEventListener('keydown', (event) => {
      if (!isOpen()) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        closeMenu(true);
        return;
      }
      if (event.key !== 'Tab') return;
      const list = focusables();
      const first = list[0];
      const last = list[list.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    });
    desktop.addEventListener('change', (e) => { if (e.matches) closeMenu(); });
    addEventListener('pageshow', () => closeMenu());
    addEventListener('popstate', () => closeMenu());

    // Dock de contacto (sólo teléfono).
    const dock = document.querySelector<HTMLElement>('[data-ops-dock]');
    const dockCta = dock?.querySelector<HTMLAnchorElement>('[data-ops-dock-cta]');
    const phone = matchMedia('(max-width: 760px)');
    const onContactPage = location.pathname.replace(/\/$/, '') === '/contacto';
    if (dock && dockCta && !onContactPage && 'IntersectionObserver' in window) {
      const blockers = new Set<Element>();
      let pastHero = false;
      const render = () => {
        const on = phone.matches && pastHero && blockers.size === 0;
        dock.classList.toggle('is-on', on);
        dock.setAttribute('aria-hidden', on ? 'false' : 'true');
        dockCta.tabIndex = on ? 0 : -1;
      };
      const watch = new IntersectionObserver((entries) => {
        entries.forEach((e) => (e.isIntersecting ? blockers.add(e.target) : blockers.delete(e.target)));
        render();
      });
      // Otros CTA de contacto, cualquier botón primario rojo, formularios y el pie
      // retiran el dock: nunca hay dos CTA primarios en pantalla ni tapa un formulario.
      const isRed = (el: Element) => /rgb\(220, 38, 38\)/.test(getComputedStyle(el).backgroundColor);
      const candidates = new Set<Element>([
        ...document.querySelectorAll('main a[href^="/contacto"], main [data-contact-open], main form, .um-site-footer, .um-contact-modal'),
        ...[...document.querySelectorAll('main a, main button')].filter(isRed),
      ]);
      candidates.forEach((el) => watch.observe(el));
      // Aparece al volver hacia arriba (intención de navegar) y se oculta mientras se lee hacia abajo.
      let lastY = scrollY;
      let goingUp = false;
      let ticking = false;
      const onScroll = () => {
        if (ticking) return;
        ticking = true;
        requestAnimationFrame(() => {
          ticking = false;
          const y = scrollY;
          const delta = y - lastY;
          if (Math.abs(delta) > 6) { goingUp = delta < 0; lastY = y; }
          pastHero = y > innerHeight * 0.85 && goingUp;
          render();
        });
      };
      addEventListener('scroll', onScroll, { passive: true });
      phone.addEventListener('change', render);
      render();
    }
  };

  initOpsNavigation();
  document.addEventListener('astro:page-load', initOpsNavigation);
</script>
