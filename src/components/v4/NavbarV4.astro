---
/**
 * NavbarV4 - Navbar responsivo V4 Design System
 * - Fixed position con backdrop blur
 * - Menu hamburguesa para móvil
 * - Touch targets 44px mínimo
 * - Highlight de página activa
 */

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;

// Navigation items
const navItems = [
  { href: '/servicios', label: 'Servicios' },
  { href: '/antecedentes', label: 'Antecedentes' },
  { href: '/sectores', label: 'Sectores' },
  { href: '/nosotros', label: 'Nosotros' },
  { href: '/blog', label: 'Blog' },
];

// Helper to check if current page
const isActive = (href: string) => {
  if (href === '/') return currentPath === '/';
  return currentPath.startsWith(href);
};
---

<nav
  class="um-site-nav fixed top-0 left-0 right-0 z-50 backdrop-blur-md"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-16 sm:h-20">
      <!-- Logo responsive -->
      <a href="/" class="um-brand-link flex items-center">
        <span class="um-logo">ultimamilla<span>.</span>com<span>.</span>ar</span>
      </a>

      <!-- Desktop Menu (visible ≥1180px; ver DESIGN.md § Navbar) -->
      <div class="um-desktop-menu items-center gap-4 xl:gap-7">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`um-nav-link ${isActive(item.href) ? 'is-active' : ''}`}
          >
            {item.label}
          </a>
        ))}
        <a
          href="/contacto"
          data-contact-open
          data-contact-intent="general"
          class="um-nav-cta px-5 py-2.5 rounded-[4px] text-base font-bold"
        >
          Contacto
        </a>
      </div>

      <!-- Hamburger Button (visible solo móvil) -->
      <button
        id="menuToggle"
        class="um-menu-toggle md:hidden p-2 -mr-2 rounded-[4px] min-h-[44px] min-w-[44px] flex items-center justify-center"
        aria-label="Abrir menú"
        aria-expanded="false"
        aria-controls="mobileMenu"
      >
        <svg id="hamburgerIcon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
        <svg id="closeIcon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile Menu Dropdown -->
  <div id="mobileMenu" class="um-mobile-menu mobile-menu-hidden md:hidden">
    <div class="px-4 py-4 space-y-1">
      {navItems.map((item) => (
        <a
          href={item.href}
          class={`um-mobile-link ${isActive(item.href) ? 'is-active' : ''}`}
        >
          {item.label}
        </a>
      ))}
      <a
        href="/contacto"
        data-contact-open
        data-contact-intent="general"
        class={`um-mobile-cta ${isActive('/contacto') ? 'is-active' : ''}`}
      >
        Contacto
      </a>
    </div>
  </div>
</nav>

<!-- Spacer to compensate for fixed navbar -->
<div class="h-16 sm:h-20"></div>

<style>
  /* Mobile menu animation */
  .mobile-menu-hidden {
    display: none;
  }

  .mobile-menu-visible {
    display: block;
  }

  .um-site-nav {
    background: var(--skin-nav-bg);
    border-bottom: 1px solid var(--skin-nav-line);
  }

  .um-brand-link {
    min-width: 0;
    max-width: calc(100vw - 92px);
  }

  .um-logo {
    display: block;
    max-width: 100%;
    color: var(--skin-nav-text-strong);
    font-family: var(--um-font-logo);
    font-size: 1.5rem;
    font-weight: 600;
    letter-spacing: 0;
    line-height: 1;
    overflow: hidden;
    text-overflow: clip;
    white-space: nowrap;
  }

  .um-logo span {
    color: var(--um-red);
  }

  .um-desktop-menu {
    display: flex;
  }

  .um-nav-link {
    color: var(--skin-nav-text);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
    padding: 0.5rem 0;
    border-bottom: 2px solid transparent;
    transition: color 160ms ease, border-color 160ms ease;
  }

  .um-nav-link:hover,
  .um-nav-link.is-active {
    color: var(--skin-nav-text-strong);
    border-bottom-color: var(--um-red);
  }

  .um-nav-cta,
  .um-mobile-cta {
    background: var(--um-red);
    color: #fff;
  }

  .um-nav-cta:hover,
  .um-mobile-cta:hover,
  .um-mobile-cta.is-active {
    background: var(--um-red-dark);
    color: #fff;
  }

  .um-menu-toggle {
    color: var(--skin-nav-text-strong);
    position: relative;
    z-index: 2;
  }

  .um-menu-toggle:hover {
    background: color-mix(in srgb, var(--skin-nav-text-strong) 10%, transparent);
  }

  .um-menu-toggle svg {
    color: var(--skin-nav-text-strong);
    stroke: var(--skin-nav-text-strong);
  }

  .um-menu-toggle::before {
    content: "";
    display: block;
    width: 24px;
    height: 16px;
    background:
      linear-gradient(var(--skin-nav-text-strong), var(--skin-nav-text-strong)) 0 0 / 24px 2px no-repeat,
      linear-gradient(var(--skin-nav-text-strong), var(--skin-nav-text-strong)) 0 7px / 24px 2px no-repeat,
      linear-gradient(var(--skin-nav-text-strong), var(--skin-nav-text-strong)) 0 14px / 24px 2px no-repeat;
  }

  .um-menu-toggle svg {
    display: none;
  }

  .um-mobile-menu {
    background: var(--skin-nav-bg);
    border-top: 1px solid var(--skin-nav-line);
  }

  .um-mobile-link {
    display: flex;
    min-height: 44px;
    align-items: center;
    padding: 0.75rem 1rem;
    border-left: 2px solid transparent;
    border-radius: 6px;
    color: var(--skin-nav-text);
    font-weight: 700;
    transition: background-color 160ms ease, color 160ms ease, border-color 160ms ease;
  }

  .um-mobile-link:hover,
  .um-mobile-link.is-active {
    background: color-mix(in srgb, var(--skin-nav-text-strong) 10%, transparent);
    border-left-color: var(--um-red);
    color: var(--skin-nav-text-strong);
  }

  .um-mobile-cta {
    display: flex;
    min-height: 44px;
    align-items: center;
    justify-content: center;
    margin-top: 0.5rem;
    padding: 0.75rem 1rem;
    border-radius: 6px;
    font-weight: 700;
    transition: background-color 160ms ease, color 160ms ease;
  }

  /* Desktop nav visible from 1180px (Forbes QA: 5 ítems + CTA sin colapsar antes de 1181px). */
  @media (min-width: 1180px) {
    .um-menu-toggle {
      display: none;
    }
  }

  @media (max-width: 1179px) {
    .um-desktop-menu {
      display: none !important;
    }

    .um-menu-toggle {
      display: flex !important;
      position: absolute;
      top: 10px;
      right: 16px;
    }

    .um-mobile-menu {
      display: none;
    }

    .um-mobile-menu.mobile-menu-visible {
      display: block;
    }

    .um-site-nav .um-logo {
      font-size: clamp(1.08rem, 4.6vw, 1.5rem) !important;
    }
  }

  @media (max-width: 420px) {
    .um-site-nav .um-logo {
      font-size: clamp(1rem, 4.2vw, 1.12rem) !important;
    }
  }

  /* Respect reduced motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu-hidden,
    .mobile-menu-visible {
      transition: none;
    }
  }
</style>

<script>
  // Mobile menu toggle functionality
  const menuToggle = document.getElementById('menuToggle');
  const mobileMenu = document.getElementById('mobileMenu');
  const hamburgerIcon = document.getElementById('hamburgerIcon');
  const closeIcon = document.getElementById('closeIcon');

  if (menuToggle && mobileMenu && hamburgerIcon && closeIcon) {
    menuToggle.addEventListener('click', function() {
      const isHidden = mobileMenu.classList.contains('mobile-menu-hidden');

      if (isHidden) {
        mobileMenu.classList.remove('mobile-menu-hidden');
        mobileMenu.classList.add('mobile-menu-visible');
        hamburgerIcon.classList.add('hidden');
        closeIcon.classList.remove('hidden');
        menuToggle.setAttribute('aria-expanded', 'true');
        menuToggle.setAttribute('aria-label', 'Cerrar menú');
      } else {
        mobileMenu.classList.remove('mobile-menu-visible');
        mobileMenu.classList.add('mobile-menu-hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.setAttribute('aria-label', 'Abrir menú');
      }
    });

    // Close menu when clicking a link
    mobileMenu.querySelectorAll('a').forEach(function(link) {
      link.addEventListener('click', function() {
        mobileMenu.classList.remove('mobile-menu-visible');
        mobileMenu.classList.add('mobile-menu-hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.setAttribute('aria-label', 'Abrir menú');
      });
    });

    // Close menu on Escape key
    document.addEventListener('keydown', function(e) {
      if (e.key === 'Escape' && mobileMenu.classList.contains('mobile-menu-visible')) {
        mobileMenu.classList.remove('mobile-menu-visible');
        mobileMenu.classList.add('mobile-menu-hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.setAttribute('aria-label', 'Abrir menú');
        menuToggle.focus();
      }
    });

    // Close menu when clicking outside
    document.addEventListener('click', function(e) {
      const target = e.target as Node;
      if (!menuToggle.contains(target) && !mobileMenu.contains(target) && mobileMenu.classList.contains('mobile-menu-visible')) {
        mobileMenu.classList.remove('mobile-menu-visible');
        mobileMenu.classList.add('mobile-menu-hidden');
        hamburgerIcon.classList.remove('hidden');
        closeIcon.classList.add('hidden');
        menuToggle.setAttribute('aria-expanded', 'false');
        menuToggle.setAttribute('aria-label', 'Abrir menú');
      }
    });
  }
</script>
