<script>
  const initOpsNavigation = () => {
    const header = document.querySelector<HTMLElement>('.um-ops-header');
    const menuToggle = document.getElementById('menuToggle');
    const mobileMenu = document.getElementById('mobileMenu');
    if (!header || !menuToggle || !mobileMenu || menuToggle.dataset.bound === 'true') return;
    menuToggle.dataset.bound = 'true';

    // Un solo estado visible para puntero, teclado y lector de pantalla.
    const megas = [...document.querySelectorAll<HTMLElement>('.um-ops-mega')];
    const closeMegas = (except?: HTMLElement) => {
      megas.forEach((m) => {
        if (m === except) return;
        m.classList.remove('is-open');
        m.querySelector<HTMLButtonElement>('.um-ops-mega__toggle')?.setAttribute('aria-expanded', 'false');
      });
    };
    megas.forEach((mega) => {
      const toggle = mega.querySelector<HTMLButtonElement>('.um-ops-mega__toggle');
      const link = mega.querySelector<HTMLAnchorElement>('.um-ops-mega__link');
      if (!toggle) return;
      mega.dataset.interactive = 'true';
      let hoverOnly = false;
      const setOpen = (open: boolean, hovered = false) => {
        hoverOnly = open && hovered;
        if (open) closeMegas(mega);
        mega.classList.toggle('is-open', open);
        toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      };
      toggle.addEventListener('click', event => setOpen((event.detail > 0 && hoverOnly) || !mega.classList.contains('is-open')));
      link?.addEventListener('keydown', (event) => {
        if (event.key === 'ArrowDown') { event.preventDefault(); setOpen(true); mega.querySelector<HTMLAnchorElement>('.um-ops-mega__grid a')?.focus(); }
      });
      mega.addEventListener('focusout', (event) => {
        const next = event.relatedTarget as Node | null;
        if (next && !mega.contains(next)) setOpen(false);
      });
      mega.addEventListener('pointerenter', event => { if (event.pointerType === 'mouse' && !mega.classList.contains('is-open')) setOpen(true, true); });
      mega.addEventListener('pointerleave', event => {
        if (event.pointerType === 'mouse' && !mega.querySelector('.um-ops-mega__panel')?.contains(document.activeElement)) setOpen(false);
      });
    });
    document.addEventListener('keydown', (event) => {
      if (event.key !== 'Escape') return;
      const opened = megas.find(m => m.classList.contains('is-open'));
      if (!opened) return;
      event.preventDefault();
      const restoreFocus = opened.contains(document.activeElement);
      closeMegas();
      if (restoreFocus) opened.querySelector<HTMLButtonElement>('.um-ops-mega__toggle')?.focus();
    });
    document.addEventListener('click', (event) => {
      if (!megas.some((m) => m.contains(event.target as Node))) closeMegas();
    });

    const root = document.documentElement;
    const desktop = matchMedia('(min-width: 1111px)');
    const focusables = () => [
      ...header.querySelectorAll<HTMLElement>('a[href], button'),
      ...mobileMenu.querySelectorAll<HTMLElement>('a[href], button'),
    ].filter(element => element.tabIndex >= 0 && element.getClientRects().length > 0);
    // Todo lo que no es la cabecera ni el menú queda inerte mientras el menú está abierto.
    const outside = () => [...document.body.children].filter((el) => el !== header && el !== mobileMenu && el.tagName !== 'SCRIPT') as HTMLElement[];

    const isOpen = () => !mobileMenu.hasAttribute('hidden');
    let savedY = 0;
    const suspended = new Set<HTMLElement>();
    const openMenu = () => {
      savedY = scrollY;
      root.style.setProperty('--um-ops-header-h', `${Math.max(0, Math.round(header.getBoundingClientRect().bottom))}px`);
      mobileMenu.removeAttribute('hidden');
      root.classList.add('um-ops-menu-open');
      rootScroll = 0;
      selectCatalog();
      for (const el of outside()) {
        if (el.inert) continue;
        el.inert = true;
        suspended.add(el);
      }
      menuToggle.setAttribute('aria-expanded', 'true');
      menuToggle.setAttribute('aria-label', menuToggle.dataset.labelClose || 'Cerrar menú');
      const active = mobileMenu.querySelector<HTMLElement>('[data-menu-current]');
      (active || mobileMenu.querySelector<HTMLElement>('.um-ops-mobile__row'))?.focus({ preventScroll: true });
    };
    const closeMenu = (restoreFocus = false) => {
      if (!isOpen()) return;
      mobileMenu.setAttribute('hidden', '');
      root.classList.remove('um-ops-menu-open');
      suspended.forEach(el => { el.inert = false; });
      suspended.clear();
      if (Math.abs(scrollY - savedY) > 1) scrollTo({ top: savedY, behavior: 'instant' as ScrollBehavior });
      menuToggle.setAttribute('aria-expanded', 'false');
      menuToggle.setAttribute('aria-label', menuToggle.dataset.labelOpen || 'Abrir menú');
      if (restoreFocus) menuToggle.focus({ preventScroll: true });
    };

    const catalogs = mobileMenu.querySelector<HTMLElement>('[data-menu-catalogs]')!;
    const groupButtons = [...mobileMenu.querySelectorAll<HTMLButtonElement>('[data-mobile-group-toggle]')];
    const switches = [...catalogs.querySelectorAll<HTMLButtonElement>('[data-menu-catalog]')];
    let rootScroll = 0;
    const selectCatalog = (selected?: HTMLButtonElement) => {
      if (selected && !mobileMenu.hasAttribute('data-browsing')) rootScroll = mobileMenu.scrollTop;
      mobileMenu.toggleAttribute('data-browsing', Boolean(selected));
      catalogs.hidden = !selected;
      for (const button of groupButtons) {
        const active = button === selected;
        button.setAttribute('aria-expanded', String(active));
        button.closest('li')?.toggleAttribute('data-selected', active);
        document.getElementById(button.getAttribute('aria-controls')!)!.hidden = !active;
      }
      for (const button of switches) {
        const active = Boolean(selected && button.getAttribute('aria-controls') === selected.getAttribute('aria-controls'));
        button.setAttribute('aria-pressed', String(active));
        if (active) button.focus({ preventScroll: true });
      }
      mobileMenu.scrollTop = selected ? 0 : rootScroll;
    };
    const menuIndex = () => {
      const from = groupButtons.find(button => button.getAttribute('aria-expanded') === 'true');
      selectCatalog();
      from?.focus({ preventScroll: true });
    };
    groupButtons.forEach(button => button.addEventListener('click', () => selectCatalog(button)));
    switches.forEach(button => button.addEventListener('click', () => {
      const target = groupButtons.find(group => group.getAttribute('aria-controls') === button.getAttribute('aria-controls'));
      if (target) selectCatalog(target);
    }));
    catalogs.querySelector('[data-menu-index]')?.addEventListener('click', menuIndex);
    menuToggle.addEventListener('click', () => (isOpen() ? closeMenu() : openMenu()));
    const closeOnNavigation = (event: MouseEvent) => {
      if (!isOpen() || event.defaultPrevented || event.button !== 0 ||
          event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
      const link = event.target instanceof Element ? event.target.closest<HTMLAnchorElement>('a[href]') : null;
      if (link && (!link.target || link.target === '_self') && !link.hasAttribute('download')) closeMenu();
    };
    header.addEventListener('click', closeOnNavigation);
    mobileMenu.addEventListener('click', closeOnNavigation);
    document.addEventListener('keydown', (event) => {
      if (!isOpen()) return;
      if (event.key === 'Escape') {
        event.preventDefault();
        if (mobileMenu.hasAttribute('data-browsing')) menuIndex();
        else closeMenu(true);
        return;
      }
      if (event.key !== 'Tab') return;
      const list = focusables();
      const first = list[0];
      const last = list[list.length - 1];
      if (event.shiftKey && document.activeElement === first) { event.preventDefault(); last.focus(); }
      else if (!event.shiftKey && document.activeElement === last) { event.preventDefault(); first.focus(); }
    });
    let lastNavigationFocus: Element | null = null;
    document.addEventListener('focusin', (event) => {
      const target = event.target;
      lastNavigationFocus = target instanceof Element && (header.contains(target) || mobileMenu.contains(target)) ? target : null;
    });
    desktop.addEventListener('change', (event) => {
      const focused = document.activeElement === document.body ? lastNavigationFocus : document.activeElement;
      closeMegas();
      if (event.matches) {
        const mobilePanel = focused?.closest('[data-mobile-catalog-panel]')?.id || focused?.getAttribute('aria-controls');
        const catalog = mobilePanel?.match(/^mobile-(servicios|sectores)$/)?.[1];
        const href = focused?.closest<HTMLAnchorElement>('a')?.getAttribute('href');
        closeMenu();
        if (focused === menuToggle || (focused && mobileMenu.contains(focused))) {
          const links = [...header.querySelectorAll<HTMLAnchorElement>('.um-ops-nav__link, .um-ops-cta')];
          const equivalent = links.find(link => catalog ? link.closest<HTMLElement>('[data-mega]')?.dataset.mega === catalog : link.getAttribute('href') === href);
          const current = header.querySelector<HTMLElement>('.um-ops-nav__link[aria-current], .um-ops-logo[aria-current]');
          (equivalent || current || header.querySelector<HTMLElement>('.um-ops-logo'))?.focus({ preventScroll: true });
        }
      } else if (focused?.closest('.um-ops-nav') || (focused?.matches('.um-ops-cta') && !focused.getClientRects().length)) {
        menuToggle.focus({ preventScroll: true });
      }
    });
    addEventListener('pageshow', () => closeMenu());
    addEventListener('popstate', () => closeMenu());
  };

  initOpsNavigation();
  document.addEventListener('astro:page-load', initOpsNavigation);
</script>
