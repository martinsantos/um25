---
import EnhancedImage from "./EnhancedImage.astro";

// Componente para mostrar antecedentes destacados
const { antecedentes } = Astro.props;

// Función para formatear la fecha
const formatDate = (dateString) => {
  if (!dateString) return '';
  const options = { year: 'numeric', month: 'long', day: 'numeric' };
  return new Date(dateString).toLocaleDateString('es-ES', options);
};

// Función para generar slugs
const generateSlug = (text = '') => {
  if (!text) return 'proyecto';
  return String(text)
    .toLowerCase()
    .normalize("NFD").replace(/[\u0300-\u036f]/g, "")
    .replace(/[^\w\s-]/g, '')
    .trim()
    .replace(/\s+/g, '-')
    .replace(/-+/g, '-')
    .replace(/^-+|-+$/g, '')
    .slice(0, 50);
};
---

<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
  {antecedentes.map(item => (
    <div 
      key={item.id} 
      class="bg-white rounded-lg shadow-md overflow-hidden hover:shadow-lg transition-shadow h-full flex flex-col group"
    >
      <div class="relative h-48 overflow-hidden">
        <EnhancedImage
          src={item.Imagen?.id ? 
            `${import.meta.env.PUBLIC_DIRECTUS_URL}/assets/${item.Imagen.id}?width=600&height=400&fit=cover` : 
            null}
          alt={item.Titulo || 'Proyecto destacado'}
          width={600}
          height={400}
          class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
          fallbackSrc="/images/placeholder-project.jpg"
          fallbackAlt={`Imagen de proyecto ${item.Titulo || 'genérico'}`}
          containerClass="w-full h-full bg-gray-100"
        />
      </div>
      
      <div class="p-6 flex-grow flex flex-col">
        <div class="flex-grow">
          <h3 class="text-xl font-bold text-gray-800 mb-2 group-hover:text-red-600 transition-colors">
            {item.Titulo || 'Proyecto sin título'}
          </h3>
          
          {item.Fecha && (
            <p class="text-sm text-gray-500 mb-3">{formatDate(item.Fecha)}</p>
          )}
          
          {item.Servicios && item.Servicios.length > 0 && (
            <div class="flex flex-wrap gap-2 mb-3">
              {item.Servicios.map(servicio => (
                <span 
                  key={servicio.Servicios_id?.id || Math.random()}
                  class="inline-block bg-gray-100 text-gray-800 text-xs px-2 py-1 rounded"
                >
                  {servicio.Servicios_id?.Titulo || 'Servicio'}
                </span>
              ))}
            </div>
          )}
          
          <p class="text-gray-600 line-clamp-3">
            {item.Descripcion || 'Descripción no disponible.'}
          </p>
        </div>
        
        <div class="mt-4 pt-4 border-t border-gray-100">
          <a 
            href={`/antecedentes/${item.id}/${generateSlug(item.Titulo)}`}
            class="inline-flex items-center text-red-600 hover:text-red-700 font-medium"
            aria-label={`Ver detalles de ${item.Titulo || 'este proyecto'}`}
          >
            Ver proyecto
            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 ml-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </div>
    </div>
  ))}
</div>

<style>
  .line-clamp-3 {
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  
  .group:hover .group-hover\:scale-105 {
    transform: scale(1.05);
  }
  
  a:focus {
    outline: 2px solid rgba(220, 38, 38, 0.5);
    outline-offset: 2px;
    border-radius: 0.25rem;
  }
</style>
