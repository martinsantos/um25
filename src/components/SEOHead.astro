---
export interface Props {
  title: string;
  description?: string;
  keywords?: string;
  canonicalUrl?: string;
  ogImage?: string;
}

const { 
  title,
  description = "ULTIMA MILLA - Empresa líder en servicios IT, telecomunicaciones, seguridad informática y desarrollo de software en Argentina.",
  keywords = "ULTIMA MILLA, servicios IT, telecomunicaciones, seguridad informática, desarrollo software, Argentina",
  canonicalUrl = `https://ultimamilla.com.ar${Astro.url.pathname}`,
  ogImage = "https://ultimamilla.com.ar/images/ultima-milla-og.jpg"
} = Astro.props;

const fullTitle = title.includes('ULTIMA MILLA') ? title : `${title} - ULTIMA MILLA`;
---

<!-- Primary Meta Tags -->
<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="keywords" content={keywords} />
<meta name="author" content="ULTIMA MILLA" />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalUrl} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={canonicalUrl} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:site_name" content="ULTIMA MILLA" />

<!-- Twitter -->
<meta property="twitter:card" content="summary_large_image" />
<meta property="twitter:url" content={canonicalUrl} />
<meta property="twitter:title" content={fullTitle} />
<meta property="twitter:description" content={description} />
<meta property="twitter:image" content={ogImage} />
