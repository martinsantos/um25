---
import type { GeoCommercialHub } from '../../data/geoCommercialHubs';
import { resolveReplicaH1 } from '../../utils/replicaProdCopy';
import BudgetBriefFields from '../um/BudgetBriefFields.astro';

interface Props {
  hub: GeoCommercialHub;
}

const { hub } = Astro.props;
const hubH1 = resolveReplicaH1(`/${hub.slug}`, hub.h1);
const intentLabel = {
  comparison: 'Comparación de proveedor',
  decision: 'Decisión de compra',
  research: 'Investigación técnica'
}[hub.intent];

const proofItems = hub.proof.map((item, index) => {
  const supportMatch = item.match(/24\/7/);
  if (supportMatch) {
    return {
      value: '24/7',
      label: item.replace(/24\/7/g, '').replace(/\s+/g, ' ').trim()
    };
  }

  const metricMatch = item.match(/^(\d+\+?|\d+%|\d+\/\d+)\s*(.*)$/);
  if (metricMatch) {
    return {
      value: metricMatch[1],
      label: metricMatch[2] || item
    };
  }

  return {
    value: String(index + 1).padStart(2, '0'),
    label: item
  };
});

const mediaByHub: Record<string, { src: string; alt: string; caption: string }> = {
  'servicios-it-empresas-mendoza': {
    src: '/images/hero/foto-general.jpg',
    alt: 'Infraestructura técnica y operación IT para empresas',
    caption: 'Operación local, continuidad nacional'
  },
  'presupuesto-servicios-it-empresas': {
    src: '/images/hero/foto-soporte.jpg',
    alt: 'Herramientas de diagnóstico para servicios IT empresariales',
    caption: 'Alcance verificable antes de cotizar'
  },
  'proyectos-ingenieria-it-mendoza': {
    src: '/images/hero/foto-electricos.jpg',
    alt: 'Infraestructura eléctrica y técnica para proyectos IT',
    caption: 'Ingeniería, campo y documentación'
  },
  'servicios-it-empresas-argentina': {
    src: '/images/hero/foto-consultoria.jpg',
    alt: 'Equipo técnico y consultoría IT para organizaciones',
    caption: 'Cobertura planificada y soporte trazable'
  }
};

const heroMedia = mediaByHub[hub.slug] || mediaByHub['servicios-it-empresas-mendoza'];
---

<article class="geo-dossier">
  <section class="geo-dossier-hero">
    <div class="um-container geo-dossier-hero__grid">
      <div class="geo-dossier-hero__copy">
        <nav class="geo-dossier-crumb" aria-label="Breadcrumb">
          <a href="/">Inicio</a>
          <span>/</span>
          <span>{hubH1}</span>
        </nav>
        <p class="geo-dossier-kicker">{hub.eyebrow}</p>
        <h1>{hubH1}</h1>
        <div class="geo-dossier-actions">
          <a class="um-btn-primary" href="/contacto">{hub.primaryCta}</a>
          <a class="um-btn-secondary" href={hub.secondaryHref}>{hub.secondaryCta}</a>
        </div>
        <p class="geo-dossier-lead">{hub.lead}</p>
      </div>

      <aside class="geo-dossier-side" aria-label="Resumen comercial GEO">
        <div class="geo-dossier-brief">
          <div class="geo-dossier-brief__top">
            <span>Dossier comercial</span>
            <strong>{hub.market}</strong>
          </div>
          <dl>
            <div>
              <dt>Intención</dt>
              <dd>{intentLabel}</dd>
            </div>
            <div>
              <dt>Salida</dt>
              <dd>{hub.primaryCta}</dd>
            </div>
          </dl>
        </div>

        <figure class="geo-dossier-media">
          <img src={heroMedia.src} alt={heroMedia.alt} loading="eager" fetchpriority="high" decoding="async" width="1200" height="800" />
          <figcaption>
            <span>{heroMedia.caption}</span>
            <strong>{hub.market}</strong>
          </figcaption>
        </figure>
      </aside>
    </div>
  </section>

  <section class="geo-proofline" aria-label="Prueba institucional">
    <div class="um-container geo-proofline__grid">
      {proofItems.map((item) => (
        <div>
          <span>{item.value}</span>
          <strong>{item.label}</strong>
        </div>
      ))}
    </div>
  </section>

  <section class="geo-dossier-section">
    <div class="um-container geo-dossier-two">
      <div>
        <p class="geo-dossier-kicker">Criterio de compra</p>
        <h2>Qué debe resolver el proveedor</h2>
      </div>
      <div class="geo-dossier-copy">
        <p>{hub.buyerNeed}</p>
        <p>{hub.decisionFrame}</p>
        <ul class="geo-risk-list">
          {hub.operatingRisks.map((risk) => <li>{risk}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="geo-dossier-section geo-dossier-section--alt">
    <div class="um-container">
      <div class="geo-section-head">
        <p class="geo-dossier-kicker">Servicios conectados</p>
        <h2>Alcance técnico conectado a la operación</h2>
        <p>La decisión se ordena por alcance, criticidad, documentación y soporte.</p>
      </div>

      <div class="geo-service-ledger">
        {hub.services.map((service, index) => (
          <a href={service.href}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{service.title}</strong>
            <p>{service.summary}</p>
            <em>Ver servicio</em>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="geo-dossier-section">
    <div class="um-container geo-evidence-grid">
      <div class="geo-evidence-main">
        <p class="geo-dossier-kicker">Evidencia operativa</p>
        <h2>Evidencia antes que promesa</h2>
        <p>Los antecedentes conectan necesidad comercial, experiencia ejecutada y criterio técnico.</p>
        <a class="um-btn-secondary" href="/antecedentes">Explorar antecedentes</a>
      </div>

      <div class="geo-evidence-rows">
        {hub.cases.map((item, index) => (
          <a href={item.href}>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <div>
              <strong>{item.client}</strong>
              <p>{item.title}</p>
            </div>
            <em>{item.sector}</em>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="geo-dossier-section geo-dossier-section--alt">
    <div class="um-container geo-sector-process">
      <div>
        <div class="geo-section-head geo-section-head--compact">
          <p class="geo-dossier-kicker">Sectores relacionados</p>
          <h2>Contextos donde cambia el riesgo</h2>
        </div>
        <div class="geo-sector-list">
          {hub.sectors.map((sector, index) => (
            <a href={sector.href}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{sector.title}</strong>
              <p>{sector.summary}</p>
            </a>
          ))}
        </div>
      </div>

      <aside class="geo-process-card">
        <p class="geo-dossier-kicker">Método UMSA</p>
        <ol>
          {hub.process.map((step) => <li>{step}</li>)}
        </ol>
      </aside>
    </div>
  </section>

  <section class="geo-dossier-section geo-faq">
    <div class="um-container geo-faq__grid">
      <div>
        <p class="geo-dossier-kicker">Preguntas frecuentes</p>
        <h2>Respuestas breves para decidir</h2>
      </div>
      <div>
        {hub.faqs.map((faq) => (
          <details>
            <summary>{faq.question}</summary>
            <p>{faq.answer}</p>
          </details>
        ))}
      </div>
    </div>
  </section>

  {hub.slug === 'presupuesto-servicios-it-empresas' && (
    <section class="geo-dossier-section geo-budget-brief" id="presupuesto-brief" aria-labelledby="geo-budget-title">
      <div class="um-container geo-budget-brief__grid">
        <div>
          <p class="geo-dossier-kicker">Presupuesto por variables</p>
          <h2 id="geo-budget-title">Definí alcance antes de cotizar</h2>
          <p>
            Sin precio en web: sector, criticidad, sedes y tipo de intervención. Completá el contexto y continuá en contacto con el mismo equipo técnico.
          </p>
        </div>
        <form class="geo-budget-brief__form" action="/contacto" method="get">
          <BudgetBriefFields idPrefix="geo-budget" locale="es" />
          <button type="submit" class="um-btn-primary geo-budget-brief__submit">Continuar a contacto</button>
          <p class="geo-budget-brief__note">Los valores se precargan en el formulario de contacto.</p>
        </form>
      </div>
    </section>
  )}

  <section class="geo-final">
    <div class="um-container geo-final__inner">
      <div>
        <p class="geo-dossier-kicker">Próximo paso</p>
        <h2>Convertir intención de búsqueda en alcance técnico verificable.</h2>
      </div>
      <div>
        <a class="um-btn-primary" href="/contacto">{hub.primaryCta}</a>
        <a class="um-btn-secondary" href="/servicios">Ver servicios</a>
      </div>
    </div>
  </section>
</article>

<style>
  .geo-dossier {
    background: var(--skin-page);
    color: var(--skin-text);
  }

  .geo-dossier-hero {
    position: relative;
    overflow: hidden;
    background: #080808;
    color: #fff;
  }

  .geo-dossier-hero::before {
    content: "";
    position: absolute;
    inset: 80px 0 auto;
    height: 1px;
    background: rgba(255, 255, 255, 0.12);
  }

  :global(body[data-skin] main .geo-dossier-hero :where(h1, h2, h3, strong)),
  :global(body[data-skin] main .geo-final :where(h1, h2, h3, strong)) {
    color: #fff !important;
  }

  :global(body[data-skin] main .geo-dossier-hero :where(p, span, li, dd)),
  :global(body[data-skin] main .geo-final :where(p, span, li, dd)) {
    color: rgba(255, 255, 255, 0.72) !important;
  }

  :global(body[data-skin] main .geo-dossier-hero .geo-dossier-kicker),
  :global(body[data-skin] main .geo-final .geo-dossier-kicker) {
    color: rgba(255, 255, 255, 0.84) !important;
  }

  :global(body[data-skin] main .geo-dossier-panel span) {
    color: rgba(255, 255, 255, 0.58) !important;
  }

  :global(body[data-skin] main .geo-dossier-panel strong) {
    color: #fff !important;
  }

  .geo-dossier-hero::after {
    content: "";
    position: absolute;
    inset: auto 0 0;
    height: 1px;
    background: rgba(255, 255, 255, 0.18);
  }

  .geo-dossier-hero__grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: minmax(0, 0.58fr) minmax(360px, 0.42fr);
    gap: clamp(34px, 5.4vw, 72px);
    align-items: center;
    min-height: auto;
    padding-block: clamp(34px, 4.8vw, 58px) clamp(34px, 4.6vw, 58px);
  }

  .geo-dossier-hero__copy {
    max-width: 700px;
  }

  .geo-dossier-crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    color: rgba(255, 255, 255, 0.64);
    font-size: 1rem;
    margin-bottom: clamp(18px, 3vw, 30px);
  }

  .geo-dossier-crumb a:hover {
    color: #fff;
  }

  .geo-dossier-kicker {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 16px;
    color: var(--um-red) !important;
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0;
    line-height: 1.25;
    text-transform: none;
  }

  .geo-dossier-hero .geo-dossier-kicker,
  .geo-final .geo-dossier-kicker {
    color: rgba(255, 255, 255, 0.84) !important;
  }

  .geo-dossier-kicker::before {
    content: "";
    width: 42px;
    height: 2px;
    background: var(--um-red);
  }

  .geo-dossier-hero h1 {
    max-width: 14ch;
    font-size: clamp(2.14rem, 2.9vw, 3rem);
    line-height: 1.1;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .geo-dossier-lead {
    max-width: 640px;
    margin-top: 20px;
    color: rgba(255, 255, 255, 0.76);
    font-size: clamp(1.04rem, 1.08vw, 1.16rem);
    line-height: 1.64;
  }

  .geo-dossier-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .geo-dossier-hero .um-btn-primary {
    background: var(--um-red) !important;
    border-color: var(--um-red) !important;
    color: #fff !important;
    box-shadow: inset 0 0 0 1px var(--um-red);
  }

  .geo-dossier-hero .um-btn-primary:hover {
    background: #fff !important;
    border-color: #fff !important;
    color: #111 !important;
  }

  .geo-dossier-hero .um-btn-secondary {
    border-color: rgba(255, 255, 255, 0.35);
    color: #fff;
    color: #fff !important;
  }

  .geo-dossier-hero .um-btn-secondary:hover {
    background: #fff;
    border-color: #fff;
    color: #111;
  }

  .geo-dossier-side {
    display: grid;
    gap: 14px;
    align-self: center;
  }

  .geo-dossier-brief {
    position: relative;
    overflow: hidden;
    padding: clamp(18px, 2vw, 22px) 0;
    border-top: 0;
    border-bottom: 0;
    background: #0a0a0a;
    color: #fff;
  }

  .geo-dossier-brief::before {
    display: none;
  }

  .geo-dossier-brief__top {
    display: grid;
    grid-template-columns: 1fr;
    gap: 8px;
    padding-bottom: 16px;
    border-bottom: 0;
  }

  .geo-dossier-brief__top span,
  .geo-dossier-brief dt {
    color: rgba(255, 255, 255, 0.6);
    font-size: 1rem;
    font-weight: 500;
    line-height: 1.3;
  }

  .geo-dossier-brief__top strong {
    color: #fff;
    font-family: var(--um-font-display);
    font-size: clamp(1.35rem, 1.9vw, 1.78rem);
    font-weight: 600;
    line-height: 1.12;
  }

  .geo-dossier-brief dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.9rem;
    margin: 16px 0 0;
    padding-top: 1rem;
    border-top: 0;
    background: transparent;
  }

  .geo-dossier-brief dl div {
    min-height: 0;
    padding: 0;
    background: transparent;
  }

  .geo-dossier-brief dd {
    margin: 8px 0 0;
    color: #fff;
    font-family: var(--um-font-display);
    font-size: 1.05rem;
    font-weight: 600;
    line-height: 1.22;
  }

  .geo-dossier-media {
    position: relative;
    overflow: hidden;
    box-sizing: border-box;
    width: 100%;
    max-width: 100%;
    min-width: 0;
    min-height: 190px;
    aspect-ratio: 16 / 7.2;
    margin: 0;
    border-top: 0;
    border-bottom: 0;
    background: #111;
  }

  .geo-dossier-media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.86) contrast(1.05);
  }

  .geo-dossier-media::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(180deg, transparent 36%, rgba(0, 0, 0, 0.82)),
      linear-gradient(90deg, rgba(0, 0, 0, 0.28), transparent 58%);
  }

  .geo-dossier-media figcaption {
    position: absolute;
    z-index: 1;
    left: 24px;
    right: 24px;
    bottom: 22px;
    display: grid;
    gap: 6px;
    min-width: 0;
    color: #fff;
    text-shadow: 0 2px 18px rgba(0, 0, 0, 0.58);
  }

  .geo-dossier-media span {
    min-width: 0;
    color: rgba(255, 255, 255, 0.62);
    font-size: 1rem;
    overflow-wrap: anywhere;
  }

  .geo-dossier-media strong {
    min-width: 0;
    color: #fff;
    font-size: clamp(1.24rem, 1.6vw, 1.52rem);
    line-height: 1.14;
    overflow-wrap: anywhere;
  }

  .geo-dossier-panel {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 0;
    background: rgba(8, 8, 8, 0.58);
    backdrop-filter: blur(14px);
  }

  .geo-dossier-panel > div {
    min-height: 112px;
    padding: 20px;
    border-right: 0;
  }

  .geo-dossier-panel > div:last-child {
    border-right: 0;
  }

  .geo-dossier-panel span,
  .geo-dossier-panel strong {
    display: block;
  }

  .geo-dossier-panel span {
    margin-bottom: 12px;
    color: rgba(255, 255, 255, 0.58);
    font-size: 1rem;
  }

  .geo-dossier-panel strong {
    color: #fff;
    font-size: clamp(1.08rem, 1.2vw, 1.26rem);
    line-height: 1.2;
  }

  :global(body[data-skin="white"] main) .geo-dossier-hero {
    background: #050505;
    color: #fff;
    border-bottom: 0;
  }

  :global(body[data-skin="white"] main) .geo-dossier-hero::before {
    display: block;
    background:
      linear-gradient(90deg, rgba(5,5,5,0.94) 0%, rgba(5,5,5,0.82) 48%, rgba(5,5,5,0.38) 100%),
      linear-gradient(180deg, rgba(5,5,5,0.28) 0%, rgba(5,5,5,0.84) 100%);
  }

  :global(body[data-skin="white"] main .geo-dossier-hero :where(h1, h2, h3, strong)) {
    color: #fff !important;
  }

  :global(body[data-skin="white"] main .geo-dossier-hero :where(p, span, li, dd, .geo-dossier-crumb)) {
    color: rgba(255, 255, 255, 0.78) !important;
  }

  :global(body[data-skin="white"] main .geo-dossier-hero .geo-dossier-kicker) {
    color: rgba(255, 255, 255, 0.84) !important;
  }

  :global(body[data-skin="white"] main) .geo-dossier-panel {
    border-color: transparent;
    background: #ffffff;
    backdrop-filter: none;
  }

  :global(body[data-skin="white"] main .geo-dossier-hero .geo-dossier-brief) {
    border-color: rgba(255, 255, 255, 0.14) !important;
    background: rgba(5, 5, 5, 0.58) !important;
  }

  :global(body[data-skin="white"] main .geo-dossier-hero .geo-dossier-brief :where(strong, dd)) {
    color: #fff !important;
  }

  :global(body[data-skin="white"] main .geo-dossier-hero .geo-dossier-brief :where(span, dt)) {
    color: rgba(255, 255, 255, 0.68) !important;
  }

  :global(body[data-skin="white"] main .geo-dossier-hero .geo-dossier-brief dl) {
    background: transparent !important;
  }

  :global(body[data-skin="white"] main .geo-dossier-hero .geo-dossier-brief__top) {
    border-bottom-color: transparent !important;
  }

  :global(body[data-skin="white"] main) .geo-dossier-panel > div {
    border-color: transparent;
  }

  :global(body[data-skin="white"] main .geo-dossier-panel span) {
    color: var(--skin-muted) !important;
  }

  :global(body[data-skin="white"] main .geo-dossier-panel strong) {
    color: var(--skin-text) !important;
  }

  :global(body[data-skin="white"] main) .geo-dossier-media {
    border-color: transparent;
    background: #ffffff;
  }

  :global(body[data-skin="white"] main .geo-dossier-media figcaption span) {
    color: rgba(255, 255, 255, 0.76) !important;
  }

  :global(body[data-skin="white"] main .geo-dossier-media figcaption strong) {
    color: #fff !important;
  }

  :global(body[data-skin="white"] main) .geo-dossier-hero .um-btn-secondary {
    border-color: transparent;
    color: #fff !important;
    background: rgba(255, 255, 255, 0.1) !important;
  }

  :global(body[data-skin="white"] main) .geo-dossier-hero .um-btn-primary {
    background: var(--um-red) !important;
    border-color: var(--um-red) !important;
    color: #fff !important;
  }

  :global(body[data-skin="white"] main) .geo-dossier-hero .um-btn-primary:hover {
    background: #111 !important;
    border-color: #111 !important;
  }

  :global(body[data-skin="white"] main) .geo-dossier-hero .um-btn-secondary:hover {
    background: #fff;
    border-color: #fff;
    color: #111 !important;
  }

  .geo-proofline {
    border-bottom: 0;
    background: #090909;
    color: #fff;
  }

  .geo-proofline__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    border-left: 0;
  }

  .geo-proofline__grid > div {
    min-height: 96px;
    padding: 20px 28px;
    border-right: 0;
  }

  .geo-proofline span {
    display: block;
    color: #fff;
    font-family: var(--um-font-display);
    font-size: clamp(1.62rem, 2.35vw, 2.28rem);
    font-weight: 600;
    line-height: 1;
  }

  .geo-proofline strong {
    display: block;
    margin-top: 10px;
    color: rgba(255, 255, 255, 0.68);
    font-size: 1rem;
    line-height: 1.35;
  }

  :global(body[data-skin="white"] main) .geo-proofline {
    border-top: 0;
    border-bottom: 0;
    background: #fff;
    color: var(--skin-text);
  }

  :global(body[data-skin="white"] main) .geo-proofline__grid {
    border-left: 0;
  }

  :global(body[data-skin="white"] main) .geo-proofline__grid > div {
    min-height: 82px;
    padding: 16px 28px;
    border-right: 0;
  }

  :global(body[data-skin="white"] main) .geo-proofline span {
    color: var(--skin-text);
    font-size: clamp(1.42rem, 2vw, 1.92rem);
  }

  :global(body[data-skin="white"] main) .geo-proofline strong {
    margin-top: 8px;
    color: var(--skin-muted);
  }

  .geo-dossier-section {
    padding-block: clamp(56px, 6.8vw, 92px);
    background: var(--skin-section);
  }

  .geo-dossier-section--alt {
    background: #ffffff;
  }

  .geo-dossier-two {
    display: grid;
    grid-template-columns: minmax(0, 0.46fr) minmax(0, 0.54fr);
    gap: clamp(36px, 7vw, 96px);
    align-items: start;
  }

  .geo-dossier-two h2,
  .geo-section-head h2,
  .geo-evidence-main h2,
  .geo-query-grid h2,
  .geo-faq h2,
  .geo-final h2 {
    color: var(--skin-text);
