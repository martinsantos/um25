---
import {
  applyDisplayNameReplacements,
  formatDisplayName,
  truncateEditorialText,
} from '../../utils/editorialContent';
import { resolveReplicaH1 } from '../../utils/replicaProdCopy';

interface Props {
  pageData: any;
  featuredAntecedente?: any;
  filterChips: any[];
  sectorFilter?: string;
  searchQuery?: string;
  areaFilter?: string;
  unidadFilter?: string;
  pageSize: number;
}

const antecedentesPath = `${Astro.url.pathname}${Astro.url.search}`;
const antecedentesIndexH1 = resolveReplicaH1(antecedentesPath, 'Evidencia operativa real.');

const {
  pageData,
  featuredAntecedente = null,
  filterChips,
  sectorFilter = '',
  searchQuery = '',
  areaFilter = '',
  unidadFilter = '',
  pageSize
} = Astro.props;

const currentUrl = new URL(Astro.request.url);
const spotlight = pageData.spotlightAntecedentes || [];
const archive = pageData.antecedentes || [];
const totalItems = pageData.totalItems || 0;
const archiveTotalItems = pageData.archiveTotalItems ?? Math.max(0, totalItems - spotlight.length);
const institutionalProofTotal = Number(pageData.catalogTotalItems || totalItems || 0);
const institutionalProofShort = institutionalProofTotal >= 500
  ? `${Math.floor(institutionalProofTotal / 100) * 100}+`
  : String(institutionalProofTotal);
const totalPages = Math.max(1, pageData.totalPages || 1);
const currentPage = pageData.currentPage || 1;
const feature = featuredAntecedente || spotlight[0];
const secondary = spotlight.slice(1, 3);
const hasResults = totalItems > 0;
const showingStart = archiveTotalItems === 0 ? 0 : ((currentPage - 1) * pageSize) + 1;
const showingEnd = Math.min(currentPage * pageSize, archiveTotalItems);
const hasActiveFilters = Boolean(sectorFilter || searchQuery || areaFilter || unidadFilter);
const isLandingPage = Boolean(pageData.isLandingPage ?? (currentPage === 1 && !hasActiveFilters && spotlight.length > 0));
const activeFilterLabel = filterChips.find((chip: any) => chip.id === sectorFilter)?.name || 'Todos';
const preservedSearchParams = Array.from(currentUrl.searchParams.entries()).filter(
  ([key]) => !['q', 'page', 'reset'].includes(key)
);

const buildSectorUrl = (sector: string) => {
  const url = new URL(currentUrl);
  if (sector) url.searchParams.set('sector', sector);
  else url.searchParams.delete('sector');
  url.searchParams.delete('page');
  url.searchParams.delete('reset');
  return `${url.pathname}${url.search}`;
};

const buildPageUrl = (page: number) => {
  const url = new URL(currentUrl);
  url.searchParams.set('page', String(page));
  url.searchParams.delete('reset');
  return `${url.pathname}${url.search}`;
};

const buildClearUrl = () => {
  const url = new URL(currentUrl);
  ['sector', 'area', 'cliente', 'unidad_negocio', 'q', 'page', 'reset'].forEach((key) => url.searchParams.delete(key));
  return `${url.pathname}${url.search}`;
};

const computePaginationPages = () => {
  if (totalPages <= 5) return Array.from({ length: totalPages }, (_, index) => index + 1);
  if (currentPage <= 3) return [1, 2, 3, 4, 5];
  if (currentPage >= totalPages - 2) return [totalPages - 4, totalPages - 3, totalPages - 2, totalPages - 1, totalPages];
  return [currentPage - 2, currentPage - 1, currentPage, currentPage + 1, currentPage + 2];
};

const paginationPages = computePaginationPages();
const truncate = (value: unknown, length = 170) => truncateEditorialText(value, length);
const projectHref = (item: any) => `/antecedentes/${item.slug}`;
const projectTitle = (item: any) =>
  applyDisplayNameReplacements(item?.displayTitle || item?.Titulo || item?.Cliente || 'Antecedente UMSA', [item?.Cliente]);
const projectDescription = (item: any) =>
  applyDisplayNameReplacements(item?.displayDescription || item?.Descripcion || item?.Titulo || '', [item?.Cliente]);
const projectScope = (item: any) => item?.Area || item?.Unidad_de_negocio || 'Servicios IT';
const projectClient = (item: any) => formatDisplayName(item?.Cliente) || 'Proyecto UMSA';
const projectYear = (item: any) => {
  if (item?.displayYear && item.displayYear !== 'Invalid Date') return item.displayYear;
  const raw = item?.Fecha || item?.fecha || item?.anio || item?.year;
  if (!raw || /invalid date/i.test(String(raw))) return 'sin fecha';
  const date = new Date(raw);
  if (!Number.isNaN(date.getTime())) return String(date.getFullYear());
  const year = String(raw).match(/\b(19\d{2}|20\d{2})\b/)?.[1];
  return year || 'sin fecha';
};
const publicRecordLabel = (value: unknown) => {
  const label = String(value || '')
    .replace(/\bRegistro\s+[\p{L}]+\b/giu, 'Proyecto técnico')
    .replace(/\bRegistro\b/gi, 'Proyecto')
    .replace(/\bDoc[\p{L}]*\b/giu, 'Técnico')
    .trim();
  return label || 'Proyecto técnico';
};
const projectRecordLabel = (item: any) => publicRecordLabel(item?.curation?.recordLabel);
const heroImages = [feature, ...secondary, ...archive].filter((item: any) => item?.imageUrl).slice(0, 5);
const archiveTitle = isLandingPage
  ? 'Centro de evidencia operativa'
  : currentPage > 1
    ? `Proyectos tecnicos - pagina ${currentPage}`
    : 'Proyectos tecnicos filtrados';
const archiveText = isLandingPage
  ? 'Lectura ejecutiva por cliente, alcance, sector y ano para abrir cada dossier con contexto comercial claro.'
  : 'Proyectos reales de ULTIMA MILLA, ordenados por cliente, sector, ano e imagen asociada.';
---

<main class="um26-antecedentes">
  <section class="ante26-hero" aria-labelledby="ante26-title">
    {heroImages[0]?.imageUrl && <img src={heroImages[0].imageUrl} alt="" loading="eager" fetchpriority="high" decoding="async" />}
    <div class="ante26-hero__veil" aria-hidden="true"></div>
    <div class="ante26-shell ante26-hero__grid">
      <div class="ante26-hero__copy">
        <nav class="ante26-crumb" aria-label="Breadcrumb">
          <a href="/">Inicio</a>
          <span>/</span>
          <span>Antecedentes</span>
        </nav>
        <p class="ante26-kicker"><span></span>Archivo operativo / evidencia</p>
        <h1 id="ante26-title">{isLandingPage ? antecedentesIndexH1 : 'Antecedentes tecnicos.'}</h1>
        <p>Proyectos reales para evaluar alcance, continuidad, criticidad y experiencia en redes, seguridad electronica, telecomunicaciones, software, soporte y energia para IT.</p>
        <div class="ante26-actions">
          <a class="ante26-btn ante26-btn--red" href="#archivo-antecedentes">Ver proyectos</a>
          <a class="ante26-btn ante26-btn--ghost" href="/contacto">Solicitar relevamiento</a>
        </div>
      </div>

      <aside class="ante26-hero__panel" aria-label="Resumen de antecedentes">
        <dl>
          <div><dt>Proyectos</dt><dd>{institutionalProofShort}</dd></div>
          <div><dt>Trayectoria</dt><dd>22+ anos</dd></div>
          <div><dt>Sectores</dt><dd>{Math.max(filterChips.length - 1, 0)} mercados</dd></div>
          <div><dt>Soporte</dt><dd>24/7</dd></div>
        </dl>
        <p>El archivo cruza cliente, alcance, sector y continuidad para validar experiencia antes de definir el proximo paso.</p>
      </aside>
    </div>
  </section>

  <section class="ante26-rail" aria-label="Indice de antecedentes tecnicos">
    <div class="ante26-shell ante26-rail__grid">
      <div class="ante26-range">
        <strong>{showingStart}-{showingEnd}</strong>
        <span>{hasActiveFilters ? `de ${totalItems} coincidencias` : `de ${institutionalProofShort} proyectos`}</span>
      </div>

      <form method="get" action="/antecedentes" class="ante26-search">
        {preservedSearchParams.map(([key, value]) => <input type="hidden" name={key} value={value} />)}
        <label for="ante26-search">Afinar busqueda</label>
        <div>
          <input id="ante26-search" type="search" name="q" value={searchQuery} placeholder="Cliente o alcance" />
          <button type="submit">Buscar</button>
        </div>
      </form>
    </div>
    <nav class="ante26-shell ante26-filters" aria-label="Filtrar antecedentes por sector">
      {filterChips.map((chip: any) => (
        <a
          href={buildSectorUrl(chip.id)}
          class:list={['ante26-filter', { 'is-active': sectorFilter === chip.id || (chip.id === '' && !sectorFilter) }]}
          aria-current={sectorFilter === chip.id || (chip.id === '' && !sectorFilter) ? 'page' : undefined}
        >
          {chip.name}
        </a>
      ))}
      {hasActiveFilters && <a href={buildClearUrl()} class="ante26-filter ante26-filter--clear">Limpiar</a>}
    </nav>
  </section>

  {isLandingPage && (
    <section class="ante26-featured" aria-labelledby="ante26-featured-title">
      <div class="ante26-shell">
        <div class="ante26-section-head">
          <p class="ante26-kicker"><span></span>Evidencia destacada</p>
          <h2 id="ante26-featured-title">Casos con contexto, alcance y trazabilidad.</h2>
        </div>

        {!hasResults ? (
          <div class="ante26-empty">
            <h2>No se encontraron proyectos</h2>
            <p>Proba con otro sector o una busqueda mas amplia dentro del archivo.</p>
            <a href={buildClearUrl()}>Ver todos los proyectos</a>
          </div>
        ) : (
          <div class="ante26-feature-grid">
            {feature && (
              <a href={projectHref(feature)} class="ante26-feature-case">
                {feature.imageUrl && <img src={feature.imageUrl} alt={feature.Titulo || projectTitle(feature)} loading="eager" decoding="async" />}
                <div>
                  <span>{projectRecordLabel(feature)}</span>
                  <h3>{projectTitle(feature)}</h3>
                  <p>{truncate(projectDescription(feature), 210)}</p>
                  <dl>
                    <div><dt>Sector</dt><dd>{projectScope(feature)}</dd></div>
                    <div><dt>Cliente</dt><dd>{projectClient(feature)}</dd></div>
                    <div><dt>Ano</dt><dd>{projectYear(feature)}</dd></div>
                  </dl>
                  <strong>Ver proyecto</strong>
                </div>
              </a>
            )}

            <div class="ante26-secondary">
              {secondary.map((item: any, index: number) => (
                <a href={projectHref(item)} class="ante26-secondary-card">
                  {item.imageUrl && <img src={item.imageUrl} alt={item.Titulo || projectTitle(item)} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />}
                  <div>
                    <span>{projectRecordLabel(item)}</span>
                    <h3>{projectTitle(item)}</h3>
                    <p>{truncate(projectDescription(item), 132)}</p>
                    <em>{projectScope(item)} / {projectYear(item)}</em>
                  </div>
                </a>
              ))}
            </div>
          </div>
        )}
      </div>
    </section>
  )}

  {archive.length > 0 && (
    <section class="ante26-archive" id="archivo-antecedentes" aria-labelledby="archivo-antecedentes-title">
      <div class="ante26-shell">
        <div class="ante26-section-head ante26-section-head--split">
          <div>
            <p class="ante26-kicker"><span></span>{activeFilterLabel}</p>
            <h2 id="archivo-antecedentes-title">{archiveTitle}</h2>
          </div>
          <p>{archiveText}</p>
        </div>

        <div class="ante26-ledger">
          {archive.map((item: any, index: number) => (
            <a href={projectHref(item)} class="ante26-row">
              <span>{String(showingStart + index).padStart(2, '0')}</span>
              {item.imageUrl && <img src={item.imageUrl} alt={item.Titulo || projectTitle(item)} loading={index < 6 ? 'eager' : 'lazy'} decoding="async" />}
              <div class="ante26-row__copy">
                <p>{projectRecordLabel(item)}</p>
                <h3>{projectTitle(item)}</h3>
                <em>{truncate(projectDescription(item), 150)}</em>
              </div>
              <div class="ante26-row__meta">
                <small>Sector</small>
                <strong>{projectScope(item)}</strong>
                <small>Ano</small>
                <strong>{projectYear(item)}</strong>
              </div>
              <b>Detalle</b>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}

  {archive.length === 0 && !isLandingPage && (
    <section class="ante26-archive ante26-archive--empty" id="archivo-antecedentes" aria-labelledby="archivo-antecedentes-title">
      <div class="ante26-shell ante26-empty">
        <p class="ante26-kicker"><span></span>Archivo</p>
        <h2 id="archivo-antecedentes-title">Vista temporalmente sin proyectos visibles</h2>
        <p>El indice no pudo cargar antecedentes para esta vista. Podes volver al listado completo o pedir un relevamiento tecnico.</p>
        <a href="/antecedentes">Reintentar listado</a>
      </div>
    </section>
  )}

  {totalPages > 1 && (
    <nav class="ante26-shell ante26-pagination" aria-label="Paginacion de antecedentes">
      <span>Pagina {currentPage} de {totalPages}</span>
      <div>
        {currentPage > 1 && <a href={buildPageUrl(currentPage - 1)}>Anterior</a>}
        {paginationPages.map((pageNum) => (
          <a href={buildPageUrl(pageNum)} class={currentPage === pageNum ? 'is-active' : ''}>{pageNum}</a>
        ))}
        {currentPage < totalPages && <a href={buildPageUrl(currentPage + 1)}>Siguiente</a>}
      </div>
    </nav>
  )}

  <section class="ante26-closing">
    <div class="ante26-shell ante26-closing__panel">
      <div>
        <p class="ante26-kicker"><span></span>Para avanzar</p>
        <h2>Pasar de evidencia a alcance tecnico.</h2>
      </div>
      <div class="ante26-closing__links">
        <a href="/servicios"><span>Servicios</span><strong>Capacidades aplicadas</strong><em>Conectar casos reales con redes, seguridad, telecomunicaciones, software y soporte.</em></a>
        <a href="/sectores"><span>Sectores</span><strong>Mapa de verticales</strong><em>Comparar evidencia por mercado, criticidad y continuidad operativa.</em></a>
        <a href="/contacto"><span>Diagnostico</span><strong>Contacto tecnico</strong><em>Enviar contexto para definir el siguiente paso.</em></a>
      </div>
    </div>
  </section>
</main>

<style>
  :global(body[data-skin]) main {
    background: #0a0a0b;
  }

  .um26-antecedentes {
    background: #0a0a0b;
    color: #f7f7f7;
  }

  .ante26-shell {
    width: min(1336px, calc(100% - 126px));
    margin-inline: auto;
  }

  .ante26-hero {
    position: relative;
    min-height: 76vh;
    overflow: hidden;
    isolation: isolate;
    background: #0a0a0b;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .ante26-hero > img,
  .ante26-hero__veil {
    position: absolute;
    inset: 0;
  }

  .ante26-hero > img {
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.08) contrast(1.08) saturate(0.9);
  }

  .ante26-hero__veil {
    z-index: -2;
    background:
      linear-gradient(100deg, rgba(10,10,11,0.97), rgba(10,10,11,0.77) 48%, rgba(10,10,11,0.28)),
      linear-gradient(to top, #0a0a0b, rgba(10,10,11,0.42), transparent);
  }

  .ante26-hero__grid {
    position: relative;
    z-index: 1;
    min-height: 76vh;
    display: grid;
    grid-template-columns: minmax(0, 0.64fr) minmax(320px, 0.36fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: end;
    padding: clamp(70px, 8vw, 116px) 0 70px;
  }

  .ante26-crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: 28px;
    color: rgba(255,255,255,0.58);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .ante26-crumb a {
    color: inherit;
    text-decoration: none;
  }

  .ante26-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: rgba(255,255,255,0.66);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .ante26-kicker span {
    width: 34px;
    height: 2px;
    background: #DC2626;
  }

  .ante26-hero h1 {
    max-width: 900px;
    margin-top: 16px;
    color: #fff;
    font-size: clamp(3rem, 6vw, 6.2rem);
    line-height: 0.95;
    font-weight: 600;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .ante26-hero__copy > p:not(.ante26-kicker) {
    max-width: 760px;
    margin-top: 22px;
    color: rgba(255,255,255,0.72);
    font-size: clamp(1rem, 1.25vw, 1.18rem);
    line-height: 1.7;
  }

  .ante26-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }

  .ante26-btn {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    color: #fff;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
  }

  .ante26-btn--red {
    background: #DC2626;
  }

  .ante26-btn--ghost {
    background: rgba(255,255,255,0.08);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.18);
  }

  .ante26-hero__panel {
    align-self: center;
    padding: clamp(24px, 3vw, 34px);
    background: rgba(5,5,5,0.72);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.12);
    backdrop-filter: blur(6px);
  }

  .ante26-hero__panel dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 18px;
    margin: 0;
  }

  .ante26-hero__panel dl div {
    padding: 18px 0;
    border-top: 1px solid rgba(255,255,255,0.14);
  }

  .ante26-hero__panel dt,
  .ante26-row__meta small {
    color: rgba(255,255,255,0.58);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .ante26-hero__panel dd {
    margin: 7px 0 0;
    color: #fff;
    font-size: clamp(1.28rem, 2vw, 1.85rem);
    line-height: 1.05;
    font-weight: 600;
  }

  .ante26-hero__panel p {
    margin-top: 18px;
    color: rgba(255,255,255,0.68);
    font-size: 1rem;
    line-height: 1.58;
  }

  .ante26-rail,
  .ante26-featured,
  .ante26-archive,
  .ante26-closing {
    background: #0a0a0b;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .ante26-rail {
    position: sticky;
    top: var(--nav-offset, 0);
    z-index: 4;
    padding: 18px 0;
    background: rgba(10,10,11,0.94);
    backdrop-filter: blur(8px);
  }

  .ante26-rail__grid {
    display: grid;
    grid-template-columns: minmax(170px, 0.25fr) minmax(0, 0.75fr);
    gap: 24px;
    align-items: end;
  }

  .ante26-range strong,
  .ante26-range span {
    display: block;
  }

  .ante26-range strong {
    color: #fff;
    font-size: 1.05rem;
  }

  .ante26-range span,
  .ante26-search label {
    color: rgba(255,255,255,0.58);
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ante26-search label {
    display: block;
    margin-bottom: 8px;
  }

  .ante26-search div {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
  }

  .ante26-search input {
    min-height: 44px;
    min-width: 0;
    padding: 0 14px;
    color: #fff;
    font-size: 1rem;
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.14);
  }

  .ante26-search button {
    min-height: 44px;
    padding: 0 18px;
    color: #fff;
    font-size: 0.9rem;
    font-weight: 700;
    background: #DC2626;
    border: 0;
  }

  .ante26-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 14px;
  }

  .ante26-filter {
    min-height: 36px;
    display: inline-flex;
    align-items: center;
    padding: 0 13px;
    color: rgba(255,255,255,0.72);
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.12);
  }

  .ante26-filter:hover,
  .ante26-filter:focus-visible,
  .ante26-filter.is-active {
    color: #fff;
    background: #DC2626;
    border-color: #DC2626;
  }

  .ante26-filter--clear {
    margin-left: auto;
  }

  .ante26-featured,
  .ante26-archive,
  .ante26-closing {
    padding: clamp(60px, 8vw, 112px) 0;
  }

  .ante26-section-head {
    max-width: 880px;
    margin-bottom: clamp(30px, 4.6vw, 58px);
  }

  .ante26-section-head--split {
    max-width: none;
    display: grid;
    grid-template-columns: minmax(0, 0.48fr) minmax(0, 0.52fr);
    gap: clamp(24px, 4vw, 56px);
    align-items: end;
  }

  .ante26-section-head h2,
  .ante26-closing h2 {
    margin-top: 14px;
    color: #fff;
    font-size: clamp(2.35rem, 4.5vw, 4.9rem);
    line-height: 0.96;
    font-weight: 600;
    text-wrap: balance;
  }

  .ante26-section-head--split > p {
    color: rgba(255,255,255,0.62);
    font-size: clamp(1rem, 1.24vw, 1.16rem);
    line-height: 1.65;
  }

  .ante26-feature-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.58fr) minmax(330px, 0.42fr);
    gap: 18px;
  }

  .ante26-feature-case,
  .ante26-secondary-card {
    color: #fff;
    text-decoration: none;
    background: #101012;
    border: 1px solid rgba(255,255,255,0.12);
  }

  .ante26-feature-case {
    min-height: 560px;
    display: grid;
    grid-template-rows: minmax(260px, 0.58fr) auto;
  }

  .ante26-feature-case img,
  .ante26-secondary-card img,
  .ante26-row img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.06) saturate(0.9);
  }

  .ante26-feature-case > div {
    padding: clamp(24px, 3.6vw, 44px);
  }

  .ante26-feature-case span,
  .ante26-secondary-card span,
  .ante26-row > span,
  .ante26-row__copy p,
  .ante26-closing__links span {
    color: #DC2626;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ante26-feature-case h3 {
