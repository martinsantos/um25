---
import EvidenceItem from './EvidenceItem.astro';
import SectionHeader from '../um/SectionHeader.astro';
import MetricStrip from '../um/MetricStrip.astro';
import UMButton from '../um/UMButton.astro';
import { truncateEditorialText } from '../../utils/editorialContent';
import { resolveReplicaH1 } from '../../utils/replicaProdCopy';
import { getAntecedentesCountExactPhrase } from '../../utils/verifiedProof';

const antecedentesProofLabel = getAntecedentesCountExactPhrase();

interface Props {
  mode?: 'index' | 'detail';
  sectors?: any[];
  sector?: any;
  antecedentes?: any[];
  valueProps?: any[];
  serviciosRelacionados?: any[];
}

const {
  mode = 'index',
  sectors = [],
  sector = {},
  antecedentes = [],
  valueProps = [],
  serviciosRelacionados = []
} = Astro.props;

const featuredSectors = sectors.slice(0, 2);
const supportingSectors = sectors.slice(2);
const mainCase = antecedentes[0];
const secondaryCases = antecedentes.slice(1, 3);
const archiveCases = antecedentes.slice(3, 6);

const text = (value: unknown) => String(value || '').replace(/<[^>]*>/g, '').replace(/\s+/g, ' ').trim();
const truncate = (value: unknown, length = 150) => truncateEditorialText(value, length);
const sanitizeCopy = (value: unknown, length = 150) => truncateEditorialText(value, length);
const sectorSlug = sector.slug || '';
const sectorAntecedentesHref = sectorSlug
  ? `/antecedentes?sector=${encodeURIComponent(sectorSlug)}`
  : '/antecedentes';
const caseHref = (item: any) => `/antecedentes/${item.id}/${item.slug || ''}`;
const sectorTitleBase = sector.pageHeadline || sector.headline || sector.nombre || sector.label || 'Sector';
const sectorIndexH1 = resolveReplicaH1('/sectores', 'Infraestructura IT por sector, con evidencia operativa.');
const sectorTitle = sectorSlug
  ? resolveReplicaH1(`/${sectorSlug}`, sectorTitleBase)
  : sectorTitleBase;
const sectorSummary = sector.pageSummary || sector.summary || sector.descripcion || '';
const sectorName = sector.nombre || sector.label || sectorTitle;
const sectorImage = sector.heroImage || sector.image;
const sectorStats = Array.isArray(sector.stats) ? sector.stats : [];
const sectorMetrics = sectorStats.map((stat: any) => ({
  value: String(stat.value || ''),
  label: String(stat.label || ''),
}));
if (mode === 'detail' && antecedentes.length > 0) {
  sectorMetrics.push({ value: `${antecedentes.length}+`, label: 'Antecedentes' });
}
---

{mode === 'index' ? (
  <section class="sector-editorial sector-editorial--index">
    <div class="sector-editorial-index-hero">
    <div class="um-container">
      <div class="sector-editorial__head">
        <span class="sector-editorial__rule" aria-hidden="true"></span>
        <p class="sector-editorial__kicker">Sectores</p>
        <h1>{sectorIndexH1}</h1>
        <p class="sector-editorial__lead">
          Una lectura directa de riesgos, continuidad y evidencia para priorizar inversiones
          por criticidad operativa.
        </p>
        <dl class="sector-editorial__proofline" aria-label="Prueba institucional">
          <div>
            <dt>Mercados</dt>
            <dd>{sectors.length} verticales</dd>
          </div>
          <div>
            <dt>Archivo</dt>
            <dd>{antecedentesProofLabel}</dd>
          </div>
          <div>
            <dt>Operación</dt>
            <dd>22+ años / 24-7</dd>
          </div>
        </dl>
        <div class="sector-editorial__actions">
          <UMButton href="/contacto">Solicitar diagnóstico</UMButton>
          <UMButton href="/antecedentes" variant="secondary">Ver antecedentes</UMButton>
        </div>
      </div>
    </div>
    </div>

    <div class="um-container sector-editorial-index-body">
      <div class="sector-editorial__features">
        {featuredSectors.map((item, index) => (
          <a href={`/${item.slug}`} class="sector-editorial-feature">
            <img src={item.image} alt={item.imageAlt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
            <div>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h2>{item.label}</h2>
              <p>{item.summary}</p>
              <dl>
                <div><dt>Archivo</dt><dd>{item.cases}</dd></div>
                <div><dt>Necesidad</dt><dd>{item.operatingNeed}</dd></div>
              </dl>
            </div>
          </a>
        ))}
      </div>

      <div class="sector-editorial__support">
        {supportingSectors.map((item, index) => (
          <a href={`/${item.slug}`} class="sector-editorial-row">
            <span>{String(index + 3).padStart(2, '0')}</span>
            <strong>{item.label}</strong>
            <p>{item.operatingNeed}</p>
            <em>{item.cases}</em>
          </a>
        ))}
      </div>
    </div>
  </section>
) : (
  <section class="sector-editorial sector-editorial--detail">
    <div class="sector-editorial-detail-hero">
      {sectorImage && <img src={sectorImage} alt={sectorTitle} loading="eager" fetchpriority="high" decoding="async" width="1200" height="800" />}
      <div class="um-container">
        <nav class="sector-editorial__crumb" aria-label="Breadcrumb">
          <a href="/">Inicio</a>
          <span>/</span>
          <a href="/sectores?template=editorial">Sectores</a>
          <span>/</span>
          <span>{sectorName}</span>
        </nav>
        <div class="sector-editorial-detail-hero__copy">
          <span class="sector-editorial__rule" aria-hidden="true"></span>
          <p class="sector-editorial-detail-hero__kicker">Infraestructura crítica · {sectorName}</p>
          <h1>{sectorTitle}</h1>
          <p class="sector-editorial-detail-hero__lead">{sectorSummary}</p>
          <dl class="sector-editorial-detail-hero__proofline" aria-label="Prueba institucional">
            <div>
              <dt>Archivo</dt>
              <dd>{antecedentesProofLabel}</dd>
            </div>
            <div>
              <dt>Trayectoria</dt>
              <dd>22+ años</dd>
            </div>
            <div>
              <dt>Operación</dt>
              <dd>24/7</dd>
            </div>
          </dl>
          <div class="sector-editorial-detail-hero__actions">
            <UMButton href="/contacto">Solicitar diagnóstico</UMButton>
            <UMButton href={sectorAntecedentesHref} variant="secondary">Ver antecedentes del sector</UMButton>
          </div>
        </div>
      </div>
    </div>

    <div class="um-container sector-editorial-detail">
      <section class="sector-editorial-detail__risk">
        <div>
          <p>Riesgo operativo</p>
          <h2>{sector.operatingNeed || `Necesidades técnicas de ${sectorName}`}</h2>
        </div>
        <div>
          <p>{sector.proof || sectorSummary}</p>
          {sectorMetrics.length > 0 && (
            <MetricStrip metrics={sectorMetrics} class="sector-editorial-detail__metrics" />
          )}
        </div>
      </section>

      {mainCase && (
        <section class="sector-editorial-detail__evidence">
          <SectionHeader title={`Evidencia aplicada a ${sectorName}`} />
          <EvidenceItem
            variant="feature"
            href={caseHref(mainCase)}
            title={mainCase.Cliente || mainCase.Titulo || 'Proyecto destacado'}
            description={truncate(mainCase.Descripcion || mainCase.Titulo, 170)}
            image={mainCase.imageUrl}
            imageAlt={mainCase.Titulo || mainCase.Cliente || 'Antecedente'}
            eyebrow="Caso destacado"
            client={mainCase.Cliente}
            sector={mainCase.Area || mainCase.Unidad_de_negocio || sectorName}
            meta={[{ label: 'Alcance', value: 'Ejecución + soporte' }]}
          />
          <div class="sector-editorial-detail__secondary">
            {secondaryCases.map((item: any, index: number) => (
              <EvidenceItem
                variant="compact"
                href={caseHref(item)}
                title={item.Cliente || item.Titulo || 'Antecedente'}
                description={truncate(item.Descripcion || item.Titulo, 115)}
                image={item.imageUrl}
                imageAlt={item.Titulo || item.Cliente || 'Antecedente'}
                eyebrow="Archivo"
                index={index}
                sector={item.Area || item.Unidad_de_negocio || sectorName}
              />
            ))}
          </div>
        </section>
      )}

      <section class="sector-editorial-detail__services">
        <SectionHeader title="Servicios aplicados" />
        <div class="sector-editorial-service-list">
          {(serviciosRelacionados || []).map((item: any, index: number) => (
            <a href={`/servicios/${item.id}/${item.slug || ''}`}>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{item.nombre}</strong>
              <p>{sanitizeCopy(item.descripcion, 130)}</p>
            </a>
          ))}
          {(!serviciosRelacionados || serviciosRelacionados.length === 0) && (sector.services || []).map((item: string, index: number) => (
            <div>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{item}</strong>
              <p>Capacidad conectada al contexto operativo de {sectorName}.</p>
            </div>
          ))}
        </div>
      </section>

      {valueProps.length > 0 && (
        <section class="sector-editorial-detail__criteria">
          <SectionHeader title="Criterios técnicos" />
          <div class="sector-editorial-criteria-grid">
            {valueProps.map((item: any, index: number) => (
              <article>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h3>{item.titulo}</h3>
                <p>{sanitizeCopy(item.descripcion, 180)}</p>
              </article>
            ))}
          </div>
        </section>
      )}

      {archiveCases.length > 0 && (
        <section class="sector-editorial-detail__archive">
          {archiveCases.map((item: any, index: number) => (
            <EvidenceItem
              variant="row"
              href={caseHref(item)}
              title={item.Cliente || item.Titulo || 'Antecedente'}
              description={truncate(item.Descripcion || item.Titulo, 135)}
              image={item.imageUrl}
              imageAlt={item.Titulo || item.Cliente || 'Antecedente'}
              eyebrow="Dossier"
              index={index + 3}
              sector={item.Area || item.Unidad_de_negocio || sectorName}
            />
          ))}
        </section>
      )}
    </div>
  </section>
)}

<style>
  .sector-editorial {
    background: #fff;
    color: #111;
    padding: clamp(32px, 4.8vw, 60px) 0 clamp(44px, 6vw, 72px);
  }

  .sector-editorial--index {
    padding: 0 0 clamp(44px, 6vw, 72px);
  }

  .sector-editorial-index-hero {
    background: #050505;
    color: #fff;
    padding: clamp(28px, 4vw, 48px) 0 clamp(36px, 5vw, 56px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
  }

  .sector-editorial-index-hero .sector-editorial__head {
    margin-bottom: 0;
  }

  .sector-editorial-index-hero .sector-editorial__kicker,
  .sector-editorial-index-hero .sector-editorial__proofline dt {
    color: rgba(255, 255, 255, 0.62);
  }

  .sector-editorial-index-hero .sector-editorial__head h1,
  .sector-editorial-index-hero .sector-editorial__proofline dd {
    color: #fff;
  }

  .sector-editorial-index-hero .sector-editorial__lead {
    color: rgba(255, 255, 255, 0.78);
  }

  .sector-editorial-index-body {
    padding-top: clamp(28px, 4vw, 44px);
  }

  .sector-editorial__head {
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(280px, 0.28fr);
    gap: 16px clamp(24px, 5vw, 64px);
    align-items: end;
    margin-bottom: clamp(22px, 3.6vw, 42px);
  }

  .sector-editorial__rule {
    display: inline-block;
    grid-column: 1 / -1;
    width: 56px;
    height: 3px;
    background: var(--um-red);
  }

  .sector-editorial__kicker {
    grid-column: 1 / -1;
    color: var(--um-red);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1;
    text-transform: uppercase;
  }

  .sector-editorial__head h1 {
    max-width: 760px;
    color: var(--skin-text, #111111);
    font-size: clamp(2.5rem, 2.78vw, 2.95rem);
    line-height: 1.1;
    font-weight: var(--um-weight-title, 600);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .sector-editorial__lead {
    max-width: 360px;
    align-self: start;
    color: var(--um-gray-700);
    font-size: 1rem;
    line-height: 1.68;
  }

  .sector-editorial__proofline {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px clamp(16px, 3vw, 28px);
    margin: 4px 0 0;
    padding: 0;
    border: 0;
  }

  .sector-editorial__proofline div {
    display: grid;
    gap: 4px;
  }

  .sector-editorial__proofline dt {
    color: var(--um-gray-600);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .sector-editorial__proofline dd {
    margin: 0;
    color: #111;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .sector-editorial__actions,
  .sector-editorial-detail-hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    align-items: center;
  }

  .sector-editorial__actions {
    grid-column: 1 / -1;
  }

  .sector-editorial-detail-hero__actions {
    margin-top: 16px;
  }

  .sector-editorial__features {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .sector-editorial-feature {
    position: relative;
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 0;
    overflow: hidden;
    border: 1px solid var(--um-line);
    background: #fff;
    color: #111;
  }

  .sector-editorial-feature:nth-child(2) {
    margin-top: 0;
    min-height: 0;
  }

  .sector-editorial-feature img {
    position: static;
    width: 100%;
    height: clamp(168px, 14vw, 218px);
    object-fit: cover;
    color: transparent;
    filter: grayscale(0.04) contrast(1.04) saturate(0.92);
  }

  .sector-editorial-feature::after {
    display: none;
  }

  .sector-editorial-feature > div {
    position: relative;
    z-index: 0;
    align-self: start;
    padding: clamp(18px, 2.4vw, 28px);
  }

  .sector-editorial-feature span,
  .sector-editorial-row > span,
  .sector-editorial-service-list span,
  .sector-editorial-criteria-grid span {
    color: var(--um-red);
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.2;
  }

  .sector-editorial-feature h2 {
    margin-top: 10px;
    color: #000;
    font-size: clamp(1.42rem, 1.85vw, 2rem);
    line-height: 1.08;
    font-weight: 600;
  }

  .sector-editorial-feature p {
    max-width: 560px;
    margin-top: 10px;
    color: var(--um-gray-700);
    font-size: 1rem;
    line-height: 1.5;
  }

  .sector-editorial-feature dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1px;
    margin: 18px 0 0;
    border: 1px solid var(--um-line);
    background: var(--um-line);
  }

  .sector-editorial-feature dl div {
    padding: 12px;
    background: #f8f8f8;
  }

  .sector-editorial-feature dt {
    color: #777;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .sector-editorial-feature dd {
    margin: 6px 0 0;
    color: #111;
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .sector-editorial__support {
    display: grid;
    margin-top: clamp(30px, 5vw, 58px);
    border-top: 1px solid var(--um-line);
  }

  .sector-editorial-row {
    display: grid;
    grid-template-columns: 70px minmax(180px, 0.34fr) minmax(0, 1fr) minmax(110px, auto);
    gap: clamp(18px, 3vw, 34px);
    align-items: start;
    padding: 26px clamp(18px, 2vw, 26px);
    border-bottom: 1px solid var(--um-line);
    color: #111;
  }

  .sector-editorial-row strong {
    color: #000;
    font-size: clamp(1.25rem, 1.6vw, 1.62rem);
    line-height: 1.14;
    font-weight: 700;
  }

  .sector-editorial-row p,
  .sector-editorial-row em {
    color: var(--um-gray-700);
    font-size: 1rem;
    line-height: 1.52;
  }

  .sector-editorial-row em {
    font-style: normal;
    font-weight: 700;
    text-align: right;
  }

  .sector-editorial--detail {
    padding: 0 0 clamp(72px, 9vw, 120px);
  }

  .sector-editorial-detail-hero {
    position: relative;
    min-height: 0;
    overflow: hidden;
    background: #050505;
    color: #fff;
  }

  .sector-editorial-detail-hero > img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    color: transparent;
    filter: grayscale(0.1) contrast(1.08) saturate(0.86);
  }

  .sector-editorial-detail-hero::after {
    content: "";
    position: absolute;
    inset: 0;
    background:
      linear-gradient(90deg, rgba(0,0,0,0.95) 0%, rgba(0,0,0,0.82) 58%, rgba(0,0,0,0.55) 100%),
      linear-gradient(180deg, rgba(0,0,0,0.12), rgba(0,0,0,0.86));
  }

  .sector-editorial-detail-hero .um-container {
    position: relative;
    z-index: 1;
    display: grid;
    min-height: clamp(360px, 46vh, 480px);
    align-content: start;
    padding-top: clamp(56px, 7vw, 84px);
    padding-bottom: clamp(28px, 4vw, 44px);
  }

  .sector-editorial__crumb {
    position: absolute;
    top: clamp(26px, 4vw, 48px);
    left: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    color: rgba(255,255,255,0.62);
    font-size: 1rem;
    font-weight: 700;
  }

  .sector-editorial__crumb a:hover {
    color: #fff;
  }

  .sector-editorial-detail-hero__copy {
    max-width: 840px;
  }

  .sector-editorial-detail-hero__kicker {
    margin-top: 18px;
    color: rgba(255, 255, 255, 0.78);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .sector-editorial-detail-hero h1 {
    margin-top: 14px;
    color: #fff;
    font-size: clamp(2.05rem, 3.12vw, 3.25rem);
    line-height: 1.1;
    font-weight: 600;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .sector-editorial-detail-hero__proofline {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px clamp(16px, 3vw, 28px);
    max-width: 720px;
    margin: 18px 0 0;
    padding: 0;
    border: 0;
  }

  .sector-editorial-detail-hero__proofline div {
    display: grid;
    gap: 4px;
  }

  .sector-editorial-detail-hero__proofline dt {
    color: rgba(255, 255, 255, 0.74);
    font-size: 1rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .sector-editorial-detail-hero__proofline dd {
    margin: 0;
    color: #fff;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.35;
  }

  .sector-editorial-detail-hero__lead {
    max-width: 680px;
    margin-top: 18px;
    color: rgba(255,255,255,0.88);
    font-size: clamp(1.05rem, 1.25vw, 1.22rem);
    line-height: 1.62;
  }

  .sector-editorial-detail {
    display: grid;
    gap: clamp(64px, 8vw, 104px);
    padding-top: clamp(72px, 9vw, 116px);
  }

  .sector-editorial-detail__risk,
  .sector-editorial-detail__section-head {
    display: grid;
    grid-template-columns: minmax(280px, 0.42fr) minmax(0, 0.58fr);
    gap: clamp(34px, 7vw, 90px);
    align-items: start;
  }

  .sector-editorial-detail__risk > div:first-child p {
    color: var(--um-red);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .sector-editorial-detail__risk h2,
  .sector-editorial-detail__section-head h2 {
    margin-top: 16px;
    color: #000;
    font-size: clamp(1.75rem, 2.35vw, 2.45rem);
    line-height: 1.12;
    font-weight: 700;
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .sector-editorial-detail__risk > div:last-child > p {
    color: var(--um-gray-700);
    font-size: clamp(1.05rem, 1.2vw, 1.18rem);
    line-height: 1.7;
  }

  .sector-editorial-detail__risk dl {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    margin: 28px 0 0;
    border: 1px solid var(--um-line);
    background: var(--um-line);
  }

  .sector-editorial-detail__risk dl div {
    padding: 18px;
    background: #f8f8f8;
  }

  .sector-editorial-detail__risk dt {
    color: #777;
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .sector-editorial-detail__risk dd {
    margin: 8px 0 0;
    color: #111;
    font-size: clamp(1.35rem, 2vw, 2rem);
    font-weight: 700;
    line-height: 1.05;
  }

  .sector-editorial-detail__secondary {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
    margin-top: 18px;
  }

  .sector-editorial-detail__services,
  .sector-editorial-detail__criteria,
  .sector-editorial-detail__archive {
    display: grid;
    gap: 28px;
  }

  .sector-editorial-service-list,
  .sector-editorial-criteria-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    border: 1px solid var(--um-line);
    background: var(--um-line);
  }

  .sector-editorial-service-list a,
  .sector-editorial-service-list div,
  .sector-editorial-criteria-grid article {
    min-height: 230px;
    padding: clamp(22px, 3vw, 34px);
    background: #fff;
  }

  .sector-editorial-service-list strong,
  .sector-editorial-criteria-grid h3 {
    display: block;
    margin-top: 18px;
    color: #111;
    font-size: clamp(1.22rem, 1.5vw, 1.5rem);
    line-height: 1.16;
    font-weight: 700;
