---
import EvidenceItem from './EvidenceItem.astro';
import UMButton from '../um/UMButton.astro';
import IntentLinkGraph from '../um/IntentLinkGraph.astro';
import { truncateEditorialText } from '../../utils/editorialContent';
import { getAntecedentesCountExactPhrase, getAntecedentesCountShort } from '../../utils/verifiedProof';
import { buildSectorStrategicLinkGroups } from '../../data/strategicLinkGraph';

const antecedentesProofLabel = getAntecedentesCountExactPhrase();
const antecedentesProofShort = getAntecedentesCountShort();

interface Props {
  mode?: 'index' | 'detail';
  sectors?: any[];
  sector?: any;
  antecedentes?: any[];
  valueProps?: any[];
  serviciosRelacionados?: any[];
  sectorFilter?: string;
  sectorFilterOptions?: Array<{ id: string; label: string }>;
}

const {
  mode = 'index',
  sectors = [],
  sector = {},
  antecedentes = [],
  valueProps = [],
  serviciosRelacionados = [],
  sectorFilter = '',
  sectorFilterOptions = []
} = Astro.props;

const truncate = (value: unknown, length = 150) => truncateEditorialText(value, length);
const sanitizeCopy = (value: unknown, length = 150) => truncateEditorialText(value, length);
const sectorSlug = sector.slug || '';
const sectorAntecedentesHref = sectorSlug
  ? `/antecedentes?sector=${encodeURIComponent(sectorSlug)}`
  : '/antecedentes';
const caseHref = (item: any) => `/antecedentes/${item.id}/${item.slug || ''}`;
const sectorTitle = sector.pageHeadline || sector.headline || sector.nombre || sector.label || 'Sector';
const sectorSummary = sector.pageSummary || sector.summary || sector.descripcion || '';
const sectorName = sector.nombre || sector.label || sectorTitle;
const sectorImage = sector.heroImage || sector.image;
const sectorStats = Array.isArray(sector.stats) ? sector.stats : [];
const mainCases = antecedentes.slice(0, 6);
const heroSector = sectors[0] || {};
const methodSector = sectors.find((item, index) => index > 0 && item?.image && item.image !== heroSector?.image) || sectors[1] || heroSector;
const activeSector = sectors.find((item) => item.slug === sectorFilter);
const filteredSectors = activeSector ? sectors.filter((item) => item.slug === activeSector.slug) : sectors;
const sectorStrategicLinkGroups = buildSectorStrategicLinkGroups({
  currentPath: mode === 'detail' && sectorSlug ? `/${sectorSlug}` : '/sectores',
  sectorSlug,
  sectorName,
  title: mode === 'detail' ? sectorTitle : 'Mercados operativos, riesgo y evidencia.',
  summary: sectorSummary,
  text: [
    sector.operatingNeed,
    sector.proof,
    Array.isArray(sector.services) ? sector.services.join(' ') : '',
    sectors.map((item: any) => `${item.label || ''} ${item.summary || ''} ${(item.services || []).join(' ')}`).join(' '),
  ].filter(Boolean).join(' '),
  relatedServices: serviciosRelacionados || [],
  relatedCases: antecedentes.slice(0, 4),
});
const buildSectorFilterUrl = (nextSector: string) => {
  const url = new URL(Astro.request.url);
  if (nextSector) url.searchParams.set('sector', nextSector);
  else url.searchParams.delete('sector');
  return `${url.pathname}${url.search}`;
};
---

{mode === 'index' ? (
  <section class="sector-atlas sector-atlas--index">
    <div class="sector-atlas-index-hero">
    <div class="um-container">
      <header class="sector-atlas-exec-hero">
        <div class="sector-atlas-exec-hero__copy">
          <span class="sector-atlas__rule" aria-hidden="true"></span>
          <p>Mercados operativos UMSA</p>
          <h1>Mercados operativos, riesgo y evidencia.</h1>
          <p class="sector-atlas-exec-hero__lead">
            Un centro de lectura para entender dónde interviene UMSA, qué riesgos operativos
            resuelve y qué antecedentes sostienen cada conversación comercial.
          </p>
          <dl class="sector-atlas-exec-hero__proofline" aria-label="Prueba institucional">
            <div>
              <dt>Mercados</dt>
              <dd>{sectors.length} verticales</dd>
            </div>
            <div>
              <dt>Archivo</dt>
              <dd>{antecedentesProofLabel}</dd>
            </div>
            <div>
              <dt>Operación</dt>
              <dd>22+ años / 24-7</dd>
            </div>
          </dl>
          <div class="sector-atlas-exec-actions">
            <UMButton href="/contacto">Solicitar diagnóstico</UMButton>
            <UMButton href="/antecedentes" variant="secondary">Ver antecedentes</UMButton>
          </div>
        </div>

        <aside class="sector-atlas-exec-proof" aria-label="Prueba institucional por sector">
          <figure>
            <img src={heroSector?.image} alt={heroSector?.imageAlt || 'Infraestructura IT por sector'} loading="eager" decoding="async" />
          </figure>
          <div><span>{sectors.length}</span><strong>mercados priorizados</strong></div>
          <div><span>{antecedentesProofShort}</span><strong>antecedentes vinculables</strong></div>
          <div><span>24/7</span><strong>soporte operativo</strong></div>
        </aside>
      </header>
    </div>
    </div>

    <div class="um-container">
      <section class="sector-atlas-exec-feature" aria-label="Lectura ejecutiva por sector">
        <figure>
          <img src={methodSector?.image} alt={methodSector?.imageAlt || 'Infraestructura IT por sector'} loading="lazy" decoding="async" />
          <figcaption>
            <span>Caso de lectura</span>
            <strong>{methodSector?.label}</strong>
          </figcaption>
        </figure>
        <div>
          <h2>Primero el riesgo operativo. Después el sistema técnico.</h2>
          <p>
            Cada vertical combina condiciones de campo, continuidad, seguridad, documentación y soporte.
            El mapa permite comparar prioridades comerciales y decidir el alcance técnico correcto.
          </p>
        </div>
      </section>

      <section class="sector-atlas-exec-ledger" aria-label="Sectores y necesidades operativas">
        <div class="sector-atlas-exec-ledger__controls">
          <div class="sector-atlas-exec-ledger__filters" aria-label="Filtrar sectores">
            <nav class="sector-atlas-exec-ledger__filters-links">
              {sectorFilterOptions.map((item) => (
                <a
                  href={buildSectorFilterUrl(item.id)}
                  class={sectorFilter === item.id || (!sectorFilter && item.id === '') ? 'is-active' : ''}
                  aria-current={sectorFilter === item.id || (!sectorFilter && item.id === '') ? 'page' : undefined}
                >
                  <em>{item.label}</em>
                </a>
              ))}
              {sectorFilter && (
                <a href={buildSectorFilterUrl('')} class="sector-atlas-exec-ledger__clear">
                  Limpiar
                </a>
              )}
            </nav>
          </div>
        </div>
        {filteredSectors.map((item, index) => (
          <a href={`/${item.slug}`} class="um-click-surface sector-atlas-exec-row">
            <span class="sector-atlas-exec-row__num">{String(index + 1).padStart(2, '0')}</span>
            <div class="sector-atlas-exec-row__sector">
              <figure>
                <img src={item.image} alt={item.imageAlt || item.label} loading={index < 2 ? 'eager' : 'lazy'} decoding="async" />
              </figure>
              <div>
                <h2>{item.label}</h2>
                <p>{item.summary}</p>
              </div>
            </div>
            <p class="sector-atlas-exec-row__need">{item.operatingNeed}</p>
            <ul class="sector-atlas-exec-row__services">
              {item.services.slice(0, 3).map((service: string) => <li>{service}</li>)}
            </ul>
            <strong>{item.cases}</strong>
          </a>
        ))}
      </section>
    </div>

    <IntentLinkGraph
      kicker="Para avanzar"
      title="Entrar por sector"
      text="Entrá por vertical, servicio aplicado, evidencia o contacto técnico sin perder contexto."
      groups={sectorStrategicLinkGroups}
    />
  </section>
) : (
  <section class="sector-atlas sector-atlas--detail">
    <div class="sector-atlas-detail-hero">
      {sectorImage && <img src={sectorImage} alt={sectorTitle} loading="eager" decoding="async" />}
      <div class="um-container sector-atlas-detail-hero__grid">
        <div>
          <nav class="sector-atlas__crumb" aria-label="Breadcrumb">
            <a href="/">Inicio</a>
            <span>/</span>
            <a href="/sectores?template=atlas">Sectores</a>
            <span>/</span>
            <span>{sectorName}</span>
          </nav>
          <span class="sector-atlas__rule" aria-hidden="true"></span>
          <p class="sector-atlas-detail-hero__kicker">Infraestructura crítica · {sectorName}</p>
          <h1>{sectorTitle}</h1>
          <p class="sector-atlas-detail-hero__lead">{sectorSummary}</p>
          <dl class="sector-atlas-detail-hero__proofline" aria-label="Prueba institucional">
            <div>
              <dt>Archivo</dt>
              <dd>{antecedentesProofLabel}</dd>
            </div>
            <div>
              <dt>Trayectoria</dt>
              <dd>22+ años</dd>
            </div>
            <div>
              <dt>Operación</dt>
              <dd>24/7</dd>
            </div>
          </dl>
          <div class="sector-atlas-detail-hero__actions">
            <UMButton href="/contacto">Solicitar diagnóstico</UMButton>
            <UMButton href={sectorAntecedentesHref} variant="secondary">Ver antecedentes del sector</UMButton>
          </div>
        </div>
        <aside class="sector-atlas-detail-panel">
          <strong>Blueprint operativo</strong>
          <p>{sector.operatingNeed || `Riesgos, servicios y evidencia para ${sectorName}.`}</p>
          <dl>
            {sectorStats.map((stat: any) => (
              <div><dt>{stat.label}</dt><dd>{stat.value}</dd></div>
            ))}
            <div><dt>Antecedentes</dt><dd>{antecedentes.length}+</dd></div>
          </dl>
        </aside>
      </div>
    </div>

    <div class="um-container sector-atlas-detail">
      <section class="sector-atlas-blueprint">
        <div>
          <p>01 / Riesgo</p>
          <h2>{sector.operatingNeed || `Contexto operativo de ${sectorName}`}</h2>
        </div>
        <div>
          <p>{sector.proof || sectorSummary}</p>
        </div>
      </section>

      <section class="sector-atlas-service-map">
        <div class="sector-atlas-section-title">
          <p>02 / Servicios</p>
          <h2>Capacidades conectadas</h2>
        </div>
        <div class="sector-atlas-service-map__grid">
          {(serviciosRelacionados || []).map((item: any, index: number) => (
            <a href={`/servicios/${item.id}/${item.slug || ''}`} class="um-click-surface">
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{item.nombre}</strong>
              <p>{sanitizeCopy(item.descripcion, 130)}</p>
            </a>
          ))}
          {(!serviciosRelacionados || serviciosRelacionados.length === 0) && (sector.services || []).map((item: string, index: number) => (
            <div>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <strong>{item}</strong>
              <p>Servicio aplicado al mapa operativo de {sectorName}.</p>
            </div>
          ))}
        </div>
      </section>

      {valueProps.length > 0 && (
        <section class="sector-atlas-criteria">
          <div class="sector-atlas-section-title">
            <p>03 / Criterios</p>
            <h2>Condiciones de diseño</h2>
          </div>
          <div class="sector-atlas-criteria__grid">
            {valueProps.map((item: any, index: number) => (
              <article>
                <span>{String(index + 1).padStart(2, '0')}</span>
                <h3>{item.titulo}</h3>
                <p>{sanitizeCopy(item.descripcion, 180)}</p>
              </article>
            ))}
          </div>
        </section>
      )}

      {mainCases.length > 0 && (
        <section class="sector-atlas-evidence">
          <div class="sector-atlas-section-title">
            <p>04 / Evidencia</p>
            <h2>Archivo vinculado</h2>
          </div>
          <div class="sector-atlas-evidence__list">
            {mainCases.map((item: any, index: number) => (
              <EvidenceItem
                variant="row"
                href={caseHref(item)}
                title={item.Cliente || item.Titulo || 'Antecedente'}
                description={truncate(item.Descripcion || item.Titulo, 135)}
                image={item.imageUrl}
                imageAlt={item.Titulo || item.Cliente || 'Antecedente'}
                eyebrow="Caso"
                index={index}
                sector={item.Area || item.Unidad_de_negocio || sectorName}
              />
            ))}
          </div>
        </section>
      )}
    </div>

    <IntentLinkGraph
      kicker="Para avanzar"
      title="Ver también"
      text="Servicios aplicados, evidencia del vertical y contacto para un relevamiento técnico."
      groups={sectorStrategicLinkGroups}
    />
  </section>
)}

<style>
  .sector-atlas {
    background: var(--skin-section, #fff);
    color: var(--skin-text, #111);
    padding: clamp(58px, 7vw, 96px) 0;
  }

  .sector-atlas--index {
    background: var(--skin-page, #fff);
    color: var(--skin-text, #111);
    padding: 0 0 clamp(58px, 7vw, 96px);
  }

  .sector-atlas-index-hero {
    background: #050505;
    color: #fff;
    padding: clamp(28px, 4vw, 48px) 0 clamp(32px, 4.5vw, 52px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
    margin-bottom: clamp(28px, 4vw, 44px);
  }

  .sector-atlas-index-hero .sector-atlas-exec-hero {
    padding-bottom: 0;
  }

  .sector-atlas-index-hero .sector-atlas-exec-hero p:not(.sector-atlas-exec-hero__lead) {
    color: rgba(255, 255, 255, 0.62);
  }

  .sector-atlas-index-hero .sector-atlas-exec-hero h1,
  .sector-atlas-index-hero .sector-atlas-exec-proof strong {
    color: #fff;
  }

  .sector-atlas-index-hero .sector-atlas-exec-hero__lead {
    color: rgba(255, 255, 255, 0.76);
  }

  .sector-atlas--detail {
    background: var(--skin-page, #fff);
    color: var(--skin-text, #111);
    padding: 0 0 clamp(72px, 9vw, 120px);
  }

  .sector-atlas-exec-hero {
    display: grid;
    grid-template-columns: minmax(0, 0.58fr) minmax(340px, 0.42fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
    padding-bottom: clamp(34px, 5vw, 58px);
    border-bottom: 0;
  }

  .sector-atlas-exec-hero__copy {
    max-width: 760px;
  }

  .sector-atlas-exec-hero p:not(.sector-atlas-exec-hero__lead),
  .sector-atlas-exec-feature > div > p:first-child {
    margin-top: 16px;
    color: var(--um-red);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.25;
  }

  .sector-atlas-exec-hero h1 {
    max-width: 720px;
    margin-top: 14px;
    color: var(--skin-text, #111);
    font-size: clamp(2.5rem, 3.65vw, 3.7rem);
    line-height: 1.08;
    font-weight: 600;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .sector-atlas-exec-hero__lead {
    max-width: 690px;
    margin-top: 22px;
    color: var(--skin-muted, #555d66);
    font-size: clamp(1.05rem, 1.18vw, 1.18rem);
    line-height: 1.72;
  }

  .sector-atlas-exec-hero__proofline {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px clamp(16px, 3vw, 28px);
    margin: 20px 0 0;
    padding: 0;
    border: 0;
  }

  .sector-atlas-exec-hero__proofline div {
    display: grid;
    gap: 4px;
  }

  .sector-atlas-exec-hero__proofline dt {
    color: var(--skin-muted, #6b7280);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .sector-atlas-exec-hero__proofline dd {
    margin: 0;
    color: var(--skin-text, #111);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }

  .sector-atlas-index-hero .sector-atlas-exec-hero__proofline dt {
    color: rgba(255, 255, 255, 0.62);
  }

  .sector-atlas-index-hero .sector-atlas-exec-hero__proofline dd {
    color: #fff;
  }

  .sector-atlas-exec-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 26px;
  }

  .sector-atlas-exec-actions a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 48px;
    padding: 0 22px;
    border: 0;
    background: rgba(17,17,17,0.05);
    color: var(--skin-text, #111);
    font-size: 1rem;
    font-weight: 600;
  }

  .sector-atlas-exec-actions a:first-child {
    background: var(--um-red);
    background-clip: border-box;
    box-shadow: none;
    color: #fff;
  }

  .sector-atlas-exec-proof {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0;
    background: transparent;
  }

  .sector-atlas-exec-proof figure {
    position: relative;
    grid-column: 1 / -1;
    min-height: clamp(160px, 15vw, 220px);
    margin: 0;
    overflow: hidden;
    background: #111;
  }

  .sector-atlas-exec-proof figure::after {
    content: "";
    position: absolute;
    inset: 42% 0 0;
    background: linear-gradient(180deg, transparent, rgba(0,0,0,0.78));
  }

  .sector-atlas-exec-proof img {
    display: block;
    width: 100%;
    height: 100%;
    min-height: inherit;
    object-fit: cover;
    filter: grayscale(0.08) contrast(1.05) saturate(0.9);
  }

  .sector-atlas-exec-proof div {
    min-height: 116px;
    padding: 20px;
    background: #fff;
  }

  .sector-atlas-exec-proof span {
    display: block;
    color: var(--skin-text, #111);
    font-family: var(--um-font-display);
    font-size: clamp(1.8rem, 2.6vw, 2.55rem);
    font-weight: 600;
    line-height: 1;
  }

  .sector-atlas-exec-proof strong {
    display: block;
    margin-top: 10px;
    color: var(--skin-muted, #555d66);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.44;
    overflow-wrap: anywhere;
  }

  .sector-atlas-exec-feature {
    display: grid;
    grid-template-columns: minmax(320px, 0.42fr) minmax(0, 0.58fr);
    gap: clamp(34px, 5.4vw, 78px);
    align-items: end;
    padding: clamp(34px, 5vw, 58px) 0;
    border-bottom: 0;
  }

  .sector-atlas-exec-feature figure {
    position: relative;
    overflow: hidden;
    aspect-ratio: 16 / 10;
    margin: 0;
    background: #111;
  }

  .sector-atlas-exec-feature img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.9) contrast(1.04);
  }

  .sector-atlas-exec-feature figure::after {
    content: "";
    position: absolute;
    inset: 50% 0 0;
    background: linear-gradient(180deg, transparent, rgba(0,0,0,0.74));
  }

  .sector-atlas-exec-feature figcaption {
    position: absolute;
    z-index: 1;
    left: 22px;
    right: 22px;
    bottom: 20px;
    display: grid;
    gap: 6px;
  }

  .sector-atlas-exec-feature figcaption span {
    color: rgba(255,255,255,0.68);
    font-size: 1rem;
  }

  .sector-atlas-exec-feature figcaption strong {
    color: #fff;
    font-size: clamp(1.24rem, 1.6vw, 1.5rem);
    line-height: 1.12;
  }

  .sector-atlas-exec-feature h2 {
    max-width: 680px;
    margin-top: 14px;
    color: var(--skin-text, #111);
    font-size: clamp(1.74rem, 2.35vw, 2.56rem);
    line-height: 1.14;
    font-weight: 600;
    text-wrap: balance;
  }

  .sector-atlas-exec-feature > div > p:last-child {
    max-width: 760px;
    margin-top: 18px;
    color: var(--skin-muted, #555d66);
    font-size: 1.05rem;
    line-height: 1.72;
  }

  .sector-atlas-exec-ledger {
    display: grid;
    min-width: 0;
    max-width: 100%;
    padding-top: clamp(30px, 4.8vw, 54px);
  }

  .sector-atlas-exec-ledger__controls {
    position: sticky;
    top: 80px;
    z-index: 9;
    min-width: 0;
    max-width: 100%;
    overflow: hidden;
    background: var(--skin-page, #fff);
    padding: 0 0 10px;
    border-bottom: 0;
    box-shadow: 0 -12px 0 var(--skin-page, #fff);
  }

  .sector-atlas-exec-ledger__filters {
    display: block;
    padding: 0;
    margin-bottom: 0;
    background: #fff;
    border-top: 0;
    border-bottom: 0;
  }

  .sector-atlas-exec-ledger__filters-links {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    gap: clamp(12px, 1.4vw, 20px);
    min-width: 0;
    max-width: 100%;
    overflow-x: auto;
    overflow-y: hidden;
    overscroll-behavior-inline: contain;
    scrollbar-width: none;
    -webkit-overflow-scrolling: touch;
  }

  .sector-atlas-exec-ledger__filters-links::-webkit-scrollbar {
    display: none;
  }

  .sector-atlas-exec-ledger__filters-links a {
    display: inline-flex;
    gap: 0;
    align-items: center;
    flex: 0 0 auto;
    min-height: 48px;
    padding: 0;
    color: var(--skin-text, #111);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.2;
    white-space: nowrap;
    position: relative;
    text-decoration: none;
    transition: color 180ms ease;
  }

  .sector-atlas-exec-ledger__filters-links a em {
    color: currentColor;
    font-style: normal;
    font-weight: 600;
  }

  .sector-atlas-exec-ledger__filters-links a.is-active {
    color: var(--um-red);
  }

  .sector-atlas-exec-ledger__filters-links a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: currentColor;
    opacity: 0;
    transition: opacity 180ms ease;
  }

  .sector-atlas-exec-ledger__filters-links a:hover,
  .sector-atlas-exec-ledger__filters-links a:focus-visible {
    color: var(--um-red);
  }

  .sector-atlas-exec-ledger__filters-links a.is-active::after {
    opacity: 1;
  }

  .sector-atlas-exec-ledger__clear {
    color: var(--skin-muted, #555d66) !important;
  }

  .sector-atlas-exec-ledger__clear:hover,
  .sector-atlas-exec-ledger__clear:focus-visible {
    color: var(--um-red) !important;
  }

  .sector-atlas-exec-row {
    display: grid;
    grid-template-columns: 44px minmax(420px, 0.46fr) minmax(230px, 0.22fr) minmax(280px, 0.24fr) 108px;
    gap: clamp(18px, 2.3vw, 26px);
    align-items: start;
  }

