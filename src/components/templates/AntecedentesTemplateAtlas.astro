---
import EvidenceItem from './EvidenceItem.astro';
import { truncateEditorialText } from '../../utils/editorialContent';

interface Props {
  pageData: any;
  filterChips: any[];
  sectorFilter?: string;
  searchQuery?: string;
  areaFilter?: string;
  unidadFilter?: string;
  pageSize: number;
}

const {
  pageData,
  filterChips,
  sectorFilter = '',
  searchQuery = '',
  areaFilter = '',
  unidadFilter = '',
  pageSize
} = Astro.props;

const currentUrl = new URL(Astro.request.url);
const buildSectorUrl = (sector: string) => {
  const url = new URL(currentUrl);
  if (sector) url.searchParams.set('sector', sector);
  else url.searchParams.delete('sector');
  url.searchParams.set('page', '1');
  return `${url.pathname}${url.search}`;
};
const buildPageUrl = (page: number) => {
  const url = new URL(currentUrl);
  url.searchParams.set('page', String(page));
  return `${url.pathname}${url.search}`;
};
const computePaginationPages = () => {
  const total = pageData.totalPages;
  const current = pageData.currentPage;
  if (total <= 5) return Array.from({ length: total }, (_, index) => index + 1);
  if (current <= 3) return [1, 2, 3, 4, 5];
  if (current >= total - 2) return [total - 4, total - 3, total - 2, total - 1, total];
  return [current - 2, current - 1, current, current + 1, current + 2];
};
const paginationPages = computePaginationPages();
const projects = pageData.antecedentes || [];
const rowItems = projects.slice(0, 7);
const ledgerItems = projects.slice(7);
const institutionalProofTotal = 469;
const showingStart = pageData.totalItems === 0 ? 0 : ((pageData.currentPage - 1) * pageSize) + 1;
const showingEnd = Math.min(pageData.currentPage * pageSize, pageData.totalItems);
const activeFilterName = filterChips.find((chip) => chip.id === sectorFilter)?.name || 'Todos los sectores';
const truncate = (value: unknown, length = 150) => truncateEditorialText(value, length);
const projectHref = (item: any) => `/antecedentes/${item.slug}`;
---

<section class="ante-atlas">
  <div class="um-container ante-atlas__hero">
    <div>
      <span class="ante-atlas__rule" aria-hidden="true"></span>
      <p>Atlas documental</p>
      <h1>Antecedentes como archivo navegable, no como catálogo de cards.</h1>
    </div>
    <aside>
      <strong>{institutionalProofTotal}+</strong>
      <span>antecedentes institucionales</span>
      <p>{activeFilterName} / página {pageData.currentPage}</p>
    </aside>
  </div>

  <div class="um-container ante-atlas__grid">
    <aside class="ante-atlas__filters">
      <form method="get" action="/antecedentes">
        <input type="hidden" name="template" value="atlas" />
        {sectorFilter && <input type="hidden" name="sector" value={sectorFilter} />}
        <label for="ante-atlas-search">Buscar</label>
        <input id="ante-atlas-search" type="text" name="q" value={searchQuery} placeholder="Cliente, alcance, sector" />
      </form>

      <nav aria-label="Filtrar antecedentes por sector">
        {filterChips.map((chip) => (
          <a
            href={buildSectorUrl(chip.id)}
            class={sectorFilter === chip.id || (chip.id === '' && !sectorFilter) ? 'is-active' : ''}
          >
            <span>{chip.name}</span>
          </a>
        ))}
      </nav>

      {(sectorFilter || searchQuery || areaFilter || unidadFilter) && <a class="ante-atlas__clear" href="/antecedentes?template=atlas">Limpiar filtros</a>}
    </aside>

    <main class="ante-atlas__archive">
      <div class="ante-atlas__archive-head">
        <p>Mostrando {showingStart}-{showingEnd} de {pageData.totalItems}</p>
        <span>{activeFilterName}</span>
      </div>

      {projects.length === 0 ? (
        <div class="ante-atlas__empty">
          <h2>No se encontraron proyectos</h2>
          <p>Probá con otro sector o una búsqueda más amplia.</p>
          <a href="/antecedentes?template=atlas">Ver todos los proyectos</a>
        </div>
      ) : (
        <>
          <div class="ante-atlas__rows">
            {rowItems.map((item: any, index: number) => (
              <EvidenceItem
                variant="row"
                href={projectHref(item)}
                title={item.Cliente || item.Titulo || 'Antecedente'}
                description={truncate(item.Descripcion || item.Titulo, 130)}
                image={item.imageUrl}
                imageAlt={item.Titulo || item.Cliente || 'Antecedente'}
                eyebrow="Registro"
                index={index}
                sector={item.Area || item.Unidad_de_negocio || 'Servicios IT'}
              />
            ))}
          </div>
          {ledgerItems.length > 0 && (
            <div class="ante-atlas__ledger">
              {ledgerItems.map((item: any, index: number) => (
                <EvidenceItem
                  variant="ledger"
                  href={projectHref(item)}
                  title={item.Cliente || item.Titulo || 'Antecedente'}
                  description={truncate(item.Descripcion || item.Titulo, 120)}
                  eyebrow="Registro"
                  index={index + rowItems.length}
                  sector={item.Area || item.Unidad_de_negocio || 'Servicios IT'}
                />
              ))}
            </div>
          )}
        </>
      )}

      {pageData.totalPages > 1 && (
        <nav class="ante-atlas__pagination" aria-label="Paginación de antecedentes">
          <span>Página {pageData.currentPage} de {pageData.totalPages}</span>
          <div>
            {pageData.currentPage > 1 && <a href={buildPageUrl(pageData.currentPage - 1)}>Anterior</a>}
            {paginationPages.map((pageNum) => (
              <a href={buildPageUrl(pageNum)} class={pageData.currentPage === pageNum ? 'is-active' : ''}>{pageNum}</a>
            ))}
            {pageData.currentPage < pageData.totalPages && <a href={buildPageUrl(pageData.currentPage + 1)}>Siguiente</a>}
          </div>
        </nav>
      )}
    </main>
  </div>
</section>

<style>
  .ante-atlas {
    background: var(--skin-section, #fff);
    color: var(--skin-text, #111);
    padding: clamp(58px, 7vw, 96px) 0;
  }

  .ante-atlas__rule {
    display: inline-block;
    width: 56px;
    height: 3px;
    background: var(--um-red);
  }

  .ante-atlas__hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, 360px);
    gap: clamp(34px, 7vw, 90px);
    align-items: end;
    margin-bottom: clamp(36px, 6vw, 68px);
  }

  .ante-atlas__hero p:first-of-type {
    margin-top: 22px;
    color: var(--um-red);
    font-size: 1rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .ante-atlas__hero h1 {
    max-width: 920px;
    margin-top: 18px;
    color: var(--skin-hero-text, #fff);
    font-size: clamp(2.5rem, 3.12vw, 3.25rem);
    line-height: 1.1;
    font-weight: var(--um-weight-title, 600);
    overflow-wrap: anywhere;
    text-wrap: balance;
  }

  .ante-atlas__hero aside {
    border: 1px solid var(--skin-hero-line, rgba(255,255,255,0.18));
    padding: clamp(24px, 4vw, 38px);
    background: var(--skin-hero-panel-solid, rgba(8,8,8,0.68));
  }

  .ante-atlas__hero strong {
    display: block;
    color: var(--skin-hero-text, #fff);
    font-family: var(--um-font-display);
    font-size: clamp(2.5rem, 4vw, 4rem);
    line-height: 1;
    font-weight: 700;
  }

  .ante-atlas__hero span,
  .ante-atlas__hero aside p {
    display: block;
    margin-top: 12px;
    color: var(--skin-hero-muted, rgba(255,255,255,0.68));
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .ante-atlas__grid {
    display: grid;
    grid-template-columns: minmax(260px, 310px) minmax(0, 1fr);
    gap: clamp(34px, 6vw, 76px);
    align-items: start;
  }

  .ante-atlas__filters {
    position: sticky;
    top: 104px;
    border: 1px solid var(--skin-line, #ddd);
    background: var(--skin-panel, #fff);
  }

  .ante-atlas__filters form {
    padding: 20px;
    border-bottom: 1px solid var(--skin-line, #ddd);
  }

  .ante-atlas__filters label {
    display: block;
    margin-bottom: 8px;
    color: var(--skin-muted, #5f6368);
    font-size: 1rem;
    font-weight: 700;
  }

  .ante-atlas__filters input {
    width: 100%;
    min-height: 48px;
    border: 1px solid var(--skin-line, #ddd);
    border-radius: 0;
    background: var(--skin-panel, #fff);
    padding: 0 12px;
    color: var(--skin-text, #111);
    font-size: 1rem;
  }

  .ante-atlas__filters nav {
    display: grid;
  }

  .ante-atlas__filters nav a,
  .ante-atlas__clear {
    display: flex;
    align-items: center;
    min-height: 52px;
    border-bottom: 1px solid var(--skin-line, #ddd);
    padding: 0 20px;
    color: var(--skin-text, #111);
    font-size: 1rem;
    font-weight: 700;
  }

  .ante-atlas__filters nav a.is-active {
    color: var(--skin-text, #111);
    background: #ffffff;
    box-shadow: inset 2px 0 0 var(--um-red);
  }

  .ante-atlas__clear {
    color: var(--um-red);
  }

  .ante-atlas__archive {
    min-width: 0;
  }

  .ante-atlas__archive-head {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 18px;
    align-items: end;
    margin-bottom: 20px;
    color: var(--skin-muted, #5f6368);
  }

  .ante-atlas__archive-head p,
  .ante-atlas__archive-head span {
    font-size: 1rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .ante-atlas__archive-head span {
    color: var(--um-red);
  }

  .ante-atlas__rows {
    display: grid;
    gap: 14px;
  }

  .ante-atlas__ledger {
    display: grid;
    margin-top: 18px;
    border-top: 1px solid var(--skin-line, #ddd);
  }

  .ante-atlas__rows :global(.evidence-item),
  .ante-atlas__ledger :global(.evidence-item) {
    border-color: var(--skin-line, #ddd);
    background: var(--skin-panel, #fff);
    color: var(--skin-text, #111);
  }

  .ante-atlas__rows :global(.evidence-item p),
  .ante-atlas__ledger :global(.evidence-item p),
  .ante-atlas__rows :global(.evidence-item__meta dd),
  .ante-atlas__ledger :global(.evidence-item__meta dd) {
    color: var(--skin-muted, #5f6368);
  }

  .ante-atlas__rows :global(.evidence-item__meta),
  .ante-atlas__ledger :global(.evidence-item__meta) {
    border-color: var(--skin-line, #ddd);
    background: #ffffff;
  }

  .ante-atlas__rows :global(.evidence-item__meta div),
  .ante-atlas__ledger :global(.evidence-item__meta div) {
    background: var(--skin-panel, #fff);
  }

  .ante-atlas__rows :global(.evidence-item__meta dt),
  .ante-atlas__ledger :global(.evidence-item__meta dt) {
    color: var(--skin-muted, #5f6368);
  }

  .ante-atlas__rows :global(.evidence-item__cta),
  .ante-atlas__ledger :global(.evidence-item__cta),
  .ante-atlas__rows :global(.evidence-item h3),
  .ante-atlas__ledger :global(.evidence-item h3) {
    color: var(--skin-text, #111);
  }

  .ante-atlas__pagination {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 18px;
    align-items: center;
    margin-top: 28px;
    border-top: 1px solid var(--skin-line, #ddd);
    padding-top: 24px;
  }

  .ante-atlas__pagination span,
  .ante-atlas__pagination a {
    color: var(--skin-text, #111);
    font-size: 1rem;
    font-weight: 700;
  }

  .ante-atlas__pagination div {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .ante-atlas__pagination a {
    display: grid;
    min-width: 44px;
    min-height: 44px;
    place-items: center;
    border: 0;
    padding: 0 12px;
  }

  .ante-atlas__pagination a.is-active {
    border-color: var(--um-red);
    color: var(--um-red);
  }

  .ante-atlas__empty {
    border: 1px solid var(--skin-line, #ddd);
    padding: clamp(28px, 5vw, 56px);
    background: #ffffff;
  }

  .ante-atlas__empty h2 {
    color: var(--skin-text, #111);
    font-size: clamp(1.6rem, 2.5vw, 2.4rem);
    line-height: 1.1;
  }

  .ante-atlas__empty p,
  .ante-atlas__empty a {
    margin-top: 12px;
    color: var(--skin-muted, #5f6368);
    font-size: 1rem;
    line-height: 1.5;
  }

  .ante-atlas__empty a {
    display: inline-flex;
    color: var(--um-red);
    font-weight: 700;
  }

  @media (max-width: 980px) {
    .ante-atlas__hero,
    .ante-atlas__grid {
      grid-template-columns: 1fr;
    }

    .ante-atlas__filters {
      position: static;
    }
  }

  @media (max-width: 640px) {
    .ante-atlas__hero h1 {
      max-width: 18ch;
      font-size: clamp(2rem, 8.4vw, 2.55rem);
      line-height: 1.1;
      text-wrap: normal;
    }
  }
</style>
