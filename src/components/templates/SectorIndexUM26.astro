---
interface SectorIndexItem {
  slug: string;
  label: string;
  headline: string;
  summary: string;
  proof: string;
  cases: string;
  image: string;
  imageAlt: string;
  services: string[];
  operatingNeed: string;
}

interface FilterOption {
  id: string;
  label: string;
}

interface Props {
  sectors?: SectorIndexItem[];
  sectorFilter?: string;
  sectorFilterOptions?: FilterOption[];
}

const {
  sectors = [],
  sectorFilter = '',
  sectorFilterOptions = [],
} = Astro.props;

const activeSectors = sectorFilter
  ? sectors.filter((sector) => sector.slug === sectorFilter)
  : sectors;
const allSectors = activeSectors.length ? activeSectors : sectors;
const feature = allSectors[0];
const rest = allSectors.slice(1);
const leadImage = feature?.image || sectors[0]?.image || '/img/sectores/aeropuertos.webp';
const countLabel = (sector: SectorIndexItem) => {
  const match = String(sector.cases || '').match(/\d+/);
  return match?.[0] || '0';
};
const visibleFilterOptions = sectorFilterOptions.filter((option) => option.id || !sectorFilter);
---

<div class="sectors-demo" aria-labelledby="sectors-demo-title">
  <section class="sectors-demo-hero">
    <img src={leadImage} alt="" loading="eager" fetchpriority="high" decoding="async" />
    <div class="sectors-demo-hero__shade" aria-hidden="true"></div>
    <div class="sectors-demo-shell sectors-demo-hero__content">
      <p class="sectors-demo-kicker"><span></span>02 / Sectores</p>
      <h1 id="sectors-demo-title">Infraestructura por sector.</h1>
      <p>Cada sector tiene exigencias distintas. Entra por el suyo.</p>
    </div>
  </section>

  <section class="sectors-demo-shell sectors-demo-stats" aria-label="Resumen de sectores">
    <div>
      <strong>{sectors.length}</strong>
      <span>sectores</span>
    </div>
    <div>
      <strong>518</strong>
      <span>antecedentes en archivo</span>
    </div>
  </section>

  {visibleFilterOptions.length > 1 && (
    <nav class="sectors-demo-filters" aria-label="Sectores disponibles">
      <div class="sectors-demo-shell">
        {visibleFilterOptions.map((option) => (
          <a
            href={option.id ? `/sectores?sector=${option.id}` : '/sectores'}
            class:list={['sectors-demo-filter', { 'is-active': option.id === sectorFilter }]}
            aria-current={option.id === sectorFilter ? 'page' : undefined}
          >
            {option.label}
          </a>
        ))}
      </div>
    </nav>
  )}

  {feature && (
    <section class="sectors-demo-shell">
      <a href={`/${feature.slug}`} class="sectors-demo-feature">
        <img src={feature.image} alt={feature.imageAlt} loading="eager" decoding="async" />
        <div class="sectors-demo-feature__shade" aria-hidden="true"></div>
        <div class="sectors-demo-feature__body">
          <p>Sector 01 - {feature.label}</p>
          <h2>{feature.label}</h2>
          <span>{feature.operatingNeed}</span>
        </div>
        <div class="sectors-demo-feature__count">
          <span>Antecedentes</span>
          <strong>{countLabel(feature)}</strong>
        </div>
        <i aria-hidden="true"></i>
      </a>
    </section>
  )}

  <section class="sectors-demo-shell sectors-demo-grid" aria-label="Mapa de sectores">
    {rest.map((sector, index) => (
      <a
        href={`/${sector.slug}`}
        class:list={['sectors-demo-card', { 'sectors-demo-card--wide': index === 0 || index === 4 }]}
      >
        <img src={sector.image} alt={sector.imageAlt} loading="lazy" decoding="async" />
        <div class="sectors-demo-card__shade" aria-hidden="true"></div>
        <div class="sectors-demo-card__count">
          <span>Casos</span>
          <strong>{countLabel(sector)}</strong>
        </div>
        <div class="sectors-demo-card__body">
          <p>Sector - {sector.label}</p>
          <h2>{sector.label}</h2>
          <span>{sector.operatingNeed || sector.summary}</span>
        </div>
        <i aria-hidden="true"></i>
      </a>
    ))}
  </section>

  <section class="sectors-demo-shell sectors-demo-closing">
    <div>
      <p class="sectors-demo-kicker"><span></span>Sector no listado?</p>
      <h2>Trabajamos operaciones criticas en industrias diversas.</h2>
    </div>
    <div>
      <a href="/antecedentes">Explorar antecedentes</a>
      <a href="/servicios">Ver servicios</a>
    </div>
  </section>
</div>

<style>
  .sectors-demo {
    min-height: 100vh;
    background: #0a0a0b;
    color: #fff;
  }

  .sectors-demo-shell {
    width: min(100% - 64px, 1302px);
    margin-inline: auto;
  }

  .sectors-demo-hero {
    position: relative;
    min-height: 322px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    isolation: isolate;
    border-bottom: 1px solid rgba(255,255,255,0.08);
    background: #0a0a0b;
  }

  .sectors-demo-hero > img {
    position: absolute;
    inset: 0;
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.08) saturate(0.9) brightness(0.68);
  }

  .sectors-demo-hero__shade {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(90deg, rgba(10,10,11,0.98), rgba(10,10,11,0.68) 42%, rgba(10,10,11,0.34)),
      linear-gradient(to top, #0a0a0b, rgba(10,10,11,0.26));
  }

  .sectors-demo-hero__content {
    padding: 86px 0 56px;
  }

  .sectors-demo-kicker {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    margin: 0 0 18px;
    color: #dc2626;
    font-family: var(--um-font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .sectors-demo-kicker span {
    width: 36px;
    height: 2px;
    background: #dc2626;
  }

  .sectors-demo-hero h1 {
    max-width: 900px;
    margin: 0;
    color: #fff;
    font-family: var(--um-font-display);
    font-size: clamp(3rem, 6vw, 5.2rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 0.98;
    text-wrap: balance;
  }

  .sectors-demo-hero p:not(.sectors-demo-kicker) {
    max-width: 560px;
    margin: 20px 0 0;
    color: rgba(255,255,255,0.76);
    font-size: 1.02rem;
    line-height: 1.6;
  }

  .sectors-demo-stats {
    display: flex;
    flex-wrap: wrap;
    gap: 1px;
    margin-top: 56px;
    margin-bottom: 28px;
    border: 1px solid rgba(255,255,255,0.08);
    background: rgba(255,255,255,0.08);
  }

  .sectors-demo-filters,
  .sectors-demo-grid,
  .sectors-demo-closing {
    background: #0a0a0b;
  }

  .sectors-demo-stats div {
    min-width: 190px;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 15px 22px;
    background: #0f0f11;
  }

  .sectors-demo-stats strong {
    color: #fff;
    font-family: var(--um-font-display);
    font-size: 1.6rem;
    line-height: 1;
  }

  .sectors-demo-stats div:nth-child(2) strong {
    color: #dc2626;
  }

  .sectors-demo-stats span {
    color: #71717a;
    font-family: var(--um-font-mono);
    font-size: 0.64rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .sectors-demo-filters {
    margin-bottom: 28px;
  }

  .sectors-demo-filters > div {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .sectors-demo-filter {
    display: inline-flex;
    min-height: 36px;
    align-items: center;
    padding: 0 14px;
    border: 1px solid rgba(255,255,255,0.12);
    color: #a1a1aa;
    font-size: 0.82rem;
    font-weight: 700;
    text-decoration: none;
    background: #101012;
  }

  .sectors-demo-filter.is-active,
  .sectors-demo-filter:hover {
    color: #fff;
    border-color: #dc2626;
  }

  .sectors-demo-feature,
  .sectors-demo-card {
    position: relative;
    display: block;
    overflow: hidden;
    isolation: isolate;
    color: #fff;
    text-decoration: none;
    background: #0f0f11;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .sectors-demo-feature {
    min-height: 452px;
    aspect-ratio: 21 / 9;
    border-top: 3px solid #dc2626;
  }

  .sectors-demo-feature > img,
  .sectors-demo-card > img {
    position: absolute;
    inset: 0;
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.08) saturate(0.9) brightness(0.82);
    transform: scale(1.01);
    transition: transform 0.25s ease, filter 0.25s ease;
  }

  .sectors-demo-feature:hover > img,
  .sectors-demo-card:hover > img {
    transform: scale(1.04);
    filter: contrast(1.1) saturate(1) brightness(0.9);
  }

  .sectors-demo-feature__shade,
  .sectors-demo-card__shade {
    position: absolute;
    inset: 0;
    z-index: -2;
    background:
      linear-gradient(to top, rgba(10,10,11,0.97), rgba(10,10,11,0.36) 58%, rgba(10,10,11,0.08)),
      linear-gradient(105deg, rgba(10,10,11,0.72), transparent 64%);
  }

  .sectors-demo-feature__body {
    position: absolute;
    left: 48px;
    right: 48px;
    bottom: 42px;
  }

  .sectors-demo-feature__body p,
  .sectors-demo-card__body p {
    margin: 0 0 14px;
    color: #dc2626;
    font-family: var(--um-font-mono);
    font-size: 0.74rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }

  .sectors-demo-feature__body h2,
  .sectors-demo-card__body h2 {
    margin: 0;
    color: #fff;
    font-family: var(--um-font-display);
    font-size: clamp(2.45rem, 5vw, 4.25rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 1;
    text-wrap: balance;
  }

  .sectors-demo-feature__body span,
  .sectors-demo-card__body span {
    display: block;
    max-width: 620px;
    margin-top: 16px;
    color: rgba(255,255,255,0.72);
    font-size: 1rem;
    line-height: 1.55;
  }

  .sectors-demo-feature__count,
  .sectors-demo-card__count {
    position: absolute;
    z-index: 2;
    top: 30px;
    right: 32px;
    text-align: right;
  }

  .sectors-demo-feature__count span,
  .sectors-demo-card__count span {
    display: block;
    margin-bottom: 4px;
    color: rgba(255,255,255,0.66);
    font-family: var(--um-font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .sectors-demo-feature__count strong {
    color: #fff;
    font-family: var(--um-font-display);
    font-size: 4rem;
    line-height: 1;
  }

  .sectors-demo-grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 12px;
    margin-top: 28px;
  }

  .sectors-demo-card {
    grid-column: span 4;
    min-height: 380px;
    aspect-ratio: 4 / 5;
  }

  .sectors-demo-card--wide {
    grid-column: span 8;
    aspect-ratio: 16 / 10;
  }

  .sectors-demo-card__body {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 24px;
  }

  .sectors-demo-card__body h2 {
    font-size: clamp(1.9rem, 3.6vw, 3rem);
  }

  .sectors-demo-card__body span {
    font-size: 0.96rem;
  }

  .sectors-demo-card__count {
    top: 18px;
    right: 20px;
  }

  .sectors-demo-card__count strong {
    color: #fff;
    font-family: var(--um-font-display);
    font-size: 2.35rem;
    line-height: 1;
  }

  .sectors-demo-feature > i,
  .sectors-demo-card > i {
    position: absolute;
    left: 0;
    bottom: 0;
    width: 0;
    height: 3px;
    background: #dc2626;
    transition: width 0.24s ease;
  }

  .sectors-demo-feature:hover > i,
  .sectors-demo-card:hover > i,
  .sectors-demo-feature:focus-visible > i,
  .sectors-demo-card:focus-visible > i {
    width: 100%;
  }

  .sectors-demo-closing {
    position: relative;
    display: flex;
    justify-content: space-between;
    gap: 24px;
    margin-top: 52px;
    margin-bottom: 72px;
    padding: 32px 40px;
    overflow: hidden;
    border: 1px solid rgba(255,255,255,0.1);
    background: #0f0f11;
  }

  .sectors-demo-closing h2 {
    max-width: 650px;
    margin: 0;
    color: #fff;
    font-family: var(--um-font-display);
    font-size: clamp(1.55rem, 3vw, 2.1rem);
    line-height: 1.08;
  }

  .sectors-demo-closing > div:last-child {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }

  .sectors-demo-closing a {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 22px;
    background: #dc2626;
    color: #fff;
    font-size: 0.92rem;
    font-weight: 700;
    text-decoration: none;
  }

  .sectors-demo-closing a + a {
    background: transparent;
    border: 1px solid rgba(255,255,255,0.2);
  }

  @media (max-width: 980px) {
    .sectors-demo-shell {
      width: min(100% - 28px, 1302px);
    }

    .sectors-demo-hero {
      min-height: 330px;
    }

    .sectors-demo-hero__content {
      padding: 72px 0 42px;
    }

    .sectors-demo-hero h1 {
      font-size: clamp(2.55rem, 12vw, 4.4rem);
    }

    .sectors-demo-feature,
    .sectors-demo-card,
    .sectors-demo-card--wide {
      grid-column: span 12;
      min-height: 360px;
      aspect-ratio: 4 / 4.2;
    }

    .sectors-demo-feature__body,
    .sectors-demo-card__body {
      left: 20px;
      right: 20px;
      bottom: 20px;
    }

    .sectors-demo-feature__body h2,
    .sectors-demo-card__body h2 {
      font-size: clamp(2.1rem, 11vw, 3rem);
    }

    .sectors-demo-feature__count {
      top: 18px;
      right: 20px;
    }

    .sectors-demo-feature__count strong {
      font-size: 3rem;
    }

    .sectors-demo-closing {
      display: grid;
      padding: 24px;
    }
  }

  @media (max-width: 620px) {
    .sectors-demo-stats {
      margin-top: 34px;
    }

    .sectors-demo-stats div {
      width: 100%;
    }

    .sectors-demo-feature,
    .sectors-demo-card,
    .sectors-demo-card--wide {
      min-height: 330px;
    }

    .sectors-demo-feature__body span,
    .sectors-demo-card__body span {
      display: none;
    }
  }
</style>
