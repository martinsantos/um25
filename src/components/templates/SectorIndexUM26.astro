---
interface SectorIndexItem {
  slug: string;
  label: string;
  headline: string;
  summary: string;
  proof: string;
  cases: string;
  image: string;
  imageAlt: string;
  services: string[];
  operatingNeed: string;
}

interface FilterOption {
  id: string;
  label: string;
}

interface Props {
  sectors?: SectorIndexItem[];
  sectorFilter?: string;
  sectorFilterOptions?: FilterOption[];
}

const {
  sectors = [],
  sectorFilter = '',
  sectorFilterOptions = [],
} = Astro.props;

const activeSectors = sectorFilter
  ? sectors.filter((sector) => sector.slug === sectorFilter)
  : sectors;
const featuredSectors = activeSectors.slice(0, 2);
const ledgerSectors = activeSectors.slice(2);
const leadImage = featuredSectors[0]?.image || sectors[0]?.image;
const activeFilterLabel = sectorFilterOptions.find((option) => option.id === sectorFilter)?.label || 'Todos';
---

<main class="um26-sectors">
  <section class="sectors26-hero" aria-labelledby="sectors26-title">
    {leadImage && <img src={leadImage} alt="" loading="eager" fetchpriority="high" decoding="async" />}
    <div class="sectors26-hero__veil" aria-hidden="true"></div>
    <div class="sectors26-shell sectors26-hero__grid">
      <div class="sectors26-hero__copy">
        <nav class="sectors26-crumb" aria-label="Breadcrumb">
          <a href="/">Inicio</a>
          <span>/</span>
          <span>Sectores</span>
        </nav>
        <p class="sectors26-kicker"><span></span>Mercados / evidencia operativa</p>
        <h1 id="sectors26-title">Infraestructura IT por sector.</h1>
        <p>Soluciones conectadas por industria para continuidad, seguridad, comunicaciones, software y soporte tecnico con antecedentes verificables.</p>
        <div class="sectors26-actions">
          <a class="sectors26-btn sectors26-btn--red" href="/contacto">Solicitar diagnostico</a>
          <a class="sectors26-btn sectors26-btn--ghost" href="/antecedentes">Ver antecedentes</a>
        </div>
      </div>

      <aside class="sectors26-hero__panel" aria-label="Resumen de mercados">
        <dl>
          <div><dt>Mercados</dt><dd>9 verticales</dd></div>
          <div><dt>Archivo</dt><dd>500+</dd></div>
          <div><dt>Operacion</dt><dd>22+ anos / 24/7</dd></div>
        </dl>
        <p>Cada vertical cruza riesgo operativo, servicios aplicados y evidencia de antecedentes para llegar rapido al alcance correcto.</p>
      </aside>
    </div>
  </section>

  <section class="sectors26-rail" aria-label="Filtro de sectores">
    <div class="sectors26-shell">
      <p class="sectors26-rail__label">Vista activa: <strong>{activeFilterLabel}</strong></p>
      <nav class="sectors26-filters" aria-label="Sectores disponibles">
        {sectorFilterOptions.map((option) => (
          <a
            href={option.id ? `/sectores?sector=${option.id}` : '/sectores'}
            class:list={['sectors26-filter', { 'is-active': option.id === sectorFilter }]}
            aria-current={option.id === sectorFilter ? 'page' : undefined}
          >
            {option.label}
          </a>
        ))}
      </nav>
    </div>
  </section>

  <section class="sectors26-featured" aria-label="Sectores destacados">
    <div class="sectors26-shell sectors26-featured__grid">
      {featuredSectors.map((sector, index) => (
        <a href={`/${sector.slug}`} class="sectors26-feature-card">
          <img src={sector.image} alt={sector.imageAlt} loading={index === 0 ? 'eager' : 'lazy'} decoding="async" />
          <div>
            <span>{String(index + 1).padStart(2, '0')}</span>
            <h2>{sector.label}</h2>
            <p>{sector.summary}</p>
            <dl>
              <div><dt>Necesidad</dt><dd>{sector.operatingNeed}</dd></div>
              <div><dt>Archivo</dt><dd>{sector.cases}</dd></div>
            </dl>
            <strong>Ver vertical</strong>
          </div>
        </a>
      ))}
    </div>
  </section>

  <section class="sectors26-ledger" aria-label="Mapa de verticales">
    <div class="sectors26-shell">
      <div class="sectors26-section-head">
        <p class="sectors26-kicker"><span></span>Verticales conectados</p>
        <h2>Del contexto al alcance tecnico.</h2>
      </div>

      <div class="sectors26-ledger__grid">
        {ledgerSectors.map((sector, index) => (
          <a href={`/${sector.slug}`} class="sectors26-ledger-card">
            <div class="sectors26-ledger-card__media">
              <img src={sector.image} alt={sector.imageAlt} loading="lazy" decoding="async" />
            </div>
            <div class="sectors26-ledger-card__body">
              <span>{String(index + 3).padStart(2, '0')}</span>
              <h3>{sector.label}</h3>
              <p>{sector.summary}</p>
              <ul>
                {sector.services.slice(0, 3).map((service) => <li>{service}</li>)}
              </ul>
              <em>{sector.cases}</em>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sectors26-closing">
    <div class="sectors26-shell sectors26-closing__panel">
      <div>
        <p class="sectors26-kicker"><span></span>Para avanzar</p>
        <h2>Definir alcance desde evidencia, no desde rubros aislados.</h2>
      </div>
      <div class="sectors26-closing__links">
        <a href="/servicios"><span>Capacidades</span><strong>Servicios integrados</strong><em>Redes, seguridad, telecomunicaciones, software y soporte.</em></a>
        <a href="/antecedentes"><span>Archivo</span><strong>Antecedentes verificables</strong><em>Casos por industria para contrastar alcance y continuidad.</em></a>
        <a href="/contacto"><span>Diagnostico</span><strong>Contacto tecnico</strong><em>Enviar contexto operativo y recibir el proximo paso.</em></a>
      </div>
    </div>
  </section>
</main>

<style>
  :global(body[data-skin]) main {
    background: #0a0a0b;
  }

  .um26-sectors {
    background: #0a0a0b;
    color: #f7f7f7;
  }

  .sectors26-shell {
    width: min(1336px, calc(100% - 126px));
    margin-inline: auto;
  }

  .sectors26-hero {
    position: relative;
    min-height: 74vh;
    overflow: hidden;
    isolation: isolate;
    background: #0a0a0b;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .sectors26-hero > img,
  .sectors26-hero__veil {
    position: absolute;
    inset: 0;
  }

  .sectors26-hero > img {
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.08) contrast(1.08) saturate(0.9);
  }

  .sectors26-hero__veil {
    z-index: -2;
    background:
      linear-gradient(100deg, rgba(10,10,11,0.97), rgba(10,10,11,0.76) 48%, rgba(10,10,11,0.28)),
      linear-gradient(to top, #0a0a0b, rgba(10,10,11,0.42), transparent);
  }

  .sectors26-hero__grid {
    position: relative;
    z-index: 1;
    min-height: 74vh;
    display: grid;
    grid-template-columns: minmax(0, 0.64fr) minmax(320px, 0.36fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: end;
    padding: clamp(70px, 8vw, 116px) 0 70px;
  }

  .sectors26-crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: 28px;
    color: rgba(255,255,255,0.58);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .sectors26-crumb a {
    color: inherit;
    text-decoration: none;
  }

  .sectors26-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: rgba(255,255,255,0.66);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .sectors26-kicker span {
    width: 34px;
    height: 2px;
    background: #DC2626;
  }

  .sectors26-hero h1 {
    max-width: 870px;
    margin-top: 16px;
    color: #fff;
    font-size: clamp(3.25rem, 6.8vw, 6.95rem);
    line-height: 0.94;
    font-weight: 600;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .sectors26-hero__copy > p:not(.sectors26-kicker) {
    max-width: 760px;
    margin-top: 22px;
    color: rgba(255,255,255,0.72);
    font-size: clamp(1rem, 1.25vw, 1.18rem);
    line-height: 1.7;
  }

  .sectors26-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }

  .sectors26-btn {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    color: #fff;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
  }

  .sectors26-btn--red {
    background: #DC2626;
  }

  .sectors26-btn--ghost {
    background: rgba(255,255,255,0.08);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.18);
  }

  .sectors26-hero__panel {
    align-self: center;
    padding: clamp(24px, 3vw, 34px);
    background: rgba(5,5,5,0.72);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.12);
    backdrop-filter: blur(6px);
  }

  .sectors26-hero__panel dl {
    display: grid;
    gap: 0;
    margin: 0;
  }

  .sectors26-hero__panel dl div {
    padding: 18px 0;
    border-top: 1px solid rgba(255,255,255,0.14);
  }

  .sectors26-hero__panel dl div:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .sectors26-hero__panel dt {
    color: rgba(255,255,255,0.58);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .sectors26-hero__panel dd {
    margin: 7px 0 0;
    color: #fff;
    font-size: clamp(1.35rem, 2.4vw, 2.1rem);
    line-height: 1.02;
    font-weight: 600;
  }

  .sectors26-hero__panel p {
    margin-top: 18px;
    color: rgba(255,255,255,0.68);
    font-size: 1rem;
    line-height: 1.58;
  }

  .sectors26-rail,
  .sectors26-featured,
  .sectors26-ledger,
  .sectors26-closing {
    background: #0a0a0b;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .sectors26-rail {
    position: sticky;
    top: var(--nav-offset, 0);
    z-index: 4;
    padding: 18px 0;
    background: rgba(10,10,11,0.94);
    backdrop-filter: blur(8px);
  }

  .sectors26-rail__label {
    margin: 0 0 12px;
    color: rgba(255,255,255,0.55);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sectors26-rail__label strong {
    color: #fff;
    font-weight: 700;
  }

  .sectors26-filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .sectors26-filter {
    min-height: 38px;
    display: inline-flex;
    align-items: center;
    padding: 0 14px;
    color: rgba(255,255,255,0.7);
    font-size: 0.9rem;
    font-weight: 700;
    text-decoration: none;
    background: rgba(255,255,255,0.07);
    border: 1px solid rgba(255,255,255,0.12);
  }

  .sectors26-filter:hover,
  .sectors26-filter:focus-visible,
  .sectors26-filter.is-active {
    color: #fff;
    background: #DC2626;
    border-color: #DC2626;
  }

  .sectors26-featured,
  .sectors26-ledger,
  .sectors26-closing {
    padding: clamp(60px, 8vw, 112px) 0;
  }

  .sectors26-featured__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 18px;
  }

  .sectors26-feature-card {
    position: relative;
    min-height: 560px;
    display: grid;
    align-items: end;
    overflow: hidden;
    color: #fff;
    text-decoration: none;
    background: #111;
    border: 1px solid rgba(255,255,255,0.12);
  }

  .sectors26-feature-card img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.08) saturate(0.9);
  }

  .sectors26-feature-card::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(0,0,0,0.9), rgba(0,0,0,0.46), rgba(0,0,0,0.1));
  }

  .sectors26-feature-card > div {
    position: relative;
    z-index: 1;
    padding: clamp(26px, 4vw, 48px);
  }

  .sectors26-feature-card span,
  .sectors26-ledger-card__body span,
  .sectors26-closing__links span {
    color: #DC2626;
    font-size: 0.82rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .sectors26-feature-card h2 {
    margin-top: 12px;
    color: #fff;
    font-size: clamp(2.2rem, 4vw, 4.2rem);
    line-height: 0.96;
    font-weight: 600;
    text-wrap: balance;
  }

  .sectors26-feature-card p {
    max-width: 620px;
    margin-top: 14px;
    color: rgba(255,255,255,0.72);
    font-size: 1rem;
    line-height: 1.62;
  }

  .sectors26-feature-card dl {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    margin-top: 22px;
  }

  .sectors26-feature-card dl div {
    padding: 13px;
    background: rgba(255,255,255,0.08);
  }

  .sectors26-feature-card dt {
    color: rgba(255,255,255,0.58);
    font-size: 0.74rem;
    font-weight: 700;
    text-transform: uppercase;
  }

  .sectors26-feature-card dd {
    margin: 5px 0 0;
    color: #fff;
    font-size: 0.88rem;
    font-weight: 700;
    line-height: 1.35;
  }

  .sectors26-feature-card strong {
    display: inline-flex;
    margin-top: 20px;
    color: #fff;
    font-size: 0.9rem;
  }

  .sectors26-feature-card strong::after,
  .sectors26-ledger-card em::after {
    content: " ->";
    color: #DC2626;
    margin-left: 6px;
  }

  .sectors26-section-head {
    max-width: 860px;
    margin-bottom: clamp(30px, 4.6vw, 58px);
  }

  .sectors26-section-head h2,
  .sectors26-closing h2 {
    margin-top: 14px;
    color: #fff;
    font-size: clamp(2.35rem, 4.5vw, 4.9rem);
    line-height: 0.96;
    font-weight: 600;
    text-wrap: balance;
  }

  .sectors26-ledger__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid rgba(255,255,255,0.12);
  }

  .sectors26-ledger-card {
    display: grid;
    grid-template-rows: 230px minmax(320px, auto);
    min-width: 0;
    color: #fff;
    text-decoration: none;
    background: #101012;
    border-right: 1px solid rgba(255,255,255,0.1);
    border-bottom: 1px solid rgba(255,255,255,0.1);
  }

  .sectors26-ledger-card__media {
    overflow: hidden;
    background: #151515;
  }

  .sectors26-ledger-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.06) saturate(0.9);
  }

  .sectors26-ledger-card__body {
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding: clamp(22px, 3vw, 34px);
  }

  .sectors26-ledger-card h3 {
    margin-top: 18px;
    color: #fff;
    font-size: clamp(1.5rem, 2.1vw, 2.15rem);
    line-height: 1.02;
    font-weight: 600;
    text-wrap: balance;
  }

  .sectors26-ledger-card p {
    margin-top: 14px;
    color: rgba(255,255,255,0.64);
    font-size: 0.98rem;
    line-height: 1.56;
  }

  .sectors26-ledger-card ul {
    display: flex;
    flex-wrap: wrap;
    gap: 7px;
    margin: 18px 0 0;
    padding: 0;
    list-style: none;
  }

  .sectors26-ledger-card li {
    padding: 7px 9px;
    color: rgba(255,255,255,0.82);
    font-size: 0.78rem;
    font-weight: 700;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.1);
  }

  .sectors26-ledger-card em {
    display: inline-flex;
    margin-top: auto;
    padding-top: 22px;
    color: #fff;
    font-style: normal;
    font-size: 0.9rem;
    font-weight: 700;
  }

  .sectors26-closing__panel {
    display: grid;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 0.58fr);
    gap: clamp(28px, 5vw, 70px);
    padding: clamp(30px, 4vw, 54px);
    background:
      linear-gradient(105deg, rgba(220,38,38,0.14), transparent 52%),
      #111113;
    border: 1px solid rgba(255,255,255,0.1);
  }

  .sectors26-closing__links {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
  }

  .sectors26-closing__links a {
    min-height: 180px;
    padding: 20px;
    color: #fff;
    text-decoration: none;
    background: #0a0a0b;
    border: 1px solid rgba(255,255,255,0.12);
  }

  .sectors26-closing__links strong {
    display: block;
    margin-top: 10px;
    color: #fff;
    font-size: 1rem;
  }

  .sectors26-closing__links em {
    display: block;
    margin-top: 8px;
    color: rgba(255,255,255,0.58);
    font-style: normal;
    line-height: 1.45;
  }

  @media (max-width: 1040px) {
    .sectors26-ledger__grid,
    .sectors26-closing__links {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 900px) {
    .sectors26-shell {
      width: min(100% - 32px, 720px);
    }

    .sectors26-hero__grid,
    .sectors26-featured__grid,
    .sectors26-closing__panel {
      grid-template-columns: 1fr;
    }

    .sectors26-hero h1 {
      font-size: clamp(2.25rem, 10.6vw, 3.35rem);
      line-height: 0.98;
    }

    .sectors26-hero__panel {
      align-self: stretch;
    }

    .sectors26-feature-card {
      min-height: 480px;
    }

    .sectors26-feature-card dl,
    .sectors26-ledger__grid,
    .sectors26-closing__links {
      grid-template-columns: 1fr;
    }

    .sectors26-ledger-card {
      grid-template-rows: 220px auto;
    }
  }
</style>
