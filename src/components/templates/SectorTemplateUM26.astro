---
// Página de sector: arriba el Blender (CineBanner), debajo el despiece de su escena por
// servicios (SectorCode), y al final los proyectos del sector con el cierre de contacto
// (SectorAfter). Nada más: la historia es "dominamos la disciplina tanto como para
// simularla en un despiece".
import CineBanner from '../cine/CineBanner.astro';
import SectorCode from '../cine/SectorCode.astro';
import SectorAfter from '../cine/SectorAfter.astro';
import { sectorBySlug, V4_CUTS } from '../../data/cine/scenes';
import { getAntecedentesCatalogCount } from '../../utils/verifiedProof';

// La página sigue recibiendo estos datos del CMS aunque ya no los muestre.
interface Props {
  sector?: any;
  antecedentes?: any[];
  valueProps?: any[];
  serviciosRelacionados?: any[];
}

const { sector = {} } = Astro.props;

const sectorSlug = sector.slug || '';
const sectorDataSlug = sectorSlug === 'gobierno' ? 'gobiernosectorpublico' : sectorSlug;
const sectorName = sector.nombre || sector.label || sector.pageHeadline || 'Sector';
const sectorSummary = sector.pageSummary || sector.summary || sector.descripcion || '';
const sectorAntecedentesHref = sectorSlug
  ? `/antecedentes?sector=${encodeURIComponent(sectorSlug)}`
  : '/antecedentes';
const sectorOrder = [
  'aeropuertos',
  'bodegas',
  'gobiernosectorpublico',
  'salud',
  'constructoras',
  'industria',
  'mineria',
  'seguridad-electronica',
  'software',
];
const sectorNumber = String(Math.max(1, sectorOrder.indexOf(sectorDataSlug) + 1)).padStart(2, '0');
// Escena del despiece: los seis sectores con escena propia usan la suya; gobierno comparte la
// de constructoras (edificio de oficinas) y software la de industria (planta con tableros).
const SPEC_FOR: Record<string, string> = {
  salud: 'salud',
  aeropuertos: 'aeropuertos',
  industria: 'industria',
  bodegas: 'bodegas',
  constructoras: 'constructoras',
  mineria: 'mineria',
  gobiernosectorpublico: 'constructoras',
  software: 'industria',
};
const specSlug = SPEC_FOR[sectorDataSlug] as any;
const cineSector = sectorBySlug(sectorDataSlug);
const cineScene = cineSector?.scene || 'fachada';
const cineStats = [
  cineSector?.count
    ? { label: 'Casos en el sector', value: cineSector.count }
    : { label: 'Proyectos documentados', value: String(getAntecedentesCatalogCount()) },
  { label: 'Soporte', value: '24/7' },
  { label: 'Trayectoria', value: '22+ años' },
];
---

<div class="um26-sector">
  <CineBanner
    variant="sector"
    scenes={[cineScene]}
    variants={{ [cineScene]: Object.keys(V4_CUTS).filter((k) => k.startsWith(`${cineScene}-`)) }}
    titleId="sector26-title"
    kicker={cineSector?.text || `Sector ${sectorNumber}`}
    title={sectorName}
    lead={sectorSummary}
    primary={{ href: '/contacto', label: 'Solicitar relevamiento' }}
    secondary={{ href: sectorAntecedentesHref, label: 'Ver casos del sector' }}
    stats={cineStats}
    back={{ href: '/sectores', label: '← Todos los sectores' }}
  />

  {specSlug && <SectorCode sector={specSlug} />}

  <SectorAfter sector={sectorSlug} label={sectorName} antecedentesHref={sectorAntecedentesHref} />
</div>

<style>
  :global(body[data-skin]) main {
    background: #0a0a0b;
  }

  .um26-sector {
    background: #0a0a0b;
    color: #f7f7f7;
  }
</style>
