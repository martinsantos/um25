---
import { truncateEditorialText } from '../../utils/editorialContent';
import { getAntecedentesCountShort } from '../../utils/verifiedProof';
import { buildSectorStrategicLinkGroups } from '../../data/strategicLinkGraph';

interface Props {
  sector?: any;
  antecedentes?: any[];
  valueProps?: any[];
  serviciosRelacionados?: any[];
}

const {
  sector = {},
  antecedentes = [],
  valueProps = [],
  serviciosRelacionados = [],
} = Astro.props;

const truncate = (value: unknown, length = 150) => truncateEditorialText(value, length);
const sectorSlug = sector.slug || '';
const sectorDataSlug = sectorSlug === 'gobierno' ? 'gobiernosectorpublico' : sectorSlug;
const sectorName = sector.nombre || sector.label || sector.pageHeadline || 'Sector';
const sectorTitle = sectorName;
const sectorSummary = sector.pageSummary || sector.summary || sector.descripcion || '';
const sectorImage = sector.heroImage || sector.image;
const sectorServices = Array.isArray(sector.services) ? sector.services : [];
const proofLabel = getAntecedentesCountShort();
const sectorAntecedentesHref = sectorSlug
  ? `/antecedentes?sector=${encodeURIComponent(sectorSlug)}`
  : '/antecedentes';
const caseHref = (item: any) => `/antecedentes/${item.id}/${item.slug || ''}`;
const leadCase = antecedentes[0];
const evidenceCases = antecedentes.slice(0, 6);
const serviceItems = (serviciosRelacionados || []).slice(0, 8);
const criteriaItems = (valueProps || []).slice(0, 6);
const heroStats = [
  { label: 'Archivo', value: proofLabel },
  { label: 'Operacion', value: '24/7' },
  { label: 'Antecedentes', value: `${antecedentes.length}+` },
];
const sectorOrder = [
  'aeropuertos',
  'bodegas',
  'gobiernosectorpublico',
  'salud',
  'constructoras',
  'industria',
  'mineria',
  'seguridad-electronica',
  'software',
];
const sectorNumber = String(Math.max(1, sectorOrder.indexOf(sectorDataSlug) + 1)).padStart(2, '0');
const sectorAccent = sectorDataSlug === 'bodegas'
  ? '#2d8a2d'
  : sectorDataSlug === 'mineria'
    ? '#71717a'
    : sectorDataSlug === 'seguridad-electronica' || sectorDataSlug === 'salud' || sectorDataSlug === 'industria'
      ? '#dc2626'
      : '#1a56c0';
const strategicLinkGroups = buildSectorStrategicLinkGroups({
  currentPath: sectorSlug ? `/${sectorSlug}` : '/sectores',
  sectorSlug: sectorDataSlug,
  sectorName,
  title: sectorTitle,
  summary: sectorSummary,
  text: [
    sector.operatingNeed,
    sector.proof,
    sectorServices.join(' '),
  ].filter(Boolean).join(' '),
  relatedServices: serviceItems,
  relatedCases: antecedentes.slice(0, 4),
});
const nextLinks = strategicLinkGroups.flatMap((group: any) => group.links || []).slice(0, 4);
const caseNameAcronyms = new Set(['SA', 'SRL', 'IT', 'CCTV', 'SDI', 'API', 'APIS', 'ERP']);
const formatCaseName = (value: unknown, fallback = 'Antecedente') => {
  const raw = String(value || fallback).trim();
  if (!raw) return fallback;
  const hasLowercase = /[a-záéíóúüñ]/.test(raw);
  if (hasLowercase || raw.length < 12) return raw;

  return raw
    .toLocaleLowerCase('es-AR')
    .replace(/(^|[\s/–-])([\p{L}\d][\p{L}\d.]*)/gu, (_match, prefix, word) => {
      const upper = word.toLocaleUpperCase('es-AR');
      if (caseNameAcronyms.has(upper)) return `${prefix}${upper}`;
      return `${prefix}${word.charAt(0).toLocaleUpperCase('es-AR')}${word.slice(1)}`;
    });
};
---

<div class="um26-sector">
  <section class="sector26-hero-card" aria-labelledby="sector26-title">
    <div class="sector26-shell">
      <a class="sector26-back" href="/sectores">← Volver a sectores</a>
      <div class="sector26-hero-frame" style={`--sector-accent: ${sectorAccent}`}>
        {sectorImage && <img src={sectorImage} alt="" loading="eager" fetchpriority="high" decoding="async" />}
        <div class="sector26-hero-frame__veil" aria-hidden="true"></div>
        <div class="sector26-hero-frame__body">
          <p class="sector26-kicker"><span></span>Sector / {sectorNumber}</p>
          <h1 id="sector26-title">{sectorTitle}</h1>
          <p>{sectorSummary}</p>
        </div>
        <dl class="sector26-hero-frame__stats" aria-label="Resumen operativo">
          {heroStats.map((stat) => (
            <div><dt>{stat.label}</dt><dd>{stat.value}</dd></div>
          ))}
        </dl>
      </div>
    </div>
  </section>

  <section class="sector26-intro">
    <div class="sector26-shell sector26-intro__grid">
      <div>
        <p class="sector26-kicker"><span></span>01 / Riesgo</p>
        <h2>{sector.operatingNeed || `Continuidad operativa para ${sectorName}.`}</h2>
      </div>
      <p>{sector.proof || sectorSummary}</p>
    </div>
  </section>

  <section class="sector26-services" aria-label="Servicios aplicados">
    <div class="sector26-shell">
      <div class="sector26-section-head">
        <p class="sector26-kicker"><span></span>02 / Servicios</p>
        <h2>Capacidades conectadas al vertical.</h2>
      </div>
      <div class="sector26-service-grid">
        {serviceItems.map((item: any, index: number) => (
          <a href={`/servicios/${item.id}/${item.slug || ''}`} class="um-click-surface sector26-service-card">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{item.nombre || item.Titulo || 'Servicio'}</strong>
            <p>{truncate(item.descripcion || item.Descripcion, 138)}</p>
            <em class="um-click-action">Ver detalle</em>
          </a>
        ))}
        {serviceItems.length === 0 && sectorServices.map((item: string, index: number) => (
          <article class="sector26-service-card">
            <span>{String(index + 1).padStart(2, '0')}</span>
            <strong>{item}</strong>
            <p>Capacidad aplicada al mapa operativo de {sectorName}.</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  {criteriaItems.length > 0 && (
    <section class="sector26-criteria">
      <div class="sector26-shell">
        <div class="sector26-section-head">
          <p class="sector26-kicker"><span></span>03 / Criterios</p>
          <h2>Condiciones de diseno.</h2>
        </div>
        <div class="sector26-criteria-grid">
          {criteriaItems.map((item: any, index: number) => (
            <article>
              <span>{String(index + 1).padStart(2, '0')}</span>
              <h3>{item.titulo}</h3>
              <p>{truncate(item.descripcion, 170)}</p>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="sector26-evidence" aria-label="Evidencia vinculada">
    <div class="sector26-shell">
      <div class="sector26-section-head sector26-section-head--split">
        <div>
          <p class="sector26-kicker"><span></span>04 / Evidencia</p>
          <h2>Archivo operativo vinculado.</h2>
        </div>
        <a href={sectorAntecedentesHref}>Ver todos los antecedentes</a>
      </div>

      {leadCase && (
        <a class="um-click-surface sector26-feature-case" href={caseHref(leadCase)}>
          {leadCase.imageUrl && <img src={leadCase.imageUrl} alt="" loading="lazy" decoding="async" />}
          <div>
            <p>Caso destacado</p>
            <h3>{leadCase.Cliente || leadCase.Titulo || 'Antecedente destacado'}</h3>
            <p>{truncate(leadCase.Descripcion || leadCase.Titulo, 190)}</p>
            <dl>
              <div><dt>Sector</dt><dd>{leadCase.Area || leadCase.Unidad_de_negocio || sectorName}</dd></div>
              <div><dt>Alcance</dt><dd>Ejecucion + soporte</dd></div>
            </dl>
            <strong class="um-click-action">Ver detalle</strong>
          </div>
        </a>
      )}

      <div class="sector26-case-list">
        {evidenceCases.slice(1).map((item: any, index: number) => (
          <a href={caseHref(item)} class="um-click-surface sector26-case-row">
            <span>{String(index + 2).padStart(2, '0')}</span>
            {item.imageUrl && <img src={item.imageUrl} alt="" loading="lazy" decoding="async" />}
            <div>
              <p>Archivo</p>
              <strong>{formatCaseName(item.Cliente || item.Titulo, 'Antecedente')}</strong>
              <em>{truncate(item.Descripcion || item.Titulo, 128)}</em>
            </div>
            <b class="um-click-action">Ver detalle</b>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sector26-closing">
    <div class="sector26-shell sector26-closing__panel">
      <div>
        <p class="sector26-kicker"><span></span>Para avanzar</p>
        <h2>Convertir riesgo del vertical en alcance tecnico.</h2>
        <p>Entramos por contexto, evidencia comparable y servicios aplicados para definir el proximo paso sin perder trazabilidad.</p>
      </div>
      <div class="sector26-closing__links">
        {nextLinks.map((link: any) => (
          <a href={link.href}>
            <span>{link.label || 'Ruta'}</span>
            <strong>{link.title}</strong>
            <em>{truncate(link.summary, 96)}</em>
          </a>
        ))}
        {nextLinks.length === 0 && (
          <>
            <a href="/contacto"><span>Contacto</span><strong>Contacto tecnico</strong><em>Enviar contexto operativo para recibir el proximo paso.</em></a>
            <a href="/servicios"><span>Servicios</span><strong>Servicios IT</strong><em>Ver capacidades aplicadas a continuidad operativa.</em></a>
          </>
        )}
      </div>
    </div>
  </section>
</div>

<style>
  :global(body[data-skin]) main {
    background: #0a0a0b;
  }

  .um26-sector {
    background: #0a0a0b;
    color: #f7f7f7;
  }

  .sector26-shell {
    width: min(1336px, calc(100% - 126px));
    margin-inline: auto;
  }

  .sector26-hero-card {
    position: relative;
    padding: clamp(66px, 8vw, 104px) 0 52px;
    overflow: hidden;
    isolation: isolate;
    background: #0a0a0b;
  }

  .sector26-back {
    display: inline-flex;
    margin-bottom: 32px;
    color: #71717a;
    font-family: var(--um-font-mono);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .sector26-back:hover {
    color: #fff;
  }

  .sector26-hero-frame {
    position: relative;
    min-height: min(62vh, 610px);
    overflow: hidden;
    isolation: isolate;
    background: #0f0f11;
    border: 1px solid rgba(255,255,255,0.1);
    border-top: 3px solid var(--sector-accent, #1a56c0);
  }

  .sector26-hero-frame > img,
  .sector26-hero-frame__veil {
    position: absolute;
    inset: 0;
  }

  .sector26-hero-frame > img {
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: contrast(1.08) saturate(0.9) brightness(0.66);
  }

  .sector26-hero-frame__veil {
    z-index: -2;
    background:
      linear-gradient(to top, rgba(10,10,11,0.98), rgba(10,10,11,0.4) 55%, rgba(10,10,11,0.12)),
      linear-gradient(100deg, rgba(10,10,11,0.82), rgba(10,10,11,0.26) 58%, rgba(10,10,11,0.72));
  }

  .sector26-hero-frame__body {
    position: absolute;
    z-index: 2;
    left: clamp(28px, 4vw, 56px);
    right: clamp(28px, 4vw, 56px);
    bottom: clamp(32px, 5vw, 64px);
  }

  .sector26-hero-frame h1 {
    max-width: 870px;
    margin: 0;
    color: #fff;
    font-family: var(--um-font-display);
    font-size: clamp(3rem, 6vw, 5rem);
    font-weight: 700;
    letter-spacing: 0;
    line-height: 0.98;
    text-wrap: balance;
  }

  .sector26-hero-frame__body > p:not(.sector26-kicker) {
    max-width: 740px;
    margin: 18px 0 0;
    color: rgba(255,255,255,0.72);
    font-size: clamp(1rem, 1.25vw, 1.18rem);
    line-height: 1.7;
  }

  .sector26-hero-frame__stats {
    position: absolute;
    top: 28px;
    right: 30px;
    z-index: 2;
    display: flex;
    gap: 1px;
    margin: 0;
    background: rgba(255,255,255,0.08);
    border: 1px solid rgba(255,255,255,0.08);
  }

  .sector26-hero-frame__stats div {
    min-width: 118px;
    padding: 12px 14px;
    background: rgba(10,10,11,0.72);
  }

  .sector26-hero-frame__stats dt {
    color: #71717a;
    font-family: var(--um-font-mono);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .sector26-hero-frame__stats dd {
    margin: 5px 0 0;
    color: #fff;
    font-family: var(--um-font-display);
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1;
  }

  .sector26-hero {
    position: relative;
    min-height: 78vh;
    overflow: hidden;
    isolation: isolate;
    background: #0a0a0b;
    border-bottom: 1px solid rgba(255,255,255,0.08);
  }

  .sector26-hero > img,
  .sector26-hero__veil {
    position: absolute;
    inset: 0;
  }

  .sector26-hero > img {
    z-index: -3;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: grayscale(0.08) contrast(1.08) saturate(0.9);
  }

  .sector26-hero__veil {
    z-index: -2;
    background:
      linear-gradient(100deg, rgba(10,10,11,0.96), rgba(10,10,11,0.72) 48%, rgba(10,10,11,0.26)),
      linear-gradient(to top, #0a0a0b, rgba(10,10,11,0.4), transparent);
  }

  .sector26-hero__grid {
    position: relative;
    z-index: 1;
    min-height: 78vh;
    display: grid;
    grid-template-columns: minmax(0, 0.62fr) minmax(330px, 0.38fr);
    gap: clamp(28px, 5vw, 72px);
    align-items: end;
    padding: clamp(64px, 8vw, 112px) 0 72px;
  }

  .sector26-crumb {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    margin-bottom: 28px;
    color: rgba(255,255,255,0.58);
    font-size: 0.86rem;
    font-weight: 700;
  }

  .sector26-crumb a {
    color: inherit;
    text-decoration: none;
  }

  .sector26-crumb a:hover {
    color: #fff;
  }

  .sector26-kicker {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: rgba(255,255,255,0.66);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .sector26-kicker span {
    width: 34px;
    height: 2px;
    background: #DC2626;
  }

  .sector26-hero h1 {
    max-width: 850px;
    margin-top: 16px;
    color: #fff;
    font-size: clamp(3.25rem, 6.5vw, 6.75rem);
    line-height: 0.94;
    font-weight: 600;
    letter-spacing: 0;
    text-wrap: balance;
  }

  .sector26-hero__copy > p:not(.sector26-kicker) {
    max-width: 760px;
    margin-top: 22px;
    color: rgba(255,255,255,0.72);
    font-size: clamp(1rem, 1.25vw, 1.18rem);
    line-height: 1.7;
  }

  .sector26-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 26px;
  }

  .sector26-btn {
    min-height: 46px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0 18px;
    color: #fff;
    font-size: 0.88rem;
    font-weight: 700;
    text-decoration: none;
  }

  .sector26-btn--red {
    background: #DC2626;
  }

  .sector26-btn--ghost {
    background: rgba(255,255,255,0.08);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.18);
  }

  .sector26-proofline {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    margin: 30px 0 0;
  }

  .sector26-proofline dt,
  .sector26-hero__panel dt {
    color: rgba(255,255,255,0.58);
    font-size: 0.78rem;
    font-weight: 700;
    letter-spacing: 0.1em;
    line-height: 1.2;
    text-transform: uppercase;
  }

  .sector26-proofline dd {
    margin: 6px 0 0;
    color: #fff;
    font-size: 1rem;
    font-weight: 700;
  }

  .sector26-hero__panel {
    align-self: center;
    padding: clamp(24px, 3vw, 34px);
    background: rgba(5,5,5,0.72);
    box-shadow: inset 0 0 0 1px rgba(255,255,255,0.12);
    backdrop-filter: blur(6px);
  }

  .sector26-hero__panel strong {
    display: block;
    color: #fff;
    font-size: clamp(1.45rem, 2.3vw, 2rem);
    line-height: 1.05;
    font-weight: 600;
  }

  .sector26-hero__panel > p {
    margin-top: 12px;
    color: rgba(255,255,255,0.72);
    font-size: 1rem;
    line-height: 1.55;
  }

  .sector26-hero__panel dl {
    display: grid;
    margin-top: 22px;
  }

  .sector26-hero__panel dl div {
    padding: 17px 0;
    border-top: 1px solid rgba(255,255,255,0.14);
  }

  .sector26-hero__panel dd {
    margin: 7px 0 0;
    color: #fff;
    font-size: 0.95rem;
    font-weight: 700;
    line-height: 1.42;
  }

  .sector26-intro,
  .sector26-services,
  .sector26-criteria,
  .sector26-evidence,
  .sector26-closing {
    background: #0a0a0b;
    border-top: 1px solid rgba(255,255,255,0.08);
  }

  .sector26-intro {
    padding: clamp(58px, 8vw, 108px) 0;
  }

  .sector26-intro__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.42fr) minmax(0, 0.58fr);
    gap: clamp(28px, 6vw, 92px);
    align-items: start;
  }

  .sector26-intro h2,
  .sector26-section-head h2,
  .sector26-closing h2 {
    margin-top: 14px;
    color: #fff;
    font-size: clamp(2.3rem, 4.3vw, 4.65rem);
    line-height: 0.96;
    font-weight: 600;
    text-wrap: balance;
    overflow-wrap: normal;
    word-break: normal;
    hyphens: none;
  }

  .sector26-intro__grid > p,
  .sector26-closing p {
    color: rgba(255,255,255,0.62);
    font-size: clamp(1rem, 1.3vw, 1.18rem);
    line-height: 1.78;
  }

  .sector26-services,
  .sector26-criteria,
  .sector26-evidence,
  .sector26-closing {
    padding: clamp(60px, 8vw, 112px) 0;
  }

  .sector26-section-head {
    max-width: 820px;
    margin-bottom: clamp(28px, 4.6vw, 54px);
  }

  .sector26-section-head--split {
    max-width: none;
    display: flex;
    justify-content: space-between;
    gap: 22px;
    align-items: end;
  }

  .sector26-section-head--split a {
    color: #fff;
    font-weight: 700;
    text-decoration: none;
  }

  .sector26-section-head--split a::after {
    content: " ->";
    color: #DC2626;
  }

  .sector26-service-grid,
  .sector26-criteria-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border: 1px solid rgba(255,255,255,0.12);
  }

  .sector26-service-card,
  .sector26-criteria-grid article {
    position: relative;
    isolation: isolate;
    --um-click-hover-bg:
      radial-gradient(circle at 100% 0%, rgba(220,38,38,0.18), transparent 48%),
      #171719;
    min-height: 260px;
    padding: clamp(22px, 3.1vw, 38px);
    background:
      radial-gradient(circle at 100% 0%, rgba(220,38,38,0.12), transparent 46%),
      #101012;
    border-right: 1px solid rgba(255,255,255,0.1);
    border-bottom: 1px solid rgba(255,255,255,0.1);
    color: #fff;
    text-decoration: none;
    transition:
      background 180ms ease,
      border-color 180ms ease,
      color 180ms ease;
  }

  a.sector26-service-card:hover,
  a.sector26-service-card:focus-visible {
    background:
      radial-gradient(circle at 100% 0%, rgba(220,38,38,0.18), transparent 48%),
      #171719;
    border-color: rgba(255,255,255,0.22);
  }

  a.sector26-service-card:focus-visible {
    outline: 3px solid rgba(220, 38, 38, 0.42);
    outline-offset: 4px;
  }

  a.sector26-service-card:hover strong,
  a.sector26-service-card:focus-visible strong {
    color: #fff !important;
  }

  a.sector26-service-card:hover p,
  a.sector26-service-card:focus-visible p {
    color: rgba(255,255,255,0.74);
  }

  .sector26-service-card span,
  .sector26-criteria-grid span,
  .sector26-case-row > span {
    color: #DC2626;
    font-size: 0.86rem;
    font-weight: 700;
  }

  .sector26-service-card strong,
  .sector26-criteria-grid h3 {
    display: block;
    margin-top: 20px;
    color: #fff;
    font-size: clamp(1.3rem, 1.75vw, 1.8rem);
    line-height: 1.04;
    font-weight: 600;
  }

  .sector26-service-card p,
  .sector26-criteria-grid p {
    margin-top: 14px;
    color: rgba(255,255,255,0.62);
    font-size: 0.98rem;
    line-height: 1.56;
  }

  .sector26-service-card em {
    display: inline-flex;
    align-items: center;
    margin-top: 22px;
    color: #fff;
    font-style: normal;
    font-weight: 700;
    text-decoration: underline;
    text-decoration-color: rgba(220,38,38,0.66);
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
    transition:
      color 180ms ease,
      text-decoration-color 180ms ease;
  }

  .sector26-service-card em::after {
    content: " ->";
    color: #DC2626;
    margin-left: 6px;
    transition: transform 180ms ease;
  }

  a.sector26-service-card:hover em,
  a.sector26-service-card:focus-visible em {
    color: #fff;
