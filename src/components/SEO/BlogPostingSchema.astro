---
/**
 * BlogPosting Schema Component
 * Generates BlogPosting JSON-LD for blog articles
 *
 * Usage:
 * <BlogPostingSchema
 *   title="Article Title"
 *   description="Article description"
 *   image="image-url.jpg"
 *   author="Author Name"
 *   datePublished={new Date('2025-01-15')}
 *   dateModified={new Date('2025-01-20')}
 *   url="https://ultimamilla.com.ar/blog/article-slug"
 * />
 */

interface Props {
  title: string;
  description: string;
  image?: string;
  author?: string;
  datePublished?: Date | string;
  dateModified?: Date | string;
  url: string;
  keywords?: string[];
  readingTime?: number;
}

const {
  title,
  description,
  image = 'https://ultimamilla.com.ar/logo.png',
  author = 'Equipo ULTIMA MILLA',
  datePublished = new Date(),
  dateModified = new Date(),
  url,
  keywords = [],
  readingTime = 5
} = Astro.props;

// Ensure dates are ISO strings
const pubDate = typeof datePublished === 'string'
  ? datePublished
  : datePublished.toISOString();

const modDate = typeof dateModified === 'string'
  ? dateModified
  : dateModified.toISOString();

const blogPostingSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  'headline': title,
  'description': description,
  'image': image.startsWith('http') ? image : `https://ultimamilla.com.ar${image}`,
  'author': {
    '@type': 'Person',
    'name': author,
    'url': 'https://ultimamilla.com.ar/nosotros'
  },
  'publisher': {
    '@type': 'Organization',
    'name': 'ULTIMA MILLA',
    'logo': {
      '@type': 'ImageObject',
      'url': 'https://ultimamilla.com.ar/logo.png',
      'width': 200,
      'height': 60
    },
    'url': 'https://ultimamilla.com.ar'
  },
  'datePublished': pubDate,
  'dateModified': modDate,
  'mainEntityOfPage': {
    '@type': 'WebPage',
    '@id': url
  },
  'articleSection': 'Blog',
  'keywords': keywords.join(', '),
  'wordCount': Math.round((description.split(/\s+/).length || 0) * 3.5) // Estimation
};
---

<script type="application/ld+json" set:html={JSON.stringify(blogPostingSchema)} />
