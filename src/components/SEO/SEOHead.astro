---
export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: 'website' | 'article' | 'service' | 'organization';
  structuredData?: object;
  noindex?: boolean;
  service?: {
    name: string;
    area: string;
    description: string;
  };
  breadcrumbs?: Array<{
    name: string;
    url: string;
  }>;
}

const {
  title = "ULTIMA MILLA | Especialistas en Comunicaciones, Sistemas e Integración - Mendoza",
  description = "ULTIMA MILLA: transformación digital y tecnología desde los 2000. +400 proyectos con Gobierno de Mendoza, AFIP, Banco Credicoop. Redes, software, seguridad y servicios gestionados.",
  keywords = "ultima milla, servicios IT mendoza, empresa tecnología mendoza, transformación digital, comunicaciones, sistemas, redes, telecomunicaciones, software a medida, seguridad informática, argentina",
  canonical,
  ogImage = "/images/og-ultima-milla-mendoza.jpg",
  ogType = "website",
  structuredData,
  noindex = false,
  service,
  breadcrumbs = []
} = Astro.props;

// Generar título optimizado para SEO local
const seoTitle = service 
  ? `${service.name} en Mendoza - ${service.area} | ULTIMA MILLA`
  : title;

// Generar descripción optimizada para SEO local
const seoDescription = service
  ? `${service.description} Servicios de ${service.area.toLowerCase()} para empresas en Mendoza, Argentina. +20 años de experiencia. Consulta gratuita.`
  : description;

// URL canónica
const canonicalUrl = canonical || Astro.url.href;

// Schema.org LocalBusiness base
const localBusinessSchema = {
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": "ULTIMA MILLA",
  "description": "Especialistas en servicios IT, comunicaciones y sistemas en Mendoza, Argentina",
  "url": "https://ultimamilla.com.ar",
  "telephone": "+54-261-4250000",
  "email": "info@ultimamilla.com.ar",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": "Av. España 1234",
    "addressLocality": "Mendoza",
    "addressRegion": "Mendoza",
    "postalCode": "5500",
    "addressCountry": "AR"
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": -32.8908,
    "longitude": -68.8272
  },
  "areaServed": {
    "@type": "City", 
    "name": "Mendoza"
  },
  "foundingDate": "2000",
  "slogan": "Transformamos tu negocio con tecnología que puedes pagar",
  "priceRange": "$$",
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Servicios IT Empresariales",
    "itemListElement": [
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service",
          "name": "Servicios IT",
          "description": "Infraestructura IT empresarial completa"
        }
      },
      {
        "@type": "Offer", 
        "itemOffered": {
          "@type": "Service",
          "name": "Redes de Datos",
          "description": "Cableado estructurado y redes empresariales"
        }
      },
      {
        "@type": "Offer",
        "itemOffered": {
          "@type": "Service", 
          "name": "Seguridad Informática",
          "description": "Ciberseguridad y protección de datos"
        }
      }
    ]
  }
};

// Schema.org Service específico si se proporciona
const serviceSchema = service ? {
  "@context": "https://schema.org",
  "@type": "Service",
  "name": `${service.name} en Mendoza`,
  "description": service.description,
  "provider": {
    "@type": "LocalBusiness",
    "name": "ULTIMA MILLA",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Mendoza",
      "addressCountry": "AR"
    }
  },
  "areaServed": {
    "@type": "City",
    "name": "Mendoza"
  },
  "serviceType": service.area
} : null;

// Schema.org Breadcrumbs
const breadcrumbSchema = breadcrumbs.length > 0 ? {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": breadcrumbs.map((crumb, index) => ({
    "@type": "ListItem",
    "position": index + 1,
    "name": crumb.name,
    "item": `https://ultimamilla.com.ar${crumb.url}`
  }))
} : null;

// Combinar schemas
const combinedSchema = {
  "@context": "https://schema.org",
  "@graph": [
    localBusinessSchema,
    ...(serviceSchema ? [serviceSchema] : []),
    ...(breadcrumbSchema ? [breadcrumbSchema] : []),
    ...(structuredData ? [structuredData] : [])
  ]
};
---

<Fragment slot="head">
  <!-- Meta Tags Básicos -->
  <title>{seoTitle}</title>
  <meta name="description" content={seoDescription} />
  <meta name="keywords" content={keywords} />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta charset="UTF-8" />

  <!-- Canonical URL -->
  <link rel="canonical" href={canonicalUrl} />

  <!-- Robots -->
  {noindex && <meta name="robots" content="noindex, nofollow" />}

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:title" content={seoTitle} />
  <meta property="og:description" content={seoDescription} />
  <meta property="og:image" content={`https://ultimamilla.com.ar${ogImage}`} />
  <meta property="og:site_name" content="ULTIMA MILLA" />
  <meta property="og:locale" content="es_AR" />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={canonicalUrl} />
  <meta name="twitter:title" content={seoTitle} />
  <meta name="twitter:description" content={seoDescription} />
  <meta name="twitter:image" content={`https://ultimamilla.com.ar${ogImage}`} />

  <!-- Local Business Meta Tags -->
  <meta name="geo.region" content="AR-M" />
  <meta name="geo.placename" content="Mendoza" />
  <meta name="geo.position" content="-32.8908;-68.8272" />
  <meta name="ICBM" content="-32.8908, -68.8272" />

  <!-- Business Info -->
  <meta name="business:contact_data:street_address" content="Av. San Martín 1234" />
  <meta name="business:contact_data:locality" content="Mendoza" />
  <meta name="business:contact_data:region" content="Mendoza" />
  <meta name="business:contact_data:postal_code" content="5500" />
  <meta name="business:contact_data:country_name" content="Argentina" />

  <!-- Preconnect para Performance -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- DNS Prefetch -->
  <link rel="dns-prefetch" href="//www.google-analytics.com" />
  <link rel="dns-prefetch" href="//www.googletagmanager.com" />

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />

  <!-- Structured Data -->
  <script type="application/ld+json" set:html={JSON.stringify(combinedSchema)} />

  <!-- Additional SEO Meta Tags for Mendoza -->
  <meta name="dc.title" content={seoTitle} />
  <meta name="dc.description" content={seoDescription} />
  <meta name="dc.subject" content="Servicios IT, Tecnología, Mendoza" />
  <meta name="dc.coverage" content="Mendoza, Argentina" />
  <meta name="dc.type" content="Service" />
  <meta name="dc.format" content="text/html" />
  <meta name="dc.language" content="es" />

  <!-- Verificación de Google (si tienes Google Search Console) -->
  <!-- <meta name="google-site-verification" content="YOUR_VERIFICATION_CODE" /> -->

  <!-- Microsoft Clarity (Analytics alternativo) -->
  <!-- Agregar si se requiere analytics adicional -->
</Fragment>
