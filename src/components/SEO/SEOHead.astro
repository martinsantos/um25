---
/**
 * SEOHead — Single source of truth for ALL <head> meta/SEO content used by LayoutV4.
 *
 * Usage from any layout:
 *   <SEOHead slot="head" title="..." description="..." canonical={Astro.url.href} />
 *
 * This component handles purely <head> meta/seo tags only.
 * Font links, GA4 tracking, and <style> blocks stay in the layout.
 */
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION, BUSINESS_ADDRESS } from '../../config/seo';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  ogType?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  hreflang?: boolean;
  gscVerification?: string;
  service?: {
    name: string;
    area: string;
    description: string;
  };
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title,
  description,
  keywords,
  canonical,
  ogImage,
  ogType = 'website',
  structuredData,
  noindex = false,
  hreflang = false,
  gscVerification,
  service,
  breadcrumbs = [],
} = Astro.props;

// ---------------------------------------------------------------------------
// Normalise current URL — strip www. and trailing slash
// ---------------------------------------------------------------------------
const currentUrl = canonical
  ? canonical.replace(/^https?:\/\/www\./, 'https://').replace(/\/$/, '')
  : `${SITE_URL}${Astro.url.pathname}`.replace(/\/$/, '');

// ---------------------------------------------------------------------------
// Title
// ---------------------------------------------------------------------------
const defaultTitle = `${SITE_NAME} | Servicios Tecnológicos en Mendoza, Cuyo y Patagonia`;
const rawTitle = title ?? defaultTitle;

const seoTitle = service
  ? `${service.name} en Mendoza - ${service.area} | ${SITE_NAME}`
  : rawTitle.includes(SITE_NAME)
    ? rawTitle
    : `${rawTitle} | ${SITE_NAME}`;

// ---------------------------------------------------------------------------
// Description
// ---------------------------------------------------------------------------
const rawDescription = description ?? SITE_DESCRIPTION;

const seoDescription = service
  ? `${service.description} Servicios de ${service.area.toLowerCase()} para empresas en Mendoza, Argentina. +20 años de experiencia. Consulta gratuita.`
  : rawDescription;

// ---------------------------------------------------------------------------
// Keywords
// ---------------------------------------------------------------------------
const defaultKeywords =
  'servicios tecnologicos empresas argentina, zona incumbencia mendoza cuyo patagonia, telecomunicaciones profesionales, cableado estructurado certificado, corrientes debiles instalacion, deteccion incendio sistemas, software a medida organizaciones, servicios it mendoza san juan san luis, mineria tecnologia, industria 4.0, salud hospitales, aeropuertos infraestructura, gobierno sector publico, bodegas vitivinicolas, constructoras, seguridad electronica cctv';
const pageKeywords = keywords ?? defaultKeywords;

// ---------------------------------------------------------------------------
// OG Image — ensure absolute URL
// ---------------------------------------------------------------------------
const rawImage = ogImage || '/nosotros-tech.jpg';
const pageImage = rawImage.startsWith('http') ? rawImage : `${SITE_URL}${rawImage}`;

// ---------------------------------------------------------------------------
// Timestamps
// ---------------------------------------------------------------------------
const currentYear = new Date().getFullYear();
const isoNow = new Date().toISOString();

// ---------------------------------------------------------------------------
// Schema.org entities
// ---------------------------------------------------------------------------

/** Base organisation — always present */
const organizationSchema = {
  "@type": "Organization",
  name: SITE_NAME,
  alternateName: "Ultima Milla Comunicaciones",
  url: SITE_URL,
  logo: `${SITE_URL}/images/um-logo.png`,
  description: SITE_DESCRIPTION,
  foundingDate: "2000",
  address: {
    "@type": "PostalAddress",
    ...BUSINESS_ADDRESS,
  },
  areaServed: [
    { "@type": "City", name: "Mendoza" },
    { "@type": "City", name: "San Juan" },
    { "@type": "City", name: "San Luis" },
    { "@type": "AdministrativeArea", name: "Patagonia" },
    { "@type": "Country", name: "Argentina" },
  ],
  geo: {
    "@type": "GeoCoordinates",
    latitude: "-32.8908",
    longitude: "-68.8272",
  },
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer service",
    email: "contacto@ultimamilla.com.ar",
    url: `${SITE_URL}/contacto`,
    availableLanguage: ["es", "en"],
  },
  sameAs: [
    "https://www.linkedin.com/company/ultimamilla",
    "https://x.com/ultimamilla",
  ],
};

/** LocalBusiness — always present (physical office in Mendoza) */
const localBusinessSchema = {
  "@type": "LocalBusiness",
  name: SITE_NAME,
  description: SITE_DESCRIPTION,
  url: SITE_URL,
  email: "contacto@ultimamilla.com.ar",
  address: {
    "@type": "PostalAddress",
    ...BUSINESS_ADDRESS,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: -32.8908,
    longitude: -68.8272,
  },
  areaServed: { "@type": "City", name: "Mendoza" },
  foundingDate: "2000",
  slogan: "Transformamos tu negocio con tecnología que puedes pagar",
  priceRange: "$$",
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    opens: "08:00",
    closes: "18:00",
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Servicios IT Empresariales",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Servicios IT",
          description: "Infraestructura IT empresarial completa",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Redes de Datos",
          description: "Cableado estructurado y redes empresariales",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Seguridad Informática",
          description: "Ciberseguridad y protección de datos",
        },
      },
    ],
  },
  aggregateRating: {
    "@type": "AggregateRating",
    ratingValue: "4.8",
    reviewCount: "47",
    bestRating: "5",
    worstRating: "1",
  },
  sameAs: [
    "https://www.linkedin.com/company/ultimamilla",
    "https://x.com/ultimamilla",
  ],
};

/** Service-specific schema (only when `service` prop is provided) */
const serviceSchema = service
  ? {
      "@type": "Service",
      name: `${service.name} en Mendoza`,
      description: service.description,
      provider: {
        "@type": "LocalBusiness",
        name: SITE_NAME,
        address: {
          "@type": "PostalAddress",
          addressLocality: "Mendoza",
          addressCountry: "AR",
        },
      },
      areaServed: { "@type": "City", name: "Mendoza" },
      serviceType: service.area,
    }
  : null;

/** BreadcrumbList (only when `breadcrumbs` prop has entries) */
const breadcrumbSchema = breadcrumbs.length > 0
  ? {
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map((crumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: crumb.name,
        item: crumb.url.startsWith("http")
          ? crumb.url.replace(/^https?:\/\/www\./, "https://")
          : `${SITE_URL}${crumb.url}`,
      })),
    }
  : null;

/** Additional structured data passed via prop — normalise to array */
const additionalStructuredData = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];

// ---------------------------------------------------------------------------
// Combined @graph
// ---------------------------------------------------------------------------
const combinedSchema = {
  "@context": "https://schema.org",
  "@graph": [
    organizationSchema,
    localBusinessSchema,
    ...(serviceSchema ? [serviceSchema] : []),
    ...(breadcrumbSchema ? [breadcrumbSchema] : []),
    ...additionalStructuredData,
  ],
};
---

<Fragment slot="head">
  <!-- Charset & Viewport -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />

  <!-- Primary Meta -->
  <title>{seoTitle}</title>
  <meta name="title" content={seoTitle} />
  <meta name="description" content={seoDescription} />
  <meta name="keywords" content={pageKeywords} />
  <meta name="robots" content={noindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
  <meta name="author" content={SITE_NAME} />
  <meta name="publisher" content={SITE_NAME} />
  <meta name="copyright" content={`© ${currentYear} ${SITE_NAME}`} />
  <meta name="language" content="es-AR" />
  <meta name="revisit-after" content="7 days" />
  <meta name="rating" content="general" />
  <meta name="distribution" content="global" />
  <meta name="theme-color" content="#DC2626" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
  <meta name="application-name" content={SITE_NAME} />
  <meta name="msapplication-TileColor" content="#0ea5e9" />
  <meta name="format-detection" content="telephone=yes" />

  <!-- Google Search Console Verification -->
  {gscVerification && <meta name="google-site-verification" content={gscVerification} />}

  <!-- Geo Meta -->
  <meta name="geo.region" content="AR-M" />
  <meta name="geo.placename" content="Mendoza" />
  <meta name="geo.position" content="-32.8908;-68.8272" />
  <meta name="ICBM" content="-32.8908, -68.8272" />

  <!-- Business Contact Info -->
  <meta name="business:contact_data:street_address" content={BUSINESS_ADDRESS.streetAddress} />
  <meta name="business:contact_data:locality" content={BUSINESS_ADDRESS.addressLocality} />
  <meta name="business:contact_data:region" content={BUSINESS_ADDRESS.addressRegion} />
  <meta name="business:contact_data:postal_code" content={BUSINESS_ADDRESS.postalCode} />
  <meta name="business:contact_data:country_name" content="Argentina" />

  <!-- Dublin Core -->
  <meta name="dc.title" content={seoTitle} />
  <meta name="dc.description" content={seoDescription} />
  <meta name="dc.subject" content="Servicios IT, Tecnología, Mendoza" />
  <meta name="dc.coverage" content="Mendoza, Argentina" />
  <meta name="dc.type" content="Service" />
  <meta name="dc.format" content="text/html" />
  <meta name="dc.language" content="es" />

  <!-- Canonical URL -->
  <link rel="canonical" href={currentUrl} />

  <!-- Hreflang (self-referencing) — controlled by `hreflang` prop -->
  {hreflang && (
    <>
      <link rel="alternate" hreflang="es-AR" href={currentUrl} />
      <link rel="alternate" hreflang="es" href={currentUrl} />
      <link rel="alternate" hreflang="x-default" href={currentUrl} />
    </>
  )}

  <!-- Sitemap Discovery -->
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={currentUrl} />
  <meta property="og:title" content={seoTitle} />
  <meta property="og:description" content={seoDescription} />
  <meta property="og:image" content={pageImage} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={seoTitle} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content="es_AR" />
  <meta property="og:updated_time" content={isoNow} />

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={currentUrl} />
  <meta name="twitter:title" content={seoTitle} />
  <meta name="twitter:description" content={seoDescription} />
  <meta name="twitter:image" content={pageImage} />
  <meta name="twitter:image:alt" content={seoTitle} />
  <meta name="twitter:site" content="@ultimamilla" />
  <meta name="twitter:creator" content="@ultimamilla" />

  <!-- Performance: DNS Prefetch (analytics domains) -->
  <link rel="dns-prefetch" href="//www.google-analytics.com" />
  <link rel="dns-prefetch" href="//www.googletagmanager.com" />

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/svg+xml" sizes="16x16" href="/favicon-16.svg" />
  <link rel="icon" type="image/svg+xml" sizes="32x32" href="/favicon-32.svg" />
  <link rel="icon" type="image/svg+xml" sizes="192x192" href="/favicon-192.svg" />
  <link rel="icon" type="image/svg+xml" sizes="512x512" href="/favicon-512.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
  <link rel="manifest" href="/site.webmanifest" />

  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify(combinedSchema)} />
</Fragment>
