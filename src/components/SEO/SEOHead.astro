---
/**
 * SEOHead — Single source of truth for ALL <head> meta/SEO content used by LayoutV4.
 *
 * Usage from any layout:
 *   <SEOHead slot="head" title="..." description="..." canonical={Astro.url.href} />
 *
 * This component handles purely <head> meta/seo tags only.
 * Font links, GA4 tracking, and <style> blocks stay in the layout.
 */
import { SITE_URL, SITE_NAME, SITE_DESCRIPTION, BUSINESS_ADDRESS } from '../../config/seo';
import { resolveEnglishPath, resolvePageLanguage, resolveSpanishPath } from '../../config/i18nRoutes';
import { editorialImages, editorialImageDimensions } from '../../data/editorialImageSystem';
import { canonicalUrl as toCanonicalUrl, publicImageUrl, stripWww } from '../../utils/seoUrl';
import { finalizeSeoTitle, trimAtWordBoundary } from '../../utils/seoMetaPolicy';
import { getPageMetaOverride, isInternalPath } from '../../utils/seoPageOverrides';
import { DEFAULT_OG_IMAGE_PATH, OG_IMAGE_HEIGHT, OG_IMAGE_WIDTH, absoluteOgUrl, ogVariantFor } from '../../utils/seoOgImage';
import { getLocalImageDimensions } from '../../utils/seoImageMeta';

export interface Props {
  title?: string;
  description?: string;
  keywords?: string;
  canonical?: string;
  ogImage?: string;
  ogImageWidth?: number;
  ogImageHeight?: number;
  ogType?: string;
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
  noindex?: boolean;
  hreflang?: boolean;
  gscVerification?: string;
  updatedTime?: string | Date;
  service?: {
    name: string;
    area: string;
    description: string;
  };
  breadcrumbs?: Array<{ name: string; url: string }>;
}

const {
  title,
  description,
  keywords,
  canonical,
  ogImage,
  ogImageWidth,
  ogImageHeight,
  ogType = 'website',
  structuredData,
  noindex = false,
  hreflang = false,
  gscVerification,
  updatedTime,
  service,
  breadcrumbs: breadcrumbsFromLayout = [],
} = Astro.props;

// Una página puede fijar su jerarquía (Blog → Tema → Nota) en Astro.locals;
// si no, se usan las migas derivadas de la URL por el layout.
const breadcrumbs = Astro.locals?.seoBreadcrumbs?.length
  ? Astro.locals.seoBreadcrumbs
  : breadcrumbsFromLayout;

// ---------------------------------------------------------------------------
// Normalise current URL to the public canonical host and strip trailing slash.
// ---------------------------------------------------------------------------
const currentUrl = canonical
  ? toCanonicalUrl(canonical)
  : toCanonicalUrl(Astro.url.pathname);

const pathname = Astro.url.pathname;
const pageOverride = getPageMetaOverride(pathname);
const shouldNoindex = noindex || isInternalPath(pathname);
const pageLang = resolvePageLanguage(pathname);
const pageLanguageTag = pageLang === 'en' ? 'en' : 'es-AR';
const dcLanguage = pageLang === 'en' ? 'en' : 'es';
const ogLocale = pageLang === 'en' ? 'en_US' : 'es_AR';
const spanishPath = resolveSpanishPath(pathname);
const englishPath = resolveEnglishPath(pathname);
const hreflangEsUrl = toCanonicalUrl(spanishPath);
const hreflangEnUrl = toCanonicalUrl(englishPath);

// ---------------------------------------------------------------------------
// Title
// ---------------------------------------------------------------------------
const defaultTitle = `${SITE_NAME} | Servicios Tecnológicos en Mendoza, Cuyo y Patagonia`;
const rawTitle = pageOverride?.title ?? title ?? defaultTitle;

const seoTitle = service
  ? `${service.name} en Mendoza · ${service.area}`
  : rawTitle;
// 30–60 caracteres: la marca se agrega sólo si entra sin cortar el título humano.
const metaTitle = finalizeSeoTitle(seoTitle);

// ---------------------------------------------------------------------------
// Description
// ---------------------------------------------------------------------------
const rawDescription = pageOverride?.description ?? description ?? SITE_DESCRIPTION;

const seoDescription = service
  ? `${service.description} Servicios de ${service.area.toLowerCase()} para empresas en Mendoza, Cuyo y Patagonia. Relevamiento técnico y alcance operativo.`
  : rawDescription;
const metaDescription = trimAtWordBoundary(seoDescription, 160);

// ---------------------------------------------------------------------------
// Keywords
// ---------------------------------------------------------------------------
const defaultKeywords =
  'servicios tecnologicos empresas argentina, zona incumbencia mendoza cuyo patagonia, telecomunicaciones profesionales, cableado estructurado certificado, corrientes debiles instalacion, deteccion incendio sistemas, software a medida organizaciones, servicios it mendoza san juan san luis, mineria tecnologia, industria 4.0, salud hospitales, aeropuertos infraestructura, gobierno sector publico, bodegas vitivinicolas, constructoras, seguridad electronica cctv';
const pageKeywords = keywords ?? defaultKeywords;

// ---------------------------------------------------------------------------
// OG Image — ensure absolute URL
// ---------------------------------------------------------------------------
// Preferencia: variante 1200×630 generada > imagen dedicada de 1200×630 >
// imagen original con sus dimensiones medidas > imagen por defecto 1200×630.
const rawImage = ogImage || editorialImages.defaultOg;
const ogVariant = ogVariantFor(rawImage);
const declaresOgSize = ogImageWidth === OG_IMAGE_WIDTH && ogImageHeight === OG_IMAGE_HEIGHT;
const publicRawImage = publicImageUrl(rawImage);
let pageImage = absoluteOgUrl(DEFAULT_OG_IMAGE_PATH);
let ogWidth: number | null = OG_IMAGE_WIDTH;
let ogHeight: number | null = OG_IMAGE_HEIGHT;
if (ogVariant) {
  pageImage = absoluteOgUrl(ogVariant);
} else if (publicRawImage) {
  pageImage = publicRawImage;
  const measured = declaresOgSize ? null : await getLocalImageDimensions(publicRawImage);
  ogWidth = declaresOgSize ? OG_IMAGE_WIDTH : measured?.width ?? null;
  ogHeight = declaresOgSize ? OG_IMAGE_HEIGHT : measured?.height ?? null;
}
const normalizedOgImageWidth = ogWidth ? String(ogWidth) : '';
const normalizedOgImageHeight = ogHeight ? String(ogHeight) : '';
const ogImageType = /\.jpe?g$/i.test(pageImage) ? 'image/jpeg' : /\.webp$/i.test(pageImage) ? 'image/webp' : /\.png$/i.test(pageImage) ? 'image/png' : '';

// ---------------------------------------------------------------------------
// Timestamps
// ---------------------------------------------------------------------------
const currentYear = new Date().getFullYear();
const stableUpdatedTime = updatedTime ? new Date(updatedTime).toISOString() : null;

// ---------------------------------------------------------------------------
// Schema.org entities
// ---------------------------------------------------------------------------

/** Base organisation — always present */
const organizationSchema = {
  "@type": "Organization",
  "@id": `${SITE_URL}/#organization`,
  name: SITE_NAME,
  legalName: "ULTIMA MILLA S.A.",
  alternateName: "Ultima Milla Comunicaciones",
  // Fecha de fundación confirmada por la dirección (01/06/2003).
  foundingDate: "2003-06-01",
  url: SITE_URL,
  logo: {
    "@type": "ImageObject",
    url: `${SITE_URL}/images/um-logo.png`,
    width: 2816,
    height: 1536,
  },
  description: SITE_DESCRIPTION,
  address: {
    "@type": "PostalAddress",
    ...BUSINESS_ADDRESS,
  },
  areaServed: [
    { "@type": "City", name: "Mendoza" },
    { "@type": "City", name: "San Juan" },
    { "@type": "City", name: "San Luis" },
    { "@type": "AdministrativeArea", name: "Patagonia" },
    { "@type": "Country", name: "Argentina" },
  ],
  geo: {
    "@type": "GeoCoordinates",
    latitude: "-32.8908",
    longitude: "-68.8272",
  },
  contactPoint: {
    "@type": "ContactPoint",
    contactType: "customer service",
    email: "contacto@ultimamilla.com.ar",
    url: `${SITE_URL}/contacto`,
    availableLanguage: ["es", "en"],
  },
  sameAs: [
    "https://www.linkedin.com/company/ultimamilla",
    "https://x.com/ultimamilla",
  ],
};

/** LocalBusiness — always present (physical office in Mendoza) */
const localBusinessSchema = {
  "@type": "LocalBusiness",
  "@id": `${SITE_URL}/#sede-mendoza`,
  name: `${SITE_NAME} · Sede Mendoza`,
  description: SITE_DESCRIPTION,
  url: SITE_URL,
  image: `${SITE_URL}${DEFAULT_OG_IMAGE_PATH}`,
  logo: `${SITE_URL}/images/um-logo.png`,
  parentOrganization: { "@id": `${SITE_URL}/#organization` },
  email: "contacto@ultimamilla.com.ar",
  address: {
    "@type": "PostalAddress",
    ...BUSINESS_ADDRESS,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: -32.8908,
    longitude: -68.8272,
  },
  areaServed: [
    { "@type": "AdministrativeArea", name: "Mendoza" },
    { "@type": "AdministrativeArea", name: "San Juan" },
    { "@type": "AdministrativeArea", name: "San Luis" },
    { "@type": "AdministrativeArea", name: "Neuquén" },
    { "@type": "AdministrativeArea", name: "Patagonia" },
  ],
  slogan: "Servicios IT para operaciones que no pueden detenerse",
  openingHoursSpecification: {
    "@type": "OpeningHoursSpecification",
    dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"],
    opens: "08:00",
    closes: "18:00",
  },
  hasOfferCatalog: {
    "@type": "OfferCatalog",
    name: "Servicios IT Empresariales",
    itemListElement: [
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Servicios IT integrales",
          description: "Redes, seguridad electrónica, telecomunicaciones, software, soporte y energía IT",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Redes de Datos",
          description: "Cableado estructurado, fibra óptica, switching y radioenlaces",
        },
      },
      {
        "@type": "Offer",
        itemOffered: {
          "@type": "Service",
          name: "Seguridad electrónica",
          description: "CCTV, control de accesos, intrusión, monitoreo y sistemas de detección",
        },
      },
    ],
  },
  sameAs: [
    "https://www.linkedin.com/company/ultimamilla",
    "https://x.com/ultimamilla",
  ],
};

/** Service-specific schema (only when `service` prop is provided) */
const serviceSchema = service
  ? {
      "@type": "Service",
      name: `${service.name} en Mendoza`,
      description: service.description,
      inLanguage: pageLanguageTag,
      provider: { "@id": `${SITE_URL}/#organization` },
      areaServed: { "@type": "City", name: "Mendoza" },
      serviceType: service.area,
    }
  : null;

/** BreadcrumbList (only when `breadcrumbs` prop has entries) */
const breadcrumbSchema = breadcrumbs.length > 0
  ? {
      "@type": "BreadcrumbList",
      itemListElement: breadcrumbs.map((crumb, index) => ({
        "@type": "ListItem",
        position: index + 1,
        name: crumb.name,
        item: crumb.url.startsWith("http")
          ? stripWww(crumb.url)
          : toCanonicalUrl(crumb.url),
      })),
    }
  : null;

/** Additional structured data passed via prop — normalise to array */
const additionalStructuredData = Array.isArray(structuredData)
  ? structuredData
  : structuredData
    ? [structuredData]
    : [];

// ---------------------------------------------------------------------------
// Combined @graph
// ---------------------------------------------------------------------------
const combinedSchema = {
  "@context": "https://schema.org",
  "@graph": [
    organizationSchema,
    localBusinessSchema,
    ...(serviceSchema ? [serviceSchema] : []),
    ...(breadcrumbSchema ? [breadcrumbSchema] : []),
    ...additionalStructuredData,
  ],
};
---

<Fragment slot="head">
  <!-- Charset & Viewport -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0, viewport-fit=cover" />

  <!-- Primary Meta -->
  <title>{metaTitle}</title>
  <meta name="title" content={metaTitle} />
  <meta name="description" content={metaDescription} />
  <meta name="keywords" content={pageKeywords} />
  <meta name="robots" content={shouldNoindex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'} />
  <meta name="author" content={SITE_NAME} />
  <meta name="publisher" content={SITE_NAME} />
  <meta name="copyright" content={`© ${currentYear} ${SITE_NAME}`} />
  <meta name="language" content={pageLanguageTag} />
  <meta name="revisit-after" content="7 days" />
  <meta name="rating" content="general" />
  <meta name="distribution" content="global" />
  <meta name="theme-color" content="#DC2626" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-title" content={SITE_NAME} />
  <meta name="application-name" content={SITE_NAME} />
  <meta name="msapplication-TileColor" content="#DC2626" />
  <meta name="format-detection" content="telephone=yes" />

  <!-- Google Search Console Verification -->
  {gscVerification && <meta name="google-site-verification" content={gscVerification} />}

  <!-- Geo Meta -->
  <meta name="geo.region" content="AR-M" />
  <meta name="geo.placename" content="Mendoza" />
  <meta name="geo.position" content="-32.8908;-68.8272" />
  <meta name="ICBM" content="-32.8908, -68.8272" />

  <!-- Business Contact Info -->
  <meta name="business:contact_data:street_address" content={BUSINESS_ADDRESS.streetAddress} />
  <meta name="business:contact_data:locality" content={BUSINESS_ADDRESS.addressLocality} />
  <meta name="business:contact_data:region" content={BUSINESS_ADDRESS.addressRegion} />
  <meta name="business:contact_data:postal_code" content={BUSINESS_ADDRESS.postalCode} />
  <meta name="business:contact_data:country_name" content="Argentina" />

  <!-- Dublin Core -->
  <meta name="dc.title" content={metaTitle} />
  <meta name="dc.description" content={metaDescription} />
  <meta name="dc.subject" content="Servicios IT, Tecnología, Mendoza" />
  <meta name="dc.coverage" content="Mendoza, Argentina" />
  <meta name="dc.type" content="Service" />
  <meta name="dc.format" content="text/html" />
  <meta name="dc.language" content={dcLanguage} />

  <!-- Canonical URL -->
  <link rel="canonical" href={currentUrl} />

  <!-- Hreflang (self-referencing) — controlled by `hreflang` prop -->
  {hreflang && (
    <>
      <link rel="alternate" hreflang="es-AR" href={hreflangEsUrl} />
      <link rel="alternate" hreflang="es" href={hreflangEsUrl} />
      <link rel="alternate" hreflang="en" href={hreflangEnUrl} />
      <link rel="alternate" hreflang="x-default" href={hreflangEsUrl} />
    </>
  )}

  <!-- Sitemap Discovery -->
  <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
  <link rel="alternate" type="text/plain" href="/llms.txt" title="ULTIMA MILLA LLM discovery" />
  <link rel="alternate" type="application/rss+xml" href="/rss.xml" title="Blog ULTIMA MILLA" />
  <link rel="alternate" type="application/json" href="/geo/brand-facts.json" title="ULTIMA MILLA GEO brand facts" />

  <!-- Open Graph / Facebook -->
  <meta property="og:type" content={ogType} />
  <meta property="og:url" content={currentUrl} />
  <meta property="og:title" content={metaTitle} />
  <meta property="og:description" content={metaDescription} />
  <meta property="og:image" content={pageImage} />
  {normalizedOgImageWidth && <meta property="og:image:width" content={normalizedOgImageWidth} />}
  {normalizedOgImageHeight && <meta property="og:image:height" content={normalizedOgImageHeight} />}
  {ogImageType && <meta property="og:image:type" content={ogImageType} />}
  <meta property="og:image:alt" content={metaTitle} />
  <meta property="og:site_name" content={SITE_NAME} />
  <meta property="og:locale" content={ogLocale} />
  {stableUpdatedTime && <meta property="og:updated_time" content={stableUpdatedTime} />}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:url" content={currentUrl} />
  <meta name="twitter:title" content={metaTitle} />
  <meta name="twitter:description" content={metaDescription} />
  <meta name="twitter:image" content={pageImage} />
  <meta name="twitter:image:alt" content={metaTitle} />
  <meta name="twitter:site" content="@ultimamilla" />
  <meta name="twitter:creator" content="@ultimamilla" />

  <!-- Performance: DNS Prefetch (analytics domains) -->
  <link rel="dns-prefetch" href="//www.google-analytics.com" />
  <link rel="dns-prefetch" href="//www.googletagmanager.com" />

  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico" />
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="icon" type="image/svg+xml" sizes="16x16" href="/favicon-16.svg" />
  <link rel="icon" type="image/svg+xml" sizes="32x32" href="/favicon-32.svg" />
  <link rel="icon" type="image/svg+xml" sizes="192x192" href="/favicon-192.svg" />
  <link rel="icon" type="image/svg+xml" sizes="512x512" href="/favicon-512.svg" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.svg" />
  <link rel="manifest" href="/manifest.json" />

  <!-- Structured Data (JSON-LD) -->
  <script type="application/ld+json" set:html={JSON.stringify(combinedSchema)} />
</Fragment>
