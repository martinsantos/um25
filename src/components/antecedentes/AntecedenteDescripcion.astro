---
interface Props {
  descripcion: string;
  titulo?: string;
}

const { descripcion, titulo = "Descripción" } = Astro.props;
---

<section class="antecedente-descripcion">
  <div class="antecedente-descripcion__container">
    {titulo && <h2 class="antecedente-descripcion__title">{titulo}</h2>}
    
    {descripcion ? (
      <div class="antecedente-descripcion__content">
        <p set:html={descripcion}></p>
      </div>
    ) : (
      <p class="antecedente-descripcion__empty">No hay descripción disponible</p>
    )}
  </div>
</section>

<style>
  .antecedente-descripcion {
    padding: 4rem 0;
    background-color: #fff;
  }
  
  .antecedente-descripcion__container {
    max-width: 800px;
    margin: 0 auto;
    padding: 0 20px;
  }
  
  .antecedente-descripcion__title {
    font-size: 2.5rem;
    margin-bottom: 2rem;
    text-align: center;
    color: #333;
  }
  
  .antecedente-descripcion__content {
    color: #444;
    line-height: 1.8;
    font-size: 1.1rem;
  }
  
  .antecedente-descripcion__content p {
    margin-bottom: 1.5rem;
  }
  
  .antecedente-descripcion__empty {
    text-align: center;
    color: #666;
    font-style: italic;
    padding: 2rem;
  }
  
  @media (max-width: 768px) {
    .antecedente-descripcion__title {
      font-size: 2rem;
    }
    
    .antecedente-descripcion__content {
      font-size: 1rem;
    }
  }
</style>
