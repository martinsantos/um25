---
import { getOptimizedImageUrl } from '../../utils/assets.js';

interface Props {
  titulo: string;
  subtitulo?: string;
  imagenFondo?: any;
  cliente?: string;
  fecha?: string;
  estado?: string;
}

const { titulo, subtitulo, imagenFondo, cliente = 'Cliente', fecha = 'Fecha no especificada', estado = 'Completado' } = Astro.props;

// Función para extraer el ID de la imagen de diferentes formatos
function extractImageId(imageData) {
  if (!imageData) return null;
  
  // Si es un string, asumimos que es directamente el ID
  if (typeof imageData === 'string') return imageData;
  
  // Si es un array, tomar el primer elemento
  if (Array.isArray(imageData) && imageData.length > 0) {
    return extractImageId(imageData[0]);
  }
  
  // Si es un objeto, buscar el ID en diferentes propiedades
  if (typeof imageData === 'object') {
    return (
      imageData.id ||
      imageData.directus_files_id?.id ||
      imageData.directus_files_id ||
      imageData.file?.id ||
      imageData.data?.id
    );
  }
  
  return null;
}

// Obtener URL de la imagen si existe
let imageUrl = null;
const imageId = extractImageId(imagenFondo);

// Imagen por defecto (gradiente azul) si no hay imagen
const defaultImageUrl = '/images/default.jpg';

if (imageId) {
  const baseUrl = import.meta.env.PUBLIC_DIRECTUS_URL || 'http://localhost:8055';
  imageUrl = `${baseUrl}/assets/${imageId}?width=1920&quality=80`;
} else {
  // Usar imagen por defecto si no hay ID de imagen
  console.log('Usando imagen por defecto para el antecedente');
  imageUrl = defaultImageUrl;
}

// Determinar el color del estado
let estadoColor = 'green';
if (estado.toLowerCase().includes('pendiente')) {
  estadoColor = 'yellow';
} else if (estado.toLowerCase().includes('cancelado') || estado.toLowerCase().includes('error')) {
  estadoColor = 'red';
}
---

<header class="bg-gradient-to-r from-blue-900 to-blue-700 shadow-lg">
  <div class="container mx-auto px-4 sm:px-6 py-6 sm:py-8">
    <div class="flex items-center justify-between">
      <div class="flex items-center">
        <span class="material-icons-outlined text-white mr-3 text-3xl">verified_user</span>
        <h1 class="text-2xl sm:text-3xl font-bold text-white">Ultima Milla</h1>
      </div>
      <nav class="hidden md:block">
        <a class="text-white hover:text-blue-200 px-3 py-2 rounded-md text-sm font-medium" href="/">Inicio</a>
        <a class="text-white hover:text-blue-200 px-3 py-2 rounded-md text-sm font-medium" href="/servicios">Servicios</a>
        <a class="text-white hover:text-blue-200 px-3 py-2 rounded-md text-sm font-medium bg-blue-800" href="/antecedentes">Antecedentes</a>
        <a class="text-white hover:text-blue-200 px-3 py-2 rounded-md text-sm font-medium" href="/nosotros">Nosotros</a>
      </nav>
      <button class="md:hidden text-white">
        <span class="material-icons-outlined">menu</span>
      </button>
    </div>
  </div>
</header>

<main class="container mx-auto px-4 sm:px-6 py-8">
  <!-- Cabecera del caso -->
  <div class="mb-8 p-6 bg-white rounded-lg shadow-md">
    <div class="flex flex-col sm:flex-row sm:items-center justify-between mb-4 gap-4">
      <h2 class="text-xl sm:text-2xl font-semibold text-gray-800">{titulo}</h2>
      <span class={`inline-flex items-center px-3 py-1 rounded-full text-sm font-medium bg-${estadoColor}-100 text-${estadoColor}-700`}>
        <span class="material-icons-outlined mr-1.5 text-sm">check_circle</span>
        {estado}
      </span>
    </div>
    
    <div class="flex flex-col sm:flex-row justify-between gap-4">
      <div>
        <p class="text-sm font-medium text-gray-500 uppercase tracking-wider">Cliente</p>
        <p class="text-lg text-gray-800 font-semibold">{cliente}</p>
      </div>
      <div>
        <p class="text-sm font-medium text-gray-500 uppercase tracking-wider">Fecha</p>
        <p class="text-lg text-gray-800 font-semibold">{fecha}</p>
      </div>
    </div>
    
    {subtitulo && (
      <div class="mt-4">
        <p class="text-gray-600 text-md">{subtitulo}</p>
      </div>
    )}
  </div>
  
  <!-- Sección Hero con imagen de fondo -->
  <div 
    class="mb-8 rounded-lg overflow-hidden shadow-lg bg-cover bg-center h-[300px] md:h-[400px] flex items-center justify-center relative" 
    style={`background-image: url('${imageUrl}');`}
  >
    <div class="absolute inset-0 bg-blue-900 bg-opacity-50"></div>
    <div class="relative z-10 text-center px-4">
      <h2 class="text-3xl md:text-4xl font-bold text-white mb-4">{titulo}</h2>
      {subtitulo && (
        <p class="text-xl text-white max-w-3xl mx-auto">{subtitulo}</p>
      )}
    </div>
  </div>
</main>

<style>
  /* Estilos personalizados si son necesarios */
  .hero-section {
    padding: 6rem 0;
  }
  
  @media (max-width: 768px) {
    .hero-section {
      padding: 4rem 0;
      min-height: 70vh;
    }
  }
</style>
