---
interface Props {
  titulo?: string;
  subtitulo?: string;
  botonPrimario?: string;
  botonSecundario?: string;
  iconoPrimario?: string;
  iconoSecundario?: string;
}

const { 
  titulo = "Maximice su confianza con nuestros servicios", 
  subtitulo = "Garantice el cumplimiento, mitigue riesgos y tome decisiones informadas con nuestras soluciones líderes en el sector.",
  botonPrimario = "Descargar Informe Completo",
  botonSecundario = "Solicitar Consulta",
  iconoPrimario = "description",
  iconoSecundario = "contact_support"
} = Astro.props;
---

<section class="bg-gradient-to-r from-blue-600 to-indigo-700 text-white p-8 rounded-lg shadow-xl text-center mb-12">
  <h3 class="text-2xl font-semibold mb-3">{titulo}</h3>
  <p class="mb-6 text-blue-100 max-w-3xl mx-auto">
    {subtitulo}
  </p>
  <div class="flex flex-col sm:flex-row justify-center gap-4">
    <button class="bg-white text-blue-700 font-semibold py-3 px-6 rounded-lg shadow-md hover:bg-blue-50 transition duration-300 ease-in-out transform hover:scale-105">
      <span class="material-icons-outlined mr-2 align-middle text-sm">{iconoPrimario}</span>
      {botonPrimario}
    </button>
    <button class="border border-white text-white font-semibold py-3 px-6 rounded-lg hover:bg-white hover:text-blue-700 transition duration-300 ease-in-out transform hover:scale-105">
      <span class="material-icons-outlined mr-2 align-middle text-sm">{iconoSecundario}</span>
      {botonSecundario}
    </button>
  </div>
</section>
