---
import '../../styles/proto-despiece.css';
import Head from './Head.astro';
import Top from './Top.astro';
import Cierre from './Cierre.astro';
import { publicDespiecePath } from '../../lib/despieceRoutes';
import { NAV_SERVICES, NAV_SECTORS, directoryCardId } from '../../data/navigation';
import { shellServiceCopy } from '../../config/i18nShell';
import { ChevronRight } from 'lucide-astro';
import { publicCaseTitle } from './casePresentation';
import type { Story } from './isoData';

interface Props { matches?: Story[] }
const { matches = [] } = Astro.props;
const path = publicDespiecePath(Astro.originPathname);
const archive = path.startsWith('/antecedentes/') || matches.length > 0;
const en = path === '/en' || path.startsWith('/en/');
const general = archive
  ? { title: 'Buscar una obra · ULTIMA MILLA', h1: matches.length ? '¿Qué obra buscabas?' : 'No encontramos esa obra',
      p: matches.length ? 'Elegí la ficha por cliente, fecha o referencia UM.' : 'Podés buscarla en el archivo por cliente, trabajo o referencia UM.',
      links: [['/antecedentes', 'Ver todos los antecedentes']] }
  : en
  ? { title: 'Page not found · ULTIMA MILLA', h1: 'This page does not exist', p: 'The address changed or the page was never published. You can continue from one of these sections.', links: [['/en', 'Home'], ['/en/services', 'Services'], ['/antecedentes', 'Projects (Spanish)'], ['/en/contact', 'Contact']] }
  : { title: 'Página no encontrada · ULTIMA MILLA', h1: 'Esta página no existe', p: 'La dirección cambió o la página nunca se publicó. Podés continuar desde estos accesos.', links: [['/antecedentes', 'Ver proyectos'], ['/servicios', 'Servicios'], ['/sectores', 'Sectores'], ['/contacto', 'Contacto']] };
const service = path.startsWith('/servicios/') || path.startsWith('/en/services/');
const sector = path.startsWith('/sectores/');
const article = path.startsWith('/blog/');
let t = general;
if (service) {
  t = {
    title: en ? 'Service not found · ULTIMA MILLA' : 'Servicio no encontrado · ULTIMA MILLA',
    h1: en ? 'Which service are you looking for?' : '¿Qué servicio buscabas?',
    p: en ? 'This address does not match a service. Choose one from the catalogue.' : 'Esta dirección no corresponde a una ficha. Elegí el servicio que necesitás.',
    links: NAV_SERVICES.map(item => en
      ? ['/en/services#' + directoryCardId(item.href), shellServiceCopy('en', item.code, item.name, item.text).name]
      : [item.href, item.name]),
  };
} else if (sector) {
  t = { title: 'Sector no encontrado · ULTIMA MILLA', h1: '¿Qué sector buscabas?',
    p: 'Esta dirección no corresponde a un sector. Elegí uno para ver sus sistemas y obras.',
    links: NAV_SECTORS.map(item => [item.href, item.name]) };
} else if (article) {
  t = { title: 'Nota no encontrada · ULTIMA MILLA', h1: 'No encontramos esa nota',
    p: 'Podés consultar las notas publicadas en el archivo del blog.',
    links: [['/blog', 'Ver las notas del blog']] };
}
const directory = service || sector;

---
<!doctype html>
<html lang={en ? 'en' : 'es'}>
  <head>
    <Head noindex title={t.title} description={t.p} lang={en ? 'en' : 'es'} />
    <style>
      .noexiste { padding-block: var(--s6) var(--s7, var(--s6)); min-height: 50vh; display: grid; align-content: start; gap: var(--s3); }
      .noexiste p { max-width: 52ch; color: var(--ink-2); font-size: 1.125rem; }
      .noexiste .salidas { list-style: none; margin: var(--s2) 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 12px 28px; }
      .salidas a { display: inline-flex; align-items: center; min-height: 44px; border-bottom: 2px solid var(--red); padding-bottom: 2px; font-weight: 500; }
      .noexiste .salidas.directorio { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--s4); max-width: 52rem; }
      .directorio li { border-top: 1px solid var(--line); }
      .directorio a { display: flex; justify-content: space-between; gap: 12px; min-height: 54px; padding-block: 8px; border: 0; }
      .directorio a:hover { text-decoration: underline; text-underline-offset: .22em; }
      .directorio :global(svg) { color: var(--red); flex: none; }
      @media (max-width: 560px) { .noexiste .salidas.directorio { grid-template-columns: 1fr; } }
      .obra-search { display: grid; gap: 8px; max-width: 40rem; }
      .obra-search label, .matches strong { font-weight: 600; }
      .obra-search__controls { display: flex; gap: 8px; }
      .obra-search input { min-width: 0; flex: 1; background: var(--bg-2); color: var(--ink); border: 1px solid var(--ink-3); padding: 10px 12px; font: inherit; }
      .obra-search button { min-height: 48px; }
      .matches { display: grid; padding: 0; list-style: none; max-width: 51rem; }
      .matches a { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 4px 16px; border-top: 1px solid var(--line); padding: 16px 0; color: var(--ink); }
      .matches small { grid-column: 1; color: var(--ink-2); font-size: 1rem; }
      .matches .arrow { grid-column: 2; grid-row: 1 / span 2; }
      .noexiste :is(input, button, a):focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
      @media (max-width: 420px) { .obra-search__controls { flex-direction: column; } }
    </style>
  </head>
  <body>
    <Top lang={en ? 'en' : 'es'} />
    <main id="contenido" class="wrap noexiste">
      <h1>{t.h1}{!t.h1.endsWith('?') && <span class="dot">.</span>}</h1>
      <p>{t.p}</p>
      {matches.length > 0 && <ul class="matches">{matches.map(work => {
        const title = publicCaseTitle(work);
        const date = work.year && !title.includes(String(work.year)) ? work.year : undefined;
        return <li><a href={work.href}>
          <strong>{title}</strong>
          <small>{[`UM-${work.id}`, work.client, date].filter(Boolean).join(' · ')}</small>
          <span class="arrow" aria-hidden="true">→</span>
        </a></li>;
      })}</ul>}
      {archive && <form class="obra-search" action="/antecedentes#obras-filtradas" method="get" role="search">
        <label for="obra-busqueda">Buscar en Antecedentes</label>
        <div class="obra-search__controls">
          <input type="search" id="obra-busqueda" name="q" placeholder="Cliente, trabajo o referencia UM" required />
          <button class="btn" type="submit">Buscar</button>
        </div>
      </form>}
      <ul class:list={['salidas', { directorio: directory }]}>{t.links.map(([href, label]) => (
        <li><a href={href}>{label}{directory && <ChevronRight size={16} aria-hidden="true" />}</a></li>
      ))}</ul>
    </main>
    <Cierre lang={en ? 'en' : 'es'} />
  </body>
</html>
