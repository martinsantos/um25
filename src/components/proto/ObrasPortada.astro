---
import { ArrowDown, ArrowUpRight, ChevronDown } from 'lucide-astro';
import { homeWorkLink, type Project } from './portadaCases';
import { srcsetDe } from './isoData';
import ProjectEvidence from './ProjectEvidence.astro';
interface Props {
  obras: Project[];
  title?: string;
  inset?: boolean;
  compact?: boolean;
  fold?: boolean;
  continuation?: boolean;
  home?: boolean;
  destinationLanguage?: 'es-AR';
  jump?: { label: string; href: string };
}
const { obras, title = 'Obras destacadas', inset = false, compact = false, fold = false, continuation = false, home = false, destinationLanguage,
  jump = { label:'Todos los antecedentes', href:'/antecedentes' } } = Astro.props;
const sectionId = continuation ? 'mas-obras' : 'casos';
const headingId = continuation ? 'mas-obras-titulo' : 'obras-titulo';
const JumpIcon = jump.href.startsWith('#') ? ArrowDown : ArrowUpRight;
const more = obras.length - 1;
const folded = fold && more > 0;
const projectImage = (obra: Project) => obra.contextImage || obra.image;
const ordered = continuation
  ? [...obras.filter(projectImage), ...obras.filter(obra => !projectImage(obra))]
  : obras;
const groups = folded
  ? [{ items: ordered.slice(0, 1), offset: 0 }, { items: ordered.slice(1), offset: 1 }]
  : [{ items: ordered, offset: 0 }];
---
{obras.length > 0 && <section id={sectionId} tabindex="-1" data-obras-portada class:list={['seleccion',{inset,compact,continuation,home}]} aria-labelledby={headingId}>
  <div class:list={[!inset && 'wrap']}>
    <header><h2 id={headingId}>{title}<span class="dot">.</span></h2>
      {!fold && <a href={jump.href} hreflang={destinationLanguage}>{jump.label}<JumpIcon size={16} aria-hidden="true" /></a>}</header>
    {groups.map(({ items, offset }) => {
      const Group = offset ? 'details' : 'div';
      return <Group class:list={[offset && 'resto-obras']} data-obras-plegadas={offset ? '' : undefined}>
        {offset > 0 && <summary>Ver {more === 1 ? 'otra obra' : `otras ${more} obras`} <ChevronDown size={18} aria-hidden="true" /></summary>}
        <div class:list={['obras', { 'obras--lead': fold && offset === 0 }]}>
          {items.map((obra,i) => {
            const image = projectImage(obra);
            const caseScope = obra.editorialScope;
            const evidence = obra.editorialEvidence;
            const position = i + offset;
            const destinations = obra.links.map((link, index) => ({
              label: link.label,
              ...(home ? homeWorkLink(link.href, obra.key, 'obras-inicio', index) : { href: link.href, id: undefined }),
            }));
            const kind = continuation ? (image ? 'galeria' : 'archivo') :
              position === 0 ? 'principal' : position < 3 ? 'lateral' : position < 6 ? 'media' : 'breve';
            const sizes = kind === 'galeria'
              ? '(max-width:700px) 94vw, (max-width:940px) 45vw, (max-width:1500px) 31vw, 448px'
              : fold && kind === 'principal'
              ? '(max-width:640px) 94vw, 35vw'
              : caseScope && kind === 'lateral'
              ? '(max-width:640px) 94vw, (max-width:850px) 37vw, 15vw'
              : kind === 'principal' ? '(max-width:700px) 94vw, 53vw'
              : kind === 'breve' ? '(max-width:700px) 24vw, 130px' : '(max-width:700px) 50vw, 32vw';
            return <article id={'obra-'+obra.key} data-obra={obra.key} class:list={[kind,{ilustrada:Boolean(image), directa:obra.links.length === 1, narrada:Boolean(caseScope)}]}>
              {home && destinations.map(({id}) => <span id={id} class="ancla-destino" aria-hidden="true"></span>)}
              {image && <figure><img src={image} srcset={srcsetDe(image)}
                sizes={sizes}
                width="960" height="540" loading={kind === 'principal' ? 'eager' : 'lazy'} decoding="async" alt="" /></figure>}
              <div class="detalle">
                <div class="identidad">
                  <p class="cliente">{obra.client}</p>
                  {!image && !caseScope && obra.measure && <p class="medida"><b>{obra.measure[0]}</b> {obra.measure[1]}</p>}
                  <h3>{obra.title}</h3>
                </div>
                {!caseScope && obra.fact && <p class="dato">{obra.fact}</p>}
                {(caseScope || kind === 'principal') && <p class="alcance">{caseScope || obra.scope}</p>}
                {evidence && <ProjectEvidence evidence={evidence} light={kind === 'principal'} /> }
                <div class="destinos">{destinations.map(({id, href, label}) =>
                  <a data-obra-destino={id} data-regreso-obra={sectionId + "-" + obra.key} href={href}
                    hreflang={destinationLanguage} aria-label={label+' · '+obra.title}>{label}<ArrowUpRight size={14} aria-hidden="true" /></a>
                )}</div>
              </div>
            </article>;
          })}
        </div>
      </Group>;
    })}
  </div>
</section>}
<script>
  import './regresoObraPortada';
</script>
<style>
  .seleccion { container: obras / inline-size; padding-block:clamp(26px,4vw,66px); scroll-margin-top:var(--top-h); }
  .home { scroll-margin-top:0; }
  .inset { border-top:1px solid var(--line); }
  .continuation {
    scroll-margin-top:0;
    border-top:1px solid var(--line);
  }
  header { display:flex; align-items:baseline; justify-content:space-between; gap:2px 24px; flex-wrap:wrap; margin-bottom:clamp(14px,2vw,28px); }
  h2 { font-size:clamp(1.7rem,3.2vw,3.3rem); line-height:1.04; letter-spacing:-.05em; }
  header a,.destinos a { display:inline-flex; align-items:center; gap:6px; min-height:44px; font-size:.92rem; font-weight:600; }
  a:hover { text-decoration:underline; text-underline-offset:4px; }
  a:focus-visible { outline:2px solid currentColor; outline-offset:2px; }
  .obras { display:grid; grid-template-columns:repeat(12,minmax(0,1fr)); gap:clamp(16px,2vw,30px); }
  .obras--lead .principal { grid-column:1 / -1; grid-row:auto; }
  .resto-obras { margin-top:12px; border-bottom:1px solid var(--line); }
  .resto-obras summary { display:flex; align-items:center; justify-content:space-between; gap:12px; min-height:48px; cursor:pointer; font-weight:600; list-style:none; }
  .resto-obras summary::-webkit-details-marker { display:none; }
  .resto-obras[open] summary :global(svg) { transform:rotate(180deg); }
  .resto-obras .obras { margin-block:12px 24px; }
  @container obras (min-width:641px) {
    .obras--lead .principal.ilustrada { display:grid; grid-template-columns:minmax(0,.95fr) minmax(0,1.05fr); grid-template-rows:auto; align-items:stretch; }
    .obras--lead .principal figure { position:relative; aspect-ratio:auto; min-height:0; }
    .obras--lead .principal img { position:absolute; inset:0; }
    .resto-obras .lateral { grid-column:span 6; }
  }
  article { position:relative; min-width:0; scroll-margin-top:calc(var(--top-h) + 12px); }
  .ancla-destino { position:absolute; inset-block-start:0; inset-inline-start:0; width:1px; height:1px; pointer-events:none; }
  .directa { position:relative; isolation:isolate; }
  .directa .destinos a::after { content:''; position:absolute; inset:0; z-index:1; }
  .directa .detalle p { position:relative; z-index:2; width:fit-content; }
  .directa:has(a:focus-visible) { outline:2px solid currentColor; outline-offset:3px; }
  @media (hover:hover) {
    .directa:has(a:hover) h3 { text-decoration:underline; text-decoration-thickness:1px; text-underline-offset:.13em; }
  }
  article:target, article:has(.ancla-destino:target) { outline:2px solid var(--red); outline-offset:4px; }
  figure { min-width:0; margin:0; overflow:hidden; }
  img { display:block; width:100%; height:100%; object-fit:cover; }
  .cliente,.dato { font-size:.92rem; line-height:1.4; font-weight:570; }
  .cliente {color:var(--ink-2);}
  h3 { margin:5px 0; font-size:clamp(1.2rem,1.65vw,1.8rem); line-height:1.12; letter-spacing:-.035em; text-wrap:balance; }
  .alcance { max-width:65ch; line-height:1.5; margin-top:8px; }
  .destinos { display:flex; flex-wrap:wrap; gap:0 16px; margin-top:3px; }
  .principal { grid-column:span 7; grid-row:span 2; background:#e8eae5; color:#141818; }
  .principal figure { aspect-ratio:2.65; }
  @container obras (min-width:851px) {
    .narrada.principal { display:grid; grid-template-rows:1fr auto; }
    .narrada.principal figure {
      position:relative;
      min-height:clamp(220px,20vw,340px);
      aspect-ratio:auto;
    }
    .narrada.principal img { position:absolute; inset:0; }
  }
  .principal .detalle { padding:clamp(18px,2vw,32px); }
  .principal .cliente { color:#434e49; }
  .principal h3 { font-size:clamp(1.55rem,2.55vw,2.7rem); max-width:26ch; }
  .lateral { grid-column:span 5; display:grid; grid-template-columns:minmax(0,.78fr) minmax(0,1fr); gap:18px; align-items:center; border-top:1px solid var(--line); padding-top:12px; }
  .narrada.lateral { grid-template-columns:minmax(0,.6fr) minmax(0,1fr); }
  .narrada:not(.principal) .alcance { font-size:.96rem; color:var(--ink-2); }
  .principal :global(.evidencia) { max-width:44ch; }
  .narrada .destinos { column-gap:14px; }
  .narrada .destinos a { text-decoration:underline; text-decoration-color:var(--line); text-underline-offset:4px; }
  .narrada.principal .destinos a { text-decoration-color:#9ba19d; }
  .narrada .destinos a:hover { text-decoration-color:currentColor; }
  .detalle .destinos a[data-destino-de-regreso] {
    text-decoration-line:underline; text-decoration-color:var(--red); text-decoration-thickness:2px;
    text-underline-offset:4px;
  }
  .destinos a[data-destino-de-regreso] :global(svg) { color:var(--red); }
  .lateral figure { height:100%; min-height:100px; }
  .narrada.lateral { align-items:start; }
  .narrada.lateral figure { height:auto; aspect-ratio:4/5; }
  .media { grid-column:span 4; border-top:2px solid var(--line); padding-top:12px; }
  .media figure { aspect-ratio:2; margin-bottom:13px; }
  .medida { margin:8px 0 12px; display:flex; align-items:baseline; flex-wrap:wrap; gap:4px 9px; font-size:.95rem; }
  .medida b { font-size:clamp(2.6rem,4vw,4.5rem); letter-spacing:-.06em; line-height:1; }
  .breve { grid-column:span 6; display:grid; grid-template-columns:minmax(76px,24%) 1fr; align-items:center; gap:14px; border-top:1px solid var(--line); padding-top:14px; }
  .breve figure { aspect-ratio:1.5; }
  article:not(.ilustrada) .detalle { grid-column:1/-1; }

  .galeria {
    grid-column:span 4;
    align-self:start;
    background:var(--bg-2);
    border:1px solid var(--line);
  }
  .galeria figure { aspect-ratio:1.9; }
  .galeria .detalle { padding:clamp(14px,1.7vw,24px); }
  .galeria .detalle :global(.evidencia) { margin-bottom:8px; }

  .archivo {
    grid-column:span 6;
    padding-top:14px;
    border-top:1px solid var(--line);
  }
  .archivo .identidad h3 { text-wrap:pretty; }
  .archivo .detalle :global(.evidencia) { border-top:0; margin:8px 0 2px; padding:0; }
  .archivo .detalle :global(.evidencia li) { display:flex; align-items:baseline; flex-wrap:wrap; gap:4px 8px; }

  .compact { padding-block:24px; }
  .compact h2 { font-size:clamp(1.65rem,2.3vw,2.4rem); }
  @container obras (max-width:850px) {
    .principal {grid-column:span 7;}
    .lateral,.narrada.lateral {grid-template-columns:1fr;align-content:start;gap:8px;}
    .lateral figure {height:100px;}
    .narrada.lateral figure {min-height:0; aspect-ratio:2;}
    .breve {grid-column:span 6;grid-template-columns:1fr;}
    .galeria { grid-column:span 6; }
  }
  @container obras (max-width:640px) {
    .obras {grid-template-columns:1fr;gap:20px;}
    .principal,.lateral,.media,.breve,.galeria,.archivo {grid-column:auto;grid-row:auto;}
    .galeria figure { aspect-ratio:2.1; }
    .principal figure {aspect-ratio:2;}
    .lateral,.narrada.lateral,.media,.breve {display:grid;grid-template-columns:30% minmax(0,1fr);gap:12px;align-items:start;border-top:1px solid var(--line);padding-top:14px;}
    .lateral figure,.media figure,.breve figure {height:auto;min-height:0;aspect-ratio:1;margin:0;}
    .narrada:is(.lateral,.media,.breve) .detalle { display:contents; }
    .narrada.ilustrada:is(.lateral,.media,.breve) .identidad { grid-column:2; align-self:center; }
    .narrada:not(.ilustrada) .identidad,.narrada:is(.lateral,.media,.breve) :is(.alcance,.destinos) { grid-column:1 / -1; }
    .narrada:is(.lateral,.media,.breve) :global(.evidencia) { grid-column:1 / -1; margin-top:0; }
    .narrada:is(.lateral,.media,.breve) .alcance { margin-top:0; }
    .narrada.lateral figure { grid-column:1 / -1; aspect-ratio:2.15; }
    .narrada.ilustrada.lateral .identidad { grid-column:1 / -1; }
    .narrada:is(.lateral,.media,.breve) .destinos { margin-top:-6px; }
    .medida b {font-size:2.4rem;}
  }
</style>
