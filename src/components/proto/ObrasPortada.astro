---
import { ArrowUpRight } from 'lucide-astro';
import type { portadaCases } from './portadaCases';
import PruebaProyecto from './PruebaProyecto.astro';

interface Props {
  obras: ReturnType<typeof portadaCases>;
  title?: string;
  inset?: boolean;
  jump?: { label: string; href: string };
}
const { obras, title = 'Obras seleccionadas', inset = false, jump } = Astro.props;
---
{obras.length > 0 && <section id="casos" class:list={['archivo', { inset }]} aria-labelledby="obras-titulo" data-obras-portada>
  <div class:list={[!inset && 'wrap', 'archivo-interior']}>
    <header class="archivo-top">
      <h2 id="obras-titulo">{title}<span class="dot">.</span></h2>
      {jump && <a class="salto" href={jump.href}>{jump.label} <span aria-hidden="true">↓</span></a>}
    </header>
    <nav class="indice" aria-label="Elegir una obra">{obras.map(({ pub, label, detalle, thumb }) =>
      <a id={'selector-' + pub.id} href={'#obra-' + pub.id}><img src={thumb} width="90" height="60" alt="" loading="lazy" /><span><small>{detalle.kicker.split(' · ')[0]}</small><b>{label}</b></span></a>
    )}</nav>
    {obras.map(({ pub, detalle, poster, caption, posterAlt, image, srcset }, index) => (
      <article class="obra" id={'obra-' + pub.id} data-case-id={pub.id}>
        <div class="imagen"><img src={image} srcset={srcset} sizes="(max-width:700px) 90vw, 44vw" width="960" height="600" alt="" loading={index === 0 ? 'eager' : 'lazy'} decoding="async" /></div>
        <div class="identidad">
          <p class="referencia">UM {pub.id}{pub.year > 0 && ' / ' + pub.year}</p>
          <h3><a href={pub.href}>{detalle.title}</a></h3>
          <p class="cliente">{pub.client}</p>
          {detalle.evidence.length ? <PruebaProyecto items={detalle.evidence.slice(0, 2)} compact /> : <p class="scope">{detalle.introduction}</p>}
          <a class="enlace-obra" href={pub.href}>Ver ficha de obra <ArrowUpRight size={16} aria-hidden="true" /></a>
        </div>
        {poster && <figure class="equipo"><img src={poster} width="900" height="300" loading="lazy" alt={posterAlt} /><figcaption>{caption}</figcaption></figure>}
      </article>
    ))}

  </div>
</section>}
<style>
  .archivo { --ink:#191e1f; --ink-2:#465254; --line:#bac4bf; color:var(--ink); background:#e8ece9; padding-block:clamp(20px,2.6vw,40px); scroll-margin-top:var(--top-h); container: archivo / inline-size; }
  .archivo.inset { padding-inline:clamp(16px,2.7vw,40px); margin-bottom:var(--s4); }
  .archivo-top { display:flex; align-items:baseline; justify-content:space-between; gap:8px 24px; flex-wrap:wrap; border-bottom:1px solid var(--line); padding-bottom:12px; }
  h2 { font-size:clamp(1.4rem,2.25vw,2.2rem); line-height:1.1; letter-spacing:-.04em; }
  .salto,.enlace-obra { display:inline-flex; align-items:center; gap:8px; font-weight:650; min-height:44px; }
  .obra { display:grid; grid-template-columns:minmax(0,1.42fr) minmax(0,1fr) minmax(0,.84fr); gap:clamp(16px,2.1vw,36px); align-items:center; padding-block:clamp(16px,2vw,30px); scroll-margin-top:var(--top-h); }
  .obra[hidden] { display:none; }
  .imagen img { display:block; width:100%; height:clamp(210px,19vw,310px); object-fit:cover; }
  .identidad { min-width:0; }
  .referencia,.indice small { color:var(--ink-2); font-size:.8rem; font-variant-numeric:tabular-nums; }
  h3 { margin:7px 0; font-size:clamp(1.5rem,2.25vw,2.65rem); line-height:1.06; letter-spacing:-.04em; text-wrap:balance; }
  .cliente,.scope { color:var(--ink-2); line-height:1.4; }
  .scope { margin-top:12px; }
  .identidad :global(.prueba-proyecto) { margin-top:14px; padding:0; gap:12px; border:0; }
  .identidad :global(.prueba-proyecto dd) { font-size:clamp(1.45rem,1.95vw,2rem); }
  .identidad :global(.prueba-proyecto dt) { font-size:.85rem; line-height:1.25; }
  .enlace-obra { margin-top:6px; }
  .equipo { margin:0; align-self:center; }
  .equipo img { display:block; width:100%; height:auto; }
  .equipo figcaption { border-top:1px solid var(--line); padding-top:8px; color:var(--ink-2); font-size:.85rem; }
  .indice { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,140px),1fr)); gap:0 clamp(10px,1.8vw,28px); }
  .indice a { min-width:0; border-top:2px solid var(--line); padding-block:10px; display:flex; gap:10px; align-items:center; }
  .indice a[aria-selected=true] { border-color:#bf2227; }
  .indice img { width:clamp(52px,5.6vw,85px); aspect-ratio:1.45; height:auto; object-fit:cover; }
  .indice b,.indice small { display:block; line-height:1.2; }
  .indice b { margin-top:3px; font-size:1rem; }
  .archivo a:focus-visible { outline:2px solid #a51d23; outline-offset:2px; }
  .archivo a:hover { text-decoration:underline; text-underline-offset:4px; }
  @container archivo (max-width:900px) {
    .obra { grid-template-columns:minmax(0,1fr) minmax(0,1fr); gap:12px 24px; }
    .imagen { grid-row:1 / 3; }
    .imagen img { height:auto; aspect-ratio:1.13; }
    .equipo { width:min(100%,290px); }
    .indice { grid-template-columns:repeat(2,minmax(0,1fr)); }
  }
  @container archivo (max-width:540px) {
    .obra { grid-template-columns:minmax(0,1fr); gap:14px; }
    .imagen { grid-row:auto; }
    .imagen img { aspect-ratio:2.2; }
    .equipo { width:100%; display:grid; grid-template-columns:minmax(0,1.5fr) minmax(0,1fr); gap:12px; align-items:center; }
    .equipo figcaption { border:0; padding:0; }
    .indice a { gap:7px; }
    .indice img { width:clamp(40px,10vw,60px); }
    .indice small { font-size:.73rem; }
    .indice b { font-size:.87rem; }
    .identidad :global(.prueba-proyecto) { max-width:310px; }
  }
</style>
<script>
  for (const section of document.querySelectorAll<HTMLElement>('[data-obras-portada]')) {
    const nav = section.querySelector<HTMLElement>('.indice')!;
    const tabs = Array.from(nav.querySelectorAll<HTMLAnchorElement>('a'));
    const panels = Array.from(section.querySelectorAll<HTMLElement>('.obra'));
    const select = (index: number) => {
      tabs.forEach((tab, i) => {
        const active = index === i;
        tab.setAttribute('aria-selected', String(active));
        tab.tabIndex = active ? 0 : -1;
        panels[i].hidden = !active;
      });
    };
    nav.setAttribute('role', 'tablist');
    tabs.forEach((tab, i) => {
      const panel = panels[i];
      tab.setAttribute('role', 'tab');
      tab.setAttribute('aria-controls', panel.id);
      panel.setAttribute('role', 'tabpanel');
      panel.setAttribute('aria-labelledby', tab.id);
      tab.addEventListener('click', event => {
        if (event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
        event.preventDefault();
        select(i);
      });
      tab.addEventListener('keydown', event => {
        const keys: Record<string, number> = { ArrowRight: (i + 1) % tabs.length, ArrowLeft: (i + tabs.length - 1) % tabs.length, Home: 0, End: tabs.length - 1 };
        if (!(event.key in keys)) return;
        event.preventDefault();
        select(keys[event.key]);
        tabs[keys[event.key]].focus();
      });
    });
    const fromHash = () => {
      const index = panels.findIndex(panel => '#' + panel.id === location.hash);
      if (index >= 0) select(index);
    };
    select(0);
    fromHash();
    window.addEventListener('hashchange', fromHash);
  }
</script>
