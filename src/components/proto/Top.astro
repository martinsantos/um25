---
/** Barra superior común. */
interface Props { current?: string }
const { current = '' } = Astro.props;
const items: [string, string, string][] = [['Servicios', '/propuesta/servicios', 'servicios'], ['Sectores', '/propuesta/sectores', 'sectores'], ['Antecedentes', '/propuesta/antecedentes', 'antecedentes'], ['Blog', '/blog', 'blog']];
---
<header class="top">
  <a class="logo" href="/propuesta">ultimamilla<i>.</i>com<i>.</i>ar</a>
  <nav aria-label="Principal">{items.map(([n, h, k]) => <a href={h} aria-current={k === current ? 'page' : undefined}>{n}</a>)}<a class="cta" href="#contacto">Contactar</a></nav>
</header>
