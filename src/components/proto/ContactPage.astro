---
import '../../styles/proto-despiece.css';
import Cierre from './Cierre.astro';
import Head from './Head.astro';
import Top from './Top.astro';

interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;
const t = (es: string, en: string) => lang === 'en' ? en : es;
---
<!doctype html>
<html lang={lang}>
  <head>
    <Head lang={lang} title={t('Contacto · ULTIMA MILLA','Contact our IT team in Mendoza · ULTIMA MILLA')}
      description={t('Contactá al equipo de ULTIMA MILLA en Mendoza para solicitar un relevamiento, una propuesta, soporte o documentación técnica.', 'Request an IT assessment, proposal, support agreement or technical documentation. Contact our team in Mendoza using the enquiry form in English.')} />
  </head>
  <body>
    <Top lang={lang} />
    <main id="contenido" tabindex="-1" class="wrap contacto">
      <header>
        <h1>{t('Contacto','Contact')}<span class="dot">.</span></h1>
        <p>{t('Un técnico revisa tu consulta y te orienta sobre el próximo paso.', 'A technician will review your enquiry and advise on the next step.')}</p>
      </header>
      <slot />

    </main>
    <Cierre lang={lang} withContact={false} />
  </body>
</html>
<style>
  .contacto { display:grid; grid-template-columns:minmax(0,5fr) minmax(0,7fr); grid-template-rows:auto 1fr; align-items:start; gap:28px clamp(28px,4vw,96px); padding-block:var(--s5) var(--s6); }
  h1 { font-size:clamp(2rem,4vw,3.625rem); }
  header p { margin-top:var(--s2); max-width:34ch; font-size:1.125rem; line-height:1.5; color:var(--ink-2); }
  .contacto > :global(#formulario) { grid-column:2; grid-row:1 / 3; min-width:0; }
  @media(max-width:900px) {
    .contacto { grid-template-columns:minmax(0,1fr); grid-template-rows:auto; gap:24px; padding-block-start:28px; }
    .contacto > :global(#formulario) { grid-column:auto; grid-row:auto; }
    header p { margin-top:8px; font-size:1rem; }
  }
</style>
