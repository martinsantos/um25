---
import '../../styles/proto-despiece.css';
import Cierre from './Cierre.astro';
import Head from './Head.astro';
import Top from './Top.astro';

interface Props { lang?: 'es' | 'en' }
const { lang = 'es' } = Astro.props;
const t = (es: string, en: string) => lang === 'en' ? en : es;
---
<!doctype html>
<html lang={lang}>
  <head>
    <Head lang={lang} title={t('Contacto · ULTIMA MILLA','Contact our IT team in Mendoza · ULTIMA MILLA')}
      description={t('Contanos qué tiene que seguir funcionando. Un técnico responde por email con el próximo paso: diagnóstico, relevamiento, propuesta o documentación.', 'Request an IT assessment, proposal, support agreement or technical documentation. Contact our team in Mendoza using the enquiry form in English.')} />
  </head>
  <body>
    <Top lang={lang} />
    <main id="contenido" tabindex="-1" class="wrap contacto">
      <header>
        <h1><span class="contacto__general">{t('Contanos qué tiene que seguir funcionando','Tell us what needs to keep running')}</span><span class="contacto__guided">{t('Contacto','Contact')}</span><span class="dot">.</span></h1>
        <p>{t('Un técnico lee tu consulta y te responde por email con el próximo paso.', 'A technician will review your enquiry and email you with the next step.')}</p>
      </header>
      <slot />

    </main>
    <Cierre lang={lang} withContact={false} />
  </body>
</html>
<style>
  .contacto { display:grid; grid-template-columns:minmax(0,5fr) minmax(0,7fr); grid-template-rows:auto 1fr; align-items:start; gap:28px clamp(28px,4vw,96px); padding-block:var(--s5) var(--s6); }
  h1 { max-width:16ch; font-size:clamp(2.125rem,4vw,3.625rem); }
  .contacto__guided { display:none; }
  header p { margin-top:var(--s2); max-width:40ch; font-size:1.125rem; line-height:1.5; color:var(--ink-2); }
  .contacto > :global(#formulario) { grid-column:2; grid-row:1 / 3; min-width:0; }
  @media(max-width:900px) {
    .contacto { grid-template-columns:minmax(0,1fr); grid-template-rows:auto; gap:var(--s4); }
    .contacto > :global(#formulario) { grid-column:auto; grid-row:auto; }
    .contacto:has(> #formulario[data-guided]) { padding-top:28px; gap:22px; }
    .contacto:has(> #formulario[data-guided]) h1 { font-size:1.65rem; }
    .contacto:has(> #formulario[data-guided]) .contacto__general { display:none; }
    .contacto:has(> #formulario[data-guided]) .contacto__guided { display:inline; }
    .contacto:has(> #formulario[data-guided]) header > p { margin-top:8px; font-size:1rem; }
  }
</style>
