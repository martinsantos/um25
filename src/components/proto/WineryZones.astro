---
import CatalogResultsReturn from './CatalogResultsReturn.astro';
import { contactLink } from '../../lib/contactEntry';
import { ArrowRight, ArrowUpRight, Warehouse, BellRing } from 'lucide-astro';
import gate from '../../media/bodegas/ingreso.webp?url';
import gateSmall from '../../media/bodegas/ingreso-480.webp?url';
import gateMedium from '../../media/bodegas/ingreso-720.webp?url';
import porteria from '../../media/bodegas/porteria-animada.webp?url';
import hall from '../../media/bodegas/nave.webp?url';
import hallSmall from '../../media/bodegas/nave-480.webp?url';
import hallMedium from '../../media/bodegas/nave-720.webp?url';
import { thumbOf, type Story } from './isoData';
import { samePublicClient } from './casePresentation';

import { wineryContactParams, wineryZones } from '../../data/propuesta/wineryZones';

interface Props { stories: Story[] }
const visuals = {
  ingreso: { icon: BellRing, image: gate, small: gateSmall, medium: gateMedium },
  nave: { icon: Warehouse, image: hall, small: hallSmall, medium: hallMedium },
};
const posterSizes = '(max-width:500px) calc(100vw - 40px), (max-width:800px) 92vw, (max-width:1520px) 52vw, 800px';
const zones = wineryZones.map(zone => ({ ...zone, ...visuals[zone.key], story: Astro.props.stories.find(s => s.id === zone.id && samePublicClient(s.client, zone.client)) }));
const selected = zones.find(zone => zone.key === Astro.url.searchParams.get('zona')) || zones[0]!;
---
<section class="sec winery" aria-labelledby="zone-title">
 <div class="wrap">
  <header class="zone-head" id="integracion" tabindex="-1">
   {!Astro.url.searchParams.has('sistema') && <CatalogResultsReturn />}
   <h2 id="zone-title">La bodega, zona por zona<span class="dot">.</span></h2>
   <nav aria-label="Zonas de la bodega">{zones.map(({key,label,icon:Icon}) =>
    <a data-zone={key} aria-current={key===selected.key ? 'true' : undefined} href={`?zona=${key}#integracion`}><Icon size={19} aria-hidden="true"/>{label}</a>
   )}</nav>
  </header>
  {zones.map(zone => {
   const href = '/contacto?' + wineryContactParams(zone) + '#formulario';
   return <article class="zone-panel" data-zone-panel={zone.key} hidden={zone.key!==selected.key}>
    <figure data-flow-gif={zone.key === 'ingreso' ? porteria : undefined}>
     <div class="zone-art" data-flow-art>
       <img class="scene" src={zone.image} srcset={zone.small + ' 480w, ' + zone.medium + ' 720w, ' + zone.image + ' 1080w'}
         sizes={posterSizes} alt={zone.alt} width="1080" height="720" loading="lazy" decoding="async" />
     </div>
     <figcaption aria-label="Secuencia de funcionamiento">{zone.steps.map((step,i) => <span>{i>0 && <ArrowRight size={14} aria-hidden="true"/>}{step}</span>)}</figcaption>
    </figure>
    <div class="info">
     <div class="copy"><h3>{zone.title}</h3><p>{zone.description}</p></div>
     {zone.story && <a class="work" href={zone.story.href + '?zona=' + zone.key}>
      {zone.story.image && <img src={thumbOf(zone.story.image)} alt="" width="68" height="58" loading="lazy"/>}
      <span><small>Obra relacionada · UM-{zone.id}</small><strong>{zone.work}</strong><span class="client">{zone.story.client}</span></span>
      <ArrowUpRight size={17} aria-hidden="true"/>
     </a>}
     <a class="zone-contact" href={contactLink(Astro.url.pathname, href)} data-contact-subject={`Bodegas · ${zone.label}`} data-contact-question={zone.question}>{zone.cta}<ArrowRight size={18} aria-hidden="true"/></a>
    </div>
   </article>
  })}
 </div>
</section>
<script>
 import { initFlowMotion } from './service-motion';
 initFlowMotion(document);
 const section = document.querySelector('.winery');
 if (section) {
   const links = [...section.querySelectorAll<HTMLAnchorElement>('[data-zone]')];
   const panels = [...section.querySelectorAll<HTMLElement>('[data-zone-panel]')];
   const select = (key: string | null) => {
     const active = links.find(link => link.dataset.zone === key) || links[0];
     if (!active) return;
     for (const link of links) {
       if (link === active) link.setAttribute('aria-current', 'true');
       else link.removeAttribute('aria-current');
     }
     for (const panel of panels) panel.hidden = panel.dataset.zonePanel !== active.dataset.zone;
     window.dispatchEvent(new Event('umsa:zone-selected'));
   };
   for (const link of links) link.addEventListener('click', event => {
     if (event.button || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) return;
     event.preventDefault();
     if (link.href !== location.href) history.pushState(null, '', link.href);
     select(link.dataset.zone!);
   });
   window.addEventListener('popstate', () => select(new URL(location.href).searchParams.get('zona')));
 }
</script>
<style>

 .zone-head{display:flex;align-items:end;justify-content:space-between;gap:24px;margin-bottom:22px}
 .zone-head h2{font-size:clamp(2rem,3.6vw,3.5rem);line-height:1.08}
 nav{display:flex;gap:4px;border-bottom:1px solid var(--line)}
 nav a{display:inline-flex;align-items:center;justify-content:center;gap:9px;padding:10px 15px;min-height:46px;color:var(--ink-2);font-size:1rem;font-weight:600;border-bottom:2px solid transparent}
 nav a[aria-current]{color:var(--ink);border-color:var(--red);background:var(--bg-2)}
 .zone-panel{display:grid;grid-template-columns:minmax(0,1.34fr) minmax(0,1fr);border:1px solid var(--line);background:var(--bg-2)}
 .zone-panel[hidden]{display:none}
 figure{position:relative;min-width:0;overflow:hidden;margin:0;background:#34312c}
 .zone-art{position:relative;height:100%}
 .zone-art :global(.flow-gif){position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:0}
 figure[data-flow-running] .zone-art :global(.flow-gif){opacity:1}
 .scene{display:block;width:100%;height:100%;min-height:330px;aspect-ratio:1.55;object-fit:cover}
 figcaption{position:absolute;bottom:0;left:0;right:0;display:flex;align-items:center;gap:12px;color:white;font-size:.94rem;font-weight:600;padding:48px 22px 18px;background:linear-gradient(transparent,rgba(0,0,0,.82))}
 figcaption span{display:flex;align-items:center;gap:12px}
 .info{display:flex;flex-direction:column;justify-content:center;align-items:flex-start;gap:clamp(20px,2vw,32px);padding:clamp(22px,3vw,46px)}
 .copy h3{font-size:clamp(1.65rem,2.7vw,2.8rem);line-height:1.08;max-width:16ch}
 .copy p{color:var(--ink-2);font-size:1.04rem;line-height:1.5;max-width:46ch;margin:12px 0 0}
 .work{width:100%;display:flex;align-items:center;gap:14px;border-block:1px solid var(--line);padding:16px 0}
 .work img{object-fit:cover;width:64px;height:58px;flex:none}
 .work>span{flex:1}.work small,.client{display:block;color:var(--ink-2);font-size:.875rem;line-height:1.4}
 .work strong{display:block;line-height:1.25;margin-block:4px;font-size:1rem}
 .zone-contact{display:inline-flex;align-items:center;gap:14px;min-height:44px;font-weight:600}
 .zone-contact :global(svg){color:var(--red-text)}
 .zone-contact:hover,.work:hover strong{text-decoration:underline;text-underline-offset:4px}
 .winery a:focus-visible{outline:2px solid var(--red-text);outline-offset:2px}
 @media(max-width:800px){
  .zone-head{display:grid;gap:14px;margin-bottom:0}.zone-head nav{width:100%}
  nav a{padding:10px 12px}.zone-panel{grid-template-columns:1fr}.scene{min-height:0;aspect-ratio:1.85}
  .info{padding:20px;gap:16px}.copy h3{max-width:none;font-size:1.65rem}.copy p{margin-top:8px;font-size:1rem}
  .zone-art{height:auto}
  figcaption{
   position:static; flex-wrap:wrap; gap:4px; padding:9px 10px;
   background:var(--bg-2); color:var(--ink); border-bottom:1px solid var(--line);
   font-size:.9375rem; line-height:1.4;
  }
  figcaption span{gap:4px}
  .work{padding:12px 0}.work img{width:54px;height:50px}
  .zone-contact{min-height:44px}
 }
</style>
