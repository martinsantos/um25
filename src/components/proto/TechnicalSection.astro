---
import TechnicalScene from "./TechnicalScene.astro";
import type { TechnicalContent } from "../../data/technicalScenes";
interface Props {
  content: TechnicalContent;
  project?: boolean;
}
const { content, project = false } = Astro.props;
---

<section
  class="sec technical-section"
  id="flujo"
  aria-labelledby="technical-heading"
>
  <div class="wrap">
    <div class="technical-heading">
      <div>
        <p class="technical-kicker">{content.kicker}</p><h2
          id="technical-heading"
        >
          {content.title.replace(/\.$/, "")}<span class="dot">.</span>
        </h2>
      </div>
      <p>{content.description}</p>
    </div>
    <TechnicalScene content={content} project={project} />
  </div>
</section>
<style>
  .technical-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 24px 64px;
    align-items: end;
    margin-bottom: 28px;
  }
  .technical-heading h2 {
    max-width: 23ch;
  }
  .technical-heading p {
    color: var(--ink-2);
    max-width: 48ch;
    margin: 0;
  }
  .technical-heading .technical-kicker {
    margin: 0 0 12px;
    font-size: 0.875rem;
  }
  @media (max-width: 760px) {
    .technical-heading {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 24px;
    }
    .technical-heading h2 {
      font-size: clamp(1.75rem, 7vw, 2.25rem);
    }
  }
</style>
