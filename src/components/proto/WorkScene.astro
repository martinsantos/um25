---
import ConnectionSection from './ConnectionSection.astro';
import ProcessWorkScene from './ProcessWorkScene.astro';
import CatalogScene from './CatalogScene.astro';
import SignalRoute from './SignalRoute.astro';
import panel from '../../assets/catalog-scenes/distribution.webp?url';
import termination from '../../assets/catalog-scenes/network-termination.webp?url';
import type { workScene } from '../../data/propuesta/workScenes';

interface Props { content: NonNullable<ReturnType<typeof workScene>> }
const { content } = Astro.props;
const plate = content.format !== 'equipment' ? undefined : content.asset === 'distribution' ? panel : content.asset === 'network-termination' ? termination : undefined;
---
<div class="work-example">
  {content.format === 'connection' ? <ConnectionSection content={content.connection} embedded />
    : content.format === 'process' ? <ProcessWorkScene example={content.process} />
    : content.signalRoute ? <SignalRoute content={content} route={content.signalRoute} />
    : content.points && plate ? <section aria-label={content.title}>
    <header><p>{content.kicker}</p><h3>{content.title}</h3></header>
    <figure data-functional-scene={`work-${content.kind}`} data-catalog-asset={content.asset} data-state="complete" data-phase="2">
      <div class="sheet">
        <div class="drawing" data-functional-stage>
          <img src={plate} width="1536" height="1024" loading="lazy" decoding="async" alt={content.subject}/>
          {content.points.map(([x,y], i) => <span class="pin" aria-hidden="true" style={`left:${x}%;top:${y}%`}>{i+1}</span>)}
        </div>
      </div>
      <figcaption><ol>{content.steps.map(([label, text], i) =>
        <li><span aria-hidden="true">{i+1}</span><div><strong>{label}</strong><p>{text}</p></div></li>
      )}</ol></figcaption>
    </figure>
  </section> : <CatalogScene content={content} counterView={content.counterView} embedded/>}
</div>
<script>
  import { initFunctionalScenes } from './functional-motion';
  initFunctionalScenes(document);
</script>
<style>
  .work-example { container-type:inline-size; min-width:0; }
  header, .work-example :global(.catalog-heading) { margin-bottom:16px; }
  header p { color:var(--ink-3);margin-bottom:8px; }
  h3, .work-example :global(.catalog-heading h3) { font-size:clamp(1.35rem,3.8cqi,1.85rem);line-height:1.14;text-wrap:balance; }
  figure { margin:0;display:grid;grid-template-columns:minmax(0,1.4fr) minmax(210px,1fr);background:#e9edec;color:#20282b; }
  .sheet { display:grid;align-items:center; }
  .drawing { position:relative; }
  .drawing img { display:block;width:100%;height:auto;mix-blend-mode:multiply; }
  .pin { position:absolute; transform:translate(-50%,-50%); border:2px solid #fff;box-shadow:0 0 0 1px #20282b66; }
  .pin, li > span { display:grid;place-items:center;width:24px;height:24px;border-radius:50%;background:#263033;color:#fff;font-size:.82rem;font-weight:600;line-height:1; font-variant-numeric:tabular-nums; }
  figcaption { display:grid;align-items:center;border-inline-start:1px solid #bdc7c4;padding:clamp(14px,3cqi,28px); }
  ol {display:grid;gap:14px;list-style:none;margin:0;padding:0;}
  li {display:grid;grid-template-columns:auto 1fr;gap:9px;align-items:baseline;}
  li strong {font-weight:650;} li p {font-size:.94rem;line-height:1.45;color:#414d50;margin:3px 0 0;}
  figure[data-state="running"][data-phase="0"] :is(.pin:nth-of-type(1),li:nth-child(1) > span),
  figure[data-state="running"][data-phase="1"] :is(.pin:nth-of-type(2),li:nth-child(2) > span),
  figure[data-state="running"][data-phase="2"] :is(.pin:nth-of-type(3),li:nth-child(3) > span) {background:#ab2028;box-shadow:0 0 0 4px #ab20282b;}
  @container (max-width:600px) {
    figure {grid-template-columns:minmax(0,1fr);}
    figcaption {border-inline-start:0;border-top:1px solid #bdc7c4;}
    .work-example :global(.catalog-scene__operation-head), .work-example :global(.catalog-scene__call-mark) {display:none;}
    .work-example :global(.catalog-scene__mechanism) {min-height:0;height:112px;flex:none;}
    .work-example :global(.catalog-scene__operation-foot) {height:auto;padding:12px 16px;}
  }
</style>
