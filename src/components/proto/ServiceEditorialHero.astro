---
import { ArrowUpRight } from 'lucide-astro';
import SoftwareFilmTone from '../cine/SoftwareFilmTone.astro';
import { EDITORIAL_HERO_SIZES, srcsetDe, variantes } from './isoData';
interface Props { label: string; image: string; film?: string; mobileFilm?: string; poster?: string; imageAlt?: string; naturalPhoto?: boolean; metrics?: [string, string, string?][];
  reference?: { href: string; title: string; client: string; year: number };
}
const { label, image, film, mobileFilm, poster, imageAlt = '', naturalPhoto = false, metrics = [], reference } = Astro.props;
const photo = variantes(image);
---
{film && <SoftwareFilmTone />}
<section class="service-editorial wrap" aria-label={label} data-software-film={film ? true : undefined}>
  <div class="service-editorial__copy"><slot /></div>
  <div class:list={["service-editorial__visual", { "service-editorial__visual--photo": naturalPhoto }]}>
    {film ?
      <video data-service-film={film} data-mobile-film={mobileFilm} loop poster={poster || image} muted playsinline preload="none" width="1920" height="1080" aria-label="Recorrido animado de una operación por la interfaz, la aplicación y sus servicios"></video>
     : <picture>{photo.avif && <source type="image/avif" srcset={photo.avif} sizes={EDITORIAL_HERO_SIZES} />}<img src={photo.w960} srcset={srcsetDe(image)} sizes={EDITORIAL_HERO_SIZES} alt={imageAlt} width="1672" height="941" fetchpriority="high" decoding="async" /></picture>}
    <slot name="credit" />
    {reference && <a class="editorial-reference" href={reference.href}>
      <span>Obra de referencia{reference.year > 0 && ` · ${reference.year}`}</span>
      <strong>{reference.title}</strong>
      {reference.client && <span>{reference.client}</span>}
      <ArrowUpRight size={20} aria-hidden="true" />
    </a>}
  </div>
  {metrics.length > 0 && <dl class="service-editorial__metrics">
    {metrics.map(([value, label, href]) => <div>
      <dt>{href ? <a href={href}>{label}</a> : label}</dt>
      <dd>{value}</dd>
    </div>)}
  </dl>}
</section>
<style>
  .service-editorial { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); align-items: center; gap: clamp(32px, 4vw, 72px); padding-block: clamp(40px, 7vw, 100px); }
  .service-editorial__copy :global(.editorial-actions) {
    display: flex; flex-wrap: wrap; align-items: center; gap: 6px 20px; margin-top: 8px;
  }
  .service-editorial__copy :global(.editorial-actions .btn) { min-height: 48px; }
  .service-editorial__copy :global(.editorial-actions .u) { gap: 6px; }
  .editorial-reference {
    display: grid; grid-template-columns: minmax(0, 1fr) auto;
    align-items: center; gap: 3px 14px; padding: 14px 16px;
    border-block: 1px solid var(--line); background: var(--bg-2); color: var(--ink);
    text-decoration: none;
  }
  .editorial-reference > :is(span,strong) { grid-column: 1; }
  .editorial-reference > span { color: var(--ink-2); font-size: .875rem; line-height: 1.35; }
  .editorial-reference strong { font-size: clamp(1rem, 1.4vw, 1.25rem); line-height: 1.25; }
  .editorial-reference > :global(svg) { grid-column: 2; grid-row: 1 / span 3; }
  .editorial-reference:hover strong { text-decoration: underline; text-underline-offset: 4px; }
  .editorial-reference:focus-visible { outline: 2px solid currentColor; outline-offset: -3px; }
  .service-editorial__copy { display: grid; gap: var(--s2); }
  .service-editorial__copy :global(h1) { font-size: clamp(2.8rem, 5.4vw, 5.4rem); }
  .service-editorial__copy :global(p) { color: var(--ink-2); max-width: 45ch; font-size: 1.125rem; }
  .service-editorial__copy :global(.u) { display: inline-flex; align-items: center; min-height: 44px; width: fit-content; max-width: 100%; }
  .service-editorial__copy :global(.tag) { color: var(--ink); }
  .service-editorial__visual { position: relative; min-width: 0; }
  .service-editorial__visual img, .service-editorial__visual video { width: 100%; height: auto; display: block; aspect-ratio: 16 / 9; object-fit: contain; }
  .service-editorial__visual--photo img { aspect-ratio: 3 / 2; object-fit: cover; }
  [data-software-film] .service-editorial__visual { overflow: hidden; }
  [data-software-film] video { transform: scale(1.1); }
  @media (min-width: 761px) and (max-width: 900px) {
    .service-editorial { gap: 24px; padding-block: 36px; }
    .service-editorial__copy :global(h1) { font-size: clamp(2rem, 4.3vw, 2.5rem); }
    .service-editorial__copy :global(p) { font-size: 1.0625rem; line-height: 1.55; }
  }
  @media (max-width: 760px) {
    .service-editorial { grid-template-columns: minmax(0, 1fr); gap: 22px; padding-block: 26px; }
    .service-editorial__copy { gap: 14px; }
    .service-editorial__copy :global(p) { font-size: 1.0625rem; line-height: 1.52; }
    .service-editorial__copy :global(.editorial-actions) { display: grid; justify-items: start; gap: 3px; margin-top: 2px; order: 2; }
    .service-editorial__copy :global(.editorial-actions .u) { font-size: .98rem; line-height: 1.35; }
    .service-editorial__copy :global(.editorial-actions .btn) {
      display: flex; justify-content: center; align-items: center; width: 100%;
      min-height: 50px; padding: 12px 14px; background: var(--red);
      color: #fff; border: 0; font-size: 1rem; line-height: 1.35; text-align: center;
    }
    .service-editorial__copy :global(.sector-back) { min-height: 44px; display: inline-flex; align-items: center; margin: 0; font-size: 1rem; }

    .service-editorial__visual { grid-row: 2; }
    .service-editorial__copy :global(h1) { font-size: clamp(2rem, 7.5vw, 2.6rem); line-height: 1.08; font-weight: 600; letter-spacing: -.025em; }
  }
  @media (max-width: 600px) {
    .service-editorial[data-software-film] { gap: 14px; }
    [data-software-film] .service-editorial__copy { display: contents; }
    [data-software-film] .service-editorial__visual { grid-row: auto; order: 1; aspect-ratio: 1.32; width: 100%; }
    [data-software-film] .service-editorial__visual video { position: absolute; inset: 0; width: 100%; height: 100%; aspect-ratio: auto; object-fit: cover; transform: scale(1.15); }
    [data-software-film] .service-editorial__copy :global(.editorial-actions) { order: 2; }
  }
  .service-editorial__metrics {
    grid-column: 1 / -1; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px 24px; margin: 0; padding-top: 16px; border-top: 1px solid var(--line);
  }
  .service-editorial__metrics > div { position: relative; display: flex; flex-direction: column-reverse; justify-content: end; }
  .service-editorial__metrics dt { color: var(--ink-2); font-size: 1rem; }
  .service-editorial__metrics dd { margin: 0; color: var(--ink); font-size: 1.5rem; font-weight: 600; }
  .service-editorial__metrics a { text-decoration: underline; text-underline-offset: 4px; }
  .service-editorial__metrics a::after { content: ''; position: absolute; inset: 0; }
  @media (max-width: 600px) {
    .service-editorial__metrics { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .service-editorial__metrics a:focus-visible { outline: 2px solid currentColor; outline-offset: 3px; }
</style>
<script>
  for (const video of document.querySelectorAll<HTMLVideoElement>('video[data-service-film]')) {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    let visible = false;
    const sync = () => {
      if (!visible || document.hidden || reduced.matches) { video.pause(); return; }
      if (!video.hasAttribute('src')) {
        video.src = (matchMedia('(max-width: 600px)').matches && video.dataset.mobileFilm) || video.dataset.serviceFilm!;
      }
      void video.play().catch(() => {});
    };
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(([entry]) => {
        visible = entry.isIntersecting && entry.intersectionRatio >= .25;
        sync();
      }, { threshold: [0, .25] }).observe(video);
    }
    video.addEventListener('loadeddata', () => { video.dataset.frameReady = 'true'; });
    document.addEventListener('visibilitychange', sync);
    reduced.addEventListener('change', sync);
  }
</script>
