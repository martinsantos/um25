---
interface Props { label: string; image: string; film?: string; poster?: string }
const { label, image, film, poster } = Astro.props;
---
<section class="service-editorial wrap" aria-label={label}>
  <div class="service-editorial__copy"><slot /></div>
  <div class="service-editorial__visual">
    {film ? <>
      <video data-service-film={film} poster={poster || image} muted playsinline loop preload="none" width="1920" height="1080" aria-label={`Película de ${label}`}></video>
      <button type="button" data-service-play aria-label="Reproducir película">Reproducir película</button>
    </> : <img src={image} alt="" width="1672" height="941" fetchpriority="high" decoding="async" />}
  </div>
</section>
<style>
  .service-editorial { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); align-items: center; gap: clamp(32px, 4vw, 72px); padding-block: clamp(40px, 7vw, 100px); }
  .service-editorial__copy { display: grid; gap: var(--s2); }
  .service-editorial__copy :global(h1) { font-size: clamp(2.8rem, 5.4vw, 5.4rem); }
  .service-editorial__copy :global(p) { color: var(--ink-2); max-width: 45ch; font-size: 1.125rem; }
  .service-editorial__copy :global(.tag) { color: var(--ink); }
  .service-editorial__visual { position: relative; min-width: 0; }
  .service-editorial__visual img, .service-editorial__visual video { width: 100%; height: auto; display: block; aspect-ratio: 16 / 9; object-fit: contain; }
  .service-editorial__visual button { display: block; margin-top: 16px; margin-left: auto; padding: 8px 0; border-bottom: 1px solid var(--ink-3); font-size: .9375rem; }
  @media (max-width: 900px) {
    .service-editorial { grid-template-columns: minmax(0, 1fr); gap: 32px; }
    .service-editorial__visual { grid-row: 2; }
  }
</style>
<script>
  document.querySelectorAll<HTMLVideoElement>('video[data-service-film]').forEach((video) => {
    const button = video.parentElement!.querySelector<HTMLButtonElement>('[data-service-play]')!;
    const update = () => { const label = video.paused ? 'Reproducir película' : 'Pausar película'; button.textContent = label; button.setAttribute('aria-label', label); };
    const play = () => { if (!video.getAttribute('src')) video.src = video.dataset.serviceFilm!; video.play().catch(update); };
    button.addEventListener('click', () => video.paused ? play() : video.pause());
    video.addEventListener('play', update);
    video.addEventListener('pause', update);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    if (matchMedia('(min-width: 900px)').matches && !reduced.matches) play();
    reduced.addEventListener('change', () => { if (reduced.matches) video.pause(); });
  });
</script>
