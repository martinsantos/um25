---
import SoftwareFilmTone from '../cine/SoftwareFilmTone.astro';
import { variantes } from './isoData';
interface Props { label: string; image: string; film?: string; poster?: string; imageAlt?: string; naturalPhoto?: boolean }
const { label, image, film, poster, imageAlt = '', naturalPhoto = false } = Astro.props;
const photo = variantes(image);
---
{film && <SoftwareFilmTone />}
<section class="service-editorial wrap" aria-label={label} data-software-film={film ? true : undefined}>
  <div class="service-editorial__copy"><slot /></div>
  <div class:list={["service-editorial__visual", { "service-editorial__visual--photo": naturalPhoto }]}>
    {film ? <>
      <video data-service-film={film} poster={poster || image} muted playsinline preload="none" width="1920" height="1080" aria-label={`Película de ${label}`}></video>
    </> : <picture>{photo.avif && <source type="image/avif" srcset={photo.avif} sizes="(max-width: 900px) 100vw, 55vw" />}<img src={photo.w960} srcset={photo.ancho ? [photo.w480 + " 480w", photo.w960 + " 960w", photo.full + " " + photo.ancho + "w"].join(", ") : undefined} sizes="(max-width: 900px) 100vw, 55vw" alt={imageAlt} width="1672" height="941" fetchpriority="high" decoding="async" /></picture>}
    <slot name="credit" />
  </div>
</section>
<style>
  .service-editorial { display: grid; grid-template-columns: minmax(0, 5fr) minmax(0, 6fr); align-items: center; gap: clamp(32px, 4vw, 72px); padding-block: clamp(40px, 7vw, 100px); }
  .service-editorial__copy :global(.editorial-actions) { display: contents; }
  .service-editorial__copy { display: grid; gap: var(--s2); }
  .service-editorial__copy :global(h1) { font-size: clamp(2.8rem, 5.4vw, 5.4rem); }
  .service-editorial__copy :global(p) { color: var(--ink-2); max-width: 45ch; font-size: 1.125rem; }
  .service-editorial__copy :global(.u) { width: fit-content; max-width: 100%; }
  .service-editorial__copy :global(.tag) { color: var(--ink); }
  .service-editorial__visual { position: relative; min-width: 0; }
  .service-editorial__visual img, .service-editorial__visual video { width: 100%; height: auto; display: block; aspect-ratio: 16 / 9; object-fit: contain; }
  .service-editorial__visual--photo img { aspect-ratio: 3 / 2; object-fit: cover; }
  .service-editorial__visual button { display: grid; place-items: center; margin-top: 16px; margin-left: auto; width: 44px; height: 44px; border: 1px solid var(--line); border-radius: 50%; }
  @media (max-width: 900px) {
    .service-editorial { grid-template-columns: minmax(0, 1fr); gap: 32px; padding-block: 32px; }
    .service-editorial__copy { gap: 20px; }
    .service-editorial__copy :global(p) { font-size: 1.0625rem; line-height: 1.55; }
    .service-editorial__copy :global(.editorial-actions) { display: grid; gap: 12px; order: 2; }
    .service-editorial__copy :global(.service-actions) { display: grid; gap: 12px; margin: 0; }
    .service-editorial__copy :global(.editorial-actions .u) { display: inline-flex; align-items: center; justify-content: center; justify-self: center; min-height: 44px; text-align: center; font-size: 1rem; line-height: 1.4; }
    .service-editorial__copy :global(.service-actions .btn), .service-editorial__copy :global(.editorial-primary) { display: flex; justify-content: center; align-items: center; width: 100%; min-height: 52px; padding: 14px 20px; background: var(--red); color: #fff; border: 0; font-size: 1rem; line-height: 1.4; }
    .service-editorial__copy :global(.cifras) { order: 3; margin: 4px 0 0; padding-top: 20px; gap: 16px 24px; }
    .service-editorial__copy :global(.cifras b) { font-size: 1.5rem; line-height: 1.15; }
    .service-editorial__copy :global(.sector-back) { min-height: 44px; display: inline-flex; align-items: center; margin: 0; font-size: 1rem; }

    .service-editorial__visual { grid-row: 2; }
    .service-editorial__copy :global(h1) { font-size: clamp(2rem, 7.5vw, 2.6rem); line-height: 1.08; font-weight: 600; letter-spacing: -.025em; }
  }
</style>
<script>
  document.querySelectorAll<HTMLVideoElement>('video[data-service-film]').forEach(video => {
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    if ('IntersectionObserver' in window) {
      const observer = new IntersectionObserver(entries => {
        if (!entries[0]?.isIntersecting) { video.pause(); return; }
        observer.disconnect();
        if (reduced.matches || !matchMedia('(min-width: 900px)').matches) return;
        video.src = video.dataset.serviceFilm!;
        video.play().catch(() => {});
      }, { threshold: .35 });
      observer.observe(video);
    }
    video.addEventListener('loadeddata', () => { video.dataset.frameReady = 'true'; });
    reduced.addEventListener('change', () => { if (reduced.matches) video.pause(); });
  });
</script>
