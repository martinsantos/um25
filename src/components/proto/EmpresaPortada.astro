---
import { ArrowUpRight, BookOpen, Cable, ClipboardCheck, Headset, MapPin, Ruler } from 'lucide-astro';
import DossierObraPortada from './DossierObraPortada.astro';
import FichasTecnicasPortada from './FichasTecnicasPortada.astro';
import type { Story } from './isoData';
import { EMPRESA } from './relato';

interface Props { stories: Story[] }
const { stories } = Astro.props;
const obra = stories.find(({ id }) => id === 3102);

const pasos = [
  { icono: Ruler, titulo: 'Relevar', texto: 'Entender la operación, definir el alcance y ordenar las prioridades.' },
  { icono: Cable, titulo: 'Integrar', texto: 'Diseñar y ejecutar redes, seguridad, energía y software como un sistema.' },
  { icono: ClipboardCheck, titulo: 'Verificar', texto: 'Probar la instalación y entregar documentación útil para operarla.' },
  { icono: Headset, titulo: 'Sostener', texto: 'Acompañar la operación con soporte, mantenimiento y trazabilidad.' },
];
const hitos = ['Infraestructura y telecomunicaciones', 'Seguridad y software', 'Soporte y trazabilidad', 'Integración IT en Argentina'];
---
<section class="sec empresa" id="empresa" aria-labelledby="empresa-titulo">
  <div class="wrap">
    <header class="empresa__cabecera">
      <h2 id="empresa-titulo">De la ingeniería<br />a la operación<span class="dot">.</span></h2>
      <p>Unimos diseño, obra y soporte para que cada sistema se pueda operar, auditar y ampliar.</p>
    </header>

    <ol class="metodo" aria-label="Cómo trabajamos">
      {pasos.map(({ icono: Icono, titulo, texto }, i) => <li>
        <div class="metodo__marca"><span>{String(i + 1).padStart(2, '0')}</span><Icono size={28} stroke-width={1.5} aria-hidden="true" /></div>
        <h3>{titulo}</h3>
        <p>{texto}</p>
      </li>)}
    </ol>

    <section class="documentacion" id="documentacion-de-obra" aria-labelledby="documentacion-titulo">
      <header class="documentacion__intro">
        <p class="documentacion__rotulo">Documentación de obra</p>
        <h3 id="documentacion-titulo">Lo que instalamos<br />queda documentado<span class="dot">.</span></h3>
        <p>Documentamos para el técnico que va a intervenir la obra después de nosotros.</p>
        <p>En una red, el inventario dice qué recibió. El plano y el rotulado le permiten ubicarlo. El informe de prueba deja constancia de lo que se verificó.</p>
      </header>
      <DossierObraPortada story={obra} />
      <div class="documentacion__acciones" data-documentacion-acciones hidden>
        <button class="documentacion__boton" type="button"
          data-abrir-fichas aria-haspopup="dialog" aria-controls="fichas-tecnicas-portada" hidden>
          <BookOpen size={18} aria-hidden="true" /> Fichas por servicio
        </button>
        <button class="documentacion__boton" type="button" data-contact-open
          data-contact-intent="documentacion" aria-haspopup="dialog">Solicitar un dossier</button>
      </div>
      <FichasTecnicasPortada />
    </section>

    <div class="trayectoria">
      <div class="trayectoria__cabecera"><h3>Desde 2003, en campo.</h3><a href="/nosotros">Conocé la empresa <ArrowUpRight size={18} aria-hidden="true" /></a></div>
      <ol aria-label="Trayectoria de ULTIMA MILLA">
        {EMPRESA.historia.map(([year], i) => <li><span>{year}</span><p>{hitos[i]}</p></li>)}
      </ol>
    </div>
    <div class="cobertura"><MapPin size={19} stroke-width={1.6} aria-hidden="true" /><p>{EMPRESA.cobertura}</p><a href="/contacto">Hablemos de tu proyecto <ArrowUpRight size={18} aria-hidden="true" /></a></div>
  </div>
</section>

<style>
  .empresa { --empresa-paper:#e8ebea; --empresa-ink:#191e21; --empresa-muted:#515b60; --empresa-line:#c4ccce; }
  .empresa__cabecera { display:grid; grid-template-columns:1fr 1fr; align-items:end; gap:var(--s4); margin-bottom:var(--s4); }
  .empresa__cabecera h2 { font-size:clamp(2rem,3.2vw,3rem); }
  .empresa__cabecera p { max-width:44ch; font-size:clamp(1.125rem,1.6vw,1.35rem); line-height:1.5; color:var(--ink-2); }
  .metodo { list-style:none; padding:0; margin:0 0 var(--s5); display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:var(--s4); }
  .metodo li { position:relative; padding-top:var(--s3); border-top:1px solid var(--line); }
  .metodo li::before { content:''; width:28px; height:2px; background:var(--red); position:absolute; top:-1px; left:0; }
  .metodo__marca { display:flex; align-items:center; justify-content:space-between; gap:var(--s2); color:var(--ink-2); margin-bottom:var(--s2); }
  .metodo__marca span { font-size:1rem; font-variant-numeric:tabular-nums; }
  .metodo h3 { font-size:1.35rem; margin-bottom:var(--s1); }
  .metodo p { color:var(--ink-2); font-size:1rem; line-height:1.5; max-width:30ch; }
  .empresa a { display:inline-flex; align-items:center; gap:var(--s1); min-height:44px; font-size:1rem; font-weight:600; line-height:1.35; }
  .empresa a:hover { text-decoration:underline; text-decoration-color:var(--red); text-underline-offset:4px; }
  .documentacion {
    display: grid;
    grid-template: "intro muestra" auto "acciones muestra" 1fr / minmax(0, 0.78fr) minmax(0, 1.22fr);
    gap: var(--s3) clamp(32px, 5vw, 72px);
    padding-block: var(--s4);
    border-block: 1px solid var(--line);
  }
  .documentacion__intro { grid-area: intro; }
  .documentacion__rotulo {
    display: flex;
    align-items: center;
    gap: var(--s1);
    margin-bottom: var(--s2);
    color: var(--ink-2);
    font-size: 1rem;
    font-weight: 600;
  }
  .documentacion__rotulo::before {
    content: '';
    width: 20px;
    height: 2px;
    background: var(--red);
  }
  .documentacion__intro h3 {
    font-size: clamp(2rem, 3.35vw, 2.875rem);
    font-weight: 600;
    line-height: 1.08;
    letter-spacing: normal;
    text-wrap: balance;
  }
  .documentacion__intro h3 ~ p {
    max-width: 43ch;
    margin-top: var(--s2);
    color: var(--ink-2);
    line-height: 1.6;
  }
  .documentacion__intro h3 ~ p + p { margin-top: var(--s1); }
  .documentacion__acciones {
    grid-area: acciones;
    display: flex;
    align-self: start;
    flex-wrap: wrap;
    gap: var(--s1) var(--s3);
  }
  .documentacion__boton {
    display: inline-flex;
    align-items: center;
    gap: var(--s1);
    min-height: 48px;
    border-bottom: 1px solid var(--line);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .documentacion__boton:hover { border-color: var(--red); }
  .documentacion__boton :global(svg) { flex: none; }
  .trayectoria { margin-top:var(--s4); }
  .trayectoria__cabecera { display:flex; justify-content:space-between; align-items:center; gap:var(--s3); margin-bottom:var(--s3); }
  .trayectoria__cabecera h3 { font-size:1.125rem; }
  .trayectoria ol { list-style:none; padding:0; margin:0; display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:var(--s4); }
  .trayectoria li { border-top:1px solid var(--line); padding-top:var(--s2); }
  .trayectoria li > span { font-size:1.75rem; line-height:1.2; font-variant-numeric:tabular-nums; }
  .trayectoria li p { color:var(--ink-2); font-size:1rem; line-height:1.4; margin-top:var(--s1); max-width:24ch; overflow-wrap:anywhere; }
  .cobertura { display:flex; flex-wrap:wrap; align-items:center; gap:var(--s1); padding-top:var(--s3); margin-top:var(--s4); border-top:1px solid var(--line-2); color:var(--ink-2); font-size:1rem; }
  .cobertura a { color:var(--ink); margin-left:auto; }
  .cobertura :global(svg) { flex:none; }
  @media(max-width:980px) {
    .empresa__cabecera { align-items:start; gap:var(--s3); }
    .metodo,.trayectoria ol { gap:var(--s3); }
  }
  @media (max-width: 900px) {
    .documentacion {
      grid-template: "intro" "muestra" "acciones" / minmax(0, 1fr);
      padding-block: var(--s3);
    }
  }
  @media(max-width:640px) {
    .documentacion__intro h3 { font-size: clamp(1.8rem, 8vw, 2.5rem); }
    .empresa__cabecera { grid-template-columns:1fr; gap:var(--s2); margin-bottom:var(--s3); }
    .empresa__cabecera h2 { font-size:2rem; }
    .empresa__cabecera p { font-size:1.125rem; }
    .metodo { grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--s3); margin-bottom:var(--s4); }
    .metodo li { padding-top:var(--s2); }
    .metodo__marca { margin-bottom:var(--s1); }
    .metodo h3 { font-size:1.2rem; }
    .trayectoria__cabecera { flex-wrap:wrap; gap:0 var(--s2); margin-bottom:var(--s2); }
    .trayectoria ol { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .trayectoria li > span { font-size:1.5rem; }
    .cobertura { display:grid; grid-template-columns:19px minmax(0,1fr); align-items:start; }
    .cobertura > :global(svg) { margin-top:3px; }
    .cobertura a { grid-column:2; margin-left:0; }
  }
</style>
