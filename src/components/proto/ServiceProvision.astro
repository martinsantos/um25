---
import Parte from './Parte.astro';
import WorkScene from './WorkScene.astro';
import { serviceWorkExamples, workScene } from '../../data/propuesta/workScenes';
import { samePublicClient } from './casePresentation';
import JourneyAction from './JourneyAction.astro';
import { serviceJourney } from '../../data/propuesta/recorrido';
import { groupedProvisionParts } from '../../data/propuesta/service-provision-visuals';
import type { Story } from './isoData';
import { groupServiceProvision, type ServiceProvisionItem } from '../../utils/serviceProvision';

type Item = ServiceProvisionItem & { reference?: Pick<Story, 'href' | 'title' | 'client'> };
type System = ReturnType<typeof groupServiceProvision<Item>>[number] & { integration?: boolean };
type Props = { introduction?: string; sceneGroup?:string; code:string; stories:Story[] } & ({ items: Item[] } | { systems: System[] });
const props = Astro.props;
const systems: System[] = 'systems' in props ? props.systems : groupServiceProvision(props.items).map(system => ({
  ...system,
  parts: groupedProvisionParts(system.members),
}));
const { introduction } = props;
---
<section id="provision" class="sec" data-provision aria-labelledby="provision-title">
  <div class="wrap">
    <h2 id="provision-title">Qué proveemos<span class="dot">.</span></h2>
    {introduction && <p class="intro">{introduction}</p>}
    <div class="systems">
      {systems.map((system, index) => {
        const guide = serviceJourney[props.code]?.groups[system.title];
        const label = guide?.label || system.title;
        const reference = guide?.reference;
        const story = reference && props.stories.find(s => s.id === reference.id && (samePublicClient(s.client, reference.client)
          || (s.client === reference.client && s.title === reference.title)));
        const example = serviceWorkExamples[props.code]?.[system.title];
        const scene = workScene(example, story);
        return <details id={example?.anchor} open={index === 0}>
        <summary>{label}</summary>
        {system.title === props.sceneGroup && <div class="inline-flow"><slot name="flow" /></div>}
        {system.title === 'Control de Acceso Biométrico' && <slot name="accessReader" />}
        <div class:list={['system-body', { compact: !scene && 'items' in props && system.parts.length < 3, 'with-scene': scene }]} style={`--part-count:${system.parts.length}`}>
          {scene && <div class="work-scene"><WorkScene content={scene} /></div>}
          {system.title === "Videovigilancia IP" && Astro.slots.has("cameraStages") ? <slot name="cameraStages" /> : system.parts.length > 0 && <div class="parts" aria-label={`Componentes de ${label}`}>
            {system.parts.map(part => <figure data-provision-part={part.key}>
              <Parte k={part.key} size={96} /><figcaption>{part.label}</figcaption>
            </figure>)}
          </div>}
          <div class="scope">
            {system.members.map(member => <div data-provision-item>
              {system.members.length > 1 && <h3>{member.group?.heading || member.title}</h3>}
              {member.summary && <p>{member.summary}</p>}
              {member.scopeDetail && <p><strong>{member.scopeDetail.label}</strong> · {member.scopeDetail.text}</p>}
              {member.reference && <p><strong>Trabajo documentado de cableado</strong><br />
                <a class="reference u" href={member.reference.href}>{member.reference.title} · {member.reference.client}</a>
              </p>}
            </div>)}
            {system.integration && <a class="u" href="/servicios/107#provision">Ver el servicio de incendios →</a>}
            {!scene && <JourneyAction code={props.code} group={system.title} story={example ? undefined : story} />}
          </div>
          {scene && <div class="work-evidence"><JourneyAction code={props.code} group={system.title} story={story} /></div>}
        </div>
      </details>})}
    </div>
    <slot />
  </div>
</section>
<script>
  // Some browsers leave a linked scene inside a closed disclosure on arrival.
  function revealLinkedScene() {
    const target = document.getElementById(location.hash.slice(1));
    const group = target?.closest<HTMLDetailsElement>('[data-provision] details');
    if (!target || !group) return;
    group.open = true;
    target.scrollIntoView({ block: 'start', behavior: 'instant' });
  }
  if (location.hash) requestAnimationFrame(revealLinkedScene);
  window.addEventListener('hashchange', revealLinkedScene);
  document.addEventListener('click', event => {
    const link = event.target instanceof Element && event.target.closest<HTMLAnchorElement>('a[href^="#"]');
    if (link && link.hash === location.hash && !event.defaultPrevented && !event.metaKey && !event.ctrlKey && !event.shiftKey && !event.altKey)
      requestAnimationFrame(revealLinkedScene);
  });
</script>
<style>
  .inline-flow { margin:2px 0 var(--s3); }
  .inline-flow :global(section.sec) { padding:0; border:0; scroll-margin-top:calc(var(--top-h,66px) + 12px); }
  .inline-flow :global(.wrap) { width:100%;max-width:none;padding:0; }
  #provision { scroll-margin-top:calc(var(--top-h,66px) + 12px); }
  .intro { max-width:64ch; margin-top:var(--s2); color:var(--ink-2); }
  .reference { display:inline-flex; align-items:center; min-height:44px; }
  .systems { margin-top:var(--s3); border-bottom:1px solid var(--line); }
  .systems details { border-top:1px solid var(--line); }
  summary { cursor:pointer; padding:18px 4px; font-size:1.2rem; font-weight:600; }
  summary::marker { color:var(--ink-2); font-size:.85em; }
  summary:focus-visible { outline:2px solid currentColor; outline-offset:2px; }
  .system-body { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:var(--s4); padding-bottom:var(--s3); align-items:start; }
  .parts :global(.parte) { width:clamp(76px,8vw,110px);height:auto;max-width:100%; }
  @media(min-width:721px) {
    .system-body.compact { grid-template-columns:minmax(0,calc(var(--part-count) * 148px + 32px)) minmax(0,1fr); }
  }
  .system-body .scope:only-child { grid-column:1 / -1; }
  .parts { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(110px,100%),1fr)); gap:14px; padding:16px; background:#e3e8e6; color:#20292b; }
  figure { display:grid; justify-items:center; align-content:start; margin:0; }
  figcaption { text-align:center; font-size:.95rem; line-height:1.3; }
  details[id] { scroll-margin-top:calc(var(--top-h,66px) + 12px); }
  .system-body.with-scene {
    grid-template-columns:minmax(240px,.8fr) minmax(0,1.5fr);
    grid-template-areas:"scope scene" "parts scene" "evidence scene";
    grid-template-rows:auto auto 1fr;
    gap:16px clamp(24px,4vw,56px);
  }
  .with-scene .work-scene { grid-area:scene; min-width:0; }
  .with-scene .scope { grid-area:scope; }
  .with-scene .parts { grid-area:parts; background:transparent; color:inherit; padding:0; grid-template-columns:1fr; gap:8px; }
  .with-scene figure { display:flex;gap:10px;align-items:center; }
  .with-scene figure :global(.parte) { width:40px;flex-shrink:0; }
  .with-scene figcaption { text-align:start; }
  .work-evidence { grid-area:evidence; }
  @media(max-width:900px) {
    .system-body.with-scene { grid-template-columns:minmax(0,1fr);grid-template-areas:"scope" "scene" "parts" "evidence";grid-template-rows:auto; }
    .with-scene .parts {grid-template-columns:repeat(auto-fit,minmax(min(150px,100%),1fr));}
  }
  .scope { min-width:0; display:grid; gap:16px; max-width:60ch; }
  .scope h3 { font-size:1.05rem; }
  .scope p { color:var(--ink-2); margin:4px 0 0; line-height:1.5; }
  @media(max-width:720px) { .system-body { grid-template-columns:minmax(0,1fr); gap:16px; } }
</style>
