---
import Partes from "./Partes.astro";
import FunctionalScene from "./FunctionalScene.astro";
import { caseEquipmentFor } from "./casePresentation";
import { services, type Story } from "./isoData";
interface Props {
  story: Story;
}
const { story } = Astro.props;
const { partes } = caseEquipmentFor(story);
const byCode = new Map(services.map((s) => [s.code, s.name]));
---

{
  story.id === 3082 ? (
    <FunctionalScene kind="fiber" />
  ) : (
    <div class="fiso fiso--scope fiso--functional">
      <div class="fiso__lista">
        <Partes
          items={partes.map((p) => ({
            key: p.key,
            code: p.code,
            label: (p.qty ? `${p.qty} × ` : "") + p.label,
            meta: byCode.get(p.code),
          }))}
        />
      </div>
    </div>
  )
}
<style>
  .fiso--scope {
    grid-template-columns: minmax(0, 1fr);
  }
  .fiso--functional :global(.partes) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 32px;
  }
  .fiso--functional :global(.partes li) {
    grid-template-columns: 96px minmax(0, 1fr);
    gap: 0 16px;
    min-height: 112px;
    padding-block: 12px;
  }
  .fiso--functional :global(.partes .parte) {
    width: 96px;
    height: 96px;
  }
  @media (max-width: 600px) {
    .fiso--functional :global(.partes) {
      grid-template-columns: 1fr;
    }
  }
</style>
