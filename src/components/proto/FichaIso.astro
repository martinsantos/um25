---
/**
 * Ficha isométrica de un proyecto: el banco con lo que el registro dice que se instaló
 * (cantidad incluida cuando la dice), la lista de partes, y debajo el lugar por dentro con los
 * recorridos de sus servicios encendidos. Cuando el registro no nombra equipos, se muestran
 * las partes del alcance publicado del servicio, con la leyenda que lo aclara.
 */
import Parte from './Parte.astro';
import Banco from './Banco.astro';
import { despieceDe } from './despiece';
import { services, SITE_OF, type Story } from './isoData';
interface Props { story: Story }
const { story: c } = Astro.props;
const site = SITE_OF[c.sectorSlug] || 'building';
const { partes, origen } = despieceDe(c.title, c.summary, c.serviceCodes);
const byCode = new Map(services.map((s) => [s.code, s.name]));
const codes = [...new Set([...c.serviceCodes, ...partes.map((p) => p.code)])];
const nombre = partes.map((p) => (p.qty ? `${p.qty} × ` : '') + p.label).join(', ');
---
<div class="fiso" data-fiso>
  <div class="despiece">
    <Banco items={partes.map((p) => ({ key: p.key, qty: p.qty }))} label={nombre} />
    <ol class="partes-lista" data-partes>
      {partes.map((p) => <li data-code={p.code}><Parte k={p.key} size={48} /><span><b>{p.qty ? `${p.qty} × ` : ''}{p.label}</b><span class="small">{byCode.get(p.code)}</span></span></li>)}
    </ol>
    <p class="despiece__nota small">{origen === 'registro' ? 'Equipamiento nombrado en el registro del proyecto.' : `Alcance del servicio ${partes.map((p) => byCode.get(p.code)).filter((v, i, a) => v && a.indexOf(v) === i).join(' y ')}; el registro no detalla equipos.`}</p>
  </div>
  <div class="fiso__lugar iso" data-svcs={codes.join(' ')} data-src={`/cine/iso/site-${site}-v2.svg`}><span class="ahora">{codes.map((k) => byCode.get(k)).filter(Boolean).join(' · ')}</span></div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-fiso]').forEach((root) => {
    const lugar = root.querySelector<HTMLElement>('.fiso__lugar')!;
    const items = [...root.querySelectorAll<HTMLElement>('[data-partes] li')];
    const fit = (svg: SVGSVGElement) => { try { const b = svg.getBBox(); const pad = Math.max(b.width, b.height) * .05; svg.setAttribute('viewBox', `${b.x - pad} ${b.y - pad} ${b.width + pad * 2} ${b.height + pad * 2}`); svg.setAttribute('preserveAspectRatio', 'xMidYMid meet'); } catch { /* sin bbox */ } };
    new IntersectionObserver(([e], io) => {
      if (!e.isIntersecting) return; io.disconnect();
      fetch(lugar.dataset.src!).then((r) => (r.ok ? r.text() : '')).then((markup) => { if (!markup) return; lugar.insertAdjacentHTML('afterbegin', markup); const svg = lugar.querySelector<SVGSVGElement>('svg'); if (svg) fit(svg); requestAnimationFrame(() => root.classList.add('on')); });
    }, { rootMargin: '600px 0px' }).observe(lugar);
    items.forEach((li) => {
      const on = () => { items.forEach((o) => o.classList.toggle('on', o === li)); lugar.dataset.svc = li.dataset.code; };
      li.addEventListener('pointerenter', on); li.addEventListener('focusin', on);
    });
    root.addEventListener('pointerleave', () => { items.forEach((o) => o.classList.remove('on')); delete lugar.dataset.svc; });
  });
</script>
