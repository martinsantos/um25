---
import { ChevronDown, Network, Cctv, RadioTower, CodeXml, Headset, Workflow, Flame, Zap } from 'lucide-astro';
import ServiceScene from './ServiceScene.astro';
import { sectorIntegrationScope } from '../../data/propuesta/sector-integration';
interface Props { slug:string; name:string; items: {code:string;name:string;text:string;count:number}[] }
const {items,slug,name}=Astro.props;
const intros:Record<string,[string,string]>={
 bodegas:['Tecnología entre producción y administración','La misma operación, de la cava al despacho.'],
 industria:['Infraestructura para la planta','Cada sistema, al ritmo de la producción.'],
 mineria:['Comunicaciones en terreno','Conectar sitios. Sostener la operación.'],
 salud:['Infraestructura para el establecimiento','Sistemas que acompañan la atención.'],
 aeropuertos:['Tecnología para la terminal','Cada área conectada con la operación.'],
 gobiernosectorpublico:['Infraestructura entre sedes','Servicios conectados, de una sede a otra.'],
 constructoras:['Infraestructura desde la obra','Un edificio. Sistemas que trabajan juntos.'],
};
const icons:Record<string,typeof Network>={'101':Network,'102':Cctv,'103':RadioTower,'104':CodeXml,'105':Headset,'106':Workflow,'107':Flame,'108':Zap};
const intro=intros[slug] || ['Integración por sistema',`Tecnología para ${name.toLowerCase()}.`];
---
<section class="sec sector-systems" id={slug === 'bodegas' ? 'sistemas' : 'integracion'}>
 <div class="wrap">
  <header><p class="eyebrow">{intro[0]}</p><h2>{intro[1].replace(/\.$/,'')}<span class="dot">.</span></h2><p>Explorá cada sistema: qué conecta, cómo funciona y dónde lo implementamos.</p></header>
  <div class="systems">
  {items.map((item,i)=>{ const Icon=icons[item.code] || Network; return <details name={`sector-system-${slug}`} open={i===0}>
    <summary><span class="system-name"><Icon size={22} stroke-width={1.6} aria-hidden="true"/>{item.name}</span><ChevronDown size={20} aria-hidden="true"/></summary>
    <div class="system-body"><div class="system-copy"><h3>{item.name}</h3><p>{sectorIntegrationScope(slug,item.code,item.text)}</p><a href={`/servicios/${item.code}#provision`}>Qué proveemos →</a>{item.count>0&&<a href={`/antecedentes?sector=${slug}&service=${item.code}`}>{item.count} antecedentes en {name.toLowerCase()} →</a>}</div>
    <div class="system-scene"><ServiceScene code={item.code}/></div></div>
  </details>})}
  </div>
 </div>
</section>
<style>
.system-name{display:flex;align-items:center;gap:14px}.system-name :global(svg){flex:none}header{max-width:880px;margin-bottom:32px}header h2{max-width:22ch}header p{margin-top:16px;color:var(--ink-2)}.eyebrow{font-size:.875rem;letter-spacing:.06em}.systems{border-top:1px solid var(--line)}details{scroll-margin-top:calc(var(--top-h,66px) + 16px);border-bottom:1px solid var(--line)}summary{display:flex;justify-content:space-between;align-items:center;cursor:pointer;list-style:none;min-height:68px;font-size:1.25rem;font-weight:600;padding:16px 4px}summary::-webkit-details-marker{display:none}summary:focus-visible{outline:2px solid var(--red);outline-offset:4px}details[open] summary{color:var(--red-text)}details[open] summary > :global(svg){transform:rotate(180deg)}.system-body{display:grid;grid-template-columns:minmax(220px,.7fr) minmax(0,2fr);gap:36px;padding:12px 0 32px}.system-copy{display:flex;flex-direction:column;align-items:flex-start;gap:20px;padding-top:12px}.system-copy h3{font-size:1.5rem}.system-copy p{color:var(--ink-2);line-height:1.65}.system-copy a{font-size:1rem;min-height:44px;display:flex;align-items:center;text-decoration:underline;text-underline-offset:5px}.system-scene{min-width:0}.system-scene :global(.fs__steps){padding-inline:18px}.system-scene>p{color:var(--ink-2);padding:32px;background:var(--bg-2)}@media(max-width:900px){.system-body{grid-template-columns:1fr;gap:20px}.system-copy h3{display:none}.system-copy{gap:12px;padding:0}.system-scene :global(.fs__steps){padding-inline:0}summary{font-size:1.125rem}}
</style>

<script>
  document.querySelectorAll<HTMLDetailsElement>('.sector-systems details').forEach(detail => {
    detail.addEventListener('toggle', () => {
      if (!detail.open) return;
      requestAnimationFrame(() => {
        const header = document.querySelector('body > header')?.getBoundingClientRect().bottom || 80;
        if (detail.getBoundingClientRect().top < header) detail.scrollIntoView({block:'start', behavior:'instant'});
      });
    });
  });
</script>
