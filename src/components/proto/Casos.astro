---
/** Casos con el alcance real de cada obra: foto, qué se hizo, para quién y cuándo, el alcance del registro y los servicios. */
import type { Caso } from './relato';
import { services, SECTOR_PHOTO, SERVICE_PHOTO, type Story } from './isoData';
interface Props { casos: Caso[]; stories: Story[]; title?: string; max?: number; fallbackImage?: string }
const { casos, stories, title, max = 4, fallbackImage } = Astro.props;
const byCode = new Map(services.map((s) => [s.code, s]));
const items = casos.slice(0, max).map((c) => {
  const pub = c.publicado ? stories.find((s) => s.id === c.publicado) : undefined;
  const image = pub?.image && pub.image.startsWith('/images/antecedentes/') ? pub.image : (fallbackImage || SECTOR_PHOTO[c.sector] || SERVICE_PHOTO[c.servicios[0]] || SECTOR_PHOTO.constructoras);
  return { ...c, href: pub ? pub.href : (c.sector ? `/propuesta/antecedentes?sector=${c.sector}` : '/propuesta/antecedentes'), image, serviceNames: c.servicios.map((code) => byCode.get(code)?.name).filter(Boolean) as string[] };
});
---
{items.length > 0 && (
  <section class="band" id="casos">
    {title && <h2>{title}<span class="dot">.</span></h2>}
    <div class="casos">
      {items.map((c) => (
        <article class="caso">
          <figure><img src={c.image} alt="" width="1200" height="750" loading="lazy" decoding="async" /></figure>
          <div class="caso__copy">
            <h3><a href={c.href}>{c.titulo}</a></h3>
            <span class="cliente">{c.cliente}{c.year > 0 && <span class="anio"> · {c.year}</span>}</span>
            <p>{c.texto}</p>
            {c.serviceNames.length > 0 && <div class="svc">{c.serviceNames.map((n) => <span>{n}</span>)}</div>}
          </div>
        </article>
      ))}
    </div>
  </section>
)}
