---
import { ArrowRight, ArrowUpRight, Cctv, ChevronRight, CodeXml, FileText, Flame, Headset, Network, RadioTower, ScanSearch, Workflow, Zap } from 'lucide-astro';
import { NAV_SERVICES } from '../../data/navigation';
import serviceMotion from '../../data/serviceMotion.json';
import { destacados, type Story } from './isoData';
import { pageCaseCandidates } from './caseSelection';
import { publicCaseFor } from './casePresentation';
import { KIT_DE_SERVICIO } from './despiece';
import { ISOMETRIC_STUDIES } from '../../data/cine/isometric';
import { tituloProyecto } from './titulos';
import Parte from './Parte.astro';

interface Props { stories: Story[] }
const { stories } = Astro.props;
const detalles = import.meta.glob<string>('../../assets/cine/isometric/*-detail.svg', { eager:true, query:'?url', import:'default' });
// Para los servicios profesionales, la referencia visual es la misma del menú.
const visuales: Record<string, { icono: typeof Network; corto: string; leyenda: string; encuadre?: string; editorial?: boolean }> = {
  '101': { icono: Network, corto: 'Redes', leyenda: 'Switch de acceso', encuadre: '65,100,850,570' },
  '102': { icono: Cctv, corto: 'Seguridad', leyenda: 'Cámara IP de exterior', encuadre: '251,10,478,462' },
  '103': { icono: RadioTower, corto: 'Telecom', leyenda: 'Antena de radioenlace', encuadre: '280,-38,427,463' },
  '104': { icono: CodeXml, corto: 'Software', leyenda: 'Desarrollo de aplicaciones', editorial: true },
  '105': { icono: Headset, corto: 'Soporte', leyenda: 'Soporte técnico', editorial: true },
  '106': { icono: Workflow, corto: 'Consultoría', leyenda: 'Comunidad de software en Rosario', editorial: true },
  '107': { icono: Flame, corto: 'Incendios', leyenda: 'Central de detección', encuadre: '309,-22,390,565' },
  '108': { icono: Zap, corto: 'Energía', leyenda: 'UPS de rack', encuadre: '-25,-14,1028,747' },
};
const frentes = NAV_SERVICES.map((servicio) => {
  const propios = stories.filter((obra) => obra.serviceCodes.includes(servicio.code));
  const candidatos = pageCaseCandidates(propios, undefined, servicio.code);
  const obra = candidatos.find((c) => publicCaseFor(c)) ?? destacados(candidatos, 1)[0];
  const estudio = ISOMETRIC_STUDIES[servicio.code];
  const animacion = serviceMotion[servicio.code as keyof typeof serviceMotion];
  return { ...servicio, visual: visuales[servicio.code]!, kit: (KIT_DE_SERVICIO[servicio.code] ?? []).slice(0, 3),
    detalle: estudio && detalles[`../../assets/cine/isometric/${estudio.asset}-detail.svg`],
    detalleNombre: estudio?.views.at(-1)?.label,
    animacion, total: propios.length, obra, tituloObra: obra && (publicCaseFor(obra)?.title || tituloProyecto(obra.title, obra.client, obra.summary) || obra.title) };
});
---
<div class="explorador" data-service-motion>
  <header class="encabezado">
    <h2 id="explorador-titulo">Ocho frentes de servicio<span class="dot">.</span></h2>
    <a class="catalogo" href="/servicios">Catálogo de servicios <ArrowUpRight size={18} aria-hidden="true" /></a>
  </header>
  <fieldset>
    <legend class="lector">Elegí un servicio para ver su alcance y sus antecedentes</legend>
    <div class="mesa">
      {frentes.map(({ code, name, text, href, visual, kit, total, obra, tituloObra, detalle, detalleNombre, animacion }, i) => {
        const Icono = visual.icono;
        return <>
          <input class="selector" id={`frente-${code}`} type="radio" name="frente-portada" checked={i === 0} aria-controls={`panel-${code}`} />
          <label class="fila" for={`frente-${code}`} style={`--fila:${i + 1};--fila-m:${Math.floor(i / 2) + 1};--col-m:${i % 2 + 1}`}>
            <Icono class="icono" size={24} stroke-width={1.65} aria-hidden="true" />
            <span class="nombre">{name}</span><span class="corto" aria-hidden="true">{visual.corto}</span>
            <span class="marca" aria-hidden="true"><ChevronRight size={17} /></span>
          </label>
          <article class="panel" id={`panel-${code}`} aria-labelledby={`nombre-${code}`}>
            <div class="lamina">
              <div class="alcance">
                <span class="codigo">Servicio {code}</span>
                <h3 id={`nombre-${code}`}>{name}</h3>
                <p>{text}</p>
                <a class="provision" href={`${href}#provision`}>Qué proveemos <ArrowRight size={17} aria-hidden="true" /></a>
              </div>
              <figure class="dibujo movimiento" data-motion-figure>
                {detalle && !visual.editorial && <>
                  <input class="detalle-control" id={`detalle-${code}`} type="checkbox" aria-label={`Ver detalle de ${visual.leyenda.toLowerCase()}`} />
                  <label class="ampliar" for={`detalle-${code}`}><ScanSearch size={16} aria-hidden="true" /> Detalle</label>
                  <img class="ampliacion" src={detalle} width="420" height="270" loading="lazy" decoding="async" alt="" />
                </>}
                <img class="equipo" src={animacion.poster} width="512" height="320" loading="lazy" decoding="async" alt="" />
                <video class="movimiento-video" data-src={animacion.motion} width="512" height="320" preload="none" muted playsinline disablepictureinpicture disableremoteplayback aria-hidden="true" tabindex="-1"></video>
                <figcaption><span>{animacion.title}</span>{detalleNombre && <b> · {detalleNombre}</b>}</figcaption>
              </figure>
            </div>
            <ul class="piezas" aria-label={`Ejemplos de provisión de ${name}`}>
              {kit.map(([key, label]) => <li><Parte k={key} size={40} /><span>{label}</span></li>)}
            </ul>
            <div class="evidencia">
              {obra && <a class="referencia" href={obra.href}>
                <FileText size={19} stroke-width={1.6} aria-hidden="true" />
                <span><small>Proyecto de referencia{obra.year > 0 && ` · ${obra.year}`}</small>
                  <strong>{tituloObra}</strong>{obra.client && !tituloObra?.toLocaleLowerCase('es').includes(obra.client.toLocaleLowerCase('es')) && <span class="cliente">{obra.client}</span>}</span>
                <ArrowUpRight size={18} aria-hidden="true" />
              </a>}
              {total > 0 && <a class="archivo" href={`/antecedentes?servicio=${code}`}>{total} {total === 1 ? 'antecedente' : 'antecedentes'} <ArrowRight size={16} aria-hidden="true" /></a>}
            </div>
          </article>
        </>;
      })}
    </div>
  </fieldset>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-service-motion]');
  if (root) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const panels = [...root.querySelectorAll<HTMLElement>('.panel')];
    const figures = panels.map(panel => panel.querySelector<HTMLElement>('[data-motion-figure]')!);
    const visible = new Set<HTMLElement>();
    const pending = new Set<HTMLElement>();
    let epoch = 0;
    let activeVideo: HTMLVideoElement | null = null;
    const selected = (figure: HTMLElement) => figure.closest('.panel')?.previousElementSibling?.previousElementSibling instanceof HTMLInputElement
      && (figure.closest('.panel')!.previousElementSibling!.previousElementSibling as HTMLInputElement).checked;
    const stop = () => {
      epoch++;
      activeVideo?.pause();
      activeVideo = null;
      figures.forEach(figure => figure.removeAttribute('data-moving'));
    };
    const start = async (figure: HTMLElement) => {
      if (!pending.has(figure) || !visible.has(figure) || !selected(figure) || reduced.matches || document.hidden
        || figure.querySelector<HTMLInputElement>('.detalle-control')?.checked) return;
      stop();
      pending.delete(figure);
      const video = figure.querySelector<HTMLVideoElement>('video')!;
      const token = epoch;
      activeVideo = video;
      // Only the active, visible service downloads motion. The static image is always usable.
      if (!video.hasAttribute('src')) video.src = video.dataset.src!;
      video.muted = true;
      video.currentTime = 0;
      try {
        await video.play();
        if (epoch === token && !document.hidden && visible.has(figure) && selected(figure) && !reduced.matches) {
          figure.setAttribute('data-moving', '');
        } else if (activeVideo !== video) video.pause();
      } catch {
        if (epoch === token) stop();
      }
    };
    const observer = new IntersectionObserver(entries => {
      for (const entry of entries) {
        const figure = entry.target as HTMLElement;
        if (entry.isIntersecting && entry.intersectionRatio >= .5) {
          visible.add(figure);
          void start(figure);
        } else {
          visible.delete(figure);
          if (activeVideo === figure.querySelector('video')) stop();
        }
      }
    }, { threshold: [0, .5] });
    figures.forEach(figure => {
      observer.observe(figure);
      if (selected(figure)) pending.add(figure);
      figure.querySelector('video')!.addEventListener('ended', () => {
        if (activeVideo === figure.querySelector('video')) stop();
      });
      figure.querySelector('video')!.addEventListener('error', () => {
        if (activeVideo === figure.querySelector('video')) stop();
      });
    });
    root.addEventListener('change', event => {
      const control = event.target;
      if (!(control instanceof HTMLInputElement)) return;
      if (control.matches('.selector')) {
        stop();
        pending.clear();
        const figure = root.querySelector<HTMLElement>(`#${control.getAttribute('aria-controls')} [data-motion-figure]`);
        if (figure) { pending.add(figure); void start(figure); }
      } else if (control.matches('.detalle-control')) stop();
    });
    document.addEventListener('visibilitychange', () => { if (document.hidden) { pending.clear(); stop(); } });
    reduced.addEventListener('change', () => { if (reduced.matches) { pending.clear(); stop(); } });
    window.addEventListener('pagehide', () => { pending.clear(); stop(); observer.disconnect(); }, { once: true });
  }
</script>

<style>
  .encabezado { display:flex; align-items:end; justify-content:space-between; gap:20px; margin-bottom:24px; }
  .encabezado h2 { max-width:24ch; }
  .catalogo,.provision,.archivo { display:inline-flex; align-items:center; gap:8px; width:fit-content; min-height:44px; font-weight:600; font-size:1rem; }
  .catalogo:hover,.provision:hover,.archivo:hover,.referencia:hover strong { text-decoration:underline; text-decoration-color:var(--red-text); text-underline-offset:4px; }
  fieldset { min-width:0; padding:0; margin:0; border:0; }
  .mesa { position:relative; display:grid; grid-template-columns:minmax(230px, .88fr) minmax(0, 2.32fr); border-block:1px solid var(--line); }
  .lector,.selector,.detalle-control { position:absolute; inline-size:1px; block-size:1px; padding:0; margin:0; overflow:hidden; clip-path:inset(50%); white-space:nowrap; }
  .fila { grid-column:1; grid-row:var(--fila); display:grid; grid-template-columns:26px minmax(0,1fr) 18px; align-items:center; gap:12px; min-height:55px; padding:8px 18px; border-bottom:1px solid var(--line-2); color:var(--ink-2); cursor:pointer; font-weight:550; line-height:1.15; }
  .icono { color:var(--ink-2); }
  .marca { display:grid; color:var(--ink-3); opacity:.55; }
  .corto { display:none; }
  .fila:hover { background:var(--bg-2); color:var(--ink); }
  .selector:checked + .fila { box-shadow:inset 3px 0 var(--red); background:#1b1d20; color:var(--ink); }
  .selector:checked + .fila :is(.icono,.marca) { color:var(--red-text); opacity:1; }
  .selector:focus-visible + .fila { outline:2px solid var(--ink); outline-offset:-3px; }
  .panel { display:none; grid-column:2; grid-row:1 / span 8; align-content:stretch; grid-template-rows:minmax(220px,1fr) auto auto; min-width:0; border-left:1px solid var(--line); background:var(--bg-2); }
  .selector:checked + .fila + .panel { display:grid; }
  .lamina { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.15fr); }
  .alcance { align-self:center; display:grid; justify-items:start; gap:12px; padding:24px clamp(18px,2.3vw,36px); }
  .codigo { display:flex; align-items:center; gap:9px; font-size:.9rem; font-variant-numeric:tabular-nums; color:var(--ink-2); }
  .codigo::before { content:''; width:20px; height:2px; background:var(--red); }
  .alcance h3 { font-size:clamp(1.65rem,2.5vw,2.6rem); line-height:1.04; }
  .alcance p { color:var(--ink-2); line-height:1.45; max-width:36ch; }
  .provision { color:var(--ink); }
  .provision :global(svg),.archivo :global(svg) { color:var(--red-text); }
  .dibujo { position:relative; isolation:isolate; display:grid; align-items:center; min-width:0; min-height:245px; margin:0; overflow:hidden; background-color:#c7cdce; background-image:radial-gradient(circle, #9ca5a7 .8px, transparent 1px); background-size:16px 16px; }
  .dibujo img { position:absolute; inset:3% 1% 11%; width:98%; height:86%; object-fit:contain; }
  .dibujo::after { content:''; position:absolute; inset:12px; background:linear-gradient(var(--ink-3),var(--ink-3)) left top/10px 1px, linear-gradient(var(--ink-3),var(--ink-3)) left top/1px 10px, linear-gradient(var(--ink-3),var(--ink-3)) right bottom/10px 1px, linear-gradient(var(--ink-3),var(--ink-3)) right bottom/1px 10px; background-repeat:no-repeat; pointer-events:none; }
  figcaption { position:absolute; bottom:13px; left:16px; max-width:calc(100% - 32px); background:#c7cdce; color:#242a2c; padding:2px 6px; font-size:.95rem; line-height:1.2; }
  .editorial figcaption { background:var(--bg-2); color:var(--ink); }
  .ampliar { position:absolute; z-index:1; right:10px; top:5px; display:inline-flex; align-items:center; gap:6px; min-height:44px; padding:4px 10px; color:#242a2c; cursor:pointer; font-size:.95rem; }
  .ampliar:hover,.detalle-control:checked ~ .ampliar { text-decoration:underline; text-decoration-color:var(--red); text-underline-offset:4px; }
  .detalle-control:focus-visible + .ampliar { outline:2px solid #242a2c; }
  .ampliacion,figcaption b { display:none; }
  .detalle-control:checked ~ .ampliacion { display:block; }
  .detalle-control:checked ~ .equipo { display:none; }
  .detalle-control:checked ~ figcaption b { display:inline; }
  .editorial img { inset:0; width:100%; height:100%; object-fit:cover; }
  .movimiento { background:#e6e6e1; }
  .movimiento .equipo,.movimiento-video { position:absolute; inset:0 0 10%; width:100%; height:90%; object-fit:contain; }
  .movimiento-video { opacity:0; pointer-events:none; }
  .movimiento[data-moving] .movimiento-video { opacity:1; }
  .movimiento figcaption { background:#e6e6e1; }
  .detalle-control:checked ~ .movimiento-video { display:none; }
  @media(prefers-reduced-motion:reduce) { .movimiento-video { display:none; } }
  .piezas { display:grid; grid-template-columns:repeat(auto-fit,minmax(0,1fr)); margin:0; padding:0 16px; list-style:none; border-block:1px solid var(--line); }
  .piezas li { display:flex; align-items:center; gap:6px; padding:10px 8px; font-size:1rem; line-height:1.25; }
  .piezas :global(svg) { flex:0 0 40px; }
  .evidencia { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:14px clamp(18px,2.3vw,36px); background:var(--bg); }
  .referencia { display:flex; align-items:center; gap:12px; min-width:0; min-height:44px; }
  .referencia > :global(svg) { flex:none; color:var(--ink-2); }
  .referencia small,.cliente { display:block; color:var(--ink-2); font-size:.95rem; line-height:1.35; }
  .referencia strong { display:block; font-size:1.03rem; line-height:1.25; margin:3px 0; }
  .archivo { flex:none; color:var(--ink-2); }
  @media(max-width:980px) {
    .encabezado { flex-wrap:wrap; gap:4px 14px; margin-bottom:12px; }
    .mesa { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .fila { grid-row:var(--fila-m); grid-column:var(--col-m); min-height:48px; padding:8px 12px; gap:7px; grid-template-columns:22px minmax(0,1fr) 12px; font-size:1rem; }
    .fila .icono { width:20px; }
    .marca { transform:rotate(90deg); }
    .corto { display:block; }
    .nombre { position:absolute; clip-path:inset(50%); width:1px; height:1px; overflow:hidden; }
    .panel { grid-column:1/-1; grid-row:5; grid-template-rows:auto auto auto; border-left:0; }
    .alcance { padding:16px; gap:6px; }
    .lamina { grid-template-columns:minmax(0,1.05fr) minmax(0,1fr); }
    .dibujo { min-height:180px; }
    .editorial img { inset:0; height:100%; }
    figcaption { left:6px; bottom:7px; max-width:calc(100% - 12px); font-size:.85rem; line-height:1.2; }
    .dibujo::after { inset:7px; }
    .alcance h3 { font-size:1.5rem; }
    .alcance p { font-size:1rem; }
    .piezas { display:flex; flex-wrap:wrap; padding:0 4px; }
    .piezas li { flex:1 1 90px; flex-direction:column; align-items:start; gap:2px; padding:8px; }
    .piezas :global(svg) { width:34px; height:34px; flex:none; }
    .evidencia { flex-wrap:wrap; gap:2px 16px; padding:12px 16px; }
  }
  @media(max-width:560px) {
    .lamina { grid-template-columns:minmax(0,1fr); }
    .alcance { grid-template-columns:minmax(0,1fr) auto; column-gap:12px; }
    .alcance .codigo,.alcance h3 { grid-column:1/-1; }
    .alcance p { grid-column:1; }
    .alcance .provision { grid-column:2; align-self:center; font-size:.95rem; }
    .dibujo { grid-row:1; min-height:155px; }
    .dibujo .equipo,.dibujo .ampliacion { inset:0 4% 10%; width:92%; height:90%; }
    .dibujo.movimiento .equipo,.dibujo .movimiento-video { inset:0 0 10%; width:100%; height:90%; }
    .editorial .equipo { inset:0; width:100%; height:100%; object-position:center 45%; }
  }
  @media(max-width:380px) {
    .fila { padding-inline:6px; }
    .alcance { padding:12px; }
    .piezas li { padding:6px; }
  }
  @media(min-width:360px) and (max-width:980px) {
    .mesa { grid-template-columns:repeat(4,minmax(0,1fr)); }
    .panel { grid-row:3; }
    .fila { grid-column:auto; grid-row:auto; display:flex; flex-direction:column; justify-content:center; gap:4px; min-height:60px; padding:6px 2px; text-align:center; }
    .fila .marca { display:none; }
    .selector:checked + .fila { box-shadow:inset 0 -2px var(--red); }
  }
</style>
