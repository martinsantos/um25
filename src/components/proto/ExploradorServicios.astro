---
import { ArrowRight, ArrowUpRight, Cctv, ChevronRight, CodeXml, FileText, Flame, Headset, Network, RadioTower, ScanSearch, Workflow, Zap } from 'lucide-astro';
import { NAV_SERVICES } from '../../data/navigation';
import { SERVICE_MOTION } from '../../data/serviceMotion';
import { destacados, type Story } from './isoData';
import { pageCaseCandidates } from './caseSelection';
import { publicCaseFor } from './casePresentation';
import { KIT_DE_SERVICIO } from './despiece';
import { ISOMETRIC_STUDIES } from '../../data/cine/isometric';
import { tituloProyecto } from './titulos';
import Parte from './Parte.astro';

interface Props { stories: Story[] }
const { stories } = Astro.props;
const detalles = import.meta.glob<string>('../../assets/cine/isometric/*-detail.svg', { eager:true, query:'?url', import:'default' });
const visuales: Record<string, { icono: typeof Network; corto: string }> = {
  '101': { icono: Network, corto: 'Redes' }, '102': { icono: Cctv, corto: 'Seguridad' },
  '103': { icono: RadioTower, corto: 'Telecom' }, '104': { icono: CodeXml, corto: 'Software' },
  '105': { icono: Headset, corto: 'Soporte' }, '106': { icono: Workflow, corto: 'Consultoría' },
  '107': { icono: Flame, corto: 'Incendios' }, '108': { icono: Zap, corto: 'Energía' },
};
const frentes = NAV_SERVICES.map((servicio) => {
  const propios = stories.filter((obra) => obra.serviceCodes.includes(servicio.code));
  const candidatos = pageCaseCandidates(propios, undefined, servicio.code);
  const obra = candidatos.find((c) => publicCaseFor(c)) ?? destacados(candidatos, 1)[0];
  const estudio = ISOMETRIC_STUDIES[servicio.code];
  const animacion = SERVICE_MOTION[servicio.code];
  return { ...servicio, visual: visuales[servicio.code]!, kit: (KIT_DE_SERVICIO[servicio.code] ?? []).slice(0, 3),
    detalle: estudio && detalles[`../../assets/cine/isometric/${estudio.asset}-detail.svg`],
    detalleNombre: estudio?.views.at(-1)?.label,
    animacion, total: propios.length, obra, tituloObra: obra && (publicCaseFor(obra)?.title || tituloProyecto(obra.title, obra.client, obra.summary) || obra.title) };
});
---
<div class="explorador" data-service-motion>
  <header class="encabezado">
    <h2 id="explorador-titulo">Ocho frentes de servicio<span class="dot">.</span></h2>
    <a class="catalogo" href="/servicios">Catálogo de servicios <ArrowUpRight size={18} aria-hidden="true" /></a>
  </header>
  <fieldset>
    <legend class="lector">Elegí un servicio para ver su alcance y sus antecedentes</legend>
    <div class="mesa">
      {frentes.map(({ code, name, text, href, visual, kit, total, obra, tituloObra, detalle, detalleNombre, animacion }, i) => {
        const Icono = visual.icono;
        return <>
          <input class="selector" id={`frente-${code}`} type="radio" name="frente-portada" checked={i === 0} aria-controls={`panel-${code}`} />
          <label class="fila" for={`frente-${code}`} style={`--fila:${i + 1};--fila-m:${Math.floor(i / 2) + 1};--col-m:${i % 2 + 1}`}>
            <Icono class="icono" size={24} stroke-width={1.65} aria-hidden="true" />
            <span class="nombre">{name}</span><span class="corto" aria-hidden="true">{visual.corto}</span>
            <span class="marca" aria-hidden="true"><ChevronRight size={17} /></span>
          </label>
          <article class="panel" id={`panel-${code}`} aria-labelledby={`nombre-${code}`}>
            <div class="lamina">
              <div class="alcance">
                <span class="codigo">Servicio {code}</span>
                <h3 id={`nombre-${code}`}>{name}</h3>
                <p>{text}</p>
                <a class="provision" href={`${href}#provision`}>Qué proveemos <ArrowRight size={17} aria-hidden="true" /></a>
              </div>
              <figure class="dibujo" data-motion-figure data-service={code}>
                {detalle && <>
                  <input class="detalle-control" id={`detalle-${code}`} type="checkbox" aria-label={`Ver detalle de ${animacion.title.toLowerCase()}`} />
                  <label class="ampliar" for={`detalle-${code}`}><ScanSearch size={16} aria-hidden="true" /> Detalle</label>
                </>}
                <div class="equipo-vista">
                  <img class="equipo" src={`/cine/iso/service-${code}.svg${animacion.viewBox ? '#svgView(viewBox('+animacion.viewBox+'))' : ''}`} width="420" height="270" loading="lazy" decoding="async" alt="" />
                  {detalle && <img class="ampliacion" src={detalle} width="420" height="270" loading="lazy" decoding="async" alt="" />}
                </div>
                <figcaption><span>{animacion.title}</span>{detalleNombre && <b>{animacion.title} · {detalleNombre}</b>}</figcaption>
                <div class="secuencia">
                  <span class="circuito" aria-hidden="true"><span class="senal" data-signal></span></span>
                  <ol aria-label="Secuencia conceptual de operación">{animacion.sequence.map(label => <li>{label}</li>)}</ol>
                </div>
              </figure>
            </div>
            <ul class="piezas" aria-label={`Ejemplos de provisión de ${name}`}>
              {kit.map(([key, label]) => <li><Parte k={key} size={40} /><span>{label}</span></li>)}
            </ul>
            <div class="evidencia">
              {obra && <a class="referencia" href={obra.href}>
                <FileText size={19} stroke-width={1.6} aria-hidden="true" />
                <span><small>Proyecto de referencia{obra.year > 0 && ` · ${obra.year}`}</small>
                  <strong>{tituloObra}</strong>{obra.client && !tituloObra?.toLocaleLowerCase('es').includes(obra.client.toLocaleLowerCase('es')) && <span class="cliente">{obra.client}</span>}</span>
                <ArrowUpRight size={18} aria-hidden="true" />
              </a>}
              {total > 0 && <a class="archivo" href={`/antecedentes?servicio=${code}`}>{total} {total === 1 ? 'antecedente' : 'antecedentes'} <ArrowRight size={16} aria-hidden="true" /></a>}
            </div>
          </article>
        </>;
      })}
    </div>
  </fieldset>
</div>

<script>
  import { initServiceMotion } from './service-motion';
  document.querySelectorAll<HTMLElement>('[data-service-motion]').forEach(initServiceMotion);
</script>

<style>
  .encabezado { display:flex; align-items:end; justify-content:space-between; gap:20px; margin-bottom:24px; }
  .encabezado h2 { max-width:24ch; }
  .catalogo,.provision,.archivo { display:inline-flex; align-items:center; gap:8px; width:fit-content; min-height:44px; font-weight:600; font-size:1rem; }
  .catalogo:hover,.provision:hover,.archivo:hover,.referencia:hover strong { text-decoration:underline; text-decoration-color:var(--red-text); text-underline-offset:4px; }
  fieldset { min-width:0; padding:0; margin:0; border:0; }
  .mesa { position:relative; display:grid; grid-template-columns:minmax(230px, .88fr) minmax(0, 2.32fr); border-block:1px solid var(--line); }
  .lector,.selector,.detalle-control { position:absolute; inline-size:1px; block-size:1px; padding:0; margin:0; overflow:hidden; clip-path:inset(50%); white-space:nowrap; }
  .fila { grid-column:1; grid-row:var(--fila); display:grid; grid-template-columns:26px minmax(0,1fr) 18px; align-items:center; gap:12px; min-height:55px; padding:8px 18px; border-bottom:1px solid var(--line-2); color:var(--ink-2); cursor:pointer; font-weight:550; line-height:1.15; }
  .icono { color:var(--ink-2); }
  .marca { display:grid; color:var(--ink-3); opacity:.55; }
  .corto { display:none; }
  .fila:hover { background:var(--bg-2); color:var(--ink); }
  .selector:checked + .fila { box-shadow:inset 3px 0 var(--red); background:var(--bg-2); color:var(--ink); }
  .selector:checked + .fila :is(.icono,.marca) { color:var(--red-text); opacity:1; }
  .selector:focus-visible + .fila { outline:2px solid var(--ink); outline-offset:-3px; }
  .panel { display:none; grid-column:2; grid-row:1 / span 8; align-content:stretch; grid-template-rows:minmax(220px,1fr) auto auto; min-width:0; border-left:1px solid var(--line); background:var(--bg-2); }
  .selector:checked + .fila + .panel { display:grid; }
  .lamina { display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.15fr); }
  .alcance { align-self:center; display:grid; justify-items:start; gap:12px; padding:24px clamp(18px,2.3vw,36px); }
  .codigo { display:flex; align-items:center; gap:9px; font-size:1rem; font-variant-numeric:tabular-nums; color:var(--ink-2); }
  .codigo::before { content:''; width:20px; height:2px; background:var(--red); }
  .alcance h3 { font-size:clamp(1.65rem,2.5vw,2.6rem); line-height:1.04; }
  .alcance p { color:var(--ink-2); line-height:1.45; max-width:36ch; }
  .provision { color:var(--ink); }
  .provision :global(svg),.archivo :global(svg) { color:var(--red-text); }
  /* Stable equipment; only the operating path moves. */
  .dibujo { --plano:#c7cdce; --plano-ink:#242a2c; --plano-line:#879195; position:relative; isolation:isolate; display:grid; grid-template-rows:minmax(220px,1fr) auto auto; min-width:0; margin:0; background:var(--plano); color:var(--plano-ink); }
  .equipo-vista { min-height:220px; position:relative; overflow:hidden; }
  .equipo-vista img { position:absolute; inset:var(--s2) var(--s2) var(--s1); width:calc(100% - var(--s2)*2); height:calc(100% - var(--s3)); object-fit:contain; }
  .ampliar { position:absolute; z-index:1; right:var(--s1); top:0; display:inline-flex; align-items:center; gap:6px; min-height:44px; padding:4px var(--s1); cursor:pointer; font-size:1rem; }
  .ampliar:hover,.detalle-control:checked ~ .ampliar { text-decoration:underline; text-decoration-color:var(--red); text-underline-offset:4px; }
  .detalle-control:focus-visible + .ampliar { outline:2px solid var(--plano-ink); }
  .ampliacion,figcaption b { display:none; }
  .detalle-control:checked ~ .equipo-vista .ampliacion { display:block; }
  .detalle-control:checked ~ .equipo-vista .equipo,.detalle-control:checked ~ figcaption span { display:none; }
  .detalle-control:checked ~ figcaption b { display:inline; font-weight:400; }
  figcaption { padding:0 var(--s2); font-size:1rem; line-height:1.3; }
  .secuencia { position:relative; margin:var(--s1) var(--s2) var(--s2); }
  .circuito { position:absolute; top:0; left:calc((100% - 16px)/6); width:calc((100% - 16px)*2/3 + 16px); height:12px; overflow:hidden; }
  .circuito::before { content:''; position:absolute; top:5.5px; width:100%; height:1px; background:var(--plano-line); }
  .senal { position:absolute; left:0; top:5px; width:12%; height:2px; background:var(--red); transform:translateX(-100%); }
  .secuencia li::before { content:""; position:absolute; top:3px; left:50%; width:6px; height:6px; border:1px solid var(--plano-line); border-radius:50%; background:var(--plano); transform:translateX(-50%); }
  .secuencia ol { display:flex; justify-content:space-between; padding:0; margin:0; list-style:none; gap:var(--s1); font-size:1rem; line-height:1.2; }
  .secuencia li { flex:1; text-align:center; position:relative; padding-top:16px; }

  .piezas { display:grid; grid-template-columns:repeat(auto-fit,minmax(0,1fr)); margin:0; padding:0 16px; list-style:none; border-block:1px solid var(--line); }
  .piezas li { display:flex; align-items:center; gap:6px; padding:10px 8px; font-size:1rem; line-height:1.25; }
  .piezas :global(svg) { flex:0 0 40px; }
  .evidencia { display:flex; align-items:center; justify-content:space-between; gap:16px; padding:14px clamp(18px,2.3vw,36px); background:var(--bg); }
  .referencia { display:flex; align-items:center; gap:12px; min-width:0; min-height:44px; }
  .referencia > :global(svg) { flex:none; color:var(--ink-2); }
  .referencia small,.cliente { display:block; color:var(--ink-2); font-size:1rem; line-height:1.35; }
  .referencia strong { display:block; font-size:1.03rem; line-height:1.25; margin:3px 0; }
  .archivo { flex:none; color:var(--ink-2); }
  @media(max-width:980px) {
    .encabezado { flex-wrap:wrap; gap:4px 14px; margin-bottom:12px; }
    .mesa { grid-template-columns:repeat(4,minmax(0,1fr)); }
    .fila { grid-column:auto; grid-row:auto; display:flex; flex-direction:column; justify-content:center; gap:4px; min-height:60px; padding:6px 2px; text-align:center; font-size:1rem; }
    .fila .icono { width:20px; }
    .fila .marca { display:none; }
    .selector:checked + .fila { box-shadow:inset 0 -2px var(--red); }
    .corto { display:block; }
    .nombre { position:absolute; clip-path:inset(50%); width:1px; height:1px; overflow:hidden; }
    .panel { grid-column:1/-1; grid-row:3; grid-template-rows:auto auto auto; border-left:0; }
    .alcance { padding:16px; gap:6px; }
    .lamina { grid-template-columns:minmax(0,1.05fr) minmax(0,1fr); }
    .alcance h3 { font-size:1.5rem; }
    .alcance p { font-size:1rem; }
    .piezas { display:flex; flex-wrap:wrap; padding:0 4px; }
    .piezas li { flex:1 1 90px; flex-direction:column; align-items:start; gap:2px; padding:8px; }
    .piezas :global(svg) { width:34px; height:34px; flex:none; }
    .evidencia { flex-wrap:wrap; gap:2px 16px; padding:12px 16px; }
  }
  @media(max-width:560px) {
    .lamina { grid-template-columns:minmax(0,1fr); }
    .alcance { grid-template-columns:minmax(0,1fr) auto; column-gap:12px; }
    .alcance .codigo,.alcance h3 { grid-column:1/-1; }
    .alcance p { grid-column:1; }
    .alcance .provision { grid-column:2; align-self:center; font-size:1rem; }
    .dibujo { grid-row:1; grid-template-rows:176px auto auto; }
    .equipo-vista { min-height:176px; }
  }
  @media(max-width:380px) {
    .fila { padding-inline:6px; }
    .alcance { padding:12px; }
    .piezas li { padding:6px; }
  }
  @media(max-width:359px) {
    .mesa { grid-template-columns:repeat(2,minmax(0,1fr)); }
    .panel { grid-row:5; }
    .fila { grid-row:var(--fila-m); grid-column:var(--col-m); flex-direction:row; justify-content:start; gap:7px; min-height:48px; padding:8px 12px; text-align:left; }
    .selector:checked + .fila { box-shadow:inset 3px 0 var(--red); }
  }
  @media(prefers-reduced-motion:reduce) { .senal { display:none; } }
</style>
