---
import FunctionalScene from "./FunctionalScene.astro";
interface Props {
  code: string;
}
const { code } = Astro.props;
const security = code === "102";
---

<section
  class="sec functional-section"
  id="flujo"
  aria-labelledby="functional-heading"
>
  <div class="wrap">
    <div class="functional-heading">
      <div>
        <p class="functional-kicker">
          {security ? "Seguridad electrónica" : "Energía IT"}
        </p><h2 id="functional-heading">
          {
            security
              ? "Del evento a la imagen"
              : "La energía cambia. La operación sigue"
          }<span class="dot">.</span>
        </h2>
      </div><p>
        {
          security
            ? "Capturar lo que sucede, conservar el registro y encontrar la imagen cuando se necesita."
            : "La UPS sostiene los equipos conectados cuando se interrumpe el suministro eléctrico. El respaldo se dimensiona según la carga y la autonomía requerida."
        }
      </p>
    </div>
    <FunctionalScene kind={security ? "security" : "energy"} />
  </div>
</section>
<style>
  .functional-heading {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: 24px 64px;
    align-items: end;
    margin-bottom: 32px;
  }
  .functional-heading h2 {
    max-width: 22ch;
  }
  .functional-heading p {
    color: var(--ink-2);
    max-width: 48ch;
    margin: 0;
  }
  .functional-heading .functional-kicker {
    margin: 0 0 12px;
    font-size: 0.875rem;
  }
  @media (max-width: 760px) {
    .functional-heading {
      grid-template-columns: 1fr;
      gap: 16px;
      margin-bottom: 24px;
    }
    .functional-heading h2 {
      font-size: clamp(1.75rem, 7vw, 2.25rem);
    }
  }
</style>
