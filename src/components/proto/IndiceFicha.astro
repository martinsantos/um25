---
import { ArrowDown } from 'lucide-astro';

interface Props { links: { href: string; label: string }[]; class?: string }
const { links, class: className } = Astro.props;
---
<nav class:list={['indice-ficha', className]} aria-label="En esta ficha">
  <ul>
    {links.map(({ href, label }) => <li><a href={href}>{label}<ArrowDown size={15} aria-hidden="true" /></a></li>)}
  </ul>
</nav>
<style>
  .indice-ficha { border-block:1px solid var(--line, #44474b); }
  ul {
    display:flex; flex-wrap:wrap; gap:0 clamp(16px,2vw,32px);
    margin:0; padding:6px 0; list-style:none;
  }
  a {
    display:flex; align-items:center; justify-content:space-between; gap:8px;
    min-height:44px; color:inherit; font-size:.96rem; font-weight:600; line-height:1.3;
    text-decoration:underline; text-decoration-color:var(--line-2, #6b7076); text-underline-offset:4px;
  }
  a svg { flex:none; color:var(--ink-2, #b9bcbe); }
  a:hover { text-decoration-color:currentColor; }
  a:focus-visible { outline:2px solid currentColor; outline-offset:3px; }
  @media(max-width:700px) {
    ul { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:0 16px; padding:0; }
    li { min-width:0; }
    li:nth-child(n+3) { border-top:1px solid var(--line, #44474b); }
    a { padding-block:7px; }
  }
</style>
