---
import { srcsetDe, variantes } from './isoData';
interface Props { label: string; image: string }
const { label, image } = Astro.props;
const photo = variantes(image);
const posterAvif = /^\/cine\/media\/cine-.+-poster\.jpg$/.test(image) ? image.replace(/\.jpg$/, '.avif') : '';
---
<section class="apertura-foto" aria-label={label}>
  <picture aria-hidden="true">
    {posterAvif && <source type="image/avif" srcset={posterAvif} />}
    {photo.avif && <source type="image/avif" srcset={photo.avif} sizes="100vw" />}
    <img src={photo.w960} srcset={srcsetDe(image)} sizes={photo.ancho ? '100vw' : undefined}
      alt="" width="1672" height="941" fetchpriority="high" decoding="async" />
  </picture>
  <div class="wrap apertura-foto__contenido">
    <div class="apertura-foto__texto"><slot /></div>
  </div>
</section>

<style>
  .apertura-foto { position:relative; isolation:isolate; background:var(--bg); }
  picture, .apertura-foto::before { position:absolute; inset:0; }
  picture { z-index:-2; }
  img { display:block; width:100%; height:100%; object-fit:cover; object-position:center 45%; }
  .apertura-foto::before {
    content:'';
    z-index:-1;
    background:linear-gradient(90deg, #0a0b0df5 8%, #0a0b0dcf 35%, #0a0b0d27 76%), linear-gradient(0deg, var(--bg), transparent 45%);
  }
  .apertura-foto__contenido { display:grid; align-items:center; min-height:clamp(430px, 57svh, 640px); padding-block:clamp(32px, 5vw, 72px); }
  .apertura-foto__texto { display:grid; gap:var(--s2); justify-items:start; max-width:min(100%, 650px); }
  .apertura-foto__texto :global(h1) { max-width:18ch; font-size:clamp(2.35rem, 4.6vw, 4.6rem); line-height:1.02; }
  .apertura-foto__texto :global(p) { max-width:47ch; color:var(--ink-2); font-size:1.125rem; line-height:1.55; }
  .apertura-foto__texto :global(.small) { color:var(--ink-2); }
  .apertura-foto__texto :global(.action-links) { margin:0; gap:8px clamp(12px, 2vw, 24px); }
  .apertura-foto__texto :global(a) { display:inline-flex; align-items:center; gap:8px; min-height:44px; max-width:100%; }
  .apertura-foto__texto :global(a:focus-visible) { outline:2px solid #fff; outline-offset:3px; }
  @media(max-width:700px) {
    .apertura-foto::before { background:linear-gradient(180deg, #0a0b0d16, #0a0b0dcd 32%, #0a0b0df6 75%, var(--bg)); }
    .apertura-foto__contenido { padding-block:clamp(76px, 14svh, 118px) var(--s3); min-height:0; }
    .apertura-foto__texto { gap:14px; }
    .apertura-foto__texto :global(h1) { font-size:clamp(2rem, 8.6vw, 3.2rem); }
    .apertura-foto__texto :global(p) { font-size:1rem; }
    .apertura-foto__texto :global(.btn) { padding:10px 16px; }
  }
</style>
