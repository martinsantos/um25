---
/**
 * Apertura común: texto a la izquierda, la imagen real que se abre hasta el despiece a la derecha.
 * En el hero (portada, sector, servicio) el lugar real va a pantalla completa de fondo, película o
 * foto, y se retira con el scroll; recién entonces se dibuja la isometría, sola. Nunca los dos a la
 * vez: salen de cámaras distintas y superpuestos se leían como dos edificios.
 */
import '../../styles/apertura.css';
import { variantes } from './isoData';
interface Props { label: string; iso?: string; isoSrc?: string; svc?: string; ciclo?: boolean; nombres?: Record<string, string>; image: string; ghost?: string; film?: string; poster?: string; open?: boolean; hero?: boolean; photoOnly?: boolean; eager?: boolean }
const { label, iso, isoSrc, svc, ciclo = false, nombres, image, ghost, film, poster, open = false, hero = false, photoOnly = false, eager = true } = Astro.props;
const foto = variantes(image);
const nombresAttr = nombres ? Object.entries(nombres).map(([k, v]) => `${k}:${v}`).join('|') : undefined;
---
<section class:list={['lugar', { 'lugar--open': open, 'lugar--hero': hero, 'lugar--photo': photoOnly }]} data-lugar={photoOnly ? undefined : ''} data-fase={photoOnly ? undefined : '0'} aria-label={label}>
  <div class="lugar__pin">
    {hero && (
      <div class="lugar__fondo" aria-hidden="true">
        {film
          ? <>
              <picture>{(poster || image).endsWith('.jpg') && <source type="image/avif" srcset={(poster || image).replace(/\.jpg$/, '.avif')} />}<img src={poster || image} alt="" width="1920" height="1080" loading="eager" fetchpriority="high" decoding="async" /></picture>
              <video muted playsinline loop preload="none" data-film={film} width="1920" height="1080"></video>
            </>
          : <picture>{foto.avif && <source type="image/avif" srcset={foto.avif} sizes="100vw" />}<img src={foto.w960} srcset={foto.ancho ? `${foto.w960} 960w, ${foto.full} ${foto.ancho}w` : undefined} sizes="100vw" alt="" width="1672" height="941" loading="eager" fetchpriority="high" decoding="async" /></picture>}
      </div>
    )}
    <div class="copy"><slot /></div>
    {!photoOnly && <div class="xray">
      {!hero && <div class="xray__ghost"><img src={ghost || image} alt="" width="1672" height="941" loading={eager ? 'eager' : 'lazy'} /></div>}
      {iso ? <div class="xray__iso iso" data-svc={svc} data-ciclo={ciclo ? "" : undefined} data-nombres={nombresAttr} set:html={iso} /> : <div class="xray__iso iso" data-svc={svc} data-ciclo={ciclo ? "" : undefined} data-nombres={nombresAttr} data-src={isoSrc}></div>}
      {!hero && <div class="xray__foto">
        {film ? <video muted playsinline loop preload="none" poster={image} data-film={film} width="1920" height="1080"></video> : <img src={image} alt="" width="1672" height="941" loading={eager ? 'eager' : 'lazy'} fetchpriority={eager ? 'high' : 'auto'} decoding="async" />}
      </div>}
      <div class="xray__linea"></div>
      {ciclo && <div class="xray__rotulo" data-rotulo aria-live="polite"></div>}
    </div>}
  </div>
</section>

<style>
  /* A normal document-flow opening: the photograph never gives way to a diagram. */
  .lugar--photo { height:auto; }
  .lugar--photo .lugar__pin { position:relative; top:auto; height:auto; min-height:calc(100svh - var(--top-h)); overflow:visible; }
  .lugar--photo .lugar__fondo { opacity:1; }
  @media (max-width:900px) {
    .lugar--photo .lugar__pin { min-height:0; }
  }
</style>
