---
import { publicCaseTitle } from './casePresentation';
import { variantes, type Story } from './isoData';
interface Props { story: Story; href?: string; eager?: boolean; showSector?: boolean; primera?: boolean; imageSizes?: string; archiveTitle?: string }
const { story: c, href = c.href, eager = false, showSector = true, primera = false, imageSizes, archiveTitle } = Astro.props;
const photo = variantes(c.image);
---
<li class="ficha" data-ficha data-id={String(c.id)} data-sector={c.sectorSlug} data-services={c.serviceCodes.join(' ')} data-year={String(c.year)} data-client={c.client.toLowerCase()} data-status={c.status} data-search={[c.client, c.title, c.sector, ...c.services, c.summary].join(' ')}>
  <a href={href} id={archiveTitle ? `resultado-um-${c.id}` : undefined}>
    <figure>
      {c.image && <img src={photo.w480} srcset={photo.ancho ? `${photo.w480} 480w, ${photo.w960} 960w` : undefined} sizes={(eager ? "" : "auto, ") + (imageSizes || "(max-width: 600px) 94vw, (max-width: 900px) 46vw, (max-width: 1100px) 32vw, 22vw")} alt="" width="480" height="300" loading={eager ? 'eager' : 'lazy'} fetchpriority={primera ? 'high' : undefined} decoding="async" />}
    </figure>
    <b>{archiveTitle || publicCaseTitle(c)}</b>
    <span class="t">{c.client}</span>
    <span class="small">{[archiveTitle ? `UM-${c.id}` : '', showSector ? c.sector : '', c.year || ''].filter(Boolean).join(' · ')}</span>
  </a>
</li>
