---
/**
 * Ficha de proyecto: foto, cliente, qué se hizo, sector y año. Lo instalado se lee adentro, en la
 * ficha completa; en la pared sólo la foto y el texto, para que las 500 fichas se lean como una.
 */
import { thumbOf, type Story } from './isoData';
interface Props { story: Story; eager?: boolean; showSector?: boolean; lazy?: boolean }
const { story: c, eager = false, showSector = true } = Astro.props;
---
<li class="ficha" data-ficha data-sector={c.sectorSlug} data-services={c.serviceCodes.join(' ')} data-year={String(c.year)} data-client={c.client.toLowerCase()}>
  <a href={c.href}>
    <figure>{c.image && <img src={thumbOf(c.image)} alt="" width="480" height="300" loading={eager ? 'eager' : 'lazy'} decoding="async" />}</figure>
    <b>{c.client}</b>
    <span class="t">{c.title}</span>
    <span class="small">{[showSector ? c.sector : '', c.year || ''].filter(Boolean).join(' · ')}</span>
  </a>
</li>
