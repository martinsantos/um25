---
import { ArrowRight } from 'lucide-astro';
import { srcsetDe, thumbOf } from './isoData';
import { projectMediaKey } from './caseSelection';
import { publicCaseTitle } from './casePresentation';
import type { RelatedGroup } from './relatedCaseGroups';

interface Props { cover: string; groups: RelatedGroup[]; query?: string }
const { cover, groups, query = '' } = Astro.props;
const photos = new Set([projectMediaKey(cover)]);
const relation = { cliente: 'Mismo cliente', sector: 'Mismo sector', servicio: 'Mismo servicio' };
---
{groups.length > 0 && <section class:list={['related', { 'related--single': groups.length === 1 }]} id="obras-relacionadas" tabindex="-1" aria-labelledby="related-heading">
  <div class="wrap">
    <h2 id="related-heading">Obras relacionadas<span class="dot">.</span></h2>
    <div class="groups">
      {groups.map(group => {
        const illustrated = group.works.find(s => /^\/images\/(antecedentes|photography)\//.test(s.image) && !photos.has(projectMediaKey(s.image)));
        if (illustrated) photos.add(projectMediaKey(illustrated.image));
        return <section data-related-group={group.kind} aria-labelledby={'related-' + group.kind}>
          <h3 id={'related-' + group.kind}><span>{relation[group.kind]}</span>{group.name}</h3>
          <ul>{group.works.map(s => <li>
            <a href={s.href + query} data-related-case={s.id}>
              {s === illustrated && <img src={thumbOf(s.image)} srcset={srcsetDe(s.image)} sizes="(max-width: 550px) 96px, 148px" width="148" height="96" alt="" loading="lazy" decoding="async" />}
              <span class="record"><strong>{publicCaseTitle(s)}</strong>
                <small>{[group.kind !== 'cliente' && s.client, `UM-${s.id}`, s.year || ''].filter(Boolean).join(' · ')}</small></span>
              <ArrowRight size={17} aria-hidden="true" />
            </a>
          </li>)}</ul>
          <a class="archive" href={group.href + '#obras-filtradas'}>{group.all} <ArrowRight size={16} aria-hidden="true" /></a>
        </section>;
      })}
    </div>
  </div>
</section>}
<style>
  .related { padding-block: var(--s5); border-block-start: 1px solid var(--line); }
  h2 { margin-bottom: var(--s4); }
  .groups { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: var(--s4); }
  .related--single .groups { grid-template-columns: minmax(0,1fr); }
  @media (min-width: 960px) {
    .related--single > .wrap { display: grid; grid-template-columns: minmax(240px, 4fr) minmax(0, 7fr); gap: var(--s4); }
    .related--single h2 { max-width: 12ch; }
  }
  h3 { display:grid; gap:5px; font-size:clamp(1.125rem,1.5vw,1.4rem); margin-bottom:12px; }
  h3 span { color:var(--ink-2); font-size:.875rem; font-weight:500; }
  ul { padding: 0; margin: 0; list-style: none; }
  li { border-block-start: 1px solid var(--line); }
  li a { display: flex; gap: clamp(10px,1.4vw,20px); align-items: center; padding-block: 14px; min-height: 52px; }
  img { width: clamp(96px,10.4vw,148px); height: auto; aspect-ratio: 3 / 2; object-fit: cover; flex: none; }
  .record { flex: 1; min-width: 0; display: grid; gap: 4px; overflow-wrap: anywhere; }
  strong { font-weight: 600; line-height: 1.35; }
  small { font-size: .9375rem; line-height: 1.45; color: var(--ink-2); }
  a :global(svg) { flex: none; }
  .archive { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; text-decoration: underline; text-underline-offset: .25em; }
  li a:hover strong, li a:focus-visible strong { text-decoration: underline; text-underline-offset: .2em; }
  a:focus-visible { outline: 2px solid currentColor; outline-offset: 2px; }
  @media(max-width: 780px) { .groups { grid-template-columns: minmax(0,1fr); } }
  @media(max-width: 360px) { img { width: 80px; } }
  @media print { .related { display: none; } }
</style>
