---
import { ArrowRight, ArrowUpRight } from 'lucide-astro';
import { catalogResultsHref } from './catalogFilters';
import { publicCaseTitle } from './casePresentation';
import type { Story } from './isoData';

interface Props {
  service: string;
  name: string;
  sectors: { slug: string; name: string; count: number; reference?: Story }[];
  unclassified: number;
}
const { service, name, sectors, unclassified } = Astro.props;
---
{(sectors.length > 0 || unclassified > 0) && <section class="sec sector-works" id="obras-por-sector" tabindex="-1" aria-labelledby="sector-works-title">
  <div class="wrap">
    <header>
      <h2 id="sector-works-title">Dónde lo hicimos<span class="dot">.</span></h2>
      <p>Antecedentes de {name} por actividad.</p>
    </header>
    {sectors.length > 0 && <ul>
      {sectors.map(({ slug, name: market, count, reference }) => <li>
        <div class="sector-summary">
          <a class="sector" href={`/sectores/${slug}`} aria-label={`Ver ficha del sector: ${market}`}>
            {market} <ArrowUpRight size={15} aria-hidden="true" />
          </a>
          <a class="works" href={catalogResultsHref({ service, sector: slug })}
            aria-label={`Ver ${count} ${count === 1 ? 'antecedente' : 'antecedentes'} de ${name} en ${market}`}>
            {count} {count === 1 ? 'antecedente' : 'antecedentes'} <ArrowRight size={17} aria-hidden="true" />
          </a>
        </div>
        {reference && <a class="reference" data-sector-work={reference.id} href={reference.href}>
          <span>
            <small>{reference.client} · UM-{reference.id}</small>
            <strong>{publicCaseTitle(reference)}</strong>
          </span>
          <ArrowUpRight size={16} aria-hidden="true" />
        </a>}
      </li>)}
    </ul>}
    {unclassified > 0 && <a class="unclassified" href={catalogResultsHref({ service, sector: 'sin-clasificar' })}>
      {`Ver ${unclassified} ${unclassified === 1 ? 'antecedente sin sector asignado' : 'antecedentes sin sector asignado'}`}
      <ArrowRight size={16} aria-hidden="true" />
    </a>}
  </div>
</section>}
<style>
  .sector-works { background:var(--bg-2); }
  header { display:flex; align-items:baseline; justify-content:space-between; flex-wrap:wrap; gap:8px 24px; margin-bottom:var(--s3); }
  header p { margin:0; color:var(--ink-2); }
  ul { list-style:none; margin:0; padding:0; border-top:1px solid var(--line); }
  li {
    display:grid; grid-template-columns:minmax(0,1fr) minmax(0,1.3fr);
    gap:0 clamp(18px,4vw,64px); align-items:center; border-bottom:1px solid var(--line);
  }
  .sector-summary { display:grid; grid-template-columns:minmax(0,1fr) auto; gap:8px 18px; align-items:center; }
  a { min-height:48px; color:inherit; }
  .sector,.works,.unclassified { display:inline-flex; align-items:center; gap:6px; line-height:1.35; width:fit-content; }
  .sector { font-weight:650; padding-block:8px; }
  .works { color:var(--ink-2); font-size:.96rem; text-align:end; font-variant-numeric:tabular-nums; }
  .reference {
    display:flex; align-items:center; justify-content:space-between; gap:14px;
    padding:10px 0 10px clamp(16px,2vw,28px); border-inline-start:1px solid var(--line);
  }
  .reference span { min-width:0; }
  .reference small,.reference strong { display:block; }
  .reference small { margin-bottom:4px; color:var(--ink-2); font-size:.875rem; line-height:1.3; }
  .reference strong { font-size:1rem; line-height:1.35; overflow-wrap:anywhere; }
  a :global(svg) { flex:none; color:var(--red-text); }
  .sector:hover,.works:hover,.unclassified:hover,.reference:hover strong { text-decoration:underline; text-underline-offset:4px; }
  a:focus-visible { outline:2px solid currentColor; outline-offset:2px; }
  .unclassified { padding-block:8px; margin-top:8px; color:var(--ink-2); }
  @media(max-width:760px) {
    header { display:grid; }
    li { grid-template-columns:minmax(0,1fr); }
    .sector-summary { gap:8px 10px; }
    .reference { padding:0 0 12px; border-inline-start:0; }
  }
</style>
