---
/** Cierre común: contacto y pie con el mapa del sitio. Sólo frases existentes. */
import ContactModal from '../um/ContactModal.astro';
import AppTabBar from '../v4/AppTabBar.astro';
import { publicDespiecePath } from '../../lib/despieceRoutes';
import { commercialHubLinkItems } from '../../data/strategicLinkGraph';
interface Props {
  lang?: 'es' | 'en';
  withContact?: boolean;
  heading?: string;
  description?: string;
  ctaText?: string;
}
const { lang = 'es', heading, description, ctaText, withContact = true } = Astro.props;
const es = { h: 'Contanos qué tiene que seguir funcionando', p: 'Indicá qué necesitás, dónde y para cuándo. Un técnico te responde por email con el próximo paso: diagnóstico, relevamiento, propuesta o documentación.', btn: 'Enviar consulta', href: '/contacto', email: 'Email', office: 'Oficina', hours: 'Horario', hoursV: 'Lunes a viernes, 8 a 18 h', foot: 'Servicios IT desde 2003. Mendoza, Argentina.', links: [['Nosotros', '/nosotros'], ['Documentación técnica', '/documentacion'], ['Blog', '/blog'], ['Certificaciones', '/certificaciones'], ['UMSA CCTV AI', '/cctvai'], ['Privacidad', '/privacidad'], ['Términos', '/terminos'], ...commercialHubLinkItems.map((link) => [link.label, link.href]), ['English', '/en']] };
const en = { h: 'Tell us what has to keep running', p: 'Tell us what you need, where and by when. Our team will reply by email with the next step.', btn: 'Contact our team', href: '/en/contact', email: 'Email', office: 'Office', hours: 'Hours', hoursV: 'Monday to Friday, 8 am to 6 pm', foot: 'IT services since 2003. Mendoza, Argentina.', links: [['About', '/en/about'], ['Services', '/en/services'], ['Versión en español', '/']] };
const base = lang === 'en' ? en : es;
const t = { ...base, h: heading ?? base.h, p: description ?? base.p, btn: ctaText ?? base.btn };
---
<footer>
{withContact && <section class="cierre" id="contacto">
  <div class="wrap cierre__grid">
    <div class="cierre__copy">
      <h2>{t.h}<span class="dot">.</span></h2>
      <p>{t.p}</p>
      <a class="btn" href={t.href}>{t.btn} <span aria-hidden="true">→</span></a>
    </div>
    <div class="cierre__datos">
      <div><span>{t.email}</span><b><a href="mailto:contacto@ultimamilla.com.ar">contacto@ultimamilla.com.ar</a></b></div>
      <div><span>{t.office}</span><b>Houssay 1159, Guaymallén, Mendoza</b></div>
      <div><span>{t.hours}</span><b>{t.hoursV}</b></div>
    </div>
  </div>
</section>}
<div class="pie">
  <div class="wrap pie__grid">
    <span>ultimamilla.com.ar · {t.foot}</span>
    <nav aria-label={lang === 'en' ? 'Site' : 'Sitio'}>{t.links.map(([n, h]) => <a href={h}>{n}</a>)}</nav>
  </div>
</div>
</footer>

<ContactModal />
<AppTabBar currentPath={publicDespiecePath(Astro.url.pathname)} />
