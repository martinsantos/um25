---
import { pageContactLink } from '../../lib/caseJourney';
import EmailLink from '../common/EmailLink.astro';
import FooterV4 from '../v4/FooterV4.astro';
import ContactLinks from '../um/ContactLinks.astro';
import AppTabBar from '../v4/AppTabBar.astro';
import { publicDespiecePath } from '../../lib/despieceRoutes';
interface Props {
  lang?: 'es' | 'en';
  withContact?: boolean;
  heading?: string;
  description?: string;
  ctaText?: string;
  contactHref?: string;
}
const { lang = 'es', heading, description, ctaText, contactHref, withContact = true } = Astro.props;
const es = { h: 'Contanos qué tiene que seguir funcionando', p: 'Indicá qué necesitás, dónde y para cuándo. Un técnico te responde por email con el próximo paso: diagnóstico, relevamiento, propuesta o documentación.', btn: 'Iniciar una consulta', href: '/contacto', email: 'Email', office: 'Oficina', hours: 'Horario', hoursV: 'Lunes a viernes, 8 a 18 h' };
const en = { h: 'Tell us what has to keep running', p: 'Tell us what you need, where and by when. Our team will reply by email with the next step.', btn: 'Contact our team', href: '/en/contact', email: 'Email', office: 'Office', hours: 'Hours', hoursV: 'Monday to Friday, 8 am to 6 pm' };
const base = lang === 'en' ? en : es;
const t = { ...base, h: heading ?? base.h, p: description ?? base.p, btn: ctaText ?? base.btn };
---
<FooterV4 compactBrand={withContact}>
{withContact && <section class="cierre" id="contacto">
  <div class="wrap cierre__grid">
    <div class="cierre__copy">
      <h2>{t.h}<span class="dot">.</span></h2>
      <p>{t.p}</p>
      <a class="btn" data-contact-follow={!contactHref || undefined} href={pageContactLink(Astro, contactHref || t.href)}>{t.btn} <span aria-hidden="true">→</span></a>
    </div>
    <div class="cierre__datos">
      <div><span>{t.email}</span><b><EmailLink hrefFallback={t.href} /></b></div>
      <div><span>{t.office}</span><b>Houssay 1159, Guaymallén, Mendoza</b></div>
      <div><span>{t.hours}</span><b>{t.hoursV}</b></div>
    </div>
  </div>
</section>}
</FooterV4>

<ContactLinks />
<AppTabBar currentPath={publicDespiecePath(Astro.url.pathname)} />
