---
import hero from '../../assets-pilot/hero-propuesta.webp?url';
interface Props { cifras:[string,string][]; total:number }
const {cifras,total}=Astro.props;
---
<section class="opening" aria-label="Portada">
 <div class="wrap opening-grid">
  <div class="opening-copy"><p class="eyebrow">Ingeniería · Instalación · Soporte</p><h1>Servicios IT para operaciones que no pueden detenerse<span class="dot">.</span></h1><p class="intro">Redes, seguridad, comunicaciones y energía. Integramos cada sistema y documentamos lo que entregamos.</p><a class="btn" href="/contacto">Pedir un relevamiento</a></div>
  <figure><img src={hero} width="1536" height="1024" alt="Detalle de una conexión de red y su equipo de comprobación" fetchpriority="high" /></figure>
  <div class="opening-proof"><div class="cifras">{cifras.map(([n,t])=><div><b>{n}</b><span>{t}</span></div>)}</div><a class="u" href="/antecedentes">Ver los {total} antecedentes →</a></div>
 </div>
</section>
<style>
.opening{padding:48px 0 32px;border-bottom:1px solid var(--line)}.opening-grid{display:grid;grid-template-columns:1fr 1.1fr;gap:32px 48px;align-items:center}.opening-copy{display:flex;flex-direction:column;align-items:flex-start;gap:24px}.eyebrow{font-size:.8125rem;letter-spacing:.08em;color:var(--ink-2);text-transform:uppercase}h1{font-size:clamp(2.4rem,4.2vw,3.75rem);line-height:1.07;letter-spacing:-.04em;max-width:18ch}.intro{max-width:44ch;color:var(--ink-2);font-size:1.125rem;line-height:1.6}figure{margin:0;align-self:stretch;min-height:460px;overflow:hidden}img{display:block;width:100%;height:100%;object-fit:cover;object-position:60% center}.opening-proof{grid-column:1/-1;display:flex;gap:32px;align-items:center;justify-content:space-between;border-top:1px solid var(--line);padding-top:24px}.opening-proof .cifras{display:grid;grid-template-columns:repeat(4,1fr);gap:32px;border:0;padding:0;margin:0;flex:1}.cifras b{font-size:2rem}.cifras span{font-size:.875rem;color:var(--ink-2)}.opening-proof>a{white-space:nowrap;font-size:1rem}@media(max-width:900px){.opening{padding:28px 0}.opening-grid{grid-template-columns:1fr;gap:24px}.opening-copy{gap:16px}h1{font-size:clamp(2rem,7.5vw,2.75rem);max-width:22ch}.intro{font-size:1rem}.opening-copy .btn{min-height:48px}figure{min-height:0;aspect-ratio:3/2}img{object-fit:cover}.opening-proof{display:block;padding-top:20px}.opening-proof .cifras{gap:16px;grid-template-columns:repeat(2,1fr)}.opening-proof>a{display:inline-flex;align-items:center;min-height:44px;margin-top:20px}.cifras b{font-size:1.5rem}}
</style>
