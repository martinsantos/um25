---
import { contactLink } from '../../lib/contactEntry';
import planta from '../../media/home/planta-1440.webp?url';
import plantaSmall from '../../media/home/planta-720.webp?url';
interface Props { cifras:[string,string][]; total:number }
const {cifras,total}=Astro.props;
---
<section class="opening" data-cover="planta" aria-label="Portada">
  <figure><img src={planta} srcset={`${plantaSmall} 720w, ${planta} 1440w`} sizes="100vw" width="1440" height="960" alt="Técnico junto a un gabinete de comunicaciones en una planta industrial" fetchpriority="high" /></figure>
 <div class="wrap opening-grid">
  <div class="opening-copy"><p class="eyebrow">Ingeniería · Instalación · Soporte</p><h1>Servicios IT para operaciones que no pueden detenerse<span class="dot">.</span></h1><p class="intro">Redes, seguridad, comunicaciones y energía. Integramos cada sistema y documentamos lo que entregamos.</p><a class="btn" href={contactLink(Astro.url.pathname)}>Pedir un relevamiento</a></div>

  <div class="opening-proof"><div class="cifras">{cifras.map(([n,t])=><div><b>{n}</b><span>{t}</span></div>)}</div><a class="u" href="/antecedentes">Ver los {total} antecedentes →</a></div>
 </div>
</section>
<style>
.opening { position:relative; isolation:isolate; background:#101317; color:#fff; }
figure, .opening::before { position:absolute; inset:0; margin:0; }
figure { z-index:-2; }
figure img { display:block; width:100%; height:100%; object-fit:cover; object-position:65% 45%; }
.opening::before { content:""; z-index:-1; background:linear-gradient(0deg,rgba(8,11,14,.93),transparent 31%),linear-gradient(90deg,rgba(5,8,11,.95),rgba(5,8,11,.82) 35%,rgba(5,8,11,.06) 76%); }
.opening[data-cover="planta"]::before { background:linear-gradient(0deg,rgba(8,11,14,.93),transparent 31%),linear-gradient(270deg,rgba(5,8,11,.95),rgba(5,8,11,.84) 35%,rgba(5,8,11,.04) 71%); }
.opening-grid { display:grid; align-content:space-between; gap:3rem; min-height:clamp(36rem,78svh,48rem); padding-block:clamp(3rem,6vw,7rem) 2rem; }
.opening-copy { display:grid; align-content:center; justify-items:start; gap:1.2rem; width:min(46%,36rem); }
.opening[data-cover="planta"] .opening-copy { justify-self:end; }
.eyebrow { font-size:.8125rem; letter-spacing:.08em; text-transform:uppercase; }
h1 { font-size:clamp(2.4rem,4.3vw,4.4rem); line-height:1.04; letter-spacing:-.04em; text-wrap:balance; }
.intro { max-width:42ch; font-size:1.125rem; line-height:1.5; color:#e2e6e8; }
.opening-proof { display:flex; gap:2rem; align-items:center; justify-content:space-between; padding-top:1rem; border-top:1px solid #ffffff55; }
.opening-proof .cifras { display:grid; grid-template-columns:repeat(4,1fr); flex:1; margin:0; padding:0; border:0; }
.cifras b { font-size:2rem; } .cifras span { color:#e2e6e8; font-size:.875rem; }
@media(max-width:700px) {
 .opening::before,.opening[data-cover="planta"]::before { background:linear-gradient(180deg,rgba(5,8,11,.04) 8%,rgba(5,8,11,.70) 33%,rgba(5,8,11,.89) 64%,#090c0e 100%); }
 figure img { object-position:65% 36%; } .opening[data-cover="planta"] img { object-position:25% center; }
 .opening-grid { min-height:0; gap:1.5rem; padding-block:clamp(9rem,24svh,14rem) 1.5rem; }
 .opening-copy { width:100%; gap:.875rem; }
 h1 { max-width:19ch; font-size:clamp(2rem,8.2vw,3rem); }
 .intro { font-size:1rem; } .opening-copy .btn { min-height:48px; }
 .opening-proof { display:grid; gap:.75rem; } .opening-proof .cifras { grid-template-columns:repeat(2,1fr); gap:.75rem; }
 .cifras b { font-size:1.5rem; } .opening-proof>a { justify-self:start; display:inline-flex; align-items:center; min-height:44px; }
}
</style>
