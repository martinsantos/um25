---
import { ArrowDown } from 'lucide-astro';
import { FOUNDING_DATE } from '../../config/publicFacts';
import { BUSINESS_ADDRESS } from '../../config/seo';
import { contactLink } from '../../lib/contactEntry';
import planta from '../../media/home/planta-1440.webp?url';
import plantaSmall from '../../media/home/planta-720.webp?url';

import { thumbOf } from './isoData';
import type { Project } from './portadaCases';
interface Props { obrasHref: string; obras: Project[] }
const { obrasHref, obras } = Astro.props;
const referentes = [
  ['estadio','Estadio Malvinas Argentinas','Red de prensa y transmisión'],
  ['hospitales','Hospitales de FUESMEN','Datos y energía'],
  ['justicia','Suprema Corte de Mendoza','Validación de usuarios y documentos'],
].flatMap(([key,name,scope]) => {
  const project = obras.find(obra => obra.key === key);
  return project ? [{key, name, scope, image:project.image}] : [];
});
---
<section class="opening" data-cover="planta" aria-labelledby="portada-titulo">
  <img class="opening-image" src={planta} srcset={`${plantaSmall} 720w, ${planta} 1440w`} sizes="100vw" width="1440" height="960" alt="" fetchpriority="high" />
  <div class="wrap opening-grid">
    <header>
      <p class="origen">{BUSINESS_ADDRESS.addressRegion}, Argentina <span aria-hidden="true">/</span> Desde {FOUNDING_DATE.slice(0, 4)}</p>
      <h1 id="portada-titulo">Infraestructura IT, de la obra a la operación<span class="dot">.</span></h1>
      <p class="intro">Diseñamos, instalamos y sostenemos redes, energía y software para hospitales, industria y organismos públicos.</p>
      <div class="acciones">
        <a class="btn" href={contactLink(Astro.url.pathname)}>Pedir un relevamiento</a>
        <a class="ver" href={obrasHref}>Ver obras <ArrowDown size={16} aria-hidden="true" /></a>
      </div>
    </header>
  </div>
  {referentes.length > 0 && <nav class="referencias wrap" aria-label="Obras destacadas">{referentes.map(({key,name,scope,image}) =>
    <a href={'#obra-'+key}>{image && <img src={thumbOf(image)} width="96" height="64" alt="" />}<span>{name}<small>{scope}</small></span><ArrowDown size={16} aria-hidden="true" /></a>)}</nav>}
</section>
<style>
  .opening { position: relative; isolation: isolate; background: #101317; color: #fff; }
  .opening-image, .opening::before { position: absolute; inset: 0; }
  .opening-image { z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: 48% 4%; }
  .opening::before { content: ''; z-index: -1; background: linear-gradient(90deg, transparent 18%, #10141820 36%, #0b1014c9 53%, #090d11f2 79%); }
  .opening-grid { display: grid; align-items: center; min-height: clamp(410px, 52svh, 570px); padding-block: clamp(26px, 3.8vw, 62px); }
  header { justify-self: end; width: 48%; display: grid; justify-items: start; gap: clamp(13px, 1.5vw, 23px); }
  .origen { display: flex; align-items: baseline; gap: 10px; color: #f2f3f3; font-size: .875rem; font-weight: 550; }
  .origen span { color: #c9cacc; }
  h1 { max-width: 16ch; text-wrap: balance; font-size: clamp(2.7rem, 4.8vw, 5.1rem); line-height: 1.02; letter-spacing: -.055em; }
  .intro { max-width: 39ch; font-size: clamp(1.05rem, 1.35vw, 1.25rem); line-height: 1.45; color: #edf0ef; }
  .acciones { display: flex; align-items: center; flex-wrap: wrap; gap: 4px 24px; }
  .acciones a { display: inline-flex; align-items: center; gap: 8px; min-height: 44px; font-weight: 600; }
  .ver:hover { text-decoration: underline; text-underline-offset: 4px; }
  .acciones a:focus-visible { outline: 2px solid #fff; outline-offset: 4px; }
  @media (max-width: 700px) {
    .opening-image { object-position: 23% 29%; }
    .opening::before { background: linear-gradient(180deg, #080c0e0a, #080c0e33 18%, #080c0ecc 46%, #090c0efa 88%); }
    .opening-grid { min-height: 0; padding-block: clamp(96px, 14svh, 150px) 24px; }
    header { width: 100%; gap: 12px; }
    h1 { font-size: clamp(2.15rem, 8.8vw, 3.7rem); }
    .intro { font-size: 1rem; max-width: 38ch; }
    .acciones { gap: 6px 16px; }
    .acciones .btn { padding: 11px 16px; }
  }
  @media (max-width: 359px) {
    .opening-grid { padding-block: 62px 18px; }
    header { gap: 9px; }
    .acciones { gap: 4px 12px; }
  }
  .referencias { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));background:#0b0d0ef2;border-top:1px solid #69706f; }
  .referencias a {display:flex;align-items:center;gap:12px;position:relative;padding:12px 32px 12px 14px;min-height:74px;}
  .referencias a+a {border-left:1px solid #434847;}
  .referencias img {width:clamp(58px,6vw,90px);aspect-ratio:1.45;height:auto;object-fit:cover;}
  .referencias span {font-weight:620;line-height:1.15;}
  .referencias small {display:block;font-weight:400;font-size:.84rem;color:#cbd0ce;margin-top:4px;}
  .referencias svg {position:absolute;right:12px;top:calc(50% - 8px);}
  .referencias a:hover span {text-decoration:underline;}
  @media (max-width:700px) {
    .referencias {grid-template-columns:1fr;}
    .referencias a {padding:7px 22px 7px 0;min-height:50px;}
    .referencias a+a {border-left:0;border-top:1px solid #363b3b;}
    .referencias img {width:48px;aspect-ratio:1.4;}
    .referencias span {font-size:.95rem;}
    .referencias small {font-size:.81rem;margin-top:2px;}
    .referencias svg {right:0;}
  }
</style>
