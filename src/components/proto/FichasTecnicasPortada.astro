---
import { Download, X } from 'lucide-astro';
import { SERVICE_SPEC_LIST } from '../../data/serviceSpecs';
import { contactLink } from '../../lib/contactEntry';
import { getDatasheetPublicPath } from '../../utils/datasheets';
import { shellServiceCopy, type ShellLang } from '../../config/i18nShell';

interface Props { lang?: ShellLang }
const { lang = 'es' } = Astro.props;
const t = (es: string, en: string) => lang === 'en' ? en : es;
const shortEnglish: Record<string, string> = { '102': 'Security', '103': 'Telecom', '104': 'Software', '107': 'Fire detection', '108': 'IT power' };

const nombresDeIndice: Record<string, string> = {
  '102': 'Seguridad',
  '103': 'Telecom',
  '104': 'Software',
  '106': 'Consultoría',
  '107': 'Incendios',
};
---
<dialog id="fichas-tecnicas-portada" class="fichas-portada" aria-labelledby="fichas-portada-titulo">
  <div class="fichas-portada__panel">
    <header class="fichas-portada__cabecera">
      <h2 id="fichas-portada-titulo">{t('Fichas técnicas', 'Technical sheets in Spanish')}<span class="dot">.</span></h2>
      <form method="dialog">
        <button type="submit" class="fichas-portada__cerrar" aria-label={t('Cerrar fichas técnicas', 'Close technical sheets')} autofocus>
          <X size={22} aria-hidden="true" />
        </button>
      </form>
    </header>

    <div class="fichas-portada__lectura">
      <div class="fichas-portada__selector" data-selector-documental hidden>
        <select data-servicio-documental aria-label={t('Elegir servicio', 'Choose a service')} aria-controls="fichas-contenido">
          {SERVICE_SPEC_LIST.map(({ code, name }) => (
            <option value={`fichas-hoja-${code}`}>{shellServiceCopy(lang, code, name, '').name}</option>
          ))}
        </select>
      </div>
      <div class="fichas-portada__indice" role="tablist" aria-orientation="vertical" aria-label={t('Índice de servicios', 'Service index')} data-indice-documental hidden>
        {SERVICE_SPEC_LIST.map(({ code, name }, index) => (
          <button type="button" role="tab" id={`fichas-tab-${code}`} aria-controls={`fichas-hoja-${code}`}
            aria-selected={index === 0} aria-label={shellServiceCopy(lang, code, name, '').name} tabindex={index === 0 ? 0 : -1}>
            <span>{lang === 'en' ? shortEnglish[code] || shellServiceCopy(lang, code, name, '').name : nombresDeIndice[code] || name}</span>
          </button>
        ))}
      </div>
      <div class="fichas-portada__contenido" id="fichas-contenido" data-fichas-contenido lang={lang === 'en' ? 'es-AR' : undefined}>
        {SERVICE_SPEC_LIST.map(({ code, name, deliverables, scope, standards }, index) => {
          const pdf = getDatasheetPublicPath(code);
          const consult = contactLink(Astro.url.pathname, t('/contacto', '/en/contact') + '?intent=documentacion&sistema=' + code);
          return (
            <section role="tabpanel" id={`fichas-hoja-${code}`} aria-labelledby={`fichas-tab-${code}`} tabindex="0" hidden={index !== 0}>
              <h3 id={`fichas-titulo-${code}`}>{name}</h3>
              <div class="fichas-portada__grupos">
                <div>
                  <h4>Documentación que recibís</h4>
                  <ul class="lista">{deliverables.map((item) => <li>{item}</li>)}</ul>
                </div>
                <div>
                  <h4>Alcance técnico</h4>
                  <ul class="lista">{scope.map((item) => <li>{item}</li>)}</ul>
                </div>
              </div>
              <div class="fichas-portada__referencias">
                <h4>Normas y criterios</h4>
                <ul class="lista">{standards.map((item) => <li>{item}</li>)}</ul>
              </div>
              <div class="fichas-portada__acciones" lang={lang}>
                {pdf && <a href={pdf} hreflang="es-AR" download>
                  {t('Descargar ficha en PDF', 'Download PDF (Spanish)')} <Download size={18} aria-hidden="true" />
                </a>}
                <a data-consultar-ficha href={consult}>{t('Consultar por esta ficha', 'Ask about this service')}</a>
              </div>
            </section>
          );
        })}
      </div>
    </div>
  </div>
</dialog>

<script>
  import { activarIndiceDocumental } from './indiceDocumental';

  const acciones = document.querySelector<HTMLElement>('[data-documentacion-acciones]');
  const abrir = acciones?.querySelector<HTMLButtonElement>('[data-abrir-fichas]');
  const visor = document.querySelector<HTMLDialogElement>('#fichas-tecnicas-portada');
  const contenido = visor?.querySelector<HTMLElement>('[data-fichas-contenido]');

  if (abrir && visor && contenido && typeof visor.showModal === 'function') {
    activarIndiceDocumental(visor, () => { contenido.scrollTop = 0; });
    abrir.hidden = false;
    abrir.addEventListener('click', () => visor.showModal());
    contenido.addEventListener('click', (event) => {
      if (event.button !== 0 || event.ctrlKey || event.metaKey || event.altKey || event.shiftKey) return;
      const enlace = event.target instanceof Element && event.target.closest('[data-consultar-ficha]');
      if (!enlace) return;
      const hoja = enlace.closest('section');
      if (hoja) history.replaceState({ ...history.state, fichaConsultada: { id: hoja.id, scroll: contenido.scrollTop } }, '');
    });

    window.addEventListener('pageshow', () => {
      const guardada = history.state?.fichaConsultada;
      if (!guardada || typeof guardada.id !== 'string') return;
      const hoja = document.getElementById(guardada.id);
      if (!hoja || !contenido.contains(hoja)) return;
      const tab = visor.querySelector<HTMLButtonElement>(`[aria-controls="${CSS.escape(hoja.id)}"][role="tab"]`);
      if (!tab) return;
      tab.click();
      if (!visor.open) visor.showModal();
      contenido.scrollTop = guardada.scroll;
      const consulta = hoja.querySelector<HTMLElement>('[data-consultar-ficha]');
      consulta?.focus({ preventScroll: true });
      consulta?.scrollIntoView({ block: 'nearest', inline: 'nearest', behavior: 'instant' });
    });

    visor.addEventListener('close', () => {
      if (history.state?.fichaConsultada) {
        const state = { ...history.state };
        delete state.fichaConsultada;
        history.replaceState(state, '');
      }
      abrir.focus({ preventScroll: true });
    });
  }
</script>

<style>
  :global(html:has(#fichas-tecnicas-portada[open])) {
    overflow: hidden;
    scrollbar-gutter: stable;
  }
  .fichas-portada {
    --fichas-gutter: clamp(20px, 4vw, 32px);
    position: fixed;
    inset: 0;
    width: min(1040px, calc(100% - 24px));
    max-width: none;
    max-height: none;
    margin: auto;
    padding: 0;
    border: 1px solid var(--empresa-line);
    background: var(--empresa-paper);
    color: var(--empresa-ink);
    color-scheme: light;
    overflow: hidden;
  }
  .fichas-portada::backdrop { background: rgb(10 11 13 / .72); }
  .fichas-portada__panel {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr);
    max-height: calc(100dvh - 28px);
  }
  .fichas-portada__cabecera {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: var(--s2);
    padding: var(--s2) var(--fichas-gutter);
    border-bottom: 1px solid var(--empresa-line);
  }
  .fichas-portada__cabecera h2 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    font-weight: 600;
    line-height: 1.15;
    letter-spacing: normal;
  }
  .fichas-portada__cerrar {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--empresa-line);
  }
  .fichas-portada__cerrar:hover { border-color: var(--empresa-ink); }
  .fichas-portada__lectura {
    display: grid;
    grid-template-columns: minmax(0, 192px) minmax(0, 1fr);
    min-height: 0;
  }
  .fichas-portada__indice {
    display: grid;
    align-content: start;
    gap: 2px;
    padding: var(--s2) var(--s1);
    border-right: 1px solid var(--empresa-line);
    overflow-y: auto;
    overscroll-behavior: contain;
  }
  .fichas-portada__selector {
    padding: 8px var(--fichas-gutter);
    border-bottom: 1px solid var(--empresa-line);
  }
  .fichas-portada__selector select {
    width: 100%;
    min-height: 44px;
    padding-inline: 8px;
    border: 1px solid var(--empresa-muted);
    border-radius: 0;
    background: var(--empresa-paper);
    color: inherit;
    font: inherit;
    font-weight: 600;
    appearance: auto;
  }
  .fichas-portada__selector[hidden], .fichas-portada__indice[hidden] { display: none; }
  .fichas-portada__indice button {
    min-height: 44px;
    padding: 8px 12px;
    text-align: left;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.25;
  }
  .fichas-portada__indice button:hover { background: rgb(0 0 0 / .05); }
  .fichas-portada__indice button[aria-selected='true'] {
    background: #f5f6f5;
    box-shadow: inset 3px 0 var(--red);
  }
  .fichas-portada__indice button:focus-visible { outline-offset: -3px; }
  .fichas-portada__contenido {
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: var(--s3) var(--fichas-gutter);
    scrollbar-width: thin;
  }
  .fichas-portada__contenido [role='tabpanel']:focus-visible { outline-offset: -2px; }
  .fichas-portada__grupos {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: var(--s3);
  }
  .fichas-portada h3 {
    margin-bottom: var(--s2);
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: normal;
  }
  .fichas-portada h4 {
    margin-bottom: var(--s1);
    font-weight: 600;
    font-size: 1.125rem;
    line-height: 1.25;
    letter-spacing: normal;
  }
  .fichas-portada .lista {
    gap: var(--s1);
    color: var(--empresa-muted);
    font-size: 1rem;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }
  .fichas-portada__referencias {
    margin-top: var(--s3);
    padding-top: var(--s2);
    border-top: 1px solid var(--empresa-line);
  }
  .fichas-portada__acciones {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--s3);
    margin-top: var(--s2);
  }
  .fichas-portada__acciones a {
    display: inline-flex;
    align-items: center;
    gap: var(--s1);
    min-height: 44px;
    font-size: 1rem;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 4px;
  }
  .fichas-portada__acciones :global(svg) { flex: none; }
  @media (max-width: 720px) {
    .fichas-portada__lectura {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: auto minmax(0, 1fr);
    }
    .fichas-portada__grupos { grid-template-columns: minmax(0, 1fr); }
  }
</style>
