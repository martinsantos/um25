---
import animation from '../../assets/access-3104/lectura.gif?url';
import poster from '../../assets/access-3104/lector.webp?url';
interface Props { inline?: boolean }
const { inline = false } = Astro.props;
const Heading = inline ? 'h3' : 'h2';
---
<section class:list={[inline ? 'credential-inline' : 'sec']} id={inline ? 'lectura-de-credencial' : 'flujo'} aria-labelledby="credential-title">
  <div class:list={[!inline && 'wrap']}>
    <div class:list={[!inline && 'sec__head']}><Heading id="credential-title">Cómo se lee una credencial<span class="dot">.</span></Heading></div>
    <div class="sequence">
      <figure data-flow-gif={animation} aria-label="Secuencia ilustrativa de un lector de credenciales">
        <div data-flow-art><img src={poster} width="512" height="320" loading="lazy" alt="Una credencial frente al lector de proximidad" /></div>
      </figure>
      <ol>
        <li><strong>Credencial</strong><p>La persona acerca la tarjeta al lector de proximidad.</p></li>
        <li><strong>Validación</strong><p>El sistema comprueba si tiene permiso para ese acceso.</p></li>
        <li><strong>Respuesta</strong><p>El lector enciende la luz verde cuando autoriza el ingreso.</p></li>
      </ol>
    </div>
  </div>
</section>
<script>
  import { initFlowMotion } from './service-motion';
  initFlowMotion(document);
</script>
<style>
  section { scroll-margin-top:5.5rem; }
  .credential-inline { margin:0 0 var(--s4); }
  .credential-inline h3 { font-size:clamp(1.2rem,2vw,1.6rem); line-height:1.2; margin:0 0 var(--s2); }
  .sequence { display:grid;grid-template-columns:minmax(0, min(52%, 36rem)) minmax(0, 1fr);align-items:center;gap:var(--s4); }
  figure { margin:0; }
  [data-flow-art] { position:relative;aspect-ratio:8/5; }
  img, [data-flow-art] :global(.flow-gif) { display:block;width:100%;height:100%;object-fit:contain; }
  [data-flow-art] :global(.flow-gif) { position:absolute;inset:0;opacity:0; }
  [data-flow-running] [data-flow-art] :global(.flow-gif) { opacity:1; }
  ol { max-width:48ch; padding:0;margin:0;list-style-position:inside; }
  li { padding:14px 0;border-top:1px solid var(--line); }
  li::marker { color:var(--ink-2); }
  p { color:var(--ink-2);margin:4px 0 0; }
  @media(max-width:720px){ .sequence {grid-template-columns:1fr;gap:var(--s2);} }
  @media(prefers-reduced-motion:reduce){ [data-flow-art] :global(.flow-gif) {display:none;} }
</style>
