---
import { directoryCardId } from '../../data/navigation';
import ObraPrincipal from './ObraPrincipal.astro';
import { ArrowRight, ChevronDown, ChevronRight, FolderOpen } from 'lucide-astro';
import type { Project } from './portadaCases';
import { srcsetDe } from './isoData';

interface Props {
  sector?: boolean;
  feature?: Project;
  hasWorks?: boolean;
  lang?: 'es' | 'en';
  title: string;
  intro: string;
  items: {
    name: string;
    summary: string;
    count: number;
    photo: string;
    href: string;
    archiveHref: string;
    detailHref: string;
    detailLabel: string;
    shortcuts?: { href: string; label: string }[];
    reference?: { title: string; href: string; client?: string };
  }[];
}
const { title, intro, items, feature, hasWorks = false, sector = false, lang = 'es' } = Astro.props;
const english = lang === 'en';
const langOfDetails = english ? 'es-AR' : undefined;
const directory = english
  ? { choose: sector ? 'Choose an industry' : 'Choose a service', comparison: sector ? 'Industry comparison' : 'Service comparison', compare: 'Compare', browse: 'Browse the catalogue' }
  : { choose: sector ? 'Elegir sector' : 'Elegir servicio', comparison: sector ? 'Comparación de sectores' : 'Comparación de servicios', compare: 'Comparar', browse: sector ? 'Directorio de sectores y obras' : 'Directorio de servicios y obras' };

---
<header class="cabecera-catalogo">
  <div class="catalogo-intro">
    <h1>{title}<span class="dot">.</span></h1><p>{intro}</p>
    <nav class="atajos" aria-label={directory.browse}>
      <details class="eleccion">
        <summary>{directory.choose} <ChevronDown size={17} aria-hidden="true" /></summary>
        <ul class="eleccion-lista">
          {items.map(item => <li><a href={english ? '#' + directoryCardId(item.href) : item.href}>{item.name}<ChevronRight size={15} aria-hidden="true" /></a></li>)}
        </ul>
      </details>
      <a class="indice indice-comparar" href="#catalogo" aria-label={english ? `Compare all ${items.length} services` : `Comparar los ${items.length} ${sector ? 'sectores' : 'servicios'}`}>{directory.compare} <span aria-hidden="true">↓</span></a>
    </nav>
  </div>
</header>
{feature && <div class="obra-apertura"><ObraPrincipal obra={feature} moreWorks={hasWorks} /></div>}
<ol id="catalogo" tabindex="-1" aria-label={directory.comparison} class:list={["catalogo", { "catalogo--sectores": sector }]}>
  {items.map(({ name, summary, count, photo, href, archiveHref, detailHref, detailLabel, reference, shortcuts }) => (
    <li>
      <a id={directoryCardId(href)} href={href} hreflang={langOfDetails} class="catalogo-ficha" aria-label={english ? `${name} · Service details in Spanish` : name}>
        <img src={photo} srcset={srcsetDe(photo)} sizes={sector ? "auto, (max-width:700px) 27vw, (max-width:960px) 45vw, 30vw" : "auto, (max-width:700px) 27vw, 14vw"}
          alt="" width="1672" height="941" loading="lazy" decoding="async" />
        <h2>{name}</h2>
        {(!reference || !sector) && <p class="resumen">{summary}</p>}
        {english && <span class="idioma-ficha">Service details (ES) <span aria-hidden="true">↗</span></span>}
      </a>
      {shortcuts && shortcuts.length > 0 && (
        <ul class="prestaciones" aria-label={`Accesos a prestaciones de ${name}`}>
          {shortcuts.map(({ href, label }) => (
            <li><a href={href}>{label}<ChevronRight size={14} aria-hidden="true" /></a></li>
          ))}
        </ul>
      )}
      {reference && <a id={'obra-' + directoryCardId(href)} href={reference.href + '?' + new URLSearchParams({ desde: 'directorio', [sector ? 'sector' : 'sistema']: href.split('/').filter(Boolean).at(-1)! })} class="obra-ejemplo">
        <span>{reference.client || 'Obra de referencia'}</span>
        <strong>{reference.title}<span aria-hidden="true">&nbsp;↗</span></strong>
      </a>}
      <div class="acciones">
        <a href={detailHref} aria-label={detailLabel + ' · ' + name}>
          {detailLabel}<ArrowRight size={16} aria-hidden="true" />
        </a>
        {count > 0 && (
          <a class="archivo" href={archiveHref} hreflang={langOfDetails}
            aria-label={english ? `${count} ${count === 1 ? 'project' : 'projects'} in Spanish · ${name}` : `Ver ${count} ${count === 1 ? 'antecedente' : 'antecedentes'} · ${name}`}>
            <FolderOpen size={16} aria-hidden="true" />{count}
            {english ? count === 1 ? 'project (ES)' : 'projects (ES)' : count === 1 ? 'antecedente' : 'antecedentes'}
          </a>
        )}
      </div>
    </li>
  ))}
</ol>
<slot />
<style>
  .cabecera-catalogo { padding-block:clamp(22px,3vw,46px); }
  .catalogo-intro { display:grid; grid-template-columns:minmax(0,1.15fr) minmax(0,1fr); gap:4px clamp(24px,6vw,88px); align-items:end; }
  .catalogo-intro h1 { grid-row:span 2; font-size:clamp(2.4rem,4.8vw,5.1rem); line-height:1; letter-spacing:-.06em; text-wrap:balance; }
  .catalogo-intro p { max-width:47ch; color:var(--ink-2); line-height:1.5; }
  .atajos { container-type:inline-size; display:grid; grid-template-columns:minmax(0,1fr) auto; align-items:start; column-gap:clamp(8px,2vw,24px); margin-top:8px; }
  .eleccion { grid-column:1 / -1; grid-row:1; min-width:0; }
  .eleccion summary { display:flex; align-items:center; justify-content:space-between; gap:16px; width:fit-content; max-width:100%; min-height:44px; padding:6px 14px; color:var(--ink); background:var(--bg-2); border:1px solid var(--ink-3); font-weight:600; cursor:pointer; }
  .eleccion summary::-webkit-details-marker { display:none; }
  .eleccion summary:focus-visible { outline:2px solid var(--ink); outline-offset:2px; }
  .eleccion[open] summary svg { transform:rotate(180deg); }
  .eleccion-lista { list-style:none; padding:0; margin:14px 0 0; display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); column-gap:clamp(12px,2vw,28px); }
  .eleccion-lista li { border-top:1px solid var(--line); }
  .eleccion-lista a { display:flex; align-items:center; justify-content:space-between; gap:4px; min-height:48px; padding:6px 2px; font-size:1rem; line-height:1.25; }
  .eleccion-lista svg { flex:none; color:var(--ink-2); }
  .indice-comparar { grid-column:2; grid-row:1; align-self:start; z-index:1; }
  @container (max-width:340px) {
    .eleccion summary { gap:6px; padding-inline:8px; }
    .eleccion-lista { grid-template-columns:minmax(0,1.12fr) minmax(0,1fr); column-gap:10px; }
    .eleccion-lista a { font-size:.9375rem; letter-spacing:-.01em; overflow-wrap:anywhere; }
    .eleccion-lista svg { display:none; }
  }
  .indice,.acciones a { display:inline-flex;align-items:center;gap:8px;min-height:44px;font-weight:600; }
  .obra-apertura { margin-bottom:clamp(24px,3vw,44px); }
  .catalogo {position:relative;--cols:2;display:grid;grid-template-columns:repeat(var(--cols),minmax(0,1fr));gap:18px clamp(20px,2.6vw,44px);padding:0 0 var(--s5);list-style:none;}
  .catalogo:focus-visible { outline:none; }
  .catalogo:focus-visible::before { content:""; position:absolute; inset:-4px 0 auto; height:2px; background:var(--red); }
  .catalogo--sectores {--cols:3;}
  .catalogo > li {min-width:0;border-top:1px solid var(--line);padding-block:16px 0;display:flex;flex-direction:column;}
  .catalogo-ficha {position:relative; display:block;}
  .catalogo:not(.catalogo--sectores) .catalogo-ficha {padding-left:calc(28% + 16px);min-height:100px;}
  .catalogo-ficha img {object-fit:cover;display:block;width:100%;aspect-ratio:2.1;}
  .catalogo:not(.catalogo--sectores) img {width:28%;height:100%;position:absolute;left:0;top:0;}
  .catalogo h2 {font-size:clamp(1.18rem,1.7vw,1.7rem);line-height:1.12;margin-top:6px;letter-spacing:-.025em;}
  .catalogo--sectores h2 {margin-top:14px;}
  .prestaciones { display:flex; flex-wrap:wrap; gap:0 20px; list-style:none; margin:6px 0 0; padding:0; border-block:1px solid var(--line); }
  .prestaciones li { min-width:0; }
  .prestaciones a { display:inline-flex; align-items:center; gap:5px; min-height:44px; font-size:.9rem; font-weight:600; line-height:1.25; }
  .prestaciones svg { flex:none; color:var(--red-text); }
  .obra-ejemplo { scroll-margin-top:calc(var(--top-h) + 10px); display:grid; align-content:start; gap:3px; margin-block:8px; color:var(--ink); min-height:44px; }
  .obra-ejemplo > span { font-size:.875rem; color:var(--ink-2); }
  .obra-ejemplo strong { font-size:1rem; font-weight:500; line-height:1.35; }
  .catalogo:not(.catalogo--sectores) .obra-ejemplo { border-inline-start:2px solid var(--line); padding-inline-start:12px; margin-block:14px 4px; }
  .idioma-ficha { display:block; margin-top:4px; color:var(--ink-2); font-size:.875rem; line-height:1.35; }
  .resumen {line-height:1.45;color:var(--ink-2);margin:7px 0;}
  .acciones {display:flex;gap:0 14px;flex-wrap:wrap;margin-top:auto;}
  .acciones a {font-size:.9rem;}
  .archivo {color:var(--ink-2);}
  a:focus-visible {outline:2px solid currentColor;outline-offset:3px;}
  a:hover {text-decoration:underline;text-underline-offset:4px;}
  .catalogo-ficha:hover {text-decoration:none;}
  .catalogo-ficha:target h2,.catalogo-ficha:hover h2 {text-decoration:underline;text-underline-offset:4px;}
  @media(max-width:960px) { .catalogo--sectores {--cols:2;} }
  @media(max-width:700px) {
    .catalogo-intro {grid-template-columns:1fr;gap:8px;}
    .catalogo-intro h1 {grid-row:auto;}
    .catalogo {--cols:1;}
    .catalogo > li { padding-top:14px; }
    .catalogo .catalogo-ficha { display:grid; grid-template-columns:clamp(80px,26vw,148px) minmax(0,1fr); grid-template-rows:auto 1fr; gap:4px 14px; }
    .catalogo:not(.catalogo--sectores) .catalogo-ficha {padding-left:0;min-height:0;}
    .catalogo .catalogo-ficha img { grid-column:1; grid-row:1/3; width:100%; height:auto; position:static; aspect-ratio:1.12; }
    .catalogo .catalogo-ficha h2 { grid-column:2; margin:0; }
    .catalogo .resumen { grid-column:2; margin:0; }
    .catalogo .idioma-ficha { grid-column:2; }
    .catalogo--sectores li:has(.obra-ejemplo) { position:relative; --thumb:clamp(80px,26vw,148px); display:grid; grid-template-columns:var(--thumb) minmax(0,1fr); grid-template-rows:auto 1fr auto; column-gap:14px; }
    .catalogo--sectores li:has(.obra-ejemplo)::before { content:""; grid-column:1; grid-row:1 / 3; align-self:start; aspect-ratio:1.12; }
    .catalogo--sectores li:has(.obra-ejemplo) .catalogo-ficha { display:flex; align-items:center; position:static; grid-column:2; grid-row:1; min-height:44px; }
    .catalogo--sectores li:has(.obra-ejemplo) .catalogo-ficha img { position:absolute; left:0; top:14px; width:var(--thumb); }
    .obra-ejemplo { grid-column:2; margin:5px 0 0; }
    .acciones { grid-column:1 / -1; margin-top:6px; }

  }
</style>
