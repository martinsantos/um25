---
import { srcsetDe } from './isoData';

interface Props {
  title: string;
  intro: string;
  action: string;
  items: { name: string; summary: string; count: number; photo: string; href: string }[];
}
const { title, intro, action, items } = Astro.props;
---
<div class="catalogo-intro">
  <h1>{title}<span class="dot">.</span></h1>
  <p>{intro}</p>
</div>
<ol class="catalogo">
  {items.map(({ name, summary, count, photo, href }, index) => (
    <li>
      <a href={href} class="catalogo-fila">
        <figure>
          <img src={photo} srcset={srcsetDe(photo)} sizes="(max-width: 400px) 76px, (max-width: 900px) 96px, 144px"
            alt="" width="1672" height="941" loading={index < 4 ? 'eager' : 'lazy'} decoding="async" />
        </figure>
        <div class="catalogo-texto">
          <h2>{name}</h2>
          <p>{summary}</p>
          <div class="catalogo-pie">
            {count > 0 && <span>{count} {count === 1 ? 'antecedente' : 'antecedentes'}</span>}
            <strong>{action} <span aria-hidden="true">→</span></strong>
          </div>
        </div>
      </a>
    </li>
  ))}
</ol>
<style>
  .catalogo-intro { padding-block: var(--s4); }
  .catalogo-intro h1 { font-size: clamp(2rem, 4.4vw, 3.5rem); line-height: 1.08; }
  .catalogo-intro p { margin-top: var(--s2); max-width: 64ch; color: var(--ink-2); font-size: 1.125rem; }
  .catalogo { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); column-gap: clamp(28px, 4vw, 64px); margin: 0; padding: 0 0 var(--s6); list-style: none; }
  .catalogo li { min-width: 0; border-top: 1px solid var(--line); }
  .catalogo-fila { display: grid; grid-template-columns: clamp(96px, 10vw, 144px) minmax(0, 1fr); gap: clamp(16px, 2vw, 24px); align-items: start; padding-block: 24px; height: 100%; }
  figure { margin: 0; aspect-ratio: 4 / 3; background: var(--bg-2); overflow: hidden; }
  img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .catalogo-texto { display: grid; gap: 8px; min-width: 0; overflow-wrap: anywhere; }
  h2 { font-size: clamp(1.25rem, 2vw, 1.625rem); line-height: 1.2; }
  p { margin: 0; color: var(--ink-2); line-height: 1.5; }
  .catalogo-pie { display: flex; flex-wrap: wrap; gap: 4px 16px; color: var(--ink-3); line-height: 1.5; }
  strong { color: var(--ink); font-weight: 600; }
  .catalogo-fila:hover strong { text-decoration: underline; text-decoration-color: var(--red); text-underline-offset: 4px; }
  @media (max-width: 900px) {
    .catalogo-intro { padding-block: 32px 24px; }
    .catalogo-intro p { font-size: 1.0625rem; }
    .catalogo { grid-template-columns: minmax(0, 1fr); }
    .catalogo-fila { grid-template-columns: 96px minmax(0, 1fr); }
  }
  @media (max-width: 400px) {
    .catalogo-fila { grid-template-columns: clamp(56px, 19vw, 76px) minmax(0, 1fr); gap: 12px; padding-block: 20px; }
    h2 { font-size: clamp(1.125rem, 5.25vw, 1.25rem); }
  }
</style>
