---
import OperationsScene from "./OperationsScene.astro";
import type { OperationsContent } from "../../data/operationsScenes";
interface Props { content: OperationsContent }
const { content } = Astro.props;
---
<section
  class="sec operations-section"
  id="flujo"
  aria-labelledby="operations-heading"
>
  <div class="wrap">
    <div class="ops-heading">
      <div>
        <p>{content.kicker}</p><h2 id="operations-heading">
          {content.title.replace(/\.$/, "")}<span class="dot">.</span>
        </h2>
      </div><p>{content.description}</p>
    </div>
    <OperationsScene content={content} />
  </div>
</section>
