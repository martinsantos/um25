---
import { ClipboardCheck, FileText, Map, Network } from 'lucide-astro';
import { publicCaseFor } from './casePresentation';
import type { Story } from './isoData';

interface Props { story?: Story; lang?: 'es' | 'en'; headingLevel?: 3 | 4 }
const { story, lang = 'es', headingLevel = 4 } = Astro.props;
const Title = headingLevel === 3 ? 'h3' : 'h4';
const SectionTitle = headingLevel === 3 ? 'h4' : 'h5';
const caso = story?.id === 3102 ? publicCaseFor(story) : undefined;
const t = (es: string, en: string) => lang === 'en' ? en : es;
const labels: Record<string, string> = {
  'puestos simples de datos Cat. 6 LSZH': 'Single Cat 6 LSZH data outlets',
  'puestos dobles de datos Cat. 6 LSZH': 'Dual Cat 6 LSZH data outlets',
  'rack de piso · 1000 mm': 'Floor-standing rack · 1000 mm',
  'racks murales · 500 mm': 'Wall-mounted racks · 500 mm',
};
---
<div class="dossier-obra" data-dossier-obra>
  <header class="dossier-obra__cabecera">
    <p class="dossier-obra__rotulo"><FileText size={18} stroke-width={1.6} aria-hidden="true" /> {caso ? t('Muestra de obra', 'Project example') : t('Ejemplo de entrega', 'Handover example')}</p>
    <Title class="dossier-obra__titulo">{caso ? 'Hospital General Las Heras' : t('Una instalación de cableado', 'A cabling installation')}</Title>
    {caso && <p class="dossier-obra__meta">{['Tupungato, Mendoza', story?.year, `UM-${caso.id}`].filter(Boolean).join(' · ')}</p>}
  </header>

  <section class="dossier-obra__paso">
    <Network size={23} stroke-width={1.5} aria-hidden="true" />
    <div>
      <SectionTitle class="dossier-obra__subtitulo">{t('Inventario de la instalación', 'Installation inventory')}</SectionTitle>
      {caso ? (
        <dl class="dossier-obra__inventario">
          {caso.evidence.map(({ label, value }) => (
            <div><dt lang={lang === 'en' && !labels[label] ? 'es-AR' : undefined}>{lang === 'en' ? labels[label] || label : label}</dt><dd>{value}</dd></div>
          ))}
        </dl>
      ) : (
        <p>{t('Registra la cantidad, la categoría y el tipo de puestos, la capacidad de los racks y el alcance del tendido.', 'The inventory records outlet counts, cabling category, rack capacity and the extent of the cabling installation.')}</p>
      )}
    </div>
  </section>

  <div class="dossier-obra__entregables">
    <p class="dossier-obra__referencia">{t('Entregables según la ficha técnica de Redes', 'Handover documents in our networking specification')}</p>
    <section class="dossier-obra__paso">
      <ClipboardCheck size={23} stroke-width={1.5} aria-hidden="true" />
      <div>
        <SectionTitle class="dossier-obra__subtitulo">{t('Certificación y protocolos de prueba', 'Certification and test protocols')}</SectionTitle>
        <p>{t('El informe de certificación identifica cada enlace ensayado y reúne sus mediciones. Los protocolos registran las verificaciones acordadas.', 'The certification report identifies each tested link and records its measurements. Test protocols record the agreed checks.')}</p>
      </div>
    </section>
    <section class="dossier-obra__paso">
      <Map size={23} stroke-width={1.5} aria-hidden="true" />
      <div>
        <SectionTitle class="dossier-obra__subtitulo">{t('Plano conforme a obra y memoria técnica', 'As-built drawings and technical report')}</SectionTitle>
        <p>{t('El plano y los rótulos permiten localizar puntos y racks. La memoria deja constancia de lo instalado para que otro técnico pueda intervenir o ampliar la red.', 'The drawings and labels help locate outlets and racks. The technical report records what was installed so another engineer can service or extend the network.')}</p>
      </div>
    </section>
  </div>
</div>

<style>
  .dossier-obra {
    --dossier-gutter: clamp(16px, 3.2vw, 40px);
    grid-area: muestra;
    min-width: 0;
    align-self: start;
    color: var(--empresa-ink);
    background: var(--empresa-paper);
    border-top: 3px solid var(--red);
  }
  .dossier-obra__cabecera { padding: var(--s3) var(--dossier-gutter) var(--s2); }
  .dossier-obra__rotulo {
    display: flex;
    align-items: center;
    gap: var(--s1);
    color: var(--empresa-muted);
    font-size: 1rem;
    font-weight: 600;
  }
  .dossier-obra__titulo {
    margin-top: var(--s1);
    font-size: clamp(1.5rem, 2.65vw, 2.25rem);
    font-weight: 600;
    line-height: 1.15;
    text-wrap: balance;
  }
  .dossier-obra__meta { margin-top: 4px; color: var(--empresa-muted); }
  .dossier-obra__paso {
    display: grid;
    grid-template-columns: 23px minmax(0, 1fr);
    gap: var(--s1);
    margin-inline: var(--dossier-gutter);
    padding-block: var(--s2);
    border-top: 1px solid var(--empresa-line);
  }
  .dossier-obra__paso > :global(svg) { margin-top: 1px; color: var(--empresa-muted); }
  .dossier-obra__subtitulo {
    font-size: clamp(1.125rem, 1.5vw, 1.375rem);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: normal;
  }
  .dossier-obra__paso p {
    max-width: 61ch;
    margin-top: 6px;
    color: var(--empresa-muted);
    font-size: 1rem;
    line-height: 1.5;
  }
  .dossier-obra__inventario {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px var(--s2);
    margin: var(--s1) 0 0;
  }
  .dossier-obra__inventario > div {
    display: flex;
    flex-direction: column;
    align-items: start;
    gap: 2px;
  }
  .dossier-obra__inventario dt { color: var(--empresa-muted); font-size: 1rem; line-height: 1.3; }
  .dossier-obra__inventario dd {
    order: -1;
    font-size: clamp(1.25rem, 2vw, 1.625rem);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    line-height: 1.15;
  }
  .dossier-obra__entregables { background: rgb(0 0 0 / .04); border-top: 1px solid var(--empresa-line); }
  .dossier-obra__referencia {
    margin-inline: var(--dossier-gutter);
    padding-block: var(--s2) 0;
    color: var(--empresa-muted);
    font-size: 1rem;
    font-weight: 600;
    line-height: 1.3;
  }
  .dossier-obra__referencia + .dossier-obra__paso { border-top: 0; }
</style>
