            }
          } else if (baseCommand === 'portfolio') {
            const count = parseInt(params[0]) || 3;
            const maxCount = Math.min(count, 10);
            response = this.getPortfolioCommand(maxCount);
          } else if (baseCommand === 'services') {
            response = params[0] 
              ? this.getServicesCommand(params[0]) 
              : this.getServicesCommand();
          } else if (baseCommand === 'demo') {
            response = this.getDemoCommand();
          } else if (baseCommand === 'quote') {
            response = this.getQuoteCommand();
          } else if (baseCommand === 'matrix') {
            response = this.getMatrixCommand();
          } else if (baseCommand === 'security') {
            response = this.getSecurityCommand();
          } else if (baseCommand === 'infrastructure') {
            response = this.getInfrastructureCommand();
          } else if (baseCommand === 'projects') {
            response = this.getProjectsCommand();
          } else if (baseCommand === 'clients') {
            response = this.getClientsCommand();
          } else {
            response = `<span style="color: #ef4444;">Comando no reconocido: "${command}"</span>
Escribe <code>help</code> para ver los comandos disponibles.

<span style="color: #7ee787;">💡 Sugerencia:</span> Usa <code>TAB</code> para autocompletado o <code>help</code> para la lista completa.`;
            commandSuccess = false; // Mark as failed command
          }
      }

      commandOutput.innerHTML = `
        <div style="margin-bottom: 8px;">
          <span style="color: #00d4aa;">visitante@ultimamilla:~$</span> ${command}
        </div>
        <div style="margin-bottom: 16px; padding-left: 16px;">
          ${response}
        </div>`;

      if (this.output) {
        this.output.appendChild(commandOutput);
        this.output.scrollTop = this.output.scrollHeight;
