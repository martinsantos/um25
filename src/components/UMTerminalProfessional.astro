        default:
          // Handle commands with parameters
          const [baseCommandRaw, ...params] = command.split(' ');
          const baseCommand = this.normalizeCommand(baseCommandRaw);
          
          if (baseCommand === 'ls' || baseCommand === 'list') {
            if (params.length > 0) {
              // Handle 'ls servicios' or 'ls [category]'
              response = this.getServicesCommand(params[0]);
            } else {
              // Default ls command
              response = `
