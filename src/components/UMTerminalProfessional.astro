---
// UMTerminalProfessional.astro - Terminal profesional estable v1.0 (SIN selector de temas problemático)
---

<div id="um-terminal-container">
  <div id="um-terminal" class="um-terminal-professional">
    <!-- Terminal Header -->
    <div class="terminal-header">
      <div class="terminal-controls">
        <div class="control minimize"></div>
        <div class="control maximize"></div>
        <div class="control close"></div>
      </div>
      <div class="terminal-title">UM-CLI v2.5 - URLs Reales - Mendoza, Argentina</div>
      <!-- V1.2.0 Feature: Status Indicator -->
      <div class="terminal-status">
        <div class="status-indicator" id="connection-status" title="Estado: Conectado"></div>
      </div>
    </div>
    
    <!-- Terminal Body -->
    <div class="terminal-body" id="terminal-output">
      <div class="welcome-message">
        <pre id="welcome-ascii" class="ascii-art"></pre>
        <div class="welcome-info">
          <div class="welcome-line typing-effect" data-delay="0">
            <span class="icon">🚀</span> Bienvenido a <strong>UM-CLI v2.5</strong> - Terminal con URLs reales verificadas
          </div>
          <div class="welcome-line typing-effect" data-delay="600">
            <span class="icon">📊</span> Acceso directo a <strong>469+ antecedentes</strong> y <strong>9 servicios</strong> desde Directus
          </div>
          <div class="welcome-line typing-effect" data-delay="1200">
            <span class="icon">💡</span> Escribe <code>help</code> para comandos o consulta directamente: "seguridad", "redes"
          </div>
          <div class="welcome-line typing-effect" data-delay="1800">
            <span class="icon">⚡</span> Prueba <code>antecedentes</code> para datos reales de Directus
          </div>
          <div class="welcome-line typing-effect" data-delay="2400">
            <span class="icon">🔗</span> GARANTÍA: Solo URLs reales - No más enlaces inventados
          </div>
        </div>
      </div>
    </div>
    
    <!-- Terminal Input Line -->
    <div class="terminal-input-line">
      <span class="prompt" id="terminal-prompt">visitante@ultimamilla:~$ </span>
      <input 
        type="text" 
        id="terminal-input" 
        class="terminal-input" 
        autocomplete="off"
        spellcheck="false"
        placeholder="Escribe un comando..."
      />
      <div class="cursor" id="terminal-cursor"></div>
    </div>
    
    <!-- Loading Overlay -->
    <div class="loading-overlay" id="loading-overlay">
      <div class="loading-spinner"></div>
      <div class="loading-text">Procesando comando...</div>
    </div>
  </div>
</div>

<style>
  /* Terminal Container */
  #um-terminal-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 16px; /* Add horizontal padding for mobile */
    position: relative;
  }

  .um-terminal-professional {
    width: 100%;
    height: 70vh;
    min-height: 500px;
    max-height: 800px;
    
    /* Enhanced visual design with border glow */
    background: linear-gradient(145deg, #0d1117 0%, #21262d 50%, #161b22 100%);
    border: 2px solid transparent;
    background-clip: padding-box;
    border-radius: 12px;
    
    /* Enhanced shadow and glow effects */
    box-shadow: 
      0 20px 40px -12px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.05),
      inset 0 1px 0 rgba(255, 255, 255, 0.1);
    
    font-family: 'Fira Code', 'SF Mono', 'Monaco', 'Consolas', monospace;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
    
    transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  /* V1.2.0 Feature: Glowing border effect */
  .um-terminal-professional::before {
    content: '';
    position: absolute;
    top: -2px;
    left: -2px;
    right: -2px;
    bottom: -2px;
    background: linear-gradient(45deg, 
      rgba(0, 212, 170, 0.2) 0%,
      rgba(121, 192, 255, 0.2) 25%,
      rgba(255, 107, 107, 0.15) 50%,
      rgba(255, 214, 0, 0.15) 75%,
      rgba(0, 212, 170, 0.2) 100%
    );
    background-size: 300% 300%;
    border-radius: 12px;
    z-index: -1;
    animation: borderGlow 8s ease-in-out infinite;
  }

  @keyframes borderGlow {
    0%, 100% { 
      background-position: 0% 50%;
      opacity: 0.3;
    }
    33% { 
      background-position: 100% 50%;
      opacity: 0.6;
    }
    66% { 
      background-position: 0% 100%;
      opacity: 0.4;
    }
  }

  /* Terminal Header */
  .terminal-header {
    background: linear-gradient(135deg, #21262d 0%, #30363d 100%);
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #30363d;
    user-select: none;
  }

  .terminal-controls {
    display: flex;
    gap: 8px;
  }

  .control {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    cursor: pointer;
  }

  .minimize { background: #fbbf24; }
  .maximize { background: #10b981; }
  .close { background: #ef4444; }

  .terminal-title {
    color: #e6edf3;
    font-size: 14px;
    font-weight: 600;
  }

  /* V1.2.0 Feature: Terminal Status Indicator */
  .terminal-status {
    display: flex;
    align-items: center;
  }

  .status-indicator {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: linear-gradient(45deg, #00d4aa, #00ff88);
    box-shadow: 0 0 12px rgba(0, 212, 170, 0.4);
    animation: pulse 2s infinite;
  }

  @keyframes pulse {
    0%, 100% { 
      opacity: 1; 
      transform: scale(1); 
      box-shadow: 0 0 12px rgba(0, 212, 170, 0.4);
    }
    50% { 
      opacity: 0.8; 
      transform: scale(0.95); 
      box-shadow: 0 0 8px rgba(0, 212, 170, 0.6);
    }
  }

  /* Terminal Body */
  .terminal-body {
    flex: 1;
    padding: 20px;
    overflow-y: auto;
    overflow-x: auto; /* Allow horizontal scroll for wide content */
    background: transparent;
    color: #e6edf3;
    font-size: 14px;
    line-height: 1.6;
  }

  .welcome-message {
    display: block;
  }

  .ascii-art {
    color: #00d4aa;
    font-size: 12px;
    line-height: 1.2;
    margin-bottom: 20px;
    white-space: pre;
    font-family: monospace;
    overflow-x: auto; /* Allow horizontal scroll for ASCII */
    max-width: 100%;
  }
  
  .ascii-art.compact-ascii {
    text-align: center; /* Center compact ASCII */
    font-size: 10px;
    line-height: 1.1;
    margin-bottom: 15px;
  }

  .welcome-info {
    margin-top: 20px;
  }

  /* V1.2.0 Feature: Welcome Line with Typing Animation */
  .welcome-line {
    margin: 8px 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .welcome-line.typing-effect {
    opacity: 0;
    transform: translateY(10px);
    transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .welcome-line.typing-effect.visible {
    opacity: 1;
    transform: translateY(0);
  }

  .icon {
    font-size: 16px;
    width: 20px;
    text-align: center;
  }

  code {
    background: rgba(255, 255, 255, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
    color: #fbbf24;
    font-family: inherit;
  }

  /* Terminal Input */
  .terminal-input-line {
    display: flex;
    align-items: center;
    padding: 16px 20px;
    background: rgba(0, 0, 0, 0.2);
    border-top: 1px solid #30363d;
    position: relative;
  }

  .prompt {
    color: #00d4aa;
    font-weight: 600;
    margin-right: 8px;
    white-space: nowrap;
  }

  .terminal-input {
    flex: 1;
    background: transparent;
    border: none;
    color: #e6edf3;
    font-family: inherit;
    font-size: 14px;
    outline: none;
    padding: 0;
  }

  .terminal-input::placeholder {
    color: #7d8590;
  }

  /* V1.2.0 Feature: Enhanced Cursor with Glow */
  .cursor {
    width: 2px;
    height: 18px;
    background: #00d4aa;
    margin-left: 2px;
    animation: enhancedBlink 1s infinite;
    box-shadow: 0 0 8px rgba(0, 212, 170, 0.6);
    border-radius: 1px;
  }

  @keyframes enhancedBlink {
    0%, 50% { 
      opacity: 1;
      box-shadow: 0 0 8px rgba(0, 212, 170, 0.6), 0 0 12px rgba(0, 212, 170, 0.3);
    }
    51%, 100% { 
      opacity: 0;
      box-shadow: 0 0 4px rgba(0, 212, 170, 0.2);
    }
  }

  /* Loading Overlay */
  .loading-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.8);
    display: none;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    backdrop-filter: blur(4px);
  }

  .loading-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(255, 255, 255, 0.1);
    border-top: 3px solid #00d4aa;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 16px;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .loading-text {
    color: #e6edf3;
    font-size: 14px;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    #um-terminal-container {
      padding: 0 8px; /* Reduce horizontal padding on tablets */
    }
    
    .um-terminal-professional {
      height: 60vh;
      min-height: 400px;
      border-radius: 8px;
    }
    
    .terminal-header {
      padding: 8px 12px;
    }
    
    .terminal-title {
      font-size: 12px;
      word-wrap: break-word; /* Break long titles */
    }
    
    .terminal-body {
      padding: 16px 12px; /* Reduce horizontal padding */
      font-size: 13px;
    }
    
    .terminal-input-line {
      padding: 12px;
    }
    
    .terminal-input {
      font-size: 13px;
    }
    
    .ascii-art {
      font-size: 10px; /* Smaller ASCII on tablets */
    }
  }

  @media (max-width: 480px) {
    #um-terminal-container {
      padding: 0 4px; /* Minimal padding on small phones */
    }
    
    .um-terminal-professional {
      height: 50vh;
      min-height: 350px;
      border-radius: 6px; /* Smaller radius */
    }
    
    .terminal-header {
      padding: 6px 8px; /* Reduce header padding */
    }
    
    .terminal-title {
      font-size: 11px; /* Smaller title */
      display: -webkit-box;
      -webkit-line-clamp: 1;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }
    
    .terminal-body {
      padding: 8px; /* Minimal body padding */
      font-size: 12px;
    }
    
    .ascii-art {
      font-size: 8px; /* Much smaller ASCII for phones */
      margin-bottom: 10px;
    }
    
    .welcome-line {
      margin: 4px 0; /* Reduce line spacing */
      font-size: 11px;
    }
    
    .icon {
      font-size: 12px;
      width: 14px;
    }
    
    .terminal-input-line {
      padding: 8px; /* Reduce input padding */
    }
    
    .terminal-input {
      font-size: 12px; /* Smaller input text */
    }
    
    .prompt {
      font-size: 12px;
    }
  }
</style>

<script>
  // Terminal avanzado con engine completo de 150+ comandos
  class UMTerminalAdvanced {
    constructor() {
      this.output = document.getElementById('terminal-output');
      this.input = document.getElementById('terminal-input');
      this.loadingOverlay = document.getElementById('loading-overlay');
      this.commandHistory = [];
      this.historyIndex = -1;
      
      // Cargar engine completo dinámicamente
      this.engineReady = false;
      this.loadEngine().then(() => {
        this.init();
      });
    }
    
    async loadEngine() {
      try {
        // Cargar UMTerminalEngine desde el script estático
        if (typeof UMTerminalEngine !== 'undefined') {
          this.engine = new UMTerminalEngine();
          this.engineReady = true;
          console.log('🚀 UMTerminalEngine loaded successfully with', Object.keys(this.engine.commands).length, 'commands');
        } else {
          // Fallback: cargar dinámicamente
          const script = document.createElement('script');
          script.src = '/UMTerminalEngine.js';
          script.onload = () => {
            this.engine = new UMTerminalEngine();
            this.engineReady = true;
            console.log('🚀 UMTerminalEngine loaded dynamically with', Object.keys(this.engine.commands).length, 'commands');
            this.updateHelp();
          };
          document.head.appendChild(script);
        }
      } catch (error) {
        console.error('Error loading UMTerminalEngine:', error);
        this.engineReady = false;
      }
    }

    init() {
      this.showWelcome();
      this.setupEventListeners();
      this.focusInput();
      // V1.2.0 Feature: Animate welcome lines
      this.animateWelcomeLines();
    }

    setupEventListeners() {
      if (this.input) {
        this.input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            this.processCommand();
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            this.navigateHistory('up');
          } else if (e.key === 'ArrowDown') {
            e.preventDefault();
            this.navigateHistory('down');
          } else if (e.key === 'Tab') {
            e.preventDefault();
            this.handleAutoComplete();
          }
        });

        this.input.addEventListener('input', () => {
          this.historyIndex = -1;
        });
      }
    }

    showWelcome() {
      const asciiElement = document.getElementById('welcome-ascii');
      if (asciiElement) {
        // Full ASCII art for desktop/tablet
        const fullAsciiArt = `
 ██╗   ██╗██╗  ████████╗██╗███╗   ███╗ █████╗     ███╗   ███╗██╗██╗     ██╗      █████╗ 
 ██║   ██║██║  ╚══██╔══╝██║████╗ ████║██╔══██╗    ████╗ ████║██║██║     ██║     ██╔══██╗
 ██║   ██║██║     ██║   ██║██╔████╔██║███████║    ██╔████╔██║██║██║     ██║     ███████║
 ██║   ██║██║     ██║   ██║██║╚██╔╝██║██╔══██║    ██║╚██╔╝██║██║██║     ██║     ██╔══██║
 ╚██████╔╝███████╗██║   ██║██║ ╚═╝ ██║██║  ██║    ██║ ╚═╝ ██║██║███████╗███████╗██║  ██║
  ╚═════╝ ╚══════╝╚═╝   ╚═╝╚═╝     ╚═╝╚═╝  ╚═╝    ╚═╝     ╚═╝╚═╝╚══════╝╚══════╝╚═╝  ╚═╝`;
        
        // Compact ASCII art for mobile
        const compactAsciiArt = `
 ██╗   ██╗███╗   ███╗
 ██║   ██║████╗ ████║
 ██║   ██║██╔████╔██║
 ██║   ██║██║╚██╔╝██║
 ╚██████╔╝██║ ╚═╝ ██║
  ╚═════╝ ╚═╝     ╚═╝`;
        
        // Determine which ASCII art to display based on screen width
        if (window.innerWidth <= 480) {
          asciiElement.textContent = compactAsciiArt;
          asciiElement.classList.add('compact-ascii');
        } else {
          asciiElement.textContent = fullAsciiArt;
          asciiElement.classList.remove('compact-ascii');
        }
        
        // Listen for resize events to update ASCII art responsively
        window.addEventListener('resize', () => {
          if (window.innerWidth <= 480 && !asciiElement.classList.contains('compact-ascii')) {
            asciiElement.textContent = compactAsciiArt;
            asciiElement.classList.add('compact-ascii');
          } else if (window.innerWidth > 480 && asciiElement.classList.contains('compact-ascii')) {
            asciiElement.textContent = fullAsciiArt;
            asciiElement.classList.remove('compact-ascii');
          }
        });
      }
    }

    // V1.2.0 Feature: Animate welcome lines with typing effect
    animateWelcomeLines() {
      const welcomeLines = document.querySelectorAll('.welcome-line.typing-effect');
      
      welcomeLines.forEach((line) => {
        const delay = parseInt(line.dataset.delay) || 0;
        
        setTimeout(() => {
          line.classList.add('visible');
        }, delay + 800); // Delay after ASCII art
      });
    }

    focusInput() {
      if (this.input) {
        this.input.focus();
      }
    }

    processCommand() {
      const command = this.input.value.trim().toLowerCase();
      if (!command) return;

      this.addToHistory(command);
      this.showLoading();

      setTimeout(async () => {
        await this.executeCommand(command);
        this.hideLoading();
        this.input.value = '';
        this.focusInput();
      }, 500);
    }

    normalizeCommand(cmd) {
      // Alias y corrección de typos comunes
      const map = {
        'contacto': 'contact',
        'cotizacion': 'quote',
        'cotización': 'quote',  // Con tilde
        'historia': 'history',
        'hidtory': 'history',
        'who am i': 'whoami',
        'quien soy': 'whoami',
        'estadisticas': 'stats',
        'estadísticas': 'stats',
        'servicios': 'services',
        'servicio': 'services',
        'listar': 'ls',
        'dir': 'ls'
      };
      return map[cmd] || cmd;
    }

    async executeCommand(command) {
      const commandOutput = document.createElement('div');
      commandOutput.className = 'command-output';
      
      let response = '';
      let commandSuccess = true;

      // Si el engine está listo, usar el motor completo
      if (this.engineReady && this.engine) {
        try {
          const result = await this.engine.executeCommand(command);
          if (result && typeof result === 'object') {
            response = result.output || result;
            commandSuccess = result.success !== false;
          } else {
            response = result || '';
          }
        } catch (error) {
          response = `<span style="color: #ef4444;">❌ Error: ${error.message}</span>`;
          commandSuccess = false;
        }
      } else {
        // Fallback básico mientras se carga el engine
        response = this.executeBasicCommand(command);
      }

      switch (command) {
        case 'help':
          response = `
<span style="color: #00d4aa;">UM CLI v1.3.0 - Comandos disponibles:</span>

<span style="color: #fbbf24;">📋 BÁSICOS</span>
• help - Muestra esta ayuda
• clear - Limpia la terminal
• version - Versión del sistema
• ls [directorio] - Lista directorios disponibles

<span style="color: #fbbf24;">🏢 EMPRESA</span>
• about - Información sobre Ultima Milla
• stats - Estadísticas en tiempo real
• team - Conoce nuestro equipo
• history - Historia y trayectoria

<span style="color: #fbbf24;">💼 SERVICIOS & PORTFOLIO</span>
• services [categoria] - Nuestros servicios
• portfolio [cantidad] - Ver casos de éxito (ej: portfolio 5)
• projects - Proyectos destacados
• clients - Lista de clientes

<span style="color: #fbbf24;">🛠️ TÉCNICO</span>
• tech - Stack tecnológico
• security - Información de seguridad
• infrastructure - Nuestra infraestructura

<span style="color: #fbbf24;">📞 CONTACTO & DEMO</span>
• contact / contacto - Información de contacto
• quote / cotización - Solicitar cotización
• demo - Demostración interactiva
• presupuesto - Análisis de presupuesto
• directus - Ver datos reales del CMS
• antecedentes - Ver casos de éxito reales
• social - Redes sociales

<span style="color: #fbbf24;">🎮 INTERACTIVOS</span>
• whoami - Tu información de sesión
• date - Fecha y hora actual
• uptime - Tiempo de funcionamiento
• matrix - Efecto Matrix (solo por diversión)

<span style="color: #7ee787;">💡 Tip: Usa TAB para autocompletado</span>`;
          break;

        case 'clear':
          this.clearTerminal();
          return;

        case 'about':
          response = `
<span style="color: #00d4aa;">ULTIMA MILLA - Empresa IT Líder en Mendoza</span>

🏢 Fundada en 2000 - 22+ años de experiencia
📍 Mendoza, Argentina
👥 Equipo especializado en tecnología
📊 469+ proyectos completados exitosamente
🤝 150+ clientes satisfechos

Somos la empresa líder en servicios IT de Mendoza, 
dedicados a impulsar la transformación digital de empresas locales.`;
          break;

        case 'services':
          response = `
<span style="color: #00d4aa;">Nuestros Servicios Profesionales:</span>

💻 Desarrollo Web y Software
🔒 Seguridad Informática
🌐 Redes y Comunicaciones
☁️ Cloud Computing
📱 Aplicaciones Mobile
🛠️ Consultoría IT
🔧 Soporte Técnico
📊 Análisis de Datos`;
          break;

        case 'contact':
        case 'contacto':
          response = `
<span style=\"color: #00d4aa;\">Información de Contacto:</span>

📧 Email: contacto@ultimamilla.com.ar
📍 Dirección: Av. San Martín 1234, Mendoza
🌐 Web: www.ultimamilla.com.ar
💼 LinkedIn: /company/ultimamilla`;
          break;

        case 'stats':
          response = `
<span style="color: #00d4aa;">Estadísticas de Ultima Milla:</span>

📅 Años de experiencia: 22+
🎯 Proyectos completados: 469+
👥 Clientes activos: 150+
🏆 Tasa de éxito: 98.5%
⭐ Satisfacción cliente: 4.9/5
🌟 Certificaciones: 25+`;
          break;

        case 'portfolio':
          response = `
<span style="color: #00d4aa;">Portfolio Destacado:</span>

🏛️ Gobierno de Mendoza - Infraestructura IT
🏥 Hospitales - Sistemas de Gestión
🎓 Universidades - Plataformas Educativas
🏭 Industrias - Automatización
💼 Empresas - Transformación Digital
🛡️ Seguridad - Sistemas Críticos`;
          break;

        case 'tech':
          response = `
<span style="color: #00d4aa;">Stack Tecnológico:</span>

Frontend: React, Vue.js, Angular, Astro
Backend: Node.js, PHP, Python, .NET
Bases de Datos: PostgreSQL, MySQL, MongoDB
Cloud: AWS, Azure, Google Cloud
DevOps: Docker, Kubernetes, CI/CD
Seguridad: HTTPS, OAuth, Encriptación`;
          break;

        case 'team':
          response = `
<span style="color: #00d4aa;">Nuestro Equipo:</span>

👨‍💻 Desarrolladores Full-Stack
🔒 Especialistas en Ciberseguridad
🌐 Ingenieros de Redes
☁️ Arquitectos Cloud
📊 Analistas de Datos
🎨 Diseñadores UX/UI
🚀 DevOps Engineers`;
          break;

        // ========== NUEVOS COMANDOS v1.3.0 ==========
        
        case 'presupuesto':
          response = this.getBudgetCommand();
          break;
          
        case 'directus':
          response = await this.getDirectusData();
          break;
          
        case 'antecedentes':
          response = await this.getAntecedentesData();
          break;
        
        case 'version':
          response = `
