      this.commandHistory.unshift(command);
      if (this.commandHistory.length > 50) {
        this.commandHistory.pop();
      }
      this.historyIndex = -1;
    }

    navigateHistory(direction) {
      if (this.commandHistory.length === 0) return;

      if (direction === 'up') {
        if (this.historyIndex < this.commandHistory.length - 1) {
          this.historyIndex++;
        }
      } else if (direction === 'down') {
        if (this.historyIndex > -1) {
          this.historyIndex--;
        }
      }

      if (this.historyIndex >= 0) {
        this.input.value = this.commandHistory[this.historyIndex];
      } else {
        this.input.value = '';
      }
    }

    handleAutoComplete() {
      if (this.engineReady && this.engine) {
        // Autocompletion avanzado con todos los comandos del engine
        const allCommands = [
          ...Object.keys(this.engine.commands),
          ...Object.keys(this.engine.aliases || {})
        ];
        const currentValue = this.input.value.toLowerCase();
        
        // Autocompletar comandos
        const commandMatches = allCommands.filter(cmd => cmd.startsWith(currentValue));
        
        if (commandMatches.length === 1) {
          this.input.value = commandMatches[0];
        } else if (commandMatches.length > 1) {
          // Mostrar sugerencias en la próxima línea
          const suggestionDiv = document.createElement('div');
          suggestionDiv.style.color = '#7ee787';
          suggestionDiv.innerHTML = `💡 Sugerencias: ${commandMatches.slice(0, 5).join(', ')}`;
          if (this.output) {
            this.output.appendChild(suggestionDiv);
          }
        }
        
        // Autocompletar parámetros (para comandos como grep, find)
        const parts = this.input.value.split(' ');
        if (parts.length > 1 && this.engine.dynamicData) {
          this.autoCompleteParameters(parts);
        }
      } else {
        // Fallback básico
        const basicCommands = ['help', 'clear', 'contact', 'stats', 'presupuesto'];
        const currentValue = this.input.value.toLowerCase();
        const matches = basicCommands.filter(cmd => cmd.startsWith(currentValue));
        if (matches.length === 1) {
          this.input.value = matches[0];
        }
      }
    }
    
    autoCompleteParameters(parts) {
      const command = parts[0];
      const currentParam = parts[parts.length - 1];
      
      if (command === 'grep' && this.engine.dynamicData) {
        // Autocompletar nombres de clientes
        const clientes = this.engine.dynamicData.antecedentes?.map(a => a.cliente || a.Cliente).filter(Boolean) || [];
        const matches = clientes.filter(c => c.toLowerCase().includes(currentParam.toLowerCase()));
        if (matches.length > 0) {
          const suggestion = matches[0];
          parts[parts.length - 1] = `"${suggestion}"`;
          this.input.value = parts.join(' ');
        }
      }
    }
  }

  // Prevenir múltiples inicializaciones
  let terminalInstance = null;
  
  function initializeTerminal() {
    if (terminalInstance) return; // Evitar duplicados
    terminalInstance = new UMTerminalAdvanced();
  }
  
  // Inicialización segura
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeTerminal);
  } else {
    initializeTerminal();
  }
</script>
