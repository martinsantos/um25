---
// UM Terminal Desktop - Consistente con móvil
---

<div class="um-terminal-desktop-container">
  <div class="terminal-header">
    <div class="window-controls">
      <span class="control-red"></span>
      <span class="control-yellow"></span>
      <span class="control-green"></span>
    </div>
    <h3>UM CLI v2.5 - Desktop</h3>
  </div>
  
  <div class="terminal-content">
    <div id="terminal-output-desktop" class="terminal-output"></div>
    <div class="terminal-input-line">
      <span class="prompt">umcli%</span>
      <input type="text" id="terminal-input-desktop" class="terminal-input" placeholder="Escribe tu consulta..." />
    </div>
  </div>
</div>

<style>
.um-terminal-desktop-container {
  background: #1e1e2e;
  border-radius: 12px;
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.3);
  max-width: 800px;
  margin: 2rem auto;
  overflow: hidden;
  font-family: 'Fira Code', 'SF Mono', Monaco, 'Cascadia Code', 'Roboto Mono', Consolas, 'Courier New', monospace;
}

.terminal-header {
  background: #313244;
  padding: 12px 20px;
  display: flex;
  align-items: center;
  gap: 12px;
  border-bottom: 1px solid #45475a;
}

.window-controls {
  display: flex;
  gap: 8px;
}

.control-red, .control-yellow, .control-green {
  width: 12px;
  height: 12px;
  border-radius: 50%;
}

.control-red { background: #f38ba8; }
.control-yellow { background: #f9e2af; }
.control-green { background: #a6e3a1; }

.terminal-header h3 {
  color: #cdd6f4;
  font-size: 14px;
  font-weight: 500;
  margin: 0;
}

.terminal-content {
  padding: 20px;
  min-height: 400px;
  max-height: 600px;
  overflow-y: auto;
}

.terminal-output {
  color: #cdd6f4;
  font-size: 14px;
  line-height: 1.6;
  margin-bottom: 20px;
  white-space: pre-wrap;
}

.terminal-input-line {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: 20px;
}

.prompt {
  color: #89b4fa;
  font-weight: bold;
  font-size: 14px;
}

.terminal-input {
  flex: 1;
  background: transparent;
  border: none;
  color: #cdd6f4;
  font-family: inherit;
  font-size: 14px;
  outline: none;
  padding: 8px 0;
}

.terminal-input::placeholder {
  color: #6c7086;
}

/* Scrollbar styling */
.terminal-content::-webkit-scrollbar {
  width: 6px;
}

.terminal-content::-webkit-scrollbar-track {
  background: #1e1e2e;
}

.terminal-content::-webkit-scrollbar-thumb {
  background: #45475a;
  border-radius: 3px;
}

.terminal-content::-webkit-scrollbar-thumb:hover {
  background: #585b70;
}

/* Responsive */
@media (max-width: 768px) {
  .um-terminal-desktop-container {
    margin: 1rem;
    max-width: none;
  }
  
  .terminal-content {
    padding: 15px;
    min-height: 300px;
  }
}
</style>

<script>
// JAVASCRIPT CONSISTENTE CON MÓVIL - SOLO URLs REALES
document.addEventListener('DOMContentLoaded', function() {
  const terminalOutput = document.getElementById('terminal-output-desktop');
  const terminalInput = document.getElementById('terminal-input-desktop');
  
  // ESTADO GLOBAL CONSISTENTE
  let currentSearchResults = [];
  let currentResultIndex = 0;
  let currentQuery = '';
  
  function addOutputLine(text) {
    if (terminalOutput) {
      terminalOutput.innerHTML += text + '\n';
      terminalOutput.scrollTop = terminalOutput.scrollHeight;
    }
  }
  
  // FUNCIÓN IDÉNTICA A MÓVIL - SOLO URLs REALES
  async function processAdvancedQuery(query) {
    addOutputLine('🔍 <span style="color: #ffb86c;">Buscando en base de conocimientos UM...</span>');
    
    try {
      // USAR API CORREGIDA - SOLO URLs REALES
      const response = await fetch('/api/cli/query', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ query })
      });
      
      const data = await response.json();
      
      if (data.error) {
        addOutputLine(`❌ <span style="color: #ff5555;">Error:</span> ${data.message}`);
        return;
      }
      
      if (data.results && data.results.length > 0) {
        // GUARDAR RESULTADOS PARA NAVEGACIÓN INTERACTIVA
        currentSearchResults = data.results;
        currentResultIndex = 0;
        currentQuery = query;
        
        addOutputLine(`🎯 <strong style="color: #50fa7b;">Encontré ${data.results.length} resultado(s) para "${query}"</strong>`);
        addOutputLine('📋 <span style="color: #f1fa8c;">Te muestro de a uno para mejor experiencia:</span>');
        addOutputLine('');
        
        // MOSTRAR PRIMER RESULTADO
        showCurrentResult();
        
      } else {
        addOutputLine('❌ <span style="color: #ffb86c;">Sin resultados específicos</span>');
        addOutputLine('💡 Intenta: "seguridad", "redes", "desarrollo", "antecedentes"');
      }
      
    } catch (error) {
      console.error('API Error:', error);
      addOutputLine('❌ <span style="color: #ff5555;">Error de conexión con API</span>');
    }
  }
  
  // MOSTRAR RESULTADO ACTUAL CON CONTROLES INTERACTIVOS
  function showCurrentResult() {
    if (currentSearchResults.length === 0) return;
    
    const result = currentSearchResults[currentResultIndex];
    const position = currentResultIndex + 1;
    const total = currentSearchResults.length;
    
    // DISEÑO CONSISTENTE CON MÓVIL
    addOutputLine('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');
    addOutputLine(`📍 <strong style="color: #bd93f9;">Resultado ${position} de ${total}</strong>`);
    addOutputLine('');
    
    addOutputLine(`${result.icon} <strong style="color: #64ffda;">${result.title}</strong>`);
    
    if (result.client) {
      addOutputLine(`🏢 <span style="color: #f1fa8c;">Cliente:</span> ${result.client}`);
    }
    
    addOutputLine(`📝 ${result.content}`);
    
    addOutputLine('');
    addOutputLine('🎮 <strong style="color: #50fa7b;">¿Qué quieres hacer?</strong>');
    
    if (result.url) {
      addOutputLine(`   🔗 <a href="${result.url}" style="color: #50fa7b;" target="_blank">Ver información completa</a>`);
    }
    
    if (result.mailto_link) {
      addOutputLine(`   📧 <a href="${result.mailto_link}" style="color: #ffb86c;">Enviar por correo electrónico</a>`);
    }
    
    addOutputLine('');
    
    // CONTROLES DE NAVEGACIÓN
    const navigationControls = [];
    
    if (currentResultIndex > 0) {
      navigationControls.push('<button onclick="showPreviousResult()" style="background: #6272a4; color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; margin: 4px;">⬅️ Anterior</button>');
    }
    
    if (currentResultIndex < currentSearchResults.length - 1) {
      navigationControls.push('<button onclick="showNextResult()" style="background: #50fa7b; color: #282a36; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; margin: 4px;">➡️ Siguiente</button>');
    }
    
    navigationControls.push('<button onclick="newSearch()" style="background: #ff79c6; color: white; border: none; padding: 8px 16px; border-radius: 6px; cursor: pointer; margin: 4px;">🔍 Nueva búsqueda</button>');
    
    if (navigationControls.length > 0) {
      addOutputLine('🎛️ <strong>Controles:</strong> ' + navigationControls.join(' '));
    }
    
    addOutputLine('');
    addOutputLine('💡 <span style="color: #8be9fd;">Tip:</span> También puedes escribir cualquier nueva consulta directamente');
    addOutputLine('━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━');
  }
  
  // FUNCIONES DE NAVEGACIÓN GLOBALES
  window.showNextResult = function() {
    if (currentResultIndex < currentSearchResults.length - 1) {
      currentResultIndex++;
      addOutputLine('');
      showCurrentResult();
    }
  };

  window.showPreviousResult = function() {
    if (currentResultIndex > 0) {
      currentResultIndex--;
      addOutputLine('');
      showCurrentResult();
    }
  };

  window.newSearch = function() {
    addOutputLine('');
    addOutputLine('🔍 <span style="color: #50fa7b;">Perfecto! Escribe tu nueva consulta...</span>');
    addOutputLine('💡 Ejemplos: "desarrollo web", "seguridad empresarial", "redes cisco"');
    terminalInput.focus();
  };
  
  // EVENT HANDLERS
  if (terminalInput) {
    terminalInput.addEventListener('keypress', function(e) {
      if (e.key === 'Enter') {
        const query = this.value.trim();
        if (query) {
          addOutputLine(`umcli% ${query}`);
          processAdvancedQuery(query);
          this.value = '';
        }
      }
    });
    
    // Focus automático
    terminalInput.focus();
  }
  
  // MENSAJE INICIAL
  addOutputLine('🚀 <strong style="color: #50fa7b;">UM CLI v2.5 Desktop - Listo!</strong>');
  addOutputLine('💡 Escribe tu consulta para buscar en 469+ antecedentes y servicios');
  addOutputLine('📋 Ejemplos: "seguridad", "redes cisco", "desarrollo web"');
  addOutputLine('');
});
</script>
