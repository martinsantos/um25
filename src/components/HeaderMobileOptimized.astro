---
// src/components/HeaderMobileOptimized.astro
// Mobile-first header con hamburger menu elegante
import type { AstroGlobal } from 'astro';

interface Props {
  title?: string;
}

const { title = 'Ultima Milla' } = Astro.props;
const currentPath = Astro.url.pathname;

// Helper para detectar ruta activa
const isActive = (href: string): boolean => {
  if (href === '/' && currentPath === '/') return true;
  if (href !== '/' && currentPath.startsWith(href)) return true;
  return false;
};

const navItems = [
  { label: 'Servicios', href: '/servicios' },
  { label: 'Antecedentes', href: '/antecedentes' },
  { label: 'Nosotros', href: '/nosotros' },
  { label: 'Contacto', href: '/contacto' },
];
---

<header class="fixed top-0 w-full z-50 bg-white/95 backdrop-blur-md border-b border-gray-200">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="flex items-center justify-between h-16 sm:h-20">

      <!-- Logo - Responsive sizing -->
      <a href="/" class="flex items-center gap-2 group">
        <div class="w-10 h-10 sm:w-12 sm:h-12 bg-gradient-to-br from-cyan-500 to-blue-600 rounded-lg flex items-center justify-center transform group-hover:scale-105 transition-transform duration-300">
          <span class="text-white font-black text-lg sm:text-xl">UM</span>
        </div>
        <span class="hidden sm:block font-bold text-gray-900 text-lg tracking-tight">
          {title}
        </span>
      </a>

      <!-- Desktop Navigation (hidden on mobile) -->
      <nav class="hidden md:flex items-center gap-8">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`text-sm font-medium transition-colors ${
              isActive(item.href)
                ? 'text-cyan-600'
                : 'text-gray-600 hover:text-cyan-600'
            }`}
          >
            {item.label}
          </a>
        ))}
        <a
          href="/contacto"
          class="text-sm font-medium px-4 py-2 rounded-lg bg-cyan-500 text-white hover:bg-cyan-600 transition-colors"
        >
          Contacto
        </a>
      </nav>

      <!-- Mobile Menu Button -->
      <button
        id="mobile-menu-btn"
        class="md:hidden p-2.5 text-gray-600 hover:bg-gray-100 rounded-lg transition-colors"
        aria-label="Abrir menú"
        aria-expanded="false"
      >
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>
        </svg>
      </button>

    </div>

    <!-- Mobile Navigation Menu -->
    <nav
      id="mobile-menu"
      class="md:hidden border-t border-gray-100 bg-white/98 backdrop-blur-sm hidden"
    >
      <div class="px-4 py-4 space-y-1 flex flex-col">
        {navItems.map((item) => (
          <a
            href={item.href}
            class={`block px-4 py-3 rounded-lg transition-colors font-medium text-base ${
              isActive(item.href)
                ? 'bg-cyan-50 text-cyan-600'
                : 'text-gray-700 hover:bg-gray-50'
            }`}
          >
            {item.label}
          </a>
        ))}
        <div class="pt-2 border-t border-gray-100">
          <a
            href="/contacto"
            class="block px-4 py-3 bg-cyan-500 text-white rounded-lg hover:bg-cyan-600 transition-colors font-medium text-base text-center"
          >
            Contacto
          </a>
        </div>
      </div>
    </nav>

  </div>
</header>

<!-- Spacer to prevent content overlap -->
<div class="h-16 sm:h-20"></div>

<script is:inline>
  // Mobile menu toggle
  const menuBtn = document.getElementById('mobile-menu-btn');
  const mobileMenu = document.getElementById('mobile-menu');

  if (menuBtn && mobileMenu) {
    menuBtn.addEventListener('click', () => {
      const isOpen = !mobileMenu.classList.contains('hidden');
      mobileMenu.classList.toggle('hidden');
      menuBtn.setAttribute('aria-expanded', String(!isOpen));

      // Animate hamburger icon
      const svg = menuBtn.querySelector('svg');
      if (svg) {
        if (!isOpen) {
          // Opening menu - animate to X
          svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>';
        } else {
          // Closing menu - animate to hamburger
          svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>';
        }
      }
    });

    // Close menu when clicking a link
    mobileMenu.querySelectorAll('a').forEach(link => {
      link.addEventListener('click', () => {
        mobileMenu.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
        const svg = menuBtn.querySelector('svg');
        if (svg) {
          svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>';
        }
      });
    });

    // Close menu when clicking outside
    document.addEventListener('click', (e) => {
      if (!menuBtn.contains(e.target) && !mobileMenu.contains(e.target)) {
        mobileMenu.classList.add('hidden');
        menuBtn.setAttribute('aria-expanded', 'false');
        const svg = menuBtn.querySelector('svg');
        if (svg) {
          svg.innerHTML = '<path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"/>';
        }
      }
    });
  }
</script>

<style>
  header {
    animation: slideDown 0.3s ease-out;
  }

  @keyframes slideDown {
    from {
      transform: translateY(-100%);
      opacity: 0;
    }
    to {
      transform: translateY(0);
      opacity: 1;
    }
  }

  @media (max-width: 768px) {
    a {
      /* Touch target minimum 44-48px height for accessibility */
      min-height: 44px;
      display: flex;
      align-items: center;
    }
  }
</style>
