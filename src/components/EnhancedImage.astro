---
interface Props {
    src?: string | null;
    alt: string;
    width?: number | string;
    height?: number | string;
    class?: string;
    loading?: 'lazy' | 'eager';
    fallbackSrc?: string;
    fallbackAlt?: string;
    containerClass?: string;
}

const {
    src,
    alt,
    width = '100%',
    height = '100%',
    class: className = '',
    loading = 'lazy',
    fallbackSrc = '/images/antecedentes-hero-bg.jpg',
    fallbackAlt = 'Imagen no disponible',
    containerClass = ''
} = Astro.props;

const imageToShow = src || fallbackSrc;
const imageAlt = src ? alt : (fallbackAlt || alt);
---

<div class={`relative ${containerClass}`}>
  <img
      src={imageToShow}
      alt={imageAlt}
      width={width}
      height={height}
      loading={loading}
      class={`w-full h-full object-cover ${className}`}
      onerror={`
        if (this.src !== '${fallbackSrc}') {
          console.log('Error cargando imagen:', this.src, 'usando fallback:', '${fallbackSrc}');
          this.src = '${fallbackSrc}';
          this.alt = '${fallbackAlt}';
        }
      `}
  />
  {!src && (
    <div class="absolute inset-0 flex items-center justify-center bg-gray-100 text-gray-500 text-sm">
      <div class="text-center">
        <svg class="w-8 h-8 mx-auto mb-2 opacity-50" fill="currentColor" viewBox="0 0 20 20">
          <path fill-rule="evenodd" d="M4 3a2 2 0 00-2 2v10a2 2 0 002 2h12a2 2 0 002-2V5a2 2 0 00-2-2H4zm12 12H4l4-8 3 6 2-4 3 6z" clip-rule="evenodd" />
        </svg>
        <span>Imagen no disponible</span>
      </div>
    </div>
  )}
</div>
