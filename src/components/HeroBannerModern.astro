---
// Banner Hero Minimalista y Moderno - Nivel Mundial
// Diseño limpio, sin bloques largos, impacto visual máximo
---

<header id="banner" class="relative w-full min-h-screen bg-gradient-to-br from-gray-900 via-black to-gray-800 flex items-center justify-center overflow-hidden">
  
  <!-- Fondo dinámico con animación -->
  <div class="absolute inset-0 bg-cover bg-center opacity-40 hero-background"></div>
  
  <!-- Grid animado de fondo -->
  <div class="absolute inset-0 opacity-10">
    <div class="absolute inset-0" style="background-image: linear-gradient(rgba(0,212,170,0.3) 1px, transparent 1px), linear-gradient(90deg, rgba(0,212,170,0.3) 1px, transparent 1px); background-size: 80px 80px; animation: gridShift 20s linear infinite;"></div>
  </div>

  <!-- Orbes de luz flotantes -->
  <div class="absolute top-20 left-10 w-72 h-72 bg-blue-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob"></div>
  <div class="absolute top-40 right-10 w-72 h-72 bg-purple-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-2000"></div>
  <div class="absolute -bottom-8 left-20 w-72 h-72 bg-cyan-500 rounded-full mix-blend-multiply filter blur-3xl opacity-20 animate-blob animation-delay-4000"></div>

  <!-- Contenido Principal -->
  <div class="relative z-10 w-full h-full flex flex-col items-center justify-center px-4 py-20">
    
    <!-- Logo/Marca animada -->
    <div class="mb-8 animate-fadeInDown">
      <div class="inline-block">
        <span class="text-sm font-semibold text-cyan-400 tracking-widest uppercase">Transformación Digital</span>
      </div>
    </div>

    <!-- Título Principal - Impactante -->
    <div class="max-w-4xl mx-auto text-center mb-8 animate-fadeInUp">
      <h1 class="text-5xl md:text-7xl font-black text-white mb-6 leading-tight">
        <span class="bg-gradient-to-r from-cyan-400 via-blue-400 to-purple-400 bg-clip-text text-transparent">
          Soluciones IT
        </span>
        <br />
        <span class="text-white">que transforman negocios</span>
      </h1>
      
      <p class="text-xl md:text-2xl text-gray-300 font-light max-w-2xl mx-auto leading-relaxed">
        22+ años impulsando empresas mendocinas hacia la transformación digital
      </p>
    </div>

    <!-- Estadísticas compactas -->
    <div class="grid grid-cols-3 gap-8 md:gap-12 mb-12 animate-fadeInUp animation-delay-200">
      <div class="text-center">
        <div class="text-3xl md:text-4xl font-bold text-cyan-400 mb-2">469+</div>
        <div class="text-sm text-gray-400">Proyectos</div>
      </div>
      <div class="text-center">
        <div class="text-3xl md:text-4xl font-bold text-cyan-400 mb-2">22+</div>
        <div class="text-sm text-gray-400">Años</div>
      </div>
      <div class="text-center">
        <div class="text-3xl md:text-4xl font-bold text-cyan-400 mb-2">100%</div>
        <div class="text-sm text-gray-400">Satisfacción</div>
      </div>
    </div>

    <!-- CTA Buttons -->
    <div class="flex flex-col sm:flex-row gap-4 mb-16 animate-fadeInUp animation-delay-400">
      <a href="#servicios" class="px-8 py-4 bg-gradient-to-r from-cyan-500 to-blue-500 text-white font-semibold rounded-lg hover:shadow-2xl hover:shadow-cyan-500/50 transition-all duration-300 transform hover:scale-105">
        Explorar Servicios
      </a>
      <a href="#contacto" class="px-8 py-4 border-2 border-cyan-400 text-cyan-400 font-semibold rounded-lg hover:bg-cyan-400/10 transition-all duration-300">
        Solicitar Consulta
      </a>
    </div>

    <!-- Scroll indicator -->
    <div class="absolute bottom-8 left-1/2 transform -translate-x-1/2 animate-bounce">
      <svg class="w-6 h-6 text-cyan-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
      </svg>
    </div>
  </div>
</header>

<style>
  @keyframes gridShift {
    0% {
      background-position: 0 0;
    }
    100% {
      background-position: 80px 80px;
    }
  }

  @keyframes blob {
    0%, 100% {
      transform: translate(0, 0) scale(1);
    }
    33% {
      transform: translate(30px, -50px) scale(1.1);
    }
    66% {
      transform: translate(-20px, 20px) scale(0.9);
    }
  }

  @keyframes fadeInDown {
    from {
      opacity: 0;
      transform: translateY(-30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes fadeInUp {
    from {
      opacity: 0;
      transform: translateY(30px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  .animate-blob {
    animation: blob 7s infinite;
  }

  .animation-delay-2000 {
    animation-delay: 2s;
  }

  .animation-delay-4000 {
    animation-delay: 4s;
  }

  .animate-fadeInDown {
    animation: fadeInDown 0.8s ease-out;
  }

  .animate-fadeInUp {
    animation: fadeInUp 0.8s ease-out forwards;
    opacity: 0;
  }

  .animation-delay-200 {
    animation-delay: 0.2s;
  }

  .animation-delay-400 {
    animation-delay: 0.4s;
  }

  .hero-background {
    background-attachment: fixed;
    background-size: cover;
    background-position: center;
  }

  @media (max-width: 768px) {
    h1 {
      font-size: 2.5rem !important;
    }

    p {
      font-size: 1.125rem !important;
    }
  }
</style>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const techImages = [
      '/images/portadas/portada1.png',
      '/images/portadas/portada11.png',
      '/images/portadas/portada1alt2.png',
      '/images/portadas/portada21.png',
      '/images/portadas/portada2alt2.png',
      '/images/portadas/portada3.png',
      '/images/portadas/portada31.png',
      '/images/portadas/portada3alt2.png',
      '/images/portadas/portada4alt2.png',
      '/images/portadas/portada51.png',
      '/images/portadas/portada5alt2.png',
      '/images/portadas/portada61.png',
      '/images/portadas/portada71.png',
      '/images/portadas/portada7alt2.png',
      '/images/portadas/portada81.png',
      '/images/portadas/portada811.png',
      '/images/portadas/portada8111.png',
      '/images/portadas/portada8alt2.png',
      '/images/portadas/portada91.png',
      '/images/portadas/portadagif.gif'
    ];
    
    const banner = document.getElementById('banner');
    const heroBackground = banner?.querySelector('.hero-background');
    
    function changeHeroBackground() {
      if (heroBackground) {
        const randomImage = techImages[Math.floor(Math.random() * techImages.length)];
        heroBackground.style.backgroundImage = `url(${randomImage})`;
      }
    }
    
    changeHeroBackground();
    setInterval(changeHeroBackground, 5000); // Faster for testing
  });
</script>
