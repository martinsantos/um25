// Configuración de Babel para el proyecto
module.exports = function(api) {
  // Cache the configuration based on NODE_ENV
  const isTest = api.env('test');
  const isDevelopment = api.env('development');
  const isProduction = api.env('production');
  
  // Cache the configuration
  api.cache.using(() => 
    JSON.stringify({
      env: process.env.NODE_ENV,
      test: isTest,
      development: isDevelopment,
      production: isProduction,
    })
  );

  // Configuración común para todos los entornos
  const presets = [
    ['@babel/preset-env', {
      // Configuración específica para pruebas
      ...(isTest && {
        targets: {
          node: 'current',
        },
      }),
      // Configuración para desarrollo y producción
      ...(!isTest && {
        modules: false, // Para tree-shaking en producción
        useBuiltIns: 'usage',
        corejs: { version: '3.26', proposals: true },
      }),
      // Opciones comunes
      bugfixes: true,
      loose: true,
      shippedProposals: true,
    }],
    // Preset de TypeScript
    '@babel/preset-typescript',
    // Preset de React con configuración optimizada
    ['@babel/preset-react', {
      runtime: 'automatic',
      development: isDevelopment,
      importSource: '@emotion/react',
    }],
  ];

  // Plugins comunes para todos los entornos
  const plugins = [
    // Soporte para decoradores (usado por TypeScript)
    ['@babel/plugin-proposal-decorators', { legacy: true }],
    
    // Soporte para class properties
    ['@babel/plugin-proposal-class-properties', { loose: true }],
    
    // Soporte para optional chaining y nullish coalescing
    '@babel/plugin-proposal-optional-chaining',
    '@babel/plugin-proposal-nullish-coalescing-operator',
    
    // Transformación de módulos (solo en pruebas)
    ...(isTest ? [
      '@babel/plugin-transform-modules-commonjs',
      'babel-plugin-dynamic-import-node',
    ] : []),
    
    // Soporte para async/await
    '@babel/plugin-transform-runtime',
    
    // Mejoras de rendimiento
    'babel-plugin-transform-react-remove-prop-types',
    'babel-plugin-transform-react-constant-elements',
    'babel-plugin-transform-react-inline-elements',
    
    // Soporte para Emotion (si se usa)
    '@emotion/babel-plugin',
    
    // Mejoras para desarrollo
    ...(isDevelopment ? [
      'react-refresh/babel',
    ] : []),
  ];

  // Configuración específica para producción
  if (isProduction) {
    plugins.push(
      'babel-plugin-transform-react-remove-prop-types',
      'babel-plugin-transform-react-constant-elements',
      'babel-plugin-transform-react-inline-elements',
      'babel-plugin-transform-react-pure-class-to-function',
      'babel-plugin-transform-remove-console',
      'babel-plugin-transform-remove-debugger'
    );
  }

  return {
    presets,
    plugins,
    // Configuración para manejar módulos ES y CommonJS
    sourceType: 'unambiguous',
    // Configuración para @babel/plugin-transform-runtime
    assumptions: {
      noClassCalls: true,
      setPublicClassFields: true,
      privateFieldsAsProperties: true,
    },
    // Configuración para el plugin de runtime
    env: {
      test: {
        plugins: [
          // Asegurar que los módulos se resuelvan correctamente en pruebas
          ['babel-plugin-module-resolver', {
            root: ['.'],
            alias: {
              '^@/(.*)$': './src/$1',
              '^~/(.*)$': './src/$1',
              '^@components/(.*)$': './src/components/$1',
              '^@pages/(.*)$': './src/pages/$1',
              '^@utils/(.*)$': './src/utils/$1',
              '^@styles/(.*)$': './src/styles/$1',
              '^@assets/(.*)$': './src/assets/$1',
              '^@hooks/(.*)$': './src/hooks/$1',
              '^@contexts/(.*)$': './src/contexts/$1',
              '^@services/(.*)$': './src/services/$1',
              '^@mocks/(.*)$': './__mocks__/$1',
              '^@tests/(.*)$': './tests/$1',
            },
          }],
        ],
      },
    },
  };
};
