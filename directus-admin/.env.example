# Copy to directus-admin/.env for an isolated local instance.
POSTGRES_USER=directus
POSTGRES_DB=directus
POSTGRES_PASSWORD=
DB_CLIENT=pg
# Host of your isolated PostgreSQL instance
DB_HOST=
DB_PORT=5432
DB_USER=directus
DB_DATABASE=directus
DIRECTUS_KEY=
DIRECTUS_SECRET=
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=
PUBLIC_URL=http://localhost:8055
PUBLIC_DIRECTUS_URL=http://localhost:8055
