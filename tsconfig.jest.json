{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "module": "commonjs",
    "target": "es2017",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["node", "jest"],
    "baseUrl": ".",
    "paths": {
      "~/*": ["src/*"],
      "@/*": ["src/*"],
      "@astrojs/*": ["node_modules/@astrojs/*"],
      "astro:config": ["node_modules/astro/dist/config/index.d.ts"],
      "astro:components": ["node_modules/astro/dist/components/index.d.ts"],
      "astro:content": ["node_modules/astro/dist/content/index.d.ts"],
      "astro:middleware": ["node_modules/astro/dist/middleware/index.d.ts"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "src/**/*.js",
    "src/**/*.jsx",
    "tests/**/*.ts",
    "tests/**/*.tsx",
    "tests/**/*.js",
    "tests/**/*.jsx",
    "jest.setup.js",
    "jest-astro-transformer.js"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
