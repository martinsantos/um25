  <h3 class="font-black text-xl">{titulo}</h3>
  {descripcion && <p class="text-gray-600">{descripcion}</p>}
</div>
```

### 2. **Estilos UI/UX Modernos**
```css
/* Patrón de efectos hover establecido */
.card-modern {
  @apply hover:shadow-2xl hover:shadow-blue-500/25 
         transform hover:-translate-y-2 hover:scale-[1.02]
         hover:ring-4 hover:ring-blue-300/50
         border-2 border-transparent hover:border-blue-400
         transition-all duration-300;
}
```

### 3. **API Directus**
```javascript
// Patrón de conexión establecido
import { directus } from '../utils/directus.js';

export async function getAntecedentes() {
  try {
    const response = await directus.items('antecedentes').readByQuery({
      fields: ['*', 'servicio_id.nombre'],
      limit: -1
    });
    return response.data || [];
  } catch (error) {
    // Fallback a datos estáticos
    return STATIC_ANTECEDENTES;
  }
}
```

