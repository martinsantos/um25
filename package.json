{
  "name": "fumbling-field",
  "type": "module",
  "version": "0.0.1",
  "scripts": {
    "dev": "astro dev",
    "start": "astro preview --host",
    "build": "npm run process-images && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "process-images": "node --max-old-space-size=4096 scripts/process-images.js",
