{
  "name": "fumbling-field",
  "type": "module",
  "version": "0.0.1",
  "description": "UMBot - Ultima Milla Website with CI/CD Pipeline Test - 27 Jun 2025",
  "scripts": {
    "dev": "astro dev",
    "dev:replica": "UMSA_LOCAL_REPLICA=1 astro dev --port 4321",
    "replica:preflight": "UMSA_LOCAL_REPLICA=1 node scripts/replica-preflight.mjs",
    "replica:sync": "node scripts/replica-sync.mjs",
    "replica:parity-check": "node scripts/replica-parity-check.mjs",
    "replica:scrape-copy": "node scripts/replica-scrape-prod-copy.mjs",
    "replica:images": "node scripts/replica-download-images.mjs",
    "replica:images-audit": "node scripts/replica-images-audit.mjs",
    "replica:content-parity": "node scripts/replica-content-parity.mjs",
    "audit:antecedente-layout": "node scripts/antecedente-detail-layout-audit.mjs",
    "replica:gate": "UMSA_LOCAL_REPLICA=1 node scripts/replica-gate.mjs",
    "start": "astro preview --host",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "process-images": "node scripts/process-images.js",
    "prebuild": "npm run process-images",
    "optimize-images": "node scripts/optimize-images.js",
    "antecedentes:prompts": "node scripts/antecedentes_images/rewrite-prompts.mjs",
    "antecedentes:images:ingest": "node scripts/antecedentes_images/cli.mjs ingest-latest",
    "antecedentes:images:postprocess": "node scripts/antecedentes_images/cli.mjs postprocess",
    "antecedentes:images:gallery": "node scripts/antecedentes_images/cli.mjs gallery",
    "antecedentes:images:contact-sheet": "node scripts/antecedentes_images/cli.mjs contact-sheet",
    "antecedentes:images:publish": "node scripts/publish-antecedentes-generated-images.mjs",
    "antecedentes:images:audit": "node scripts/antecedentes_images/audit.mjs",
    "antecedentes:images:continue-once": "node scripts/antecedentes_images/watch-generated-images.mjs --once",
    "antecedentes:images:watch": "node scripts/antecedentes_images/watch-generated-images.mjs --interval-minutes 15",
    "snapshot-data": "node scripts/snapshot-directus-data.mjs",
    "download-images": "node scripts/download-directus-images.mjs",
    "snapshot-all": "npm run snapshot-data && npm run download-images",
    "umsa:handoff": "node scripts/umsa-diaria-safe-handoff.mjs",
    "umsa:preflight": "node scripts/umsa-diaria-preflight.mjs",
    "lint": "eslint \"src/**/*.{js,ts,jsx,tsx,astro}\"",
    "lint:fix": "eslint \"src/**/*.{js,ts,jsx,tsx,astro}\" --fix",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "check": "npm run lint && npm run typecheck && npm run audit:css && npm run test:ci && npm run build",
    "seo:audit": "node scripts/seo-audit.mjs",
    "audit:visual": "node scripts/visual-contrast-audit.mjs",
    "audit:css": "node scripts/css-contract-audit.mjs",
    "audit:hover": "node scripts/hover-contract-audit.mjs",
    "audit:visual:strict": "VISUAL_AUDIT_STRICT=1 node scripts/visual-contrast-audit.mjs",
    "audit:visual:commercial": "node scripts/run-commercial-visual-audit.mjs",
    "audit:e2e:visual": "node scripts/run-e2e-visual-suite.mjs",
    "audit:screenshots": "node scripts/capture-visual-snapshots.mjs",
    "test": "jest --config=jest.config.cjs",
    "test:watch": "jest --watch --config=jest.config.cjs",
    "test:coverage": "jest --coverage --config=jest.config.cjs",
    "test:ui": "jest --watchAll --config=jest.config.cjs",
    "test:ci": "jest --ci --runInBand --config=jest.config.cjs",
    "test:integration": "jest --config=jest.config.cjs",
    "test:e2e": "jest --config=jest.config.cjs",
    "validate:database": "./scripts/validate-database.sh",
    "validate:images": "./scripts/validate-images.sh",
    "validate:api": "./scripts/test-connectivity.sh",
    "migration:report": "node scripts/generate-migration-report.js",
    "test:migration": "npm run validate:database && npm run validate:images && npm run validate:api",
    "test:e2e:production": "NODE_ENV=production npm run test:e2e",
    "migrate:servicios-v4": "node scripts/migration/migrate-servicios-v4-fields.js",
    "migrate:servicios-v4:dry": "node scripts/migration/migrate-servicios-v4-fields.js --dry-run",
    "migrate:productos": "node scripts/migration/migrate-productos-to-directus.js",
    "migrate:productos:dry": "node scripts/migration/migrate-productos-to-directus.js --dry-run",
    "migrate:m2m": "node scripts/migration/create-m2m-antecedentes-servicios.js",
    "migrate:m2m:dry": "node scripts/migration/create-m2m-antecedentes-servicios.js --dry-run",
    "migrate:m2m:test": "node scripts/migration/create-m2m-antecedentes-servicios.js --dry-run --limit=10",
    "migrate:v4": "npm run migrate:servicios-v4 && npm run migrate:productos && npm run migrate:m2m",
    "migrate:v4:dry": "npm run migrate:servicios-v4:dry && npm run migrate:productos:dry && npm run migrate:m2m:test"
  },
  "dependencies": {
    "@astrojs/alpinejs": "^0.3.0",
    "@astrojs/mdx": "^4.2.4",
    "@astrojs/node": "^9.2.1",
    "@astrojs/rss": "^3.0.0",
    "@astrojs/sitemap": "^3.0.0",
    "@astrojs/tailwind": "^5.0.0",
    "@chenglou/pretext": "^0.0.6",
    "@directus/sdk": "^13.0.2",
    "@sentry/astro": "^10.27.0",
    "@types/nodemailer": "^6.4.14",
    "alpinejs": "^3.12.0",
    "astro": "^5.7.4",
    "axios": "^1.9.0",
    "dotenv": "^16.4.7",
    "form-data": "^4.0.2",
    "lucide-astro": "^0.511.0",
    "node-cache": "^5.1.2",
    "node-fetch": "^3.3.2",
    "nodemailer": "^6.9.16",
    "sharp": "^0.34.2",
    "tailwindcss-animate": "^1.0.7",
    "typescript-eslint": "^8.34.1"
  },
