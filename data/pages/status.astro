---
import Layout from "@/layouts/Layout.astro";

const statusResponse = await fetch(`${Astro.url.origin}/api/status.json`);
const status = await statusResponse.json();
---

<Layout title="System Status - Ultima Milla">
  <div class="min-h-screen bg-gradient-to-br from-slate-900 via-slate-800 to-slate-900 text-white">
    <!-- Header -->
    <div class="border-b border-slate-700 bg-slate-900/50">
      <div class="max-w-7xl mx-auto px-4 py-8">
        <h1 class="text-4xl font-bold mb-2">System Status Dashboard</h1>
        <p class="text-slate-400">Real-time monitoring with trending analytics</p>
      </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-7xl mx-auto px-4 py-8">
      <!-- Metrics Grid -->
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
        <div class="bg-slate-800/50 border border-slate-700 rounded-lg p-6">
          <h2 class="text-sm text-slate-400 mb-2">Memory</h2>
          <div class="text-3xl font-bold mb-2" id="memory-percent">{status.server.memory.usagePercent}%</div>
          <div class="text-xs text-slate-400">{status.server.memory.used} / {status.server.memory.total}</div>
          <div class="mt-2 h-2 bg-slate-700 rounded overflow-hidden">
            <div class="h-full bg-red-500 rounded" style={`width: ${status.server.memory.usagePercent}%`}></div>
          </div>
        </div>

        <div class="bg-slate-800/50 border border-slate-700 rounded-lg p-6">
          <h2 class="text-sm text-slate-400 mb-2">Health Status</h2>
          <div class="text-3xl font-bold mb-2 uppercase">{status.health}</div>
          <div class="text-xs text-slate-400">{status.issues.length} issues</div>
        </div>

        <div class="bg-slate-800/50 border border-slate-700 rounded-lg p-6">
          <h2 class="text-sm text-slate-400 mb-2">Services Online</h2>
          <div class="text-3xl font-bold mb-2">2/2</div>
          <div class="space-y-1 text-xs">
            {status.server.services.map(s => (
              <div>{s.name}: {s.status === "online" ? "✅" : "🔴"}</div>
            ))}
          </div>
        </div>

        <div class="bg-slate-800/50 border border-slate-700 rounded-lg p-6">
          <h2 class="text-sm text-slate-400 mb-2">Nginx Ports</h2>
          <div class="text-xs space-y-1">
            {status.server.nginxPorts.map(p => (
              <div>{p.expected}: {p.listening ? "✅" : "❌"}</div>
            ))}
          </div>
        </div>
      </div>

      <!-- Tabs Navigation -->
      <div class="flex gap-2 mb-6 border-b border-slate-700">
        <button data-tab="memory" class="tab-btn active px-4 py-2 text-sm font-medium border-b-2 border-blue-500">📈 Memory Trend</button>
        <button data-tab="config" class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent hover:border-slate-500">⚙️ Configuration</button>
        <button data-tab="webhooks" class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent hover:border-slate-500">🔔 Webhooks</button>
        <button data-tab="alerts" class="tab-btn px-4 py-2 text-sm font-medium border-b-2 border-transparent hover:border-slate-500">📋 Alert History</button>
      </div>

      <!-- Tab 1: Memory Trend Chart -->
      <div id="memory-tab" class="tab-content bg-slate-800/50 border border-slate-700 rounded-lg p-6 mb-8">
        <h2 class="text-xl font-bold mb-4">Memory Usage Trend</h2>
        <div class="flex gap-2 mb-4">
          <button data-hours="1" class="trend-btn px-3 py-1 text-sm bg-blue-600 rounded hover:bg-blue-700">1h</button>
          <button data-hours="6" class="trend-btn px-3 py-1 text-sm bg-slate-700 rounded hover:bg-slate-600">6h</button>
          <button data-hours="24" class="trend-btn px-3 py-1 text-sm bg-slate-700 rounded hover:bg-slate-600">24h</button>
          <button data-hours="168" class="trend-btn px-3 py-1 text-sm bg-slate-700 rounded hover:bg-slate-600">7d</button>
        </div>
        <canvas id="memory-chart" class="w-full"></canvas>
      </div>

      <!-- Tab 2: Configuration -->
      <div id="config-tab" class="tab-content hidden bg-slate-800/50 border border-slate-700 rounded-lg p-6 mb-8">
        <h2 class="text-xl font-bold mb-4">System Configuration</h2>
        <form id="config-form" class="space-y-4">
          <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <div>
              <label class="block text-sm font-medium mb-2">Memory Warning %</label>
              <input type="number" name="memory_warning_percent" min="0" max="100" class="w-full bg-slate-700 border border-slate-600 rounded px-3 py-2 text-white" />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2">Memory Critical %</label>
              <input type="number" name="memory_critical_percent" min="0" max="100" class="w-full bg-slate-700 border border-slate-600 rounded px-3 py-2 text-white" />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2">Check Interval (minutes)</label>
              <input type="number" name="check_interval_minutes" min="1" max="60" class="w-full bg-slate-700 border border-slate-600 rounded px-3 py-2 text-white" />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2">Alert Consolidate (hours)</label>
              <input type="number" name="alert_consolidate_hours" min="1" max="24" class="w-full bg-slate-700 border border-slate-600 rounded px-3 py-2 text-white" />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2">Email Recipients</label>
              <input type="text" name="email_recipients" class="w-full bg-slate-700 border border-slate-600 rounded px-3 py-2 text-white" />
            </div>
            <div>
              <label class="block text-sm font-medium mb-2">Retention Days</label>
              <input type="number" name="retention_days" min="7" max="365" class="w-full bg-slate-700 border border-slate-600 rounded px-3 py-2 text-white" />
            </div>
          </div>
          <div class="flex gap-2">
            <button type="submit" class="px-4 py-2 bg-blue-600 rounded hover:bg-blue-700">Save Configuration</button>
            <button type="button" id="reset-config" class="px-4 py-2 bg-slate-700 rounded hover:bg-slate-600">Reset</button>
          </div>
          <div id="config-status" class="text-sm text-slate-400"></div>
        </form>
      </div>

      <!-- Tab 3: Webhooks -->
      <div id="webhooks-tab" class="tab-content hidden bg-slate-800/50 border border-slate-700 rounded-lg p-6 mb-8">
        <h2 class="text-xl font-bold mb-4">Alert Webhooks Configuration</h2>
        <form id="webhooks-form" class="space-y-4">
          <div>
            <label class="block text-sm font-medium mb-2">Slack Webhook URL</label>
            <input type="text" name="slack_webhook_url" placeholder="https://hooks.slack.com/..." class="w-full bg-slate-700 border border-slate-600 rounded px-3 py-2 text-white" />
            <p class="text-xs text-slate-400 mt-1">Leave empty to disable Slack alerts</p>
          </div>
          <div>
            <label class="block text-sm font-medium mb-2">Discord Webhook URL</label>
            <input type="text" name="discord_webhook_url" placeholder="https://discord.com/api/webhooks/..." class="w-full bg-slate-700 border border-slate-600 rounded px-3 py-2 text-white" />
            <p class="text-xs text-slate-400 mt-1">Leave empty to disable Discord alerts</p>
          </div>
          <div class="flex gap-2">
            <button type="submit" class="px-4 py-2 bg-blue-600 rounded hover:bg-blue-700">Save Webhooks</button>
            <button type="button" class="test-webhook px-4 py-2 bg-slate-700 rounded hover:bg-slate-600">Test Slack</button>
            <button type="button" class="test-webhook px-4 py-2 bg-slate-700 rounded hover:bg-slate-600">Test Discord</button>
          </div>
          <div id="webhook-status" class="text-sm text-slate-400"></div>
        </form>

        <div class="mt-6 p-4 bg-slate-700/50 rounded border border-slate-600">
          <h3 class="text-sm font-bold mb-2">📊 Alert Channels Status</h3>
          <div class="space-y-2 text-sm">
            <div id="slack-status">🔌 Slack: Not configured</div>
            <div id="discord-status">🔌 Discord: Not configured</div>
            <div id="email-status">📧 Email: {status.server.memory.usagePercent > 0 ? "✅ Enabled" : "❌ Disabled"}</div>
          </div>
        </div>
      </div>

      <!-- Tab 4: Alert History -->
      <div id="alerts-tab" class="tab-content hidden bg-slate-800/50 border border-slate-700 rounded-lg p-6 mb-8">
        <h2 class="text-xl font-bold mb-4">Alert History</h2>
        <div id="alerts-list" class="space-y-2 max-h-96 overflow-y-auto">
          <p class="text-slate-400">Loading alerts...</p>
        </div>
      </div>

      <!-- Recent Issues -->
      {status.issues.length > 0 && (
        <div class="bg-red-900/20 border border-red-700 rounded-lg p-6 mb-8">
          <h2 class="text-xl font-bold mb-4">🚨 Active Issues</h2>
          <div class="space-y-2">
            {status.issues.map(issue => (
              <div class="text-sm">{issue}</div>
            ))}
          </div>
        </div>
      )}

      <!-- Last Updated -->
      <div class="text-center text-sm text-slate-400 mb-8">
        Last updated: <span id="last-updated">{new Date(status.timestamp).toLocaleString()}</span>
        <br />
        <button id="refresh-btn" class="text-blue-400 hover:text-blue-300 mt-2">↻ Refresh Now</button>
      </div>
    </div>
  </div>

  <!-- Chart.js Library -->
  <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

  <script>
    // Global state
    let memoryChart = null;
    let currentHours = 24;

    // Initialize
    document.addEventListener('DOMContentLoaded', async () => {
      await loadConfig();
      await loadChart(24);
      await loadAlertHistory();
      setupEventListeners();

      // Auto-save metrics every minute
      setInterval(saveMetrics, 60000);
      saveMetrics();

      // Auto-refresh every 30 seconds
      setInterval(async () => {
        window.location.reload();
      }, 30000);
    });

    // Save current metrics to storage
    async function saveMetrics() {
      try {
        const memElement = document.querySelector('[id="memory-percent"]');
        if (!memElement) return;

        const memoryPercent = parseInt(memElement.textContent);

        await fetch('/api/metrics/save.json', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            memory_percent: memoryPercent,
            memory_total_gb: 3.6,
            memory_used_gb: 3.2,
            services_online: 2,
            services_total: 2,
            health_status: memoryPercent > 85 ? 'critical' : memoryPercent > 70 ? 'degraded' : 'healthy'
          })
        });
      } catch (error) {
        console.error('Error saving metrics:', error);
      }
    }

    // Load configuration
    async function loadConfig() {
      try {
        const response = await fetch('/api/config.json');
        const config = await response.json();

        document.querySelector('[name="memory_warning_percent"]').value = config.memory_warning_percent;
        document.querySelector('[name="memory_critical_percent"]').value = config.memory_critical_percent;
        document.querySelector('[name="check_interval_minutes"]').value = config.check_interval_minutes;
        document.querySelector('[name="alert_consolidate_hours"]').value = config.alert_consolidate_hours;
        document.querySelector('[name="email_recipients"]').value = config.email_recipients;
        document.querySelector('[name="retention_days"]').value = config.retention_days;
        document.querySelector('[name="slack_webhook_url"]').value = config.slack_webhook_url || '';
        document.querySelector('[name="discord_webhook_url"]').value = config.discord_webhook_url || '';

        // Update webhook status
        if (config.slack_webhook_url) {
          document.querySelector('#slack-status').textContent = '✅ Slack: Configured';
        }
        if (config.discord_webhook_url) {
          document.querySelector('#discord-status').textContent = '✅ Discord: Configured';
        }
      } catch (error) {
        console.error('Error loading config:', error);
      }
    }

    // Load memory chart
    async function loadChart(hours) {
      currentHours = hours;

      try {
        const response = await fetch(`/api/metrics/chart.json?hours=${hours}&type=memory`);
        const data = await response.json();

        const ctx = document.getElementById('memory-chart').getContext('2d');

        if (memoryChart) {
          memoryChart.destroy();
        }

        memoryChart = new Chart(ctx, {
          type: 'line',
          data: {
            labels: data.labels,
            datasets: data.datasets
          },
          options: {
            responsive: true,
            maintainAspectRatio: true,
            plugins: {
              legend: {
                labels: { color: '#e2e8f0' }
              }
            },
            scales: {
              y: {
                beginAtZero: true,
                max: 100,
                ticks: { color: '#cbd5e1' },
                grid: { color: '#334155' },
                title: { display: true, text: 'Memory %', color: '#e2e8f0' }
              },
              x: {
                ticks: { color: '#cbd5e1' },
                grid: { color: '#334155' }
              }
            }
          }
        });
      } catch (error) {
        console.error('Error loading chart:', error);
      }
    }

    // Load alert history
    async function loadAlertHistory() {
      try {
        // Note: This would need a new endpoint to fetch alert history
        document.querySelector('#alerts-list').innerHTML = '<p class="text-slate-400">No alerts in the last 24 hours</p>';
      } catch (error) {
        console.error('Error loading alerts:', error);
      }
    }

    // Setup event listeners
    function setupEventListeners() {
      // Tab switching
      document.querySelectorAll('.tab-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          const tabName = e.target.dataset.tab;

          // Hide all tabs
          document.querySelectorAll('.tab-content').forEach(tab => tab.classList.add('hidden'));
          document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('border-blue-500'));

          // Show selected tab
          document.getElementById(`${tabName}-tab`).classList.remove('hidden');
          e.target.classList.add('border-blue-500');
        });
      });

      // Trend buttons
      document.querySelectorAll('.trend-btn').forEach(btn => {
        btn.addEventListener('click', (e) => {
          document.querySelectorAll('.trend-btn').forEach(b => b.classList.remove('bg-blue-600'));
          e.target.classList.add('bg-blue-600');
          loadChart(parseInt(e.target.dataset.hours));
        });
      });

      // Config form
      document.getElementById('config-form').addEventListener('submit', saveConfig);
      document.getElementById('reset-config').addEventListener('click', loadConfig);

      // Webhooks form
      document.getElementById('webhooks-form').addEventListener('submit', saveWebhooks);

      // Refresh button
      document.getElementById('refresh-btn').addEventListener('click', () => window.location.reload());
    }

    // Save configuration
    async function saveConfig(e) {
      e.preventDefault();

      const formData = new FormData(document.getElementById('config-form'));
      const data = Object.fromEntries(formData);

      try {
        const response = await fetch('/api/config.json', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (response.ok) {
          document.getElementById('config-status').textContent = '✅ Configuration saved!';
          setTimeout(() => {
            document.getElementById('config-status').textContent = '';
          }, 3000);
        }
      } catch (error) {
        document.getElementById('config-status').textContent = '❌ Error saving configuration';
        console.error('Error:', error);
      }
    }

    // Save webhooks
    async function saveWebhooks(e) {
      e.preventDefault();

      const formData = new FormData(document.getElementById('webhooks-form'));
      const data = Object.fromEntries(formData);

      try {
        const response = await fetch('/api/config.json', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });

        if (response.ok) {
          document.getElementById('webhook-status').textContent = '✅ Webhooks saved!';
          setTimeout(() => {
            document.getElementById('webhook-status').textContent = '';
            loadConfig();
          }, 3000);
        }
      } catch (error) {
        document.getElementById('webhook-status').textContent = '❌ Error saving webhooks';
        console.error('Error:', error);
      }
    }
  </script>

  <style>
    .tab-btn {
      cursor: pointer;
      transition: all 0.3s ease;
    }

    .tab-content {
      animation: fadeIn 0.3s ease;
    }

    @keyframes fadeIn {
      from { opacity: 0; }
      to { opacity: 1; }
    }
  </style>
</Layout>
