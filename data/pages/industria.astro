---
import Layout from '../layouts/Layout.astro';
import { directus, DEFAULT_IMAGE, getAntecedenteImageUrl } from '../utils/directus';
import { generateSlug } from '../utils/slugUtils';

// Configuración SEO específica para Industria - ULTRA OPTIMIZADA
const seoConfig = {
  title: "Industria 4.0 y Automatización Industrial | Mendoza, Cuyo y Patagonia | ULTIMA MILLA",
  description: "Servicios tecnológicos de Industria 4.0 para empresas manufactureras argentinas. Zona de incumbencia: Mendoza, Cuyo, Patagonia. Automatización industrial, IoT profesional, redes robustas, telecomunicaciones y cableado estructurado para manufactura.",
  keywords: "industria 4.0 mendoza, automatizacion industrial cuyo, iot empresas patagonia, servicios tecnologicos manufactura, redes industriales, telecomunicaciones plantas, transformacion digital industria",
  ogImage: "/images/services/servicios-it.jpg",
  canonical: "https://ultimamilla.com.ar/industria",
  locale: "es_AR",
  region: "Cuyo, Patagonia, Argentina",
  author: "Ultima Milla",
  robots: "index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1"
};

// Cargar antecedentes del sector industria
import { antecedentesReales } from '../data/antecedentes_completos.js';
import AntecedentesGridMobileOptimized from '../components/AntecedentesGridMobileOptimized.astro';

let antecedentes = [];
let serviciosRelacionados = [];
let error = null;

const keywords = [
  'industria', 'industrial', 'fabrica', 'planta', 'manufactura',
  'produccion', 'parque industrial', 'polo industrial',
  'minera', 'mineria', 'petroleo', 'gas', 'energia',
  'cerveceria', 'malteria', 'quilmes', 'brahma', 'andes',
  'aceitera', 'molino', 'frigorif', 'alimenticia', 'alimentos',
  'textil', 'metalurgica', 'siderur', 'quimica', 'petroquimica',
  'automotriz', 'autopartes', 'maquinaria', 'herramientas',
  'farmaceutica', 'laboratorio', 'biotecnologia',
  'procesamiento', 'empaque', 'logistica industrial'
];

const filterAntecedentes = async (data) => {
  const filtered = data.filter(item => {
    const cliente = (item.Cliente || '').toLowerCase();
    const titulo = (item.Titulo || '').toLowerCase();
    const area = (item.Area || '').toLowerCase();
    return keywords.some(k => cliente.includes(k) || titulo.includes(k) || area.includes(k));
  });

  const withImages = await Promise.all(
    filtered.map(async (item) => ({
      ...item,
      Nombre: item.Titulo,
      mapeo_imagenes_completo: await getAntecedenteImageUrl(item),
      slug: generateSlug(item.Titulo)
    }))
  );

  return withImages.sort((a, b) => new Date(b.Fecha || '2000-01-01') - new Date(a.Fecha || '2000-01-01'));
};

try {
  // Obtener antecedentes desde Directus
  const response = await directus.getAntecedentes({
    limit: 500,
    page: 1
  });

  if (response && response.data && response.data.length > 0) {
    antecedentes = await filterAntecedentes(response.data);
    console.log(`✅ Cargados ${antecedentes.length} antecedentes de industria`);
  }
} catch (err) {
  console.error('Error cargando antecedentes:', err);
  error = err;
}

// Fallback a datos locales si no hay resultados de API
if (antecedentes.length === 0) {
  console.log('Usando antecedentes locales para Industria');
  antecedentes = await filterAntecedentes(antecedentesReales);
}

// Limitar a 6 para la vista (ELIMINADO - Ahora se maneja en el componente con "Ver más")
// antecedentes = antecedentes.slice(0, 6);

  // Structured Data para SEO
  const structuredData = {
    "@context": "https://schema.org",
    "@type": "Service",
    "serviceType": "Tecnología Industrial e Industria 4.0",
    "provider": {
      "@type": "Organization",
      "name": "Ultima Milla",
      "url": "https://www.ultimamilla.com.ar",
      "logo": "https://www.ultimamilla.com.ar/images/um-logo.png",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Mendoza",
        "addressRegion": "Mendoza",
        "addressCountry": "AR"
      }
    },
    "areaServed": [
      { "@type": "City", "name": "Mendoza" },
      { "@type": "City", "name": "San Juan" },
      { "@type": "City", "name": "San Luis" },
      { "@type": "Country", "name": "Argentina" }
    ],
    "audience": {
      "@type": "BusinessAudience",
      "name": "Empresas Industriales y de Manufactura"
    },
    "hasOfferCatalog": {
      "@type": "OfferCatalog",
      "name": "Servicios IT para Industria",
      "itemListElement": [
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Automatización y Control" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "IoT Industrial (IIoT)" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Redes Industriales" } },
        { "@type": "Offer", "itemOffered": { "@type": "Service", "name": "Ciberseguridad OT" } }
      ]
    }
  };

// Función para obtener imagen del antecedente (Ya no es necesaria aquí, la maneja el componente)
// const antecedentesConImagenes = ... (Eliminado)
---

<Layout
  title={seoConfig.title}
  description={seoConfig.description}
  keywords={seoConfig.keywords}
  image={seoConfig.ogImage}
  canonical={seoConfig.canonical}
>
  <main style="background: #f5f5f5;">
    <!-- HERO -->
    <section style="position: relative; min-height: 400px; display: flex; align-items: center; background: linear-gradient(rgba(15, 23, 42, 0.75), rgba(15, 23, 42, 0.75)), url('https://images.unsplash.com/photo-1581091226825-a6a2a5aee158?w=1920&q=80') center/cover; color: white;">
      <div style="max-width: 1200px; margin: 0 auto; padding: 50px 40px; width: 100%;">
        <!-- Badge -->
        <div style="display: inline-flex; align-items: center; gap: 12px; padding: 12px 20px; background: linear-gradient(135deg, rgba(16, 185, 129, 0.3), rgba(16, 185, 129, 0.1)); border-radius: 20px; margin-bottom: 20px; border: 1px solid rgba(16, 185, 129, 0.4); backdrop-filter: blur(10px);">
          <div style="width: 40px; height: 40px; background: linear-gradient(135deg, #059669, #10b981); border-radius: 12px; display: flex; align-items: center; justify-content: center; box-shadow: 0 8px 20px rgba(16, 185, 129, 0.4);">
            <span style="font-size: 24px;">🏭</span>
          </div>
          <span style="font-size: 13px; font-weight: 800; color: #34d399; text-transform: uppercase; letter-spacing: 1.2px;">Sector Industrial</span>
        </div>

        <!-- Title -->
        <h1 style="font-size: 48px; font-weight: 900; margin-bottom: 20px; line-height: 1.2; color: white;">
          Industria 4.0 y<br/>Transformación Digital
        </h1>

        <!-- Subtitle -->
        <p style="font-size: 18px; font-weight: 400; color: rgba(255, 255, 255, 0.9); max-width: 600px; margin-bottom: 32px; line-height: 1.6;">
          Impulsamos la eficiencia operativa mediante automatización, IoT y conectividad industrial avanzada.
        </p>

        <!-- CTA Button -->
        <a href="#contacto" style="display: inline-block; background: #059669; color: white; padding: 14px 32px; border-radius: 6px; font-weight: 700; font-size: 15px; text-decoration: none; transition: all 0.3s ease;" onmouseover="this.style.background='#047857'" onmouseout="this.style.background='#059669'">
          Soluciones Industriales
        </a>
      </div>
    </section>

    <!-- 3 CARDS -->
    <section style="background: #f5f5f5; padding: 50px 40px;">
      <div style="max-width: 1200px; margin: 0 auto;">
        <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 30px;">
          <!-- Card 1 -->
          <div style="text-align: center; padding: 40px 30px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            <div style="width: 80px; height: 80px; background: white; border: 3px solid #e0e0e0; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
              <svg style="width: 40px; height: 40px; color: #333;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19.428 15.428a2 2 0 00-1.022-.547l-2.384-.477a6 6 0 00-3.86.517l-.318.158a6 6 0 01-3.86.517L6.05 15.21a2 2 0 00-1.806.547M8 4h8l-1 1v5.172a2 2 0 00.586 1.414l5 5c1.26 1.26.367 3.414-1.415 3.414H4.828c-1.782 0-2.674-2.154-1.414-3.414l5-5A2 2 0 009 10.172V5L8 4z"></path>
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Automatización</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Control de procesos y sistemas SCADA para optimizar la producción.</p>
          </div>

          <!-- Card 2 -->
          <div style="text-align: center; padding: 40px 30px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            <div style="width: 80px; height: 80px; background: white; border: 3px solid #e0e0e0; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
              <svg style="width: 40px; height: 40px; color: #333;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Ciberseguridad OT</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Protección de redes industriales y sistemas de control crítico.</p>
          </div>

          <!-- Card 3 -->
          <div style="text-align: center; padding: 40px 30px; background: white; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.1);">
            <div style="width: 80px; height: 80px; background: white; border: 3px solid #e0e0e0; border-radius: 50%; display: flex; align-items: center; justify-content: center; margin: 0 auto 24px;">
              <svg style="width: 40px; height: 40px; color: #333;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Eficiencia Energética</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">Monitoreo y optimización del consumo energético en planta.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- SERVICIOS -->
<!-- SERVICIOS: INDUSTRIA DE PROCESOS (Data-Driven) -->
    <section id="servicios" style="background: white; padding: 50px 40px;">
      <div style="max-width: 1200px; margin: 0 auto;">
        <!-- Header -->
        <div style="text-align: center; margin-bottom: 60px;">
          <h2 style="font-size: 36px; font-weight: 700; color: #333; margin-bottom: 16px;">Ingeniería para Procesos Industriales</h2>
          <p style="font-size: 16px; color: #666; max-width: 700px; margin: 0 auto; line-height: 1.6;">
            Infraestructura de potencia, control y comunicaciones para la industria manufacturera, alimenticia y vitivinícola.
          </p>
        </div>

        <!-- Capability Matrix Grid -->
        <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 30px; max-width: 1000px; margin: 0 auto;">
          
          <!-- Capacidad 1: Electrificación y Potencia -->
          <div style="padding: 30px; background: #fafafa; border-radius: 8px; border-left: 4px solid #059669;">
            <div style="width: 50px; height: 50px; background: #059669; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
              <svg style="width: 28px; height: 28px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Electrificación y Potencia</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">
              Tendidos de media y baja tensión para plantas industriales, alimentación de bombas y salas de máquinas (Ej: Cervecería Quilmes).
            </p>
          </div>

          <!-- Capacidad 2: Seguridad en Procesos (Bodegas) -->
          <div style="padding: 30px; background: #fafafa; border-radius: 8px; border-left: 4px solid #059669;">
            <div style="width: 50px; height: 50px; background: #059669; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
              <svg style="width: 28px; height: 28px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Seguridad Industrial Certificada</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">
              Sistemas de detección de incendio y CCTV adaptados a normativas de higiene y seguridad en industria alimenticia (Ej: Bodegas, Hoteles).
            </p>
          </div>

          <!-- Capacidad 3: Conectividad Parques Industriales -->
          <div style="padding: 30px; background: #fafafa; border-radius: 8px; border-left: 4px solid #059669;">
            <div style="width: 50px; height: 50px; background: #059669; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
              <svg style="width: 28px; height: 28px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16m14 0h2m-2 0h-4m-5 0H9m0 0H5m4 0V9a1 1 0 011-1h4a1 1 0 011 1v12M9 7h6" />
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Redes en Parques Industriales</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">
              Infraestructura de fibra óptica y conectividad para naves industriales y centros logísticos (Ej: Inversora Pasip, Premix).
            </p>
          </div>

          <!-- Capacidad 4: Automatización y Control -->
          <div style="padding: 30px; background: #fafafa; border-radius: 8px; border-left: 4px solid #059669;">
            <div style="width: 50px; height: 50px; background: #059669; border-radius: 8px; display: flex; align-items: center; justify-content: center; margin-bottom: 20px;">
              <svg style="width: 28px; height: 28px; color: white;" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4" />
              </svg>
            </div>
            <h3 style="font-size: 18px; font-weight: 700; color: #333; margin-bottom: 12px;">Automatización y Control</h3>
            <p style="font-size: 14px; color: #666; line-height: 1.6;">
              Integración de tableros de control, PLC y sistemas SCADA para monitoreo de procesos productivos críticos.
            </p>
          </div>
        </div>
      </div>
    </section>

          <AntecedentesGridMobileOptimized items={antecedentes} limit={25} title="Casos de Éxito en industria" description="Proyectos destacados en este sector" />
        </div>
      </section>
    )}

    <!-- FORMULARIO -->
    <section id="contacto" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%); padding: 100px 32px; position: relative; overflow: hidden;">
      <div style="max-width: 75rem; margin: 0 auto; position: relative; z-index: 10;">
        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 80px; align-items: center;">
          <!-- Left Content -->
          <div>
            <div style="display: inline-block; padding: 8px 20px; background: rgba(16, 185, 129, 0.2); border-radius: 50px; margin-bottom: 24px; border: 1px solid rgba(16, 185, 129, 0.3);">
              <span style="font-size: 13px; font-weight: 800; color: #34d399; letter-spacing: 1px; text-transform: uppercase;">📞 Contáctenos</span>
            </div>
            <h2 style="font-size: clamp(36px, 5vw, 56px); font-weight: 900; color: white; margin-bottom: 24px; line-height: 1.1; letter-spacing: -0.02em;">
              Impulse su Industria<br/>al Siguiente Nivel
            </h2>
            <p style="font-size: 18px; color: #cbd5e1; line-height: 1.8; margin-bottom: 40px; font-weight: 500;">
              Contáctenos para descubrir cómo nuestras soluciones de Industria 4.0 pueden optimizar su producción.
            </p>
          </div>
          
          <!-- Right Form -->
          <div style="background: white; border-radius: 24px; padding: 48px; box-shadow: 0 20px 60px rgba(0,0,0,0.3);">
            <form action="/api/contact" method="POST" style="display: flex; flex-direction: column; gap: 24px;">
              <div>
                <label style="display: block; font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Nombre</label>
                <input type="text" name="nombre" required style="width: 100%; padding: 14px 18px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 15px;" placeholder="Nombre Completo" />
              </div>
              <div>
                <label style="display: block; font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Empresa</label>
                <input type="text" name="empresa" required style="width: 100%; padding: 14px 18px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 15px;" placeholder="Empresa" />
              </div>
              <div>
                <label style="display: block; font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Email</label>
                <input type="email" name="email" required style="width: 100%; padding: 14px 18px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 15px;" placeholder="email@empresa.com" />
              </div>
              <div>
                <label style="display: block; font-size: 14px; font-weight: 700; color: #0f172a; margin-bottom: 8px;">Mensaje</label>
                <textarea name="mensaje" required rows="4" style="width: 100%; padding: 14px 18px; border: 2px solid #e2e8f0; border-radius: 12px; font-size: 15px;" placeholder="Detalles del requerimiento..."></textarea>
              </div>
              <button type="submit" style="width: 100%; padding: 18px; background: linear-gradient(135deg, #059669, #10b981); color: white; border: none; border-radius: 12px; font-size: 16px; font-weight: 800; cursor: pointer;">
                Solicitar Contacto
              </button>
            </form>
          </div>
        </div>
      </div>
    </section>
  </main>
</Layout>

<style>
  /* RESPONSIVE MOBILE - FUERZA OVERRIDE CON !important */
  @media (max-width: 768px) {
    [style*="grid-template-columns: repeat(3, 1fr)"] { grid-template-columns: 1fr !important; }
    [style*="grid-template-columns: repeat(2, 1fr)"] { grid-template-columns: 1fr !important; }
    [style*="grid-template-columns: 1fr 1fr"] { grid-template-columns: 1fr !important; gap: 40px !important; }
    h1[style] { font-size: 32px !important; }
    h2[style] { font-size: 28px !important; }
    h3[style] { font-size: 18px !important; }
    section[style*="padding"] { padding: 40px 20px !important; }
    #contacto form { padding: 24px !important; }
    [style*="padding: 30px"] { padding: 20px !important; }
  }
</style>
