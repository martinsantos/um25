---
interface Props {
  kpis?: {
    icono: string;
    titulo: string;
    valor: string;
    descripcion: string;
    color?: string;
  }[];
}

const { kpis = [] } = Astro.props;

// KPIs por defecto si no se proporcionan
const defaultKpis = [
  {
    icono: 'checklist',
    titulo: 'Verificaciones',
    valor: '15',
    descripcion: 'Verificaciones individuales',
    color: 'blue'
  },
  {
    icono: 'hourglass_top',
    titulo: 'Tiempo Promedio',
    valor: '2.5 días',
    descripcion: 'Promedio del sector: 3.2 días',
    color: 'green'
  },
  {
    icono: 'verified',
    titulo: 'Tasa de Precisión',
    valor: '99.8%',
    descripcion: 'Basado en validación post-verificación',
    color: 'purple'
  },
  {
    icono: 'warning',
    titulo: 'Alertas Críticas',
    valor: '1',
    descripcion: 'Problema de alta prioridad identificado',
    color: 'red'
  }
];

const kpisToShow = kpis.length > 0 ? kpis : defaultKpis;
---

<section class="mb-12">
  <h3 class="text-xl font-semibold mb-6 pl-4 border-l-4 border-blue-600 text-blue-900">Indicadores Clave</h3>
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6">
    {kpisToShow.map(kpi => (
      <div class="bg-white p-6 rounded-lg shadow-lg transition-transform hover:translate-y-[-5px]">
        <div class="flex items-center mb-3">
          <span class={`material-icons-outlined text-${kpi.color || 'blue'}-600 mr-3 text-3xl`}>
            {kpi.icono}
          </span>
          <h4 class="text-lg font-medium text-gray-700">{kpi.titulo}</h4>
        </div>
        <p class="text-4xl font-bold text-blue-900">{kpi.valor}</p>
        <p class="text-sm text-gray-500">{kpi.descripcion}</p>
      </div>
    ))}
  </div>
</section>

<style>
  /* Estilos personalizados si son necesarios */
</style>
