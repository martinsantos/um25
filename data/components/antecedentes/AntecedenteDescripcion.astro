---
import '../../styles/antecedentes.css';

interface Props {
  descripcion: string;
  titulo?: string;
}

const { descripcion, titulo = "Descripción" } = Astro.props;
---

<section class="antecedente-descripcion">
  <div class="antecedente-descripcion__container">
    {titulo && <h2 class="antecedente-descripcion__title">{titulo}</h2>}
    
    {descripcion ? (
      <div class="antecedente-descripcion__content">
        <p set:html={descripcion}></p>
      </div>
    ) : (
      <p class="antecedente-descripcion__empty">No hay descripción disponible</p>
    )}
  </div>
</section>
