---
// UMTerminalProfessional.astro - Terminal profesional estable v1.0 (SIN selector de temas problemático)
---

<div id="um-terminal-container">
  <div id="um-terminal" class="um-terminal-professional">
    <!-- Terminal Header -->
    <div class="terminal-header">
      <div class="terminal-controls">
        <div class="control minimize"></div>
        <div class="control maximize"></div>
        <div class="control close"></div>
      </div>
      <div class="terminal-title">ULTIMA MILLA CLI v22.0 - Mendoza, Argentina</div>
    </div>
    
    <!-- Terminal Body -->
    <div class="terminal-body" id="terminal-output">
      <div class="welcome-message">
        <pre id="welcome-ascii" class="ascii-art"></pre>
        <div class="welcome-info">
          <div class="welcome-line">
            <span class="icon">🚀</span> Bienvenido a <strong>ULTIMA MILLA CLI</strong> - Terminal interactivo empresarial
          </div>
          <div class="welcome-line">
            <span class="icon">📊</span> Explora <strong>22 años</strong> de historia, <strong>469+ proyectos</strong> y <strong>150+ clientes</strong>
          </div>
          <div class="welcome-line">
            <span class="icon">💡</span> Escribe <code>help</code> para ver comandos disponibles
          </div>
          <div class="welcome-line">
            <span class="icon">⚡</span> Prueba <code>sudo ultimamilla.py --demo</code> para una demostración completa
          </div>
          <div class="welcome-line">
            <span class="icon">📞</span> Comando <code>contacto</code> para enviar mensajes reales
          </div>
        </div>
      </div>
    </div>
    
    <!-- Terminal Input Line -->
    <div class="terminal-input-line">
      <span class="prompt" id="terminal-prompt">visitante@ultimamilla:~$ </span>
      <input 
        type="text" 
        id="terminal-input" 
        class="terminal-input" 
        autocomplete="off"
        spellcheck="false"
        placeholder="Escribe un comando..."
      />
      <div class="cursor" id="terminal-cursor"></div>
    </div>
    
    <!-- Loading Overlay -->
    <div class="loading-overlay" id="loading-overlay">
      <div class="loading-spinner"></div>
      <div class="loading-text">Procesando comando...</div>
    </div>
  </div>
</div>

<style>
  /* Terminal Container */
  #um-terminal-container {
    width: 100%;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0;
    position: relative;
  }

  .um-terminal-professional {
    width: 100%;
    height: 70vh;
    min-height: 500px;
    max-height: 800px;
    
    /* Diseño profesional simple */
    background: linear-gradient(145deg, #0d1117 0%, #21262d 50%, #161b22 100%);
    border: 1px solid #30363d;
    border-radius: 12px;
    
    /* Sombra profesional */
    box-shadow: 
      0 20px 40px -12px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(255, 255, 255, 0.05);
    
    font-family: 'Fira Code', 'SF Mono', 'Monaco', 'Consolas', monospace;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    position: relative;
    
    transition: all 0.3s ease;
  }

  /* Terminal Header */
  .terminal-header {
    background: linear-gradient(135deg, #21262d 0%, #30363d 100%);
    padding: 12px 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid #30363d;
    user-select: none;
  }

  .terminal-controls {
    display: flex;
    gap: 8px;
  }

  .control {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    cursor: pointer;
  }

  .minimize { background: #fbbf24; }
  .maximize { background: #10b981; }
  .close { background: #ef4444; }

  .terminal-title {
    color: #e6edf3;
    font-size: 14px;
    font-weight: 600;
  }

  /* Terminal Body */
  .terminal-body {
    flex: 1;
    padding: 20px;
    overflow-y: auto;
    background: transparent;
    color: #e6edf3;
    font-size: 14px;
    line-height: 1.6;
  }

  .welcome-message {
    display: block;
  }

  .ascii-art {
    color: #00d4aa;
    font-size: 12px;
    line-height: 1.2;
    margin-bottom: 20px;
    white-space: pre;
    font-family: monospace;
  }

  .welcome-info {
    margin-top: 20px;
  }

  .welcome-line {
    margin: 8px 0;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .icon {
    font-size: 16px;
    width: 20px;
    text-align: center;
  }

  code {
    background: rgba(255, 255, 255, 0.1);
    padding: 2px 6px;
    border-radius: 4px;
    color: #fbbf24;
    font-family: inherit;
  }

  /* Terminal Input */
  .terminal-input-line {
    display: flex;
    align-items: center;
    padding: 16px 20px;
    background: rgba(0, 0, 0, 0.2);
    border-top: 1px solid #30363d;
    position: relative;
  }

  .prompt {
    color: #00d4aa;
    font-weight: 600;
    margin-right: 8px;
    white-space: nowrap;
  }

  .terminal-input {
    flex: 1;
    background: transparent;
    border: none;
    color: #e6edf3;
    font-family: inherit;
    font-size: 14px;
    outline: none;
    padding: 0;
  }

  .terminal-input::placeholder {
    color: #7d8590;
  }

  .cursor {
    width: 2px;
    height: 18px;
    background: #00d4aa;
    margin-left: 2px;
    animation: blink 1s infinite;
  }

  @keyframes blink {
    0%, 50% { opacity: 1; }
    51%, 100% { opacity: 0; }
  }

  /* Loading Overlay */
  .loading-overlay {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.8);
    display: none;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    backdrop-filter: blur(4px);
  }

  .loading-spinner {
    width: 40px;
    height: 40px;
    border: 3px solid rgba(255, 255, 255, 0.1);
    border-top: 3px solid #00d4aa;
    border-radius: 50%;
    animation: spin 1s linear infinite;
    margin-bottom: 16px;
  }

  @keyframes spin {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }

  .loading-text {
    color: #e6edf3;
    font-size: 14px;
  }

  /* Responsive Design */
  @media (max-width: 768px) {
    .um-terminal-professional {
      height: 60vh;
      min-height: 400px;
      border-radius: 8px;
    }
    
    .terminal-header {
      padding: 8px 12px;
    }
    
    .terminal-title {
      font-size: 12px;
    }
    
    .terminal-body {
      padding: 16px;
      font-size: 13px;
    }
    
    .terminal-input-line {
      padding: 12px 16px;
    }
    
    .terminal-input {
      font-size: 13px;
    }
  }

  @media (max-width: 480px) {
    .um-terminal-professional {
      height: 50vh;
      min-height: 350px;
    }
    
    .terminal-body {
      padding: 12px;
      font-size: 12px;
    }
    
    .ascii-art {
      font-size: 10px;
    }
    
    .welcome-line {
      margin: 6px 0;
      font-size: 12px;
    }
    
    .icon {
      font-size: 14px;
      width: 16px;
    }
  }
</style>

<script>
  // Terminal básico y estable sin funcionalidades problemáticas
  class UMTerminalBasic {
    constructor() {
      this.output = document.getElementById('terminal-output');
      this.input = document.getElementById('terminal-input');
      this.loadingOverlay = document.getElementById('loading-overlay');
      this.commandHistory = [];
      this.historyIndex = -1;
      
      this.init();
    }

    init() {
      this.showWelcome();
      this.setupEventListeners();
      this.focusInput();
    }

    setupEventListeners() {
      if (this.input) {
        this.input.addEventListener('keydown', (e) => {
          if (e.key === 'Enter') {
            e.preventDefault();
            this.processCommand();
          } else if (e.key === 'ArrowUp') {
            e.preventDefault();
            this.navigateHistory('up');
          } else if (e.key === 'ArrowDown') {
            e.preventDefault();
            this.navigateHistory('down');
          } else if (e.key === 'Tab') {
            e.preventDefault();
            this.handleAutoComplete();
          }
        });

        this.input.addEventListener('input', () => {
          this.historyIndex = -1;
        });
      }
    }

    showWelcome() {
      const asciiElement = document.getElementById('welcome-ascii');
      if (asciiElement) {
        const asciiArt = `
 ██╗   ██╗██╗  ████████╗██╗███╗   ███╗ █████╗     ███╗   ███╗██╗██╗     ██╗      █████╗ 
 ██║   ██║██║  ╚══██╔══╝██║████╗ ████║██╔══██╗    ████╗ ████║██║██║     ██║     ██╔══██╗
 ██║   ██║██║     ██║   ██║██╔████╔██║███████║    ██╔████╔██║██║██║     ██║     ███████║
 ██║   ██║██║     ██║   ██║██║╚██╔╝██║██╔══██║    ██║╚██╔╝██║██║██║     ██║     ██╔══██║
 ╚██████╔╝███████╗██║   ██║██║ ╚═╝ ██║██║  ██║    ██║ ╚═╝ ██║██║███████╗███████╗██║  ██║
  ╚═════╝ ╚══════╝╚═╝   ╚═╝╚═╝     ╚═╝╚═╝  ╚═╝    ╚═╝     ╚═╝╚═╝╚══════╝╚══════╝╚═╝  ╚═╝`;
        asciiElement.textContent = asciiArt;
      }
    }

    focusInput() {
      if (this.input) {
        this.input.focus();
      }
    }

    processCommand() {
      const command = this.input.value.trim().toLowerCase();
      if (!command) return;

      this.addToHistory(command);
      this.showLoading();

      setTimeout(() => {
        this.executeCommand(command);
        this.hideLoading();
        this.input.value = '';
        this.focusInput();
      }, 500);
    }

    executeCommand(command) {
      const commandOutput = document.createElement('div');
      commandOutput.className = 'command-output';
      
      let response = '';

      switch (command) {
        case 'help':
          response = `
<span style="color: #00d4aa;">Comandos disponibles:</span>
• help - Muestra esta ayuda
• clear - Limpia la terminal
• about - Información sobre Ultima Milla
• services - Nuestros servicios
• contact - Información de contacto
• stats - Estadísticas de la empresa
• portfolio - Ver nuestro portfolio
• tech - Stack tecnológico
• team - Conoce nuestro equipo`;
          break;

        case 'clear':
          this.clearTerminal();
          return;

        case 'about':
          response = `
<span style="color: #00d4aa;">ULTIMA MILLA - Empresa IT Líder en Mendoza</span>

🏢 Fundada en 2000 - 22+ años de experiencia
📍 Mendoza, Argentina
👥 Equipo especializado en tecnología
📊 469+ proyectos completados exitosamente
🤝 150+ clientes satisfechos

Somos la empresa líder en servicios IT de Mendoza, 
dedicados a impulsar la transformación digital de empresas locales.`;
          break;

        case 'services':
          response = `
<span style="color: #00d4aa;">Nuestros Servicios Profesionales:</span>

💻 Desarrollo Web y Software
🔒 Seguridad Informática
🌐 Redes y Comunicaciones
☁️ Cloud Computing
📱 Aplicaciones Mobile
🛠️ Consultoría IT
🔧 Soporte Técnico
📊 Análisis de Datos`;
          break;

        case 'contact':
          response = `
<span style="color: #00d4aa;">Información de Contacto:</span>

📧 Email: info@ultimamilla.com.ar
📞 Teléfono: +54 261 123 4567
📍 Dirección: Av. San Martín 1234, Mendoza
🌐 Web: www.ultimamilla.com.ar
💼 LinkedIn: /company/ultimamilla`;
          break;

        case 'stats':
          response = `
<span style="color: #00d4aa;">Estadísticas de Ultima Milla:</span>

📅 Años de experiencia: 22+
🎯 Proyectos completados: 469+
👥 Clientes activos: 150+
🏆 Tasa de éxito: 98.5%
⭐ Satisfacción cliente: 4.9/5
🌟 Certificaciones: 25+`;
          break;

        case 'portfolio':
          response = `
<span style="color: #00d4aa;">Portfolio Destacado:</span>

🏛️ Gobierno de Mendoza - Infraestructura IT
🏥 Hospitales - Sistemas de Gestión
🎓 Universidades - Plataformas Educativas
🏭 Industrias - Automatización
💼 Empresas - Transformación Digital
🛡️ Seguridad - Sistemas Críticos`;
          break;

        case 'tech':
          response = `
<span style="color: #00d4aa;">Stack Tecnológico:</span>

Frontend: React, Vue.js, Angular, Astro
Backend: Node.js, PHP, Python, .NET
Bases de Datos: PostgreSQL, MySQL, MongoDB
Cloud: AWS, Azure, Google Cloud
DevOps: Docker, Kubernetes, CI/CD
Seguridad: HTTPS, OAuth, Encriptación`;
          break;

        case 'team':
          response = `
<span style="color: #00d4aa;">Nuestro Equipo:</span>

👨‍💻 Desarrolladores Full-Stack
🔒 Especialistas en Ciberseguridad
🌐 Ingenieros de Redes
☁️ Arquitectos Cloud
📊 Analistas de Datos
🎨 Diseñadores UX/UI
🚀 DevOps Engineers`;
          break;

        default:
          response = `<span style="color: #ef4444;">Comando no reconocido: "${command}"</span>
Escribe <code>help</code> para ver los comandos disponibles.`;
      }

      commandOutput.innerHTML = `
        <div style="margin-bottom: 8px;">
          <span style="color: #00d4aa;">visitante@ultimamilla:~$</span> ${command}
        </div>
        <div style="margin-bottom: 16px; padding-left: 16px;">
          ${response}
        </div>`;

      if (this.output) {
        this.output.appendChild(commandOutput);
        this.output.scrollTop = this.output.scrollHeight;
      }
    }

    clearTerminal() {
      if (this.output) {
        // Mantener solo el mensaje de bienvenida
        const welcomeMessage = this.output.querySelector('.welcome-message');
        this.output.innerHTML = '';
        if (welcomeMessage) {
          this.output.appendChild(welcomeMessage);
        }
      }
    }

    showLoading() {
      if (this.loadingOverlay) {
        this.loadingOverlay.style.display = 'flex';
      }
    }

    hideLoading() {
      if (this.loadingOverlay) {
        this.loadingOverlay.style.display = 'none';
      }
    }

    addToHistory(command) {
      this.commandHistory.unshift(command);
      if (this.commandHistory.length > 50) {
        this.commandHistory.pop();
      }
      this.historyIndex = -1;
    }

    navigateHistory(direction) {
      if (this.commandHistory.length === 0) return;

      if (direction === 'up') {
        if (this.historyIndex < this.commandHistory.length - 1) {
          this.historyIndex++;
        }
      } else if (direction === 'down') {
        if (this.historyIndex > -1) {
          this.historyIndex--;
        }
      }

      if (this.historyIndex >= 0) {
        this.input.value = this.commandHistory[this.historyIndex];
      } else {
        this.input.value = '';
      }
    }

    handleAutoComplete() {
      const commands = ['help', 'clear', 'about', 'services', 'contact', 'stats', 'portfolio', 'tech', 'team'];
      const currentValue = this.input.value.toLowerCase();
      
      const matches = commands.filter(cmd => cmd.startsWith(currentValue));
      if (matches.length === 1) {
        this.input.value = matches[0];
      }
    }
  }

  // Inicialización cuando el DOM esté listo
  document.addEventListener('DOMContentLoaded', () => {
    new UMTerminalBasic();
  });

  // Fallback para casos donde DOMContentLoaded ya pasó
  if (document.readyState === 'loading') {
    // DOM aún se está cargando
  } else {
    // DOM ya está listo
    new UMTerminalBasic();
  }
</script>
