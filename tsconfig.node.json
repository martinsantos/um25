{
  "compilerOptions": {
    "composite": true,
    "module": "esnext",
    "moduleResolution": "node",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": false,
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "lib": ["es2020", "dom", "dom.iterable"],
    "types": ["node", "jest"],
    "outDir": "./dist"
  },
  "include": [
    "vite.config.*",
    "vitest.config.*",
    "jest.config.*",
    "setupTests.*",
    "src/vite-env.d.ts"
  ]
}
