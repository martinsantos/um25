  pos r a -11;
  pos r e -10;
  pos r o -11;
  pos v a -19;
  pos w a -14;
  pos y a -20;
  pos T period -62;
  pos V period -55;
  pos W period -42;
  pos Y period -63;
  pos P period -48;
  pos questiondown A -18;
  pos exclamdown A -12;
} kern;
