languagesystem DFLT dflt;
languagesystem latn dflt;
languagesystem latn ESP;
feature liga { sub f i by fi; sub f l by fl; } liga;
feature zero { sub zero by zero.slash; } zero;
feature tnum { } tnum;
feature kern {
  pos A V -51;
  pos A W -37;
  pos A Y -55;
  pos F a -32;
  pos F o -30;
  pos L T -37;
  pos L V -46;
  pos L Y -51;
