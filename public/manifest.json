  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "navigate-new"
  },
  "handle_links": "preferred",
  "protocol_handlers": [
    {
      "protocol": "web+umterminal",
      "url": "/?cmd=%s"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "text/plain": [".txt", ".log"],
        "application/json": [".json"]
      }
    }
  ]
