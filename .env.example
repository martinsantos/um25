# ULTIMA MILLA - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env files to Git!

# ===================================
# APPLICATION CONFIGURATION
# ===================================

# Environment (development, production)
NODE_ENV=development

# Public site URL (used for sitemaps, canonical URLs)
PUBLIC_SITE_URL=http://localhost:4321

# Server Configuration
HOST=0.0.0.0
PORT=4321

# ===================================
# DIRECTUS CMS CONFIGURATION
# ===================================

# Directus API URL (public, accessible from browser)
PUBLIC_DIRECTUS_URL=http://localhost:8055

# Directus Access Token (get from Directus admin panel)
# Settings → Access Tokens → Create Token
PUBLIC_DIRECTUS_TOKEN=your_directus_token_here

# ===================================
# DATABASE CONFIGURATION
# ===================================

# PostgreSQL connection (for direct DB access if needed)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=directus_dev
POSTGRES_USER=directus
POSTGRES_PASSWORD=dev_password_2025

# Connection string format (alternative)
# DATABASE_URL=postgresql://directus:dev_password_2025@localhost:5432/directus_dev

# ===================================
# CACHE CONFIGURATION
# ===================================

# Redis connection URL (for caching)
# REDIS_URL=redis://localhost:6379

# ===================================
# ERROR TRACKING (SENTRY)
# ===================================

# Sentry DSN for error tracking
# Get from: https://sentry.io/settings/projects/ultimamilla-web/keys/
# Format: https://<key>@o<org-id>.ingest.sentry.io/<project-id>
SENTRY_DSN=

# Optional Sentry Configuration
# SENTRY_ENVIRONMENT=development
# SENTRY_RELEASE=0.0.1
# SENTRY_TRACES_SAMPLE_RATE=1.0

# ===================================
# ANALYTICS & MONITORING
# ===================================

# Google Analytics Measurement ID
GOOGLE_ANALYTICS_ID=G-S2376K1GED

# ===================================
# EMAIL CONFIGURATION (OPTIONAL)
# ===================================

# SMTP Settings for contact forms
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=noreply@ultimamilla.com.ar
# SMTP_PASS=your_smtp_password
# SMTP_FROM=noreply@ultimamilla.com.ar

# ===================================
# API KEYS (OPTIONAL)
# ===================================

# ReCAPTCHA (for contact forms)
# RECAPTCHA_SITE_KEY=
# RECAPTCHA_SECRET_KEY=

# ===================================
# SECURITY
# ===================================

# Secret key for session management, JWT, etc.
SECRET_KEY=your_random_secret_key_here

# ===================================
# DEVELOPMENT-ONLY SETTINGS
# ===================================

# Debug mode (set to 'true' for verbose logging)
# DEBUG=false

# Disable SSL verification (dev only, NEVER in production)
# NODE_TLS_REJECT_UNAUTHORIZED=0

# ===================================
# PRODUCTION-ONLY SETTINGS
# ===================================

# These are typically set directly on the production server
# and should NOT be in this file

# SSL/TLS Configuration (set in Nginx/server config)
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# Security Headers (set in Nginx, documented for reference)
# HSTS_MAX_AGE=31536000
# CSP_POLICY=default-src 'self'

# ===================================
# NOTES & REMINDERS
# ===================================

# 1. NEVER commit .env files to Git
# 2. Use different values for development vs production
# 3. Store production secrets in secure password manager
# 4. Rotate credentials every 90 days
# 5. See SETUP_GUIDE.md for detailed configuration
# 6. Default credentials shown here are for LOCAL DEVELOPMENT ONLY
# 7. Generate strong passwords for production:
#    openssl rand -base64 32

# ===================================
# QUICK START
# ===================================

# For local development:
# 1. Copy this file: cp .env.example .env.local
# 2. Update DIRECTUS token from http://localhost:8055
# 3. Run: npm run dev
