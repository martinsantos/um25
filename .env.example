# Copy to .env for local development. Git ignores .env.
NODE_ENV=development
PUBLIC_SITE_URL=http://localhost:4321
HOST=127.0.0.1
PORT=4321
PUBLIC_DIRECTUS_URL=http://localhost:8055
# Server only; never copy a privileged token to PUBLIC_* or VITE_*.
DIRECTUS_STATIC_TOKEN=
USE_DIRECTUS=true

# Optional: local PostgreSQL and legacy Compose profiles
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=directus
POSTGRES_USER=directus
POSTGRES_PASSWORD=
DATABASE_URL=
DIRECTUS_KEY=
DIRECTUS_SECRET=
DIRECTUS_ADMIN_EMAIL=
DIRECTUS_ADMIN_PASSWORD=

# Optional: monitoring, analytics and authenticated endpoints
SENTRY_DSN=
PUBLIC_SENTRY_DSN=
GOOGLE_ANALYTICS_ID=
SECRET_KEY=
DIRECTUS_WEBHOOK_SECRET=
COMMENTS_ADMIN_SECRET=
